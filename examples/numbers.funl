;; The numeric tower: exact until a program asks for inexactness.
;;
;; Integers grow without bound. Dividing two integers that do not divide evenly gives an exact
;; rational, and an exact result that is whole becomes an integer again. A real appears only when
;; a literal or an operation introduces one, and once inexact a result stays inexact.

write( 2 ^ 100 )                    ;; 1267650600228229401496703205376

def factorial( n ) = if n == 0 then 1 else n * factorial( n - 1 )

write( factorial(30) )              ;; 265252859812191058636308480000000

write( 7 / 2 )                      ;; 7/2
write( 7 \ 2 )                      ;; 3 -- integer division
write( 1/3 + 1/6 )                  ;; 1/2
write( 1/3 + 2/3 )                  ;; 1 -- a whole rational is an integer
write( 2.5 * 2 )                    ;; 5.0 -- an inexact result is never demoted
write( 1/4 + 0.5 )                  ;; 0.75

;; The harmonic numbers, exactly: H(10) = 1 + 1/2 + ... + 1/10.
def harmonic( n )
  var h = 0

  for k <- 1..n
    h += 1/k

  h

write( harmonic(10) )               ;; 7381/2520

;; Newton's method for the square root of 2, run in exact rationals: each step roughly doubles
;; the number of correct digits, and the fractions show it.
var x = 1

for _ <- 1..4
  x = (x + 2/x) / 2
  write( x )                        ;; 3/2, 17/12, 577/408, 665857/470832

write( x * 1.0 )                    ;; 1.4142135623746899 -- made inexact on request

;; `div` asks "divides": it succeeds or fails, so it filters directly.
write( [n | n <- 1..30 if 3 div n and 5 div n] )   ;; [15, 30]
