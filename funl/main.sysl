import io.github.edadma.funl.*
import sh.sysl.linenoise.{history_add, history_set_max_len, read}
import sysl.text.Search

// The driver: `funl <program.funl>` compiles the program, runs it, and prints what it wrote. A file
// named `.lfunl` is literate FunL, tangled first. A file named `.pl` is a Prolog program: it is
// loaded, its directives and `initialization/1` goals run, and a file with no `initialization/1` goal
// then starts the ISO top level, whose lines are read through linenoise as the `prolog` executable
// reads them. Whatever follows the program's name is the program's own, read with `funl:process`'s
// `args`. `funl add`, `funl fetch`, `funl vendor` and `funl deps` are the package commands instead
// (`package_commands.sysl`).
//
// **It sits at the project root, outside the module**, so the package can be a dependency too: the
// `prolog` executable (`prolog/`) is a second program over the same module, and a program has one
// `main`.
//
// **The status says which thing happened** (`run_source`): 0 for a program that ran, 1 for one that
// was refused or faulted -- the diagnostics are on standard error -- 2 when `funl` could not work out
// what it was asked to do, and `N` for a program that ran `halt(N)`.

main(args: []string)
    if args.len > 1 && args[1] == "--version"
        print(s"funl $FunlVersion")
        return

    if args.len < 2
        eprints(s"usage: funl <program.funl | program.lfunl | program.pl> [argument ...]\n$CommandUsage")
        exit(2)

    // A package command is one of its words; a program file called `add` is run as `funl ./add`.
    if is_package_command(args[1])
        exit(package_command(args[1], args[2..<args.len], working_dir(), (text) -> prints(text), (text) -> eprints(text)))

    history_set_max_len(500)
    exit(run_file(args[1], (prompt) -> line(prompt), (text) -> print(text), (text) -> eprints(text), args[2..<args.len]))
end main

// A line, remembered for the arrow keys unless it is blank.
private line(prompt: string) -> Option[string]
    val got = read(prompt)

    got match
        Some(l) -> if !l.trim().is_empty() then history_add(l)
        None -> ()

    got
