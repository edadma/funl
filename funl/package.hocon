// `funl` -- the driver: `funl program.funl` (or a literate `program.lfunl`) compiles and runs a FunL program, `funl file.pl` loads a
// Prolog file through FunL's driver. The machine is the library at the repository root (`funl-vm`);
// the executable is named for this package.

package {
  name    = "funl"
  version = "0.0.4"
  sysl    = "0.1.0-alpha.5"
}

dependencies {
  funl-vm   { workspace = true }
  linenoise { git = "github.com/sysl-lang/linenoise", version = "0.3.0" }
}

requires {
  heap = true
}
