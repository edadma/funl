// `funl` -- the driver: `funl program.funl` (or a literate `program.lfunl`) compiles and runs a FunL program, `funl file.pl` loads a
// Prolog file through FunL's driver. The machine is the library at the repository root (`funl-vm`);
// the executable is named for this package.

package {
  name    = "funl"
  version = "0.0.7"
  sysl    = "0.1.1"
}

dependencies {
  funl-vm   { workspace = true, default_features = false }
  linenoise { git = "github.com/sysl-lang/linenoise", version = "0.3.0" }
}

// **The member owns its features and forwards them to the machine's**, because the machine is taken
// without its defaults: `--no-default-features` on this member then drops `funl:http`, libuv and
// SDL windows too, exactly as it does on the root.
//
// `sysl build -p funl --features profile` builds a `funl` that counts the instructions a run
// executes; `FUNL_PROFILE=1` then has it write the table to standard error when the program ends.
features {
  default  = [http, async, graphics]
  http     = ["funl-vm/http"]
  async    = ["funl-vm/async"]
  graphics = ["funl-vm/graphics"]
  profile  = ["funl-vm/profile"]
}

requires {
  heap = true
}
