module io.github.edadma.funl

import sh.sysl.dal.Number
import sh.sysl.gc
import sysl.buf.{Buf, buf}

// The collected objects, and how one is made.
//
// **Every constructor answers a `Result`, because a full heap is an answer and not a crash.** The
// collector runs only at the top of the instruction loop -- never inside an allocation -- so an
// allocation that finds no room fails the instruction that asked for it, and the run reports the
// fault against that instruction.
//
// **`gc.alloc` zeroes the payload**, and that is what makes assigning a `Buf` or a `string` into a
// fresh object safe: the assignment releases the previous occupant, which is a null. A container
// field in zeroed memory reads as empty but has no storage to push into, so every maker below
// assigns each container field before anything is added to it.

// A string: its UTF-8 bytes, how many characters they hold, and a cursor -- the character index last
// asked for and the byte it begins at -- that `byte_at` (`strings.sysl`) walks from.
struct StrObj
    s: string
    chars: usize
    at_char: usize
    at_byte: usize

// A number that owns storage: a `dal` `Big` or `Rat`, whose limbs are this object's alone.
struct NumObj
    n: Number

// A cset: a set of characters, which the scanning builtins test characters against.
struct CSetObj
    set: CharSet

// A byte string's bytes, which nothing changes once it is made.
struct BytesObj
    b: Buf[u8]

// A handle: the kind that made it (an index into `Vm.handle_kinds`), whether it has been closed, and
// whatever the kind keeps in it. `res` is the native resource, owned by the handle and given back by
// the kind's release hook; `n` is a word of state the kind uses as it likes (a position, a count);
// `vals` are values the handle keeps alive, which the collector traces.
struct HandleObj
    kind: u32
    closed: bool
    res: *u8
    n: long
    vals: Buf[Value]

// A promise: what state it is in (`PromisePending`, `PromiseKept`, `PromiseFailed`,
// `PromiseFaulted`), whether anything has awaited it, the value it was kept with -- or, faulted, the
// ball thrown, `Undefined` when the fault was not a throw -- the fault's text, and the machines parked
// waiting for it, by their index in `Vm.parked`. `orphaned` says the call that made it was a statement
// of its own, its value thrown away, so nothing can ever await it.
struct PromiseObj
    state: u8
    awaited: bool
    orphaned: bool
    value: Value
    message: string
    waiters: Buf[usize]

struct CompoundObj
    functor: u32
    args: Buf[Value]

    // The `data` constructor that made it, plus one, so that a term made any other way -- by
    // unification, by a Prolog clause, by `MakeCompound` -- is 0, as `gc.alloc` leaves it. A record's
    // fields are named by its constructor; a plain term's are not.
    record: u32

struct TupleObj
    items: Buf[Value]

struct ConsObj
    head: Value
    tail: Value

// A range: `from`, then every `step` on while short of `last` (`inclusive`, up to and including
// it), or for ever when `endless`.
struct RangeObj
    from: long
    last: long
    step: long
    inclusive: bool
    endless: bool

struct SetObj
    items: Buf[Value]

// A map's keys and the values under them, in step, in the order the keys were first added. A key is
// found by equality, as `==` decides it.
//
// **A mutable map made by `map(c, x)` has a default**: `defaulted` is set and `fallback` is `x`, which
// a lookup of a key the map does not hold answers instead of failing. The default is never an entry.
struct MapObj
    keys: Buf[Value]
    vals: Buf[Value]
    defaulted: bool
    fallback: Value

// An array's or a buffer's elements.
struct ArrayObj
    items: Buf[Value]

// A logic variable.
//
// **`stamp` dates it against the control stack**: it is the machine's stamp when the variable was
// made, and a binding needs a trail entry only when the variable is older than the newest entry.
// `id` is what an unbound variable prints as, unique within the run.
//
// **`task` is the task that made it** (`Vm.task`), and the only one that may bind it: **each task has
// its own trail and stamp**, so a binding by another could be undone by neither correctly.
struct VarObj
    value: Value
    bound: bool
    stamp: u64
    id: u64
    task: u32

// A function value: the chunk of its code and the frame it was made in, which becomes the static
// link of every frame a call of it makes.
struct ClosureObj
    chunk: usize
    up: *FrameObj

// A function's frame. **A heap object, not a region of the operand stack**: a choice point names the
// frame its alternative runs in, and that frame has to outlive the return that left it behind.
struct FrameObj
    // The chunk running in this frame, as an index into `Vm.chunks` -- compiled code is ordinary
    // reference-counted sysl data and may not live in collected memory.
    chunk: usize

    // The frame this function was defined in (the static link), and the frame to return to.
    up: *FrameObj
    caller: *FrameObj

    return_ip: usize

    // The caller's innermost mark, put back on return.
    caller_mark: usize

    // Control height when this frame was entered: entries above it were made by this frame.
    entry: usize

    // Control height a clause-level cut returns to.
    cut: usize

    // Operand stack height when this frame was entered, its arguments gone: what `return` from the
    // middle of an expression cuts the stack back to.
    base: usize

    // The failure target of a function clause whose head runs without a mark (`FrameHead`): where
    // failure goes -- the next clause, or `NoMatch` -- when it happens in the head, at an address
    // below `head_end` in this frame's chunk, while the frame has made no entry; and the operand
    // height to cut back to when it does. `fail_to` is `NoMark` while the frame has no target.
    fail_to: usize
    head_end: usize
    head_floor: usize

    // Whether a function value may still reach this frame through its static chain. A captured
    // frame is never reused by a tail call, which would change what the function value sees.
    captured: bool

    // The arguments as the call passed them, and the slots the body numbers its locals into.
    // **Two buffers and not one**: a relation's clauses each bind their own slots from the same
    // arguments, so a slot written by one clause must not change what the next clause reads.
    args: Buf[Value]
    slots: Buf[Value]

// Take `size` bytes of collected storage under `kind`, charging them to the collection schedule.
private take(v: *Vm, size: usize, kind: *gc.Kind) -> Result[*u8, string]
    val p = gc.alloc(&v.heap, size, kind)

    if p == null then return Err("heap exhausted: the heap cannot hold this program's live data")

    v.allocated += size
    Ok(p)

new_str(s: string) -> Result[Value, string]
    val v = current()
    val o: *StrObj = ptr_cast(take(v, sizeof(StrObj), &str_kind)?)

    o.s = s
    o.chars = char_count(s)
    v.allocated += s.bytes.len
    Ok(Str(o))

// A `Big` or a `Rat` boxed as a value, its limbs charged to the collection schedule as well.
new_num(n: Number, limbs: usize, fraction: bool) -> Result[Value, string]
    val v = current()
    val o: *NumObj = ptr_cast(take(v, sizeof(NumObj), &num_kind)?)

    o.n = n
    v.allocated += limbs * 8
    Ok(if fraction then Rat(o) else Big(o))

new_cset(set: CharSet) -> Result[Value, string]
    val v = current()
    val o: *CSetObj = ptr_cast(take(v, sizeof(CSetObj), &cset_kind)?)

    o.set = set
    v.allocated += set.wide.len() * sizeof(u32)
    Ok(CSet(o))

// A byte string of `bytes`, which the new object takes.
new_bytes(bytes: Buf[u8]) -> Result[Value, string]
    val v = current()
    val o: *BytesObj = ptr_cast(take(v, sizeof(BytesObj), &bytes_kind)?)

    v.allocated += bytes.len()
    o.b = bytes
    Ok(Bytes(o))

// A fresh, open handle of kind `kind`, holding no resource until its maker stores one.
new_handle(kind: u32) -> Result[*HandleObj, string]
    val v = current()
    val o: *HandleObj = ptr_cast(take(v, sizeof(HandleObj), &handle_kind)?)

    o.kind = kind
    o.vals = buf()
    Ok(o)

// A pending promise, which nothing waits for yet.
new_promise() -> Result[*PromiseObj, string]
    val v = current()
    val o: *PromiseObj = ptr_cast(take(v, sizeof(PromiseObj), &promise_kind)?)

    o.state = PromisePending
    o.awaited = false
    o.orphaned = false
    o.value = Undefined
    o.message = ""
    o.waiters = buf()
    Ok(o)

new_tuple(n: usize) -> Result[*TupleObj, string]
    val v = current()
    val o: *TupleObj = ptr_cast(take(v, sizeof(TupleObj), &tuple_kind)?)

    o.items = buf()

    for _ in 0..<n
        o.items.push(Undefined)

    v.allocated += n * sizeof(Value)
    Ok(o)

// A fresh unbound variable, dated by the running machine's stamp and owned by its task.
new_var() -> Result[*VarObj, string]
    val v = current()
    val o: *VarObj = ptr_cast(take(v, sizeof(VarObj), &var_kind)?)

    o.value = Undefined
    o.bound = false
    o.stamp = v.stamp
    o.task = v.task
    o.id = v.var_count
    v.var_count += 1
    Ok(o)

// A compound with `n` arguments, every one `Undefined` until the caller fills it.
new_compound(functor: u32, n: usize) -> Result[*CompoundObj, string]
    val v = current()
    val o: *CompoundObj = ptr_cast(take(v, sizeof(CompoundObj), &compound_kind)?)

    o.functor = functor
    o.args = buf()

    for _ in 0..<n
        o.args.push(Undefined)

    v.allocated += n * sizeof(Value)
    Ok(o)

new_cons(head: Value, tail: Value) -> Result[Value, string]
    val o: *ConsObj = ptr_cast(take(current(), sizeof(ConsObj), &cons_kind)?)

    o.head = head
    o.tail = tail
    Ok(Cons(o))

new_range(from: long, last: long, step: long, inclusive: bool, endless: bool) -> Result[Value, string]
    val o: *RangeObj = ptr_cast(take(current(), sizeof(RangeObj), &range_kind)?)

    o.from = from
    o.last = last
    o.step = step
    o.inclusive = inclusive
    o.endless = endless
    Ok(Range(o))

// An empty set, which the caller fills.
new_set() -> Result[*SetObj, string]
    val o: *SetObj = ptr_cast(take(current(), sizeof(SetObj), &set_kind)?)

    o.items = buf()
    Ok(o)

// An empty map, which the caller fills.
new_map() -> Result[*MapObj, string]
    val o: *MapObj = ptr_cast(take(current(), sizeof(MapObj), &map_kind)?)

    o.keys = buf()
    o.vals = buf()
    Ok(o)

// An array of `n` elements, every one `Undefined` until something is stored.
new_array(n: usize) -> Result[*ArrayObj, string]
    val v = current()
    val o: *ArrayObj = ptr_cast(take(v, sizeof(ArrayObj), &array_kind)?)

    o.items = buf()

    for _ in 0..<n
        o.items.push(Undefined)

    v.allocated += n * sizeof(Value)
    Ok(o)

// A frame for `chunk`, with no arguments and no slots yet.
new_frame(chunk: usize) -> Result[*FrameObj, string]
    val o: *FrameObj = ptr_cast(take(current(), sizeof(FrameObj), &frame_kind)?)

    o.chunk = chunk
    o.up = null
    o.caller = null
    o.captured = false
    o.fail_to = NoMark
    o.head_end = 0
    o.head_floor = 0
    o.args = buf()
    o.slots = buf()
    Ok(o)

// A function value over `chunk`, made in frame `up`. **`up` and every frame above it are marked
// captured**, since the value can reach all of them; a frame above a captured one is captured
// already, so the walk stops there.
new_closure(chunk: usize, up: *FrameObj) -> Result[Value, string]
    val o: *ClosureObj = ptr_cast(take(current(), sizeof(ClosureObj), &closure_kind)?)

    o.chunk = chunk
    o.up = up

    var f = up

    while f != null && !f.captured
        f.captured = true
        f = f.up

    Ok(Func(o))
