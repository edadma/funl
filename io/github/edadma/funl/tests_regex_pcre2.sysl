module io.github.edadma.funl
@tests

import sh.sysl.pcre2.{compile as pcre2_compile, describe as pcre2_describe}
import sysl.buf.{Buf, buf}
import sysl.text.{fields, split, str_builder}

// The second regex oracle, live: every pattern of every regex corpus is also run through PCRE2 and the
// spans compared with this engine's, group for group, in the form the corpora write them -- `(0,1)(?,?)`,
// or `NOMATCH`. Where the first oracle (the AT&T data) is POSIX's and so excuses lines, this one is the
// semantics the engine actually has, and it is held to all of them.
//
// Positions are characters on both sides: PCRE2 runs in UTF-8 mode and answers bytes, which are turned
// into characters here.
//
// The one place the two part is lookbehind, which this engine matches backward from the position.
// PCRE2 refuses a lookbehind of no fixed length outright (20 lines of `lookbehind.txt`, counted, with
// nothing to compare), and on 9 lines it compiles the pattern and answers differently.
// `tests/regex/pcre2_lookbehind.txt` lists those 9 with the reason; a listed line that now agrees is a
// failure, and so is an unlisted line that differs.

// The characters in the first `bytes` bytes of `s`.
private chars_before(s: string, bytes: usize) -> usize
    var n: usize = 0

    for i in 0..<bytes
        if (s.bytes[i] & u8(0xC0)) != u8(0x80) then n += 1

    n

// What PCRE2 says searching for `pattern` in `subject` comes to, in the corpora's notation.
private pcre2_searched(pattern: string, subject: string) -> string
    val re = pcre2_compile(pattern) match
        Ok(r) -> r
        Err(e) -> return s"refused: ${pcre2_describe(e)}"

    val found = re.find(subject) match
        Ok(m) -> m
        Err(e) -> return s"error: ${pcre2_describe(e)}"

    val m = found match
        Some(x) -> x
        None -> return "NOMATCH"

    var out = str_builder()

    for i in 0..<m.group_count()
        m.span(i) match
            Some((lo, hi)) -> out.push(s"(${chars_before(subject, lo)},${chars_before(subject, hi)})")
            None -> out.push("(?,?)")

    out.finish()

// The lines of `pcre2_lookbehind.txt`: `lookbehind.txt line<TAB>reason`, as `line` and `reason`.
private struct Differs
    line: usize
    why: string
    used: bool

private line_of(s: string) -> usize
    var n: usize = 0

    for b in s.bytes
        if b < u8('0') || b > u8('9') then panic(s"pcre2_lookbehind.txt: `$s` is not a line number")

        n = n * 10 + usize(b - u8('0'))

    n

private differences() -> Buf[Differs]
    var out: Buf[Differs] = buf()

    for row in split(regex_data("pcre2_lookbehind.txt"), "\n")
        if row.bytes.len == 0 || row.bytes[0] == u8('#') then continue

        val cols = split(row, "\t")

        if cols.len != 2 || cols[1].bytes.len == 0 then panic(s"pcre2_lookbehind.txt: `$row` is not `line<TAB>reason`")

        out.push(Differs(line_of(cols[0]), cols[1], false))

    out

// Compare one line; the failure, or "". `excused` is true where the line is a listed difference.
private compared(here: string, pattern: string, subject: string, excused: bool) -> string
    val ours = regex_searched(pattern, subject)
    val theirs = pcre2_searched(pattern, subject)

    if excused
        if ours == theirs then s"stale: $here is listed as a difference and agrees ($ours)\n" else ""
    else if ours != theirs
        s"$here: engine $ours, PCRE2 $theirs\n"
    else
        ""

// The AT&T files: `id pattern subject expected`. Returns the failures and the lines compared.
private att_compared(name: string) -> (string, usize)
    var failures = str_builder()
    var previous = ""
    var count: usize = 0
    var line_no: usize = 0

    for row in split(regex_data(name + ".txt"), "\n")
        line_no += 1

        val cols = fields(row)

        if cols.len == 0 then continue

        val pattern = if cols[1] == "SAME" then previous else cols[1]

        previous = pattern

        val subject = if cols[2] == "NULL" then "" else cols[2]

        failures.push(compared(s"$name.txt:$line_no `$pattern` on `$subject`", pattern, subject, false))
        count += 1

    (failures.finish(), count)

// Whether PCRE2 refused the pattern for having a lookbehind of no fixed length, which it will not
// compile at all and so has no span to compare.
private is_unbounded_refusal(said: string) -> bool
    val want = "refused: length of lookbehind assertion is not limited"

    if said.bytes.len < want.bytes.len then return false

    for i in 0..<want.bytes.len
        if said.bytes[i] != want.bytes[i] then return false

    true

// The tab-separated corpora: `pattern subject expected ...`.
private tabbed_compared(name: string, excused: Buf[Differs]) -> (string, usize, usize)
    var failures = str_builder()
    var count: usize = 0
    var refused: usize = 0
    var line_no: usize = 0

    for row in split(regex_data(name), "\n")
        line_no += 1

        if row.bytes.len == 0 || row.bytes[0] == u8('#') then continue

        val cols = split(row, "\t")
        val subject = if cols[1] == "NULL" then "" else cols[1]
        var listed = false

        for i in 0..<excused.len()
            val x = excused.at(i)

            if name == "lookbehind.txt" && x.line == line_no
                listed = true
                excused.set(i, Differs(x.line, x.why, true))

        if name == "lookbehind.txt" && is_unbounded_refusal(pcre2_searched(cols[0], subject))
            if listed then failures.push(s"$name:$line_no is listed as a difference and PCRE2 refuses it\n")

            refused += 1
            continue

        failures.push(compared(s"$name:$line_no `${cols[0]}` on `$subject`", cols[0], subject, listed))
        count += 1

    (failures.finish(), count, refused)

private att_names() -> Buf[string]
    var out: Buf[string] = buf()

    for n in ["basic3", "class", "forced-assoc", "left-assoc", "nullsub3", "osx-bsd-critical", "repetition2", "right-assoc", "totest"]
        out.push(n)

    out

@test
EVERY_AT_AND_T_LINE_GIVES_PCRE2_THE_SAME_SPANS()
    var failures = ""
    var count: usize = 0

    for n in att_names().view()
        val (f, c) = att_compared(n)


        failures = failures + f
        count += c

    assert_eq(failures, "")
    assert_eq(count, 428)

@test
EVERY_LOOKAROUND_LINE_GIVES_PCRE2_THE_SAME_SPANS()
    val (failures, count, refused) = tabbed_compared("lookaround.txt", buf())

    assert_eq(failures, "")
    assert_eq(count, 75)
    assert_eq(refused, 0)

@test
LOOKBEHIND_LINES_AGREE_WITH_PCRE2_EXCEPT_THE_LISTED_DIFFERENCES()
    val listed = differences()
    val (failures, count, refused) = tabbed_compared("lookbehind.txt", listed)
    var stale = str_builder()

    for x in listed.view()
        if !x.used then stale.push(s"stale: pcre2_lookbehind.txt names line ${x.line}, which is not a data line\n")

    assert_eq(failures, "")
    assert_eq(stale.finish(), "")
    assert_eq(listed.len(), 9)
    assert_eq(refused, 20)
