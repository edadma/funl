module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// The instruction set, and the chunk it is kept in.
//
// A jump target (`Mark`, `Choice`, `Branch`, `ChangeMark`) is an instruction index within the same chunk. A call
// target is a chunk index into `Vm.chunks`.
//
// **One instruction set for both languages the machine runs, dispatched by one match.** A Prolog
// front end emits only the instructions logic needs -- the control instructions, calls, unification
// and the `Get` family -- and never `PushUnit` or `MakeTuple`, which only FunL emits. Nothing in the
// machine asks which language a chunk came from.

// Where a head-unification instruction takes the value it unifies.
//
// `Arg(i)` is the frame's `i`th argument. `Popped` is the top of the operand stack, popped: it is
// how the arguments of a compound in a head are reached, `GetCompound` having pushed them.
enum Src
    Arg(i: usize)
    Popped

enum Op
    // Stop the run; the program succeeded.
    Halt

    // -- marks and choice points (`control.sysl`) ---------------------------------------------------

    // Begin a bounded expression; if it fails, resume at `to`.
    Mark(to: usize)

    // Begin a bounded expression whose failure is the enclosing context's business.
    MarkThrough

    // Something that can produce another result: on failure, resume at `to`.
    Choice(to: usize)

    // End the innermost bounded expression, discarding every entry above and including its mark,
    // and drop the expression's value.
    Unmark

    // `Unmark`, keeping the value on top of the stack.
    UnmarkKeep

    Fail
    Branch(to: usize)

    // Record the innermost mark's place on the control stack in slot `slot` of the running frame:
    // a loop's head, so that `break` and `continue` can reach it however many marks are open inside.
    SaveMark(slot: usize)

    // End the bounded expression whose mark slot `slot` recorded, discarding every entry above and
    // including that mark and the cells above its floor, and making the mark around it the innermost.
    UnmarkTo(slot: usize)

    // -- operands -----------------------------------------------------------------------------------

    Pop

    // Push the running chunk's `k`th constant.
    PushConst(k: usize)

    PushNil
    PushInt(n: long)

    // Push slot `slot` of the frame `depth` static links up.
    LoadSlot(depth: usize, slot: usize)

    // Store a fresh unbound variable into slot `slot`.
    NewVar(slot: usize)

    // Push a fresh unbound variable: an anonymous `_`.
    PushVar

    // Pop `n` values and push a compound of them, the deepest first.
    MakeCompound(functor: u32, n: usize)

    // Pop a tail, then a head, and push the cons of them.
    MakeCons

    // Pop `b`, pop `a`, unify them; succeed producing `b`, or fail.
    Unify

    // Pop `b`, pop `a`; succeed producing `b` when they are equal (`TestEq`) or unequal (`TestNe`),
    // or fail. An unbound variable in either is an instantiation error.
    TestEq
    TestNe

    // -- frames and calls (`frame.sysl`) ------------------------------------------------------------

    // Size the running frame's slots to `n`, every one `Undefined`.
    Frame(n: usize)

    // Call chunk `target` with the top `argc` values as its arguments.
    Call(target: usize, argc: usize)

    // As `Call`, reusing the running frame when nothing resumable was made in it. **Always followed
    // by `Return`**: where the frame cannot be reused this is an ordinary call, and its value comes
    // back to that `Return`.
    TailCall(target: usize, argc: usize)

    // Return the top of the stack, leaving the frame's choice points resumable.
    Return

    // `Return`, discarding every entry the frame made first: a deterministic exit.
    ReturnCommit

    // Call builtin `id` with the top `argc` values, which stay on the stack until it answers.
    Native(id: usize, argc: usize)

    // -- head unification (`unify.sysl`) ------------------------------------------------------------

    // First occurrence of a head variable: the slot takes the argument as it stands.
    GetVar(slot: usize, src: Src)

    // Later occurrence: unify the slot with the argument.
    GetValue(slot: usize, src: Src)

    // A constant in the head: bind an unbound argument to constant `k`, or compare.
    GetConst(k: usize, src: Src)

    // A compound in the head. An unbound argument is bound to a fresh `functor/n` term of new
    // variables; a bound one must have that functor and arity. Either way the term's arguments are
    // then pushed, the first on top, for the instructions that unify them with `Src.Popped`.
    GetCompound(functor: u32, n: usize, src: Src)

    // -- FunL's own values ------------------------------------------------------------------------

    PushUnit

    // Pop `n` values and push a tuple of them, the deepest first.
    MakeTuple(n: usize)

    // Pop `b`, pop `a`, push `a op b` -- or fail, for an ordering that does not hold.
    Arith(o: BinOp)

    // Replace the top with its negation.
    Negate

    // Fail when the top is `false`, leaving it otherwise: emitted after every condition, and nowhere
    // else, so `false` fails a condition and is an ordinary value everywhere else.
    FailIfFalse

    Dup

    // -- functions (`frame.sysl`) -------------------------------------------------------------------

    // Push the running frame's `i`th argument.
    LoadArg(i: usize)

    // Pop into slot `slot` of the running frame.
    StoreSlot(slot: usize)

    // Push a function value over chunk `target`, made in the frame `up` static links up -- or, when
    // `up` is `TopUp`, in the top level's frame.
    MakeClosure(target: usize, up: usize)

    // Call function chunk `target` with the top `argc` values, its frame's static link the frame
    // `up` names as `MakeClosure` reads it.
    CallFn(target: usize, argc: usize, up: usize)

    // `CallFn` in tail position, reusing the running frame where it can. **Always followed by
    // `Return`**, as `TailCall` is.
    TailCallFn(target: usize, argc: usize, up: usize)

    // Call the function value under the top `argc` values.
    CallValue(argc: usize)

    // `CallValue` in tail position. **Always followed by `Return`.**
    TailCallValue(argc: usize)

    // Pop a value; when it is a tuple of `n` items push them, the first on top, or fail.
    MatchTuple(n: usize)

    // Pop a value; when it is a `functor/n` term push its arguments, the first on top, or fail.
    MatchCompound(functor: u32, n: usize)

    // No clause of the running function matched its arguments: an error naming the function and
    // what it was given.
    NoMatch

    // Pop into slot `slot` of the frame `depth` static links up.
    StoreUp(depth: usize, slot: usize)

    // Pop `b`; store `x op b` into slot `slot` of the frame `depth` static links up, `x` being what
    // the slot holds, and push it -- or fail, leaving the slot alone, for an ordering that does not
    // hold. The value is read after `b` is made, so a generator in `b` updates the slot each time.
    Update(depth: usize, slot: usize, o: BinOp)

    // -- generators (`gen.sysl`) --------------------------------------------------------------------

    // Replace the collection on top with its first cursor, two cells: what is left of it and a
    // position in it.
    GenStart

    // Replace the cursor on top with its next element, leaving a choice point that resumes here on
    // the advanced cursor; fail when it is exhausted.
    GenNext

    // The cursor of `i to j by k` is the three cells `i`, `j`, `k`: replace them with `i`, leaving a
    // choice point that resumes here on `i + k`; fail once `i` has passed `j` (`inclusive`) or
    // reached it.
    GenRange(inclusive: bool)

    // -- lists, ranges and sets (`seq.sysl`) -----------------------------------------------------------

    // Pop a step, then -- unless `endless` -- an end, then a start, and push the range of them.
    MakeRange(inclusive: bool, endless: bool)

    // Pop a value; when it is a non-empty list or range push its rest and then its first element,
    // which is on top, or fail.
    MatchCons

    // Pop a value; succeed when it is an empty list or range, or fail.
    MatchNil

    // Pop a collection, pop `x`; succeed producing `x` when the collection holds it -- or, `negated`,
    // when it does not -- or fail.
    Member(negated: bool)

    // Fail unless the top is defined (`defined`) or `undefined`, leaving it.
    TestDefined(defined: bool)

    // Replace the top with its field `name`, an atom id.
    Field(name: u32)

    // Pop into slot `slot` of the frame `depth` static links up, recording what it held on the trail
    // for failure to put back.
    StoreBack(depth: usize, slot: usize)

    // Pop a value and add it to the collection building in slot `slot`, newest first.
    Collect(slot: usize)

    // Push what slot `slot` collected, in the order it was collected: a list, or a set (`set`).
    Collected(slot: usize, set: bool)

    // End a round of `|e` that produced a value: the innermost mark, pushed at `to`, now restarts
    // `e` there when failure reaches it, and the enclosing mark becomes the innermost again.
    ChangeMark(to: usize)
end Op

// What `MakeClosure`, `CallFn` and `TailCallFn` take for the top level's frame.
const TopUp: usize = 4294967295

// What a chunk's `arity` is when no call into it is checked: the top level, and the relations,
// whose calls the resolver has already counted.
const AnyArity: usize = 4294967295

// A unit of compiled code: its instructions and the constants they push.
//
// **Ordinary reference-counted sysl data, never collected**: a frame names its chunk by index. The
// constants are `Value`s and so are roots -- `roots` in `collector.sysl` walks every chunk's.
struct Chunk
    name: string
    code: Buf[Op]
    consts: Buf[Value]

    // How many arguments a call must pass, or `AnyArity`.
    arity: usize
