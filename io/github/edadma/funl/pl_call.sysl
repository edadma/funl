module io.github.edadma.funl

import sh.sysl.parsing.{full_report, point, source_of}
import sysl.buf.{Buf, buf}
import sysl.fs.read_text

// The meta-call, the soft cut and `consult`, as the instruction loop runs them.

// The control-stack height slot `slot` of the running frame recorded with `SaveHeight`.
saved_height(v: *Vm, slot: usize) -> Result[usize, string]
    slot_of(v.frame, slot)? match
        Int(n) -> Ok(usize(n))
        _ -> Err(s"slot $slot holds no saved height")

// `SoftCut`: the `Choice` at height `h` stops resuming, and everything above it stays. Once its
// condition has succeeded, an `*->` has nowhere else to go but its condition's other solutions.
soft_cut(v: *Vm, h: usize)
    if h >= v.control.len() then return

    var e = v.control.at(h)

    e.kind = MarkThrough
    v.control.set(h, e)

// `CallGoal(extra)`: the goal under the top `extra` values, with them added as its last arguments,
// called in a frame of its own -- so a cut inside it cuts no further than that frame.
call_goal(v: *Vm, extra: usize) -> Result[unit, Fault]
    val top = v.stack.len()

    if extra + 1 > top then return Err(Broken(s"call/${extra + 1} wants ${extra + 1} operands and the stack holds $top"))

    val base = top - extra - 1
    val g = deref(v.stack.at(base))
    var args: Buf[Value] = buf()

    val f = g match
        Atom(id) -> id
        Compound(c) ->
            for x in c.args.view()
                args.push(x)

            c.functor
        Var(_) -> return Err(instantiation_error("instantiation error: call/N was given an unbound variable as its goal"))
        _ -> return Err(type_error("callable", g, s"type error: call/N wants a callable goal, an atom or a compound, and was given ${described(g)}"))

    if extra == 0 && !body_callable(g)
        return Err(type_error("callable", g, s"type error: call/1 was given ${render(g)}, a goal with a part that is not callable"))

    for i in base + 1..<top
        args.push(v.stack.at(i))

    v.stack.truncate(base)

    var name = atom_name(f)

    // `M:G`, qualified by an atom: the goal `G` under the name `M:g` (`qualified_goal`).
    if name == ":" && args.len() == 2
        deref(args.at(0)) match
            Atom(m) ->
                deref(args.at(1)) match
                    Atom(id) ->
                        name = s"${atom_name(m)}:${atom_name(id)}"
                        args = buf()
                    Compound(c) ->
                        name = s"${atom_name(m)}:${atom_name(c.functor)}"
                        args = buf()

                        for x in c.args.view()
                            args.push(x)
                    _ -> ()
            _ -> ()

    val n = args.len()

    if is_inline(name, n)
        val chunk = query_chunk(f, args) match
            Ok(c) -> c
            Err(m) -> return Err(type_error("callable", g, s"type error: $m"))

        return call(v, chunk, 0)

    val key = pred_key(name, n)

    // Under an `unknown` flag other than `error`, a predicate nothing defines is called all the same:
    // its chunk runs `NoProcedure`, which fails as the flag says.
    val lenient = v.flags.unknown != "error"

    val chunk = v.preds.get(key) match
        Some(p) -> if p.defined || lenient then p.chunk else return Err(unknown_procedure(name, n))
        None ->
            if key == "catch/3" || native_id(key).is_some() || lenient
                predicate_chunk(name, n)
            else
                return Err(unknown_procedure(name, n))

    for x in args.view()
        v.stack.push(x)

    call(v, chunk, n)
end call_goal

// Whether `x` is a goal through and through: ISO turns a term into a goal before running any of it,
// so a conjunction, disjunction or if-then with a number anywhere in it is a type error as a whole,
// raised before its first part runs. A variable is a goal, `call(X)`.
private body_callable(x: Value) -> bool = deref(x) match
    Var(_) -> true
    Atom(_) -> true
    Compound(c) ->
        val n = atom_name(c.functor)

        if c.args.len() == 2 && (n == "," || n == ";" || n == "|" || n == "->" || n == "*->")
            body_callable(c.args.at(0)) && body_callable(c.args.at(1))
        else
            true
    _ -> false

// A goal built of control constructs, compiled into a chunk of its own: the constructs are read as
// the compiler reads a clause body, and every argument that is not a goal is the value it stands for.
private query_chunk(f: u32, args: Buf[Value]) -> Result[usize, string]
    val t = goal_term(f, args)

    compile_query("call/N", ReadClause(t, buf())) match
        Ok(e) -> finish(e)
        Err(p) -> Err(p.message)

private goal_term(f: u32, args: Buf[Value]) -> &Term
    val at = point(0)

    if args.len() == 0 then return term(TAtom(f), at)

    val goals = goal_args(atom_name(f), args.len())
    var ts: Buf[&Term] = buf()

    for x in args.view()
        ts.push(if goals then value_goal(x) else term(TConst(x), at))

    term(TComp(f, ts), at)

private value_goal(x: Value) -> &Term
    deref(x) match
        Atom(id) -> goal_term(id, buf())
        Compound(c) -> goal_term(c.functor, c.args)
        _ -> term(TConst(x), point(0))

// `Consult`: the file named on top, loaded, and what its directives run called.
//
// A file that cannot be read is `existence_error(source_sink, File)`, as is a file it imports that
// cannot be; one that defines a builtin's predicate, or one another file or FunL definition holds,
// `permission_error(modify, static_procedure, Name/Arity)`; and one whose text is refused
// `syntax_error(File)`. The diagnostics are in the message.
consult(v: *Vm) -> Result[unit, Fault]
    val named = deref(v.stack.pop().unwrap_or(Undefined))

    val file = named match
        Str(p) -> p.s
        Atom(id) -> atom_name(id)
        Var(_) -> return Err(instantiation_error("instantiation error: consult was given an unbound variable as its file"))
        x -> return Err(domain_error("source_sink", x, s"consult wants a file name, and was given ${described(x)}"))

    val text = read_text(file) match
        Ok(t) -> t
        Err(e) -> return Err(existence_error("source_sink", named, s"consult cannot read $file: $e"))

    val src = source_of(file, text)
    var report = full_report()

    val chunk = load_prolog(src, &report) match
        Ok(c) -> c
        Err(why) -> return Err(refused(file, why, s"consult could not load $file:\n${report.render(src)}"))

    call(v, chunk, 0)
end consult

// The error `consult/1` raises for `file`, refused for `why`.
private refused(file: string, why: Refusal, msg: string) -> Fault = why match
    Unreadable -> syntax_error(file, msg)
    Missing(f) -> new_str(f) match
        Ok(culprit) -> existence_error("source_sink", culprit, msg)
        Err(m) -> Broken(m)
    Taken(name, arity) -> indicator(name, arity) match
        Ok(pi) -> permission_error("modify", "static_procedure", pi, msg)
        Err(m) -> Broken(m)
