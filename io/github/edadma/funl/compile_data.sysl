module io.github.edadma.funl

import sysl.buf.Buf

// The data forms, compiled:
//
//     {k: v, ...}            k; v; ...; MakeMap(n)
//     {a, b, ...}            a; b; ...; MakeSet(n)
//     c(k) = e               c; k; e; StoreElem              -- `<-` trails the old element
//     s(i..j) = e            s; i..j; e; StoreSection; store into s
//     c(k) op= e             c; k; e; UpdateElem(op)
//     "a $x b"               "a "; x; " b"; Concat(3)
//     swap(a(i), b(j))       a; i; b; j; SwapElems
//     point(x, y)            x; y; MakeRecord(point)
//     b += x, `b` a val      x; InPlace(b, +)                -- `-=` too, out of a mutable set
//
// Every part is pushed before the instruction that combines them, so a generator in any part is
// backtracked into as it is anywhere else, and each of its values makes its own map, string or store.

// `{k: v, ...}`.
compile_map(e: *Emit, c: Ctx, keys: Buf[&Expr], vals: Buf[&Expr]) -> Result[unit, string]
    for i in 0..<keys.len()
        compile_value(e, c, keys.at(i))?
        compile_value(e, c, vals.at(i))?

    e.op(MakeMap(keys.len()))
    Ok(())

// `{a, b, ...}`.
compile_set(e: *Emit, c: Ctx, items: Buf[&Expr]) -> Result[unit, string]
    for x in items.view()
        compile_value(e, c, x)?

    e.op(MakeSet(items.len()))
    Ok(())

// `"text $x ${e} text"`: each part, then the string of them.
compile_interp(e: *Emit, c: Ctx, parts: Buf[&Expr]) -> Result[unit, string]
    for x in parts.view()
        compile_value(e, c, x)?

    e.op(Concat(parts.len()))
    Ok(())

// An element written: the collection, the key, the value, and the store.
compile_store(e: *Emit, c: Ctx, coll: &Expr, key: &Expr, x: &Expr, back: bool) -> Result[unit, string]
    if is_section_key(key)
        coll.kind match
            Ref(n) -> return compile_section_store(e, c, n, coll, key, x, back)
            _ -> ()

    compile_value(e, c, coll)?
    compile_key(e, c, key)?
    compile_value(e, c, x)?
    e.op(StoreElem(back))
    Ok(())

// Whether `key` is written as a range of positions, `i..j`, `i..<j`, `i..`, or `i..+n`.
is_section_key(key: &Expr) -> bool = key.kind match
    RangeValE(_, _, _, _) -> true
    RangeCountE(_, _, _) -> true
    _ -> false

// `s(i..j) = t` for a variable `s`: the store makes a new string where `s` holds one, so the result goes
// back into the variable; where `s` holds any other collection the store is `StoreElem`'s and the
// variable is given its own value again.
private compile_section_store(e: *Emit, c: Ctx, n: string, coll: &Expr, key: &Expr, x: &Expr, back: bool) -> Result[unit, string]
    compile_value(e, c, coll)?
    compile_value(e, c, key)?
    compile_value(e, c, x)?
    e.op(StoreSection(back))
    store_variable(e, c, n, coll.span.start, back)?
    Ok(())

// An element updated through an operator: the collection, the key, the operand, and the update.
compile_update(e: *Emit, c: Ctx, coll: &Expr, key: &Expr, o: BinOp, x: &Expr) -> Result[unit, string]
    compile_value(e, c, coll)?
    compile_key(e, c, key)?
    compile_value(e, c, x)?
    e.op(UpdateElem(o))
    Ok(())

// The key of an element, the collection already pushed. A random one (`?c`) is chosen from the
// collection under it, which stays for the store.
private compile_key(e: *Emit, c: Ctx, key: &Expr) -> Result[unit, string]
    key.kind match
        RandKeyE ->
            e.op(Dup)
            e.op(PushInt(0))
            e.op(NativeGen(native_id("$random_key").unwrap(), 1))
            Ok(())
        _ -> compile_value(e, c, key)

// `swap(a, b)`: both elements' collections and keys, then the exchange.
compile_swap(e: *Emit, c: Ctx, args: Buf[&Expr]) -> Result[unit, string]
    if args.len() != 2 then return Err("a swap the resolver refused reached the compiler")

    place(e, c, args.at(0))?
    place(e, c, args.at(1))?

    e.op(SwapElems)
    Ok(())

// Push the collection and the key an element names.
private place(e: *Emit, c: Ctx, a: &Expr) -> Result[unit, string]
    a.kind match
        CallE(n, at, args) ->
            compile_value(e, c, expr(Ref(n), at))?
            compile_value(e, c, args.at(0))?
            Ok(())
        ApplyE(f, args) ->
            compile_value(e, c, f)?
            compile_value(e, c, args.at(0))?
            Ok(())
        FieldE(coll, n) ->
            compile_value(e, c, coll)?
            compile_value(e, c, expr(StrE(n), a.span))?
            Ok(())
        _ -> Err("a swap of something that is not an element reached the compiler")
