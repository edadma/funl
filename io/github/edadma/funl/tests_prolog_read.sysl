module io.github.edadma.funl
@tests

// The Prolog reader: operators from the run-time table, priorities and associativity, numbers,
// quoted atoms and their escapes, comments, and where a malformed clause is refused. A term is shown
// by `write_canonical/1`, which writes every operator term in canonical form and quotes every atom
// that needs it, so the tree the reader built is what the test reads.

// `:- X = <term>, write_canonical(X), nl.` run for its one line.
private shown(term_text: string) -> string =
    ran_prolog(s":- X = ($term_text), write_canonical(X), nl.\n")

@test
AN_OP_DIRECTIVE_TAKES_EFFECT_FOR_THE_CLAUSES_AFTER_IT()
    val text = ":- op(700, xfx, ===>).\n" +
        "r(a ===> b).\n" +
        ":- r(X), write_canonical(X), nl.\n"

    assert_eq(ran_prolog(text), "===>(a,b)\nsucceeded")

@test
A_NAME_USED_AS_AN_OPERATOR_BEFORE_ITS_OP_DIRECTIVE_IS_REFUSED_AND_AFTER_IT_IS_READ()
    val text = "r(a ===> b).\n" +
        ":- op(700, xfx, ===>).\n" +
        "s(a ===> b).\n"

    assert_eq(prolog_complaints(text), "error 1:5 `,` or `)` was expected here\n")

@test
AN_OP_DIRECTIVE_WITH_PRIORITY_ZERO_REMOVES_THE_OPERATOR()
    val text = ":- op(0, xfx, =).\n" +
        "r(a = b).\n"

    assert_eq(prolog_complaints(text), "error 2:5 `,` or `)` was expected here\n")

@test
AN_OPERATOR_LIST_DEFINES_EACH_NAME()
    assert_eq(ran_prolog(":- op(200, xfy, [&&, <+>]).\n:- X = (a && b <+> c), write_canonical(X), nl.\n"), "&&(a,<+>(b,c))\nsucceeded")

@test
A_BAD_OP_DIRECTIVE_IS_REFUSED_WITH_THE_REASON()
    assert_eq(prolog_complaints(":- op(1300, xfx, ===>).\n"),
        "error 1:4 an operator's priority is from 0 to 1200, and this one is 1300\n")
    assert_eq(prolog_complaints(":- op(700, yfy, ===>).\n"),
        "error 1:4 `yfy` is not an operator type; the types are xfx, xfy, yfx, fy, fx, xf and yf\n")

@test
A_TERM_IN_CANONICAL_FORM_NEEDS_NO_OPERATOR_TABLE()
    assert_eq(shown("+(1, 2)"), "+(1,2)\nsucceeded")
    assert_eq(shown("'==='(a, b)"), "===(a,b)\nsucceeded")

@test
PRIORITIES_DECIDE_WHICH_OPERATOR_IS_THE_ROOT()
    assert_eq(shown("1 + 2 * 3 - 4"), "-(+(1,*(2,3)),4)\nsucceeded")
    assert_eq(shown("(1 + 2) * 3"), "*(+(1,2),3)\nsucceeded")
    assert_eq(shown("a :- b, c ; d -> e"), ":-(a,;(','(b,c),->(d,e)))\nsucceeded")

@test
YFX_GROUPS_TO_THE_LEFT_AND_XFY_TO_THE_RIGHT()
    assert_eq(shown("1 - 2 - 3"), "-(-(1,2),3)\nsucceeded")
    assert_eq(shown("2 ^ 3 ^ 4"), "^(2,^(3,4))\nsucceeded")
    assert_eq(shown("a , b , c"), "','(a,','(b,c))\nsucceeded")

@test
XFX_REFUSES_AN_OPERAND_OF_ITS_OWN_PRIORITY()
    assert_eq(prolog_complaints("t(X) :- X = (a = b = c).\n"),
        "error 1:20 operator priority clash: `=` cannot take a term of priority 700 on its left\n")

@test
A_MINUS_TOUCHING_DIGITS_IS_A_NEGATIVE_NUMBER_AND_A_SEPARATED_ONE_IS_AN_OPERATOR()
    assert_eq(shown("-1"), "-1\nsucceeded")
    assert_eq(shown("- 1"), "-(1)\nsucceeded")
    assert_eq(shown("-(1)"), "-(1)\nsucceeded")
    assert_eq(shown("- (1)"), "-(1)\nsucceeded")
    assert_eq(shown("1 - -1"), "-(1,-1)\nsucceeded")
    assert_eq(shown("1-1"), "-(1,1)\nsucceeded")
    assert_eq(shown("-a"), "-(a)\nsucceeded")
    assert_eq(shown("- - a"), "-(-(a))\nsucceeded")

@test
A_PREFIX_OPERATOR_WITH_NOTHING_TO_APPLY_TO_IS_AN_ATOM()
    assert_eq(shown("[-, +]"), "[-,+]\nsucceeded")
    assert_eq(shown("f(-)"), "f(-)\nsucceeded")
    assert_eq(shown("- = x"), "=(-,x)\nsucceeded")

@test
A_PREFIX_OPERATOR_BINDS_ITS_OPERAND_AT_ITS_OWN_PRIORITY()
    assert_eq(shown("\\+ a, b"), "','(\\+(a),b)\nsucceeded")
    assert_eq(shown("- 2 ^ 3"), "-(^(2,3))\nsucceeded")
    assert_eq(shown("- 2 * 3"), "*(-(2),3)\nsucceeded")

@test
LISTS_AND_CURLY_TERMS_READ_AS_THEIR_TERMS()
    assert_eq(shown("[1, 2 | [3]]"), "[1,2,3]\nsucceeded")
    assert_eq(shown("[a, b]"), "[a,b]\nsucceeded")
    assert_eq(shown("[a | b]"), "[a|b]\nsucceeded")
    assert_eq(shown("[]"), "[]\nsucceeded")
    assert_eq(shown("{a, b}"), "{','(a,b)}\nsucceeded")
    assert_eq(shown("'[]'"), "'[]'\nsucceeded")

@test
NUMBERS_IN_EVERY_BASE_AND_CHARACTER_CODES_READ_AS_INTEGERS()
    assert_eq(shown("[0x1F, 0o17, 0b101, 1_000]"), "[31,15,5,1000]\nsucceeded")
    assert_eq(shown("[0'a, 0' , 0'\\n, 0''', 0'\\\\]"), "[97,32,10,39,92]\nsucceeded")

@test
A_FLOAT_READS_AS_A_FLOAT_AND_WRITES_AS_ONE()
    // `p(1).` is an integer and a full stop: a `.` followed by layout is no fraction.
    assert_eq(prolog_complaints("p(1).\nq(X) :- X = 1.5.\n"), "")
    assert_eq(shown("[1.0, 1.5, 2.0e3, 1.0e10, 1e10, 1.5E-3, -2.5, - 2.5, 0.1]"), "[1.0,1.5,2000.0,10000000000.0,10000000000.0,0.0015,-2.5,-(2.5),0.1]\nsucceeded")
    assert_eq(shown("[1.0e22, 1.0e-10]"), "[1.0e+22,1.0e-10]\nsucceeded")
    assert_eq(shown("f(1.0)"), "f(1.0)\nsucceeded")
    assert_eq(shown("1 - -1.0"), "-(1,-1.0)\nsucceeded")

@test
AN_INTEGER_PAST_64_BITS_READS_AS_ONE()
    assert_eq(shown("[9223372036854775808, -9223372036854775809, 123456789012345678901234567890]"),
        "[9223372036854775808,-9223372036854775809,123456789012345678901234567890]\nsucceeded")
    assert_eq(prolog_complaints("q(0x1_0000_0000_0000_0000).\n"), "error 1:3 this integer is too large to hold\n")

@test
QUOTED_ATOMS_DOUBLE_THEIR_QUOTE_AND_DECODE_ISO_ESCAPES()
    assert_eq(shown("'it''s'"), "'it\\'s'\nsucceeded")
    assert_eq(shown("'\\x41\\\\x42\\'"), "'AB'\nsucceeded")
    assert_eq(shown("'\\101\\'"), "'A'\nsucceeded")
    assert_eq(shown("'tab\\there'"), "'tab\\there'\nsucceeded")
    assert_eq(shown("'back\\\\slash'"), "'back\\\\slash'\nsucceeded")
    assert_eq(shown("'con\\\ntinued'"), "continued\nsucceeded")
    assert_eq(shown("'a b'"), "'a b'\nsucceeded")

@test
A_HEX_ESCAPE_WITHOUT_ITS_CLOSING_BACKSLASH_IS_REFUSED()
    assert_eq(prolog_complaints("p('\\x41').\n"), "error 1:4 a numeric escape is closed by a `\\`\n")
    assert_eq(prolog_complaints("p('\\q').\n"), "error 1:4 this is not an escape Prolog knows\n")
    assert_eq(prolog_complaints("p('open).\n"), "error 1:3 this quoted atom is never closed\n")

@test
A_DOUBLE_QUOTED_TEXT_IS_A_STRING()
    assert_eq(ran_prolog(":- X = \"a \"\"quoted\"\" word\", write(X), nl.\n"), "a \"quoted\" word\nsucceeded")
    assert_eq(ran_prolog(":- X = f(\"s\"), writeq(X), nl.\n"), "f(\"s\")\nsucceeded")

@test
LINE_AND_BLOCK_COMMENTS_ARE_LAYOUT()
    val text = "% a comment line\n" +
        "p(1). /* a block\n   over two lines */ p(2).\n" +
        ":- forall(p(X), (write(X), /* inside */ nl)). % trailing\n"

    assert_eq(ran_prolog(text), "1\n2\nsucceeded")

@test
AN_UNCLOSED_PROLOG_BLOCK_COMMENT_IS_REFUSED_WHERE_IT_OPENS()
    assert_eq(prolog_complaints("p(1).\n/* never closed\np(2).\n"), "error 2:1 this comment is never closed\n")

@test
A_MALFORMED_CLAUSE_IS_REFUSED_AT_THE_TOKEN_THAT_BREAKS_IT_AND_READING_GOES_ON()
    val text = "p(a, ).\n" +
        "q(a b).\n" +
        "r(a) :- .\n" +
        "s(a)\n" +
        "t(1).\n" +
        "u(1)."

    val want = "error 1:6 a term was expected here\n" +
        "error 2:5 `,` or `)` was expected here\n" +
        "error 3:9 a term was expected here\n" +
        "error 5:1 an operator or the `.` that ends the clause was expected here\n"

    assert_eq(prolog_complaints(text), want)

@test
A_CLAUSE_WITH_NO_FULL_STOP_AT_THE_END_OF_THE_INPUT_IS_REFUSED()
    assert_eq(prolog_complaints("p(1).\np(2)"), "error 2:5 this clause is not ended by a `.`\n")

@test
A_CLAUSE_WHOSE_HEAD_IS_NOT_CALLABLE_IS_REFUSED()
    assert_eq(prolog_complaints("3 :- true.\n"), "error 1:1 a clause's head is an atom or a compound term\n")
    assert_eq(prolog_complaints("(a, b) :- true.\n"), "error 1:1 `,/2` is a control construct, and a program cannot define it\n")

@test
A_BODY_GOAL_THAT_IS_A_NUMBER_IS_REFUSED()
    assert_eq(prolog_complaints("p :- q, 3.\n"), "error 1:9 this is not a goal: a goal is an atom, a compound or a variable\n")

@test
A_RATIONAL_WRITTEN_N_R_M_READS_AS_THE_RATIONAL()
    assert_eq(ran_prolog(":- X = 7r2, Y is X * 2, writeq(X/Y), nl.\n"), "7r2/7\nsucceeded")
    assert_eq(ran_prolog(":- X = 14r4, Y = -7r2, Z = 4r2, writeq(X/Y/Z), nl.\n"), "7r2/ -7r2/2\nsucceeded")
@test
WHAT_WRITEQ_WRITES_OF_A_RATIONAL_READS_BACK_AS_THE_SAME_RATIONAL()
    assert_eq(ran_prolog(":- set_prolog_flag(prefer_rationals, true), X is 1 / 3, term_to_atom(X, A), term_to_atom(Y, A), Y == X, writeq(A), nl.\n"),
        "'1r3'\nsucceeded")
    assert_eq(ran_prolog(":- atom_number('7r2', N), writeq(N), nl.\n"), "7r2\nsucceeded")

@test
A_RATIONAL_WITH_A_ZERO_DENOMINATOR_IS_REFUSED()
    assert_eq(prolog_complaints("p(1r0).\n"), "error 1:3 this rational's denominator is 0\n")
    assert_eq(ran_prolog(":- (atom_number('1r0', N) -> writeq(N) ; write(none)), nl.\n"), "none\nsucceeded")

@test
BACK_QUOTED_TEXT_READS_AS_A_LIST_OF_CODES()
    assert_eq(ran_prolog(":- X = `abc`, writeq(X), nl.\n:- X = ``, writeq(X), nl.\n:- X = `it``s`, writeq(X), nl.\n"),
        "[97,98,99]\n[]\n[105,116,96,115]\nsucceeded")

@test
BACK_QUOTED_TEXT_LEFT_OPEN_IS_REFUSED()
    assert_eq(prolog_complaints("p(`abc).\n"), "error 1:3 this back-quoted text is never closed\n")
