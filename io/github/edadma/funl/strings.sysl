module io.github.edadma.funl

import sysl.buf.{Buf, buf}
import sysl.text.{chars_of, from_utf8_unchecked, is_char_boundary, str_builder}

// A string's characters, found by position, and sets of characters.
//
// **A string is its UTF-8 bytes, its character count and a forward cursor** (`vm.md`, Strings). The
// count is taken when the string is made and never goes stale, because a string never changes. A
// string whose count equals its byte length has one byte per character, and a character index is
// its byte offset. In any other the character is walked to from the cursor -- the index last asked
// for and the byte it begins at -- forward, or back: a FunL string is valid UTF-8, so a character's
// first byte is never mistaken for a later one. A scan asks for positions in order, which makes the
// walks over a whole scan linear in the string's length.

// How many characters `s` holds.
char_count(s: string) -> usize
    var n: usize = 0

    for b in s.bytes
        if is_char_boundary(b) then n += 1

    n

// The byte at which character `i` of `p` begins, counting characters from 0; `p.chars` answers the
// byte length. Moves the cursor to `i`.
byte_at(p: *StrObj, i: usize) -> usize
    val bytes = p.s.bytes

    if p.chars == bytes.len then return i

    if i >= p.chars then return bytes.len

    var k = p.at_char
    var b = p.at_byte

    // Walking back from the cursor further than forward from the start is the longer way.
    if i < k && i < k - i
        k = 0
        b = 0

    while k < i
        b += 1

        while b < bytes.len && !is_char_boundary(bytes[b])
            b += 1

        k += 1

    while k > i
        b -= 1

        while !is_char_boundary(bytes[b])
            b -= 1

        k -= 1

    p.at_char = k
    p.at_byte = b
    b
end byte_at

// Characters `from ..< to` of `p`, counting from 0.
chars_between(p: *StrObj, from: usize, to: usize) -> string
    val start = byte_at(p, from)
    val end = byte_at(p, to)

    from_utf8_unchecked(p.s.bytes[start..<end])

// Character `i` of `p`, counting from 0, which must be below `p.chars`.
char_at(p: *StrObj, i: usize) -> char
    val b = byte_at(p, i)
    val bytes = p.s.bytes

    chars_of(bytes[b..<bytes.len]).peek().unwrap()

// Whether `needle` stands in `hay` from byte `at`.
bytes_at(hay: []const u8, at: usize, needle: []const u8) -> bool
    if at + needle.len > hay.len then return false

    for i in 0..<needle.len
        if hay[at + i] != needle[i] then return false

    true

// A set of characters: a bit for each ASCII character, and the others listed in ascending order.
//
// **A complement is the same set with `inverted` set**: "every character but these". FunL's
// characters are Unicode, so a complement cannot be listed; membership and the algebra below read
// the flag, and only what has to enumerate the characters -- a size, `!c` -- has no answer for one.
struct CharSet
    lo: u64
    hi: u64
    wide: Buf[u32]
    inverted: bool

    has(self, c: char) -> bool = self.listed(c) != self.inverted

    // Whether `c` is one of the characters the set lists, whatever its flag.
    private listed(self, c: char) -> bool
        val u = u32(c)

        if u < 64 then return ((self.lo >> u64(u)) & 1) != 0

        if u < 128 then return ((self.hi >> u64(u - 64)) & 1) != 0

        for w in self.wide.view()
            if w == u then return true

            if w > u then return false

        false

    // How many characters the set lists.
    size(self) -> usize
        var n = self.wide.len()

        for u in 0..<64
            if ((self.lo >> u64(u)) & 1) != 0 then n += 1

            if ((self.hi >> u64(u)) & 1) != 0 then n += 1

        n

    // The `k`-th character the set lists, counted from 0 in ascending order; `k` is below `size`.
    nth(self, k: usize) -> char
        var left = k

        for u in 0..<128
            val c = char(u32(u))

            if self.listed(c)
                if left == 0 then return c

                left -= 1

        char(self.wide.at(left))

    // The characters not in this set.
    complemented(self) -> CharSet = CharSet(self.lo, self.hi, wide_copy(self.wide), !self.inverted)

    // The characters in either set.
    union(self, o: CharSet) -> CharSet
        if !self.inverted && !o.inverted then return regions(self, o, true, true, true, false)

        // ¬A ∪ ¬B is ¬(A ∩ B); ¬A ∪ B is ¬(A - B); A ∪ ¬B is ¬(B - A).
        if self.inverted && o.inverted then return regions(self, o, false, true, false, true)

        if self.inverted then return regions(self, o, true, false, false, true)

        regions(self, o, false, false, true, true)

    // The characters in both sets.
    intersection(self, o: CharSet) -> CharSet
        if !self.inverted && !o.inverted then return regions(self, o, false, true, false, false)

        // ¬A ∩ ¬B is ¬(A ∪ B); ¬A ∩ B is B - A; A ∩ ¬B is A - B.
        if self.inverted && o.inverted then return regions(self, o, true, true, true, true)

        if self.inverted then return regions(self, o, false, false, true, false)

        regions(self, o, true, false, false, false)

    // The characters in this set and not in `o`: this set's intersection with `o`'s complement.
    minus(self, o: CharSet) -> CharSet
        if !self.inverted && !o.inverted then return regions(self, o, true, false, false, false)

        // ¬A - ¬B is B - A; ¬A - B is ¬(A ∪ B); A - ¬B is A ∩ B.
        if self.inverted && o.inverted then return regions(self, o, false, false, true, false)

        if self.inverted then return regions(self, o, true, true, true, true)

        regions(self, o, false, true, false, false)

    add(*self, c: char)
        val u = u32(c)

        if u < 64
            self.lo = self.lo | (u64(1) << u64(u))
            return

        if u < 128
            self.hi = self.hi | (u64(1) << u64(u - 64))
            return

        var i: usize = 0

        while i < self.wide.len() && self.wide.at(i) < u
            i += 1

        if i < self.wide.len() && self.wide.at(i) == u then return

        self.wide.insert(i, u)

    // The characters the set lists, in ascending order: of a complement, those it leaves out.
    text(self) -> string
        var out = str_builder()

        for u in 0..<128
            val c = char(u32(u))

            if self.listed(c) then out.push_char(c)

        for w in self.wide.view()
            out.push_char(char(w))

        out.finish()

    same(self, other: CharSet) -> bool
        if self.inverted != other.inverted then return false

        if self.lo != other.lo || self.hi != other.hi || self.wide.len() != other.wide.len() then return false

        for i in 0..<self.wide.len()
            if self.wide.at(i) != other.wide.at(i) then return false

        true
end CharSet

// A set with no characters.
empty_chars() -> CharSet = CharSet(0, 0, buf(), false)

// A copy of a set's list of non-ASCII characters, for a new set to own.
private wide_copy(w: Buf[u32]) -> Buf[u32]
    var out: Buf[u32] = buf()

    out.extend(w.view())
    out

// The set made of the regions of `a` and `b`'s listed characters that are kept -- those only `a`
// lists, those both list, those only `b` lists -- with flag `inverted`. Every operation of the
// algebra is one choice of regions over the two lists, once the flags have been read.
private regions(a: CharSet, b: CharSet, only_a: bool, both: bool, only_b: bool, inverted: bool) -> CharSet
    val lo = kept_bits(a.lo, b.lo, only_a, both, only_b)
    val hi = kept_bits(a.hi, b.hi, only_a, both, only_b)
    var wide: Buf[u32] = buf()
    var i: usize = 0
    var j: usize = 0

    while i < a.wide.len() || j < b.wide.len()
        if j == b.wide.len() || (i < a.wide.len() && a.wide.at(i) < b.wide.at(j))
            if only_a then wide.push(a.wide.at(i))

            i += 1
        elif i == a.wide.len() || b.wide.at(j) < a.wide.at(i)
            if only_b then wide.push(b.wide.at(j))

            j += 1
        else
            if both then wide.push(a.wide.at(i))

            i += 1
            j += 1

    CharSet(lo, hi, wide, inverted)

private kept_bits(a: u64, b: u64, only_a: bool, both: bool, only_b: bool) -> u64
    val common = a & b
    var out: u64 = 0

    if only_a then out = out | (a ^ common)

    if both then out = out | common

    if only_b then out = out | (b ^ common)

    out

// The characters of `s` as a set.
char_set(s: string) -> CharSet
    var set = empty_chars()

    for c in s.chars
        set.add(c)

    set
