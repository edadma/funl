module io.github.edadma.funl
@tests

// `while`, `repeat`, `for`, labelled `break` and `continue`, `break` with a value, and `return` out
// of loops.

@test
WHILE_RUNS_ITS_BODY_WHILE_ITS_CONDITION_SUCCEEDS_AND_THEN_FAILS()
    assert_eq(ran_funl("var n = 0\nwhile n < 3\n  write( n )\n  n += 1\nwrite( #done )\n"), "0\n1\n2\ndone\nsucceeded")
    assert_eq(ran_funl("if (while false) then write( #yes ) else write( #no )\n"), "no\nsucceeded")

// A failing statement inside a block is that statement's business; a body that fails as a whole
// ends its turn, and the loop goes on.
@test
A_TURN_WHOSE_BODY_FAILS_MOVES_ON_TO_THE_NEXT()
    assert_eq(ran_funl("var n = 0\nwhile n++ < 4\n  if n == 2 then fail\n  write( n )\n"), "1\n2\n3\n4\nsucceeded")
    assert_eq(ran_funl("var n = 0\nwhile n++ < 4 do n != 2 & write( n )\nwrite( #after )\n"), "1\n3\n4\nafter\nsucceeded")
    assert_eq(ran_funl("for x <- 1..4 do x != 2 & write( x )\n"), "1\n3\n4\nsucceeded")

@test
REPEAT_RUNS_ITS_BODY_UNTIL_A_BREAK()
    assert_eq(ran_funl("var n = 0\nrepeat\n  if n++ == 3 then break\n  write( n )\nwrite( n )\n"), "1\n2\n3\n4\nsucceeded")

@test
BREAK_LEAVES_THE_INNERMOST_LOOP_AND_A_LABELLED_BREAK_THE_LOOP_OF_THAT_NAME()
    val pairs = "1, 1\n1, 2\n2, 1\n2, 2\n3, 1\n4, 1\n4, 2\n"

    assert_eq(ran_funl("var i\nvar j\n\nouter: every i = 1 to 10\n  every j = 1 to 2\n    if 3 div i and j == 2 then break\n    if 5 div i then break outer\n\n    write( i, j )\n"),
        pairs + "succeeded")
    assert_eq(ran_funl("var i = 0\nvar j\n\nouter: while i++ < 10\n  j = 0\n\n  while j++ < 2\n    if 3 div i and j == 2 then break\n    if 5 div i then break outer\n\n    write( i, j )\n"),
        pairs + "succeeded")
    assert_eq(ran_funl("var i = 0\nvar j\n\nouter: repeat\n  if not i++ < 10 then break\n  j = 0\n\n  repeat\n    if j++ >= 2 then break\n    if 3 div i and j == 2 then break\n    if 5 div i then break outer\n\n    write( i, j )\n"),
        pairs + "succeeded")

@test
CONTINUE_STARTS_THE_NEXT_TURN_OF_THE_INNERMOST_LOOP_OR_OF_THE_LOOP_IT_NAMES()
    val pairs = "1, 1\n1, 2\n2, 1\n2, 2\n3, 1\n4, 1\n4, 2\n6, 1\n7, 1\n7, 2\n8, 1\n8, 2\n9, 1\n"

    assert_eq(ran_funl("var i\nvar j\n\nouter: every i = 1 to 10\n  every j = 1 to 2\n    if 3 div i and j == 2 then continue\n    if 5 div i then continue outer\n\n    write( i, j )\n"),
        pairs + "succeeded")
    assert_eq(ran_funl("var i = 0\nvar j\n\nouter: while i++ < 10\n  j = 0\n\n  while j++ < 2\n    if 3 div i and j == 2 then continue\n    if 5 div i then continue outer\n\n    write( i, j )\n"),
        pairs + "succeeded")
    assert_eq(ran_funl("var i = 0\nvar j\n\nouter: repeat\n  if not i++ < 10 then break\n  j = 0\n\n  repeat\n    if j++ >= 2 then break\n    if 3 div i and j == 2 then continue\n    if 5 div i then continue outer\n\n    write( i, j )\n"),
        pairs + "succeeded")
    assert_eq(ran_funl("outer: for i <- 1..3, j <- 1..3\n  if j > i then continue outer\n  write( i, j )\n"),
        "1, 1\n2, 1\n2, 2\n3, 1\n3, 2\n3, 3\nsucceeded")

@test
A_BREAK_WITH_A_VALUE_IS_THE_LOOPS_VALUE_AND_A_BARE_ONE_GIVES_UNIT()
    assert_eq(ran_funl("val cr =\n  for d <- 1..100\n    if d*d >= 12 then break (d)\n\nwrite( cr )\nwrite( (for x <- [1, 2, 3] do if x == 2 then break) )\n"),
        "4\n()\nsucceeded")

@test
RETURN_LEAVES_EVERY_LOOP_AROUND_IT()
    assert_eq(ran_funl("def f()\n  for x <- 1..10\n    while true\n      if x == 3 then return x * 100 else break\n\nwrite( f() )\n"),
        "300\nsucceeded")

@test
A_GENERATING_FUNCTION_YIELDS_FROM_A_LOOP_AND_BREAKS_OUT_OF_IT()
    val text = "def divisors( n )\n  val cr =\n    for d <- 1..n\n      if d*d >= n then break (d)\n      if d div n then yield d\n\n  if cr*cr == n then yield cr\n\nevery write( divisors(12) )\nevery write( divisors(16) )\n"

    assert_eq(ran_funl(text), "1\n2\n3\n1\n2\n4\nsucceeded")
    assert_eq(ran_funl("def evens( n )\n  for k <- 1..n if 2 div k do yield k\n\nevery write( evens(6) )\n"), "2\n4\n6\nsucceeded")

@test
FOR_ITERATES_RANGES_LISTS_AND_STRINGS_AND_FILTERS()
    assert_eq(ran_funl("for x <- 1..<5 if x != 2 do write( x )\n"), "1\n3\n4\nsucceeded")
    assert_eq(ran_funl("for x <- 10 to 1 by -3 do write( x )\n"), "10\n7\n4\n1\nsucceeded")
    assert_eq(ran_funl("for c <- \"ab\" do write( c )\n"), "a\nb\nsucceeded")
    assert_eq(ran_funl("if (for x <- [] do write( x )) then write( #yes ) else write( #spent )\n"), "spent\nsucceeded")

@test
FOR_PASSES_OVER_AN_ELEMENT_ITS_PATTERN_DOES_NOT_MATCH()
    assert_eq(ran_funl("for (a, 1) <- [(#x, 1), (#y, 2), (#z, 1)] do write( a )\n"), "x\nz\nsucceeded")

@test
A_LATER_FOR_BINDING_SEES_THE_EARLIER_ONES()
    assert_eq(ran_funl("for m <- 1..3, n <- m..3 if m + n == 4 do write( m, n )\n"), "1, 3\n2, 2\nsucceeded")

@test
BREAK_AND_CONTINUE_OUTSIDE_A_LOOP_ARE_REFUSED()
    assert_eq(complaints("break\n"), "error 1:1 `break` is written inside a loop\n")
    assert_eq(complaints("def f( x ) = continue\n"), "error 1:14 `continue` is written inside a loop\n")
    assert_eq(complaints("while true do break inner\n"), "error 1:15 no loop around this `break` is labelled `inner`\n")
    assert_eq(complaints("inner: while true\n  every 1 to 3 do continue inner\nwhile true do break inner\n"),
        "error 3:15 no loop around this `break` is labelled `inner`\n")

@test
A_LAMBDA_CANNOT_BREAK_THE_LOOP_IT_IS_WRITTEN_IN()
    assert_eq(complaints("while true\n  val f = () -> break\n"), "error 2:17 `break` is written inside a loop\n")
