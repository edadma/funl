module io.github.edadma.funl
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{Search, join}

// The standalone Prolog's top level (`toplevel.sysl`), driven end to end: a script of lines in, the
// session's transcript out -- each line read written after the prompt it was read under, then what
// the top level said -- and the status it ends with. This is the `prolog` executable with its
// terminal swapped for the script.

// A family the top level consults, saying so as it loads.
private const FamilyPl: string = "parent(tom, bob).\n" +
    "parent(tom, liz).\n" +
    "parent(bob, ann).\n" +
    "grandparent(X, Z) :- parent(X, Y), parent(Y, Z).\n" +
    ":- write(loaded), nl.\n"

private struct Session
    script: Buf[string]
    at: usize
    said: Buf[string]

// The transcript of a session over `files` reading `lines`, and its status after `status:`.
private session(files: []string, lines: []string) -> string
    var script: Buf[string] = buf()

    for l in lines
        script.push(l)

    val s: &Session = Session(script, 0, buf())

    val status = toplevel(files, (prompt) -> next_line(s, prompt), (text) -> s.said.push(text))

    s.said.push(s"status: $status")
    join(s.said.view(), "\n")

private next_line(s: &Session, prompt: string) -> Option[string]
    if s.at >= s.script.len() then return None

    val l = s.script.at(s.at)

    s.at += 1
    s.said.push(prompt + l)
    Some(l)

@test
A_QUERY_WITH_SEVERAL_SOLUTIONS_GIVES_THE_NEXT_FOR_EACH_SEMICOLON_AND_ENDS_WHERE_NOTHING_IS_LEFT()
    assert_eq(session([], ["member(X, [a, b, c]).", ";", ";"]),
        "?- member(X, [a, b, c]).\nX = a\n;\nX = b\n;\nX = c.\nstatus: 0")

@test
ANYTHING_BUT_A_SEMICOLON_STOPS_AT_THE_ANSWER_GIVEN()
    assert_eq(session([], ["member(X, [a, b]).", "", "X = 1."]),
        "?- member(X, [a, b]).\nX = a\n\n?- X = 1.\nX = 1.\nstatus: 0")

@test
A_BINDING_THAT_IS_ITS_OWN_CYCLE_IS_WRITTEN_WITH_ITS_OWN_NAME()
    assert_eq(session([], ["X = f(X).", "X = [a | X].", "X = f(g(X))."]),
        "?- X = f(X).\nX = f(X).\n?- X = [a | X].\nX = [a|X].\n?- X = f(g(X)).\nX = f(g(X)).\nstatus: 0")

@test
A_CYCLE_INSIDE_A_BINDING_IS_FACTORED_INTO_A_WHERE_BLOCK()
    assert_eq(session([], ["X = f(Y), Y = g(Y)."]),
        "?- X = f(Y), Y = g(Y).\nX = f(_S1), % where\n    _S1 = g(_S1),\nY = g(_S1).\nstatus: 0")

@test
FACTORED_CYCLES_ARE_NUMBERED_ACROSS_THE_ANSWER_AND_KEEP_THEIR_NAMES()
    // SWI-Prolog 10.0.2's answer: a node an earlier binding named keeps its name.
    assert_eq(session([], ["X = f(A, B), A = g(A), B = h(B), Z = k(B)."]),
        "?- X = f(A, B), A = g(A), B = h(B), Z = k(B).\n" +
        "X = f(_S1, _S2), % where\n    _S1 = g(_S1),\n    _S2 = h(_S2),\nA = g(_S1),\nB = h(_S2),\nZ = k(_S2).\nstatus: 0")

@test
A_BINDING_THAT_IS_ITS_OWN_CYCLE_AND_HOLDS_ANOTHER_IS_FACTORED_WHOLE()
    // SWI-Prolog 10.0.2's answer: the binding's own name stands for it only when its cycle is the one.
    assert_eq(session([], ["X = f(X, Y), Y = g(Y)."]),
        "?- X = f(X, Y), Y = g(Y).\nX = _S1, % where\n    _S1 = f(_S1, _S2),\n    _S2 = g(_S2),\nY = g(_S2).\nstatus: 0")

@test
AN_ANSWER_IS_WRITTEN_AS_SWI_PROLOGS_TOP_LEVEL_WRITES_IT()
    // SWI-Prolog 10.0.2: a space after each comma, and an operator term above 699 bracketed.
    assert_eq(session([], ["X = f(Y, Y), Y = g(a)."]), "?- X = f(Y, Y), Y = g(a).\nX = f(g(a), g(a)),\nY = g(a).\nstatus: 0")
    assert_eq(session([], ["X = [a, b | c], Y = {a, b}."]), "?- X = [a, b | c], Y = {a, b}.\nX = [a, b|c],\nY = {a, b}.\nstatus: 0")
    assert_eq(session([], ["X = (a, b), Y = (a :- b, c)."]), "?- X = (a, b), Y = (a :- b, c).\nX = (a, b),\nY = (a:-b, c).\nstatus: 0")
    assert_eq(session([], ["X = [1 + 2, a = b]."]), "?- X = [1 + 2, a = b].\nX = [1+2, a=b].\nstatus: 0")

@test
A_SEMICOLON_PAST_THE_LAST_SOLUTION_IS_FALSE()
    assert_eq(session([], ["(X = 1 ; fail).", ";"]), "?- (X = 1 ; fail).\nX = 1\n;\nfalse.\nstatus: 0")

@test
A_QUERY_THAT_BINDS_NOTHING_IS_TRUE_OR_FALSE()
    assert_eq(session([], ["1 < 2.", "2 < 1.", "atom(_Hidden)."]),
        "?- 1 < 2.\ntrue.\n?- 2 < 1.\nfalse.\n?- atom(_Hidden).\nfalse.\nstatus: 0")

@test
EVERY_BINDING_OF_AN_ANSWER_IS_SHOWN_QUOTED_AND_UNBOUND_ONES_ARE_LEFT_OUT()
    assert_eq(session([], ["X = 'A b', Y is 2 + 3, Z = Z."]), "?- X = 'A b', Y is 2 + 3, Z = Z.\nX = 'A b',\nY = 5.\nstatus: 0")

@test
A_FILE_NAMED_ON_THE_COMMAND_LINE_IS_CONSULTED_BEFORE_THE_FIRST_QUERY()
    val d = scratch()
    defer scrap(d)

    val family = put(d, "family.pl", FamilyPl)

    assert_eq(session([family], ["grandparent(tom, W).", ";", "parent(tom, C).", ";"]),
        "loaded\n?- grandparent(tom, W).\nW = ann\n;\nfalse.\n?- parent(tom, C).\nC = bob\n;\nC = liz.\nstatus: 0")

@test
CONSULT_FROM_THE_TOP_LEVEL_LOADS_A_FILE_TOO()
    val d = scratch()
    defer scrap(d)

    val family = put(d, "family.pl", FamilyPl)

    assert_eq(session([], [s"consult('$family').", "parent(bob, A)."]),
        s"?- consult('$family').\nloaded\ntrue.\n?- parent(bob, A).\nA = ann.\nstatus: 0")

@test
WHAT_A_QUERY_WRITES_COMES_BEFORE_ITS_ANSWER()
    assert_eq(session([], ["write(hello), nl, X = 1."]), "?- write(hello), nl, X = 1.\nhello\nX = 1.\nstatus: 0")

@test
A_QUERY_GOES_ON_OVER_LINES_UNTIL_ONE_ENDS_IN_A_FULL_STOP()
    assert_eq(session([], ["X = f(a,", "  b)."]), "?- X = f(a,\n|      b).\nX = f(a, b).\nstatus: 0")

@test
HALT_ENDS_THE_SESSION_AND_NOTHING_AFTER_IT_IS_READ()
    assert_eq(session([], ["halt.", "X = 1."]), "?- halt.\nstatus: 0")

@test
HALT_WITH_A_STATUS_ENDS_THE_SESSION_WITH_IT()
    assert_eq(session([], ["halt(3)."]), "?- halt(3).\nstatus: 3")

@test
THE_END_OF_INPUT_ENDS_THE_SESSION()
    assert_eq(session([], ["X = 1."]), "?- X = 1.\nX = 1.\nstatus: 0")

@test
THE_END_OF_INPUT_WHILE_AN_ANSWER_WAITS_ENDS_THE_SESSION()
    assert_eq(session([], ["member(X, [a, b])."]), "?- member(X, [a, b]).\nX = a\nstatus: 0")

@test
AN_UNCAUGHT_ERROR_IS_REPORTED_IN_ISO_FORM_AND_THE_SESSION_GOES_ON()
    assert_eq(session([], ["X is 1 / 0.", "atom_length(X, L).", "X = 1."]),
        "?- X is 1 / 0.\nuncaught exception: error(evaluation_error(zero_divisor),_)\n" +
        "?- atom_length(X, L).\nuncaught exception: error(instantiation_error,_)\n?- X = 1.\nX = 1.\nstatus: 0")

@test
A_BALL_THAT_IS_NOT_AN_ERROR_TERM_IS_REPORTED_AS_ITSELF()
    assert_eq(session([], ["throw(my_ball).", "catch(throw(b), B, true)."]),
        "?- throw(my_ball).\nuncaught exception: my_ball\n?- catch(throw(b), B, true).\nB = b.\nstatus: 0")

@test
AN_ERROR_RAISED_AFTER_A_FIRST_ANSWER_IS_REPORTED_WHEN_THE_SEMICOLON_REACHES_IT()
    assert_eq(session([], ["(X = 1 ; X is foo + 1).", ";"]),
        "?- (X = 1 ; X is foo + 1).\nX = 1\n;\nuncaught exception: error(type_error(evaluable,foo/0),_)\nstatus: 0")

@test
A_QUERY_THAT_DOES_NOT_READ_IS_REPORTED_AND_THE_SESSION_GOES_ON()
    val said = session([], ["X = .", "X = 2."])

    assert(said.starts_with("?- X = .\nerror: "), said)
    assert(said.ends_with("?- X = 2.\nX = 2.\nstatus: 0"), said)

@test
A_FILE_THAT_CANNOT_BE_READ_IS_AN_EXISTENCE_ERROR_AND_THE_SESSION_STARTS_ALL_THE_SAME()
    val d = scratch()
    defer scrap(d)

    assert_eq(session([s"$d/no_such_file.pl"], ["X = 1."]),
        s"uncaught exception: error(existence_error(source_sink,'$d/no_such_file.pl'),_)\n?- X = 1.\nX = 1.\nstatus: 0")

@test
A_FILE_WITH_A_SYNTAX_ERROR_IS_REPORTED_WITH_WHERE_AND_WHAT_WAS_EXPECTED()
    val d = scratch()
    defer scrap(d)

    val bad = put(d, "bad.pl", "foo(a).\nbar(X :- .\n")
    val where = s"$d/bad.pl"

    assert_eq(session([], [s"consult('$bad').", "X = 1."]),
        s"?- consult('$bad').\nuncaught exception: error(syntax_error('$where'),_)\n" +
        s"consult could not load $where:\nerror: `,` or `)` was expected here\n --> $where:2:7\n  |\n2 | bar(X :- .\n  |       ^^\n" +
        "?- X = 1.\nX = 1.\nstatus: 0")

@test
A_FILE_ON_THE_COMMAND_LINE_WITH_A_SYNTAX_ERROR_IS_REPORTED_WITH_WHERE_TOO()
    val d = scratch()
    defer scrap(d)

    val bad = put(d, "bad.pl", "p(X) :- X = (1 + ).\n")
    val said = session([bad], [])

    assert(said.contains(s" --> $d/bad.pl:1:18"), said)
    assert(said.contains("error: a term was expected here"), said)

// -- read/1 and read_term/2 read the lines after the query ------------------------------------------

@test
READ_TAKES_THE_NEXT_TERM_FROM_THE_LINES_AFTER_THE_QUERY()
    assert_eq(session([], ["read(X).", "hello(world).", "Y = 1."]),
        "?- read(X).\n|: hello(world).\nX = hello(world).\n?- Y = 1.\nY = 1.\nstatus: 0")

@test
READ_GOES_ON_OVER_LINES_AND_LEAVES_WHAT_FOLLOWS_A_TERM_FOR_THE_NEXT_READ()
    assert_eq(session([], ["read(A), read(B), read(C).", "a. b(", "  1). c."]),
        "?- read(A), read(B), read(C).\n|: a. b(\n|:   1). c.\nA = a,\nB = b(1),\nC = c.\nstatus: 0")

@test
READ_AT_THE_END_OF_THE_INPUT_IS_END_OF_FILE()
    assert_eq(session([], ["read(X)."]), "?- read(X).\nX = end_of_file.\nstatus: 0")

@test
READ_TERM_NAMES_THE_VARIABLES_AND_FINDS_THE_SINGLETONS()
    val query = "read_term(_T, [variable_names(_V), singletons(_S), variables(_Vs)]), _T = f(_A, _B, _C, _D, _E), " +
        "_V == ['X'=_A, 'Y'=_B, '_Z'=_D], _S == ['Y'=_B, '_Z'=_D], _Vs == [_A, _B, _D, _E], _A == _C."

    assert_eq(session([], [query, "f(X, Y, X, _Z, _)."]), s"?- $query\n|: f(X, Y, X, _Z, _).\ntrue.\nstatus: 0")

@test
READ_TERM_AT_THE_END_OF_THE_INPUT_GIVES_EMPTY_LISTS()
    assert_eq(session([], ["read_term(T, [variable_names(V), singletons(S)])."]),
        "?- read_term(T, [variable_names(V), singletons(S)]).\nT = end_of_file,\nV = [],\nS = [].\nstatus: 0")

@test
READ_OF_TEXT_THAT_DOES_NOT_READ_IS_A_SYNTAX_ERROR_SAYING_WHERE()
    assert_eq(session([], ["read(X).", "foo(.", "read(Y).", "bar."]),
        "?- read(X).\n|: foo(.\nuncaught exception: error(syntax_error('a term was expected here'),_)\n" +
        "error: a term was expected here\n --> user_input:1:5\n  |\n1 | foo(.\n  |     ^\n" +
        "?- read(Y).\n|: bar.\nY = bar.\nstatus: 0")

// -- It knows standard Prolog and no FunL ---------------------------------------------------------

@test
A_FUNL_BUILTIN_IS_NO_PREDICATE_THERE()
    assert_eq(session([], ["println(hi).", "abs(-1)."]),
        "?- println(hi).\nuncaught exception: error(existence_error(procedure,println/1),_)\n" +
        "?- abs(-1).\nuncaught exception: error(existence_error(procedure,abs/1),_)\nstatus: 0")

@test
A_PROLOG_FILE_CANNOT_IMPORT_FUNL_THERE()
    // `ShapesPl` imports `geometry.funl` and defines `area/2` over its `scaled` function
    // (`tests_prolog_import.sysl` runs it through `funl`, where it works). Here `import/1` is an
    // unknown procedure, so the directive warns and nothing the FunL file would have defined exists.
    val d = scratch()
    defer scrap(d)

    val said = session([put_shapes(d)], ["area(4, A)."])

    assert(said.contains("unknown procedure import/1"), said)
    assert(said.ends_with("?- area(4, A).\nuncaught exception: error(existence_error(procedure,scaled/2),_)\nstatus: 0"), said)

@test
AN_IMPORT_QUERY_IS_AN_UNKNOWN_PROCEDURE_THERE()
    assert_eq(session([], ["import(\"geometry.funl\")."]),
        "?- import(\"geometry.funl\").\nuncaught exception: error(existence_error(procedure,import/1),_)\nstatus: 0")

@test
HALT_IN_A_NESTED_GOAL_ENDS_THE_SESSION_WITH_ITS_STATUS_AFTER_WHAT_IT_WROTE()
    assert_eq(session([], ["write(a), nl, (true -> halt(3) ; true).", "X = 1."]),
        "?- write(a), nl, (true -> halt(3) ; true).\na\nstatus: 3")

@test
HALT_IS_NOT_CAUGHT_BY_CATCH()
    assert_eq(session([], ["catch(halt(2), _, true).", "X = 1."]), "?- catch(halt(2), _, true).\nstatus: 2")

@test
HALT_WITH_A_STATUS_THAT_IS_NOT_AN_INTEGER_IS_A_TYPE_ERROR_AND_THE_SESSION_GOES_ON()
    assert_eq(session([], ["halt(foo).", "catch(halt(1.5), error(E, _), true).", "halt(X)."]),
        "?- halt(foo).\nuncaught exception: error(type_error(integer,foo),_)\n" +
        "?- catch(halt(1.5), error(E, _), true).\nE = type_error(integer, 1.5).\n" +
        "?- halt(X).\nuncaught exception: error(instantiation_error,_)\nstatus: 0")

@test
HALT_IN_A_CONSULTED_FILES_DIRECTIVE_ENDS_THE_SESSION_BEFORE_ANY_QUERY()
    val d = scratch()
    defer scrap(d)

    val file = put(d, "stop.pl", "p :- write(stopping), nl, halt(4).\n:- p.\n:- write(never), nl.\n")

    assert_eq(session([file], ["X = 1."]), "stopping\nstatus: 4")

// `funl file`'s transcript over `text` as the contents of `file`, reading `lines`: what was said, the
// complaints after `complained:` where there were any, and the status after `status:`.
private driven(file: string, text: string, lines: []string) -> string
    var script: Buf[string] = buf()

    for l in lines
        script.push(l)

    val s: &Session = Session(script, 0, buf())
    val c: &Session = Session(buf(), 0, buf())

    val status = run_source(file, text, (prompt) -> next_line(s, prompt), (t) -> s.said.push(t), (t) -> if !t.is_empty() then c.said.push(t.trim()))

    if c.said.len() > 0 then s.said.push(s"complained: ${join(c.said.view(), "\n")}")

    s.said.push(s"status: $status")
    join(s.said.view(), "\n")

@test
FUNL_RUNNING_A_PROLOG_FILE_STARTS_THE_TOP_LEVEL_ONCE_IT_IS_LOADED()
    assert_eq(driven("family.pl", FamilyPl, ["X = 1.", "parent(tom, C).", ";"]),
        "loaded\n?- X = 1.\nX = 1.\n?- parent(tom, C).\nC = bob\n;\nC = liz.\nstatus: 0")

@test
FUNL_RUNNING_A_PROLOG_FILE_WITH_AN_INITIALIZATION_GOAL_RUNS_IT_AND_READS_NO_QUERY()
    assert_eq(driven("main.pl", "main :- write(hello), nl.\n:- initialization(main).\n", ["X = 1."]),
        "hello\nstatus: 0")

@test
FUNL_RUNNING_A_PROLOG_FILE_ENDS_WITH_THE_STATUS_A_DIRECTIVE_HALTS_WITH()
    assert_eq(driven("main.pl", "main :- write(hello), nl, halt(6).\n:- initialization(main).\n", []), "hello\nstatus: 6")
    assert_eq(driven("stop.pl", ":- halt.\n", ["X = 1."]), "status: 0")

@test
FUNL_RUNNING_A_PROLOG_FILE_REFUSED_READS_NO_QUERY()
    val said = driven("bad.pl", "p :- .\n", ["X = 1."])

    assert(said.contains("complained: ") && said.ends_with("status: 1") && !said.contains("?-"), said)

@test
A_FUNL_PROGRAM_CALLING_A_PREDICATE_THAT_HALTS_ENDS_WITH_ITS_STATUS()
    val d = scratch()
    defer scrap(d)

    val pl = put(d, "stop.pl", "stop(N) :- write(stopping), nl, halt(N).\n")

    assert_eq(driven("main.funl", s"import \"$pl\"\nwrite( 1 )\nstop( 9 )\nwrite( 2 )\n", ["X = 1."]), "1\nstopping\nstatus: 9")

@test
A_FUNL_FILE_STARTS_NO_TOP_LEVEL()
    assert_eq(driven("main.funl", "write( 1 )\n", ["X = 1."]), "1\nstatus: 0")
