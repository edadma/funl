module io.github.edadma.funl
@tests

import sysl.text.Search

// FunL's runtime errors as ISO error terms: each kind of fault a FunL operation raises, caught by a
// Prolog `catch/3` and its formal term written; a Prolog error crossing FunL frames; and what an
// error nothing catches prints.

// Prolog catching what FunL code raises, and a Prolog error crossing FunL frames. Each FunL function
// named here is a predicate one argument longer, its last argument the function's value; `through/2`
// is the FunL function `through/1`, which calls `boom/1`.
private const ErrorsPl: string = "try(Goal) :- catch((Goal, Formal = none), error(Formal, _), true), write(Formal), nl.\n" +
    "divide_by_zero :- try(divide(1, 0, _)).\n" +
    "floor_divide_by_zero :- try(floor_divide(1, 0, _)).\n" +
    "too_large :- try(power(2, 100000000000, _)).\n" +
    "not_an_integer :- try(divides(2.5, 5, _)).\n" +
    "not_a_number :- try(subtract(1, a, _)).\n" +
    "unbound :- try(add(_, 1, _)).\n" +
    "pattern_unbound :- try(head(_, _)).\n" +
    "no_clause :- try(head([], _)).\n" +
    "index_out_of_range :- try(element(5, _)).\n" +
    "missing_key :- ( lookup(b, _) -> write(found) ; write(failed) ), nl.\n" +
    "missing_field :- ( field_z(point(3, 4), _) -> write(found) ; write(failed) ), nl.\n" +
    "raised :- try(raise(boom, _)).\n" +
    "not_a_collection :- try(contains(3, 5, _)).\n" +
    "immutable :- try(store(x, _)).\n" +
    "wrong_count :- try(call_with_two(x, _)).\n" +
    "negative_size :- try(make_array(1, _)).\n" +
    "no_field :- try(field_z([1], _)).\n" +
    "no_scan :- try(tab_outside(1, _)).\n" +
    "exact_quotient :- divide(7, 2, Q), write(Q), nl, X is Q * 2, write(X), nl.\n" +
    "grown_sum :- add(9223372036854775807, 1, S), write(S), nl, integer(S).\n" +
    "real_sum :- add(1, 2.5, S), write(S), nl, float(S), X is S * 2, write(X), nl.\n" +
    "boom(_) :- throw(deep).\n" +
    "crossing(R) :- catch(through(1, R), E, R = caught(E)).\n" +
    "escape(X) :- through(X, _).\n"

// The FunL functions `ErrorsPl` calls, each raising when called as it does.
private const Program: string = "def divide( a, b ) = a / b\n" +
    "def floor_divide( a, b ) = a // b\n" +
    "def add( a, b ) = a + b\n" +
    "def subtract( a, b ) = a - b\n" +
    "def power( a, b ) = a ^ b\n" +
    "def divides( a, b ) = a div b\n" +
    "def head( h:_ ) = h\n" +
    "def element( i )\n" +
    "  val a = array( 2 )\n" +
    "  a( i ) = 0\n" +
    "def lookup( k ) = {a: 1}( k )\n" +
    "def raise( x ) = error( x )\n" +
    "def contains( x, c ) = x in c\n" +
    "def store( _ )\n" +
    "  val m = {a: 1}\n" +
    "  m.a = 2\n" +
    "def call_with_two( _ )\n" +
    "  val f = x -> x\n" +
    "  f( 1, 2 )\n" +
    "def through( n ) = if boom( n ) then 1 else 2\n" +
    "def make_array( n ) = array( 0 - n )\n" +
    "def field_z( p ) = p.z\n" +
    "def tab_outside( n ) = tab( n )\n"

// The transcript of `Program`, importing `ErrorsPl`, followed by `rest`.
private ran_program(rest: string) -> string
    val d = scratch()
    defer scrap(d)

    val file = put(d, "errors.pl", ErrorsPl)

    ran_funl(s"import \"$file\"\n" + Program + rest)

// What the Prolog predicate `goal`, run from FunL, writes: the formal term it caught.
private formal(goal: string) -> string = ran_program(s"$goal()\n")

@test
DIVIDING_BY_ZERO_IS_AN_EVALUATION_ERROR()
    assert_eq(formal("divide_by_zero"), "evaluation_error(zero_divisor)\nsucceeded")
    assert_eq(formal("floor_divide_by_zero"), "evaluation_error(zero_divisor)\nsucceeded")

@test
A_POWER_TOO_LARGE_TO_BUILD_IS_A_RESOURCE_ERROR()
    assert_eq(formal("too_large"), "resource_error(memory)\nsucceeded")

@test
DIV_OF_A_REAL_IS_A_TYPE_ERROR_NAMING_IT()
    assert_eq(formal("not_an_integer"), "type_error(integer,2.5)\nsucceeded")

@test
FUNLS_RATIONALS_BIG_INTEGERS_AND_REALS_ARE_PROLOG_NUMBERS()
    assert_eq(formal("exact_quotient"), "7r2\n7\nsucceeded")
    assert_eq(formal("grown_sum"), "9223372036854775808\nsucceeded")
    assert_eq(formal("real_sum"), "3.5\n7.0\nsucceeded")

@test
AN_OPERAND_OF_THE_WRONG_KIND_IS_A_TYPE_ERROR_NAMING_IT()
    assert_eq(formal("not_a_number"), "type_error(number,a)\nsucceeded")
    assert_eq(formal("not_a_collection"), "type_error(collection,5)\nsucceeded")

@test
AN_UNBOUND_OPERAND_AND_AN_UNBOUND_PATTERN_ARGUMENT_ARE_INSTANTIATION_ERRORS()
    assert_eq(formal("unbound"), "instantiation_error\nsucceeded")
    assert_eq(formal("pattern_unbound"), "instantiation_error\nsucceeded")

@test
NO_CLAUSE_MATCHING_IS_AN_EXISTENCE_ERROR_OF_A_MATCHING_CLAUSE()
    assert_eq(formal("no_clause"), "existence_error(matching_clause,head/1)\nsucceeded")

@test
STORING_PAST_THE_END_IS_AN_EXISTENCE_ERROR_BUT_A_MISSING_KEY_OR_FIELD_JUST_FAILS()
    assert_eq(formal("index_out_of_range"), "existence_error(index,5)\nsucceeded")
    assert_eq(formal("missing_key"), "failed\nsucceeded")
    assert_eq(formal("missing_field"), "failed\nsucceeded")

@test
FUNLS_ERROR_RAISES_A_USER_ERROR_HOLDING_ITS_ARGUMENT()
    assert_eq(formal("raised"), "user_error(boom)\nsucceeded")

@test
STORING_INTO_AN_IMMUTABLE_MAP_IS_A_PERMISSION_ERROR()
    // A map is opaque to Prolog, and written as one (`prolog.md` § "The term mapping").
    assert_eq(formal("immutable"), "permission_error(modify,immutable_map,<map>)\nsucceeded")

@test
CALLING_A_FUNCTION_WITH_THE_WRONG_NUMBER_OF_ARGUMENTS_IS_AN_EXISTENCE_ERROR_OF_THAT_PROCEDURE()
    assert_eq(formal("wrong_count"), "existence_error(procedure,lambda/2)\nsucceeded")

@test
A_VALUE_OUTSIDE_WHAT_A_BUILTIN_TAKES_IS_A_DOMAIN_ERROR()
    assert_eq(formal("negative_size"), "domain_error(not_less_than_zero,-1)\nsucceeded")

@test
A_FIELD_OF_A_VALUE_WITHOUT_FIELDS_AND_A_SCAN_THAT_IS_NOT_RUNNING_ARE_EXISTENCE_ERRORS()
    assert_eq(formal("no_field"), "existence_error(field,z)\nsucceeded")
    assert_eq(formal("no_scan"), "existence_error(scan,tab)\nsucceeded")

@test
A_PROLOG_ERROR_THROWN_INSIDE_A_FUNL_FUNCTION_IS_CAUGHT_BY_THE_PROLOG_CATCH_AROUND_IT()
    assert_eq(ran_program("free r\nif crossing( r ) then write( r )\n"), "caught(deep)\nsucceeded")

@test
A_BALL_NOTHING_CATCHES_ENDS_THE_RUN_AS_A_FAULT_NAMING_THE_BALL()
    assert_eq(unplaced(ran_program("write( #before )\nescape( 1 )\nwrite( #after )\n")),
        "before\nfault: boom/1: uncaught exception: deep")

@test
A_FUNL_ERROR_NOTHING_CATCHES_PRINTS_ITS_MESSAGE_AS_BEFORE()
    assert_eq(unplaced(ran_funl("write( 1 / 0 )\n")).index_of("1 / 0 divides by zero").is_some(), true)
    assert_eq(unplaced(ran_funl("error( \"stop here\" )\n")).index_of("fault: ").is_some(), true)
    assert_eq(unplaced(ran_funl("error( \"stop here\" )\n")).index_of(": stop here").is_some(), true)
