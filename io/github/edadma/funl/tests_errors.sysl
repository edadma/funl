module io.github.edadma.funl
@tests

import sysl.text.Search

// FunL's runtime errors as ISO error terms: each kind of fault a FunL operation raises, caught by a
// Prolog `catch/3` and its formal term written; a Prolog error crossing FunL frames; and what an
// error nothing catches prints.

private const Program: string = "import \"tests/prolog/errors.pl\"\n" +
    "def divide( a, b ) = a / b\n" +
    "def add( a, b ) = a + b\n" +
    "def subtract( a, b ) = a - b\n" +
    "def head( h:_ ) = h\n" +
    "def element( c, i ) = c( i )\n" +
    "def lookup( k ) = {a: 1}( k )\n" +
    "def raise( x ) = error( x )\n" +
    "def contains( x, c ) = x in c\n" +
    "def store( _ )\n" +
    "  val m = {a: 1}\n" +
    "  m.a = 2\n" +
    "def call_with_two( _ )\n" +
    "  val f = x -> x\n" +
    "  f( 1, 2 )\n" +
    "def through( n ) = if boom( n ) then 1 else 2\n" +
    "def make_array( n ) = array( 0 - n )\n" +
    "def field_z( p ) = p.z\n" +
    "def tab_outside( n ) = tab( n )\n"

// What the Prolog predicate `goal`, run from FunL, writes: the formal term it caught.
private formal(goal: string) -> string = ran_funl(Program + s"$goal()\n")

@test
DIVIDING_BY_ZERO_IS_AN_EVALUATION_ERROR()
    assert_eq(formal("divide_by_zero"), "evaluation_error(zero_divisor)\nsucceeded")

@test
AN_OVERFLOW_IS_AN_EVALUATION_ERROR()
    assert_eq(formal("overflow"), "evaluation_error(int_overflow)\nsucceeded")

@test
A_DIVISION_THAT_IS_NOT_WHOLE_IS_A_REPRESENTATION_ERROR_UNTIL_THERE_ARE_RATIONALS()
    assert_eq(formal("inexact"), "representation_error(rational)\nsucceeded")

@test
AN_OPERAND_OF_THE_WRONG_KIND_IS_A_TYPE_ERROR_NAMING_IT()
    assert_eq(formal("not_a_number"), "type_error(number, a)\nsucceeded")
    assert_eq(formal("not_a_collection"), "type_error(collection, 5)\nsucceeded")

@test
AN_UNBOUND_OPERAND_AND_AN_UNBOUND_PATTERN_ARGUMENT_ARE_INSTANTIATION_ERRORS()
    assert_eq(formal("unbound"), "instantiation_error\nsucceeded")
    assert_eq(formal("pattern_unbound"), "instantiation_error\nsucceeded")

@test
NO_CLAUSE_MATCHING_IS_AN_EXISTENCE_ERROR_OF_A_MATCHING_CLAUSE()
    assert_eq(formal("no_clause"), "existence_error(matching_clause, /(head, 1))\nsucceeded")

@test
AN_INDEX_OUT_OF_RANGE_AND_A_MISSING_KEY_ARE_EXISTENCE_ERRORS()
    assert_eq(formal("index_out_of_range"), "existence_error(index, 5)\nsucceeded")
    assert_eq(formal("missing_key"), "existence_error(key, b)\nsucceeded")

@test
FUNLS_ERROR_RAISES_A_USER_ERROR_HOLDING_ITS_ARGUMENT()
    assert_eq(formal("raised"), "user_error(boom)\nsucceeded")

@test
STORING_INTO_AN_IMMUTABLE_MAP_IS_A_PERMISSION_ERROR()
    assert_eq(formal("immutable"), "permission_error(modify, immutable_map, {\"a\": 1})\nsucceeded")

@test
CALLING_A_FUNCTION_WITH_THE_WRONG_NUMBER_OF_ARGUMENTS_IS_AN_EXISTENCE_ERROR_OF_THAT_PROCEDURE()
    assert_eq(formal("wrong_count"), "existence_error(procedure, /(lambda, 2))\nsucceeded")

@test
A_VALUE_OUTSIDE_WHAT_A_BUILTIN_TAKES_IS_A_DOMAIN_ERROR()
    assert_eq(formal("negative_size"), "domain_error(not_less_than_zero, -1)\nsucceeded")

@test
A_MISSING_FIELD_AND_A_SCAN_THAT_IS_NOT_RUNNING_ARE_EXISTENCE_ERRORS()
    assert_eq(formal("no_field"), "existence_error(field, z)\nsucceeded")
    assert_eq(formal("no_scan"), "existence_error(scan, tab)\nsucceeded")

@test
A_PROLOG_ERROR_THROWN_INSIDE_A_FUNL_FUNCTION_IS_CAUGHT_BY_THE_PROLOG_CATCH_AROUND_IT()
    assert_eq(ran_funl(Program + "free r\nif crossing( r ) then write( r )\n"), "caught(deep)\nsucceeded")

@test
A_BALL_NOTHING_CATCHES_ENDS_THE_RUN_AS_A_FAULT_NAMING_THE_BALL()
    assert_eq(unplaced(ran_funl(Program + "write( #before )\nescape( 1 )\nwrite( #after )\n")),
        "before\nfault: boom/1: uncaught exception: deep")

@test
A_FUNL_ERROR_NOTHING_CATCHES_PRINTS_ITS_MESSAGE_AS_BEFORE()
    assert_eq(unplaced(ran_funl("write( 1 / 0 )\n")).index_of("1 / 0 divides by zero").is_some(), true)
    assert_eq(unplaced(ran_funl("error( \"stop here\" )\n")).index_of("fault: ").is_some(), true)
    assert_eq(unplaced(ran_funl("error( \"stop here\" )\n")).index_of(": stop here").is_some(), true)
