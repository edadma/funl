module io.github.edadma.funl
@tests

import sysl.text.Search

// FunL programs, compiled from source and run on both heaps: the family tree, the machine's
// guarantees shown again from source, and each construct of a relation body and of ordinary code.

@test
THE_FAMILY_TREE_PRINTS_EVERY_ANSWER_THE_LOGIC_CHAPTER_GIVES_DUPLICATES_INCLUDED()
    val text = "def\n" +
        "  female(#anne)\n  female(#rosie)\n  female(#emma)\n  female(#olivia)\n  female(#mia)\n" +
        "  male(#randy)\n  male(#don)\n  male(#liam)\n  male(#logan)\n  male(#aiden)\n" +
        "  parent(#don, #randy)\n  parent(#don, #anne)\n  parent(#rosie, #randy)\n  parent(#rosie, #anne)\n" +
        "  parent(#liam, #don)\n  parent(#olivia, #don)\n  parent(#liam, #mia)\n  parent(#olivia, #mia)\n" +
        "  parent(#emma, #rosie)\n  parent(#logan, #rosie)\n  parent(#emma, #aiden)\n  parent(#logan, #aiden)\n" +
        "def\n" +
        "  father(x, y) :- male(x) & parent(x, y)\n" +
        "  siblings(x, y) :- parent(p, x) & parent(p, y) & x != y\n" +
        "  uncle(u, n) :- male(u) & siblings(u, p) & parent(p, n)\n" +
        "  grandparent(x, y) :- parent(x, p) & parent(p, y)\n" +
        "free who\n" +
        "every father(who, _) do write(who)\n" +
        "every grandparent(who, #randy) do write(who)\n" +
        "every uncle(who, #randy) do write(who)\n" +
        "if father(who, #mia) then write(who)\n"

    val want = "don\ndon\nliam\nliam\nlogan\nlogan\n" +
        "liam\nolivia\nemma\nlogan\n" +
        "aiden\naiden\n" +
        "liam\nsucceeded"

    assert_eq(ran_funl(text), want)

@test
A_VARIABLE_UNIFIED_WITH_ITSELF_SUCCEEDS_AT_ONCE()
    assert_eq(ran_funl("free x\nif x ~ x then write(#same)\n"), "same\nsucceeded")

// `y` is bound inside a bounded condition, whose `Unmark` commits; resuming `p` must still undo it,
// or `y ~ #b` fails and `b` is never written.
@test
A_BINDING_MADE_AFTER_A_CHOICE_POINT_IS_UNDONE_WHEN_IT_RESUMES_THROUGH_AN_UNMARK()
    val text = "def p(#a)\ndef p(#b)\nfree x, y\nevery p(x) do if y ~ x then write(y)\n"

    assert_eq(ran_funl(text), "a\nb\nsucceeded")

// `#tag` is pushed before `p` is called and popped by `!=` after `p` returns leaving a choice point:
// the second solution needs it back.
@test
A_RELATION_RETURNING_INTO_A_CALLER_WITH_OPERANDS_BELOW_ITS_MARKS_RESUMES_CORRECTLY()
    val text = "def p(#a)\ndef p(#b)\nfree x\nevery write(#tag != (p(x) & x))\n"

    assert_eq(ran_funl(text), "a\nb\nsucceeded")

@test
A_RULE_BODY_BLOCK_IS_ONE_CONJUNCTION_OF_ITS_LINES()
    val text = "def\n" +
        "  parent(#f, #a)\n" +
        "  parent(#f, #b)\n" +
        "  parent(#m, #a)\n" +
        "  parent(#m, #b)\n" +
        "  parent(#f, #c)\n" +
        "  full_siblings(a, b) :-\n" +
        "    parent(f, a) & parent(f, b)\n" +
        "    parent(m, a) & parent(m, b)\n" +
        "    a != b & f != m\n" +
        "free x, y\n" +
        "every full_siblings(x, y) do write(x) & write(y)\n" +
        "if full_siblings(#a, #a) then write(#wrong) else write(#right)\n" +
        "if full_siblings(#a, #c) then write(#wrong) else write(#right)\n"

    assert_eq(ran_funl(text), "a\nb\nb\na\na\nb\nb\na\nright\nright\nsucceeded")

@test
ALTERNATION_PRODUCES_EVERY_VALUE_OF_THE_LEFT_THEN_EVERY_VALUE_OF_THE_RIGHT()
    assert_eq(ran_funl("every write(#a | #b | #c)\n"), "a\nb\nc\nsucceeded")

@test
OR_AND_AND_ARE_ALTERNATION_AND_CONJUNCTION_BELOW_THE_OPERATORS()
    val text = "every write(#a or #b)\nif #a ~ #a and #b ~ #b then write(#both)\nif #a ~ #a and #b ~ #c then write(#wrong)\n"

    assert_eq(ran_funl(text), "a\nb\nboth\nsucceeded")

@test
A_RULE_ALTERNATION_TRIES_BOTH_BRANCHES_AND_A_RECURSIVE_RELATION_FINDS_EVERY_ANCESTOR()
    val text = "def\n" +
        "  parent(#a, #b)\n" +
        "  parent(#b, #c)\n" +
        "  parent(#c, #d)\n" +
        "  ancestor(x, y) :- parent(x, y) | parent(x, p) & ancestor(p, y)\n" +
        "free who\n" +
        "every ancestor(who, #d) do write(who)\n" +
        "every ancestor(#a, who) do write(who)\n"

    assert_eq(ran_funl(text), "c\na\nb\nb\nc\nd\nsucceeded")

@test
NOT_SUCCEEDS_EXACTLY_WHEN_ITS_GOAL_FAILS()
    val text = "def p(#a)\n" +
        "if not p(#b) then write(#no_b)\n" +
        "if not p(#a) then write(#no_a) else write(#has_a)\n" +
        "def q(x) :- not p(x)\n" +
        "if q(#a) then write(#wrong)\n" +
        "if q(#z) then write(#q_z)\n"

    assert_eq(ran_funl(text), "no_b\nhas_a\nq_z\nsucceeded")

@test
IF_WITHOUT_ELSE_FAILS_WHEN_ITS_CONDITION_DOES_AND_THE_STATEMENT_AFTER_IT_STILL_RUNS()
    assert_eq(ran_funl("if #a ~ #b then write(#wrong)\nwrite(#next)\n"), "next\nsucceeded")

@test
A_CONDITION_COMMITS_TO_ITS_FIRST_SOLUTION_AND_KEEPS_ITS_BINDINGS()
    val text = "def p(#a)\ndef p(#b)\nfree x\nif p(x) then write(x)\nwrite(x)\n"

    assert_eq(ran_funl(text), "a\na\nsucceeded")

@test
EVERY_UNDOES_ITS_BINDINGS_WHEN_IT_IS_EXHAUSTED()
    val text = "def p(#a)\nfree x\nevery p(x) do write(x)\nif x ~ #z then write(x)\n"

    assert_eq(ran_funl(text), "a\nz\nsucceeded")

@test
THEN_ELSE_AND_DO_OPEN_INDENTED_BLOCKS_OF_STATEMENTS()
    val text = "def p(#a)\n" +
        "def p(#b)\n" +
        "free x\n" +
        "if p(#a) then\n" +
        "  write(#one)\n" +
        "  write(#two)\n" +
        "else\n" +
        "  write(#three)\n" +
        "every p(x) do\n" +
        "  write(x)\n" +
        "  write(#after)\n"

    assert_eq(ran_funl(text), "one\ntwo\na\nafter\nb\nafter\nsucceeded")

@test
EQUALITY_AND_INEQUALITY_PRODUCE_THEIR_RIGHT_OPERAND_OR_FAIL()
    val text = "write(#a == #a)\nwrite(1 == 2)\nwrite(1 != 2)\nwrite(#a != #a)\nwrite('x' == 'x')\n"

    assert_eq(ran_funl(text), "a\n2\nx\nsucceeded")

@test
COMPARING_AN_UNBOUND_VARIABLE_IS_AN_INSTANTIATION_ERROR()
    val said = ran_funl("free x, y\nwrite(x != y)\n")

    assert(said.contains("fault: main@"), said)
    assert(said.contains("instantiation error: '!=' was given an unbound variable"), said)

// A term can be written in a head and not yet built in ordinary code, so the bound-argument half of
// `GetCompound` is `tests_relation.sysl`'s.
@test
A_HEAD_BINDS_AN_UNBOUND_ARGUMENT_TO_A_CONSTANT_A_NUMBER_A_STRING_OR_A_TERM()
    val text = "def owns(#don, car(#red, _))\n" +
        "def age(#don, 42)\n" +
        "def named(#don, 'Don')\n" +
        "free n, s, t\n" +
        "if owns(#don, t) then write(t)\n" +
        "if age(#don, n) then write(n)\n" +
        "if named(#don, s) then write(s)\n" +
        "if age(#don, 41) then write(#wrong)\n" +
        "if named(#don, 'don') then write(#wrong)\n"

    // `n`, `s` and `t` are variables 0 to 2, so the term's two fresh arguments are 3 and 4.
    assert_eq(ran_funl(text), "car(red, _G4)\n42\nDon\nsucceeded")

@test
A_REPEATED_HEAD_VARIABLE_UNIFIES_ITS_ARGUMENTS()
    val text = "def same(x, x)\nfree y\nif same(#a, #a) then write(#yes)\nif same(#a, #b) then write(#wrong)\nif same(y, #c) then write(y)\n"

    assert_eq(ran_funl(text), "yes\nc\nsucceeded")

@test
AN_ANONYMOUS_VARIABLE_IS_NEW_AT_EACH_OCCURRENCE()
    val text = "def pair(#a, #b)\ndef both(x) :- pair(x, _) & pair(_, _)\nfree x\nevery both(x) do write(x)\n"

    assert_eq(ran_funl(text), "a\nsucceeded")

@test
COMMENTS_ARE_DOUBLE_SEMICOLONS_AND_NESTING_BLOCKS_AND_SAY_NOTHING()
    val text = ";; a fact\ndef p(#a) ;; trailing\n/* a /* nested */ block */\n\n   ;; an indented comment line\nfree x\nevery p(x) do write(x)\n"

    assert_eq(ran_funl(text), "a\nsucceeded")

@test
A_WARNING_DOES_NOT_STOP_A_PROGRAM()
    assert_eq(ran_funl("def p(#a)\ndef q(x) :- p(y)\nif q(#z) then write(#ran)\n"), "ran\nsucceeded")

// `logic.md` § "Atoms": a name that means a constructor with no fields is that constructor's atom, in
// a head as in a body, never a clause variable.
@test
A_NULLARY_CONSTRUCTOR_IN_A_HEAD_MATCHES_ONLY_ITS_OWN_ATOM()
    val text = "data hue = red | green\n" +
        "def warm( red )\n" +
        "if warm(red) then write(#yes)\n" +
        "if warm(#red) then write(#same)\n" +
        "if warm(green) then write(#wrong)\n" +
        "if warm(#blue) then write(#wrong)\n"

    assert_eq(complaints(text), "")
    assert_eq(ran_funl(text), "yes\nsame\nsucceeded")

@test
AN_UNBOUND_CALL_ENUMERATES_THE_CONSTRUCTORS_A_HEAD_NAMES()
    val text = "data hue = red | green | blue\n" +
        "def\n" +
        "  label(red, 'r')\n" +
        "  label(green, 'g')\n" +
        "  label([blue], 'b')\n" +
        "free h, s, t, u\n" +
        "every label(h, s) do write(h, s)\n" +
        "if label(green, t) then write(t)\n" +
        "if label([blue], u) then write(u)\n"

    assert_eq(complaints(text), "")
    assert_eq(ran_funl(text), "red, r\ngreen, g\n[blue], b\ng\nb\nsucceeded")

@test
A_CONSTRUCTOR_DECLARED_AFTER_A_RELATION_IS_STILL_ITS_ATOM()
    val text = "def warm( red )\n" +
        "data hue = red | green\n" +
        "free h\n" +
        "if warm(h) then write(h)\n" +
        "if warm(green) then write(#wrong)\n"

    assert_eq(complaints(text), "")
    assert_eq(ran_funl(text), "red\nsucceeded")

@test
A_NULLARY_CONSTRUCTOR_IN_A_BODY_GOAL_IS_ITS_ATOM()
    val text = "data hue = red | green\n" +
        "def warm( red )\n" +
        "def hot(y) :- warm(red) & y ~ 1\n" +
        "def cold(y) :- warm(green) & y ~ 2\n" +
        "free a, b\n" +
        "if hot(a) then write(a)\n" +
        "if cold(b) then write(#wrong) else write(#none)\n"

    assert_eq(complaints(text), "")
    assert_eq(ran_funl(text), "1\nnone\nsucceeded")

@test
A_NAME_THAT_IS_NOT_A_CONSTRUCTOR_IS_STILL_A_CLAUSE_VARIABLE()
    val text = "data hue = red | green\n" +
        "def any( blue )\n" +
        "free h\n" +
        "if any(#anything) then write(#yes)\n" +
        "if any(h) then write(#unbound)\n"

    assert_eq(complaints(text), "warning 2:10 `blue` appears only once in this clause of `any`\n")
    assert_eq(ran_funl(text), "yes\nunbound\nsucceeded")

@test
A_CONSTRUCTOR_GIVEN_THE_WRONG_NUMBER_OF_FIELDS_IN_A_RELATION_BODY_IS_REFUSED()
    val text = "data point(x, y)\ndef p(z) :- z ~ point(1)\n"

    assert_eq(complaints(text), "error 2:17 the constructor `point` takes 2 fields, and this call gives 1\n")

// -- a relation sees the top level's `val`s (`logic.md` § "Variables in a relation", rule 2) ----------

@test
A_TOP_LEVEL_VAL_IN_A_RULE_BODY_MEANS_ITS_VALUE()
    val text = "val limit = 10\n" +
        "val origin = (0, 0)\n" +
        "def under(x) :- x < limit\n" +
        "def at_origin(p) :- p ~ origin\n" +
        "free q\n" +
        "if under(3) then write(#yes) else write(#no)\n" +
        "if under(30) then write(#yes) else write(#no)\n" +
        "if at_origin(q) then write(q)\n"

    assert_eq(complaints(text), "")
    assert_eq(ran_funl(text), "yes\nno\n(0, 0)\nsucceeded")

@test
A_HEAD_PARAMETER_NAMED_LIKE_A_TOP_LEVEL_VAL_IS_STILL_A_CLAUSE_VARIABLE()
    val text = "val limit = 10\ndef positive(limit) :- limit > 0\n" +
        "if positive(3) then write(#yes) else write(#no)\n" +
        "if positive(-3) then write(#yes) else write(#no)\n"

    assert_eq(complaints(text), "")
    assert_eq(ran_funl(text), "yes\nno\nsucceeded")

// Only what the top level fixes is seen: a `var` may change, so its name in a rule body is a fresh
// clause variable, warned about when written once and unbound when the goal needs a value.
@test
A_TOP_LEVEL_VAR_IN_A_RULE_BODY_STAYS_A_CLAUSE_VARIABLE()
    val text = "var n = 5\ndef small(x) :- x < n\nif small(3) then write(#yes)\n"

    assert_eq(complaints(text), "warning 2:21 `n` appears only once in this clause of `small`\n")

    val said = ran_funl(text)

    assert(said.contains("instantiation error: '<' was given an unbound variable"), said)

@test
A_NAME_NO_VAL_DECLARES_IN_A_RULE_BODY_IS_STILL_A_FRESH_UNBOUND_VARIABLE()
    val text = "val limit = 10\ndef under(x) :- x < limt\nif under(3) then write(#yes)\n"

    assert_eq(complaints(text), "warning 2:21 `limt` appears only once in this clause of `under`\n")

    val said = ran_funl(text)

    assert(said.contains("instantiation error: '<' was given an unbound variable"), said)

// The frame a relation of an imported FunL file reads its `val` from is that file's top level, not
// the importing program's.
@test
A_RELATION_IN_AN_IMPORTED_FUNL_FILE_SEES_THAT_FILES_VAL()
    val d = scratch()
    defer scrap(d)

    put(d, "limits.funl", "val scale = 10\nexport def big(n) :- n > scale\n")

    val text = s":- import(\"$d/limits.funl\").\n" +
        ":- (big(20) -> write(yes) ; write(no)), nl.\n" +
        ":- (big(5) -> write(yes) ; write(no)), nl.\n"

    assert_eq(ran_prolog(text), "yes\nno\nsucceeded")
