module io.github.edadma.funl

// The control stack: marks, choice points, restore points and catches, how failure walks it, and how
// a bounded expression or a cut commits.

enum EntryKind
    // The start of a bounded expression with somewhere to go if it fails: restore, jump to `ip`.
    Mark

    // A bounded expression whose failure is its enclosing context's business: restore, keep failing.
    MarkThrough

    // Something that can produce another result: restore, resume at `ip`.
    Choice

    // A call that returned leaving entries behind: put the caller's operand cells back, keep failing.
    Restore

    // A `catch/3` whose goal is running, in the frame of the `catch`: failure passes it by, and a
    // throw that unifies with its catcher resumes at `ip` (`catch.sysl`).
    Catch

    // FunL's `e catch ...` while `e` runs, in the frame it is written in: failure passes it by, and
    // any throw reaching it resumes at `ip` with the ball on the operand stack (`catch.sysl`).
    Trap

    // `e` of a `catch` has produced a value while choice points inside it stand: the `Trap` at height
    // `ip` is not reached by a throw from here on. Failure passes it by, which is what makes the trap
    // reachable again once `e` is resumed.
    Untrap

struct Entry
    kind: EntryKind

    // Where to resume, for `Mark` and `Choice`, in chunk `code` and frame `frame`.
    ip: usize
    code: usize
    frame: *FrameObj

    // The enclosing mark, put back on failure.
    mark: usize

    // Operand stack height this entry restores to, and where its saved cells start in `saved`.
    floor: usize
    saved_at: usize

    // Trail height when it was pushed, and the machine stamp it was pushed under.
    trail: usize
    stamp: u64

// The operand height the innermost mark guards: cells below it cannot change while the mark stands.
floor_of(v: *Vm, mark: usize) -> usize = if mark == NoMark then 0 else v.control.at(mark).floor

// Push an entry, saving the operand cells from `floor` to the top.
//
// **The stamp is bumped before it is recorded**, so a variable made before this entry has a stamp
// strictly below the entry's and one made after it has the entry's own.
push_entry(v: *Vm, kind: EntryKind, ip: usize, floor: usize)
    val saved_at = v.saved.len()

    for i in floor..<v.stack.len()
        v.saved.push(v.stack.at(i))

    v.stamp += 1
    v.control.push(Entry(kind, ip, v.code, v.frame, v.mark, floor, saved_at, v.trail.len(), v.stamp))

    if v.control.len() > v.control_peak then v.control_peak = v.control.len()

// Begin a bounded expression: a mark saves nothing, the cells above its floor being its own.
push_mark(v: *Vm, kind: EntryKind, on_fail: usize)
    push_entry(v, kind, on_fail, v.stack.len())
    v.mark = v.control.len() - 1

// A choice point saves the bounded expression's cells -- those above the innermost mark's floor --
// because the instructions after it may pop cells below the height it was pushed at.
push_choice(v: *Vm, alt: usize)
    push_entry(v, Choice, alt, floor_of(v, v.mark))

// Fail: pop entries, restoring each, until one resumes. Answers false when the control stack runs
// out, which is the whole run failing. A failure in a clause head that runs without a mark goes to
// the frame's failure target first (`head_fails`), popping nothing.
fail(v: *Vm) -> bool
    if head_fails(v) then return true

    loop
        val e = v.control.pop() match
            Some(e) -> e
            None -> return false

        restore(v, e)

        if e.kind == Mark || e.kind == Choice
            v.ip = e.ip
            return true
end fail

// Put back what entry `e`, just popped, saved: the trail undone to its height, its operand cells,
// its frame, chunk and mark. Failure and a throw restore an entry alike.
restore(v: *Vm, e: Entry)
    undo_trail_to(v, e.trail)
    v.stack.truncate(e.floor)

    for i in e.saved_at..<v.saved.len()
        v.stack.push(v.saved.at(i))

    v.saved.truncate(e.saved_at)
    v.frame = e.frame
    v.code = e.code
    v.mark = e.mark

// Discard every entry from height `h` up without failing: a commit. The trail is filtered, not
// unwound (`commit_trail`); `ends` says whether the commit ends a bounded expression, which makes
// the reversible assignments made inside it permanent, or is a cut, which does not.
cut_to(v: *Vm, h: usize, ends: bool)
    if v.control.len() <= h then return

    val first = v.control.at(h)

    v.saved.truncate(first.saved_at)
    v.control.truncate(h)
    commit_trail(v, first.trail, ends)

// End the innermost bounded expression: every entry above and including its mark goes, so nothing
// that ran inside it can be resumed, and the expression's cells go with them.
unmark(v: *Vm) -> Result[unit, string]
    if v.mark == NoMark then return Err("Unmark with no mark open")

    val at = v.mark
    val m = v.control.at(at)

    cut_to(v, at, true)
    v.stack.truncate(m.floor)
    v.mark = m.mark
    Ok(())

// End the bounded expression whose mark is at the place `recorded` holds, however many marks are
// open above it: what `break` and `continue` do to the marks between them and their loop.
unmark_to(v: *Vm, recorded: Value) -> Result[unit, string]
    val at = recorded match
        Int(n) -> usize(n)
        _ -> return Err("a loop's mark slot holds no mark")

    if at >= v.control.len() then return Err(s"a loop's mark $at is gone from a control stack of ${v.control.len()}")

    val m = v.control.at(at)

    cut_to(v, at, true)
    v.stack.truncate(m.floor)
    v.mark = m.mark
    Ok(())
