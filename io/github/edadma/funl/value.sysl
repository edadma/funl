module io.github.edadma.funl

// What a value is.
//
// **One value model for both languages the machine runs.** Both share the terms -- atoms, integers,
// compounds, lists and variables -- so a FunL record unifies with a Prolog term and prints the same.
// Prolog code makes a `Str` too, from double-quoted text, and a `Unit` as the value a predicate
// returns, as a FunL relation does; it never makes a `Tuple`, which only FunL code does.
//
// **A `Value` holds no reference-counted sysl member.** It is copied on every push, pop and slot
// read, and an ARC increment on each copy would be a cost on every instruction. Anything that owns
// storage -- a string's bytes, a compound's arguments -- lives inside a collected object that is
// that storage's only owner, and the object's finalizer gives it back.
enum Value
    // What an empty slot holds before anything is stored in it -- the value of a variable never
    // assigned, and of a name read after its block has ended -- and what an unbound logic
    // variable's `value` reads.
    Undefined

    Unit

    // The empty list.
    Nil

    // A number, in the four kinds of `dal`'s tower (`number.sysl`). **The two kinds that fit a word
    // are held inline**: `Int`, the fast path every loop counter and index takes, is matched and
    // added without leaving the value, and `Real` is a double carried the same way. The two that own
    // storage -- an integer past 64 bits and an exact fraction -- live in a collected `NumObj`, under
    // a tag of their own so a test of kind never reads the object.
    Int(n: long)
    Big(p: *NumObj)
    Rat(p: *NumObj)
    Real(x: real)

    // An interned name. Two atoms are the same atom exactly when their ids are equal.
    Atom(id: u32)

    Str(p: *StrObj)

    // A functor atom and its arguments: a record, a Prolog term.
    Compound(p: *CompoundObj)

    Tuple(p: *TupleObj)

    // A list cell.
    Cons(p: *ConsObj)

    // A logic variable, unbound or bound to another value.
    Var(p: *VarObj)

    Bool(b: bool)

    // A function value: compiled code and the frame it was made in. Two are equal, and unify,
    // exactly when they are the same object.
    Func(p: *ClosureObj)

    // `a..b`, `a..<b`, `a..`: the integers from `a` by a step, to an end or without one. Immutable,
    // and read as a list wherever one is: iterated, indexed, matched by `h:t` and `[]`.
    Range(p: *RangeObj)

    // A set of distinct values, in the order they were first added: `Set` immutable, written
    // `{a, b}`, and `MutSet` changed in place, made by `set(s)`. Both are kinds of one object.
    Set(p: *SetObj)
    MutSet(p: *SetObj)

    // A map from keys to values, in the order the keys were first added: `Map` immutable, written
    // `{k: v}`, and `MutMap` changed in place, made by `map(m)`. Both are kinds of one object.
    Map(p: *MapObj)
    MutMap(p: *MapObj)

    // A run of values changed in place: `Array` of a fixed length, made by `array(n)`, and `Buffer`,
    // which grows, made by `buffer()`. Both are kinds of one object.
    Array(p: *ArrayObj)
    Buffer(p: *ArrayObj)

    // A `data` constructor as a value: called, it makes a record; `id` indexes `Vm.ctors`.
    Ctor(id: u32)

    // A set of characters, `cset('aeiou')`, `letters`: what `upto`, `many` and `any` look for.
    CSet(p: *CSetObj)
end Value

// Follow bound variables until reaching something that is not one.
//
// **Every operation that inspects a value goes through this first**, so a bound variable is
// indistinguishable from what it is bound to everywhere but unification and the type tests that ask
// about variables as variables.
deref(v: Value) -> Value
    var at = v

    loop
        at match
            Var(p) ->
                if !p.bound then return at

                at = p.value
            _ -> return at
end deref
