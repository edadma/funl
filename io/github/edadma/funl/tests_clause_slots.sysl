module io.github.edadma.funl
@tests

import sysl.text.Search

// Reusing a failed clause's slots in the next clause (`clause_slots.sysl`): a clean head that fails
// into a clean clause binding the same slots first resumes that clause past its `FrameHead` and the
// shared prefix (`head_fails`); anything else runs the next clause from its start.

// The `FrameHead`s of the chunk named `name`, once `text` is compiled, in the order they lie: how
// many instructions of the next head each one's failure skips past its `FrameHead`, or `-` where it
// runs the next clause from its start.
private resumes_in(text: string, name: string) -> string
    var v = new_vm(RoomyHeap, RoomyFloor, 2)
    val was = enter(&v)

    val said = compiled_text(text) match
        Ok(_) -> counted_resumes(&v, name)
        Err(e) -> s"assembly: $e"

    dispose_vm(&v)
    leave(was)
    said

private counted_resumes(v: *Vm, name: string) -> string
    for ch in v.chunks.view()
        if ch.name == name
            var out = ""

            for o in ch.code.view()
                o match
                    FrameHead(_, next, _, resume) ->
                        if out != "" then out = out + ","

                        if resume == NoMark
                            out = out + "-"
                        else
                            val head = ch.code.at(next + 1) match
                                Branch(h) -> h
                                _ -> next + 1

                            out = out + s"${resume - head}"
                    _ -> ()

            return out

    s"no chunk '$name'"

// What a program said, which must have faulted with a message containing `want`.
private faults_with(text: string, want: string)
    val said = ran_funl(text)

    assert(said.contains("fault: "), said)
    assert(said.contains(want), said)

// -- fall-through that reuses ---------------------------------------------------------------------

// fib's first clause binds `n` and fails at its guard on half its calls; the second takes `n` as it
// stands and starts at its body.
@test
FIB_FALLS_THROUGH_TO_ITS_BODY_WITH_N_ALREADY_BOUND()
    val fib = "def fib( n ) | n < 2 = n\ndef fib( n ) = fib( n - 1 ) + fib( n - 2 )\n"

    assert_eq(resumes_in(fib, "fib"), "2,-")
    assert_eq(ran_funl(fib + "write( fib(0), fib(1), fib(2), fib(15) )\n"), "0, 1, 1, 610\nsucceeded")

// The last clause fails to `NoMatch`, and a reused clause that fails still reaches it.
@test
A_REUSED_CLAUSE_THAT_FAILS_REACHES_NO_MATCH()
    val text = "def r( n ) | n > 0 = #pos\ndef r( n ) | n < 0 = #neg\n"

    assert_eq(resumes_in(text, "r"), "2,-")
    assert_eq(ran_funl(text + "write( r(2), r(-2) )\n"), "pos, neg\nsucceeded")
    faults_with(text + "write( r(0) )\n", "no clause of 'r' matches (0)")

// -- clauses binding different slots --------------------------------------------------------------

// The first clause tests its second argument after binding `n`: the second clause reuses `n` and
// binds `m` itself.
@test
A_SHARED_FIRST_PARAMETER_IS_REUSED_AND_THE_REST_BOUND_AGAIN()
    val text = "def f( n, 0 ) = #zero\ndef f( n, m ) = n + m\n"

    assert_eq(resumes_in(text, "f"), "2,-")
    assert_eq(ran_funl(text + "write( f(1, 0), f(1, 2) )\n"), "zero, 3\nsucceeded")

// The next clause has more slots: they are `Undefined` until its `where` value binds them.
@test
THE_NEXT_CLAUSE_MAY_HAVE_MORE_SLOTS()
    val text = "def p( n ) | n > 10 = #big\ndef p( n ) = m * 2\n  where\n    m = n + 1\n"

    assert_eq(resumes_in(text, "p"), "2,-")
    assert_eq(ran_funl(text + "write( p(30), p(3) )\n"), "big, 8\nsucceeded")

// The first clause binds `m` before its guard fails, a slot the second does not bind the same way:
// it runs from its start.
@test
A_HEAD_THAT_BINDS_MORE_THAN_THE_SHARED_PREFIX_REUSES_NOTHING()
    val text = "def g( n, m ) | m > n = #up\ndef g( k, _ ) = k\n"

    assert_eq(resumes_in(text, "g"), "-,-")
    assert_eq(ran_funl(text + "write( g(1, 2), g(2, 1) )\n"), "up, 2\nsucceeded")

// The two heads bind slot 0 to different arguments: nothing is shared.
@test
HEADS_BINDING_DIFFERENT_ARGUMENTS_SHARE_NOTHING()
    val text = "def h( _, b ) | b > 0 = b\ndef h( a, _ ) = a\n"

    assert_eq(resumes_in(text, "h"), "-,-")
    assert_eq(ran_funl(text + "write( h(1, 5), h(7, -1) )\n"), "5, 7\nsucceeded")

// -- clean and unclean ----------------------------------------------------------------------------

// The second clause unifies, so it keeps its `Mark` and the first runs it from its start; its own
// failure goes by the mark to the third, from its start.
@test
A_CLEAN_CLAUSE_BEFORE_AN_UNCLEAN_ONE_REUSES_NOTHING()
    val text = "def s( n ) | n < 0 = #neg\ndef s( x ) | x ~ 3 = #three\ndef s( _ ) = #other\n"

    assert_eq(resumes_in(text, "s"), "-,-")
    assert_eq(ran_funl(text + "write( s(-1), s(3), s(5) )\n"), "neg, three, other\nsucceeded")

// A guard that generates keeps its clause's mark, and its choice points are gone by the time it
// fails: the next clause runs from its start with nothing of them left.
@test
A_GUARD_THAT_GENERATES_FAILS_BY_ITS_MARK()
    val text = "def up( n ) = 1 to n\ndef pick( n ) | up(3) > n = #found\ndef pick( n ) = n\n"

    assert_eq(resumes_in(text, "pick"), "-")
    assert_eq(ran_funl(text + "write( pick(1), pick(5) )\n"), "found, 5\nsucceeded")

// -- through an index stub ------------------------------------------------------------------------

// Key `0`'s chain is clauses 1, 3 and 4, so clause 1 has a stub failing to clause 3; the stub and
// clauses 1 and 2 reuse `n`, while clause 3 binds `m` and so runs clause 4 from its start.
@test
AN_INDEX_STUB_REUSES_THE_SLOTS_IT_SHARES_WITH_THE_NEXT_CLAUSE_OF_ITS_CHAIN()
    val text = "def t( n, 0 ) | n > 0 = #zero\ndef t( n, 1 ) = #one\ndef t( n, m ) | m > n = #up\ndef t( n, _ ) = n\n"

    assert_eq(resumes_in(text, "t"), "2,2,2,-,-")
    assert_eq(ran_funl(text + "write( t(5, 0), t(-5, 0), t(5, 1), t(1, 7), t(9, 7) )\n"),
        "zero, up, one, up, 9\nsucceeded")

// -- generators -----------------------------------------------------------------------------------

// A reused clause whose body generates: each value is made from the slot the failed clause bound.
@test
A_REUSED_CLAUSE_THAT_GENERATES_SEES_ITS_SLOTS_ON_EVERY_VALUE()
    val text = "def gen( n ) | n < 0 = 0\ndef gen( n ) = n * (1 to 3)\n"

    assert_eq(resumes_in(text, "gen"), "2,-")
    assert_eq(ran_funl(text + "every write( gen(-4) )\nevery write( gen(5) )\n"), "0\n5\n10\n15\nsucceeded")

// A clause whose body generates commits to it: its values are its own, and the next clause is tried
// only when its head fails.
@test
A_CLAUSE_THAT_GENERATES_NEVER_FALLS_THROUGH_FROM_ITS_BODY()
    val text = "def gen( n ) | n > 0 = n to n + 1\ndef gen( n ) = -n\n"

    assert_eq(resumes_in(text, "gen"), "2,-")
    assert_eq(ran_funl(text + "every write( gen(2) )\nevery write( gen(-7) )\n"), "2\n3\n7\nsucceeded")

// The caller's choice points lie below the frame: each value of `1 to 4` calls afresh, and a reused
// clause on one call leaves nothing for the next.
@test
A_CALLERS_CHOICE_POINTS_SEE_EACH_CALL_AFRESH()
    val text = "def sz( n ) | n < 3 = #small\ndef sz( n ) = n\n"

    assert_eq(resumes_in(text, "sz"), "2,-")
    assert_eq(ran_funl(text + "every write( sz(1 to 4) )\n"), "small\nsmall\n3\n4\nsucceeded")
