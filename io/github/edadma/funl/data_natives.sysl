module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// The builtins that make the mutable collections and take a snapshot of one: `array`, `buffer`, `map`,
// `set` and `seq`.

install_data(v: *Vm)
    register(v, "array", 1, do_array)
    register(v, "buffer", Variadic, do_buffer)
    register_forwarding(v, "map", Variadic, map_or_mapping)
    register(v, "set", Variadic, do_set)
    register(v, "seq", Variadic, do_seq)

// `array(n)`: an array of `n` elements, each `undefined` until something is stored. `array(c)`: an
// array of the elements of `c`.
private do_array(base: usize, argc: usize) -> Result[Value, Fault]
    val x = deref(arg(base, 0))

    x match
        Int(n) ->
            if n < 0 then return Err(domain_error("not_less_than_zero", x, s"an array cannot have $n elements"))

            return Ok(Array(new_array(usize(n))?))
        _ -> ()

    Ok(Array(filled(x, "'array'")?))

// `buffer()`: an empty buffer. `buffer(c)`: a buffer of the elements of `c`.
private do_buffer(base: usize, argc: usize) -> Result[Value, Fault]
    if argc > 1 then return Err(at_most_one("buffer", argc))

    if argc == 0 then return Ok(Buffer(new_array(0)?))

    Ok(Buffer(filled(arg(base, 0), "'buffer'")?))

// **One `map`, and its first argument decides** (`modules.md` § "The prelude"): `map(f, xs)` with a
// function `f` is the prelude's `map`, applying `f` to each element, and anything else is the
// constructor below. A function is not a collection to build a map from, so no call that made a map
// before means anything else now.
private map_or_mapping(base: usize, argc: usize) -> Result[Forward, Fault]
    if argc == 2
        deref(arg(base, 0)) match
            Func(_) | Ctor(_) -> return Ok(Into(prelude_function("map")?))
            _ -> ()

    Ok(Done(do_map(base, argc)?))

// `map()`: an empty mutable map. `map(m)`: a mutable map of the entries of map `m`, or of the pairs
// `(key, value)` a collection holds. `map(c, x)`: the same, with default `x`, which a lookup of a key
// the map does not hold answers instead of failing. The default is the one value `x`, shared by every
// such lookup, never a copy. `map(m)` of a map with a default takes its entries and not its default.
private do_map(base: usize, argc: usize) -> Result[Value, Fault]
    if argc > 2
        return Err(wrong_count("map", argc, s"'map' takes no argument, a collection, or a collection and a default, and was given $argc"))

    val m = new_map()?

    if argc == 0 then return Ok(MutMap(m))

    if argc == 2
        m.defaulted = true
        m.fallback = arg(base, 1)

    val x = deref(arg(base, 0))

    x match
        Map(p) -> copy_entries(m, p)?
        MutMap(p) -> copy_entries(m, p)?
        _ ->
            var items: Buf[Value] = buf()

            elements(x, "'map'", &items)?

            for e in items.view()
                deref(e) match
                    Tuple(t) ->
                        if t.items.len() != 2 then return Err(not_a_pair(e))

                        map_put(m, t.items.at(0), t.items.at(1))?
                    _ -> return Err(not_a_pair(e))

    Ok(MutMap(m))

// `set()`: an empty mutable set. `set(c)`: a mutable set of the elements of collection `c`, each
// once, in the order they first appear.
private do_set(base: usize, argc: usize) -> Result[Value, Fault]
    if argc > 1 then return Err(at_most_one("set", argc))

    val s = new_set()?

    if argc == 0 then return Ok(MutSet(s))

    var items: Buf[Value] = buf()

    elements(arg(base, 0), "'set'", &items)?

    for e in items.view()
        set_add(s, e)?

    Ok(MutSet(s))

private copy_entries(m: *MapObj, p: *MapObj) -> Result[unit, Fault]
    for i in 0..<p.keys.len()
        map_put(m, p.keys.at(i), p.vals.at(i))?

    Ok(())

// A builtin that takes no argument or one, given `argc`.
private at_most_one(name: string, argc: usize) -> Fault =
    wrong_count(name, argc, s"'$name' takes no argument or one collection, and was given $argc")

private not_a_pair(e: Value) -> Fault =
    type_error("pair", e, s"'map' makes an entry of a pair `(key, value)`, and was given ${described(e)}")

// `seq(c)`: the elements of `c` as they are now, in a tuple that nothing changes -- a snapshot of an
// array or a buffer. `seq()` is `()`.
private do_seq(base: usize, argc: usize) -> Result[Value, Fault]
    if argc > 1 then return Err(at_most_one("seq", argc))

    if argc == 0 then return Ok(Unit)

    var items: Buf[Value] = buf()

    elements(arg(base, 0), "'seq'", &items)?

    if items.len() == 0 then return Ok(Unit)

    val t = new_tuple(items.len())?

    for i in 0..<items.len()
        t.items.set(i, items.at(i))

    Ok(Tuple(t))

// A new array object holding the elements of collection `x`.
private filled(x: Value, what: string) -> Result[*ArrayObj, Fault]
    var items: Buf[Value] = buf()

    elements(x, what, &items)?

    val a = new_array(0)?

    for e in items.view()
        a.items.push(e)

    current().allocated += items.len() * sizeof(Value)
    Ok(a)
