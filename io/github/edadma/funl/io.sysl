module io.github.edadma.funl

import sysl.text.str_builder

// Output builtins.

install_io(v: *Vm)
    register(v, "write", Variadic, do_write)

// `write(a, b, ...)`: print the arguments as one line, separated by `, `, answering `()`.
private do_write(base: usize, argc: usize) -> Result[Value, string]
    var out = str_builder()

    for i in 0..<argc
        if i > 0 then out.push(", ")

        out.push(render(arg(base, i)))

    current().output.push(out.finish())
    Ok(Unit)
