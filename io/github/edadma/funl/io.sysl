module io.github.edadma.funl

import sysl.text.{Search, str_builder}

// Output builtins.

install_io(v: *Vm)
    register(v, "write", Variadic, do_write)
    register(v, "writes", Variadic, (b, n) -> put_to(false, b, n))
    register(v, "ewrite", Variadic, (b, n) -> put_to(true, b, n, true))
    register(v, "ewrites", Variadic, (b, n) -> put_to(true, b, n))
    register(v, "stop", Variadic, do_stop)
    register_generator(v, "read", 0, do_read)
    register_generator(v, "reads", 1, do_reads)

// `write(a, b, ...)`: print the arguments as one line, separated by `, `, answering `()`. A line
// `writes` or Prolog's `write/1` has begun is its start.
private do_write(base: usize, argc: usize) -> Result[Value, Fault]
    put_out(current(), joined_args(base, argc) + "\n")
    Ok(Unit)

// `t` onto standard output, now: what a program writes is written as it runs, never held for the end
// of the run, and a line it leaves unfinished stays unfinished. `v.line` keeps what the current line
// holds so far.
put_out(v: *Vm, t: string)
    if t.bytes.len == 0 then return

    v.put(t)
    v.line = unfinished(v.line, t)

// What a line holding `line` holds once `t` is written after it: what follows the last newline of
// `t`, or `line` and all of `t` where `t` has none.
unfinished(line: string, t: string) -> string = t.last_index_of_byte(u8('\n')) match
    Some(i) -> t.slice(i + 1, t.bytes.len)
    None -> line + t

// `t` onto standard error, now.
put_err(v: *Vm, t: string)
    if t.bytes.len > 0 then v.eput(t)

// The process's standard output: the default of `Vm.put`. C buffers it, as it buffers any program's,
// so `to_stderr`, a read of standard input (`stdin_line`, the drivers' line editor) and the exit push
// it out first.
to_stdout(t: string) = prints(t)

// The process's standard error, with what standard output holds pushed out ahead of it, so a terminal
// showing both shows them in the order the program wrote them.
to_stderr(t: string)
    flush()
    eprints(t)

// End the line standard output has begun, if it has: what the top level does before it answers.
end_line(v: *Vm)
    if v.line.bytes.len > 0 then put_out(v, "\n")

// The arguments of a call as text, separated by `sep`: `, ` as `write` separates them unless given.
private joined_args(base: usize, argc: usize, sep: string = ", ") -> string
    var out = str_builder()

    for i in 0..<argc
        if i > 0 then out.push(sep)

        out.push(render(arg(base, i)))

    out.finish()

// `writes(a, ...)` and `ewrites(a, ...)`: the arguments written one straight after another, as Icon
// writes them, with no separator and no newline, to standard output or, with `err`, standard error; a
// line a call leaves unfinished is continued by the next write to the same stream. `ewrite` is the
// separated, newline-ended form (`ended`), as `write` is.
private put_to(err: bool, base: usize, argc: usize, ended: bool = false) -> Result[Value, Fault]
    val text = joined_args(base, argc, if ended then ", " else "")

    val v = current()

    if err then put_err(v, if ended then text + "\n" else text) else put_out(v, text)

    Ok(Unit)

// `stop(a, ...)`: the arguments and a newline written to standard error, then the program ends with
// status 1. Nothing catches it, as nothing catches `halt`.
private do_stop(base: usize, argc: usize) -> Result[Value, Fault]
    put_err(current(), joined_args(base, argc) + "\n")
    Err(Exits(1))

// `read()`: the next line of standard input without its newline; fails at the end of the input.
private do_read(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    input_line("read")? match
        Some(l) -> Ok(Gives(new_str(l)?))
        None -> Ok(Refuses)

// `reads(n)`: the next `n` characters of standard input, newlines included; fewer when the input ends
// first, and failure when nothing is left. `n` is a positive integer.
private do_reads(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val x = deref(arg(base, 0))

    val n = x match
        Int(k) -> k
        Var(_) -> return Err(instantiation_error("instantiation error: 'reads' was given an unbound variable"))
        _ -> return Err(kind_error(x, "integer", s"'reads' wants an integer count and was given ${described(x)}"))

    if n < 1 then return Err(domain_error("positive_integer", x, s"'reads' wants a count of at least 1 and was given $n"))

    input_chars(usize(n), "reads")? match
        Some(t) -> Ok(Gives(new_str(t)?))
        None -> Ok(Refuses)
