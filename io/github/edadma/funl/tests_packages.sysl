module io.github.edadma.funl
@tests

import sh.sysl.parsing.*
import sysl.fs.{make_dir_all, read_text, symlink, write_text}
import sysl.path.parent
import sysl.text.{Search, str_builder}

// Packages (`packages.md`): a bare word names a package, found through the manifest that governs the
// importing file, in the project's `vendor/` or the cache, never fetched while a program runs.
//
// Every test builds its packages in a scratch cache it points `set_package_cache` at, and puts the
// setting back: nothing here reads the real cache, touches the network or runs git.

private has(text: string, part: string) -> bool = text.index_of(part).is_some()

// Write `text` to `rel` under `dir`, making the directories on the way, answering the file's path.
private put_at(dir: string, rel: string, text: string) -> string
    val file = s"$dir/$rel"

    make_dir_all(parent(file).unwrap()).unwrap()
    write_text(file, text).unwrap()
    file

// A manifest naming `name` at `version`, with `rest` -- further entries, each line starting `,` --
// after them.
private manifest(name: string, version: string, rest: string) -> string =
    s"{\n  name: \"$name\",\n  version: \"$version\"$rest\n}\n"

// A `dependencies` (or other) section holding `entries`.
private section(key: string, entries: string) -> string = s",\n  $key: {\n$entries\n  }"

private dep(name: string, git: string, version: string) -> string = s"    $name: { git: \"$git\", version: \"$version\" }"

private const TabularGit: string = "github.com/example/tabular"
private const KitGit: string = "github.com/example/csv-kit"

// Package `tabular` 0.2.0 into cache directory `cache`: its `main`, a module `pivot`, a Prolog file
// `rules`, a helper no manifest lists, and a dependency on `csv_kit` 0.2.0, which it imports itself.
private put_tabular(cache: string)
    val at = s"$TabularGit/@v0.2.0"

    put_at(cache, s"$at/package.funl", manifest("tabular", "0.2.0",
        ",\n  main: \"tabular.funl\",\n  modules: { pivot: \"pivot.funl\", rules: \"rules.pl\" }" +
        section("dependencies", dep("csv_kit", KitGit, "0.2.0"))))
    put_at(cache, s"$at/tabular.funl", "import { kit } from csv_kit\nexport def rows() = kit()\nexport def name() = \"tabular 0.2.0\"\n")
    put_at(cache, s"$at/pivot.funl", "export def pivot( x ) = 2 * x\n")
    put_at(cache, s"$at/rules.pl", "colour(red).\ncolour(green).\n")
    put_at(cache, s"$at/helper.funl", "export def secret() = 1\n")

// Package `csv_kit` at `version` into `cache`, its `kit()` saying which version it is.
private put_kit(cache: string, version: string)
    val at = s"$KitGit/@v$version"

    put_at(cache, s"$at/package.funl", manifest("csv_kit", version, ",\n  main: \"kit.funl\""))
    put_at(cache, s"$at/kit.funl", s"export def kit() = \"csv_kit $version\"\n")

// A project in `dir`, depending on `tabular` 0.2.0 and on whatever else `more` lists.
private put_project(dir: string, more: string)
    val deps = if more == "" then dep("tabular", TabularGit, "0.2.0") else dep("tabular", TabularGit, "0.2.0") + ",\n" + more

    put_at(dir, "package.funl", manifest("report", "0.1.0", section("dependencies", deps)))

// The compiled program in `file`, as the driver compiles it, or its diagnostics.
private file_compiled(file: string) -> Result[usize, string]
    val src = source_of(file, read_text(file).unwrap())
    var r = full_report()

    compile_program(src, &r) match
        Some(chunk) -> Ok(chunk)
        None -> Err(r.render(src))

// The Prolog program in `file`, loaded, or its diagnostics.
private pl_file_compiled(file: string) -> Result[usize, string]
    val src = source_of(file, read_text(file).unwrap())
    var r = full_report()

    prolog_program(src, &r) match
        Some(chunk) -> Ok(chunk)
        None -> Err(r.render(src))

private ran_file(file: string) -> string = ran(() -> file_compiled(file))
private ran_pl_file(file: string) -> string = ran(() -> pl_file_compiled(file))

// What compiling the program in `file` reports, one diagnostic a line: `severity line:col message`.
private file_complaints(file: string) -> string
    var v = new_vm(RoomyHeap, RoomyFloor, 2)
    val was = enter(&v)
    val src = source_of(file, read_text(file).unwrap())
    var r = full_report()
    var out = str_builder()

    compile_program(src, &r)

    for i in 0..<r.len()
        val d = r.at(i)

        out.push(s"${d.severity} ${src.locate(d.span.start)} ${d.message}\n")

    dispose_vm(&v)
    leave(was)
    out.finish()
end file_complaints

// The manifest whose text is `text`, read as `package.funl` on a VM of its own, as the resolver reads
// one while a program compiles.
private in_vm(text: string) -> Result[Manifest, string]
    var v = new_vm(RoomyHeap, RoomyFloor, 2)
    val was = enter(&v)
    val m = manifest_from_text("package.funl", text)

    dispose_vm(&v)
    leave(was)
    m

// A scratch directory with the cache at `cache/` holding `tabular` and `csv_kit` 0.2.0, and the
// project at `proj/` depending on `tabular`; the cache set to it.
private standard(d: string)
    set_package_cache(s"$d/cache")
    put_tabular(s"$d/cache")
    put_kit(s"$d/cache", "0.2.0")
    put_project(s"$d/proj", "")

@test
A_PACKAGE_IS_IMPORTED_BY_ITS_NAME_AND_ITS_OTHER_MODULES_WITH_A_SLASH()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    val main = put_at(d, "proj/main.funl", "import { rows } from tabular\n" +
        "import { pivot } from tabular/pivot\n" +
        "import * as t from tabular\n" +
        "import tabular/rules\n" +
        "free c\n" +
        "write( rows() )\n" +
        "write( pivot(21), t.name() )\n" +
        "every colour(c) do write( c )\n")

    assert_eq(ran_file(main), "csv_kit 0.2.0\n42, tabular 0.2.0\nred\ngreen\nsucceeded")

@test
A_PACKAGE_IS_TWO_IMPORTERS_ONE_MODULE()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)
    put_at(s"$d/cache", s"$TabularGit/@v0.2.0/pivot.funl", "export def pivot( x ) = 2 * x\nwrite( #loaded )\n")
    put_at(d, "proj/other.funl", "import { pivot } from tabular/pivot\nexport def twice( x ) = pivot(x)\n")

    val main = put_at(d, "proj/main.funl", "import { pivot } from tabular/pivot\nimport { twice } from \"other.funl\"\nwrite( pivot(1), twice(2) )\n")

    // The module's top level runs once: both importers reached one file, known by its real path.
    assert_eq(ran_file(main), "loaded\n2, 4\nsucceeded")

@test
A_PACKAGES_OWN_IMPORTS_REACH_ITS_OWN_DEPENDENCIES_AND_NEVER_THE_PROGRAMS()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    // `tabular` imports `csv_kit` (the first test); the program, which does not depend on it, cannot.
    val main = put_at(d, "proj/main.funl", "import { kit } from csv_kit\n")

    assert_eq(file_complaints(main), "error 1:21 unknown module `csv_kit`\n")
    assert(has(ran_file(main), "names `tabular`"))

    // A package naming a package its own manifest does not is refused against the package's line.
    put_at(s"$d/cache", s"$TabularGit/@v0.2.0/pivot.funl", "import { x } from report\nexport def pivot( x ) = x\n")

    val other = put_at(d, "proj/other.funl", "import { pivot } from tabular/pivot\n")
    val said = ran_file(other)

    assert(has(said, "pivot.funl` could not be loaded"))
    assert(has(said, "unknown module `report`"))
    assert(has(said, "names `csv_kit`"))

@test
A_PACKAGE_SPECIFIER_THE_MANIFESTS_DO_NOT_ANSWER_IS_REFUSED_WITH_WHAT_THEY_DO()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    val main = put_at(d, "proj/main.funl", "import { a } from tabluar\n" +
        "import { b } from tabular/pivto\n" +
        "import { c } from tabular/helper\n" +
        "import { d } from tabular.pivot\n" +
        "import { e } from tabular/rules\n")

    assert_eq(file_complaints(main),
        "error 1:19 unknown module `tabluar`\n" +
        "error 2:19 `tabular` has no module `pivto`\n" +
        "error 3:19 `tabular` has no module `helper`\n" +
        "error 4:19 unknown module `tabular.pivot`\n" +
        "error 5:19 `tabular/rules` is a Prolog file, which has no exports to choose from\n")

    val said = ran_file(main)

    assert(has(said, "names `tabular`"))
    assert(has(said, "its modules are `tabular/pivot` and `tabular/rules`"))
    assert(has(said, "a package's other module is written with a slash: `tabular/pivot`"))
    assert(has(said, "a Prolog file is imported whole, every predicate it defines with it: `import tabular/rules`"))

    // A package with no `main` is reached only through its modules.
    put_at(s"$d/cache", s"$KitGit/@v0.2.0/package.funl", manifest("csv_kit", "0.2.0", ""))
    put_project(s"$d/proj", dep("csv_kit", KitGit, "0.2.0"))

    val bare = put_at(d, "proj/bare.funl", "import { kit } from csv_kit\n")

    assert_eq(file_complaints(bare), "error 1:21 `csv_kit` has no `main`, so it is not imported by its name alone\n")
    assert(has(ran_file(bare), "`csv_kit` lists no modules"))

@test
A_FILE_UNDER_NO_PROJECT_HAS_NO_PACKAGES()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    val alone = put_at(d, "elsewhere/alone.funl", "import { rows } from tabular\n")

    assert_eq(file_complaints(alone), "error 1:22 unknown module `tabular`\n")
    assert(has(ran_file(alone), "and none is above it"))

    // A file under no project that imports no package is an ordinary program.
    assert_eq(ran_file(put_at(d, "elsewhere/fine.funl", "write( 1 )\n")), "1\nsucceeded")

@test
THE_PROJECT_IS_FOUND_BY_WALKING_UP_FROM_THE_ENTRY_FILES_REAL_PATH()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    val deep = put_at(d, "proj/src/tools/deep.funl", "import { pivot } from tabular/pivot\nwrite( pivot(5) )\n")

    assert_eq(ran_file(deep), "10\nsucceeded")

    // Reached through a symbolic link from outside the project, the program still finds it.
    make_dir_all(s"$d/bin").unwrap()
    symlink(deep, s"$d/bin/deep.funl").unwrap()
    assert_eq(ran_file(s"$d/bin/deep.funl"), "10\nsucceeded")

    assert_eq(project_of(s"$d/elsewhere.funl"), "")
    assert(project_of(deep).ends_with("/proj"))

@test
A_PACKAGE_NOT_ON_THE_MACHINE_IS_REFUSED_NAMING_FUNL_FETCH()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)
    set_package_cache(s"$d/empty")

    val main = put_at(d, "proj/main.funl", "import { rows } from tabular\n")

    assert_eq(file_complaints(main), s"error 1:22 tabular 0.2.0 is not in $d/empty/$TabularGit/@v0.2.0 -- run `funl fetch`\n")

@test
VENDOR_IS_READ_BEFORE_THE_CACHE_AND_NEEDS_NO_CACHE_AT_ALL()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    // The cache's layout inside the project, `@v` and all.
    put_tabular(s"$d/proj/vendor")
    put_kit(s"$d/proj/vendor", "0.2.0")
    put_at(s"$d/proj/vendor", s"$TabularGit/@v0.2.0/pivot.funl", "export def pivot( x ) = 3 * x\n")

    val main = put_at(d, "proj/main.funl", "import { pivot } from tabular/pivot\nimport { rows } from tabular\nwrite( pivot(1), rows() )\n")

    assert_eq(ran_file(main), "3, csv_kit 0.2.0\nsucceeded")

    set_package_cache(s"$d/empty")
    assert_eq(ran_file(main), "3, csv_kit 0.2.0\nsucceeded")

@test
FUNL_SUM_REFUSES_A_PACKAGE_WHOSE_CONTENTS_CHANGED()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    val dir = s"$d/cache/$TabularGit/@v0.2.0"
    val was = tree_hash(dir).unwrap()
    val main = put_at(d, "proj/main.funl", "import { pivot } from tabular/pivot\nwrite( pivot(2) )\n")

    // Unrecorded is not refused: recording is the fetch's job. Recorded and the same runs.
    assert_eq(ran_file(main), "4\nsucceeded")
    put_at(d, "proj/funl.sum", sum_line(SumEntry(TabularGit, "0.2.0", was)) + "\n")
    assert_eq(ran_file(main), "4\nsucceeded")

    // Changed: refused, naming the package and both hashes.
    put_at(s"$d/cache", s"$TabularGit/@v0.2.0/pivot.funl", "export def pivot( x ) = 5 * x\n")

    val now = tree_hash(dir).unwrap()

    assert(now != was)
    assert_eq(file_complaints(main), s"error 1:23 $TabularGit v0.2.0 does not match funl.sum: it was recorded as $was and is now $now\n")
    assert(has(ran_file(main), "the version's tag was moved after it was first fetched"))

@test
THE_TREE_HASH_IS_OF_PATHS_AND_CONTENTS_AND_LEAVES_GIT_OUT()
    val d = scratch()
    defer scrap(d)

    put_at(d, "a/x.funl", "ab")
    put_at(d, "a/sub/y.funl", "c")
    put_at(d, "b/sub/y.funl", "c")
    put_at(d, "b/x.funl", "ab")
    put_at(d, "b/.git/HEAD", "ref: refs/heads/main\n")

    // Where the files came from does not matter; what they hold, and where in the tree, does.
    assert_eq(tree_hash(s"$d/a"), tree_hash(s"$d/b"))
    assert(tree_hash(s"$d/a").unwrap().starts_with("sha256:"))

    put_at(d, "c/x.funl", "a")
    put_at(d, "c/sub/y.funl", "bc")
    assert(tree_hash(s"$d/a") != tree_hash(s"$d/c"))

    put_at(d, "e/z.funl", "ab")
    put_at(d, "e/sub/y.funl", "c")
    assert(tree_hash(s"$d/a") != tree_hash(s"$d/e"))

    assert(tree_hash(s"$d/nowhere").is_none())

@test
FUNL_SUM_IS_READ_A_LINE_A_VERSION()
    val d = scratch()
    defer scrap(d)

    put_at(d, "funl.sum", s"$TabularGit v0.2.0 sha256:aa\n$KitGit v0.10.1 sha256:bb\na line of four fields\n\n")

    val sums = read_sums(d)

    assert_eq(sums.len(), 2)
    assert_eq(sum_line(sums.at(0)), s"$TabularGit v0.2.0 sha256:aa")
    assert_eq(sums.at(1).version, "0.10.1")
    assert_eq(read_sums(s"$d/nowhere").len(), 0)

@test
TWO_VERSIONS_OF_ONE_PACKAGE_TAKE_THE_NEWER_AND_SAY_SO()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)
    put_kit(s"$d/cache", "0.1.0")

    // The project asks for `csv_kit` 0.1.0 and `tabular` for 0.2.0: one version is used, the newer.
    put_project(s"$d/proj", dep("csv_kit", KitGit, "0.1.0"))

    val main = put_at(d, "proj/main.funl", "import { kit } from csv_kit\nimport { rows } from tabular\nwrite( kit(), rows() )\n")

    assert_eq(file_complaints(main), "warning 1:21 `report` asks for `csv_kit` 0.1.0, and 0.2.0, the newer, is used -- `report` has never been run against it\n")
    assert_eq(ran_file(main), "csv_kit 0.2.0, csv_kit 0.2.0\nsucceeded")

    assert(newer_version("0.10.0", "0.9.0"))
    assert(!newer_version("0.9.0", "0.10.0"))
    assert(newer_version("1.0.1", "1.0"))
    assert(!newer_version("1.0", "1.0.0"))

@test
A_DEV_DEPENDENCY_IS_THE_PROJECTS_OWN_AND_NO_CONSUMERS()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)
    put_at(d, "proj/package.funl", manifest("report", "0.1.0",
        section("dependencies", dep("tabular", TabularGit, "0.2.0")) + section("devDependencies", dep("csv_kit", KitGit, "0.2.0"))))

    val main = put_at(d, "proj/main.funl", "import { kit } from csv_kit\nwrite( kit() )\n")

    assert_eq(ran_file(main), "csv_kit 0.2.0\nsucceeded")

    // `tabular`'s own dev dependency is never read: its files cannot import it.
    put_at(s"$d/cache", s"$TabularGit/@v0.2.0/package.funl", manifest("tabular", "0.2.0",
        ",\n  modules: { pivot: \"pivot.funl\" }" + section("devDependencies", dep("check", "github.com/example/check", "0.1.0"))))
    put_at(s"$d/cache", s"$TabularGit/@v0.2.0/pivot.funl", "import { c } from check\nexport def pivot( x ) = x\n")

    val other = put_at(d, "proj/other.funl", "import { pivot } from tabular/pivot\n")

    assert(has(ran_file(other), "unknown module `check`"))

@test
A_PACKAGE_NEEDING_A_NEWER_FUNL_IS_REFUSED_NAMING_BOTH_VERSIONS()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    val at = s"$TabularGit/@v0.2.0/package.funl"
    val main = put_at(d, "proj/main.funl", "import { pivot } from tabular/pivot\nwrite( pivot(1) )\n")

    put_at(s"$d/cache", at, manifest("tabular", "0.2.0", ",\n  funl: \"99.0.0\",\n  modules: { pivot: \"pivot.funl\" }"))
    assert_eq(file_complaints(main), s"error 1:23 `tabular` 0.2.0 needs FunL 99.0.0 or newer, and this is FunL $FunlVersion\n")

    put_at(s"$d/cache", at, manifest("tabular", "0.2.0", s",\n  funl: \"$FunlVersion\",\n  modules: { pivot: \"pivot.funl\" }"))
    assert_eq(ran_file(main), "2\nsucceeded")

@test
CONSTRUCTORS_ARE_UNIQUE_ACROSS_PACKAGES_AND_THE_REFUSAL_NAMES_BOTH()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    set_package_cache(s"$d/cache")

    for name in ["trees", "bushes"]
        put_at(s"$d/cache", s"github.com/example/$name/@v0.1.0/package.funl", manifest(name, "0.1.0", s",\n  main: \"$name.funl\""))
        put_at(s"$d/cache", s"github.com/example/$name/@v0.1.0/$name.funl", s"export data $name = leaf | node(l, v, r)\n")

    put_at(d, "proj/package.funl", manifest("garden", "0.1.0",
        section("dependencies", dep("trees", "github.com/example/trees", "0.1.0") + ",\n" + dep("bushes", "github.com/example/bushes", "0.1.0"))))

    val main = put_at(d, "proj/main.funl", "import { node } from trees\nimport * as b from bushes\n")
    val said = ran_file(main)

    assert(has(said, "the constructor `node` of 3 fields is already declared at"))
    assert(has(said, "constructors are unique across the whole program, packages included, so package `trees` 0.1.0 and package `bushes` 0.1.0 cannot be used together"))

@test
PROLOG_NAMES_A_PACKAGE_WITH_AN_ATOM_AND_A_FILE_WITH_A_STRING()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)

    val prog = put_at(d, "proj/p.pl", ":- import(tabular/pivot).\n" +
        ":- import(tabular/rules).\n" +
        ":- import(tabular).\n" +
        ":- initialization(main).\n" +
        "main :- pivot(4, X), write(X), nl, rows(R), write(R), nl, colour(C), write(C), nl, fail.\n" +
        "main.\n")

    assert_eq(ran_pl_file(prog), "8\ncsv_kit 0.2.0\nred\ngreen\nsucceeded")

    val bad = put_at(d, "proj/q.pl", ":- import(tabluar).\n:- import(tabular/pivto).\n:- import(3).\n")
    val said = ran_pl_file(bad)

    assert(has(said, "unknown module `tabluar`"))
    assert(has(said, "`tabular` has no module `pivto`"))
    assert(has(said, "import names a file with a string, or a package with an atom"))

@test
A_BROKEN_MANIFEST_IS_SAID_IN_FULL_ONCE_A_RUN()
    val d = scratch()
    defer scrap(d)
    defer set_package_cache("")

    standard(d)
    put_at(d, "proj/package.funl", "{\n  name: report,\n  version: \"0.1.0\"\n}\n")

    val main = put_at(d, "proj/main.funl", "import { rows } from tabular\nimport { pivot } from tabular/pivot\n")
    val said = ran_file(main)

    assert(has(said, "package.funl` could not be read\n"))
    assert(has(said, "a manifest is data, and the name `report` is not"))
    assert(has(said, "package.funl` could not be read, as said above"))

    val first = said.index_of("the name `report`").unwrap()
    val after = said.slice(first + 1, said.bytes.len)

    assert(!has(after, "the name `report`"))

@test
A_MANIFEST_IS_DATA_AND_EVERY_MISTAKE_IN_IT_IS_REPORTED()
    val good = in_vm("{\n" +
        "  name: \"tabular\",\n" +
        "  \"version\": \"0.2.0\",\n" +
        "  funl: \"0.0.4\",\n" +
        "  main: \"tabular.lfunl\",\n" +
        "  description: \"rows\", homepage: \"https://example.com\", license: \"ISC\",\n" +
        "  modules: { pivot: \"pivot.funl\", rules: \"rules.pl\" },\n" +
        "  dependencies: { csv_kit: { git: \"github.com/example/csv-kit\", version: \"0.2.0\" } },\n" +
        "  devDependencies: { check: { git: \"github.com/example/check\", version: \"0.1.0\" } }\n" +
        "}\n").unwrap()

    assert_eq(good.name, "tabular")
    assert_eq(good.version, "0.2.0")
    assert_eq(good.floor, Some("0.0.4"))
    assert_eq(good.main, Some("tabular.lfunl"))
    assert_eq(good.module_file("rules"), Some("rules.pl"))
    assert_eq(good.dependency("csv_kit", false).unwrap().git, "github.com/example/csv-kit")
    assert(good.dependency("check", false).is_none())
    assert_eq(good.dependency("check", true).unwrap().version, "0.1.0")

    // Not data: each refused by what it is, all of them reported.
    val code = in_vm("{\n  name: tabular,\n  version: 1 + 2,\n  license: f(x),\n  description: #atom\n}\n").unwrap_err()

    assert(has(code, "a manifest is data, and the name `tabular` is not"))
    assert(has(code, "a manifest is data, and a `+` between two things is not"))
    assert(has(code, "a manifest is data, and a call is not"))
    assert(has(code, "a manifest is data, and the atom `#atom` is not"))
    assert(has(code, "is never run"))

    // Data of the wrong shape.
    val shape = in_vm("{\n" +
        "  name: \"t\",\n" +
        "  version: \"0.1.0\",\n" +
        "  scripts: {},\n" +
        "  main: \"t.txt\",\n" +
        "  modules: { \"my-mod\": \"m.funl\", ok: 3 },\n" +
        "  dependencies: { \"csv-kit\": { git: \"g\", version: \"1\" }, a: { git: \"g\" }, b: { version: \"1\", tag: \"x\" }, c: 4 },\n" +
        "  devDependencies: { d: { git: \"g\", version: \"1\" } },\n" +
        "  name: \"u\"\n" +
        "}\n").unwrap_err()

    assert(has(shape, "`scripts` is not a manifest key"))
    assert(has(shape, "`main` names `t.txt`, which is neither a FunL module nor a Prolog file"))
    assert(has(shape, "`my-mod` cannot be written bare in an import, so it cannot name a module"))
    assert(has(shape, "`ok` is a string"))
    assert(has(shape, "`csv-kit` cannot be written bare in an import, so it cannot name a package"))
    assert(has(shape, "the package `a` names its exact `version`"))
    assert(has(shape, "the package `b` names its `git` repository"))
    assert(has(shape, "`tag` is not a key of a dependency"))
    assert(has(shape, "the package `c` is written `{ git: \"...\", version: \"...\" }`"))
    assert(has(shape, "the key `name` is written twice"))

    // A name in both sections; the required keys; one map and nothing else.
    val both = in_vm("{\n  name: \"t\",\n  version: \"1\",\n  dependencies: { d: { git: \"g\", version: \"1\" } },\n  devDependencies: { d: { git: \"g\", version: \"1\" } }\n}\n").unwrap_err()

    assert(has(both, "`d` is in both `dependencies` and `devDependencies`, and a package is one or the other"))
    assert(has(in_vm("{}\n").unwrap_err(), "a manifest names its `name`"))
    assert(has(in_vm("{}\n").unwrap_err(), "a manifest names its `version`"))
    assert(has(in_vm("[1, 2]\n").unwrap_err(), "a manifest is one map"))
    assert(has(in_vm("").unwrap_err(), "a manifest is one map"))
    assert(has(in_vm("{name: \"t\", version: \"1\"}\n{}\n").unwrap_err(), "a second thing after it"))
    assert(has(in_vm("import \"x.funl\"\n{name: \"t\", version: \"1\"}\n").unwrap_err(), "imports nothing"))
    assert(has(in_vm("def f( x ) = x\n{name: \"t\", version: \"1\"}\n").unwrap_err(), "defines nothing"))

    // Every data kind is accepted where a key's value is not read.
    assert(in_vm("{name: \"t\", version: \"1\", description: \"d\"}\n").is_ok())
    assert(has(in_vm("{name: \"t\", version: \"1\", description: [1, -2.5, true, ()]}\n").unwrap_err(), "`description` is a string"))

    // A manifest that does not parse reports the parser's complaint and nothing about data.
    val broken = in_vm("{ name: \n").unwrap_err()

    assert(!has(broken, "a manifest is data"))
    assert(has(read_manifest("/nowhere/package.funl").unwrap_err(), "cannot be read"))

@test
THE_VERSION_FUNL_REPORTS_IS_THE_ONE_ITS_MANIFESTS_DECLARE()
    for file in ["package.hocon", "funl/package.hocon", "prolog/package.hocon"]
        assert(has(read_text(file).unwrap(), s"version = \"$FunlVersion\""), s"$file declares another version than FunlVersion")
