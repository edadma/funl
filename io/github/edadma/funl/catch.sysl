module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// `catch/3` and `throw/1`, and FunL's `catch` and `throw`.
//
// **`catch(G, C, R)` is a predicate with a chunk of its own**, so it runs in a frame of its own:
//
//     Frame(1); SaveHeight(0); PushCatch(r); LoadArg(0); CallGoal(0); ExitCatch(0); Return
//     r: LoadArg(2); CallGoal(0); Return
//
// `PushCatch` leaves a `Catch` entry naming that frame and the recovery's address. The goal is called
// as `call/1` calls it, so a cut inside it is local to it. When the goal succeeds with nothing left to
// resume, `ExitCatch` takes the entry off; when it leaves choice points, the entry stays beneath them
// so that backtracking into the goal finds the catch still there.
//
// **A catch is active exactly while its frame is one the throw is running inside**: on the chain of
// callers from the throwing frame. That is how ISO's "the catch/3 call is still being executed" reads
// on this machine -- a goal that has succeeded has returned from the `catch` frame, so a throw after
// it does not see the catch even while the entry stands, and backtracking into the goal reinstates
// frames whose callers lead back through it. **The frame cannot have been reused** by a tail call
// while its entry stands, since a frame with entries above its own is never reused.
//
// **A throw copies the ball, then unwinds** the control stack entry by entry, restoring each exactly
// as failure does -- the trail undone, the operand cells, frame, chunk and mark put back -- until an
// active `Catch` whose catcher unifies with a fresh copy of the ball. The recovery then runs in the
// catch's frame. A copy for each catcher, because a catcher that unifies part of the ball and then
// fails leaves bindings no entry may undo, and the next catcher must see the ball as thrown.
//
// **FunL's `e catch p | g -> r` is the same entry written inline**, a `Trap` in the frame the
// expression is in, which catches every ball and leaves the matching to code:
//
//     SaveHeight(h); PushTrap(r); e; ExitTrap(h); Branch(end)
//     r:  Mark(no); Dup; <match p>; g; FailIfFalse; Unmark; Pop; <recovery>; Branch(end)
//     no: Rethrow
//     end:
//
// The recovery starts with the ball on the operand stack. A pattern or guard that refuses it fails
// to the mark, which leaves the ball where it was for `Rethrow` to throw again.
//
// **An inline catch has no frame of its own to return from**, so what ends it is not a return but
// `ExitTrap`. When `e` produced its value with nothing left to resume, the `Trap` goes. When `e`
// left choice points, the `Trap` must stay beneath them -- backtracking into `e` is still inside the
// catch, as ISO's catch/3 is transparent to backtracking -- but the code after `e` in the same frame
// is not: so `ExitTrap` pushes an `Untrap` naming the trap's height. A throw unwinding past the
// `Untrap` passes the trap by; failure pops the `Untrap` on its way back into `e`, which is exactly
// when the trap is in force again.

// The chunk of `catch/3`.
catch_chunk() -> usize
    var e = emit("catch/3")
    val r = e.label()

    e.op(Frame(1))
    e.op(SaveHeight(0))
    e.op(PushCatch(r))
    e.op(LoadArg(0))
    e.op(CallGoal(0))
    e.op(ExitCatch(0))
    e.op(Return)
    e.place(r)
    e.op(LoadArg(2))
    e.op(CallGoal(0))
    e.op(Return)
    finish(e).unwrap()

// `PushCatch(to)`: a `Catch` entry in the running frame, which saves no operand cells.
push_catch(v: *Vm, to: usize)
    push_entry(v, Catch, to, v.stack.len())

// `ExitCatch(slot)`: the catch's goal succeeded; its entry goes when nothing stands above it.
exit_catch(v: *Vm, slot: usize) -> Result[unit, string]
    val h = saved_height(v, slot)?

    if v.control.len() == h + 1 && v.control.at(h).kind == Catch then cut_to(v, h, false)

    Ok(())

// Compile `e catch p | g -> r`, block `id` holding `p`'s names and the height slot.
compile_catch(e: *Emit, c: Ctx, id: usize, subject: &Expr, pat: &Expr, guard: Option[&Expr], recovery: &Expr) -> Result[unit, string]
    val inner = c.in_block(id)?
    val h = slot_of_name(inner, trap_name(id))?
    val r = e.label()
    val no = e.label()
    val end = e.label()

    e.op(SaveHeight(h))
    e.op(PushTrap(r))
    compile_value(e, c, subject)?
    e.op(ExitTrap(h))
    e.op(Branch(end))

    e.place(r)
    e.op(Mark(no))
    e.op(Dup)
    match_fresh(e, inner, pat)?

    guard match
        Some(g) ->
            compile_value(e, inner, g)?
            e.op(FailIfFalse)
        None -> ()

    e.op(Unmark)
    e.op(Pop)
    compile_value(e, inner, recovery)?
    e.op(Branch(end))

    e.place(no)
    e.op(Rethrow)
    e.place(end)
    Ok(())
end compile_catch

// `PushTrap(to)`: a `Trap` entry in the running frame, which saves no operand cells.
push_trap(v: *Vm, to: usize)
    push_entry(v, Trap, to, v.stack.len())

// `ExitTrap(slot)`: the guarded expression produced a value. Its `Trap` goes when nothing stands
// above it, and is covered by an `Untrap` otherwise.
exit_trap(v: *Vm, slot: usize) -> Result[unit, string]
    val h = saved_height(v, slot)?

    if h >= v.control.len() || v.control.at(h).kind != Trap then return Ok(())

    if v.control.len() == h + 1
        cut_to(v, h, false)
    else
        push_entry(v, Untrap, h, v.stack.len())

    Ok(())

// Unwind to the innermost active catch that takes `thrown`, and resume at its recovery: true. False
// when none does, the control stack then empty. A `catch/3` takes a ball its catcher unifies with; a
// FunL `Trap` takes every ball, with a copy of it pushed for the recovery to match.
throw_ball(v: *Vm, thrown: Value) -> Result[bool, string]
    val ball = copy_term(thrown)?
    val inside = v.frame
    var passed: Buf[usize] = buf()

    loop
        val e = v.control.pop() match
            Some(e) -> e
            None -> return Ok(false)

        restore(v, e)

        if e.kind == Untrap
            passed.push(e.ip)
        elif e.kind == Trap && encloses(inside, e.frame) && !holds(passed, v.control.len())
            v.stack.push(copy_term(ball)?)
            v.ip = e.ip
            return Ok(true)
        elif e.kind == Catch && encloses(inside, e.frame)
            if e.frame.args.len() == 3 && unify(e.frame.args.at(1), copy_term(ball)?)
                v.ip = e.ip
                return Ok(true)
end throw_ball

// Whether `hs` holds `h`.
private holds(hs: Buf[usize], h: usize) -> bool
    for x in hs.view()
        if x == h then return true

    false

// Whether frame `f` is `from` or one of its callers.
private encloses(from: *FrameObj, f: *FrameObj) -> bool
    var at = from

    while at != null
        if at == f then return true

        at = at.caller

    false

// `throw(Ball)`: the ball, which must be bound.
private pl_throw(base: usize, argc: usize) -> Result[Value, Fault]
    val ball = deref(arg(base, 0))

    ball match
        Var(_) -> Err(instantiation_error("throw/1 was given an unbound variable as its ball"))
        _ -> Err(Thrown(ball))

// `halt`: end the process with status 0, from wherever the goal is.
private pl_halt0(base: usize, argc: usize) -> Result[Value, Fault] = Err(Exits(0))

// `halt(Status)`: end the process with `Status`, which must be an integer.
private pl_halt1(base: usize, argc: usize) -> Result[Value, Fault]
    val s = deref(arg(base, 0))

    s match
        Int(n) -> Err(Exits(int(n)))
        Var(_) -> Err(instantiation_error("halt/1 was given an unbound variable as its status"))
        Big(_) -> Err(representation_error("max_integer", s"halt/1's status ${render(s)} is too large"))
        _ -> Err(type_error("integer", s, s"halt/1 wants an integer status, and was given ${described(s)}"))

install_catch(v: *Vm)
    register(v, "throw/1", 1, pl_throw)
    register(v, "halt/0", 0, pl_halt0)
    register(v, "halt/1", 1, pl_halt1)
