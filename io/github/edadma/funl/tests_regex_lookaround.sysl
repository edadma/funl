module io.github.edadma.funl
@tests

// Lookahead, lookbehind and backreferences. Each assertion searches a pattern in a subject, leftmost
// first, on both heaps, and expects the spans of the first match: the whole match, then each group in
// order, 0-based, in characters; `NOMATCH` is no match anywhere in the subject.
//
// A lookbehind is matched backward from the position (docs/design/vm.md, "Forward and reverse"), so it
// may be any pattern at all, of any length. Matched backward, the rightmost part of a lookbehind is
// tried first: of two groups the one on the right takes its share first, a group repeated keeps the
// leftmost turn as its last, and a backreference sees only groups to its right.

// `string(e)` and `ccls(e)` have no lookbehind of their own to stand in -- a regex literal holds no
// expressions -- but every pattern compiles in both directions, so their reverse instructions are run
// here directly: scan `subject` to its end, then step back over `operand` as `op` reads it, and write
// the text stepped over. An operand of `None` is the integer 1, which neither can match.
private stepped_back(subject: string, operand: Option[string], op: Op) -> string
    ran(() -> stepped_back_chunk(subject, operand, op))

private stepped_back_chunk(subject: string, operand: Option[string], op: Op) -> Result[usize, string]
    var e = emit("back")

    e.op(PushConst(e.constant(new_str(subject)?)))
    e.op(ScanBegin)

    for c in subject.chars
        e.op(Char(c, false))

    val x = operand match
        Some(s) -> new_str(s)?
        None -> Int(1)

    e.op(RxBegin(0))
    e.op(SavePos)
    e.op(PushConst(e.constant(x)))
    e.op(op)
    e.op(RxEnd)
    say(&e)
    e.op(Halt)
    finish(e)

@test
STRING_AND_CCLS_STEP_BACK_OVER_WHAT_THEY_MATCH_IN_REVERSE()
    assert_eq(stepped_back("xñb", Some("ñb"), LitOfRev), "ñb\nsucceeded")
    assert_eq(stepped_back("xab", Some(""), LitOfRev), "\nsucceeded")
    assert_eq(stepped_back("xab", Some("xb"), LitOfRev), "failed")
    assert_eq(stepped_back("ab", Some("xab"), LitOfRev), "failed")
    assert_eq(stepped_back("añ", Some("ñz"), ClassOfRev), "ñ\nsucceeded")
    assert_eq(stepped_back("ab", Some("a"), ClassOfRev), "failed")
    assert_eq(stepped_back("", Some("a"), ClassOfRev), "failed")

@test
STRING_AND_CCLS_IN_REVERSE_FAULT_ON_WHAT_THEY_CANNOT_MATCH()
    assert_eq(stepped_back("ab", None, LitOfRev), "fault: back@7: `string` matches a string, and was given the integer 1")
    assert_eq(stepped_back("ab", None, ClassOfRev), "fault: back@7: `ccls` matches a character of a cset or a string, and was given the integer 1")

@test
A_LOOKBEHIND_HOLDS_WHERE_ITS_PATTERN_ENDS_AT_THE_POSITION()
    assert_eq(regex_searched("(?<=a)b", "ab"), "(1,2)")
    assert_eq(regex_searched("(?<=a)b", "cb"), "NOMATCH")
    assert_eq(regex_searched("(?<!a)b", "ab"), "NOMATCH")
    assert_eq(regex_searched("(?<!a)b", "cb"), "(1,2)")
    assert_eq(regex_searched("(?<!a)b", "abb"), "(2,3)")
    assert_eq(regex_searched("(?<=ab|c)d", "abd"), "(2,3)")
    assert_eq(regex_searched("(?<=ab|c)d", "cd"), "(1,2)")
    assert_eq(regex_searched("(?<=ab|c)d", "bd"), "NOMATCH")
    assert_eq(regex_searched("(?<=x|yz|wxyz)!", "wxyz!"), "(4,5)")
    assert_eq(regex_searched("(?<=x|yz|wxyz)!", "ayz!"), "(3,4)")
    assert_eq(regex_searched("(?<=a{2})b", "aab"), "(2,3)")
    assert_eq(regex_searched("(?<=a{2})b", "ab"), "NOMATCH")
    assert_eq(regex_searched("(?<=(?:ab){2})c", "ababc"), "(4,5)")
    assert_eq(regex_searched("(?<=a.c)d", "abcd"), "(3,4)")
    assert_eq(regex_searched("(?s)(?<=a.)c", "abc"), "(2,3)")
    assert_eq(regex_searched("(?<=.)", "ab"), "(1,1)")
    assert_eq(regex_searched("(?<=a)", "ba"), "(2,2)")

@test
A_LOOKBEHIND_TAKES_ANCHORS_CLASSES_FLAGS_AND_WIDE_CHARACTERS()
    assert_eq(regex_searched("(?<=^)a", "a"), "(0,1)")
    assert_eq(regex_searched("(?<=^)a", "ba"), "NOMATCH")
    assert_eq(regex_searched("(?<=^|,)\\w", "a,b"), "(0,1)")
    assert_eq(regex_searched("(?<=\\bfoo)bar", "foobar"), "(3,6)")
    assert_eq(regex_searched("(?<=\\bfoo)bar", "xfoobar"), "NOMATCH")
    assert_eq(regex_searched("(?<=\\b)a", "a a"), "(0,1)")
    assert_eq(regex_searched("(?<=\\B)a", "aa"), "(1,2)")
    assert_eq(regex_searched("(?<![a-z])\\d", "a1 2"), "(3,4)")
    assert_eq(regex_searched("(?<=[aeiou]{2})t", "boot"), "(3,4)")
    assert_eq(regex_searched("(?<=\\d\\d\\d)-", "abc-123-"), "(7,8)")
    assert_eq(regex_searched("(?<=\\.)\\w+", "file.txt"), "(5,8)")
    assert_eq(regex_searched("(?<!\\.)\\b\\w+$", "a.b c"), "(4,5)")
    assert_eq(regex_searched("(?i)(?<=A)b", "ab"), "(1,2)")
    assert_eq(regex_searched("(?<=(?i)A)b", "ab"), "(1,2)")
    assert_eq(regex_searched("(?<=(?i:A))B", "aB"), "(1,2)")
    assert_eq(regex_searched("(?<=ñ)a", "ñaña"), "(1,2)")
    assert_eq(regex_searched("(?<=日本)語", "日本語"), "(2,3)")

@test
LOOKAROUNDS_NEST_INSIDE_A_LOOKBEHIND()
    assert_eq(regex_searched("(?<=a(?=b))b", "ab"), "(1,2)")
    assert_eq(regex_searched("(?<=a(?!b))b", "ab"), "NOMATCH")
    assert_eq(regex_searched("(?<=(?<=a)b)c", "abc"), "(2,3)")
    assert_eq(regex_searched("(?<=(?<=a)b)c", "xbc"), "NOMATCH")
    assert_eq(regex_searched("(?<!(?<=a)b)c", "abc"), "NOMATCH")
    assert_eq(regex_searched("(?<!(?<=a)b)c", "xbc"), "(2,3)")
    assert_eq(regex_searched("(?<=(?<!x)a)b", "xab"), "NOMATCH")
    assert_eq(regex_searched("(?<=(?<!x)a)b", "yab"), "(2,3)")
    assert_eq(regex_searched("(?<=(?<=(?<=a)b)c)d", "abcd"), "(3,4)")

@test
A_GROUP_INSIDE_A_LOOKBEHIND_CAPTURES_WHAT_IT_MATCHED_BACKWARD()
    assert_eq(regex_searched("(?<=(a))b", "ab"), "(1,2)(0,1)")
    assert_eq(regex_searched("(?<=(\\w)(\\w))c", "abc"), "(2,3)(0,1)(1,2)")
    assert_eq(regex_searched("(?<=(aa|a))b", "aab"), "(2,3)(0,2)")
    assert_eq(regex_searched("(?<=(a|ab))c", "abc"), "(2,3)(0,2)")
    assert_eq(regex_searched("(?<=(a{1,2}))b", "aab"), "(2,3)(0,2)")
    assert_eq(regex_searched("(?<=(a?)(a?))b", "aab"), "(2,3)(0,1)(1,2)")
    assert_eq(regex_searched("(?<=(?>ab|a)b)c", "abbc"), "(3,4)")

// Each of these follows from matching right to left; a reader can work it by stepping back from the
// position one character at a time.
@test
BACKWARD_THE_RIGHTMOST_PART_OF_A_LOOKBEHIND_IS_MATCHED_FIRST()
    // The first alternative that fits stepping back from the b wins: one a, not two.
    assert_eq(regex_searched("(?<=(a|aa))b", "aab"), "(2,3)(1,2)")
    // Lazy, stepping back, takes one a.
    assert_eq(regex_searched("(?<=(a{1,2}?))b", "aab"), "(2,3)(1,2)")
    // The lazy group on the right is matched first and takes nothing; the greedy one then takes an a.
    assert_eq(regex_searched("(?<=(a?)(a??))b", "aab"), "(2,3)(1,2)(2,2)")
    // The second group is matched first and takes the only a, leaving the first empty.
    assert_eq(regex_searched("(?<=(a?)(a?))b", "ab"), "(1,2)(0,0)(0,1)")
    // A group keeps its last turn, which backward is the leftmost.
    assert_eq(regex_searched("(?<=(ab){2})c", "ababc"), "(4,5)(0,2)")
    // The backreference is reached before its group, which has captured nothing yet, so it matches
    // the empty string.
    assert_eq(regex_searched("(?<=(\\w)\\1)x", "aax"), "(2,3)(1,2)")
    // The group is matched first, so the backreference on its left sees it.
    assert_eq(regex_searched("(?<=\\1(\\w))x", "aax"), "(2,3)(1,2)")
    // The atomic group is entered from its right end, where only ab fits.
    assert_eq(regex_searched("(?<=(?>a|ab)b)c", "abbc"), "(3,4)")
    // The a outside the atomic group is taken first, and the atomic run takes the other.
    assert_eq(regex_searched("(?<=(?>a{0,2})a)b", "aab"), "(2,3)")

@test
A_LOOKBEHIND_MAY_BE_OF_ANY_LENGTH()
    assert_eq(regex_searched("(?<=a+)b", "aaab"), "(3,4)")
    assert_eq(regex_searched("(?<=a+)b", "b"), "NOMATCH")
    // Greedy backward, the group takes every a; lazy, the one a next to the b.
    assert_eq(regex_searched("(?<=(a+))b", "xaaab"), "(4,5)(1,4)")
    assert_eq(regex_searched("(?<=(a+?))b", "xaaab"), "(4,5)(3,4)")
    assert_eq(regex_searched("(?<=^\\w*)b", "aab"), "(2,3)")
    // The space stops the word before it reaches the start.
    assert_eq(regex_searched("(?<=^\\w*)b", "a b"), "NOMATCH")
    // A repeated group keeps its last turn, which backward is the leftmost.
    assert_eq(regex_searched("(?<=(a|bc)+)d", "abcad"), "(4,5)(0,1)")
    assert_eq(regex_searched("(?<=^(?:ab|c)*)x", "ababcx"), "(5,6)")
    // No way to read abb back to the start out of ab's and c's.
    assert_eq(regex_searched("(?<=^(?:ab|c)*)x", "abbx"), "NOMATCH")
    assert_eq(regex_searched("(?<=\\d+(?:\\.\\d+)?)%", "rate 12.5%"), "(9,10)")
    assert_eq(regex_searched("(?<=[^a]+)a", "ññña"), "(3,4)")
    // The greedy group on the right is matched first and gives back one character so the lazy one
    // can have it.
    assert_eq(regex_searched("(?<=(\\w+?)(\\w+))!", "abc!"), "(3,4)(0,1)(1,3)")
    // The group on the right is matched before the backreference on its left.
    assert_eq(regex_searched("(?<=\\1 (\\w+) )z", "ab ab z"), "(6,7)(3,5)")
    // Possessive: the last a is taken before the run.
    assert_eq(regex_searched("(?<=a++a)b", "aab"), "(2,3)")
    assert_eq(regex_searched("(?<=(?<=a+)b+)c", "aabbc"), "(4,5)")
    assert_eq(regex_searched("(?<=(?<=a+)b+)c", "bbc"), "NOMATCH")
    // The nested negative lookbehind fails at the whole run, and holds once the run gives one a back.
    assert_eq(regex_searched("(?<=(?<!b)a+)c", "baac"), "(3,4)")
    assert_eq(regex_searched("(?<=(?<!b)(a+))c", "baac"), "(3,4)(2,3)")
    assert_eq(regex_searched("(?<!a.*)b", "xb"), "(1,2)")
    assert_eq(regex_searched("(?<!a.*)b", "axb"), "NOMATCH")

@test
A_LOOKAHEAD_TESTS_WHAT_FOLLOWS_WITHOUT_MOVING()
    assert_eq(regex_searched("a(?=b)", "ab"), "(0,1)")
    assert_eq(regex_searched("a(?!b)", "ab"), "NOMATCH")
    assert_eq(regex_searched("a(?!b)", "ac"), "(0,1)")
    assert_eq(regex_searched("(?!a)\\w", "abc"), "(1,2)")
    assert_eq(regex_searched("\\w+(?=:)", "price: 10"), "(0,5)")
    assert_eq(regex_searched("(?=a)(?=.b)ab", "ab"), "(0,2)")
    assert_eq(regex_searched("(?=(a))(?=(a)b)", "ab"), "(0,0)(0,1)(0,1)")
    assert_eq(regex_searched("(?=(a+))a*b\\1", "baaabac"), "(3,6)(3,4)")
    assert_eq(regex_searched("(?=(\\w+))\\1:", "abc:"), "(0,4)(0,3)")
    assert_eq(regex_searched("(a+)(?!\\1)", "aaab"), "(0,3)(0,3)")
    assert_eq(regex_searched("(?=.*(\\d))\\w", "ab3"), "(0,1)(2,3)")

@test
A_BACKREFERENCE_MATCHES_ONLY_WHAT_ITS_GROUP_CAPTURED()
    assert_eq(regex_searched("(a)\\1", "aa"), "(0,2)(0,1)")
    assert_eq(regex_searched("(a|b)\\1", "abb"), "(1,3)(1,2)")
    assert_eq(regex_searched("(\\w+)\\s\\1", "hello hello"), "(0,11)(0,5)")
    assert_eq(regex_searched("(?i)(a)\\1", "aA"), "(0,2)(0,1)")
    assert_eq(regex_searched("(a*)\\1b", "aaaab"), "(0,5)(0,2)")
    assert_eq(regex_searched("(?<n>x)\\k<n>", "xx"), "(0,2)(0,1)")
    // A group that has captured something still wants exactly that text.
    assert_eq(regex_searched("(a)\\1", "ab"), "NOMATCH")
    assert_eq(regex_searched("(a)b\\1", "abb"), "NOMATCH")
    assert_eq(regex_searched("(?i)(a)\\1", "ab"), "NOMATCH")

@test
A_BACKREFERENCE_TO_A_GROUP_THAT_CAPTURED_NOTHING_MATCHES_THE_EMPTY_STRING()
    // The group was skipped, or is in an alternative not taken.
    assert_eq(regex_searched("(a)?b\\1", "b"), "(0,1)(?,?)")
    assert_eq(regex_searched("(a)|\\1b", "b"), "(0,1)(?,?)")
    assert_eq(regex_searched("(?:(a)|b)\\1", "ba"), "(0,1)(?,?)")
    assert_eq(regex_searched("(?:(a)|b)\\1", "bb"), "(0,1)(?,?)")
    // The backreference comes before its group.
    assert_eq(regex_searched("\\1(a)", "a"), "(0,1)(0,1)")
    assert_eq(regex_searched("(?<n>\\k<n>x)", "x"), "(0,1)(0,1)")
    // Backtracking out of a group unsets it again: (b)? first takes the b, \2 then wants a second b,
    // and the match gives the b back, leaving group 2 unset and \2 empty.
    assert_eq(regex_searched("(a)(b)?\\2", "ab"), "(0,1)(0,1)(?,?)")
    // (a) captures, c fails, and the other alternative is taken: \1 is empty, not a.
    assert_eq(regex_searched("(?:(a)c|a)\\1y", "ay"), "(0,2)(?,?)")
    // Inside a negative lookahead, an unset \1 fits everywhere, so the lookahead fails everywhere.
    assert_eq(regex_searched("(?!\\1)(a)", "a"), "NOMATCH")
    // A backreference inside a lookbehind, to a group already matched on its left.
    assert_eq(regex_searched("(a)x(?<=\\1x)y", "axy"), "(0,3)(0,1)")
    assert_eq(regex_searched("(a)x(?<=\\1x)y", "axay"), "NOMATCH")
    assert_eq(regex_searched("(a)(?<=(\\1))", "aa"), "(0,1)(0,1)(0,1)")
    assert_eq(regex_searched("(a)(?<=\\1)", "aa"), "(0,1)(0,1)")
