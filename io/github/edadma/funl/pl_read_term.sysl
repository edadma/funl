module io.github.edadma.funl

import sh.sysl.parsing.{Report, Source, full_report, source_of}
import sysl.buf.{Buf, buf}
import sysl.text.{Search, from_utf8, from_utf8_unchecked, str_builder}

// Reading terms while a program runs: `read/1-2`, `read_term/2-3`, `term_to_atom/2`, `term_string/2` and
// `atom_to_term/3`; and the operator
// table as `current_op/3` enumerates it.
//
// **Input is lines, from the current input stream** (`pl_streams.sysl`): `user_input` is the
// machine's `input` -- the top level's own line source in the `prolog` executable, so a `read/1` in a
// query takes the lines typed after it, and standard input otherwise -- and a file is read a line at
// a time. A term is read once the lines taken hold the `.` that ends a clause; the layout character
// after that `.` goes with it, and whatever follows waits for the next read. At the end of the input
// the term read is `end_of_file`, as ISO has it.
//
// **Text that does not read raises `syntax_error(Message)`**, the message the reader's first
// refusal gave, with the reader's whole diagnostic -- where, and what was expected -- as the error's
// message. A read that refuses a term has consumed it, up to its `.`.

install_prolog_read(v: *Vm)
    register_generator(v, "read/1", 1, (b, n, c) -> read_term_from(b, false, arg(b, 0), Nil, "read/1"))
    register_generator(v, "read/2", 2, (b, n, c) -> read_term_from(b, true, arg(b, 1), Nil, "read/2"))
    register_generator(v, "read_term/2", 2, (b, n, c) -> read_term_from(b, false, arg(b, 0), arg(b, 1), "read_term/2"))
    register_generator(v, "read_term/3", 3, (b, n, c) -> read_term_from(b, true, arg(b, 1), arg(b, 2), "read_term/3"))
    register_generator(v, "term_to_atom/2", 2, (b, n, c) -> pl_term_to_atom(arg(b, 0), arg(b, 1)))
    register_generator(v, "term_string/2", 2, (b, n, c) -> pl_term_string(arg(b, 0), arg(b, 1)))
    register_generator(v, "atom_to_term/3", 3, (b, n, c) -> pl_atom_to_term(arg(b, 0), arg(b, 1), arg(b, 2)))
    register_generator(v, "$ops/4", 4, (b, n, c) -> pl_ops(arg(b, 0), arg(b, 1), arg(b, 2), arg(b, 3)))

// -- Reading ----------------------------------------------------------------------------------------

// One term read from text, or `None` for text that held nothing but layout; and how many bytes of the
// text the read used.
private struct OneTerm
    got: Option[ReadClause]
    used: usize

// Read the first term of `text`, named `name` in a diagnostic. With `whole`, the text is the term and
// nothing more, its `.` optional.
private read_one(name: string, text: string, whole: bool) -> Result[OneTerm, Fault]
    val src = source_of(name, text)
    var report = full_report()
    var r = pl_reader(src, &report)

    val got = if whole then whole_term(&r) else next_clause(&r)
    val used = read_up_to(r)

    if report.has_errors() then return Err(read_error(report, src))

    got match
        Clause(c) -> Ok(OneTerm(Some(c), used))
        _ -> Ok(OneTerm(None, used))

// The error a refused read raises.
private read_error(report: Report, src: Source) -> Fault =
    syntax_error(report.at(0).message, report.render(src).trim())

// `read_term(S, T, Options)` and `read(S, T)`: the next term of stream `S`, the first argument where
// `named`; `read_term(T, Options)` and `read(T)` are these on the current input.
private read_term_from(base: usize, named: bool, t: Value, options: Value, who: string) -> Result[Answer, Fault]
    val wanted = read_options(options, who)?
    val (s, culprit) = term_input(base, named, who)?
    val text = clause_ahead(s, culprit, who)?

    val one = read_one(stream_label(s), text, false) match
        Ok(o) -> o
        Err(f) ->
            take_ahead(s, text.bytes.len)
            return Err(f)

    val c = one.got match
        Some(c) -> c
        None ->
            take_ahead(s, text.bytes.len)
            mark_past(s)
            return answer(unify(t, atom("end_of_file")) && no_variables(wanted)?)

    take_ahead(s, one.used)
    take_layout(s)
    bind_read(t, c, wanted)

// The options of a `read_term/2`, each checked: `variable_names(V)`, `variables(V)` and
// `singletons(V)`, as `(name, V)`.
private read_options(options: Value, who: string) -> Result[Buf[(string, Value)], Fault]
    var out: Buf[(string, Value)] = buf()

    for o in list_items(options, who)?.view()
        val x = deref(o)

        if is_unbound(x) then return Err(instantiation_error(s"instantiation error: $who was given an unbound option"))

        compound_parts(x) match
            Some((f, args)) ->
                val n = atom_name(f)

                if args.len() == 1 && (n == "variable_names" || n == "variables" || n == "singletons")
                    out.push((n, args.at(0)))
                    continue
            None -> ()

        return Err(domain_error("read_option", x, s"$who: ${render(x)} is not a read option; the options are variable_names/1, variables/1 and singletons/1"))

    Ok(out)

// The options of a read that found the end of the input: every list empty.
private no_variables(wanted: Buf[(string, Value)]) -> Result[bool, Fault]
    for w in wanted.view()
        if !unify(w.1, Nil) then return Ok(false)

    Ok(true)

// Unify `t` with the term read, and each option with what it asks for.
private bind_read(t: Value, c: ReadClause, wanted: Buf[(string, Value)]) -> Result[Answer, Fault]
    var vars: Buf[Value] = buf()
    val x = term_value(c.t, &vars)?

    while vars.len() < c.names.len()
        vars.push(Undefined)

    if !unify(t, x) then return answer(false)

    for w in wanted.view()
        val got = if w.0 == "variables"
            var vs = variables_of(x, false)

            list_of(&vs, Nil)?
        else
            named_variables(c, &vars, w.0 == "singletons")?

        if !unify(w.1, got) then return answer(false)

    answer(true)

// `['X' = X, ...]` for the named variables of a clause read, in the order they were first written;
// with `singletons`, only those written once.
private named_variables(c: ReadClause, vars: *Buf[Value], singletons: bool) -> Result[Value, Fault]
    var counts: Buf[usize] = buf()

    for i in 0..<c.names.len()
        counts.push(0)

    count_uses(c.t, &counts)

    var items: Buf[Value] = buf()

    for i in 0..<c.names.len()
        val name = c.names.at(i)

        if name == "_" || (singletons && counts.at(i) != 1) then continue

        var args: Buf[Value] = buf()

        args.push(atom(name))
        args.push(vars.at(i))
        items.push(build_compound(intern("="), args)?)

    Ok(list_of(&items, Nil)?)

// How many times each variable of `t` is written.
private count_uses(t: &Term, counts: *Buf[usize])
    t.kind match
        TVar(n) -> counts.set(n, counts.at(n) + 1)
        TCons(h, tl) ->
            count_uses(h, counts)
            count_uses(tl, counts)
        TComp(f, args) ->
            for a in args.view()
                count_uses(a, counts)
        _ -> ()

// `term_to_atom(T, A)`: `A` read as a term and unified with `T` when `A` is bound, and otherwise
// `T` written as `writeq/1` writes it -- an unbound `T` among them, as in SWI-Prolog. A number given
// as `A` is read from its digits, and an `A` with no term in it is `syntax_error(end_of_string)`.
private pl_term_to_atom(t: Value, a: Value) -> Result[Answer, Fault]
    val who = "term_to_atom/2"

    val text = deref(a) match
        Atom(id) -> atom_name(id)
        Nil -> "[]"
        Str(s) -> s.s
        Var(_) -> return unified(a, atom(term_text(t, write_opts(true, false, true))))
        x ->
            if !is_num(x) then return Err(type_error("text", x, s"type error: $who wants text to read, and was given ${described(x)}"))

            written_number(x)

    val one = read_one("atom", text, true)?

    val c = one.got match
        Some(c) -> c
        None -> return Err(syntax_error("end_of_string", s"$who: the atom '$text' holds no term"))

    var vars: Buf[Value] = buf()

    unified(t, term_value(c.t, &vars)?)

// `term_string(T, S)`, as SWI-Prolog has it: `S` read as a term and unified with `T` when `S` is
// bound -- any text, a code list among it -- and otherwise `T` written as `writeq/1` writes it, as a
// string. Text with no term in it is `syntax_error(end_of_string)`.
private pl_term_string(t: Value, s: Value) -> Result[Answer, Fault]
    val who = "term_string/2"

    val text = any_text(s, who)? match
        Some(x) -> x
        None ->
            return new_str(term_text(t, write_opts(true, false, true))) match
                Ok(x) -> unified(s, x)
                Err(e) -> Err(Broken(e))

    val c = read_text(text, who)?
    var vars: Buf[Value] = buf()

    unified(t, term_value(c.t, &vars)?)

// `atom_to_term(A, T, Bindings)`, as SWI-Prolog has it: `A` read as a term, unified with `T`, and
// `Bindings` the list `['X' = X, ...]` of its named variables in the order they were first written,
// `_`-prefixed names among them and `_` aside. `A` is any text, and must be bound.
private pl_atom_to_term(a: Value, t: Value, bindings: Value) -> Result[Answer, Fault]
    val who = "atom_to_term/3"

    val text = any_text(a, who)? match
        Some(x) -> x
        None -> return Err(instantiation_error(s"instantiation error: $who wants the text to read"))

    val c = read_text(text, who)?
    var vars: Buf[Value] = buf()
    val x = term_value(c.t, &vars)?

    while vars.len() < c.names.len()
        vars.push(Undefined)

    if !unify(t, x) then return answer(false)

    unified(bindings, named_variables(c, &vars, false)?)

// The first term `text` holds, its `.` optional, as SWI-Prolog reads it: a term ended by `.` is taken
// whatever follows it. `syntax_error(end_of_string)` where the text holds no term.
private read_text(text: string, who: string) -> Result[ReadClause, Fault]
    read_one("string", text, false) match
        Ok(one) ->
            one.got match
                Some(c) -> return Ok(c)
                None -> ()
        Err(_) -> ()

    read_one("string", text, true)?.got match
        Some(c) -> Ok(c)
        None -> Err(syntax_error("end_of_string", s"$who: the text '$text' holds no term"))

// -- The input ---------------------------------------------------------------------------------------

extern read(fd: int, into: *u8, n: usize) -> long

// A line of standard input, without its newline; `None` at the end of the input. Read a byte at a
// time, so nothing past the line is taken from the descriptor for another reader to miss.
//
// What standard output holds is pushed out first, so a prompt the program wrote is showing before the
// read waits.
stdin_line() -> Option[string]
    var bytes: Buf[u8] = buf()
    var c: u8 = 0
    var any = false

    flush()

    loop
        if read(0, &c, 1) <= 0 then break

        any = true

        if c == u8('\n') then break

        bytes.push(c)

    if !any then return None

    Some(decoded_line(bytes.view()))

// The next line of the program's input for `read()`, without its newline, or `None` at the end. What
// an earlier `reads(n)` took from a line and left (`pending`) is read first, so the two share one
// stream.
input_line(who: string) -> Result[Option[string], Fault]
    val v = current()
    val held = v.pending

    if held.bytes.len > 0
        held.index_of("\n") match
            Some(i) ->
                v.pending = copied(held.bytes[i + 1..<held.bytes.len])
                return Ok(Some(copied(held.bytes[0..<i])))
            None ->
                v.pending = ""
                return Ok(Some(held))

    v.input("") match
        Some(l) ->
            if take_malformed_input() then return Err(malformed_input_error(who))

            Ok(Some(l))
        None -> Ok(None)

// The next `n` characters of the program's input for `reads(n)`, fewer when the input ends first, and
// `None` when nothing is left. A line the input hands back is read as if it ended in a newline, so
// the characters of a final line with none are followed by one.
input_chars(n: usize, who: string) -> Result[Option[string], Fault]
    val v = current()
    var text = v.pending
    var count = char_count(text)

    while count < n
        v.input("") match
            Some(l) ->
                if take_malformed_input()
                    v.pending = ""
                    return Err(malformed_input_error(who))

                text = text + l + "\n"
                count += char_count(l) + 1
            None -> break

    if text.bytes.len == 0
        v.pending = ""
        return Ok(None)

    var at: usize = 0
    var seen: usize = 0

    while at < text.bytes.len && seen < n
        at += char_width(text.bytes[at])
        seen += 1

    v.pending = copied(text.bytes[at..<text.bytes.len])
    Ok(Some(copied(text.bytes[0..<at])))

// How many characters `s` holds: its bytes that do not continue another.
private char_count(s: string) -> usize
    var n: usize = 0

    for b in s.bytes
        if (b & 192) != 128 then n += 1

    n

// How many bytes the UTF-8 character that begins with `lead` takes.
private char_width(lead: u8) -> usize =
    if lead >= 240 then 4
    else if lead >= 224 then 3
    else if lead >= 192 then 2
    else 1

// The text of a line's bytes. Bytes that are not UTF-8 cannot become a string, so the line stands in
// as empty and the fact travels beside it: the reader that asked for the line takes it with
// `take_malformed_input` and refuses the read.
decoded_line(b: []const u8) -> string
    from_utf8(b) match
        Ok(_) -> copied(b)
        Err(_) ->
            current().malformed_input = true
            ""

// Whether the last line was malformed input; reading it clears the record.
take_malformed_input() -> bool
    val v = current()
    val was = v.malformed_input

    v.malformed_input = false
    was

// The error a read of malformed input raises: the text is not a valid UTF-8 stream.
malformed_input_error(who: string) -> Fault =
    syntax_error("illegal_character", s"$who: the input is not valid UTF-8")

// Bytes as a string of its own, which outlives the buffer they came from.
private copied(b: []const u8) -> string
    var out = str_builder()

    out.push(from_utf8_unchecked(b))
    out.finish()

// -- current_op/3 ----------------------------------------------------------------------------------

// `'$ops'(P, T, Op, Ops)`: `P`, `T` and `Op` checked as `current_op/3` checks them, and `Ops` every
// operator in the table, as `op(P, T, Op)`.
private pl_ops(p: Value, t: Value, op: Value, ops: Value) -> Result[Answer, Fault]
    val who = "current_op/3"

    deref(p) match
        Var(_) -> ()
        Int(n) ->
            if n < 0 || n > 1200
                return Err(domain_error("operator_priority", Int(n), s"$who: an operator's priority is from 0 to 1200, and this one is $n"))
        x -> return Err(domain_error("operator_priority", x, s"$who wants an operator priority, and was given ${described(x)}"))

    deref(t) match
        Var(_) -> ()
        Atom(id) ->
            if op_type_named(atom_name(id)).is_none()
                return Err(domain_error("operator_specifier", Atom(id), s"$who: ${atom_name(id)} is not an operator type; the types are xfx, xfy, yfx, fy, fx, xf and yf"))
        x -> return Err(domain_error("operator_specifier", x, s"$who wants an operator type, and was given ${described(x)}"))

    deref(op) match
        Var(_) -> ()
        Atom(_) -> ()
        Nil -> ()
        x -> return Err(type_error("atom", x, s"type error: $who wants an operator's name, an atom, and was given ${described(x)}"))

    unified(ops, op_list()?)

// Every operator in the table, `,` among them, as `op(P, T, Name)`.
private op_list() -> Result[Value, Fault]
    val v = current()
    var items: Buf[Value] = buf()

    items.push(op_term(1000, "xfy", ",")?)

    for (name, o) in v.prefix_ops.walk()
        items.push(op_term(o.priority, type_name(o.kind), name)?)

    for (name, o) in v.infix_ops.walk()
        items.push(op_term(o.priority, type_name(o.kind), name)?)

    for (name, o) in v.postfix_ops.walk()
        items.push(op_term(o.priority, type_name(o.kind), name)?)

    Ok(list_of(&items, Nil)?)

private op_term(p: u16, kind: string, name: string) -> Result[Value, Fault]
    var args: Buf[Value] = buf()

    args.push(Int(long(p)))
    args.push(atom(kind))
    args.push(if name == "[]" then Nil else atom(name))
    build_compound(intern("op"), args)

private type_name(t: OpType) -> string = t match
    Xfx -> "xfx"
    Xfy -> "xfy"
    Yfx -> "yfx"
    Fy -> "fy"
    Fx -> "fx"
    Xf -> "xf"
    Yf -> "yf"
