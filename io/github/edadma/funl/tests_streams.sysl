module io.github.edadma.funl
@tests

import sysl.buf.{Buf, buf}
import sysl.text.Search

// The standard streams (`docs/reference/streams.md`): `writes`, `ewrite`, `ewrites` and `stop` on the
// way out, `read()` and `reads(n)` on the way in. Programs that read run through `run_source`, which
// is `funl file` with the terminal swapped for a script, so every line of input is the test's own.

private struct Feed
    lines: Buf[string]
    at: usize
    said: &Capture

// The transcript of FunL program `text` reading `lines`, in the order things happened: what it wrote,
// what it wrote to standard error with each line after `stderr: `, each line it read after `read: `
// (at the point the read took it), `<no newline>` where the output ends in an unfinished line, then
// the status after `status:`.
private fed(text: string, lines: []string) -> string
    var script: Buf[string] = buf()

    for l in lines
        script.push(l)

    val f: &Feed = Feed(script, 0, new_capture())

    val status = run_source("test.funl", text, (prompt) -> next_fed(f), (t) -> captured(f.said, t), (t) -> captured_err(f.said, t))
    val wrote = transcript(f.said)
    val unended = if wrote.bytes.len > 0 && !wrote.ends_with("\n") then "<no newline>\n" else ""

    s"$wrote${unended}status: $status"

private next_fed(f: &Feed) -> Option[string]
    if f.at >= f.lines.len() then return None

    val l = f.lines.at(f.at)

    f.at += 1
    f.said.pieces.push(s"read: $l\n")
    f.said.fresh = true
    Some(l)

@test
READ_ANSWERS_EACH_LINE_WITHOUT_ITS_NEWLINE_AND_FAILS_AT_THE_END()
    assert_eq(fed("while (l <- read())\n  write( l )\nwrite( read() | \"end\" )\n", ["one", "two words", ""]),
        "read: one\none\nread: two words\ntwo words\nread: \n\nend\nstatus: 0")

@test
READ_ON_AN_EMPTY_INPUT_FAILS_AT_ONCE()
    assert_eq(fed("write( read() | \"none\" )\n", []), "none\nstatus: 0")

@test
READS_TAKES_CHARACTERS_ACROSS_LINES_NEWLINES_INCLUDED()
    assert_eq(fed("write( reads(2) )\nwrite( reads(4) )\n", ["abc", "def"]), "read: abc\nab\nread: def\nc\nde\nstatus: 0")

@test
READS_GIVES_WHAT_IS_LEFT_WHEN_THE_INPUT_ENDS_AND_THEN_FAILS()
    assert_eq(fed("write( reads(100) )\nwrite( reads(1) | \"end\" )\n", ["ab"]), "read: ab\nab\n\nend\nstatus: 0")

@test
READS_COUNTS_CHARACTERS_NOT_BYTES()
    assert_eq(fed("write( reads(2) )\nwrite( reads(1) )\n", ["héllo"]), "read: héllo\nhé\nl\nstatus: 0")

@test
READ_TAKES_THE_REST_OF_A_LINE_READS_BEGAN()
    assert_eq(fed("write( reads(2) )\nwrite( read() )\nwrite( read() )\n", ["abcd", "efg"]), "read: abcd\nab\ncd\nread: efg\nefg\nstatus: 0")

@test
READS_REFUSES_A_COUNT_THAT_IS_NOT_A_POSITIVE_INTEGER()
    val said = fed("write( reads(0) )\n", ["a"])

    assert(said.contains("'reads' wants a count of at least 1 and was given 0") && said.ends_with("status: 1"), said)
    val text = fed("write( reads(\"x\") )\n", ["a"])

    assert(text.contains("'reads' wants an integer count"), text)

@test
WRITES_LEAVES_THE_LINE_OPEN_FOR_THE_NEXT_WRITE()
    assert_eq(fed("writes( \"a\" )\nwrites( \"b\", 2 )\nwrite( \"c\" )\nwrites( \"d\\ne\" )\n", []), "ab2c\nd\ne<no newline>\nstatus: 0")

@test
WRITES_AND_EWRITES_JOIN_THEIR_ARGUMENTS_WITH_NO_SEPARATOR_WHERE_WRITE_AND_EWRITE_USE_A_COMMA()
    assert_eq(fed("writes( \"a\", 1, #b, [2, 3] )\nwrite( \"x\", 1 )\n", []), "a1b[2, 3]x, 1\nstatus: 0")
    assert_eq(fed("ewrites( \"a\", 1, \"c\" )\newrite( \"x\", 2 )\n", []), "stderr: a1cx, 2\nstatus: 0")
    assert_eq(fed("writes( \"\", \"\" )\nwrites( 7 )\nwrite( \"\" )\n", []), "7\nstatus: 0")

@test
WRITES_WITH_NO_ARGUMENTS_WRITES_NOTHING()
    assert_eq(fed("writes()\nwrite( 1 )\n", []), "1\nstatus: 0")

@test
EWRITE_AND_EWRITES_GO_TO_STANDARD_ERROR_NOT_STANDARD_OUTPUT()
    assert_eq(fed("write( \"out\" )\newrite( \"oops\", 1 )\newrites( \"a\" )\newrites( \"b\" )\n", []),
        "out\nstderr: oops, 1\nstderr: ab<no newline>\nstatus: 0")

@test
STOP_WRITES_TO_STANDARD_ERROR_AND_ENDS_THE_PROGRAM_WITH_STATUS_1()
    assert_eq(fed("write( \"before\" )\nstop( \"bad input:\", 3 )\nwrite( \"after\" )\n", []),
        "before\nstderr: bad input:, 3\nstatus: 1")

@test
STOP_IS_NOT_CAUGHT()
    assert_eq(fed("write( (stop(\"x\") catch e -> \"caught\") )\nwrite( \"after\" )\n", []), "stderr: x\nstatus: 1")

@test
THE_TEST_KIT_SHOWS_STANDARD_ERROR_LINES_WHERE_THE_PROGRAM_WROTE_THEM()
    assert_eq(ran_funl("write( 1 )\newrite( \"e\" )\nwrite( read() | \"no input\" )\n"), "1\nstderr: e\nno input\nsucceeded")

@test
A_LINE_THE_PROGRAM_LEAVES_UNFINISHED_GETS_NO_NEWLINE()
    assert_eq(fed("write( 1 )\nwrites( \"end\" )\n", []), "1\nend<no newline>\nstatus: 0")
    assert_eq(fed("writes( \"a\\n\" )\n", []), "a\nstatus: 0")
    assert_eq(fed("writes( \"\" )\n", []), "status: 0")

@test
A_PROMPT_IS_WRITTEN_BEFORE_THE_READ_THAT_FOLLOWS_IT_TAKES_ITS_LINE()
    assert_eq(fed("writes( \"name: \" )\nval n = read()\nwrite( \"hi \" + n )\nwrites( \"again: \" )\nwrite( read() | \"none\" )\n", ["bob"]),
        "name: read: bob\nhi bob\nagain: none\nstatus: 0")

@test
STANDARD_ERROR_AND_STANDARD_OUTPUT_KEEP_THE_ORDER_THE_PROGRAM_WROTE_THEM_IN()
    assert_eq(fed("write( 1 )\newrite( \"e1\" )\nwrite( \"two\" )\newrites( \"e\" )\newrite( 2 )\nwrite( 3 )\nstop( \"bye\" )\n", []),
        "1\nstderr: e1\ntwo\nstderr: e2\n3\nstderr: bye\nstatus: 1")

@test
FUNL_AND_PROLOG_OUTPUT_GO_OUT_IN_THE_ORDER_THEY_RAN()
    val d = scratch()
    defer scrap(d)

    val file = put(d, "says.pl", "pl_says(X) :- write(X), write(' ').\npl_ends(X) :- format(\"~w~n\", [X]).\n")

    assert_eq(fed(s"import \"$file\"\nwrites( \"funl \" )\nif pl_says(#one) then writes( \"funl \" )\nif pl_ends(#two) then writes( \"funl\" )\n", []),
        "funl one funl two\nfunl<no newline>\nstatus: 0")

@test
CHDIR_CHANGES_THE_DIRECTORY_RELATIVE_PATHS_ARE_READ_FROM()
    val d = scratch()
    defer scrap(d)

    val f = put(d, "note.txt", "hello")

    assert_eq(ran_funl(s"import { chdir, cwd, read_file, exists } from funl:fs\nold = cwd()\nwrite( chdir(\"$d\") )\nwrite( exists(\"note.txt\") )\nwrite( read_file(\"note.txt\") )\nchdir(old)\nwrite( exists(\"note.txt\") | \"gone\" )\n"),
        "()\ntrue\nhello\ngone\nsucceeded")

@test
CHDIR_FAILS_FOR_A_DIRECTORY_THAT_IS_NOT_THERE()
    val d = scratch()
    defer scrap(d)

    assert_eq(ran_funl(s"import { chdir } from funl:fs\nwrite( chdir(\"$d/missing\") | \"failed\" )\n"), "failed\nsucceeded")

@test
CHDIR_WANTS_A_STRING()
    assert_eq(unplaced(ran_funl("import { chdir } from funl:fs\nchdir(3)\n")).contains("chdir"), true)
