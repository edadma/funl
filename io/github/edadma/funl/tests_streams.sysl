module io.github.edadma.funl
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{Search, join}

// The standard streams (`docs/reference/streams.md`): `writes`, `ewrite`, `ewrites` and `stop` on the
// way out, `read()` and `reads(n)` on the way in. Programs that read run through `run_source`, which
// is `funl file` with the terminal swapped for a script, so every line of input is the test's own.

private struct Feed
    lines: Buf[string]
    at: usize
    said: Buf[string]
    complained: Buf[string]

// The transcript of FunL program `text` reading `lines`: what it wrote, then what it wrote to standard
// error after `stderr:`, then the status after `status:`.
private fed(text: string, lines: []string) -> string
    var script: Buf[string] = buf()

    for l in lines
        script.push(l)

    val f: &Feed = Feed(script, 0, buf(), buf())

    val status = run_source("test.funl", text, (prompt) -> next_fed(f), (t) -> f.said.push(t), (t) -> if !t.is_empty() then f.complained.push(t))

    for c in f.complained.view()
        f.said.push(s"stderr: ${c.trim()}")

    f.said.push(s"status: $status")
    join(f.said.view(), "\n")

private next_fed(f: &Feed) -> Option[string]
    if f.at >= f.lines.len() then return None

    val l = f.lines.at(f.at)

    f.at += 1
    Some(l)

@test
READ_ANSWERS_EACH_LINE_WITHOUT_ITS_NEWLINE_AND_FAILS_AT_THE_END()
    assert_eq(fed("while (l <- read())\n  write( l )\nwrite( read() | \"end\" )\n", ["one", "two words", ""]),
        "one\ntwo words\n\nend\nstatus: 0")

@test
READ_ON_AN_EMPTY_INPUT_FAILS_AT_ONCE()
    assert_eq(fed("write( read() | \"none\" )\n", []), "none\nstatus: 0")

@test
READS_TAKES_CHARACTERS_ACROSS_LINES_NEWLINES_INCLUDED()
    assert_eq(fed("write( reads(2) )\nwrite( reads(4) )\n", ["abc", "def"]), "ab\nc\nde\nstatus: 0")

@test
READS_GIVES_WHAT_IS_LEFT_WHEN_THE_INPUT_ENDS_AND_THEN_FAILS()
    assert_eq(fed("write( reads(100) )\nwrite( reads(1) | \"end\" )\n", ["ab"]), "ab\n\nend\nstatus: 0")

@test
READS_COUNTS_CHARACTERS_NOT_BYTES()
    assert_eq(fed("write( reads(2) )\nwrite( reads(1) )\n", ["héllo"]), "hé\nl\nstatus: 0")

@test
READ_TAKES_THE_REST_OF_A_LINE_READS_BEGAN()
    assert_eq(fed("write( reads(2) )\nwrite( read() )\nwrite( read() )\n", ["abcd", "efg"]), "ab\ncd\nefg\nstatus: 0")

@test
READS_REFUSES_A_COUNT_THAT_IS_NOT_A_POSITIVE_INTEGER()
    val said = fed("write( reads(0) )\n", ["a"])

    assert(said.contains("'reads' wants a count of at least 1 and was given 0") && said.ends_with("status: 1"), said)
    val text = fed("write( reads(\"x\") )\n", ["a"])

    assert(text.contains("'reads' wants an integer count"), text)

@test
WRITES_LEAVES_THE_LINE_OPEN_FOR_THE_NEXT_WRITE()
    assert_eq(fed("writes( \"a\" )\nwrites( \"b\", 2 )\nwrite( \"c\" )\nwrites( \"d\\ne\" )\n", []), "ab, 2c\nd\ne\nstatus: 0")

@test
WRITES_WITH_NO_ARGUMENTS_WRITES_NOTHING()
    assert_eq(fed("writes()\nwrite( 1 )\n", []), "1\nstatus: 0")

@test
EWRITE_AND_EWRITES_GO_TO_STANDARD_ERROR_NOT_STANDARD_OUTPUT()
    assert_eq(fed("write( \"out\" )\newrite( \"oops\", 1 )\newrites( \"a\" )\newrites( \"b\" )\n", []),
        "out\nstderr: oops, 1\nstderr: ab\nstatus: 0")

@test
STOP_WRITES_TO_STANDARD_ERROR_AND_ENDS_THE_PROGRAM_WITH_STATUS_1()
    assert_eq(fed("write( \"before\" )\nstop( \"bad input:\", 3 )\nwrite( \"after\" )\n", []),
        "before\nstderr: bad input:, 3\nstatus: 1")

@test
STOP_IS_NOT_CAUGHT()
    assert_eq(fed("write( (stop(\"x\") catch e -> \"caught\") )\nwrite( \"after\" )\n", []), "stderr: x\nstatus: 1")

@test
THE_TEST_KIT_SHOWS_STANDARD_ERROR_LINES_AFTER_STANDARD_OUTPUT()
    assert_eq(ran_funl("write( 1 )\newrite( \"e\" )\nwrite( read() | \"no input\" )\n"), "1\nno input\nstderr: e\nsucceeded")

@test
CHDIR_CHANGES_THE_DIRECTORY_RELATIVE_PATHS_ARE_READ_FROM()
    val d = scratch()
    defer scrap(d)

    val f = put(d, "note.txt", "hello")

    assert_eq(ran_funl(s"import { chdir, cwd, read_file, exists } from funl:fs\nold = cwd()\nwrite( chdir(\"$d\") )\nwrite( exists(\"note.txt\") )\nwrite( read_file(\"note.txt\") )\nchdir(old)\nwrite( exists(\"note.txt\") | \"gone\" )\n"),
        "()\ntrue\nhello\ngone\nsucceeded")

@test
CHDIR_FAILS_FOR_A_DIRECTORY_THAT_IS_NOT_THERE()
    val d = scratch()
    defer scrap(d)

    assert_eq(ran_funl(s"import { chdir } from funl:fs\nwrite( chdir(\"$d/missing\") | \"failed\" )\n"), "failed\nsucceeded")

@test
CHDIR_WANTS_A_STRING()
    assert_eq(unplaced(ran_funl("import { chdir } from funl:fs\nchdir(3)\n")).contains("chdir"), true)
