module io.github.edadma.funl
@tests

import sysl.buf.Buf
import sysl.fs.read_text

// The programs of SICP's first chapters, ported from the old FunL's notes on them: each section a file
// under `tests/funl/`, `sicp_<section>.fl`, beside the output it must print, `.out`. The output is
// SICP's own answers -- its printed values, and the exercises' worked out by hand -- not a record of
// what FunL printed. Each runs on both heaps.
//
// **A section's programs that need reals or rationals are a file of their own**, `_reals` or
// `_fractions`, listed in `sicp_reasons.txt` with why: such a file not met is excused, one met is
// stale, and a listed name that is no program fails, so the list cannot outlive what it excuses.

private const Dir: string = "tests/funl/"

// Every program, by the name `sicp_reasons.txt` uses for it.
private val Programs: []const string = [
    "sicp_1_1_1", "sicp_1_1_1_fractions", "sicp_1_1_2", "sicp_1_1_2_reals", "sicp_1_1_3", "sicp_1_1_4",
    "sicp_1_1_6", "sicp_1_1_7", "sicp_1_1_8", "sicp_1_2_1", "sicp_1_2_2", "sicp_1_2_3", "sicp_1_2_4",
    "sicp_1_2_5", "sicp_1_3_1", "sicp_1_3_1_reals", "sicp_1_3_2", "sicp_1_3_2_reals", "sicp_2_1_1",
    "sicp_2_1_3"]

private sicp_data(name: string) -> string = read_text(Dir + name) match
    Ok(t) -> t
    Err(e) -> panic(s"cannot read $Dir$name (run the suite from the project root): $e")

private listed() -> Buf[string] = reason_names(Dir + "sicp_reasons.txt", sicp_data("sicp_reasons.txt"))

private is_program(name: string) -> bool
    for p in Programs
        if p == name then return true

    false

private sicp(name: string)
    assert_eq(is_program(name), true, s"$name is not in Programs")

    var excused = false

    for n in listed().view()
        if n == name then excused = true

    val got = ran_funl(sicp_data(name + ".fl"))

    assert_eq(excuse_verdict(name, got, sicp_data(name + ".out") + "succeeded", excused), "")

@test
EVERY_NAME_IN_THE_SICP_REASONS_IS_A_PROGRAM()
    for n in listed().view()
        assert_eq(is_program(n), true, s"sicp_reasons.txt names $n, which is not a program")

@test
A_SICP_PROGRAM_EXCUSED_AND_MET_IS_STALE()
    assert_eq(excuse_verdict("sicp_1_1_3", "390\nsucceeded", "390\nsucceeded", true),
        "stale: sicp_1_1_3 is listed in the reasons file and is met\n")
    assert_eq(excuse_verdict("sicp_1_1_3", "assembly: no\n", "390\nsucceeded", true), "")
    assert_eq(excuse_verdict("sicp_1_1_3", "assembly: no", "390\nsucceeded", false),
        "sicp_1_1_3 got\nassembly: no\nwant\n390\nsucceeded\n")

