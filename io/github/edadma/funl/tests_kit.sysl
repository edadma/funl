module io.github.edadma.funl
@tests

import sh.sysl.parsing.{full_report, source_of}
import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.text.{Search, split, str_builder}

// The harness: assemble a program into a fresh VM, run it, and answer what it said.
//
// **Every program is run twice** -- on a roomy heap and on one collected before every
// instruction -- and the two transcripts must agree. A root missing from `roots`, or a
// value held only in a sysl local across a collection, makes the second disagree with the first
// rather than waiting for a user's program to find it.
//
// Nothing here is `private`: the `tests_*` files are the callers.

const RoomyHeap: usize = 4194304
const RoomyFloor: usize = 65536

// Small enough that a program's garbage is collected constantly, large enough for its live data.
const TightHeap: usize = 65536

// What one run came to.
struct Said
    // Each line `write` printed, then the outcome: `succeeded`, `failed` or `fault: <message>`.
    text: string
    collections: usize
    trail: usize

    // The most entries the control stack held at once.
    control_peak: usize

    // How many chunks the VM held when the run ended.
    chunks: usize

    // The warnings compiling it rendered, or `""`. They are not part of `text`, so a transcript reads
    // the same whether or not its program drew a warning.
    warned: string

outcome_text(o: Outcome) -> string = o match
    Succeeded -> "succeeded"
    Failed -> "failed"
    Faulted(m) -> s"fault: $m"
    Halted(n) -> s"halted: $n"

// Run what `build` makes on a VM with this heap and schedule.
run_on(heap: usize, floor: usize, growth: usize, build: () -> Result[usize, string]) -> Said =
    run_compiled(heap, floor, growth, () -> build() match
        Ok(chunk) -> Ready(chunk, "")
        Err(e) -> Compiled.Refused(e))

// Run what `build` compiles on a VM with this heap and schedule, keeping the warnings it rendered.
run_compiled(heap: usize, floor: usize, growth: usize, build: () -> Compiled) -> Said
    var v = new_vm(heap, floor, growth)
    val was = enter(&v)
    var out = str_builder()
    var warned = ""

    val outcome = build() match
        Ready(chunk, said) ->
            warned = said
            outcome_text(run(&v, chunk))
        Compiled.Refused(e) -> s"assembly: $e"
        CannotRead(why) -> s"assembly: $why"

    for line in v.output.view()
        out.push(line)
        out.push("\n")

    out.push(outcome)

    val said = Said(out.finish(), v.collections, v.trail.len(), v.control_peak, v.chunks.len(), warned)

    dispose_vm(&v)
    leave(was)
    said
end run_compiled

roomy(build: () -> Result[usize, string]) -> Said = run_on(RoomyHeap, RoomyFloor, 2, build)

// Collect before every instruction.
stressed(build: () -> Result[usize, string]) -> Said = run_on(TightHeap, 0, 0, build)

// `roomy` and `stressed` for a build that keeps its warnings.
roomy_compiled(build: () -> Compiled) -> Said = run_compiled(RoomyHeap, RoomyFloor, 2, build)

stressed_compiled(build: () -> Compiled) -> Said = run_compiled(TightHeap, 0, 0, build)

// The transcript of `build`, which must be the same on both heaps.
ran(build: () -> Result[usize, string]) -> string
    val calm = roomy(build)
    val tight = stressed(build)

    assert_eq(tight.text, calm.text, "the program said something different on a heap collected at every step")
    calm.text

// Transcript `said` with its fault's instruction index taken out: `fault: f@19: m` reads `fault: f:
// m`, so a test pinning a fault's text does not move whenever the code before the fault does.
unplaced(said: string) -> string
    val f = said.index_of("fault: ") match
        Some(i) -> i
        None -> return said

    val tail = said.slice(f, said.bytes.len)

    val at = tail.index_of("@") match
        Some(i) -> i
        None -> return said

    val after = tail.slice(at, tail.bytes.len)

    val colon = after.index_of(":") match
        Some(i) -> i
        None -> return said

    said.slice(0, f + at) + after.slice(colon, after.bytes.len)

// -- FunL source -------------------------------------------------------------------------------

// Compile FunL `text` into the running VM: its chunk, or every diagnostic rendered.
compiled_text(text: string) -> Result[usize, string]
    val src = source_of("test.funl", text)
    var r = full_report()

    compile_program(src, &r) match
        Some(chunk) -> Ok(chunk)
        None -> Err(r.render(src))

// The transcript of FunL program `text`, run on both heaps; a refused program answers
// `assembly: ` and its diagnostics.
ran_funl(text: string) -> string = ran(() -> compiled_text(text))

// What compiling `text` reports, one diagnostic a line: `severity line:col message`, in the order
// they were found.
complaints(text: string) -> string
    var v = new_vm(RoomyHeap, RoomyFloor, 2)
    val was = enter(&v)
    val src = source_of("test.funl", text)
    var r = full_report()
    var out = str_builder()

    compile_program(src, &r)

    for i in 0..<r.len()
        val d = r.at(i)

        out.push(s"${d.severity} ${src.locate(d.span.start)} ${d.message}\n")

    dispose_vm(&v)
    leave(was)
    out.finish()
end complaints

// Every diagnostic compiling `text` gives, rendered as a person sees them.
rendered(text: string) -> string
    var v = new_vm(RoomyHeap, RoomyFloor, 2)
    val was = enter(&v)
    val src = source_of("test.funl", text)
    var r = full_report()

    compile_program(src, &r)

    val out = r.render(src)

    dispose_vm(&v)
    leave(was)
    out

// -- Prolog source ------------------------------------------------------------------------------

// Load Prolog `text` into the running VM as a whole program: its chunk, or every diagnostic rendered.
prolog_text(text: string) -> Result[usize, string]
    val src = source_of("test.pl", text)
    var r = full_report()

    prolog_program(src, &r) match
        Some(chunk) -> Ok(chunk)
        None -> Err(r.render(src))

// The transcript of Prolog program `text` -- its directives and `initialization/1` goals run -- on
// both heaps.
ran_prolog(text: string) -> string = ran(() -> prolog_text(text))

// What loading Prolog `text` reports, one diagnostic a line: `severity line:col message`.
prolog_complaints(text: string) -> string
    var v = new_vm(RoomyHeap, RoomyFloor, 2)
    val was = enter(&v)
    val src = source_of("test.pl", text)
    var r = full_report()
    var out = str_builder()

    prolog_program(src, &r)

    for i in 0..<r.len()
        val d = r.at(i)

        out.push(s"${d.severity} ${src.locate(d.span.start)} ${d.message}\n")

    dispose_vm(&v)
    leave(was)
    out.finish()
end prolog_complaints

// -- Scratch files ------------------------------------------------------------------------------

// A directory of the test's own for the files it needs on disk -- a file to consult or import, a
// program for the driver -- made under `TMPDIR`, so nothing is ever written into the tree. The test
// removes it with `defer scrap(d)` on the line after.
scratch() -> string = make_temp_dir("funl-test-").unwrap()

// Write `text` to `name` in scratch directory `dir`, answering the file's path.
put(dir: string, name: string, text: string) -> string
    val file = s"$dir/$name"

    write_text(file, text).unwrap()
    file

// Remove scratch directory `dir` and everything in it.
scrap(dir: string)
    remove_dir_all(dir).unwrap()

// A Prolog file a FunL program imports, calling FunL and called from it: `par/2` is a FunL relation
// and `double/2` the FunL function `double/1`, both the importing program's. `walk/2` is indexed on
// its first argument, so each step leaves no choice point. `grand/2` is at line 1 and `either/1` at
// line 3, which the clash reports name.
const InteropPl: string = "grand(X, Z) :- par(X, Y), par(Y, Z).\n" +
    "twice_of(X, Y) :- double(X, Y).\n" +
    "either(X) :- X = left ; X = right.\n" +
    "first(X) :- either(X), !.\n" +
    "walk([], done).\n" +
    "walk([_|T], R) :- walk(T, R).\n" +
    "show_term(X) :- writeq(X), nl.\n" +
    ":- write(loaded), nl.\n"

// The FunL line importing `InteropPl`, written into scratch directory `dir`.
import_interop(dir: string) -> string
    val file = put(dir, "interop.pl", InteropPl)

    s"import \"$file\"\n"

// A Prolog file other files and FunL programs define again, to be refused: `shared/1` at line 1, and
// `counter/1` declared dynamic at line 2, column 4.
const ClashAPl: string = "shared(a).\n:- dynamic(counter/1).\ncounter(0).\n"

// `shared/1` again, at line 1.
const ClashBPl: string = "shared(b).\n"

// Clauses for `counter/1`, which `ClashAPl` declares dynamic, at line 1.
const ClashCPl: string = "counter(5).\n"

// A FunL file Prolog imports: a relation, a generating function and plain functions, one of them
// reading a variable of the file's top level. `scaled` is at line 5, column 5.
const GeometryFunl: string = "val scale = 10\n" +
    "def side(#square, 4)\n" +
    "def side(#triangle, 3)\n" +
    "def upto(n) = 1 to n\n" +
    "def scaled(n) = n * scale\n" +
    "def halve(n) = 10 / n\n" +
    "write(#geometry)\n"

// A Prolog file importing `GeometryFunl` by a path relative to itself, and calling what it defines:
// `side/2`, `upto/2`, `scaled/2` and `halve/2` there, the last raising on zero.
const ShapesPl: string = ":- import(\"geometry.funl\").\n" +
    "sides(S, N) :- side(S, N).\n" +
    "counted(N, L) :- findall(K, upto(N, K), L).\n" +
    "area(N, A) :- scaled(N, A).\n" +
    "guarded(X, R) :- catch(halve(X, R), error(E, _), R = caught(E)).\n"

// Write `GeometryFunl` and `ShapesPl` into scratch directory `dir`, answering the path of the latter.
put_shapes(dir: string) -> string
    put(dir, "geometry.funl", GeometryFunl)
    put(dir, "shapes.pl", ShapesPl)

// Two greetings, written as the file loads.
const HelloPl: string = "greeting(hello).\ngreeting(world).\n:- forall(greeting(G), (write(G), nl)).\n"

// -- Reasons files ------------------------------------------------------------------------------

// The names a corpus's reasons file lists, a row `name<TAB>reason` each, `#` starting a comment row.
// `file` names it in the complaint about a malformed row.
reason_names(file: string, text: string) -> Buf[string]
    var out: Buf[string] = buf()

    for row in split(text, "\n")
        if row.bytes.len == 0 || row.bytes[0] == u8('#') then continue

        val cols = split(row, "\t")

        if cols.len < 2 || cols[1].bytes.len == 0 then panic(s"$file: `$row` is not `name<TAB>reason`")

        out.push(cols[0])

    out

// What is wrong with corpus entry `name`, whose run said `got` where `want` was owed: an entry not
// met and not `excused`, or one excused and met, which is stale. The empty string when neither.
excuse_verdict(name: string, got: string, want: string, excused: bool) -> string
    val met = got == want

    if met && excused then return s"stale: $name is listed in the reasons file and is met\n"
    if !met && !excused then return s"$name got\n${got}\nwant\n${want}\n"

    ""

// The id of builtin `name`, which the test is about to emit a call to.
builtin(name: string) -> usize = native_id(name).unwrap()

// Emit `write` of the top of the stack, dropping its answer.
say(e: *Emit)
    e.op(Native(builtin("write"), 1))
    e.op(Pop)

// Emit `write` of slot `slot`.
say_slot(e: *Emit, slot: usize)
    e.op(LoadSlot(0, slot))
    say(e)

// Emit a push of atom `name`.
push_atom(e: *Emit, name: string)
    e.op(PushConst(e.constant(atom(name))))
