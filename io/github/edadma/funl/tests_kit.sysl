module io.github.edadma.funl
@tests

import sh.sysl.parsing.{full_report, source_of}
import sysl.text.str_builder

// The harness: assemble a program into a fresh VM, run it, and answer what it said.
//
// **Every program is run twice** -- on a roomy heap and on one collected before every
// instruction -- and the two transcripts must agree. A root missing from `roots`, or a
// value held only in a sysl local across a collection, makes the second disagree with the first
// rather than waiting for a user's program to find it.
//
// Nothing here is `private`: the `tests_*` files are the callers.

const RoomyHeap: usize = 4194304
const RoomyFloor: usize = 65536

// Small enough that a program's garbage is collected constantly, large enough for its live data.
const TightHeap: usize = 65536

// What one run came to.
struct Said
    // Each line `write` printed, then the outcome: `succeeded`, `failed` or `fault: <message>`.
    text: string
    collections: usize
    trail: usize

    // The most entries the control stack held at once.
    control_peak: usize

outcome_text(o: Outcome) -> string = o match
    Succeeded -> "succeeded"
    Failed -> "failed"
    Faulted(m) -> s"fault: $m"

// Run what `build` makes on a VM with this heap and schedule.
run_on(heap: usize, floor: usize, growth: usize, build: () -> Result[usize, string]) -> Said
    var v = new_vm(heap, floor, growth)
    val was = enter(&v)
    var out = str_builder()

    val outcome = build() match
        Ok(chunk) -> outcome_text(run(&v, chunk))
        Err(e) -> s"assembly: $e"

    for line in v.output.view()
        out.push(line)
        out.push("\n")

    out.push(outcome)

    val said = Said(out.finish(), v.collections, v.trail.len(), v.control_peak)

    dispose_vm(&v)
    leave(was)
    said
end run_on

roomy(build: () -> Result[usize, string]) -> Said = run_on(RoomyHeap, RoomyFloor, 2, build)

// Collect before every instruction.
stressed(build: () -> Result[usize, string]) -> Said = run_on(TightHeap, 0, 0, build)

// The transcript of `build`, which must be the same on both heaps.
ran(build: () -> Result[usize, string]) -> string
    val calm = roomy(build)
    val tight = stressed(build)

    assert_eq(tight.text, calm.text, "the program said something different on a heap collected at every step")
    calm.text

// -- FunL source -------------------------------------------------------------------------------

// Compile FunL `text` into the running VM: its chunk, or every diagnostic rendered.
compiled_text(text: string) -> Result[usize, string]
    val src = source_of("test.fl", text)
    var r = full_report()

    compile_program(src, &r) match
        Some(chunk) -> Ok(chunk)
        None -> Err(r.render(src))

// The transcript of FunL program `text`, run on both heaps; a refused program answers
// `assembly: ` and its diagnostics.
ran_funl(text: string) -> string = ran(() -> compiled_text(text))

// What compiling `text` reports, one diagnostic a line: `severity line:col message`, in the order
// they were found.
complaints(text: string) -> string
    var v = new_vm(RoomyHeap, RoomyFloor, 2)
    val was = enter(&v)
    val src = source_of("test.fl", text)
    var r = full_report()
    var out = str_builder()

    compile_program(src, &r)

    for i in 0..<r.len()
        val d = r.at(i)

        out.push(s"${d.severity} ${src.locate(d.span.start)} ${d.message}\n")

    dispose_vm(&v)
    leave(was)
    out.finish()
end complaints

// Every diagnostic compiling `text` gives, rendered as a person sees them.
rendered(text: string) -> string
    var v = new_vm(RoomyHeap, RoomyFloor, 2)
    val was = enter(&v)
    val src = source_of("test.fl", text)
    var r = full_report()

    compile_program(src, &r)

    val out = r.render(src)

    dispose_vm(&v)
    leave(was)
    out

// The id of builtin `name`, which the test is about to emit a call to.
builtin(name: string) -> usize = native_id(name).unwrap()

// Emit `write` of the top of the stack, dropping its answer.
say(e: *Emit)
    e.op(Native(builtin("write"), 1))
    e.op(Pop)

// Emit `write` of slot `slot`.
say_slot(e: *Emit, slot: usize)
    e.op(LoadSlot(0, slot))
    say(e)

// Emit a push of atom `name`.
push_atom(e: *Emit, name: string)
    e.op(PushConst(e.constant(atom(name))))
