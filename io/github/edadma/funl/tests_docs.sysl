module io.github.edadma.funl
@tests

import sh.sysl.parsing.{full_report, source_of}
import sysl.buf.{Buf, buf}
import sysl.fs.{entries, is_dir, make_dir_all, read_text}
import sysl.path.parent
import sysl.slices.sort_by
import sysl.text.{Search, replace_all, split, str_builder}

// The programs printed in `docs/reference/` and `docs/library/` are run, and what they print is
// compared against what the page says they print.
//
// **A reference rots silently.** Nothing in an ordinary build reads it, so a page goes on claiming
// what the language did a year ago until a reader types a program in and gets something else. So a
// fenced block on a page is not a picture of a program, it IS the program, and what follows it says
// which kind:
//
//   - a `funl` block followed by an `output` block is a whole program, and the output block is what
//     it prints -- run on both heaps, and compared;
//   - a `funl` block followed by an `error` block is a program FunL refuses, at compile time or by a
//     fault, and the error block is what it says -- run, required not to succeed, and what it said
//     required to contain that text;
//   - a `funl` block with neither under it is a fragment, quoted for its shape, and is not run.
//
// A `warning` block says compiling the program draws a warning containing that text. With an
// `output` block as well, the program must also print exactly that; alone, only the warning is
// claimed. **A program shown with an `output` block and no `warning` block must compile without a
// warning**, so a page never prints a program whose warning the reader would see and the page hides.
// A `warning` block does not go with an `error` block: a refused program's warnings are part of what
// it says, and the `error` block quotes them.
//
// A `prolog` block follows the same three rules and is loaded as a whole Prolog program, and an
// `lfunl` block is a whole literate document, compiled exactly as the `funl` driver compiles a
// `.lfunl` file. Its name is the word after `lfunl` (`document.lfunl` without one), so a diagnostic
// in its `error` block names the document's own line and column. A document holds fences of its own,
// so its outer fence is longer than any inside it, as Markdown has it.
//
// **A fragment is as unverified as the prose beside it and looks exactly like a checked block to a
// reader.** `DocBlockCensus` is what keeps that hole from widening: the counts are written down per
// page, so a block that quietly loses its `output` shows up as a page whose runnable count fell.

// -- what a block claims about itself ----------------------------------------------------------------

// What a program block on a page claims about itself.
private enum Claim
    // A whole program, what running it prints, and the warning compiling it draws -- `""` for a
    // program the page shows compiling cleanly.
    Prints(text: string, warning: string)

    // A whole program that compiles with a warning. What it does when run is not claimed.
    Warns(warning: string)

    // A program FunL refuses, and what its diagnostic or fault says.
    Refused(message: string)

    // Claims that cannot go together, and why.
    Muddled(why: string)

    // A fragment, quoted to make a point about shape. Nothing is asserted about it.
    Quoted

// A fenced block as the markdown holds it: the word after the backticks, the word after that (or
// `""`), the body, and the line the opening fence is on.
private struct Fence
    lang: string
    name: string
    body: string
    line: usize

// One program block, with where it came from -- a failure names the page and the line of the block,
// because a reader of the failure has only the page to go and fix. `file` is the name the program is
// compiled under: the page itself, or a literate document's own name.
private struct Block
    page: string
    lang: string
    line: usize
    file: string
    source: string
    claim: Claim

    display(self) -> string = s"${self.page}:${self.line}, ${self.lang} block"

// Whether a fence's word makes it a program.
private is_program(lang: string) -> bool = lang == "funl" || lang == "prolog" || lang == "lfunl"

// The name a literate block is compiled under when its fence names none.
private const UnnamedDocument: string = "document.lfunl"

// The name block fence `f` on `page` is compiled under. A literate block is its document's own
// name. A `funl` or `prolog` block whose fence names a file is that file beside the page -- a page
// about packages puts its program inside a project of companion files, which is how the program
// finds its `package.funl` -- and any other block is the page itself.
private file_of(page: string, f: Fence) -> string
    if f.lang == "lfunl" then return if f.name == "" then UnnamedDocument else f.name

    if f.name == "" then return page

    parent(page) match
        Some(dir) -> s"$dir/${f.name}"
        None -> f.name

// -- reading the pages -------------------------------------------------------------------------------

// Every markdown page in `docs/reference/` and then `docs/library/`. `docs/design/` is not run: it
// describes decisions, and its blocks carry no language tag.
//
// **The path is relative to the project root**, which is where `sysl test .` runs.
private doc_pages() -> Buf[string]
    var out: Buf[string] = buf()

    pages_in("docs/reference", &out)
    pages_in("docs/library", &out)
    out

// The markdown pages directly in `dir`, if there is such a directory.
//
// **Sorted, because the census is compared as text**, and a directory answers in whatever order it
// likes.
private pages_in(dir: string, out: *Buf[string])
    if !is_dir(dir) then return

    var names = entries(dir).unwrap()

    sort_by(names.view(), (a, b) -> a < b)

    for i in 0..<names.len()
        val page = s"$dir/${names.at(i)}"

        if page.ends_with(".md") && page_runs_here(page) then out.push(page)

// Whether this build has what `page` is about: the page of a module behind a feature this build left
// off has nothing to run against.
private page_runs_here(page: string) -> bool
#if !feature_http
    if page == "docs/library/http.md" then return false
#endif
#if !feature_async || !feature_http
    if page == "docs/library/async.md" then return false
#endif
    true

// The fenced blocks of a markdown document, in order.
//
// **Only a fence at the left margin opens a block.** An indented one is inside a list item or a
// block quote, where the prose owns it.
//
// **A block is closed only by a fence at least as long as the one that opened it, with nothing after
// it**, as in Markdown. So a block opened with four backticks holds three-backtick fences as text --
// which is how a page quotes a literate document, fences and all.
private fences_of(text: string) -> Buf[Fence]
    var out: Buf[Fence] = buf()
    val lines = split(text, "\n")
    var open = false
    var length: usize = 0
    var lang = ""
    var name = ""
    var at: usize = 0
    var body = str_builder()

    for i in 0..<lines.len
        val line = lines[i]
        val ticks = backticks_at_start(line)

        if open && ticks >= length && line.slice(ticks, line.len).trim() == ""
            out.push(Fence(lang, name, body.finish(), at))
            body = str_builder()
            open = false
        elif open
            body.push(line)
            body.push("\n")
        elif ticks >= 3
            // The first two words after the backticks: the language, and a literate document's name.
            val words = split(line.slice(ticks, line.len).trim(), " ")

            lang = words[0]
            name = if words.len > 1 then words[1] else ""
            length = ticks
            at = i + 1
            open = true

    out
end fences_of

// How many backticks `line` starts with.
private backticks_at_start(line: string) -> usize
    var n: usize = 0

    // Sliced from `n` onwards, never one byte at a time: the line may start with a character wider
    // than a byte, and `n` is only ever past backticks.
    while line.slice(n, line.len).starts_with("`")
        n += 1

    n

// The program blocks of a page's `text`, each paired with what the page claims about it.
private blocks_of_text(page: string, text: string) -> Buf[Block]
    val fences = fences_of(text)
    var out: Buf[Block] = buf()

    for i in 0..<fences.len()
        val f = fences.at(i)

        if is_program(f.lang)
            out.push(Block(page, f.lang, f.line, file_of(page, f), f.body, claim_after(fences, i + 1)))

    out

private blocks_of(page: string) -> Buf[Block] = blocks_of_text(page, read_text(page).unwrap())

// What the fences after a program block say about it: the first `output` or `error` block, and the
// first `warning` block, to appear before the next program block.
//
// **Not simply the very next fence**, so a page may read *program, how to run it, what it prints*
// with another block in the middle. The search stops at the next program, so a claim can never be
// attached to the wrong one.
private claim_after(fences: Buf[Fence], from: usize) -> Claim
    var kind = ""
    var said = ""
    var warned = false
    var warning = ""

    for i in from..<fences.len()
        val f = fences.at(i)

        if is_program(f.lang) then break

        if kind == "" && (f.lang == "output" || f.lang == "error")
            kind = f.lang
            said = f.body
        elif f.lang == "warning" && !warned
            warned = true
            warning = f.body

    if kind == "error" && warned
        Muddled("a `warning` block cannot go with an `error` block: the error block quotes a refused program's warnings")
    elif kind == "error"
        Refused(said)
    elif kind == "output"
        Prints(said, warning)
    elif warned
        Warns(warning)
    else
        Quoted
end claim_after

// -- running one block -------------------------------------------------------------------------------

// Compile a FunL block into the running VM, the page named as its file so a diagnostic points there.
private compiled_block(page: string, text: string) -> Compiled
    val src = source_of(page, text)
    var r = full_report()

    val chunk = compile_program(src, &r)

    compiled_with(chunk, if r.is_empty() then "" else r.render(src))

// Load a Prolog block into the running VM as a whole program.
private loaded_block(page: string, text: string) -> Compiled
    val src = source_of(page, text)
    var r = full_report()

    val chunk = prolog_program(src, &r)

    compiled_with(chunk, if r.is_empty() then "" else r.render(src))

// A block's chunk, if it has one, with what compiling it said.
private compiled_with(chunk: Option[usize], said: string) -> Compiled = chunk match
    Some(at) -> Ready(at, said)
    None -> Compiled.Refused(said)

// A FunL, Prolog or literate block compiled into the running VM. A literate block is compiled as the
// `funl` driver compiles a `.lfunl` file named `file`.
// A block in a project whose manifest needs a newer FunL is refused first, as the driver refuses it.
private built(lang: string, file: string, text: string) -> Compiled =
    if project_floor_refusal(file).is_some()
        Compiled.Refused(s"error: ${project_floor_refusal(file).unwrap()}\n")
    elif lang == "funl"
        compiled_block(file, text)
    elif lang == "lfunl"
        compile_text(file, text)
    else
        loaded_block(file, text)

// What running a block came to: what it printed, and how it ended -- `succeeded`, `failed`,
// `fault: <message>`, `halted: <status>` for a program that ran `halt`, or `assembly: <diagnostics>`
// for a program refused before it ran. A program that halts ran, whatever its status.
private struct Ran
    printed: string
    outcome: string

    // The warnings compiling it rendered, or `""`.
    warned: string

    ok(self) -> bool = self.outcome == "succeeded" || self.outcome.starts_with("halted: ")

    refused(self) -> bool = self.outcome.starts_with("assembly: ")

// A transcript from the kit, cut into what was printed and the outcome on its last line.
//
// **A refused program's transcript is all outcome**: it never ran, and the rendered diagnostics run
// over several lines.
private cut_transcript(text: string, warned: string) -> Ran
    if text.starts_with("assembly: ") then return Ran("", text, warned)

    val lines = split(text, "\n")
    var b = str_builder()

    for i in 0..<lines.len - 1
        b.push(lines[i])
        b.push("\n")

    Ran(b.finish(), unplaced(lines[lines.len - 1]), warned)

// Run block `b` on a roomy heap and on one collected at every step, answering the run or the
// complaint that the two disagreed.
private run_block(b: Block) -> Result[Ran, string]
    val lang = b.lang
    val file = b.file
    val source = b.source
    val calm = roomy_compiled(() -> built(lang, file, source))
    val tight = stressed_compiled(() -> built(lang, file, source))

    if calm.text != tight.text
        return Err(s"${b.display()}: it said something different on a heap collected at every step:\n" +
            s"roomy:\n${doc_indent(calm.text)}\ncollected:\n${doc_indent(tight.text)}")

    Ok(cut_transcript(calm.text, calm.warned))

// Check one block, answering the complaint if it has one, or `""`.
//
// **Every block answers rather than asserting, so one run reports every page that has drifted**
// instead of the first: one language change invalidates every page that leans on it.
private check_block(b: Block) -> string = b.claim match
    Prints(expected, warning) -> check_prints(b, expected, warning)
    Warns(warning) -> check_warns(b, warning)
    Refused(expected) -> check_refused(b, expected)
    Muddled(why) -> s"${b.display()}: $why"
    Quoted -> ""

private check_prints(b: Block, expected: string, warning: string) -> string
    val r = run_block(b) match
        Ok(ran) -> ran
        Err(e) -> return e

    val warned = warning_complaint(b, warning, r)

    if warned != ""
        warned
    elif !r.ok()
        s"${b.display()}: the page says this runs, and it did not:\n${doc_indent(r.outcome)}"
    elif tidied(r.printed) != tidied(expected)
        s"${b.display()}: what it printed is not what the page says.\n" +
            s"page:\n${doc_indent(expected)}\nprogram:\n${doc_indent(r.printed)}"
    else
        ""

private check_warns(b: Block, warning: string) -> string
    val r = run_block(b) match
        Ok(ran) -> ran
        Err(e) -> return e

    if r.refused()
        s"${b.display()}: the page says this compiles with a warning, and it was refused:\n${doc_indent(r.outcome)}"
    else
        warning_complaint(b, warning, r)

// What is wrong with the warnings compiling a block drew, against the `warning` block the page shows
// (`""` for none), or `""`. A refused program's warnings are its error block's business.
private warning_complaint(b: Block, warning: string, r: Ran) -> string
    val expected = warning.trim()

    if r.refused()
        ""
    elif expected == "" && r.warned != ""
        s"${b.display()}: compiling it warned, and the page shows no `warning` block:\n${doc_indent(r.warned)}"
    elif expected != "" && r.warned == ""
        s"${b.display()}: the page says compiling this warns, and it did not"
    elif !r.warned.contains(expected)
        s"${b.display()}: it warned, but not in the words the page quotes.\n" +
            s"page:\n${doc_indent(warning)}\nFunL:\n${doc_indent(r.warned)}"
    else
        ""

private check_refused(b: Block, expected: string) -> string
    val r = run_block(b) match
        Ok(ran) -> ran
        Err(e) -> return e

    if r.ok()
        s"${b.display()}: the page says FunL refuses this, and it ran"
    elif !r.outcome.contains(expected.trim())
        s"${b.display()}: it was refused, but not in the words the page quotes.\n" +
            s"page:\n${doc_indent(expected)}\nFunL:\n${doc_indent(r.outcome)}"
    else
        ""

// Every complaint about page `page`'s blocks, one after another, or `""`.
private check_page(page: string) -> string
    val blocks = blocks_of(page)
    var b = str_builder()

    for i in 0..<blocks.len()
        val said = check_block(blocks.at(i))

        if said != ""
            b.push(said)
            b.push("\n")

    b.finish()

// A page's census line: `path runnable refused fragment warned`. `runnable` counts the programs whose
// output is claimed and `warned` those whose warning is, so a program with both is in both, and one
// shown with only a `warning` block is in `warned` alone.
private census_line(page: string, blocks: Buf[Block]) -> string
    var runnable: usize = 0
    var refused: usize = 0
    var fragments: usize = 0
    var warned: usize = 0

    for i in 0..<blocks.len()
        blocks.at(i).claim match
            Prints(_, warning) ->
                runnable += 1
                if warning.trim() != "" then warned += 1
            Warns(_) -> warned += 1
            Refused(_) -> refused += 1
            Muddled(_) -> fragments += 1
            Quoted -> fragments += 1

    s"$page $runnable $refused $fragments $warned"

// Trailing whitespace is not a claim a page makes. A fence keeps a final newline the writer did not
// type and cannot see, so comparing raw text would fail every block for a reason no reader could
// act on.
private tidied(text: string) -> string
    val lines = split(text, "\n")
    var b = str_builder()

    for i in 0..<lines.len
        if i > 0 then b.push("\n")

        b.push(lines[i].trim_end())

    b.finish().trim()

private doc_indent(text: string) -> string
    val lines = split(text, "\n")
    var b = str_builder()

    for i in 0..<lines.len
        if i > 0 then b.push("\n")

        b.push("    ")
        b.push(lines[i])

    b.finish()

// -- the documentation -------------------------------------------------------------------------------

@test
EVERY_PROGRAM_IN_THE_REFERENCE_RUNS_AND_PRINTS_WHAT_THE_PAGE_SAYS()
    val pages = doc_pages()
    var complaints = str_builder()
    var checked: usize = 0

    for i in 0..<pages.len()
        complaints.push(check_page(pages.at(i)))

        val blocks = blocks_of(pages.at(i))

        for j in 0..<blocks.len()
            blocks.at(j).claim match
                Quoted -> ()
                _ -> checked += 1

    assert_eq(complaints.finish(), "")

    // **Finding nothing to run would leave this green having tested nothing**, which is the failure a
    // walk can have and a written list cannot.
    assert(checked >= 10)

@test
EVERY_PAGE_CARRIES_THE_BLOCKS_IT_IS_EXPECTED_TO()
    // A page that gains or loses a checked block fails this until the number is changed, which is
    // the point -- the number is what says somebody looked.
    val pages = doc_pages()
    var b = str_builder()

    for i in 0..<pages.len()
        b.push(census_line(pages.at(i), blocks_of(pages.at(i))))
        b.push("\n")

    assert_eq(b.finish(), DocBlockCensus)

// What every page holds, as `path runnable refused fragment warned`.
private val DocBlockCensus: string = "docs/reference/README.md 0 0 0 0\n" +
    "docs/reference/assignment.md 11 6 0 0\n" +
    "docs/reference/async.md 11 5 0 0\n" +
    "docs/reference/data.md 34 17 0 0\n" +
    "docs/reference/functions.md 26 18 0 0\n" +
    "docs/reference/generators.md 24 5 0 0\n" +
    "docs/reference/modules.md 18 21 0 0\n" +
    "docs/reference/numbers.md 19 18 0 0\n" +
    "docs/reference/packages.md 4 10 0 1\n" +
    "docs/reference/prolog.md 42 6 0 0\n" +
    "docs/reference/regex.md 21 8 0 0\n" +
    "docs/reference/relations.md 18 6 0 1\n" +
    "docs/reference/scanning.md 16 3 0 0\n" +
    "docs/reference/source-files.md 1 3 2 0\n" +
    "docs/reference/strings.md 14 6 0 0\n" +
    "docs/reference/success-and-failure.md 17 5 0 0\n" +
    "docs/library/README.md 0 0 0 0\n" +
    AsyncCensus +
    "docs/library/fs.md 13 2 0 0\n" +
    HttpCensus +
    "docs/library/json.md 7 1 0 0\n" +
    "docs/library/prelude.md 14 10 0 0\n" +
    "docs/library/process.md 16 4 0 0\n" +
    "docs/library/sqlite.md 10 1 0 0\n" +
    "docs/library/time.md 8 1 0 0\n"

// `docs/library/http.md`'s line, which a build without the `http` feature does not run.
#if feature_http
private val HttpCensus: string = "docs/library/http.md 5 2 1 0\n"
#endif
#if !feature_http
private val HttpCensus: string = ""
#endif

// `docs/library/async.md`'s line: its I/O needs the `async` feature, and its `fetch` `http` as well,
// so a build without both does not run the page. Its timers are tested in `tests_events.sysl` in
// every build.
#if feature_async && feature_http
private val AsyncCensus: string = "docs/library/async.md 13 3 0 0\n"
#else
private val AsyncCensus: string = ""
#endif

// -- the runner itself -------------------------------------------------------------------------------

// A page of the runner's own, in a scratch directory: its complaints, with the scratch path taken
// out so the expectation can be written down.
private complaints_about(text: string) -> string
    val d = scratch()
    defer scrap(d)

    val page = put(d, "page.md", text)

    replace_all(check_page(page), page, "page.md")

@test
A_PAGE_WHOSE_PROGRAMS_DO_WHAT_IT_SAYS_DRAWS_NO_COMPLAINT()
    val text = "# A page\n\n```funl\nwrite( 1 + 2 )\n```\n\nRun it:\n\n```sh\nfunl page.funl\n```\n\n" +
        "```output\n3\n```\n\n```funl\nwrite( 1 / 0 )\n```\n\n```error\ndivides by zero\n```\n"

    assert_eq(complaints_about(text), "")

@test
A_WRONG_OUTPUT_BLOCK_IS_A_COMPLAINT_NAMING_THE_PAGE_AND_THE_LINE()
    val text = "# A page\n\n```funl\nwrite( 1 + 2 )\n```\n\n```output\n4\n```\n"

    assert_eq(complaints_about(text), "page.md:3, funl block: what it printed is not what the page says.\n" +
        "page:\n    4\n    \nprogram:\n    3\n    \n")

@test
A_PROGRAM_THE_PAGE_SAYS_RUNS_AND_THAT_FAULTS_IS_A_COMPLAINT()
    val text = "```funl\nwrite( 1 / 0 )\n```\n\n```output\n\n```\n"

    assert_eq(complaints_about(text), "page.md:1, funl block: the page says this runs, and it did not:\n" +
        "    fault: main: 1 / 0 divides by zero\n")

@test
A_PROGRAM_THE_PAGE_SAYS_IS_REFUSED_AND_THAT_RUNS_IS_A_COMPLAINT()
    val text = "```funl\nwrite( 1 )\n```\n\n```error\ndivides by zero\n```\n"

    assert_eq(complaints_about(text), "page.md:1, funl block: the page says FunL refuses this, and it ran\n")

@test
A_REFUSAL_IN_OTHER_WORDS_THAN_THE_PAGE_QUOTES_IS_A_COMPLAINT()
    val text = "```funl\nwrite( 1 / 0 )\n```\n\n```error\nis not defined\n```\n"

    assert(complaints_about(text).starts_with("page.md:1, funl block: it was refused, but not in the words the page quotes."))

@test
A_COMPILE_TIME_REFUSAL_MATCHES_AN_ERROR_BLOCK()
    val text = "```funl\nbreak\n```\n\n```error\n`break` is written inside a loop\n```\n"

    assert_eq(complaints_about(text), "")

@test
A_PROLOG_BLOCK_IS_LOADED_AND_RUN()
    val text = "```prolog\n:- write(hello), nl.\n```\n\n```output\nhello\n```\n\n" +
        "```prolog\n:- write(hello), nl.\n```\n\n```output\ngoodbye\n```\n"

    assert(complaints_about(text).starts_with("page.md:9, prolog block: what it printed is not what the page says."))

// A literate document quoted on a page: four backticks outside, its own three-backtick fence inside.
private val ShownDocument: string = "````lfunl\n# Doc\n\n    x = 'shown'\n\n```\nwrite( 'fenced' )\n```\n\n" +
    "    write( x )\n````\n\n"

@test
A_LITERATE_BLOCK_RUNS_AS_A_DOCUMENT_AND_ITS_INNER_FENCE_IS_ITS_OWN()
    // The inner fence neither ends the block nor runs: the document prints only what is indented.
    val text = ShownDocument + "```output\nshown\n```\n"
    val blocks = blocks_of_text("page.md", text)

    assert_eq(census_line("page.md", blocks), "page.md 1 0 0 0")
    assert_eq(blocks.at(0).file, "document.lfunl")
    assert_eq(complaints_about(text), "")

@test
A_LITERATE_BLOCK_IS_REFUSED_AT_ITS_PLACE_IN_THE_DOCUMENT()
    // The block's name and lines are the document's, not the page's and not the tangled program's.
    val text = "Prose first.\n\n````lfunl mistake.lfunl\n# A mistake\n\n    x = 1\n    write( y )\n````\n\n" +
        "```error\n`y` is not defined\n --> mistake.lfunl:4:12\n```\n"

    assert_eq(complaints_about(text), "")

    val misplaced = replace_all(text, ":4:12", ":4:8")

    assert(complaints_about(misplaced).starts_with("page.md:3, lfunl block: it was refused, but not in the words"))

@test
A_LITERATE_BLOCK_THAT_PRINTS_OTHER_THAN_ITS_OUTPUT_BLOCK_IS_A_COMPLAINT()
    val text = ShownDocument + "```output\nfenced\n```\n"

    assert_eq(complaints_about(text), "page.md:1, lfunl block: what it printed is not what the page says.\n" +
        "page:\n    fenced\n    \nprogram:\n    shown\n    \n")

@test
A_LITERATE_BLOCK_REFUSED_BY_THE_TANGLE_MATCHES_AN_ERROR_BLOCK()
    val text = "````lfunl\n\twrite( 1 )\n````\n\n```error\na tab in the indentation of a literate file\n```\n"

    assert_eq(complaints_about(text), "")

@test
A_LINE_STARTING_WITH_A_WIDE_CHARACTER_IS_READ_AS_PROSE()
    val text = "— a dash first\n\n```funl\nwrite( 'é' )\n```\n\n“quoted”\n\n```output\né\n```\n"

    assert_eq(census_line("page.md", blocks_of_text("page.md", text)), "page.md 1 0 0 0")
    assert_eq(complaints_about(text), "")

@test
A_CLAIM_BELONGS_TO_THE_PROGRAM_BEFORE_IT_AND_NEVER_TO_AN_EARLIER_ONE()
    // The first program has no claim before the second begins, so it is a fragment; the `output`
    // after the second is the second's. An indented fence is the prose's, not a block.
    val text = "```funl\nwrite( 'never run' )\n```\n\n```funl\nwrite( 2 )\n```\n\n" +
        "  ```funl\n  write( 3 )\n  ```\n\n```output\n2\n```\n"
    val blocks = blocks_of_text("page.md", text)

    assert_eq(census_line("page.md", blocks), "page.md 1 0 1 0")
    assert_eq(blocks.at(1).line, 5)

// A program that compiles with a singleton warning, then prints `ran`.
private val Warning: string = "```funl\ndef p(#a)\ndef q(x) :- p(y) & p(x)\nwrite( 'ran' )\n```\n\n"

@test
A_WARNING_BLOCK_MATCHES_THE_WARNING_COMPILING_THE_PROGRAM_DRAWS()
    val text = Warning + "```warning\n`y` appears only once in this clause of `q`\n```\n"

    assert_eq(census_line("page.md", blocks_of_text("page.md", text)), "page.md 0 0 0 1")
    assert_eq(complaints_about(text), "")

@test
A_WARNING_IN_OTHER_WORDS_THAN_THE_PAGE_QUOTES_IS_A_COMPLAINT()
    val text = Warning + "```warning\n`x` appears only once\n```\n"

    assert(complaints_about(text).starts_with("page.md:1, funl block: it warned, but not in the words the page quotes."))

@test
A_WARNING_BLOCK_UNDER_A_PROGRAM_THAT_DRAWS_NONE_IS_A_COMPLAINT()
    val text = "```funl\nwrite( 1 )\n```\n\n```warning\nappears only once\n```\n\n```output\n1\n```\n"

    assert_eq(complaints_about(text), "page.md:1, funl block: the page says compiling this warns, and it did not\n")

@test
A_WARNING_AND_AN_OUTPUT_BLOCK_ARE_BOTH_CHECKED()
    val right = Warning + "```warning\n`y` appears only once\n```\n\n```output\nran\n```\n"

    assert_eq(census_line("page.md", blocks_of_text("page.md", right)), "page.md 1 0 0 1")
    assert_eq(complaints_about(right), "")

    val misprinted = replace_all(right, "```output\nran", "```output\nwalked")

    assert(complaints_about(misprinted).starts_with("page.md:1, funl block: what it printed is not what the page says."))

    val miswarned = replace_all(right, "`y` appears only once\n```", "`z` appears only once\n```")

    assert(complaints_about(miswarned).starts_with("page.md:1, funl block: it warned, but not in the words the page quotes."))

@test
A_PROGRAM_SHOWN_WITH_ITS_OUTPUT_THAT_WARNS_IS_A_COMPLAINT()
    // A page may not hide a warning its reader would see.
    val text = Warning + "```output\nran\n```\n"

    assert(complaints_about(text).starts_with("page.md:1, funl block: compiling it warned, and the page shows no `warning` block:"))

@test
A_WARNING_BLOCK_WITH_AN_ERROR_BLOCK_IS_A_COMPLAINT()
    val text = "```funl\nbreak\n```\n\n```warning\nanything\n```\n\n```error\n`break` is written inside a loop\n```\n"

    assert(complaints_about(text).starts_with("page.md:1, funl block: a `warning` block cannot go with an `error` block"))

@test
A_PROGRAM_SHOWN_WARNING_THAT_IS_REFUSED_IS_A_COMPLAINT()
    val text = "```funl\nbreak\n```\n\n```warning\nappears only once\n```\n"

    assert(complaints_about(text).starts_with("page.md:1, funl block: the page says this compiles with a warning, and it was refused:"))

@test
A_WARNING_BLOCK_BELONGS_TO_THE_PROGRAM_BEFORE_IT()
    // The warning after the second program is the second's, so the first, which warns, is a fragment.
    val text = Warning + "```funl\ndef p(#a)\ndef q(x) :- p(y) & p(x)\n```\n\n" +
        "```warning\n`y` appears only once\n```\n"
    val blocks = blocks_of_text("page.md", text)

    assert_eq(census_line("page.md", blocks), "page.md 0 0 1 1")
    assert_eq(complaints_about(text), "")

@test
A_PROGRAM_BLOCK_WHOSE_FENCE_NAMES_A_FILE_IS_COMPILED_AS_THAT_FILE_BESIDE_THE_PAGE()
    val d = scratch()
    defer scrap(d)

    // The block's relative import is read from the named file's directory, not the page's.
    put_at_dir(s"$d/proj", "lib.funl", "export def answer() = 42\n")

    val page = put(d, "page.md", "```funl proj/main.funl\nimport { answer } from \"lib.funl\"\nwrite( answer() )\n```\n\n```output\n42\n```\n" +
        "```prolog proj/p.pl\n:- write(hi), nl.\n```\n\n```output\nhi\n```\n")

    assert_eq(check_page(page), "")

    val blocks = blocks_of(page)

    assert_eq(blocks.at(0).file, s"$d/proj/main.funl")
    assert_eq(blocks.at(1).file, s"$d/proj/p.pl")

    // Without the name the import would be read beside the page, where there is no `lib.funl`.
    val plain = put(d, "plain.md", "```funl\nimport { answer } from \"lib.funl\"\nwrite( answer() )\n```\n\n```output\n42\n```\n")

    assert(check_page(plain).index_of("cannot be read").is_some())

// Write `text` to `name` in directory `dir`, making it first.
private put_at_dir(dir: string, name: string, text: string) -> string
    make_dir_all(dir).unwrap()
    put(dir, name, text)
