module io.github.edadma.funl

import sysl.text.{StrBuilder, str_builder}

// How a term is printed.
//
// **A term may be cyclic**, unification having no occurs check, so the walk stops at `MaxDepth`
// and writes `...` rather than recursing for ever.
//
// **A string prints as its text, and inside a collection or a term in double quotes**, so
// `["a", "b"]` is told apart from `[a, b]`, whose elements are atoms. An immutable map prints as it is
// written, `{"a": 1}`, a mutable one as `MutableMap("a": 1)`, and an array and a buffer as
// `Array(1, 2)` and `Buffer(1, 2)`.
private const MaxDepth: usize = 1000

render(v: Value) -> string
    var out = str_builder()

    write_value(&out, v, 0)
    out.finish()

private write_value(out: *StrBuilder, v: Value, depth: usize)
    if depth > MaxDepth
        out.push("...")
        return

    deref(v) match
        Undefined -> out.push("undefined")
        Nil -> out.push("[]")
        Int(n) -> out.push_int(n)
        Atom(id) -> out.push(atom_name(id))
        Compound(p) ->
            out.push(atom_name(p.functor))
            write_items(out, p.args.view(), depth, "(", ")")
        Cons(p) -> write_list(out, p, depth)
        Var(p) ->
            out.push("_G")
            out.push_uint(p.id)
        Unit -> out.push("()")
        Str(p) ->
            if depth == 0
                out.push(p.s)
            else
                out.push("\"")
                out.push(p.s)
                out.push("\"")
        Tuple(p) -> write_items(out, p.items.view(), depth, "(", ")")
        Bool(b) -> out.push(if b then "true" else "false")
        Func(p) ->
            out.push("<function ")
            out.push(current().chunks.at(p.chunk).name)
            out.push(">")
        Range(r) -> write_range(out, r)
        Set(s) -> write_items(out, s.items.view(), depth, "{", "}")
        MutSet(s) -> write_items(out, s.items.view(), depth, "MutableSet(", ")")
        Map(m) -> write_entries(out, m, depth, "{", "}")
        MutMap(m) -> write_entries(out, m, depth, "MutableMap(", ")")
        Array(a) -> write_items(out, a.items.view(), depth, "Array(", ")")
        Buffer(a) -> write_items(out, a.items.view(), depth, "Buffer(", ")")
        Ctor(id) -> write_ctor(out, current().ctors.at(usize(id)))
        CSet(p) ->
            // As `cset` would make it, its characters in ascending order.
            out.push("cset(\"")
            out.push(p.set.text())
            out.push("\")")
end write_value

// A map's entries, `key: value`, keys and values written as elements are.
private write_entries(out: *StrBuilder, m: *MapObj, depth: usize, open: string, close: string)
    out.push(open)

    for i in 0..<m.keys.len()
        if i > 0 then out.push(", ")

        write_value(out, m.keys.at(i), depth + 1)
        out.push(": ")
        write_value(out, m.vals.at(i), depth + 1)

    out.push(close)

// A constructor as its declaration names it: `<constructor point(x, y)>`.
private write_ctor(out: *StrBuilder, d: CtorDef)
    out.push("<constructor ")
    out.push(atom_name(d.functor))
    out.push("(")

    for i in 0..<d.fields.len()
        if i > 0 then out.push(", ")

        out.push(atom_name(d.fields.at(i)))

    out.push(")>")

// A range as it is written: `1..5`, `1..<5`, `1..`, with `by k` when the step is not one.
private write_range(out: *StrBuilder, r: *RangeObj)
    out.push_int(r.from)
    out.push(if r.endless || r.inclusive then ".." else "..<")

    if !r.endless then out.push_int(r.last)

    if r.step != 1
        out.push(" by ")
        out.push_int(r.step)

private write_items(out: *StrBuilder, items: []Value, depth: usize, open: string, close: string)
    out.push(open)

    for i in 0..<items.len
        if i > 0 then out.push(", ")

        write_value(out, items[i], depth + 1)

    out.push(close)

// `[a, b, c]` for a proper list and `[a, b | t]` for one whose tail is not `[]`.
private write_list(out: *StrBuilder, first: *ConsObj, depth: usize)
    out.push("[")
    write_value(out, first.head, depth + 1)

    var tail = deref(first.tail)
    var steps: usize = 0

    loop
        tail match
            Cons(p) ->
                steps += 1

                if steps > MaxDepth
                    out.push(", ...")
                    break

                out.push(", ")
                write_value(out, p.head, depth + 1)
                tail = deref(p.tail)
            Nil -> break
            _ ->
                out.push(" | ")
                write_value(out, tail, depth + 1)
                break

    out.push("]")
end write_list
