module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// Map patterns: `MatchMap`, which takes a map apart one way for a FunL pattern, and `GetMap`, which
// unifies a relation head's map pattern with an argument, building the map when the argument is
// unbound.
//
// **A map pattern is partial**: it names some keys, the map may hold others, and a key it names that
// the map lacks is a mismatch. `{}` alone is exact, matching only the empty map. A mutable map is
// read through its entries, so its default is not one. The pattern's keys are evaluated before the
// instruction and sit on the stack above the value it reads.

// `MatchMap`: pop the keys and the value under them; push the parts or answer false.
match_map(v: *Vm, n: usize, rest: bool, exact: bool) -> Result[bool, Fault]
    val keys = popped_keys(v, n)?

    val x = v.stack.pop() match
        Some(x) -> deref(x)
        None -> return Err(Broken("a map pattern found the operand stack empty"))

    x match
        Map(m) -> take_apart(v, m, keys, rest, exact)
        MutMap(m) -> take_apart(v, m, keys, rest, exact)
        Var(_) -> Err(instantiation_error("instantiation error: a map pattern was given an unbound variable"))
        _ -> Ok(false)

// `GetMap`: pop the keys, then read the argument. **An unbound argument is bound to the map the
// pattern names**, each key under a fresh variable, and its rest is the empty map; a map is taken
// apart as `MatchMap` takes it; anything else fails.
get_map(v: *Vm, n: usize, rest: bool, exact: bool, src: Src) -> Result[bool, Fault]
    val keys = popped_keys(v, n)?
    val x = deref(head_source(v, src)?)

    x match
        Var(p) ->
            val m = new_map()?

            for k in keys.view()
                if map_find(m, k)?.is_some() then return Ok(false)

                m.keys.push(k)
                m.vals.push(Var(new_var()?))

            current().allocated += 2 * keys.len() * sizeof(Value)

            if !bind(p, Map(m)) then return Ok(false)

            if rest then v.stack.push(Map(new_map()?))

            push_values(v, m, all_of(keys.len()))
            Ok(true)
        Map(m) -> take_apart(v, m, keys, rest, exact)
        MutMap(m) -> take_apart(v, m, keys, rest, exact)
        _ -> Ok(false)
end get_map

// The top `n` values, the pattern's keys in order, each dereferenced; a key that is an unbound
// variable cannot be looked up.
private popped_keys(v: *Vm, n: usize) -> Result[Buf[Value], Fault]
    val top = v.stack.len()

    if n > top then return Err(Broken(s"a map pattern of $n keys found ${top} values on the stack"))

    var keys: Buf[Value] = buf()

    for i in (top - n)..<top
        val k = deref(v.stack.at(i))

        k match
            Var(_) -> return Err(instantiation_error("instantiation error: a map pattern's key is an unbound variable"))
            _ -> ()

        keys.push(k)

    v.stack.truncate(top - n)
    Ok(keys)

// Map `m` against `keys`: every key found, at a different entry, and for `exact` no entry at all.
// The values are pushed, the first key's on top, and under them, for `rest`, a new immutable map of
// the entries no key named.
private take_apart(v: *Vm, m: *MapObj, keys: Buf[Value], rest: bool, exact: bool) -> Result[bool, Fault]
    if exact && m.keys.len() != 0 then return Ok(false)

    var at: Buf[usize] = buf()

    for k in keys.view()
        val i = map_find(m, k)? match
            Some(i) -> i
            None -> return Ok(false)

        // Two keys that are equal name one entry, and no map holds a key twice.
        for j in at.view()
            if j == i then return Ok(false)

        at.push(i)

    if rest
        val r = new_map()?

        for i in 0..<m.keys.len()
            if !named(at, i)
                r.keys.push(m.keys.at(i))
                r.vals.push(m.vals.at(i))

        current().allocated += 2 * r.keys.len() * sizeof(Value)
        v.stack.push(Map(r))

    push_values(v, m, at)
    Ok(true)
end take_apart

// The values of `m` at entries `at`, the first on top.
private push_values(v: *Vm, m: *MapObj, at: Buf[usize])
    var i = at.len()

    while i > 0
        i -= 1
        v.stack.push(m.vals.at(at.at(i)))

private named(at: Buf[usize], i: usize) -> bool
    for j in at.view()
        if j == i then return true

    false

private all_of(n: usize) -> Buf[usize]
    var out: Buf[usize] = buf()

    for i in 0..<n
        out.push(i)

    out
