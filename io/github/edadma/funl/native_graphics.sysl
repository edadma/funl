module io.github.edadma.funl

import sysl.buf.{Buf, buf}
import sh.sysl.plutovg as pv
import sysl.text.chars_of

// `funl:graphics`: Icon's windows, over the `sysl-lang/plutovg` package (`docs/library/graphics.md`).
//
// **A window is a handle of kind `window`, and it is two things, as Icon's is: a canvas and a
// context.** The canvas is the drawing surface -- a plutovg surface of premultiplied ARGB32 and the
// plutovg canvas that draws on it -- with its size and title. The context is how drawing is done:
// the colours, the line and fill styles, the drawing operation, the clip rectangle and the origin.
// `w.clone(attrs)` is a new handle on the same canvas with a copy of the context; `couple(w1, w2)` a
// new handle on `w1`'s canvas sharing `w2`'s context, so a change through either is seen by both.
//
// **`close()` closes the canvas, and with it every handle on it** (Icon's `WClose`); `w.uncouple()`
// closes this handle alone, and the canvas goes with its last handle. A handle the collector finds
// unreachable is uncoupled, not closed, since another handle may still be drawing.
//
// **Canvases and contexts live in tables here, and a handle holds its places in them**: `n` is the
// canvas's place, `vals` the canvas's generation and the context's place. A canvas's place is reused
// once it is closed, and its generation counts the reuses, so a handle whose canvas was closed under
// it -- a clone, after `close()` on the window -- finds a different generation there, is closed on
// the spot, and faults as any closed handle does. A context is shared by every handle `couple` made
// with it and goes with the last of them.
//
// **Nothing the collector can run is interleaved with a change to these tables**: an allocation can
// run a finalizer, and a finalizer uncouples, so every maker allocates its handle first and then
// reads and writes the tables with nothing allocating in between.
//
// **Only a hidden canvas is in this build**, `canvas: #hidden`: a surface in memory, with no window
// on screen and no display; its events come only from `enqueue`. A visible window faults, naming the
// feature it needs.
//
// **Events wait on their canvas's queue**, and `event()` takes the oldest, answering its code and
// setting the running machine's event keywords (`EventKeys`). `&window` is the VM's: `open` sets it,
// a program may assign it, and the collector marks it.

// What `funl:graphics` exports, each name the short form of a native `install_graphics` registered as
// `graphics.name`.
private val GraphicsNames: [4]string = ["open", "couple", "color_value", "active"]

private const WindowKind: string = "window"
private const PixelsKind: string = "window pixels"

// A canvas opened with no `size` is Icon's default: 80 columns by 12 lines of the default font.
private const DefaultWidth: long = 480
private const DefaultHeight: long = 156

// The largest side a canvas may have, as an X server refuses a window wider than 32767 pixels.
private const MaxSide: long = 32767

// What a window on screen answers in a build that has none.
private const NoScreen: string = "a window on screen is not in this build -- it is behind the `graphics` feature"

// A canvas: its pixels and the plutovg canvas drawing on them, how many handles are open on it, and
// its attributes; its event queue, oldest first; the handles open on it, oldest first, which the
// collector does not see -- a handle leaves the list when it is uncoupled or forgotten, so every one
// there is live -- and the VM they belong to.
private struct WinCanvas
    surface: &pv.Surface
    drawn: &pv.Canvas
    handles: usize
    label: string
    width: long
    height: long
    resize: bool
    cursor: bool
    echo: bool
    inputmask: string
    queue: Buf[WinEvent]
    wins: Buf[*HandleObj]
    owner: *Vm

// An event waiting on a canvas's queue: its code -- `key`, a one-character string, when `is_key`, the
// symbol `sym` otherwise -- where it happened, in the canvas's own coordinates (no origin taken off),
// the modifiers held and whether a key was let go (`Mod...` bits), and the milliseconds since the
// event before it.
private struct WinEvent
    is_key: bool
    key: string
    sym: u32
    x: long
    y: long
    mods: u8
    interval: long

private const ModControl: u8 = 1
private const ModMeta: u8 = 2
private const ModShift: u8 = 4
private const ModReleased: u8 = 8

// The event keywords as `event()` leaves them: `&x`, `&y`, `&row`, `&col`, `&interval`, and the
// `Mod...` bits `&control`, `&meta`, `&shift` and `&released` succeed on. **They are the running
// machine's** -- `Vm.keys`, parked and unparked with the rest of it -- so one task's `event()` never
// changes what another reads.
struct EventKeys
    x: long
    y: long
    row: long
    col: long
    interval: long
    mods: u8

// The event keywords before any event: everything 0, and no modifier held.
no_event_keys() -> EventKeys = EventKeys(0, 0, 0, 0, 0, 0)

// The default font's character cell, which `&row` and `&col` count in: the default canvas is 80
// columns by 12 lines of it, `DefaultWidth` by `DefaultHeight`.
private const CellWidth: long = 6
private const CellHeight: long = 13

// The mouse's event codes, each also a keyword answering it, `&lpress` -- and `#resize`, `&resize`.
private val MouseCodes: [10]string = ["lpress", "ldrag", "lrelease", "mpress", "mdrag", "mrelease", "rpress", "rdrag",
    "rrelease", "resize"]

// What `event()` and `active()` answer when nothing can come: in this build a canvas is filled only by
// `enqueue`, which a program waiting on it cannot call.
private const NothingComes: string = "no event is queued, and none can come while the program waits: a hidden canvas takes events only from `enqueue`"

// A context: how many handles share it, and its attributes. A colour is kept as the specification
// it was given, which `get` answers, and as the components it names. `clipw` is negative when there
// is no clip rectangle, as Icon keeps it.
private struct WinContext
    refs: usize
    fg: string
    fg_rgb: Rgb
    bg: string
    bg_rgb: Rgb
    reverse: bool
    linewidth: long
    linestyle: u32
    fillstyle: u32
    drawop: u32
    clipx: long
    clipy: long
    clipw: long
    cliph: long
    dx: long
    dy: long

// An open window handle and its places.
private struct Win
    h: *HandleObj
    at: usize
    ctx: usize

// process-wide: every open canvas by place, `None` once closed. A handle is collected storage, which
// cannot hold the counted references a surface and a plutovg canvas are, so they wait here; places are
// never shared, so every VM in the process can keep its canvases in the one table.
private var canvases: Buf[Option[WinCanvas]] = buf()

// process-wide: the generation of each place in `canvases`, for the reason that table is.
private var generations: Buf[long] = buf()

// process-wide: every context in use, by place, beside the canvases.
private var contexts: Buf[Option[WinContext]] = buf()

// Every attribute, in the order `attributes()` gives them.
private val Attributes: [24]string = ["size", "width", "height", "label", "canvas", "resize", "cursor", "echo",
    "inputmask", "fg", "bg", "reverse",
    "linewidth", "linestyle", "fillstyle", "drawop", "clipx", "clipy", "clipw", "cliph", "dx", "dy", "depth", "density"]

install_graphics(v: *Vm)
    val w = register_handle_kind_forgetting(v, WindowKind, close_canvas, detach_window)

    register_handle_kind(v, PixelsKind, (h) -> ())
    optional_past(v, register_generator(v, "graphics.open", 2, do_open), 1)
    register(v, "graphics.couple", 2, do_couple)
    register_generator(v, "graphics.color_value", 1, do_color_value)
    register_method(v, w, "set", 1, do_set)
    register_method(v, w, "get", 1, do_get)
    register_method(v, w, "attributes", 0, do_attributes)
    register_method(v, w, "clone", Variadic, do_clone)
    register_method(v, w, "uncouple", 0, do_uncouple)
    register_stepping_method(v, w, "pixel", Variadic, start_pixel, step_pixel)
    register_method(v, w, "enqueue", Variadic, do_enqueue)
    register_method(v, w, "event", 0, do_event)
    register_method(v, w, "pending", 0, do_pending)
    register_generator(v, "graphics.active", 0, do_active)
    register_generator(v, "&window", 0, (b, n, c) -> window_now())
    register(v, "&window=", 1, (b, n) -> store_window(b))
    register(v, "&x", 0, (b, n) -> Ok(Int(current().keys.x)))
    register(v, "&y", 0, (b, n) -> Ok(Int(current().keys.y)))
    register(v, "&row", 0, (b, n) -> Ok(Int(current().keys.row)))
    register(v, "&col", 0, (b, n) -> Ok(Int(current().keys.col)))
    register(v, "&interval", 0, (b, n) -> Ok(Int(current().keys.interval)))
    register_generator(v, "&control", 0, (b, n, c) -> held(ModControl))
    register_generator(v, "&meta", 0, (b, n, c) -> held(ModMeta))
    register_generator(v, "&shift", 0, (b, n, c) -> held(ModShift))
    register_generator(v, "&released", 0, (b, n, c) -> held(ModReleased))

    for code in MouseCodes
        register_constant(v, s"&$code", (b, n) -> Ok(atom(code)))

// The exports of `funl:graphics`.
graphics_exports() -> Buf[ModExport] = native_exports("graphics", GraphicsNames)

// The id of handle kind `name` on the running VM.
private kind_named(name: string) -> u32
    val kinds = current().handle_kinds

    for i in 0..<kinds.len()
        if kinds.at(i).name == name then return u32(i)

    panic("funl:graphics is not installed on this VM")

// -- the tables --------------------------------------------------------------------------------------

private keep_canvas(c: WinCanvas) -> usize
    for i in 0..<canvases.len()
        if canvases.at(i).is_none()
            canvases.set(i, Some(c))
            return i

    canvases.push(Some(c))
    generations.push(0)
    canvases.len() - 1

private keep_context(c: WinContext) -> usize
    for i in 0..<contexts.len()
        if contexts.at(i).is_none()
            contexts.set(i, Some(c))
            return i

    contexts.push(Some(c))
    contexts.len() - 1

private small(x: Value) -> long = x match
    Int(n) -> n
    _ -> -1

// Whether the canvas handle `h` was made on is still open.
private canvas_live(h: *HandleObj) -> bool
    if h.vals.len() < 2 then return false

    val at = usize(h.n)

    at < canvases.len() && canvases.at(at).is_some() && generations.at(at) == small(h.vals.at(0))

private canvas_at(at: usize) -> WinCanvas = canvases.at(at).unwrap()

private context_at(at: usize) -> WinContext = contexts.at(at).unwrap()

// The canvas closed: its place freed and its generation moved on, so every other handle on it finds
// it gone.
private free_canvas(at: usize)
    var c = canvas_at(at)

    c.queue.release()
    c.wins.release()
    canvases.set(at, None)
    generations.set(at, generations.at(at) + 1)

// One handle's share of its context given back.
private drop_context(h: *HandleObj)
    if h.vals.len() < 2 then return

    val k = usize(small(h.vals.at(1)))

    if k >= contexts.len() then return

    contexts.at(k) match
        Some(c) ->
            if c.refs <= 1
                contexts.set(k, None)
            else
                var d = c
                d.refs -= 1
                contexts.set(k, Some(d))
        None -> ()

// `close()`: the canvas, and so every handle on it, then this handle's context.
private close_canvas(h: *HandleObj)
    if canvas_live(h) then free_canvas(usize(h.n))

    drop_context(h)

// `uncouple()`, a forgotten handle, and a handle found on a closed canvas: this handle's share of the
// canvas and of its context, the canvas closing with its last handle.
private detach_window(h: *HandleObj)
    if canvas_live(h)
        val at = usize(h.n)
        var c = canvas_at(at)

        if c.handles <= 1
            free_canvas(at)
        else
            c.handles -= 1

            for i in 0..<c.wins.len()
                if c.wins.at(i) == h
                    c.wins.remove(i)
                    break

            canvases.set(at, Some(c))

    drop_context(h)

// -- arguments -------------------------------------------------------------------------------------

// Argument `i`, an open window whose canvas is open. A handle whose canvas was closed through another
// handle is closed now, and faults as a closed handle does.
private window_arg(base: usize, i: usize, name: string) -> Result[Win, Fault]
    val h = open_handle(base, i, kind_named(WindowKind), s"'$name'")?

    if !canvas_live(h)
        retire_handle(h, detach_window)
        return Err(existence_error("handle", Handle(h), s"'$name' was called on ${described(Handle(h))}"))

    Ok(Win(h, usize(h.n), usize(small(h.vals.at(1)))))

// Argument `i`, a map of attributes.
private map_arg(base: usize, i: usize, name: string) -> Result[*MapObj, Fault]
    val x = deref(arg(base, i))

    x match
        Map(p) -> Ok(p)
        MutMap(p) -> Ok(p)
        _ -> Err(kind_error(x, "map", s"'$name' wants a map of attributes and was given ${described(x)}"))

// The name an attribute key spells: a string, or a symbol.
private key_text(x: Value) -> Option[string] = deref(x) match
    Str(p) -> Some(p.s)
    Atom(id) -> Some(atom_name(id))
    _ -> None

private is_attribute(k: string) -> bool
    for a in Attributes
        if a == k then return true

    false

private is_read_only(k: string) -> bool = k == "depth" || k == "density"

// -- surfaces --------------------------------------------------------------------------------------

// A colour component, 0 to 65535, as plutovg takes it.
private channel(c: long) -> f32 = f32(c) / 65535.0

// A surface `w` by `h` filled with `bg`, and the plutovg canvas that draws on it; `None` for a size
// no canvas may have, or pixels that could not be had.
private blank(w: long, h: long, bg: Rgb) -> Option[(&pv.Surface, &pv.Canvas)]
    if w < 1 || h < 1 || w > MaxSide || h > MaxSide then return None

    val s = pv.surface(int(w), int(h)) match
        Some(s) -> s
        None -> return None

    val drawn = pv.canvas(s) match
        Some(d) -> d
        None -> return None

    s.clear(channel(bg.r), channel(bg.g), channel(bg.b))
    Some((s, drawn))

// `c` made `w` by `h`, keeping the pixels the two sizes share and filling the rest with `bg`, as a
// window resized keeps its picture.
private resized(c: WinCanvas, w: long, h: long, bg: Rgb) -> Option[WinCanvas]
    val (s, drawn) = blank(w, h, bg)?
    val from = c.surface.data()
    val to = s.data()
    val from_stride = usize(c.surface.stride())
    val to_stride = usize(s.stride())
    val rows = usize(if h < c.height then h else c.height)
    val bytes = 4 * usize(if w < c.width then w else c.width)

    for y in 0..<rows
        for b in 0..<bytes
            to[y * to_stride + b] = from[y * from_stride + b]

    var out = c

    out.surface = s
    out.drawn = drawn
    out.width = w
    out.height = h
    Some(out)

// -- colours ---------------------------------------------------------------------------------------

// A component as the surface stores it, eight bits, rounded as plutovg rounds.
private device(c: long) -> long = long(channel(c) * 255.0 + 0.5)

// `color_value(s)`: colour specification `s` in the normal form `"r,g,b"`; fails when `s` is no
// colour.
private do_color_value(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val x = deref(arg(base, 0))

    val spec = x match
        Str(p) -> p.s
        _ -> return Err(kind_error(x, "string", s"'color_value' wants a colour, a string, and was given ${described(x)}"))

    parse_color(spec) match
        Some(c) -> Ok(Gives(new_str(color_text(c))?))
        None -> Ok(Refuses)

// -- attributes ------------------------------------------------------------------------------------

// The canvas and context an attribute map is applied to, before anything is kept.
private struct Pending
    cv: WinCanvas
    ctx: WinContext

// Every key of `m` an attribute that may be set: a fault for the first that is not.
private settable(m: *MapObj, name: string) -> Result[unit, Fault]
    for i in 0..<m.keys.len()
        val key = m.keys.at(i)

        val k = key_text(key) match
            Some(k) -> k
            None -> return Err(domain_error("window_attribute", key, s"'$name': ${described(key)} is no window attribute"))

        if is_read_only(k)
            return Err(permission_error("modify", "window_attribute", atom(k), s"'$name': `$k` is read-only"))

        if !is_attribute(k)
            return Err(domain_error("window_attribute", atom(k), s"'$name': `$k` is no window attribute"))

    Ok(())

// The attributes of `m` applied, in order, to the canvas at `at` and to context `ctx`: the context
// as it is afterwards, the canvas's changes kept, or `None` -- and nothing kept -- when a value is one
// Icon's `WAttrib` would refuse.
private applied(at: usize, ctx: WinContext, m: *MapObj, name: string) -> Result[Option[WinContext], Fault]
    settable(m, name)?

    var p = Pending(canvas_at(at), ctx)

    for i in 0..<m.keys.len()
        p = assigned(p, key_text(m.keys.at(i)).unwrap(), deref(m.vals.at(i)), name)? match
            Some(q) -> q
            None -> return Ok(None)

    val now = canvas_at(at)
    var kept = p.cv

    if kept.width != now.width || kept.height != now.height
        kept = resized(now, kept.width, kept.height, p.ctx.bg_rgb) match
            Some(r) ->
                var out = p.cv

                out.surface = r.surface
                out.drawn = r.drawn
                out
            None -> return Ok(None)

    canvases.set(at, Some(kept))
    Ok(Some(p.ctx))

private whole(x: Value) -> Option[long] = x match
    Int(n) -> Some(n)
    _ -> None

private side(x: Value) -> Option[long] = x match
    Int(n) -> if n >= 1 && n <= MaxSide then Some(n) else None
    _ -> None

private truth(x: Value) -> Option[bool] = x match
    Atom(id) -> if id == TrueAtom then Some(true) else if id == FalseAtom then Some(false) else None
    _ -> None

// The symbol `x` is, when it is one of `names`.
private one_of(x: Value, names: []const string) -> Option[u32] = x match
    Atom(id) ->
        for n in names
            if atom_name(id) == n then return Some(id)

        None
    _ -> None

private colour(x: Value) -> Option[(string, Rgb)] = x match
    Str(p) ->
        parse_color(p.s) match
            Some(c) -> Some((p.s, c))
            None -> None
    _ -> None

private is_undefined(x: Value) -> bool = x match
    Undefined -> true
    _ -> false

// `p` with attribute `k` given value `x`, or `None` when `x` is no value `k` can take.
private assigned(p: Pending, k: string, x: Value, name: string) -> Result[Option[Pending], Fault]
    var q = p

    if k == "size"
        val items = x match
            Tuple(t) -> t.items
            _ -> return Ok(None)

        if items.len() != 2 then return Ok(None)

        q.cv.width = side(deref(items.at(0))) match
            Some(n) -> n
            None -> return Ok(None)
        q.cv.height = side(deref(items.at(1))) match
            Some(n) -> n
            None -> return Ok(None)
    else if k == "width"
        q.cv.width = side(x) match
            Some(n) -> n
            None -> return Ok(None)
    else if k == "height"
        q.cv.height = side(x) match
            Some(n) -> n
            None -> return Ok(None)
    else if k == "label"
        q.cv.label = x match
            Str(s) -> s.s
            _ -> return Ok(None)
    else if k == "canvas"
        val mode = one_of(x, ["normal", "hidden", "maximal", "iconic"]) match
            Some(id) -> atom_name(id)
            None -> return Ok(None)

        if mode != "hidden" then return Err(system_error(s"'$name': $NoScreen"))
    else if k == "resize"
        q.cv.resize = truth(x) match
            Some(b) -> b
            None -> return Ok(None)
    else if k == "cursor"
        q.cv.cursor = truth(x) match
            Some(b) -> b
            None -> return Ok(None)
    else if k == "echo"
        q.cv.echo = truth(x) match
            Some(b) -> b
            None -> return Ok(None)
    else if k == "inputmask"
        q.cv.inputmask = x match
            Str(s) -> if is_mask(s.s) then s.s else return Ok(None)
            _ -> return Ok(None)
    else if k == "fg"
        val (spec, c) = colour(x) match
            Some(found) -> found
            None -> return Ok(None)

        q.ctx.fg = spec
        q.ctx.fg_rgb = c
    else if k == "bg"
        val (spec, c) = colour(x) match
            Some(found) -> found
            None -> return Ok(None)

        q.ctx.bg = spec
        q.ctx.bg_rgb = c
    else if k == "reverse"
        val on = truth(x) match
            Some(b) -> b
            None -> return Ok(None)

        if on != q.ctx.reverse
            q.ctx.fg = p.ctx.bg
            q.ctx.fg_rgb = p.ctx.bg_rgb
            q.ctx.bg = p.ctx.fg
            q.ctx.bg_rgb = p.ctx.fg_rgb
            q.ctx.reverse = on
    else if k == "linewidth"
        q.ctx.linewidth = whole(x) match
            Some(n) -> if n >= 0 then n else return Ok(None)
            None -> return Ok(None)
    else if k == "linestyle"
        q.ctx.linestyle = one_of(x, ["solid", "dashed", "striped"]) match
            Some(id) -> id
            None -> return Ok(None)
    else if k == "fillstyle"
        q.ctx.fillstyle = one_of(x, ["solid", "textured", "masked"]) match
            Some(id) -> id
            None -> return Ok(None)
    else if k == "drawop"
        q.ctx.drawop = one_of(x, ["copy", "reverse"]) match
            Some(id) -> id
            None -> return Ok(None)
    else if k == "clipx" || k == "clipy" || k == "clipw" || k == "cliph"
        return Ok(clipped(q, k, x))
    else if k == "dx"
        q.ctx.dx = whole(x) match
            Some(n) -> n
            None -> return Ok(None)
    else if k == "dy"
        q.ctx.dy = whole(x) match
            Some(n) -> n
            None -> return Ok(None)
    else
        return Err(Broken(s"'$name' has no way to set `$k`"))

    Ok(Some(q))
end assigned

// `p` with clip attribute `k` set to `x`, as Icon sets it: `undefined` takes the clip rectangle away,
// and a number given while there is none starts from the whole canvas.
private clipped(p: Pending, k: string, x: Value) -> Option[Pending]
    var q = p

    if is_undefined(x)
        q.ctx.clipx = 0
        q.ctx.clipy = 0
        q.ctx.clipw = -1
        q.ctx.cliph = -1
        return Some(q)

    val n = whole(x)?

    if q.ctx.clipw < 0
        q.ctx.clipx = 0
        q.ctx.clipy = 0
        q.ctx.clipw = q.cv.width
        q.ctx.cliph = q.cv.height

    if k == "clipx"
        q.ctx.clipx = n
    else if k == "clipy"
        q.ctx.clipy = n
    else if k == "clipw"
        q.ctx.clipw = n
    else
        q.ctx.cliph = n

    Some(q)

// The value of attribute `k` of canvas `c` and context `ctx`.
private attribute(c: WinCanvas, ctx: WinContext, k: string) -> Result[Value, Fault]
    if k == "size"
        val t = new_tuple(2)?

        t.items.set(0, Int(c.width))
        t.items.set(1, Int(c.height))
        return Ok(Tuple(t))

    val clip = ctx.clipw >= 0

    Ok(k match
        "width" -> Int(c.width)
        "height" -> Int(c.height)
        "label" -> new_str(c.label)?
        "canvas" -> atom("hidden")
        "resize" -> boolean(c.resize)
        "cursor" -> boolean(c.cursor)
        "echo" -> boolean(c.echo)
        "inputmask" -> new_str(c.inputmask)?
        "fg" -> new_str(ctx.fg)?
        "bg" -> new_str(ctx.bg)?
        "reverse" -> boolean(ctx.reverse)
        "linewidth" -> Int(ctx.linewidth)
        "linestyle" -> Atom(ctx.linestyle)
        "fillstyle" -> Atom(ctx.fillstyle)
        "drawop" -> Atom(ctx.drawop)
        "clipx" -> if clip then Int(ctx.clipx) else Undefined
        "clipy" -> if clip then Int(ctx.clipy) else Undefined
        "clipw" -> if clip then Int(ctx.clipw) else Undefined
        "cliph" -> if clip then Int(ctx.cliph) else Undefined
        "dx" -> Int(ctx.dx)
        "dy" -> Int(ctx.dy)
        "depth" -> Int(24)
        "density" -> Int(1)
        _ -> return Err(Broken(s"no window attribute `$k` has a value")))

// -- opening ---------------------------------------------------------------------------------------

private default_context() -> WinContext =
    WinContext(1, "black", Rgb(0, 0, 0), "white", Rgb(65535, 65535, 65535), false, 1, intern("solid"), intern("solid"),
        intern("copy"), 0, 0, -1, -1, 0, 0)

// Whether attribute map `m` asks for a hidden canvas: a fault for a visible one, which this build
// cannot open, and `None` for a `canvas` value that is no canvas state at all.
private hidden_asked(m: Option[*MapObj]) -> Result[Option[unit], Fault]
    val p = m match
        Some(p) -> p
        None -> return Err(system_error(s"'open': $NoScreen"))

    for i in 0..<p.keys.len()
        if key_text(p.keys.at(i)).unwrap_or("") == "canvas"
            return one_of(deref(p.vals.at(i)), ["normal", "hidden", "maximal", "iconic"]) match
                Some(id) -> if atom_name(id) == "hidden" then Ok(Some(())) else Err(system_error(s"'open': $NoScreen"))
                None -> Ok(None)

    Err(system_error(s"'open': $NoScreen"))

// `open(title, attrs)`: a window titled `title` with `attrs` applied. Fails where a value in `attrs`
// is one Icon would refuse.
private do_open(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val x = deref(arg(base, 0))

    val title = x match
        Str(p) -> p.s
        Atom(id) -> atom_name(id)
        _ -> return Err(kind_error(x, "string", s"'open' wants a title, a string, and was given ${described(x)}"))

    val attrs = if argc > 1 then Some(map_arg(base, 1, "open")?) else None

    if hidden_asked(attrs)?.is_none() then return Ok(Refuses)

    val h = new_handle(kind_named(WindowKind))?
    val start = default_context()

    val (s, drawn) = blank(DefaultWidth, DefaultHeight, start.bg_rgb) match
        Some(made) -> made
        None ->
            h.closed = true
            return Ok(Refuses)

    val wins: Buf[*HandleObj] = buf()

    wins.push(h)

    val at = keep_canvas(WinCanvas(s, drawn, 1, title, DefaultWidth, DefaultHeight, false, false, true, "", buf(), wins,
        current()))
    val k = keep_context(start)

    h.n = long(at)
    h.vals.push(Int(generations.at(at)))
    h.vals.push(Int(long(k)))

    val ctx = applied(at, start, attrs.unwrap(), "open") match
        Ok(Some(c)) -> c
        Ok(None) ->
            close_handle(h)
            return Ok(Refuses)
        Err(f) ->
            close_handle(h)
            return Err(f)

    // A new canvas is painted in the background colour it was opened with.
    canvas_at(at).surface.clear(channel(ctx.bg_rgb.r), channel(ctx.bg_rgb.g), channel(ctx.bg_rgb.b))
    contexts.set(k, Some(ctx))
    current().window = Handle(h)
    Ok(Gives(Handle(h)))

// `couple(w1, w2)`: a new window on `w1`'s canvas sharing `w2`'s context.
private do_couple(base: usize, argc: usize) -> Result[Value, Fault]
    window_arg(base, 0, "couple")?
    window_arg(base, 1, "couple")?

    val h = new_handle(kind_named(WindowKind))?
    val canvas = window_arg(base, 0, "couple")?
    val context = window_arg(base, 1, "couple")?
    var c = canvas_at(canvas.at)
    var ctx = context_at(context.ctx)

    c.handles += 1
    c.wins.push(h)
    ctx.refs += 1
    canvases.set(canvas.at, Some(c))
    contexts.set(context.ctx, Some(ctx))
    h.n = long(canvas.at)
    h.vals.push(Int(generations.at(canvas.at)))
    h.vals.push(Int(long(context.ctx)))
    Ok(Handle(h))

// -- the methods -----------------------------------------------------------------------------------

// `w.set(m)`: every attribute of `m` applied, in order; answers `w`, or fails with nothing applied.
private do_set(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "set")?
    val m = map_arg(base, 1, "set")?

    applied(w.at, context_at(w.ctx), m, "set")? match
        Some(c) ->
            contexts.set(w.ctx, Some(c))
            Ok(Some(Handle(w.h)))
        None -> Ok(None)

// `w.get(name)`: one attribute's value.
private do_get(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "get")?
    val x = deref(arg(base, 1))

    val k = key_text(x) match
        Some(k) -> k
        None -> return Err(kind_error(x, "string", s"'get' wants an attribute's name, a string, and was given ${described(x)}"))

    if !is_attribute(k) then return Err(domain_error("window_attribute", atom(k), s"'get': `$k` is no window attribute"))

    Ok(Some(attribute(canvas_at(w.at), context_at(w.ctx), k)?))

// `w.attributes()`: an immutable map of every attribute to its value.
private do_attributes(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "attributes")?
    val c = canvas_at(w.at)
    val ctx = context_at(w.ctx)
    val out = new_map()?

    for k in Attributes
        map_put(out, new_str(k)?, attribute(c, ctx, k)?)?

    Ok(Some(Map(out)))

// `w.clone()`, `w.clone(attrs)`: a new window on `w`'s canvas with a copy of its context, `attrs`
// applied to the copy; fails, making nothing, where `set` would.
private do_clone(base: usize, argc: usize) -> Result[Option[Value], Fault]
    if argc > 2 then return Err(wrong_count("clone", argc - 1, s"'clone' takes a map of attributes, or nothing, and was given ${argc - 1} arguments"))

    window_arg(base, 0, "clone")?

    val attrs = if argc > 1 then Some(map_arg(base, 1, "clone")?) else None
    val h = new_handle(kind_named(WindowKind))?
    val w = window_arg(base, 0, "clone")?
    var copy = context_at(w.ctx)

    copy.refs = 1

    attrs match
        Some(m) ->
            copy = applied(w.at, copy, m, "clone")? match
                Some(c) -> c
                None ->
                    h.closed = true
                    return Ok(None)
        None -> ()

    var c = canvas_at(w.at)

    c.handles += 1
    c.wins.push(h)
    canvases.set(w.at, Some(c))
    h.n = long(w.at)
    h.vals.push(Int(generations.at(w.at)))
    h.vals.push(Int(long(keep_context(copy))))
    Ok(Some(Handle(h)))

// `w.uncouple()`: this handle closed, and the canvas with it when it was the last.
private do_uncouple(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "uncouple")?

    retire_handle(w.h, detach_window)
    Ok(Some(Unit))

// -- pixels ----------------------------------------------------------------------------------------

// Argument `i` of `argc`, an integer, or `fallback` where it is not given or `undefined`.
private int_or(base: usize, argc: usize, i: usize, fallback: long, name: string) -> Result[long, Fault]
    if i >= argc then return Ok(fallback)

    val x = deref(arg(base, i))

    x match
        Int(n) -> Ok(n)
        Undefined -> Ok(fallback)
        _ -> Err(kind_error(x, "integer", s"'$name' wants an integer and was given ${described(x)}"))

// The colour of the pixel at byte `o` of `data`, eight bits a component, packed `0xrrggbb`, with the
// surface's premultiplication undone.
private pixel_at(data: []u8, o: usize) -> long
    val a = long(data[o + 3])

    if a == 0 then return 0

    val b = long(data[o]) * 255 / a
    val g = long(data[o + 1]) * 255 / a
    val r = long(data[o + 2]) * 255 / a

    (r << 16) | (g << 8) | b

// `w.pixel(x, y, wd, ht)`: the rectangle's colours, row by row, taken when the call starts. The
// rectangle is Icon's: `x` and `y` default to the origin and are moved by `dx` and `dy`, `wd` and `ht`
// default to the canvas's edge, and a negative extent reaches left or up. A pixel off the canvas is
// the background colour.
private start_pixel(base: usize, argc: usize) -> Result[Option[Value], Fault]
    if argc > 5 then return Err(wrong_count("pixel", argc - 1, s"'pixel' takes at most 4 arguments and was given ${argc - 1}"))

    window_arg(base, 0, "pixel")?

    val st = new_handle(kind_named(PixelsKind))?
    val w = window_arg(base, 0, "pixel")?
    val c = canvas_at(w.at)
    val ctx = context_at(w.ctx)
    var x = int_or(base, argc, 1, -ctx.dx, "pixel")? + ctx.dx
    var y = int_or(base, argc, 2, -ctx.dy, "pixel")? + ctx.dy
    var wd = int_or(base, argc, 3, c.width - x, "pixel")?
    var ht = int_or(base, argc, 4, c.height - y, "pixel")?

    if wd < 0
        wd = -wd
        x -= wd

    if ht < 0
        ht = -ht
        y -= ht

    val off = (device(ctx.bg_rgb.r) << 16) | (device(ctx.bg_rgb.g) << 8) | device(ctx.bg_rgb.b)
    val data = c.surface.data()
    val stride = long(c.surface.stride())

    for j in y..<y + ht
        for i in x..<x + wd
            val inside = i >= 0 && j >= 0 && i < c.width && j < c.height

            st.vals.push(Int(if inside then pixel_at(data, usize(j * stride + 4 * i)) else off))

    current().allocated += st.vals.len() * sizeof(Value)
    st.n = 0
    Ok(Some(Handle(st)))

// The next colour of a `pixel` call, as `"r,g,b"`.
private step_pixel(h: *HandleObj) -> Result[Option[Value], Fault]
    val at = usize(h.n)

    if at >= h.vals.len() then return Ok(None)

    val p = small(h.vals.at(at))

    h.n += 1

    val c = Rgb(((p >> 16) & 255) * 257, ((p >> 8) & 255) * 257, (p & 255) * 257)

    Ok(Some(new_str(color_text(c))?))

// -- events ----------------------------------------------------------------------------------------

// Whether `s` is an `inputmask`: any of `"m"`, motion with no button held reported, and `"k"`, a key's
// release reported.
private is_mask(s: string) -> bool
    for c in chars_of(s.bytes)
        if c != 'm' && c != 'k' then return false

    true

private in_mask(mask: string, wanted: char) -> bool
    for c in chars_of(mask.bytes)
        if c == wanted then return true

    false

// `enqueue`'s modifiers, `x`: a string of `"c"` (`&control`), `"m"` (`&meta`), `"s"` (`&shift`) and
// `"r"` (`&released`, a key let go), or `undefined` for none.
private modifiers(x: Value) -> Result[u8, Fault]
    val s = x match
        Str(p) -> p.s
        Undefined -> return Ok(0)
        _ -> return Err(kind_error(x, "string", s"'enqueue' wants the modifiers as a string of the letters c, m, s and r, and was given ${described(x)}"))

    var m: u8 = 0

    for c in chars_of(s.bytes)
        if c == 'c'
            m = m | ModControl
        elif c == 'm'
            m = m | ModMeta
        elif c == 's'
            m = m | ModShift
        elif c == 'r'
            m = m | ModReleased
        else
            return Err(domain_error("event_modifiers", x, s"'enqueue': the modifiers are the letters c, m, s and r, and ${described(x)} has another"))

    Ok(m)

// `w.enqueue(code, x, y, mods, interval)`: an event put on `w`'s queue, where `event()` reads it as it
// reads one the screen put there -- and, as the screen does, not put there when `inputmask` would
// keep it off: motion with no button held without `"m"`, a key's release without `"k"`. `x` and `y`
// are in `w`'s coordinates and default to 0, as do the modifiers and the interval.
private do_enqueue(base: usize, argc: usize) -> Result[Option[Value], Fault]
    if argc < 2 || argc > 6
        return Err(wrong_count("enqueue", argc - 1, s"'enqueue' takes an event code, then x, y, the modifiers and the interval, and was given ${argc - 1} arguments"))

    val w = window_arg(base, 0, "enqueue")?
    val code = deref(arg(base, 1))

    var ev = code match
        Str(p) ->
            if char_count(p.s) != 1
                return Err(domain_error("event_code", code, s"'enqueue': a key's event code is one character, and was given ${described(code)}"))

            WinEvent(true, p.s, 0, 0, 0, 0, 0)
        Atom(id) -> WinEvent(false, "", id, 0, 0, 0, 0)
        _ -> return Err(kind_error(code, "string", s"'enqueue' wants an event code, a one-character string or a symbol, and was given ${described(code)}"))

    val ctx = context_at(w.ctx)

    ev.x = int_or(base, argc, 2, 0, "enqueue")? + ctx.dx
    ev.y = int_or(base, argc, 3, 0, "enqueue")? + ctx.dy
    ev.mods = if argc > 4 then modifiers(deref(arg(base, 4)))? else 0
    ev.interval = int_or(base, argc, 5, 0, "enqueue")?

    if ev.interval < 0
        return Err(domain_error("not_less_than_zero", Int(ev.interval), s"'enqueue': an interval is 0 or more milliseconds, and was given ${ev.interval}"))

    val c = canvas_at(w.at)
    val unasked_release = (ev.mods & ModReleased) != 0 && !in_mask(c.inputmask, 'k')
    val unasked_motion = !ev.is_key && atom_name(ev.sym) == "move" && !in_mask(c.inputmask, 'm')

    if !unasked_release && !unasked_motion then c.queue.push(ev)

    Ok(Some(Unit))

// The text cell, counted from 1, that coordinate `n` falls in when cells are `size` wide.
private cell(n: long, size: long) -> long = (if n >= 0 then n / size else -((-n + size - 1) / size)) + 1

// `w.event()`: the oldest event on `w`'s queue, taken off it, its code answered and the running
// machine's event keywords set from it -- the pointer in `w`'s coordinates, its origin taken off. A
// queue nothing can fill faults rather than waiting for ever.
private do_event(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "event")?

    if canvas_at(w.at).queue.is_empty() then return Err(system_error(s"'event': $NothingComes"))

    val ev = canvas_at(w.at).queue.at(0)
    val code = if ev.is_key then new_str(ev.key)? else Atom(ev.sym)

    // The string made, the event is taken: nothing allocates from here on.
    canvas_at(w.at).queue.remove(0)

    val ctx = context_at(w.ctx)
    val x = ev.x - ctx.dx
    val y = ev.y - ctx.dy

    current().keys = EventKeys(x, y, cell(y, CellHeight), cell(x, CellWidth), ev.interval, ev.mods)
    Ok(Some(code))

// `w.pending()`: how many events are on `w`'s queue; fails when there are none.
private do_pending(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "pending")?
    val n = canvas_at(w.at).queue.len()

    Ok(if n == 0 then None else Some(Int(long(n))))

// The first canvas from place `from` on that this VM opened and that has an event waiting, and the
// oldest window open on it.
private active_from(from: usize) -> Option[(usize, *HandleObj)]
    val v = current()

    for i in from..<canvases.len()
        canvases.at(i) match
            Some(c) -> if c.owner == v && !c.queue.is_empty() && c.wins.len() > 0 then return Some((i, c.wins.at(0)))
            None -> ()

    None

// `active()`: each window that has an event waiting, one per canvas. Where none has, it faults:
// nothing can queue one while the program waits.
private do_active(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val (at, h) = active_from(usize(cursor)) match
        Some(found) -> found
        None -> return if cursor == 0 then Err(system_error(s"'active': $NothingComes")) else Ok(Refuses)

    if active_from(at + 1).is_some() then Ok(GivesMore(Handle(h), long(at + 1))) else Ok(Gives(Handle(h)))

// `&window`: the window `open` made last, or the one assigned; fails when that is closed or there is
// none.
private window_now() -> Result[Answer, Fault]
    val x = current().window

    x match
        Handle(h) -> Ok(if !h.closed && canvas_live(h) then Gives(x) else Refuses)
        _ -> Ok(Refuses)

// `&window = w`: `w`, a window, or `undefined` for none.
private store_window(base: usize) -> Result[Value, Fault]
    val x = deref(arg(base, 0))

    x match
        Undefined -> ()
        Handle(h) ->
            if h.kind != kind_named(WindowKind)
                return Err(type_error("window", x, s"'&window' wants a window, or undefined, and was given ${described(x)}"))
        Var(_) -> return Err(instantiation_error("instantiation error: '&window' was given an unbound variable"))
        _ -> return Err(type_error("window", x, s"'&window' wants a window, or undefined, and was given ${described(x)}"))

    current().window = x
    Ok(x)

// `&control`, `&meta`, `&shift`, `&released`: succeed, producing `undefined` as Icon's produce `&null`,
// when the last event `event()` took had modifier `bit`; fail when not.
private held(bit: u8) -> Result[Answer, Fault] = Ok(if (current().keys.mods & bit) != 0 then Gives(Undefined) else Refuses)
