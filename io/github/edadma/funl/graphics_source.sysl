module io.github.edadma.funl

// The part of `funl:graphics` written in FunL: Icon's palettes (`docs/library/graphics.md`), the
// functions `palette_chars`, `palette_color`, `palette_key` and `palette_grays`. Only what FunL
// cannot do is native: `_palette` reads a palette's name, `_palette_char` a key, and `_color_rgb` a
// colour specification, each with the faults the builtins give (`graphics_image.sysl`).
//
// The keys of `c5`, `c6` and the greys past `g64` are the characters from code 0 up, built a
// character at a time, so no list of them is ever live at once; a key's place among them is its code.
//
// A palette is `"c1"` to `"c6"` or `"g2"` to `"g256"`. `c1` is Icon's table of ninety named colours;
// `c2` to `c6` are colour cubes, `n` levels of each component, with the greys between the cube's own
// added after it; `gn` is `n` greys from black to white. A colour's components are computed as Icon
// computes them, in double precision and truncated, so every key answers Icon's numbers.
//
// `C1Cube` is Icon's choice of a `c1` key for each point of a 10 by 10 by 10 cube of colours, which
// `palette_key` answers for a colour that is not grey.

graphics_source() -> string = raw"""
    val C1Keys = '0123456789?!nNAa#@oOBb$%pPCc&|qQDd,.rREe;:sSFf+-tTGg*/uUHh`\'vVIi<>wWJj()xXKk[]yYLl{}zZMm^='
    val C2Keys = 'kbgcrmywx'
    val C3Keys = '@ABCDEFGHIJKLMNOPQRSTUVWXYZabcd'
    val C4Keys = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz{}$%&*+-/?@'

    val C1Levels = [
      (0, 0, 0), (8, 8, 8), (16, 16, 16), (24, 24, 24), (32, 32, 32), (40, 40, 40), (48, 48, 48), (48, 24, 30), (36, 24, 48), (48, 36, 24),
      (24, 12, 0), (8, 4, 0), (16, 0, 0), (32, 0, 0), (48, 0, 0), (48, 16, 16), (48, 32, 32), (30, 18, 18), (16, 4, 0), (32, 8, 0),
      (48, 12, 0), (48, 24, 16), (48, 36, 32), (30, 21, 18), (16, 8, 0), (32, 16, 0), (48, 24, 0), (48, 32, 16), (48, 40, 32), (30, 24, 18),
      (16, 16, 0), (32, 32, 0), (48, 48, 0), (48, 48, 16), (48, 48, 32), (30, 30, 18), (8, 16, 0), (16, 32, 0), (24, 48, 0), (32, 48, 16),
      (40, 48, 32), (24, 30, 18), (0, 16, 0), (0, 32, 0), (0, 48, 0), (16, 48, 16), (32, 48, 32), (18, 30, 18), (0, 16, 8), (0, 32, 16),
      (0, 48, 24), (16, 48, 32), (32, 48, 40), (18, 30, 24), (0, 16, 16), (0, 32, 32), (0, 48, 48), (16, 48, 48), (32, 48, 48), (18, 30, 30),
      (0, 8, 16), (0, 16, 32), (0, 24, 48), (16, 32, 48), (32, 40, 48), (18, 24, 30), (0, 0, 16), (0, 0, 32), (0, 0, 48), (16, 16, 48),
      (32, 32, 48), (18, 18, 30), (8, 0, 16), (16, 0, 32), (24, 0, 48), (32, 16, 48), (40, 32, 48), (24, 18, 30), (16, 0, 16), (32, 0, 32),
      (48, 0, 48), (48, 16, 48), (48, 32, 48), (30, 18, 30), (16, 0, 8), (32, 0, 16), (48, 0, 24), (48, 16, 32), (48, 32, 40), (30, 18, 24)
    ]

    val C1Cube = join( [
      '00wwwWWWJJ00vvvWWWJJsttvvVVVVJsttuuVVVVIsttuuVVVIISSTTTUUUIISSTTTUUUUISSTTTUUUUHFFTTGGUUHHFFFGGGGHHH',
      '00xxxWWWJJ!11vvWWWJJr11vvVVVjjrrtuuVVVjjrrtuuVVVIISSTTTUUUIISSTTTUUUiiSSTTTUUUiiFFffGGggHHFFffGGggHH',
      'nzxxxXXXXJ!11xxXXXjjp1122)Vjjjrr222)Vjjjrr222>>>jjRR--//>>iiRRRT//\'iiiRRff//ggiiRffffggghhFffffggghh',
      'nzzyyXXXXKoozyyXXXjjpp222)Xjjjqq222))jjjqq222>>>jjRR--//>>iiRRR-//\'\'iiRRff//\'giiRffffggghhEffffggghh',
      'nzzyyXXXKKoozyyXXXKK???22]]]jjqq222]]]jjqq2233>>jjRR::33>>iiRR:::/\'\'iiRR:::/\'\'iiEEfffggghhEEfffggghh',
      'NNZZZYYYKKOOZZZYYYKK???@=]]]kkPP@@=]]]kkPP%%%3]]kkQQ||3344((QQ:::444((QQ:::444<<EEeee++**<EEeee++**`',
      'NNZZZYYYYKOOZZZYYYkkOOOZ==}kkkPPP@==}}kkPP%%%=}}kkQQ|||444((QQ...444((QQe..444<<Qeeee++**<Eeeee++**`',
      'NNZZZYYYYLOOZZZYYYkkOOOa==mkkkPPaa==}kkkPP%%%=}888QQ|||44888QQc..444[[QQcc99455<Qeeee;;55<Deeee;;;*`',
      'AAZZMMYYLLAAaaMMmmLLBBaaammmllBBaaammmllCCbbb77788CCbbb77^[[Qcccc##^[[Qccc99$55[DDdd9&&556DDddd;;;66',
      'AAAMMMMLLLAAaaMMmmLLBBaaammmllBBaaammmllCCbbb777llCCbbb77^^{Ccccc##^^{Dccc99$$^{DDdd9&&&66DDddd,,,66'
    ] )

    export def
      palette_chars( p ) = pkeys( _palette("palette_chars", p) )
      palette_color( p, k ) = pcolor( _palette("palette_color", p), char(_palette_char("palette_color", k)) )
      palette_key( p, c ) = pkey( _palette("palette_key", p), _color_rgb("palette_key", c) )
      palette_grays( p ) = pgrays( _palette("palette_grays", p) )

    def
      pkeys( 1 ) = C1Keys
      pkeys( 2 ) = C2Keys
      pkeys( 3 ) = C3Keys
      pkeys( 4 ) = C4Keys
      pkeys( 5 ) = prun( 141 )
      pkeys( 6 ) = prun( 241 )
      pkeys( p ) = if -p <= 64 then C4Keys(0..<(-p)) else prun( -p )

      prun( n )
        s = ''
        for i <- 0..<n do s += char( i )
        s

      plevel( m, k ) = truncate( 65535 * m * k )
      c1level( v ) = truncate( 65535 * (v / 48.0) )
      c1entry( (r, g, b) ) = (c1level(r), c1level(g), c1level(b))
      grey( g ) = (g, g, g)

      pentry( 1, i ) = c1entry( C1Levels(i) )
      pentry( p, i ) | p < 0 = grey( plevel(1.0 / (-p - 1), i) )
      pentry( p, i ) | i < p^3 = (plevel(1.0 / (p - 1), i \ (p * p)), plevel(1.0 / (p - 1), (i \ p) mod p), plevel(1.0 / (p - 1), i mod p))
      pentry( p, i ) = grey( plevel(1.0 / (p * (p - 1)), ((i - p^3) \ (p - 1)) * p + (i - p^3) mod (p - 1) + 1) )

      pcolor( p, k ) = ptext( pentry(p, pindex(p, k, ord(k))) )

      pindex( p, k, i ) | (p == 5 or p == 6 or p < -64) and i < pcount(p) = i
      pindex( p, k, i ) | p == 5 or p == 6 or p < -64 = fail
      pindex( p, k, i ) = find( k, pkeys(p) ) - 1
      pchar( p, i ) = if p == 5 or p == 6 or p < -64 then char( i ) else pkeys(p)( i )
      pcount( 5 ) = 141
      pcount( 6 ) = 241
      pcount( p ) = -p
      ptext( (r, g, b) ) = "${r},${g},${b}"

      pgrays( p ) | p < 0 = pkeys( p )
      pgrays( 1 ) = '0123456'
      pgrays( p ) = join( [pchar(p, pgray(p, k)) | k <- 0..p * (p - 1)] )
      pgray( p, k ) = if k mod p == 0 then (k \ p) * (p * p + p + 1) else p^3 + k - k \ p - 1

      pstep( side, c ) = truncate( 0.501 + (side - 1) * (c / 65535.0) )
      pcube( side, (r, g, b) ) = (pstep(side, r) * side + pstep(side, g)) * side + pstep(side, b)

      pkey( p, (r, g, b) ) | p > 0 and r == g and g == b = pgrays(p)( truncate(0.501 + (if p == 1 then 6 else p * (p - 1)) * (g / 65535.0)) )
      pkey( 1, c ) = C1Cube( pcube(10, c) )
      pkey( p, c ) | p > 0 = pchar( p, pcube(p, c) )
      pkey( p, (r, g, b) ) = pchar( p, truncate(0.5 + (0.299 * (r / 65535.0) + 0.587 * (g / 65535.0) + 0.114 * (b / 65535.0)) * (-p - 1)) )
    """
