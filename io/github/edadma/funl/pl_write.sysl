module io.github.edadma.funl

import sh.sysl.dal
import sh.sysl.dal.Number
import sysl.buf.{Buf, buf}
import sysl.text.{Search, StrBuilder, chars_of, str_builder}

// How Prolog writes a term: operators as the current table declares them, atoms quoted where a
// reader would otherwise take them for something else, lists and curly terms in their own notation.
//
// **What `writeq` writes, the reader reads back as the same term**, under the same operator table.
// Three things make that true beyond quoting. An operand is bracketed when its priority is above
// what its position allows, and an atom that is an operator is bracketed wherever it is an operand.
// A space goes between two tokens that would otherwise run together into one -- `1- -1`, `a= \+b`,
// `X is 1` -- and nowhere else. And `-(1)` is written as the compound it is, since `-1` and `- 1` read
// as the number and `-(1)` only as the term.
//
// **Variables are written `_G` and their number**, which reads back as a variable, except where the
// top level has named them (`VarNames`).

struct WriteOpts
    quoted: bool
    ignore_ops: bool

    // `'$VAR'(N)` as the variable name it stands for: `A`, ..., `Z`, `A1`, ...
    numbervars: bool

    // How deep into a term to write before `...`, and how many elements of a list; 0 for no limit.
    max_depth: long

    // A space after each comma between arguments, list elements and the operands of `,`, as
    // SWI-Prolog's top level writes an answer (its `spacing(next_argument)`).
    spacing: bool

write_opts(quoted: bool, ignore_ops: bool, numbervars: bool) -> WriteOpts =
    WriteOpts(quoted, ignore_ops, numbervars, 0, false)

// The options the top level writes an answer with: quoted, with `'$VAR'` names and spacing.
answer_opts() -> WriteOpts = WriteOpts(true, false, true, 0, true)

// The comma between two arguments, elements or operands.
private put_comma(w: *Writer) = emit(w, if w.o.spacing then ", " else ",")

private struct Writer
    out: StrBuilder
    o: WriteOpts

    // The last byte written, which decides whether the next token needs a space before it.
    last: u8

    // The heads of the term's cycles and the names they are written as: a node among them is written
    // as its name, except where `open` says the next node written is to be spelled out.
    cyc: Cycles
    names: Buf[string]
    open: bool

    // The names unbound variables are written as, where the top level has named them.
    vars: Option[*VarNames]

// The names the top level gives the unbound variables of an answer, by variable id. A variable with
// no name is written `_G` and its number, and its id is added to `unnamed` each time it is written,
// so the top level can count how often each appears.
struct VarNames
    ids: Buf[u64]
    names: Buf[string]
    unnamed: Buf[u64]

var_names() -> VarNames = VarNames(buf(), buf(), buf())

// The name `names` gives the variable numbered `id`, if it gives one.
var_named(names: *VarNames, id: u64) -> Option[string]
    for i in 0..<names.ids.len()
        if names.ids.at(i) == id then return Some(names.names.at(i))

    None

// However deep a term is, the writer stops here, so a deep term cannot overflow the sysl stack.
private const Deepest: long = 1000

// `x` as text.
//
// **A cyclic term is written as `@(Template, Substitutions)`**, as SWI-Prolog writes one under its
// default `cycles(true)`: each node where a cycle closes is named `S_1`, `S_2`, ..., the template is
// the term with those nodes named, and each substitution spells one of them out once. So
// `X = f(X), write(X)` writes `@(S_1,[S_1=f(S_1)])`, and no write of a term is infinite.
term_text(x: Value, o: WriteOpts) -> string
    val c = cycles_of(x)

    if c.heads.len() == 0
        var w = writer(o, no_cycles(), buf())

        put_term(&w, x, 1200, 0)
        return w.out.finish()

    var names: Buf[string] = buf()

    // Under `numbervars(true)` -- `write/1`, `print/1`, `writeq/1` -- SWI-Prolog names them `S_1`,
    // `S_2`, ..., as it writes `'$VAR'(-1)`, `'$VAR'(-2)`, ...; otherwise they are written as variables.
    for k in 1..c.heads.len()
        names.push(if o.numbervars then s"S_$k" else cycle_name(k))

    var w = writer(o, c, names)

    emit(&w, "@(")
    put_term(&w, x, 999, 0)
    emit(&w, ",[")

    for k in 0..<c.heads.len()
        if k > 0 then emit(&w, ",")

        if o.ignore_ops then emit(&w, "=(")

        emit(&w, names.at(k))
        emit(&w, if o.ignore_ops then "," else "=")
        w.open = true
        put_term(&w, c.heads.at(k), if o.ignore_ops then 999 else 699, 0)

        if o.ignore_ops then emit(&w, ")")

    emit(&w, "])")
    w.out.finish()
end term_text

// `x` as text, the heads of `c`'s cycles written as `names` and its unbound variables as `vars`
// names them: `x` itself spelled out when `open`, and at priority `max`. What the top level writes an
// answer with.
term_text_vars(x: Value, o: WriteOpts, c: Cycles, names: Buf[string], open: bool, max: u16, vars: *VarNames) -> string
    var w = writer(o, c, names)

    w.open = open
    w.vars = Some(vars)
    put_term(&w, x, max, 0)
    w.out.finish()

private writer(o: WriteOpts, c: Cycles, names: Buf[string]) -> Writer = Writer(str_builder(), o, 0, c, names, false, None)

// A writer that will write into the middle of another's output, inheriting its options and names.
private sub_writer(w: *Writer) -> Writer
    var sub = writer(w.o, w.cyc, w.names)

    sub.vars = w.vars
    sub

// An unbound variable: its name where the top level has given it one, and otherwise `_G` and its
// number.
private put_var(w: *Writer, p: *VarObj)
    w.vars match
        Some(vn) ->
            var_named(vn, p.id) match
                Some(n) ->
                    emit(w, n)
                    return
                None -> vn.unnamed.push(p.id)
        None -> ()

    emit(w, s"_G${p.id}")

// The name `x` is written as, where it is the head of a cycle.
private name_of(w: *Writer, x: Value) -> Option[string]
    if w.cyc.heads.len() == 0 then return None

    val a = node_of(x)

    if a == 0 then return None

    get_at(&w.cyc.index, a, 0) match
        Some(k) -> Some(w.names.at(k - 1))
        None -> None

private emit(w: *Writer, s: string)
    val n = s.bytes.len

    if n == 0 then return

    if glues(w.last, s.bytes[0]) then w.out.push(" ")

    w.out.push(s)
    w.last = s.bytes[n - 1]

// Whether a token ending in `a` and one beginning with `b` would read as one token, or as a name
// followed by a quoted atom it does not belong to.
private glues(a: u8, b: u8) -> bool =
    (alnum(a) && alnum(b)) || (symbolic(a) && symbolic(b)) || (alnum(a) && b == u8('\'')) || (a == u8('\'') && alnum(b))

private alnum(c: u8) -> bool =
    (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z')) || (c >= u8('0') && c <= u8('9')) || c == u8('_')

private symbolic(c: u8) -> bool =
    c == u8('+') || c == u8('-') || c == u8('*') || c == u8('/') || c == u8('\\') || c == u8('^') ||
    c == u8('<') || c == u8('>') || c == u8('=') || c == u8('~') || c == u8(':') || c == u8('.') ||
    c == u8('?') || c == u8('@') || c == u8('#') || c == u8('&') || c == u8('$')

// Term `x` where a term of priority at most `max` may stand.
private put_term(w: *Writer, x: Value, max: u16, depth: long)
    if (w.o.max_depth > 0 && depth >= w.o.max_depth) || depth >= Deepest
        emit(w, "...")
        return

    val d = deref(x)

    if w.open
        w.open = false
    else
        name_of(w, d) match
            Some(n) ->
                emit(w, n)
                return
            None -> ()

    d match
        Int(n) -> emit(w, s"$n")
        Big(p) -> emit(w, num_text(p.n))

        // A rational as SWI-Prolog writes one, `7r2`, which reads as a number where `7/2` would read
        // as a term.
        Rat(p) -> emit(w, prolog_num_text(p.n))

        // A real always shows it is one -- `1.0`, never `1` -- so it reads back as a real.
        Real(r) -> emit(w, num_text(Number.Real(r)))
        Var(p) -> put_var(w, p)
        Atom(id) -> put_atom(w, atom_name(id), max < 1200)
        Nil -> emit(w, "[]")
        Cons(p) -> put_list(w, p, depth)
        // Quoted in back quotes where the `back_quotes` flag reads them as a string, as SWI-Prolog
        // writes one then.
        Str(p) -> emit(w, if w.o.quoted then quoted_text(p.s, if current().flags.back_quotes == "string" then "`" else "\"") else p.s)
        Compound(c) -> put_compound(w, c, max, depth)
        Tuple(t) -> put_canonical(w, "tuple", t.items.view(), depth)
        Unit -> emit(w, "()")
        Undefined -> emit(w, "undefined")
        Range(_) -> emit(w, render(x))
        Func(_) -> emit(w, "<function>")
        Map(_) -> emit(w, "<map>")
        MutMap(_) -> emit(w, "<map>")
        Set(_) -> emit(w, "<set>")
        MutSet(_) -> emit(w, "<set>")
        Array(_) -> emit(w, "<array>")
        Buffer(_) -> emit(w, "<buffer>")
        Ctor(_) -> emit(w, "<constructor>")
        CSet(_) -> emit(w, "<cset>")
        Bytes(_) -> emit(w, render(x))
        Handle(_) -> emit(w, render(x))
end put_term

// An atom. `inner` says it stands inside a term, where `,` and `|` are quoted even by `write`: bare,
// they would be read as punctuation.
private put_atom(w: *Writer, name: string, inner: bool)
    if w.o.quoted || (inner && (name == "," || name == "|"))
        emit(w, atom_token(name))
    else
        emit(w, name)

// An atom as `writeq` writes it: bare when the reader reads it back as that atom, and otherwise
// quoted.
atom_token(name: string) -> string = if bare_atom(name) then name else quoted_text(name, "'")

private bare_atom(name: string) -> bool
    val b = name.bytes

    if b.len == 0 then return false
    if name == "{}" || name == "!" || name == ";" then return true
    if name == "[]" || name == "," || name == "|" then return false

    if b[0] >= u8('a') && b[0] <= u8('z')
        for c in b
            if !alnum(c) then return false

        return true

    if name == "." || (b.len >= 2 && b[0] == u8('/') && b[1] == u8('*')) then return false

    for c in b
        if !symbolic(c) then return false

    true

// Text between quotes `q`, with the quote, the backslash and every control character escaped.
private quoted_text(s: string, q: string) -> string
    var out = str_builder()
    val qu = u32(q.bytes[0])

    out.push(q)

    for c in chars_of(s.bytes)
        val u = u32(c)

        if u == qu || u == 92
            out.push("\\")
            out.push_char(c)
        elif u == 10
            out.push("\\n")
        elif u == 9
            out.push("\\t")
        elif u < 32 || u == 127
            out.push(s"\\x${hex(u)}\\")
        else
            out.push_char(c)

    out.push(q)
    out.finish()

private hex(u: u32) -> string
    val digits = "0123456789abcdef"
    var n = u
    var out = ""

    loop
        out = s"${digits.slice(usize(n % 16), usize(n % 16) + 1)}$out"
        n = n / 16

        if n == 0 then break

    out

// `[a,b|T]`, at most `max_depth` elements of it.
private put_list(w: *Writer, first: *ConsObj, depth: long)
    emit(w, "[")
    put_term(w, first.head, 999, depth + 1)

    var tail = deref(first.tail)
    var count: long = 1

    loop
        // A tail that is a cycle's head is written as its name, after a bar.
        if name_of(w, tail).is_some()
            emit(w, "|")
            put_term(w, tail, 999, depth + 1)
            break

        tail match
            Cons(p) ->
                if (w.o.max_depth > 0 && count >= w.o.max_depth) || count >= Deepest * Deepest
                    emit(w, "|")
                    emit(w, "...")
                    break

                put_comma(w)
                put_term(w, p.head, 999, depth + 1)
                count += 1
                tail = deref(p.tail)
            Nil -> break
            _ ->
                emit(w, "|")
                put_term(w, tail, 999, depth + 1)
                break

    emit(w, "]")
end put_list

// `name(a1,...,an)`.
private put_canonical(w: *Writer, name: string, args: []Value, depth: long)
    put_atom(w, name, true)
    emit(w, "(")

    for i in 0..<args.len
        if i > 0 then put_comma(w)

        put_term(w, args[i], 999, depth + 1)

    emit(w, ")")

// The operator `name` written infix, `,` among them: the table leaves it out because the reader
// treats it as punctuation. `|` is written canonically, `'|'(a,b)`.
private infix_for_write(name: string) -> Option[PlOp]
    if name == "," then return Some(PlOp(1000, Xfy))

    infix_op(name)

private put_compound(w: *Writer, c: *CompoundObj, max: u16, depth: long)
    val name = atom_name(c.functor)
    val n = c.args.len()

    if name == "{}" && n == 1
        emit(w, "{")
        put_term(w, c.args.at(0), 1200, depth + 1)
        emit(w, "}")
        return

    // As SWI-Prolog writes them: `'$VAR'(N)` as its letter name, `'$VAR'(-N)` as `S_N`, and
    // `'$VAR'(Name)` as `Name` where `Name` is spelled as a variable is.
    if w.o.numbervars && name == "$VAR" && n == 1
        deref(c.args.at(0)) match
            Int(k) ->
                emit(w, if k >= 0 then var_name(k) else s"S_${-k}")
                return
            Atom(id) ->
                if variable_spelling(atom_name(id))
                    emit(w, atom_name(id))
                    return
            _ -> ()

    if !w.o.ignore_ops
        if n == 2
            infix_for_write(name) match
                Some(o) ->
                    put_infix(w, name, o, c, max, depth)
                    return
                None -> ()

        if n == 1
            prefix_op(name) match
                Some(o) ->
                    put_prefix(w, name, o, c.args.at(0), max, depth)
                    return
                None -> ()

            postfix_op(name) match
                Some(o) ->
                    open_if(w, o.priority > max)
                    put_operand(w, c.args.at(0), left_max(o), depth)
                    put_atom(w, name, false)
                    close_if(w, o.priority > max)
                    return
                None -> ()

    put_canonical(w, name, c.args.view(), depth)
end put_compound

// Whether `s` is spelled as a variable is: a capital letter or `_`, then letters, digits and `_`.
private variable_spelling(s: string) -> bool
    val b = s.bytes

    if b.len == 0 then return false
    if !(b[0] == u8('_') || (b[0] >= u8('A') && b[0] <= u8('Z'))) then return false

    for i in 1..<b.len
        if !alnum(b[i]) then return false

    true

// `'$VAR'(k)`'s name: a letter, and from the 27th on a number after it.
var_name(k: long) -> string
    val letter = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".slice(usize(k % 26), usize(k % 26) + 1)

    if k < 26 then letter else s"$letter${k / 26}"

// An operand's opening bracket. After a name -- `a mod (b+c)` -- it is set apart, or the name and the
// bracket would read as a compound's functor and its argument list.
private open_if(w: *Writer, yes: bool)
    if !yes then return

    if alnum(w.last) then w.out.push(" ")

    emit(w, "(")

private close_if(w: *Writer, yes: bool)
    if yes then emit(w, ")")

private put_infix(w: *Writer, name: string, o: PlOp, c: *CompoundObj, max: u16, depth: long)
    val bracket = o.priority > max
    val right_max: u16 = if o.kind == Xfy then o.priority else o.priority - 1

    open_if(w, bracket)
    put_operand(w, c.args.at(0), left_max(o), depth)

    if name == ","
        put_comma(w)
    elif name == "|"
        emit(w, name)
    else
        // A symbol operator that had to be set apart from its left operand is set apart from its
        // right one too -- `@ = a` -- and a name operator always is: `a is -4`, `a is [b]`.
        val token = if w.o.quoted then atom_token(name) else name
        val apart = token.bytes.len > 0 && symbolic(token.bytes[0]) && glues(w.last, token.bytes[0])

        put_atom(w, name, false)

        if apart || alnum(w.last)
            w.out.push(" ")
            w.last = u8(' ')

    put_operand(w, c.args.at(1), right_max, depth)
    close_if(w, bracket)

// A prefix operator applied, as ISO has it and GNU Prolog writes it. An operand that begins with a
// bracket is set apart from the operator by a space, so the bracket is not read as the start of an
// argument list: an operand of too high a priority, `- (1+2)` and `\+ (a,b)`, and a number or a term
// beginning with one after `-`, `- (1)` and `- (1^2)`, as `- 1` would read as the number -1.
private put_prefix(w: *Writer, name: string, o: PlOp, x: Value, max: u16, depth: long)
    val bracket = o.priority > max

    open_if(w, bracket)
    put_atom(w, name, false)

    if operand_bracketed(w, name, o, x)
        w.out.push(" ")
        emit(w, "(")
        put_term(w, x, 1200, depth + 1)
        emit(w, ")")
    else
        var sub = sub_writer(w)

        put_operand(&sub, x, operand_max(o), depth)

        val text = sub.out.finish()

        if text.bytes.len > 0 && (text.bytes[0] == u8('(') || (text.bytes[0] == u8('{') && alnum(w.last))) then w.out.push(" ")

        emit(w, text)

    close_if(w, bracket)

// Whether prefix operator `name`'s operand `x` is written in brackets: `-` before what is written
// beginning with a digit, or an operand of a priority above the operator's.
private operand_bracketed(w: *Writer, name: string, o: PlOp, x: Value) -> bool =
    (name == "-" && leads_with_digit(w, x)) || priority_of(w, x) > operand_max(o)

// Whether `x`, written as an operand, begins with a digit: a number that is not negative, or an
// operator term whose leftmost operand does.
private leads_with_digit(w: *Writer, x: Value) -> bool
    if name_of(w, deref(x)).is_some() then return false

    deref(x) match
        Int(n) -> n >= 0
        Big(p) -> dal.sign(p.n) >= 0
        Rat(p) -> dal.sign(p.n) >= 0
        Real(r) -> r >= 0.0
        Compound(c) ->
            if is_op_atom(c.args.at(0)) then return false

            val name = atom_name(c.functor)
            val n = c.args.len()

            if (n == 2 && infix_for_write(name).is_some()) || (n == 1 && postfix_op(name).is_some() && prefix_op(name).is_none())
                return leads_with_digit(w, c.args.at(0))

            false
        _ -> false

// An operand of an operator: bracketed when its priority is above `max`, or when it is an atom that
// is itself an operator.
private put_operand(w: *Writer, x: Value, max: u16, depth: long)
    if is_op_atom(x)
        open_if(w, true)
        put_term(w, x, 999, depth + 1)
        emit(w, ")")
        return

    val p = priority_of(w, x)

    open_if(w, p > max)
    put_term(w, x, if p > max then 1200 else max, depth + 1)
    close_if(w, p > max)

// The text of an answer's last binding `text`, closed with the end `.`. After a symbol character
// the dot is set apart -- `X = # .` -- or the two would read as one token.
answer_closed(text: string) -> string =
    if text.bytes.len > 0 && symbolic(text.bytes[text.bytes.len - 1]) then text + " ." else text + "."

// Whether `x` is an atom that is an operator, which an answer writes in brackets: `X = (-)`.
operator_atom(x: Value) -> bool = is_op_atom(x)

private is_op_atom(x: Value) -> bool = deref(x) match
    Atom(id) -> is_op(atom_name(id)) || atom_name(id) == ","
    _ -> false

// The priority `x` is written at: its operator's, when it is written as an operator, and 0 otherwise
// -- a cycle's head written as its name among them.
private priority_of(w: *Writer, x: Value) -> u16
    if name_of(w, deref(x)).is_some() then return 0

    deref(x) match
        Compound(c) ->
            val name = atom_name(c.functor)
            val n = c.args.len()

            if n == 2
                infix_for_write(name) match
                    Some(o) -> return o.priority
                    None -> ()

            if n == 1 && name != "{}"
                prefix_op(name) match
                    Some(o) -> return o.priority
                    None -> ()

                postfix_op(name) match
                    Some(o) -> return o.priority
                    None -> ()

            0
        _ -> 0
end priority_of
