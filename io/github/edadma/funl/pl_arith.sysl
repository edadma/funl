module io.github.edadma.funl

import sh.sysl.dal
import sh.sysl.dal.Number
import sysl.math.bigint.BigInt
import sysl.math.bigint as big
import sysl.math.{Float, checked_add, checked_mul, checked_sub}
import sysl.posix.rand.seed_from_os
import sysl.rand.rng
import sysl.text.chars_of

// Prolog arithmetic: `is/2`, the comparisons, `succ/2`, `plus/3` and `between/3`.
//
// **An expression is a term, evaluated by its functor's Prolog meaning over `dal`'s tower** under
// ISO's policy (`number.sysl`): integers without bound, `/` on two integers an integer where it
// divides and a float where it does not -- an exact rational under the `prefer_rationals` flag --
// `//`, `mod`, `rem` and `div` refusing a float, and every result that is not a finite double an
// evaluation error. What only Prolog has -- the bit operations, `gcd`, `msb`, the float functions and
// the roundings -- is here, over the same numbers.

install_prolog_arith(v: *Vm)
    register_generator(v, "is/2", 2, pl_is)
    register_generator(v, "=:=/2", 2, (b, n, c) -> compared(b, (o) -> o == 0))
    register_generator(v, "=\\=/2", 2, (b, n, c) -> compared(b, (o) -> o != 0))
    register_generator(v, "</2", 2, (b, n, c) -> compared(b, (o) -> o == -1))
    register_generator(v, ">/2", 2, (b, n, c) -> compared(b, (o) -> o == 1))
    register_generator(v, "=</2", 2, (b, n, c) -> compared(b, (o) -> o == -1 || o == 0))
    register_generator(v, ">=/2", 2, (b, n, c) -> compared(b, (o) -> o == 1 || o == 0))
    register_generator(v, "succ/2", 2, pl_succ)
    register_generator(v, "plus/3", 3, pl_plus)
    register_generator(v, "between/3", 3, pl_between)

// The value of expression `x`: always a number.
//
// **Recursive over the expression's depth**, as the reader nests no deeper than it reads; a program
// that builds an expression thousands of levels deep at run time is the one way past that.
eval(x: Value) -> Result[Value, Fault]
    val y = deref(x)

    y match
        Int(_) -> return Ok(y)
        Real(_) -> return Ok(y)
        Big(_) -> return Ok(y)
        Rat(_) -> return Ok(y)
        _ -> ()

    y match
        Var(_) -> Err(instantiation_error("instantiation error: an arithmetic expression holds an unbound variable"))
        Atom(id) -> constant(atom_name(id))
        Nil -> Err(not_evaluable("[]", 0))
        Cons(p) ->
            // `[X]` with `X` an integer -- a character code, as `"a"` reads under `double_quotes`
            // `codes` -- is `X`, as in GNU Prolog and SWI-Prolog alike.
            val single = deref(p.tail) match
                Nil -> true
                _ -> false

            if single
                deref(p.head) match
                    Int(_) -> return Ok(deref(p.head))
                    Big(_) -> return Ok(deref(p.head))
                    Var(_) -> return Err(instantiation_error("instantiation error: an arithmetic expression holds an unbound variable"))
                    _ -> ()

            Err(not_evaluable("[|]", 2))
        Str(p) ->
            // A string of one character is its code, and any other string `type_error(character, S)`,
            // as in SWI-Prolog.
            if one_char(p.s) then return Ok(Int(long(u32(chars_of(p.s.bytes).peek().unwrap()))))

            Err(type_error("character", y, s"${described(y)} is not one character, which an arithmetic expression takes as its code"))
        Compound(c) ->
            val name = atom_name(c.functor)

            c.args.len() match
                1 -> unary(name, eval(c.args.at(0))?)
                2 ->
                    val a = eval(c.args.at(0))?
                    val b = eval(c.args.at(1))?

                    binary(name, a, b)
                n -> Err(not_evaluable(name, n))
        _ -> Err(type_error("evaluable", y, s"${described(y)} is not an arithmetic expression"))

// The evaluable atoms: `pi`, `e` and `epsilon`, the gap between 1.0 and the next double above it.
private constant(name: string) -> Result[Value, Fault]
    if name == "pi" then return Ok(Real(3.141592653589793))
    if name == "e" then return Ok(Real(2.718281828459045))
    if name == "epsilon" then return Ok(Real(2.220446049250313e-16))

    Err(not_evaluable(name, 0))

// `Name/Arity` names no arithmetic function: `type_error(evaluable, Name/Arity)`.
private not_evaluable(name: string, arity: usize) -> Fault
    val culprit = indicator(name, arity) match
        Ok(x) -> x
        Err(e) -> return Broken(e)

    type_error("evaluable", culprit, s"$name/$arity is not an arithmetic function")

// The number a value `eval` answered is.
private n_of(a: Value) -> Number = num_of(a).unwrap()

private unary(name: string, a: Value) -> Result[Value, Fault]
    val p = prolog_policy()

    if name == "-" then return num_answer1(p.neg(n_of(a)), name, a)
    if name == "+" then return Ok(a)
    if name == "abs" then return num_answer1(p.abs(n_of(a)), name, a)

    if name == "sign"
        val s = dal.sign(n_of(a))

        return a match
            Real(r) ->
                val sr = if r.is_nan() then r else real(s)

                Ok(Real(sr))
            _ -> Ok(Int(long(s)))

    if name == "\\"
        a match
            Int(n) -> return Ok(Int(~n))
            _ -> return of_big(big.not(whole(a, name)?))

    if name == "msb"
        if dal.sign(n_of(a)) <= 0 || !is_int(a)
            if !is_int(a) then return Err(type_error("integer", a, s"msb wants an integer, and was given ${described(a)}"))

            return Err(type_error("not_less_than_one", a, s"msb wants a positive integer, and was given ${render(a)}"))

        return Ok(Int(long(big.bit_length(whole(a, name)?)) - 1))

    if name == "integer" || name == "round" || name == "truncate" || name == "ceiling" || name == "floor"
        return rounded(name, a)

    if name == "random" then return random_below(a)

    val r = dal.to_real(n_of(a))

    if name == "float" then return real_of(r, name, a)
    if name == "float_integer_part" then return real_of(r.trunc(), name, a)
    if name == "float_fractional_part" then return real_of(r - r.trunc(), name, a)
    if name == "sqrt" then return real_of(r.sqrt(), name, a)
    if name == "sin" then return real_of(r.sin(), name, a)
    if name == "cos" then return real_of(r.cos(), name, a)
    if name == "tan" then return real_of(r.tan(), name, a)
    if name == "asin" then return real_of(r.asin(), name, a)
    if name == "acos" then return real_of(r.acos(), name, a)
    if name == "atan" then return real_of(r.atan(), name, a)
    if name == "exp" then return real_of(r.exp(), name, a)

    if name == "sinh" then return real_of(r.sinh(), name, a)
    if name == "cosh" then return real_of(r.cosh(), name, a)
    if name == "tanh" then return real_of(r.tanh(), name, a)
    if name == "asinh" then return real_of(r.asinh(), name, a)

    // `acosh` wants at least 1, and `atanh` a number from -1 to 1.
    if name == "acosh"
        if r < 1.0 then return Err(evaluation_error("undefined", s"acosh(${render(a)}) has no value"))

        return real_of(r.acosh(), name, a)

    // `atanh(1)` and `atanh(-1)` are infinite, `float_overflow` as GNU Prolog and SWI-Prolog raise it.
    if name == "atanh"
        if r == -1.0 || r == 1.0 then return Err(evaluation_error("float_overflow", s"atanh(${render(a)}) is too large for a float"))
        if r < -1.0 || r > 1.0 then return Err(evaluation_error("undefined", s"atanh(${render(a)}) has no value"))

        return real_of(r.atanh(), name, a)

    // `cot(0)` has no value; `acot(x)` is the angle whose cotangent is `x`, so `acot(0)` is pi / 2.
    if name == "cot"
        if r == 0.0 then return Err(evaluation_error("undefined", s"cot(${render(a)}) has no value"))

        return real_of(1.0 / r.tan(), name, a)

    if name == "acot" then return real_of(1.0.atan2(r), name, a)

    // The logarithm of 0 is `float_overflow`, as GNU Prolog and SWI-Prolog both raise it, and of a
    // negative number has no value.
    if name == "log" || name == "log2"
        if r == 0.0 then return Err(evaluation_error("float_overflow", s"$name(${render(a)}) is too large for a float"))
        if r < 0.0 then return Err(evaluation_error("undefined", s"$name(${render(a)}) has no value"))

        return real_of(if name == "log" then r.ln() else r.log2(), name, a)

    Err(not_evaluable(name, 1))
end unary

// `random(N)`: an integer drawn uniformly from 0 to `N - 1`, `N` a positive integer. The machine's
// generator is seeded from the operating system the first time, so every run draws differently.
private random_below(a: Value) -> Result[Value, Fault]
    val n = a match
        Int(k) -> k
        Big(_) -> return Err(representation_error("max_integer", s"random/1's bound ${render(a)} is too large"))
        _ -> return Err(type_error("integer", a, s"random/1 wants an integer, and was given ${described(a)}"))

    if n <= 0 then return Err(domain_error("not_less_than_one", a, s"random/1 wants a positive bound, and was given $n"))

    val v = current()

    if !v.rng_seeded
        v.rng = rng(seed_from_os().unwrap_or(0), 0)
        v.rng_seeded = true

    Ok(Int(long(v.rng.below(u64(n)))))

private binary(name: string, a: Value, b: Value) -> Result[Value, Fault]
    // The fast path: two 64-bit integers whose sum, difference or product is one too.
    (a, b) match
        (Int(x), Int(y)) ->
            var quick: Option[long] = None

            if name == "+"
                quick = checked_add(x, y)
            elif name == "-"
                quick = checked_sub(x, y)
            elif name == "*"
                quick = checked_mul(x, y)

            quick match
                Some(r) -> return Ok(Int(r))
                None -> ()
        _ -> ()

    val p = prolog_policy()

    if name == "+" then return num_answer(p.add(n_of(a), n_of(b)), name, a, b)
    if name == "-" then return num_answer(p.sub(n_of(a), n_of(b)), name, a, b)
    if name == "*" then return num_answer(p.mul(n_of(a), n_of(b)), name, a, b)
    if name == "/" then return num_answer(p.div(n_of(a), n_of(b)), name, a, b)
    if name == "//" then return num_answer(p.quot(n_of(a), n_of(b)), name, a, b)
    if name == "mod" then return num_answer(p.modulo(n_of(a), n_of(b)), name, a, b)
    if name == "rem" then return num_answer(p.rem(n_of(a), n_of(b)), name, a, b)
    if name == "div" then return num_answer(p.floor_div(n_of(a), n_of(b)), name, a, b)

    // Of two equal numbers of different kinds, the first.
    if name == "min" then return Ok(if dal.compare(n_of(b), n_of(a)) == Some(-1) then b else a)
    if name == "max" then return Ok(if dal.compare(n_of(b), n_of(a)) == Some(1) then b else a)

    // `^` is the exact power on two integers and a float one where either is a float; `**` is
    // always a float.
    if name == "^"
        if is_float(a) || is_float(b) then return real_of2(dal.to_real(n_of(a)).pow(dal.to_real(n_of(b))), name, a, b)

        // A fractional exponent is the culprit when there is one, and the base otherwise.
        val blamed = if is_int(b) then a else b

        return p.pow(n_of(a), n_of(b)) match
            Ok(n) -> num_result(Ok(n), "", blamed)
            Err(e) -> Err(num_fault(e, s"${render(a)} ^ ${render(b)}", blamed))

    if name == "**" then return real_of2(dal.to_real(n_of(a)).pow(dal.to_real(n_of(b))), name, a, b)

    if name == "atan2" || name == "atan"
        val y = dal.to_real(n_of(a))
        val x = dal.to_real(n_of(b))

        // `atan2(0, 0)` is `0.0`, as C's `atan2` has it and GNU Prolog and SWI-Prolog answer.
        return real_of2(y.atan2(x), name, a, b)

    // `log(Base, X)`: the logarithm of `X` to `Base`, which must be positive and not 1.
    if name == "log"
        val base = dal.to_real(n_of(a))
        val x = dal.to_real(n_of(b))

        if base <= 0.0 || base == 1.0 || x <= 0.0 then return Err(evaluation_error("undefined", s"log(${render(a)}, ${render(b)}) has no value"))

        return real_of2(x.ln() / base.ln(), name, a, b)

    // `copysign(X, Y)`: `X` with the sign of `Y`, `-0.0` counting as negative. An integer `X` stays an
    // integer, as in SWI-Prolog -- `0` has no sign to take.
    if name == "copysign"
        val negative = b match
            Real(r) -> 1.0.copysign(r) < 0.0
            _ -> dal.sign(n_of(b)) < 0

        if is_int(a)
            val s = dal.sign(n_of(a))

            if s == 0 || (s < 0) == negative then return Ok(a)

            return num_answer1(p.neg(n_of(a)), name, a)

        return real_of2(dal.to_real(n_of(a)).copysign(dal.to_real(n_of(b))), name, a, b)

    if name == "gcd" then return of_big(big.gcd(whole(a, name)?, whole(b, name)?))

    if name == "/\\"
        (a, b) match
            (Int(x), Int(y)) -> return Ok(Int(x & y))
            _ -> return of_big(big.and(whole(a, name)?, whole(b, name)?))

    if name == "\\/"
        (a, b) match
            (Int(x), Int(y)) -> return Ok(Int(x | y))
            _ -> return of_big(big.or(whole(a, name)?, whole(b, name)?))

    if name == "xor"
        (a, b) match
            (Int(x), Int(y)) -> return Ok(Int(x ^ y))
            _ -> return of_big(big.xor(whole(a, name)?, whole(b, name)?))

    if name == ">>" then return shifted(a, b, false)
    if name == "<<" then return shifted(a, b, true)

    Err(not_evaluable(name, 2))
end binary

// A double as the answer of `name(a)`: a finite one is a float, an infinite one
// `evaluation_error(float_overflow)` and a NaN `evaluation_error(undefined)`. The message is
// written only for a refusal.
private real_of(r: real, name: string, a: Value) -> Result[Value, Fault] =
    if r.is_finite() then Ok(Real(r)) else real_refused(r, s"$name(${render(a)})")

// A double as the answer of `a name b`, likewise.
private real_of2(r: real, name: string, a: Value, b: Value) -> Result[Value, Fault] =
    if r.is_finite() then Ok(Real(r)) else real_refused(r, s"${render(a)} $name ${render(b)}")

private real_refused(r: real, what: string) -> Result[Value, Fault] =
    num_result(prolog_policy().admit(Number.Real(r)), what, Real(r))

// A big integer as an answer, demoted to 64 bits where it fits; with big integers on, the policy
// refuses none.
private of_big(n: BigInt) -> Result[Value, Fault] = num_result(prolog_policy().of_big(n), "a big integer", Undefined)

// An integer operand of an integer-only function, as a big integer: `type_error(integer, X)` for
// anything else.
private whole(a: Value, name: string) -> Result[BigInt, Fault] = n_of(a) match
    Number.Int(n) -> Ok(big.from_int(n))
    Number.Big(n) -> Ok(n)
    _ -> Err(type_error("integer", a, s"$name wants integers, and was given ${described(a)}"))

// `integer`, `round`, `truncate`, `ceiling` and `floor`: the integer a number rounds to. An integer
// is its own; a rational is rounded exactly; a float that is infinite or not a number has none.
private rounded(name: string, a: Value) -> Result[Value, Fault]
    a match
        Real(r) ->
            var f = r.round()

            if name == "truncate"
                f = r.trunc()
            elif name == "ceiling"
                f = r.ceil()
            elif name == "floor"
                f = r.floor()

            // A finite double whose magnitude is below 2^63 is a 64-bit integer already.
            if f > -9.2e18 && f < 9.2e18 then return Ok(Int(long(f)))

            big.from_real(f) match
                Some(n) -> of_big(n)
                None -> Err(evaluation_error("undefined", s"$name(${render(a)}) has no integer value"))
        Rat(_) ->
            val what = s"$name(${render(a)})"

            // Over a rational, `funl()` divides without refusing a fraction, and `quot` and
            // `floor_div` by one are the truncation and the floor, exactly.
            val p = funl_policy()
            val n = n_of(a)
            val one = Number.Int(1)
            val half = p.div(one, Number.Int(2)).unwrap()

            if name == "truncate" then return num_result(p.quot(n, one), what, a)
            if name == "floor" then return num_result(p.floor_div(n, one), what, a)
            if name == "ceiling" then return num_result(p.neg(p.floor_div(p.neg(n).unwrap(), one).unwrap()), what, a)

            // `round` and `integer`: to the nearest integer, a half away from zero.
            if dal.sign(n) >= 0 then return num_result(p.floor_div(p.add(n, half).unwrap(), one), what, a)

            num_result(p.neg(p.floor_div(p.add(p.neg(n).unwrap(), half).unwrap(), one).unwrap()), what, a)
        _ -> Ok(a)

// `a` shifted left by `b` places, or right when `left` is off; a negative count shifts the other
// way, as SWI-Prolog reads one. A right shift rounds toward minus infinity, as in every Prolog, and a
// left shift that passes 64 bits grows into a big integer.
private shifted(a: Value, b: Value, left: bool) -> Result[Value, Fault]
    val name = if left then "<<" else ">>"

    val count: long = b match
        Int(k) -> k
        Big(p) -> if dal.sign(p.n) < 0 then -67108865 else 67108865
        _ -> return Err(type_error("integer", b, s"a shift counts in integers, and was given ${described(b)}"))

    // A count past 2^26 places: a right shift that far leaves only the sign, and a left one would
    // need more bits than a number may have.
    if count > 67108864 || count < -67108864
        val n = whole(a, name)?

        if n.is_zero() then return Ok(Int(0))

        if (count > 0) == left then return Err(resource_error("memory", s"${render(a)} $name ${render(b)} would need more than 2^26 bits"))

        return Ok(Int(if n.sign() < 0 then -1 else 0))

    val by = if left then count else -count

    a match
        Int(x) ->
            if by <= 0
                val places = if by < -63 then 63 else -by

                return Ok(Int(x >> places))

            if x == 0 then return Ok(Int(0))

            if by <= 62
                val r = x << by

                if (r >> by) == x then return Ok(Int(r))
        _ -> ()

    val n = whole(a, name)?

    if by >= 0 then of_big(big.shl(n, usize(by))) else of_big(big.shr(n, usize(-by)))
end shifted

// `X is E`.
private pl_is(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val n = eval(arg(base, 1))?

    Ok(if unify(arg(base, 0), n) then Gives(Unit) else Refuses)

// A comparison of two expressions' values, succeeding when `holds` says the order is right. An
// integer compared with a float is converted to a float, as ISO has it and GNU Prolog and SWI-Prolog
// do, so `9007199254740993 =:= 9007199254740992.0`; an integer too large for a float is compared
// exactly, as in SWI-Prolog. A NaN is in no order, compared as 2.
private compared(base: usize, holds: int -> bool) -> Result[Answer, Fault]
    val a = eval(arg(base, 0))?
    val b = eval(arg(base, 1))?

    val o: int = (a, b) match
        (Int(x), Int(y)) -> if x < y then -1 elif x > y then 1 else 0
        _ ->
            if is_float(a) && is_int(b) then by_float(a, b)
            elif is_int(a) && is_float(b) then by_float(a, b)
            else dal.compare(n_of(a), n_of(b)).unwrap_or(2)

    Ok(if holds(o) then Gives(Unit) else Refuses)

// The order of `a` and `b`, one an integer and the other a float, the integer taken as a float when
// it is in a float's range.
private by_float(a: Value, b: Value) -> int
    val x = dal.to_real(n_of(a))
    val y = dal.to_real(n_of(b))

    if x.is_infinite() || y.is_infinite() then return dal.compare(n_of(a), n_of(b)).unwrap_or(2)
    if x.is_nan() || y.is_nan() then return 2

    if x < y then -1 elif x > y then 1 else 0

// An argument that must be an integer, or unbound when `open`: the integer, or `None` for unbound.
private int_arg(x: Value, who: string, open: bool) -> Result[Option[long], Fault]
    deref(x) match
        Int(n) -> Ok(Some(n))
        Big(_) -> Err(representation_error("max_integer", s"$who counts in 64-bit integers"))
        Var(_) ->
            if open then return Ok(None)

            Err(instantiation_error(s"instantiation error: $who was given an unbound variable where it wants an integer"))
        y -> Err(type_error("integer", y, s"$who wants an integer, and was given ${described(y)}"))

private natural(n: long, who: string) -> Result[unit, Fault]
    if n < 0 then return Err(domain_error("not_less_than_zero", Int(n), s"$who wants a natural number, and was given $n"))

    Ok(())

// A sum or a difference past 64 bits, as the big integer it is.
private grown(a: long, b: long, minus: bool) -> Result[Value, Fault]
    val p = prolog_policy()

    if minus then return num_result(p.sub(Number.Int(a), Number.Int(b)), s"$a - $b", Undefined)

    num_result(p.add(Number.Int(a), Number.Int(b)), s"$a + $b", Undefined)

// `succ(X, Y)`: `Y` is `X + 1`, both natural numbers.
private pl_succ(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val x = int_arg(arg(base, 0), "succ/2", true)?
    val y = int_arg(arg(base, 1), "succ/2", true)?

    x match
        Some(n) ->
            natural(n, "succ/2")?
            y match
                Some(m) -> natural(m, "succ/2")?
                None -> ()

            val m = checked_add(n, 1) match
                Some(m) -> Int(m)
                None -> grown(n, 1, false)?

            Ok(if unify(arg(base, 1), m) then Gives(Unit) else Refuses)
        None -> y match
            Some(m) ->
                natural(m, "succ/2")?

                if m == 0 then return Ok(Refuses)

                Ok(if unify(arg(base, 0), Int(m - 1)) then Gives(Unit) else Refuses)
            None -> Err(instantiation_error("instantiation error: succ/2 wants one of its arguments bound"))

// `plus(X, Y, Z)`: `Z` is `X + Y`, any two of the three given.
private pl_plus(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val x = int_arg(arg(base, 0), "plus/3", true)?
    val y = int_arg(arg(base, 1), "plus/3", true)?
    val z = int_arg(arg(base, 2), "plus/3", true)?

    // Which argument is computed, and from which two: `p + q`, or `p - q` when `minus`.
    val (slot, p, q, minus) = x match
        Some(a) -> y match
            Some(b) -> (2, a, b, false)
            None -> z match
                Some(c) -> (1, c, a, true)
                None -> return Err(plus_unbound())
        None -> y match
            Some(b) -> z match
                Some(c) -> (0, c, b, true)
                None -> return Err(plus_unbound())
            None -> return Err(plus_unbound())

    val quick = if minus then checked_sub(p, q) else checked_add(p, q)

    val r = quick match
        Some(n) -> Int(n)
        None -> grown(p, q, minus)?

    Ok(if unify(arg(base, usize(slot)), r) then Gives(Unit) else Refuses)

private plus_unbound() -> Fault = instantiation_error("instantiation error: plus/3 wants two of its arguments bound")

// `between(L, H, X)`: `X` each integer from `L` to `H` in turn, `H` being `inf` or `infinite` for no
// end; with `X` given, whether it lies between them.
private pl_between(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val low = int_arg(arg(base, 0), "between/3", false)?.unwrap()

    val high: long = deref(arg(base, 1)) match
        Atom(id) ->
            val n = atom_name(id)

            if n != "inf" && n != "infinite" then return Err(type_error("integer", Atom(id), s"between/3 wants an integer or inf as its upper bound, and was given $n"))

            9223372036854775807
        h -> int_arg(h, "between/3", false)?.unwrap()

    int_arg(arg(base, 2), "between/3", true)? match
        Some(x) -> return Ok(if low <= x && x <= high then Gives(Unit) else Refuses)
        None -> ()

    val k = checked_add(low, cursor) match
        Some(k) -> k
        None -> return Ok(Refuses)

    if k > high then return Ok(Refuses)

    unify_on_answer(arg(base, 2), Int(k))
    Ok(if k == high then Gives(Unit) else GivesMore(Unit, cursor + 1))
end pl_between

// The Prolog evaluable function `name` of one number, for FunL's math builtins: one code path, so
// both languages round, refuse and fault alike -- but for the places where Prolog follows GNU Prolog
// and SWI-Prolog and FunL keeps its own meaning: the logarithm of 0, and `atanh` of 1 or -1, have no
// value in FunL, where Prolog raises `float_overflow`.
math_unary(name: string, a: Value) -> Result[Value, Fault]
    val r = dal.to_real(n_of(a))

    if (name == "log" || name == "log2") && r == 0.0
        return Err(evaluation_error("undefined", s"$name(${render(a)}) has no value"))

    if name == "atanh" && (r == 1.0 || r == -1.0)
        return Err(evaluation_error("undefined", s"atanh(${render(a)}) has no value"))

    unary(name, a)

// The Prolog evaluable function `name` of two numbers -- but FunL's `atan(0, 0)` has no value, where
// Prolog's is `0.0`, and its `copysign` is always a float, where Prolog keeps an integer an integer.
math_binary(name: string, a: Value, b: Value) -> Result[Value, Fault]
    if (name == "atan2" || name == "atan") && dal.to_real(n_of(a)) == 0.0 && dal.to_real(n_of(b)) == 0.0
        return Err(evaluation_error("undefined", s"$name(0, 0) has no value"))

    if name == "copysign" then return real_of2(dal.to_real(n_of(a)).copysign(dal.to_real(n_of(b))), name, a, b)

    binary(name, a, b)

// The value of the evaluable atom `name` (`pi`, `e`, `epsilon`).
math_constant(name: string) -> Result[Value, Fault] = constant(name)
