module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{canonicalize, read_text}
import sysl.path.{join, normalize, parent}
import sysl.text.{Search, split, str_builder}

// Modules (`modules.md`): a file is a module, and what another file can see is what it writes
// `export` in front of.
//
// **Imports are resolved before anything runs.** An importer's `import` lines are worked through
// before its resolver starts: each FunL file is parsed, resolved and compiled first, its top level a
// call the importer's top level makes before its own statements, so the importer's resolver sees the
// module's export list. **A module is instantiated once per machine**: the first file to import it
// compiles it and runs its top level, and every later import shares what that made.
//
// **A module is an immutable map from export name to value**, taken when its top level finishes: a
// snapshot, so an `export var` the module changes afterwards is not seen changing from outside. The
// snapshot is kept in slots of the module's own top-level frame -- one per exported variable, and one
// for the map `import * as` names -- so it is rooted as that frame is.
//
// **A relation is not a value**, so it is not in the map. A qualified call `m.r(...)` is resolved by
// the compiler against the export list instead, and is the static call, first-argument index and
// all, that calling `r` in its own file is.

// No slot: a module with no frame of its own to keep a map in.
const NoMap: usize = 4294967295

// What one exported name is.
enum ExportKind
    ExFunction(chunk: usize, arity: usize)
    ExRelation(chunk: usize, arity: usize)

    // A `val` or a `var`: the slot of the module's frame its snapshot is kept in.
    ExValue(slot: usize)

    // A `data` constructor, indexing `Vm.ctors`, and every constructor of its name the module's top
    // level declares (`id` among them), each with its own number of fields: the name exports them
    // all.
    ExCtor(id: usize, kin: Buf[usize])

    // A `data` type's name, indexing `Vm.data_types`: what `is` tests in a file that imports it.
    ExType(id: usize)

    // A builtin, as a module of FunL's own gives it.
    ExNative(id: usize)

// One exported name.
struct ModExport
    name: string
    kind: ExportKind

    // A relation's or a function's definition named for a person, for a clash Prolog reports.
    what: string

// A module the machine has loaded, or is loading.
struct FunlModule
    // Its path, as the import resolved it; `funl:name` for one of FunL's own.
    file: string

    // What a call or a closure names its top level's frame by: `file_up(m)`.
    up: usize

    // False while it is being compiled: an import of it then closes a circle.
    loaded: bool

    exports: Buf[ModExport]

    // The slot of its frame holding the map `import * as` names, or `NoMap`.
    map_slot: usize

    // The chunk running its top level.
    chunk: usize

    // Whether its relations and functions are Prolog predicates yet: a Prolog file's `:- import`
    // makes them so, the first time.
    in_prolog: bool

// What compiling a module made: its exports, the copies its top level ends by taking -- each
// exported variable's slot into its snapshot's -- and the slot of the map.
struct ModuleOut
    exports: Buf[ModExport]
    copy_from: Buf[usize]
    copy_to: Buf[usize]
    map_slot: usize
    chunk: usize

// One module of FunL's own, `funl:name`: what it exports.
struct ModuleProvider
    name: string
    exports: &Fn() -> Buf[ModExport]

// The modules of FunL's own, by name: each a list of natives registered under prefixed names
// (`fs.read_file`) and exported under the short ones.
builtin_modules() -> Buf[ModuleProvider]
    var out: Buf[ModuleProvider] = buf()

    out.push(ModuleProvider("fs", fs_exports))
    out.push(ModuleProvider("process", process_exports))
    out.push(ModuleProvider("json", json_exports))
    out.push(ModuleProvider("sqlite", sqlite_exports))
    out.push(ModuleProvider("time", time_exports))
    out.push(ModuleProvider("async", async_exports))
#if feature_http
    out.push(ModuleProvider("http", http_exports))
#endif
    out

// The provider of `funl:name`, if FunL has one.
builtin_module(name: string) -> Option[ModuleProvider]
    for p in builtin_modules().view()
        if p.name == name then return Some(p)

    None

// What an import of `funl:name` is told when this build has no such module.
unknown_builtin(name: string) -> string = left_out_module(name).unwrap_or(s"unknown module `funl:$name`")

// Why `funl:name` is not in this build, when it is a module behind a feature this build left off: the
// diagnostic names the feature (`modules.md` § "Features keep the core link line short"), rather than
// reading as a misspelling of a line that is right.
left_out_module(name: string) -> Option[string]
#if !feature_http
    if name == "http" then return Some("`funl:http` is not in this build -- it is behind the `http` feature, so build with `--features http`")
#endif
    None

// Why module `file` has no export `name` in this build, when it is one behind a feature this build
// left off: `funl:async`'s promise-shaped I/O is behind `async`, and its `fetch` behind `http` as
// well. The module is there, so the diagnostic names the export and its feature rather than calling
// the name a misspelling. Not `private`: a qualified `a.read_file` is refused through it too.
left_out_export(file: string, name: string) -> Option[string]
    if file != "funl:async" then return None

    val io = name == "read_file" || name == "write_file" || name == "run"
    val net = name == "fetch"

    if !io && !net then return None

    var missing: Buf[string] = buf()

#if !feature_async
    missing.push("async")
#endif
#if !feature_http
    if net then missing.push("http")
#endif

    if missing.is_empty() then return None

    val said = s"`$name` of `funl:async` is not in this build"

    if missing.len() == 1
        val f = missing.at(0)

        return Some(s"$said -- it is behind the `$f` feature, so build with `--features $f`")

    Some(s"$said -- it is behind the `async` and `http` features, so build with `--features async,http`")

// One name an import declares: what the importer calls it, where, and what module export it is.
struct Binding
    local: string
    at: Span

    // The module, as an index into `Vm.modules`.
    source: usize
    export: ModExport

// `import * as alias`.
struct AliasBinding
    alias: string
    at: Span
    source: usize

// What a file's `import` lines come to: the chunks its top level calls first -- each Prolog file's
// directives and each FunL module's top level loaded for it -- and the names they declare.
struct Imports
    loads: Buf[usize]
    names: Buf[Binding]
    aliases: Buf[AliasBinding]

// How a module was found: its index in `Vm.modules`, and whether this import loaded it, so its top
// level is this importer's to run.
struct ModLoad
    index: usize
    fresh: bool

// The path an import names, read relative to the directory of the file `from`.
module_path(from: string, given: string) -> string = parent(from) match
    Some(dir) -> join(dir, given)
    None -> given

// Whether two paths name one file. **A file is known by its real path**, which the filesystem gives:
// `a/./b.funl`, `../a/b.funl` from inside `a`, and a symbolic link to `a/b.funl` are all the same
// module. A path naming nothing, or a name that is not a file at all (a test's program), is known by
// its text, `.` and `..` resolved.
same_file(a: string, b: string) -> bool = file_key(a) == file_key(b)

private file_key(file: string) -> string = canonicalize(file) match
    Ok(real) -> real
    Err(_) -> normalize(file)

// Whether `file` names a FunL module.
private is_funl_file(file: string) -> bool = file.ends_with(".funl") || file.ends_with(".lfunl")

// Every `import` line of `prog`, the program in `src`: each Prolog file loaded and each FunL module
// loaded, and every name they bring, or the refusals in `report`.
imports_of(src: Source, prog: Program, report: *Report) -> Imports
    var out = Imports(buf(), buf(), buf())

    // The prelude first: every file sees it, and the file that loads it runs its top level.
    load_prelude() match
        Some(chunk) -> out.loads.push(chunk)
        None -> ()

    for i in prog.imports.view()
        i.spec match
            PathSpec(given) ->
                if given.ends_with(".pl")
                    i.form match
                        WholeForm ->
                            imported(src, Spanned(given, i.at), report) match
                                Some(chunk) -> out.loads.push(chunk)
                                None -> ()
                        _ ->
                            report.add(error(i.at, s"a Prolog file has no exports to choose from")
                                .with_note(s"a Prolog file is imported whole, every predicate it defines with it: `import \"$given\"`"))
                elif is_funl_file(given)
                    val file = module_path(src.name, given)

                    load_module(file, i.at, report) match
                        Ok(l) ->
                            if l.fresh then out.loads.push(current().modules.at(l.index).chunk)

                            bind(&out, l.index, given, i.form, report)
                        Err(_) -> ()
                else
                    report.add(error(i.at, s"`$given` is neither a FunL module nor a Prolog file")
                        .with_note("a FunL module is a `.funl` or `.lfunl` file, and a Prolog file a `.pl` file"))
            PackageSpec(name) ->
                if is_funl_file(name) || name.ends_with(".pl")
                    report.add(error(i.at, s"unknown module `$name`").with_note(s"a file is imported by a quoted path: `\"$name\"`"))
                elif name.index_of(".").is_some()
                    report.add(error(i.at, s"unknown module `$name`")
                        .with_note(s"a package's other module is written with a slash: `${dots_to_slash(name)}`"))
                else
                    resolve_package(src.name, name, i.at, report) match
                        Some(FunlTarget(file)) ->
                            load_module(file, i.at, report) match
                                Ok(l) ->
                                    if l.fresh then out.loads.push(current().modules.at(l.index).chunk)

                                    bind(&out, l.index, name, i.form, report)
                                Err(_) -> ()
                        Some(PlTarget(file)) ->
                            i.form match
                                WholeForm ->
                                    imported_file(file, i.at, report) match
                                        Some(chunk) -> out.loads.push(chunk)
                                        None -> ()
                                _ ->
                                    report.add(error(i.at, s"`$name` is a Prolog file, which has no exports to choose from")
                                        .with_note(s"a Prolog file is imported whole, every predicate it defines with it: `import $name`"))
                        None -> ()
            BuiltinSpec(name) ->
                if name == "prelude"
                    prelude_index() match
                        Some(index) -> bind(&out, index, "funl:prelude", i.form, report)
                        None -> report.add(error(i.at, "`funl:prelude` is not loaded while it is being compiled"))

                    continue

                builtin_module(name) match
                    Some(p) -> bind(&out, provided(p), s"funl:$name", i.form, report)
                    None -> report.add(error(i.at, unknown_builtin(name)))

    out
end imports_of

// `tabular.pivot` as it is written: `tabular/pivot`.
private dots_to_slash(name: string) -> string
    var out = ""

    for part in split(name, ".")
        out = if out == "" then part else s"$out/$part"

    out

// Module `funl:name`, from its provider: registered once, and found again after.
private provided(p: ModuleProvider) -> usize
    val v = current()
    val file = s"funl:${p.name}"

    for i in 0..<v.modules.len()
        if v.modules.at(i).file == file then return i

    v.modules.push(FunlModule(file, TopUp, true, p.exports(), NoMap, 0, false))
    v.modules.len() - 1

// The names `form` takes from module `index`, which the import wrote as `given`.
private bind(out: *Imports, index: usize, given: string, form: ImportForm, report: *Report)
    val md = current().modules.at(index)

    form match
        WholeForm -> ()
        StarForm(alias) -> out.aliases.push(AliasBinding(alias.value, alias.span, index))
        NamedForm(names) ->
            for n in names.view()
                exported_as(md, n.name) match
                    Some(_) ->
                        // Every arity of the name comes in.
                        for x in md.exports.view()
                            if x.name == n.name then out.names.push(Binding(n.local, n.at, index, x))
                    None ->
                        left_out_export(md.file, n.name) match
                            Some(m) -> report.add(error(n.at, m))
                            None -> report.add(error(n.at, s"`$given` does not export `${n.name}`").with_note(exports_text(md)))

// The export of `md` named `name`.
private exported_as(md: FunlModule, name: string) -> Option[ModExport]
    for x in md.exports.view()
        if x.name == name then return Some(x)

    None

// What `md` does export, for the reader who asked for something else.
private exports_text(md: FunlModule) -> string
    if md.exports.len() == 0 then return "it exports nothing: a name is exported by writing `export` before its `def`, `val`, `var` or `data`"

    var out = str_builder()

    out.push("it exports ")

    for i in 0..<md.exports.len()
        if i > 0 then out.push(", ")

        out.push(s"`${md.exports.at(i).name}`")

    out.finish()

// Load the FunL module in `file`, the import naming it written at `at`: found again if it is loaded,
// and otherwise read, compiled and registered, its top level not yet run. A refusal is reported at
// `at`, with what the module's own file says about it drawn against that file.
load_module(file: string, at: Span, report: *Report) -> Result[ModLoad, Refusal]
    val v = current()

    for i in 0..<v.modules.len()
        val md = v.modules.at(i)

        if md.loaded && same_file(md.file, file) then return Ok(ModLoad(i, false))

    for f in v.loading.view()
        if same_file(f, file)
            report.add(error(at, s"${circle(file)} -- a file cannot import something that is waiting for it, so one of the two has to give up what it needs from the other"))
            return Err(Unreadable)

    val text = read_text(file) match
        Ok(t) -> t
        Err(e) ->
            report.add(error(at, s"`$file` cannot be read: $e"))
            return Err(Missing(file))

    module_from_text(file, text, at, report)
end load_module

// The FunL module `file`, whose source is `text`, compiled and registered, its top level not yet run;
// a refusal reported at `at`, with what the module's own text says about it.
module_from_text(file: string, text: string, at: Span, report: *Report) -> Result[ModLoad, Refusal]
    val v = current()
    val doc = source_of(file, text)

    // A `.lfunl` file is tangled first; a document refused is a file that cannot be compiled.
    val fl = funl_source(doc) match
        Ok(s) -> s
        Err(d) ->
            report.add(error(at, s"`$file` could not be loaded").with_note(d.render(doc)))
            return Err(Unreadable)

    val m = v.funl_tops.len()
    val mark = load_mark()
    val index = v.modules.len()

    v.funl_tops.push(null)
    v.modules.push(FunlModule(file, file_up(m), false, buf(), NoMap, 0, false))
    v.loading.push(file)

    var inner = full_report()
    val made = compile_module(fl, file_up(m), &inner)

    v.loading.pop()

    made match
        Ok(out) ->
            var md = v.modules.at(index)

            md.loaded = true
            md.exports = out.exports
            md.map_slot = out.map_slot
            md.chunk = out.chunk
            v.modules.set(index, md)
            Ok(ModLoad(index, true))
        Err(r) ->
            forget_since(mark)
            report.add(error(at, s"`$file` could not be loaded").with_note(render_report(inner, doc, fl)))
            Err(r)
end module_from_text

// How many FunL modules and imported Prolog files are loaded, so what a refused file brought can be
// forgotten again.
struct LoadMark
    modules: usize
    pl_imports: usize

load_mark() -> LoadMark = LoadMark(current().modules.len(), current().pl_imports.len())

// Forget every module and imported Prolog file loaded since `mark`: their top levels and directives
// will never run, so an import of one loads it again.
forget_since(mark: LoadMark)
    val v = current()

    while v.modules.len() > mark.modules
        v.modules.pop()

    while v.pl_imports.len() > mark.pl_imports
        v.pl_imports.pop()

// The circle an import of `file` closes, written out so the reader knows which files are in it.
private circle(file: string) -> string
    val chain = current().loading
    var from: usize = 0

    for i in 0..<chain.len()
        if same_file(chain.at(i), file) then from = i

    var out = str_builder()

    out.push("this import closes a circle: ")

    for i in from..<chain.len()
        out.push(s"`${chain.at(i)}` imports ")

    out.push(s"`$file`")
    out.finish()

// The names `im` binds, made top-level names of the file `res` resolves: each refused where the file
// defines it too, or where two imports take it.
bind_imports(res: *Resolved, im: Imports, report: *Report)
    for i in 0..<im.names.len()
        val b = im.names.at(i)

        // Another arity of the name the binding before it took, from the same import, joins it.
        val again = i > 0 && same_import(im.names.at(i - 1), b)

        if again
            export_meaning(res, current().modules.at(b.source), b.export) match
                Some(m) -> res.imported.put(b.local, with_member(b.local, res.imported.get(b.local), m))
                None -> ()

            continue

        if !free_to_import(res, b.local, b.at, current().modules.at(b.source).file, report) then continue

        b.export.kind match
            ExType(id) ->
                res.imported_types.put(b.local, id)
                continue
            ExCtor(_, kin) -> see_kin(res, b.local, kin)
            _ -> ()

        export_meaning(res, current().modules.at(b.source), b.export) match
            Some(m) -> res.imported.put(b.local, m)
            None -> ()

    for a in im.aliases.view()
        val md = current().modules.at(a.source)

        if !free_to_import(res, a.alias, a.at, md.file, report) then continue

        if md.map_slot != NoMap then res.imported.put(a.alias, Local(md.up, md.map_slot, true))

        res.aliases.put(a.alias, a.source)

        for x in md.exports.view()
            x.kind match
                ExType(id) -> res.imported_types.put(s"${a.alias}.${x.name}", id)
                ExCtor(_, kin) -> see_kin(res, s"${a.alias}.${x.name}", kin)
                _ -> ()

            // A name exported at several arities is the family of them.
            val q = s"${a.alias}.${x.name}"

            export_meaning(res, md, x) match
                Some(m) -> res.qualified.put(q, with_member(q, res.qualified.get(q), m))
                None -> ()
end bind_imports

// Whether bindings `a` and `b` are two arities of one name one import brought.
private same_import(a: Binding, b: Binding) -> bool
    a.local == b.local && a.source == b.source && a.export.name == b.export.name && a.at.start == b.at.start

// The constructors `kin` an exported name brings, seen in the file `res` resolves under `name`.
private see_kin(res: *Resolved, name: string, kin: Buf[usize])
    for id in kin.view()
        res.see_ctor(name, id, false)

// Whether the name `n` an import from `file` declares at `at` is free: not one the file defines, nor
// one another import has taken. The refusal is reported.
private free_to_import(res: *Resolved, n: string, at: Span, file: string, report: *Report) -> bool
    res.by_name.get(n) match
        Some(rs) ->
            report.add(error(res.rels.at(rs.at(0)).clauses.at(0).head, s"`$n` is imported from `$file`, and this file cannot also define it")
                .with_note("`as` renames what an import declares: `import { x as y } from ...`, `import * as m from ...`"))
            return false
        None -> ()

    if res.imported.get(n).is_some() || res.aliases.get(n).is_some() || res.imported_types.get(n).is_some()
        report.add(error(at, s"`$n` is imported twice"))
        return false

    true

// What export `x` of module `md` means to the file `res` resolves: a function or a relation is a
// definition of that file's whose chunk is already compiled, so calls to it are compiled as calls to
// one of the file's own. A type's name is no value; `bind_imports` records it for `is`.
private export_meaning(res: *Resolved, md: FunlModule, x: ModExport) -> Option[Meaning]
    x.kind match
        ExFunction(chunk, arity) -> Some(Function(foreign_rel(res, x.name, arity, chunk, true), md.up))
        ExRelation(chunk, arity) -> Some(Relation(foreign_rel(res, x.name, arity, chunk, false)))
        ExValue(slot) -> Some(Local(md.up, slot, true))
        ExCtor(id, _) -> Some(Constructor(id))
        ExNative(id) -> Some(Builtin(id))
        ExType(_) -> None

// A definition another file compiled: no clauses, so nothing resolves or compiles it again.
private foreign_rel(res: *Resolved, name: string, arity: usize, chunk: usize, function: bool) -> usize
    res.rels.push(Rel(name, arity, buf(), chunk, function, NoScope, 0, buf()))
    res.rels.len() - 1

// When `g.name` is a qualified name -- `g` a module `import * as` brought in, `gm` what `g` means
// where it is written -- what `name` means in that module: `Unknown` when the module does not
// export it. `None` when `g` is anything else, so `g.name` is a field.
qualified_name(res: *Resolved, g: string, gm: Meaning, name: string) -> Option[Meaning]
    val index = res.aliases.get(g) match
        Some(i) -> i
        None -> return None

    val md = current().modules.at(index)

    val same = gm match
        Local(d, s, _) -> md.map_slot != NoMap && d == md.up && s == md.map_slot
        Unknown -> md.map_slot == NoMap
        _ -> false

    if !same then return None

    res.qualified.get(s"$g.$name") match
        Some(m) -> Some(m)
        None -> Some(Unknown)

// The refusal of `g.name`, which module alias `g` does not export.
not_exported(res: *Resolved, g: string, name: string, at: Span) -> Diagnostic
    val md = current().modules.at(res.aliases.get(g).unwrap())

    left_out_export(md.file, name) match
        Some(m) -> return error(at, m)
        None -> ()

    error(at, s"`${md.file}` does not export `$name`").with_note(exports_text(md))

// What `g.name` means in a relation's head, `g` a module `import * as` brought in: there a name is a
// clause variable or a module, and a clause variable has no fields, so `g` is the module whenever an
// import names it. `None` when no import does.
qualified_in_head(res: *Resolved, g: string, name: string) -> Option[Meaning]
    if res.aliases.get(g).is_none() then return None

    res.qualified.get(s"$g.$name") match
        Some(m) -> Some(m)
        None -> Some(Unknown)

// Why the pattern `g.name(...)` -- `argc` fields, or `None` for the bare `g.name` -- cannot match,
// `g.name` meaning `m`: a pattern names a constructor the module exports, with as many fields as it
// has. `None` when it can.
qualified_pattern_refusal(res: *Resolved, g: string, name: string, m: Meaning, argc: Option[usize], at: Span) -> Option[Diagnostic]
    m match
        Unknown -> Some(not_exported(res, g, name, at))
        _ -> pattern_refusal(res, s"$g.$name", m, argc, at)

// Why the pattern `n(...)` -- `argc` fields, or `None` for the bare `n` -- cannot match, `n` meaning
// `m`: outside a relation head, a pattern names a constructor in scope, with as many fields as it
// has, or a constructor of its name with as many that the file sees under `n`. `None` when it can.
// `n` is the name as the pattern writes it, qualified or not.
pattern_refusal(res: *Resolved, n: string, m: Meaning, argc: Option[usize], at: Span) -> Option[Diagnostic]
    m match
        Unknown ->
            Some(error(at, s"`$n` is not defined")
                .with_note("a term in a pattern is a constructor a `data` declares, in this file or imported"))
        Constructor(id) ->
            val fields = current().ctors.at(id).fields.len()

            argc match
                Some(k) ->
                    if res.ctor_of(n, id, k).is_some() then return None

                    Some(error(at, s"the constructor `$n` takes ${counted(fields, "field")}, and this pattern gives $k"))
                None ->
                    if fields == 0 then return None

                    Some(error(at, s"the constructor `$n` takes ${counted(fields, "field")}, and this pattern gives none")
                        .with_note(s"a pattern for it gives each field: `$n(...)`"))
        _ ->
            Some(error(at, s"`$n` is not a constructor, so a pattern cannot match it")
                .with_note("a term in a pattern is a constructor, as a `data` declares it"))

// The functor of the constructor `m` names, a pattern the resolver let through.
pattern_functor(m: Option[Meaning]) -> Result[u32, string] = m match
    Some(Constructor(id)) -> Ok(current().ctors.at(id).functor)
    _ -> Err("a qualified pattern the resolver refused reached the compiler")

// The exports of a module whose names `names` its `export` lines declare, resolved in `res`; the
// snapshot slots and the map slot are made in its top level's frame when it is a `module` -- a
// program's exports are checked and nothing more.
module_exports(res: *Resolved, names: Buf[Spanned[string]], snapshot: bool, report: *Report) -> ModuleOut
    var out = ModuleOut(buf(), buf(), buf(), NoMap, 0)
    var seen: Buf[string] = buf()
    var top = res.scopes.at(res.top)

    for named in names.view()
        val n = named.value
        var again = false

        for s in seen.view()
            if s == n then again = true

        if again then continue

        seen.push(n)

        // Every arity of the name is exported.
        res.by_name.get(n) match
            Some(rs) ->
                for i in rs.view()
                    val r = res.rels.at(i)
                    val at = located(res.src, r.clauses.at(0).head.start)

                    if r.function
                        out.exports.push(ModExport(n, ExFunction(r.chunk, r.arity), s"the FunL function `$n` at $at, which is `${pred_key(n, r.arity + 1)}` to Prolog"))
                    else
                        out.exports.push(ModExport(n, ExRelation(r.chunk, r.arity), s"the FunL relation `$n` at $at"))

                continue
            None -> ()

        top.find(0, n, Anywhere) match
            Some(d) ->
                top.ctors.get(d.slot) match
                    Some(id) ->
                        val kin = res.top_kin.get(n) match
                            Some(ids) -> ids
                            None -> buf()

                        out.exports.push(ModExport(n, ExCtor(id, kin), ""))
                    None ->
                        if snapshot
                            val snap = top.declare(0, s"export $n", named.span, Anywhere, true)

                            out.copy_from.push(d.slot)
                            out.copy_to.push(snap)
                            out.exports.push(ModExport(n, ExValue(snap), ""))

                continue
            None -> ()

        res.own_types.get(n) match
            Some(id) ->
                out.exports.push(ModExport(n, ExType(id), ""))
                continue
            None -> ()

        report.add(error(named.span, s"`$n` is exported, and nothing at the top level of this file defines it"))

    if snapshot then out.map_slot = top.declare(0, "export *", point(0), Anywhere, true)

    res.scopes.set(res.top, top)
    out
end module_exports

// `:- import("funl:name")`: module `name`'s exports made Prolog predicates qualified by the module,
// `name:f/(n+1)` for a function of `n` parameters, whose last argument is unified with each value it
// gives (`modules.md`, what Prolog sees). A module-qualified goal `fs:read_file(P, T)` calls one, so
// a built-in module takes no name out of Prolog's one namespace. Answers why the import is refused.
prolog_builtin_module(name: string, at: Span, report: *Report, why: Refusal) -> Refusal
    val p = builtin_module(name) match
        Some(p) -> p
        None ->
            val now = refusal(why, report, Unreadable)

            report.add(error(at, unknown_builtin(name)))
            return now

    for x in p.exports().view()
        val id = x.kind match
            ExNative(id) -> id
            _ -> continue

        native_predicates(name, x, id) match
            Ok(_) -> ()
            Err(m) ->
                val now = refusal(why, report, Unreadable)

                report.add(error(at, s"the compiler failed: $m"))
                return now

    why
end prolog_builtin_module

// Export `x` of built-in module `owner`, builtin `id`, made the predicates `owner:f/(n+1)`. A builtin
// whose trailing arguments are optional is one predicate per count it takes.
native_predicates(owner: string, x: ModExport, id: usize) -> Result[unit, string]
    val nat = current().natives.at(id)

    for arity in nat.least..nat.arity
        val key = pred_key(s"$owner:${x.name}", arity + 1)

        if pred_defined(key) then continue

        var e = emit(key)

        for k in 0..<arity
            e.op(LoadArg(k))

        if is_generator(id)
            e.op(PushInt(0))
            e.op(NativeGen(id, arity))
        else
            e.op(Native(id, arity))

        e.op(LoadArg(arity))
        e.op(Unify)
        e.op(Pop)
        e.op(PushUnit)
        e.op(Return)

        define_predicate(key, e, Origin(s"funl:$owner", x.what))?

    Ok(())

// The FunL module `index`'s relations and functions made Prolog predicates, for a Prolog file whose
// `:- import` of it is written at `at` (`prolog.md` § "Calling FunL from Prolog"): each export only,
// as a FunL importer sees them, and once. Answers why the import is refused, given `why` so far.
prolog_exports(index: usize, at: Span, report: *Report, why: Refusal) -> Refusal
    val v = current()
    var md = v.modules.at(index)

    if md.in_prolog then return why

    var now = why
    var refused = false

    for x in md.exports.view()
        var function = false
        var chunk: usize = 0
        var arity: usize = 0

        x.kind match
            ExFunction(c, a) ->
                function = true
                chunk = c
                arity = a
            ExRelation(c, a) ->
                chunk = c
                arity = a
            _ -> continue

        val n = if function then arity + 1 else arity
        val key = pred_key(x.name, n)

        if is_builtin(key) then continue

        val origin = Origin(md.file, x.what)

        clash(key, origin) match
            Some(m) ->
                now = refusal(now, report, Taken(x.name, n))
                refused = true
                report.add(error(at, m))
                continue
            None -> ()

        funl_predicate(key, x.name, chunk, arity, function, md.up, origin) match
            Ok(_) -> ()
            Err(e) ->
                now = refusal(now, report, Unreadable)
                refused = true
                report.add(error(at, s"the compiler failed: $e"))

    if !refused
        md.in_prolog = true
        v.modules.set(index, md)

    now
end prolog_exports
