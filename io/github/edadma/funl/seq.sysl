module io.github.edadma.funl

import sh.sysl.parsing.counted
import sysl.buf.{Buf, buf}
import sysl.math.{checked_add, checked_mul}
import sysl.text.{from_utf8_unchecked, is_char_boundary}

// Lists, ranges and sets as values: building them, taking them apart, and what the operators on
// them -- `+`, `in`, indexing, `.length` -- answer.
//
// **A range is read as a list wherever a list is read**: it is iterated, indexed, measured, matched
// by `h:t` and `[]`, and added to. Only one with an end can be made into a list; an endless range
// answers every question that does not need its last element.
//
// **Everything here may allocate**, which is safe because a collection runs only between
// instructions: a value held in a sysl local for the length of one instruction is never collected
// out from under it.

// -- ranges ------------------------------------------------------------------------------------------

// Whether `n` is beyond where range `r` stops.
range_past(r: *RangeObj, n: long) -> bool
    if r.endless then return false

    if r.step > 0 then return if r.inclusive then n > r.last else n >= r.last

    if r.inclusive then n < r.last else n <= r.last

range_empty(r: *RangeObj) -> bool = range_past(r, r.from)

// How many elements a range with an end has.
range_count(r: *RangeObj) -> long
    if range_empty(r) then return 0

    val span = if r.step > 0 then r.last - r.from else r.from - r.last
    val stride = if r.step > 0 then r.step else -r.step
    var n = span / stride + 1

    if !r.inclusive && span % stride == 0 then n -= 1

    n

// The range after its first element: empty when the next element would not fit in 64 bits.
range_rest(r: *RangeObj) -> Result[Value, string]
    checked_add(r.from, r.step) match
        Some(n) -> new_range(n, r.last, r.step, r.inclusive, r.endless)
        None -> new_range(r.from, r.from, 1, false, false)

// `MakeRange`: the step, the end unless `endless`, and the start on the stack become the range.
make_range(v: *Vm, inclusive: bool, endless: bool) -> Result[unit, string]
    val step = range_bound(pop_value(v)?, "step")?
    val last = if endless then 0 else range_bound(pop_value(v)?, "end")?
    val from = range_bound(pop_value(v)?, "start")?

    if step == 0 then return Err(s"a range from $from by 0 would never move: a step cannot be zero")

    v.stack.push(new_range(from, last, step, inclusive, endless)?)
    Ok(())

private range_bound(x: Value, what: string) -> Result[long, string]
    deref(x) match
        Int(n) -> Ok(n)
        Var(_) -> Err(s"instantiation error: a range's $what is an unbound variable")
        y -> Err(s"a range counts with integers, and its $what is ${described(y)}")

private pop_value(v: *Vm) -> Result[Value, string] = v.stack.pop() match
    Some(x) -> Ok(x)
    None -> Err("the operand stack is empty")

// -- lists ---------------------------------------------------------------------------------------------

// Whether `x` is read as a list: a list, or a range.
is_seq(x: Value) -> bool = deref(x) match
    Nil -> true
    Cons(_) -> true
    Range(_) -> true
    _ -> false

// Every element of `x` -- a proper list, or a range with an end -- pushed onto `out`, in order;
// `what` names the operation for a refusal.
elements(x: Value, what: string, out: *Buf[Value]) -> Result[unit, string]
    var at = deref(x)

    loop
        at match
            Nil -> return Ok(())
            Cons(p) ->
                out.push(p.head)
                at = deref(p.tail)
            Range(r) ->
                if r.endless then return Err(s"$what was given the endless range ${render(at)}, which has no last element")

                val n = range_count(r)
                var k = r.from

                for _ in 0..<n
                    out.push(Int(k))
                    k += r.step

                return Ok(())
            Var(_) -> return Err(s"instantiation error: $what reached an unbound tail of a list")
            y -> return Err(s"$what wants a list and reached ${described(y)}")

// The list of `items` in order, ending in `tail`.
list_of(items: *Buf[Value], tail: Value) -> Result[Value, string]
    var out = tail
    var i = items.len()

    while i > 0
        i -= 1
        out = new_cons(items.at(i), out)?

    Ok(out)

// `x` as a list: a list as it is, a range with an end made into one.
as_list(x: Value) -> Result[Value, string]
    deref(x) match
        Range(_) ->
            var items: Buf[Value] = buf()

            elements(x, "a list", &items)?
            list_of(&items, Nil)
        y -> Ok(y)

// `x + y` where `x` is a list or a range: `y`'s elements after `x`'s when `y` is one too, and `y`
// itself after them otherwise -- so `[] + [1]` is `[1]` and `l += x` adds `x` to the end of `l`.
// The result is a new list sharing `y` where `y` is a list.
list_add(x: Value, y: Value) -> Result[Value, string]
    var items: Buf[Value] = buf()

    elements(x, "'+'", &items)?

    val tail = if is_seq(y) then as_list(y)? else new_cons(y, Nil)?

    list_of(&items, tail)

// `MakeCons` reads a range as the list it is, so `0:1..3` is `[0, 1, 2, 3]`.
cons_tail(t: Value) -> Result[Value, string]
    deref(t) match
        Range(r) -> if r.endless then Ok(t) else as_list(t)
        _ -> Ok(t)

// `MatchCons`: a non-empty list or range on top becomes its rest and then its first element.
match_cons(v: *Vm) -> Result[bool, string]
    deref(pop_value(v)?) match
        Cons(p) ->
            v.stack.push(p.tail)
            v.stack.push(p.head)
            Ok(true)
        Range(r) ->
            if range_empty(r) then return Ok(false)

            v.stack.push(range_rest(r)?)
            v.stack.push(Int(r.from))
            Ok(true)
        Var(_) -> Err("instantiation error: a pattern `h:t` was given an unbound variable")
        _ -> Ok(false)

// `MatchNil`: whether the value on top, popped, is an empty list or range.
match_nil(v: *Vm) -> Result[bool, string]
    deref(pop_value(v)?) match
        Nil -> Ok(true)
        Range(r) -> Ok(range_empty(r))
        Var(_) -> Err("instantiation error: a pattern `[]` was given an unbound variable")
        _ -> Ok(false)

// -- membership, indexing and fields -------------------------------------------------------------------

// Whether collection `c` holds `x`.
member(x: Value, c: Value) -> Result[bool, string]
    var at = deref(c)

    loop
        at match
            Nil -> return Ok(false)
            Cons(p) ->
                if equal_values(x, p.head, "in")? then return Ok(true)

                at = deref(p.tail)
            Range(r) ->
                val n = deref(x) match
                    Int(n) -> n
                    Var(_) -> return Err("instantiation error: 'in' was given an unbound variable")
                    _ -> return Ok(false)

                if range_past(r, n) then return Ok(false)

                if r.step > 0 && n < r.from then return Ok(false)

                if r.step < 0 && n > r.from then return Ok(false)

                return Ok((n - r.from) % r.step == 0)
            Tuple(t) -> return within(x, t.items)
            Set(s) -> return within(x, s.items)
            Var(_) -> return Err("instantiation error: 'in' was given an unbound variable to look in")
            y -> return Err(s"'in' looks in a list, a range, a tuple or a set, and was given ${described(y)}")

private within(x: Value, items: Buf[Value]) -> Result[bool, string]
    for y in items.view()
        if equal_values(x, y, "in")? then return Ok(true)

    Ok(false)

// `c(i)`: element `i` of a list, a range, a tuple or a string, counting from 0.
element_at(c: Value, index: Value) -> Result[Value, string]
    val i = deref(index) match
        Int(n) -> n
        Var(_) -> return Err("instantiation error: an index is an unbound variable")
        y -> return Err(s"an index is an integer, and this one is ${described(y)}")

    val x = deref(c)

    val endless = x match
        Range(r) -> r.endless
        _ -> false

    val n = if endless then i + 1 else length_of(x)?

    if i < 0 || i >= n then return Err(s"index $i is out of range for ${described(x)}, which has ${counted(usize(n), "element")}")

    x match
        Cons(_) ->
            var at = x
            var k: long = 0

            loop
                at match
                    Cons(p) ->
                        if k == i then return Ok(p.head)

                        k += 1
                        at = deref(p.tail)
                    _ -> return Err("a list ended before its own length")
        Range(r) ->
            checked_mul(i, r.step) match
                Some(off) ->
                    checked_add(r.from, off) match
                        Some(e) -> Ok(Int(e))
                        None -> Err(s"element $i of ${render(x)} does not fit in 64 bits")
                None -> Err(s"element $i of ${render(x)} does not fit in 64 bits")
        Tuple(t) -> Ok(t.items.at(usize(i)))
        Str(p) ->
            val bytes = p.s.bytes
            var k: long = 0
            var start: usize = 0

            for b in 0..<bytes.len
                if !is_char_boundary(bytes[b]) then continue

                if k == i then start = b

                if k == i + 1
                    return new_str(from_utf8_unchecked(bytes[start..<b]))

                k += 1

            new_str(from_utf8_unchecked(bytes[start..<bytes.len]))
        _ -> Err(s"${described(x)} cannot be indexed")
end element_at

// How many elements a list, a range with an end, a tuple, a set or a string -- in characters -- has.
length_of(x: Value) -> Result[long, string]
    val c = deref(x)

    c match
        Nil -> Ok(0)
        Cons(_) ->
            var at = c
            var n: long = 0

            loop
                at match
                    Cons(p) ->
                        n += 1
                        at = deref(p.tail)
                    Nil -> return Ok(n)
                    Var(_) -> return Err("instantiation error: a list's length reached an unbound tail")
                    y -> return Err(s"a list's length reached a tail that is ${described(y)} rather than `[]`")
        Range(r) ->
            if r.endless then return Err(s"the range ${render(c)} has no end, and no length")

            Ok(range_count(r))
        Tuple(t) -> Ok(long(t.items.len()))
        Set(s) -> Ok(long(s.items.len()))
        Str(p) ->
            var n: long = 0

            for b in p.s.bytes
                if is_char_boundary(b) then n += 1

            Ok(n)
        Var(_) -> Err("instantiation error: a length was asked of an unbound variable")
        y -> Err(s"${described(y)} has no length")
end length_of

// `x.name`.
field_of(x: Value, name: u32) -> Result[Value, string]
    val n = atom_name(name)

    if n == "length" then return Ok(Int(length_of(x)?))

    Err(s"${described(x)} has no field '$n'")

// -- comprehensions ------------------------------------------------------------------------------------

// `Collect(slot)`: the value on top joins the list building in slot `slot`, newest first.
collect(v: *Vm, slot: usize) -> Result[unit, string]
    val x = pop_value(v)?
    val acc = slot_of(v.frame, slot)?

    set_slot(v.frame, slot, new_cons(x, acc)?)

// `Collected(slot, set)`: what slot `slot` collected, in the order it was collected, as a list or a
// set; the slot is emptied.
//
// **The list is reversed in place.** Its cells were made by `Collect` and are reachable only through
// the slot -- no choice point saved them, a slot not being an operand cell -- so turning them round
// costs no allocation, and a comprehension's result never needs twice its size in the heap.
collected(v: *Vm, slot: usize, set: bool) -> Result[unit, string]
    var at = slot_of(v.frame, slot)?
    var out = Nil

    set_slot(v.frame, slot, Undefined)?

    loop
        at match
            Cons(p) ->
                val next = p.tail

                p.tail = out
                out = at
                at = next
            _ -> break

    if !set
        v.stack.push(out)
        return Ok(())

    val s = new_set()?
    var items: Buf[Value] = buf()

    elements(out, "a comprehension", &items)?

    for x in items.view()
        set_add(s, x)?

    v.stack.push(Set(s))
    Ok(())

// Add `x` to set `s` unless it holds an equal value already.
set_add(s: *SetObj, x: Value) -> Result[unit, string]
    if within(x, s.items)? then return Ok(())

    s.items.push(x)
    current().allocated += sizeof(Value)
    Ok(())

// Whether two sets hold the same values.
same_set(p: *SetObj, q: *SetObj) -> Result[bool, string]
    if p.items.len() != q.items.len() then return Ok(false)

    for x in p.items.view()
        if !within(x, q.items)? then return Ok(false)

    Ok(true)

// Whether two ranges have the same elements.
same_range(p: *RangeObj, q: *RangeObj) -> bool
    if range_empty(p) || range_empty(q) then return range_empty(p) && range_empty(q)

    if p.from != q.from then return false

    if p.endless || q.endless then return p.endless && q.endless && p.step == q.step

    val n = range_count(p)

    n == range_count(q) && (n == 1 || p.step == q.step)

// Whether range `r` has the elements of list `l`, in order.
range_equals_list(r: *RangeObj, l: Value) -> Result[bool, string]
    var at = deref(l)
    var k = r.from

    loop
        if range_past(r, k) then return Ok(is_nil(at))

        at match
            Cons(p) ->
                deref(p.head) match
                    Int(m) -> if m != k then return Ok(false)
                    Var(_) -> return Err("instantiation error: '==' was given an unbound variable")
                    _ -> return Ok(false)

                at = deref(p.tail)
            _ -> return Ok(false)

        k = checked_add(k, r.step) match
            Some(n) -> n
            None -> return Ok(is_nil(at))
end range_equals_list

private is_nil(x: Value) -> bool = x match
    Nil -> true
    _ -> false
