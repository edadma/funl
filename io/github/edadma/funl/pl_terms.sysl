module io.github.edadma.funl

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// Prolog's builtins that inspect and build terms: the type tests, `functor/3`, `arg/3`, `=../2`,
// `copy_term/2`, `term_variables/2`, `compare/3`, `unify_with_occurs_check/2`, `acyclic_term/1`,
// `cyclic_term/1`, `subsumes_term/2`, `unifiable/3`, `?=/2`, `numbervars/3` and `numbervars/4`.
//
// **A list cell is the compound `'[|]'(H, T)`** to all of them, as in SWI-Prolog 7, where `'.'` is no
// longer the list functor; and a FunL tuple is the compound `tuple(...)` the term mapping makes it.

install_prolog_terms(v: *Vm)
    register_generator(v, "var/1", 1, (b, n, c) -> answer(is_unbound(arg(b, 0))))
    register_generator(v, "nonvar/1", 1, (b, n, c) -> answer(!is_unbound(arg(b, 0))))
    register_generator(v, "atom/1", 1, (b, n, c) -> answer(is_atom(arg(b, 0))))
    register_generator(v, "number/1", 1, (b, n, c) -> answer(is_num(deref(arg(b, 0)))))
    register_generator(v, "integer/1", 1, (b, n, c) -> answer(is_int(deref(arg(b, 0)))))
    register_generator(v, "float/1", 1, (b, n, c) -> answer(is_float(deref(arg(b, 0)))))
    register_generator(v, "rational/1", 1, (b, n, c) -> answer(is_rational(deref(arg(b, 0)))))
    register_generator(v, "string/1", 1, (b, n, c) -> answer(is_str_value(arg(b, 0))))
    register_generator(v, "atomic/1", 1, (b, n, c) -> answer(is_atomic(arg(b, 0))))
    register_generator(v, "compound/1", 1, (b, n, c) -> answer(compound_parts(arg(b, 0)).is_some()))
    register_generator(v, "callable/1", 1, (b, n, c) -> answer(is_atom(arg(b, 0)) || compound_parts(arg(b, 0)).is_some()))
    register_generator(v, "is_list/1", 1, (b, n, c) -> answer(is_proper_list(arg(b, 0))))
    register_generator(v, "ground/1", 1, (b, n, c) -> answer(variables_of(arg(b, 0), true).len() == 0))
    register_generator(v, "functor/3", 3, pl_functor)
    register_generator(v, "arg/3", 3, pl_arg)
    register_generator(v, "=../2", 2, pl_univ)
    register_generator(v, "copy_term/2", 2, pl_copy_term)
    register_generator(v, "term_variables/2", 2, pl_term_variables)
    register_generator(v, "compare/3", 3, pl_compare)
    register_generator(v, "unify_with_occurs_check/2", 2, (b, n, c) -> answer(unify_checked(arg(b, 0), arg(b, 1))))
    register_generator(v, "acyclic_term/1", 1, (b, n, c) -> answer(is_acyclic(arg(b, 0))))
    register_generator(v, "cyclic_term/1", 1, (b, n, c) -> answer(!is_acyclic(arg(b, 0))))
    register_generator(v, "subsumes_term/2", 2, (b, n, c) -> answer(subsumes(arg(b, 0), arg(b, 1))))
    register_generator(v, "unifiable/3", 3, pl_unifiable)
    register_generator(v, "?=/2", 2, (b, n, c) -> answer(decided(arg(b, 0), arg(b, 1))))
    register_generator(v, "numbervars/3", 3, pl_numbervars)
    register_generator(v, "numbervars/4", 4, pl_numbervars)

// -- What every Prolog builtin answers with --------------------------------------------------------

// Succeed or fail, binding nothing.
answer(yes: bool) -> Result[Answer, Fault] = Ok(if yes then Gives(Unit) else Refuses)

// Succeed when `a` and `b` unify.
unified(a: Value, b: Value) -> Result[Answer, Fault] = answer(unify(a, b))

is_unbound(x: Value) -> bool = deref(x) match
    Var(_) -> true
    _ -> false

// An atom, `[]` among them, as in SWI-Prolog 7.
is_atom(x: Value) -> bool = deref(x) match
    Atom(_) -> true
    Nil -> true
    _ -> false

private is_str_value(x: Value) -> bool = deref(x) match
    Str(_) -> true
    _ -> false

// Neither a variable nor a compound: a number, an atom, a string, and FunL's own constants and opaque
// values.
is_atomic(x: Value) -> bool = !is_unbound(x) && compound_parts(x).is_none()

// **A cyclic list is not a list**, as in SWI-Prolog: the walk keeps a second cursor that moves at half
// speed, and the two meeting is a cycle.
is_proper_list(x: Value) -> bool
    var at = deref(x)
    var slow = at
    var steps: usize = 0

    loop
        at match
            Nil -> return true
            Cons(p) -> at = deref(p.tail)
            _ -> return false

        steps += 1

        if steps % 2 == 0
            slow = slow match
                Cons(q) -> deref(q.tail)
                _ -> slow

            if node_of(slow) == node_of(at) && node_of(at) != 0 then return false

// The functor and arguments of a compound term: a compound, a list cell, a tuple.
compound_parts(x: Value) -> Option[(u32, Buf[Value])]
    var args: Buf[Value] = buf()

    deref(x) match
        Compound(c) ->
            for a in c.args.view()
                args.push(a)

            Some((c.functor, args))
        Cons(p) ->
            args.push(p.head)
            args.push(p.tail)
            Some((intern("[|]"), args))
        Tuple(t) ->
            for a in t.items.view()
                args.push(a)

            Some((intern("tuple"), args))
        _ -> None

// The term `name(args)`: a list cell for `'[|]'` of two, and otherwise a compound.
build_compound(name: u32, args: Buf[Value]) -> Result[Value, Fault]
    if args.len() == 2 && atom_name(name) == "[|]" then return Ok(new_cons(args.at(0), args.at(1))?)

    val c = new_compound(name, args.len())?

    for i in 0..<args.len()
        c.args.set(i, args.at(i))

    Ok(Compound(c))

// The atom or other atomic value an atomic `name` is, or a compound of it.
private atomic_name(x: Value) -> Option[u32] = deref(x) match
    Atom(id) -> Some(id)
    Nil -> Some(intern("[]"))
    _ -> None

// -- functor/3, arg/3, =../2 --------------------------------------------------------------------

// The most arguments `functor/3` and `=../2` will build a term with.
const MaxArity: long = 1048576

private pl_functor(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val t = arg(base, 0)

    compound_parts(t) match
        Some((f, args)) ->
            if !unify(arg(base, 1), Atom(f)) then return Ok(Refuses)

            return unified(arg(base, 2), Int(long(args.len())))
        None -> ()

    if !is_unbound(t)
        if !unify(arg(base, 1), t) then return Ok(Refuses)

        return unified(arg(base, 2), Int(0))

    val name = deref(arg(base, 1))
    val arity = deref(arg(base, 2))

    if is_unbound(name) then return Err(instantiation_error("instantiation error: functor/3 wants a name when its term is unbound"))

    val n = arity match
        Int(n) -> n
        Var(_) -> return Err(instantiation_error("instantiation error: functor/3 wants an arity when its term is unbound"))
        _ -> return Err(type_error("integer", arity, s"functor/3 wants an integer arity, and was given ${described(arity)}"))

    if n < 0 then return Err(domain_error("not_less_than_zero", arity, s"functor/3 wants an arity of 0 or more, and was given $n"))
    if n > MaxArity then return Err(representation_error("max_arity", s"functor/3 builds terms of at most $MaxArity arguments, and was asked for $n"))

    if compound_parts(name).is_some() then return Err(type_error("atomic", name, s"functor/3 wants an atomic name, and was given ${described(name)}"))

    if n == 0 then return unified(t, name)

    val f = atomic_name(name) match
        Some(f) -> f
        None -> return Err(type_error("atom", name, s"functor/3 names a compound by an atom, and was given ${described(name)}"))

    var args: Buf[Value] = buf()

    for i in 0..<n
        args.push(Var(new_var()?))

    unified(t, build_compound(f, args)?)
end pl_functor

// `arg(N, T, A)`: argument `N` of compound `T`, counting from 1.
private pl_arg(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val nth = deref(arg(base, 0))

    val n = nth match
        Int(n) -> n
        Var(_) -> return Err(instantiation_error("instantiation error: arg/3 was given an unbound variable as its position"))
        _ -> return Err(type_error("integer", nth, s"arg/3 wants an integer position, and was given ${described(nth)}"))

    val t = arg(base, 1)

    val args = compound_parts(t) match
        Some((_, args)) -> args
        None ->
            if is_unbound(t) then return Err(instantiation_error("instantiation error: arg/3 was given an unbound variable as its term"))

            return Err(type_error("compound", t, s"arg/3 wants a compound term, and was given ${described(t)}"))

    if n < 0 then return Err(domain_error("not_less_than_zero", nth, s"arg/3 wants a position of 0 or more, and was given $n"))

    if n < 1 || n > long(args.len()) then return Ok(Refuses)

    unified(arg(base, 2), args.at(usize(n - 1)))

// `T =.. L`: `L` is `[Name|Args]`.
private pl_univ(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val t = arg(base, 0)
    val l = arg(base, 1)

    compound_parts(t) match
        Some((f, args)) ->
            var items: Buf[Value] = buf()

            items.push(Atom(f))

            for a in args.view()
                items.push(a)

            return unified(l, list_of(&items, Nil)?)
        None -> ()

    if !is_unbound(t) then return unified(l, new_cons(t, Nil)?)

    val items = list_items(l, "=../2")?

    if items.len() == 0 then return Err(domain_error("non_empty_list", Nil, "=../2 wants a non-empty list, and was given []"))

    val head = deref(items.at(0))

    if is_unbound(head) then return Err(instantiation_error("instantiation error: =../2 was given a list whose name is an unbound variable"))

    if items.len() == 1
        if compound_parts(head).is_some() then return Err(type_error("atomic", head, s"=../2 wants an atomic name, and was given ${described(head)}"))

        return unified(t, head)

    // A name that is no atom, a compound among them, is `type_error(atom, H)` where arguments follow,
    // as GNU Prolog and SWI-Prolog raise it.
    val f = atomic_name(head) match
        Some(f) -> f
        None -> return Err(type_error("atom", head, s"=../2 names a compound by an atom, and was given ${described(head)}"))

    if long(items.len() - 1) > MaxArity then return Err(representation_error("max_arity", s"=../2 builds terms of at most $MaxArity arguments"))

    var args: Buf[Value] = buf()

    for i in 1..<items.len()
        args.push(items.at(i))

    unified(t, build_compound(f, args)?)
end pl_univ

// The elements of list `x`, which must be a proper list: an unbound tail is an instantiation error,
// any other end a type error.
list_items(x: Value, who: string) -> Result[Buf[Value], Fault]
    var items: Buf[Value] = buf()
    var at = deref(x)

    loop
        at match
            Nil -> return Ok(items)
            Cons(p) ->
                items.push(p.head)
                at = deref(p.tail)
            Var(_) -> return Err(instantiation_error(s"instantiation error: $who was given a list that ends in an unbound variable"))
            _ -> return Err(type_error("list", x, s"$who wants a list, and was given ${described(x)}"))

// Whether `x` could still become a list: a list, or one whose tail is unbound.
is_partial_list(x: Value) -> bool
    var at = deref(x)

    loop
        at match
            Nil -> return true
            Var(_) -> return true
            Cons(p) -> at = deref(p.tail)
            _ -> return false

// -- copy_term/2, term_variables/2, compare/3 ------------------------------------------------------

private pl_copy_term(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault] =
    unified(arg(base, 1), copy_term(arg(base, 0))?)

private pl_term_variables(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    var vars = variables_of(arg(base, 0), false)

    unified(arg(base, 1), list_of(&vars, Nil)?)

// The unbound variables of `x`, each once, in depth-first left-to-right order; with `first`, only the
// first one found, which is all `ground/1` needs to know.
variables_of(x: Value, first: bool) -> Buf[Value]
    var found: Buf[Value] = buf()
    var seen: Map[u64, bool] = map()
    var w = term_walk()
    var work: Buf[Value] = buf()

    work.push(x)

    while work.len() > 0
        val d = next_depth(&w)
        val y = deref(work.pop().unwrap())

        // A node gone into once has given up its variables; a cyclic term would give them for ever.
        if passed(&w, y, Undefined, d) then continue

        val before = work.len()

        y match
            Var(p) ->
                if seen.get(p.id).is_none()
                    seen.put(p.id, true)
                    found.push(y)

                    if first then return found
            _ ->
                compound_parts(y) match
                    Some((_, args)) ->
                        var i = args.len()

                        while i > 0
                            i -= 1
                            work.push(args.at(i))
                    None -> ()

        pushed(&w, work.len() - before, d, work.len())

    found
end variables_of

// How many times each unbound variable of `x` occurs, by its id, a node of a cyclic term counted once.
private variable_uses(x: Value) -> Map[u64, long]
    var uses: Map[u64, long] = map()
    var w = term_walk()
    var work: Buf[Value] = buf()

    work.push(x)

    while work.len() > 0
        val d = next_depth(&w)
        val y = deref(work.pop().unwrap())

        if passed(&w, y, Undefined, d) then continue

        val before = work.len()

        y match
            Var(p) -> uses.put(p.id, uses.get(p.id).unwrap_or(0) + 1)
            _ ->
                compound_parts(y) match
                    Some((_, args)) ->
                        var i = args.len()

                        while i > 0
                            i -= 1
                            work.push(args.at(i))
                    None -> ()

        pushed(&w, work.len() - before, d, work.len())

    uses
end variable_uses

// -- subsumes_term/2, unifiable/3, ?=/2, numbervars/3 ----------------------------------------------

// `subsumes_term(General, Specific)`: `Specific` is an instance of `General` -- they unify, binding no
// variable of `Specific`. Binds nothing either way.
//
// **The test is ISO's**: after the unification each variable of `Specific` is still an unbound
// variable, and no two of them are the same one, so `f(X, X)` does not subsume `f(Y, Z)`.
private subsumes(general: Value, specific: Value) -> bool
    val vars = variables_of(specific, false)
    val h = begin_trial()
    var ok = unify(general, specific)

    if ok
        var seen: Map[u64, bool] = map()

        for x in vars.view()
            deref(x) match
                Var(p) ->
                    if seen.get(p.id).is_some()
                        ok = false
                        break

                    seen.put(p.id, true)
                _ ->
                    ok = false
                    break

    end_trial(h)
    ok
end subsumes

// `unifiable(X, Y, Unifier)`: `X` and `Y` unify, and `Unifier` is the list of `Var = Value` bindings
// that unification makes. Binds nothing in `X` or `Y`.
//
// **The bindings are listed last made first**, as SWI-Prolog lists them: unification visits a
// compound's arguments left to right and binds the younger of two variables to the older, so
// `unifiable(f(X, Y), f(a, b), U)` gives `U = [Y=b, X=a]` and `unifiable(f(X, X), f(a, Y), U)` gives
// `U = [Y=a, X=a]`. A variable given as either term whole is bound to the other: `unifiable(X, Y, U)`
// gives `U = [X=Y]`.
private pl_unifiable(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val a = deref(arg(base, 0))
    val b = deref(arg(base, 1))
    var pairs: Buf[Value] = buf()

    if is_unbound(a) || is_unbound(b)
        val same = (a, b) match
            (Var(p), Var(q)) -> p == q
            _ -> false

        if !same
            var parts: Buf[Value] = buf()

            parts.push(if is_unbound(a) then a else b)
            parts.push(if is_unbound(a) then b else a)
            pairs.push(build_compound(intern("="), parts)?)

        return unified(arg(base, 2), list_of(&pairs, Nil)?)

    val (ok, bound) = trial_unify(a, b)

    if !ok then return answer(false)

    var i = bound.len()

    while i > 0
        i -= 1

        val (x, value) = bound.at(i)
        var parts: Buf[Value] = buf()

        parts.push(x)
        parts.push(value)
        pairs.push(build_compound(intern("="), parts)?)

    unified(arg(base, 2), list_of(&pairs, Nil)?)
end pl_unifiable

// `?=(A, B)`: whether `A` and `B` are decided -- identical, or unable to unify -- so that no binding
// could change whether they unify.
private decided(a: Value, b: Value) -> bool
    val (ok, bound) = trial_unify(a, b)

    !ok || bound.len() == 0

// `numbervars(Term, Start, End)`: bind each variable of `Term`, in depth-first left-to-right order, to
// `'$VAR'(N)`, `N` counting up from `Start`; `End` is the next number after the last one used. The
// writers that take `numbervars(true)` -- `print/1`, `writeq/1`, `write/1` -- show `'$VAR'(N)` as a
// variable name: `A`, ..., `Z`, `A1`, ...
//
// `numbervars(Term, Start, End, Options)` takes SWI-Prolog's options: `functor_name(F)` binds to
// `F(N)` instead of `'$VAR'(N)`; `singletons(true)` binds a variable that occurs once to `F('_')`,
// which uses up no number; and `attvar(bind|skip|error)` is checked and changes nothing, since a FunL
// variable has no attributes. Another option is passed over, and a later one wins over an earlier.
private pl_numbervars(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val who = if argc == 4 then "numbervars/4" else "numbervars/3"
    val start = deref(arg(base, 1))

    var n = start match
        Int(k) -> k
        Var(_) -> return Err(instantiation_error(s"instantiation error: $who was given an unbound variable as its start"))
        _ -> return Err(type_error("integer", start, s"$who wants an integer start, and was given ${described(start)}"))

    var functor = "$VAR"
    var singletons = false

    if argc == 4
        val opts = arg(base, 3)
        var at = deref(opts)

        loop
            at match
                Nil -> break
                Var(_) -> return Err(instantiation_error(s"instantiation error: $who was given options that are not yet a whole list"))
                Cons(p) ->
                    val o = deref(p.head)

                    o match
                        Var(_) -> return Err(instantiation_error(s"instantiation error: $who was given an unbound option"))
                        Compound(c) ->
                            if c.args.len() == 1
                                val name = atom_name(c.functor)
                                val x = deref(c.args.at(0))

                                if name == "functor_name" || name == "singletons" || name == "attvar"
                                    x match
                                        Var(_) -> return Err(instantiation_error(s"instantiation error: $who was given $name/1 with an unbound value"))
                                        _ -> ()

                                if name == "functor_name"
                                    x match
                                        Atom(id) -> functor = atom_name(id)
                                        _ -> return Err(type_error("atom", x, s"$who's functor_name/1 wants an atom, and was given ${described(x)}"))
                                elif name == "singletons"
                                    singletons = x match
                                        Atom(id) ->
                                            val b = atom_name(id)

                                            if b == "true" then true
                                            elif b == "false" then false
                                            else return Err(type_error("bool", x, s"$who's singletons/1 wants true or false, and was given $b"))
                                        _ -> return Err(type_error("bool", x, s"$who's singletons/1 wants true or false, and was given ${described(x)}"))
                                elif name == "attvar"
                                    val ok = x match
                                        Atom(id) -> atom_name(id) == "bind" || atom_name(id) == "skip" || atom_name(id) == "error"
                                        _ -> false

                                    if !ok then return Err(domain_error("numbervar_option", deref(opts), s"$who's attvar/1 is bind, skip or error, and was given ${render(x)}"))
                        _ -> ()

                    at = deref(p.tail)
                _ -> return Err(type_error("list", at, s"$who wants a list of options, and was given ${described(at)}"))

    val vars = variables_of(arg(base, 0), false)
    val uses = if singletons then variable_uses(arg(base, 0)) else map()

    for x in vars.view()
        var parts: Buf[Value] = buf()
        var once = false

        if singletons
            x match
                Var(p) -> once = uses.get(p.id).unwrap_or(0) == 1
                _ -> ()

        parts.push(if once then atom("_") else Int(n))

        if !unify(x, build_compound(intern(functor), parts)?) then return answer(false)

        if !once then n += 1

    unified(arg(base, 2), Int(n))
end pl_numbervars

// `compare(Order, A, B)`: `Order` is `<`, `=` or `>` as `A` stands to `B` in the standard order.
private pl_compare(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val given = deref(arg(base, 0))

    given match
        Var(_) -> ()
        Atom(id) ->
            val o = atom_name(id)

            if o != "<" && o != "=" && o != ">" then return Err(domain_error("order", given, s"compare/3's order is <, = or >, and was given $o"))
        _ -> return Err(type_error("atom", given, s"compare/3's order is an atom, and was given ${described(given)}"))

    val c = compare_terms(arg(base, 1), arg(base, 2))

    unified(given, atom(if c < 0 then "<" elif c > 0 then ">" else "="))
