module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.Search

// The resolver: what every name in a program means, decided before anything is compiled.
//
// **Scopes nest as frames do.** The top level is one scope; each clause of a function or a lambda is
// a scope whose parent is the scope the function was written in; a relation clause is a scope with
// no parent. A name is looked for in the scope it is written in, then in each parent -- every step
// one static link at run time -- then among the top-level definitions and the builtins.
//
// **Definitions are hoisted.** Every top-level clause joins the definition of its name before any
// body is read, so a rule may call one written after it; a `def` inside a body or a `where` joins
// its scope's functions before that scope's names are read. A definition is one kind or the other:
// facts and `:-` rules make a relation, function clauses a function, and a name with both is refused
// naming both clauses.
//
// **A function's body is resolved after the scope it was written in is complete**, so it sees every
// name that scope declares; the bodies wait in a queue, which the lambdas met along the way join.
//
// **Blocks nest inside a frame** (language.md § Assignment): a block of statements, a `(s; e)`
// sequence and a `for`'s bindings each declare names only their own code sees, from the end of the
// declaration on. A block's names are slots of the frame, so leaving a block costs nothing at run
// time; a name read after its block has ended is `Gone` and reads `undefined`.
//
// **In a relation, a name that is not otherwise in scope is a logic variable of the clause** --
// `logic.md`'s rule; a clause variable written once is warned about, unless its name starts with
// `_`. **Elsewhere a name must be declared** -- by `free`, `val`, `var`, an assignment, a parameter
// or a pattern -- before it is read.

// The parent of a scope that has none.
const NoScope: usize = 4294967295

// One definition: a relation, a named function, or a lambda.
struct Rel
    name: string
    arity: usize
    clauses: Buf[Clause]

    // The chunk it is compiled into.
    chunk: usize

    // Whether its clauses are function clauses.
    function: bool

    // The scope a function was written in; `NoScope` for a relation.
    outer: usize

    // The block of `outer` it was written in.
    outer_block: usize

    // The scope of each clause, once its clauses are resolved.
    scopes: Buf[usize]

// A source offset after every other: where a function nested in a scope looks its names up from,
// since its body runs after the scope's own code has declared every name it is going to.
const Anywhere: usize = 4294967295

// A name a block declares.
struct Decl
    slot: usize

    // The source offset from which the name is in scope: the end of what declares it.
    from: usize

    // Declared by `val` or a `where` binding, so nothing may assign it.
    fixed: bool

// A region of a frame's code with names of its own: the frame's root, every block of statements
// inside it, and each `for`'s bindings. A block's names are slots of the frame like any other; only
// what can see them is limited.
struct Block
    decls: Map[string, Decl]

    // The block around this one, or `NoScope` for the root.
    parent: usize

// The names of one frame's worth of code, numbered as slots of the frame.
struct Scope
    // The root block is the first.
    blocks: Buf[Block]

    // Each slot's name, at its declaration, in slot order.
    names: Buf[Spanned[string]]

    // How many times each name is written, for the singleton warning.
    uses: Map[string, usize]

    // Slots below this are bound by a relation clause's head; those from here up are made fresh
    // when the clause is entered.
    head: usize

    // The enclosing scope, or `NoScope`, and the block of it this scope's code was written in.
    parent: usize
    parent_block: usize

    // The functions a `def` or a `where` defines here, as indices into `Resolved.rels`.
    fns: Map[string, usize]

    // The slots a `data` declaration's constructors are declared in, and each one's constructor id.
    ctors: Map[usize, usize]

    count(self) -> usize = self.names.len()

    // What declaration `d` of this scope means, the scope `depth` static links up: a constructor, or a
    // variable.
    named(self, depth: usize, d: Decl) -> Meaning = self.ctors.get(d.slot) match
        Some(id) -> Constructor(id)
        None -> Local(depth, d.slot, d.fixed)

    // A new block inside block `parent`.
    open(*self, parent: usize) -> usize
        var decls: Map[string, Decl] = map()

        self.blocks.push(Block(decls, parent))
        self.blocks.len() - 1

    // One more occurrence of `name`, for the singleton warning.
    used(*self, name: string)
        val n = self.uses.get(name) match
            Some(k) -> k
            None -> 0

        self.uses.put(name, n + 1)

    // `name` declared by block `blk`, in scope from offset `from`: its slot, which is a new one unless
    // the block already declares the name.
    declare(*self, blk: usize, name: string, at: Span, from: usize, fixed: bool) -> usize
        var b = self.blocks.at(blk)

        b.decls.get(name) match
            Some(d) -> return d.slot
            None -> ()

        val s = self.names.len()

        self.names.push(Spanned(name, at))
        b.decls.put(name, Decl(s, from, fixed))
        self.blocks.set(blk, b)
        s
    end declare

    // A name of the root block, counted as an occurrence and made on its first: how a relation
    // clause's variables and a head's are numbered.
    note(*self, name: string, at: Span) -> usize
        self.used(name)
        self.declare(0, name, at, 0, false)

    // The slot the root block gives `name`.
    slot(self, name: string) -> Option[usize] = self.declared(0, name)

    // The slot block `blk` itself gives `name`: where a declaration's names are stored.
    declared(self, blk: usize, name: string) -> Option[usize] = self.blocks.at(blk).decls.get(name) match
        Some(d) -> Some(d.slot)
        None -> None

    // What `name` is, written at offset `pos` in block `blk`: the innermost declaration of it in that
    // block or one around it that is in scope by `pos`.
    find(self, blk: usize, name: string, pos: usize) -> Option[Decl]
        var b = blk

        while b != NoScope
            val k = self.blocks.at(b)

            k.decls.get(name) match
                Some(d) -> if d.from <= pos then return Some(d)
                None -> ()

            b = k.parent

        None
    end find

    // Whether `name`, out of scope at `pos`, was declared before it by a block that has ended.
    ended(self, name: string, pos: usize) -> bool
        for k in self.blocks.view()
            k.decls.get(name) match
                Some(d) -> if d.from <= pos then return true
                None -> ()

        false
end Scope

scope() -> Scope = child_scope(NoScope, NoScope)

child_scope(parent: usize, parent_block: usize) -> Scope
    var blocks: Buf[Block] = buf()
    var decls: Map[string, Decl] = map()

    blocks.push(Block(decls, NoScope))
    Scope(blocks, buf(), map(), 0, parent, parent_block, map(), map())

// What a name means where it is written.
enum Meaning
    // A slot of the frame `depth` static links up; `fixed` when it cannot be assigned.
    Local(depth: usize, slot: usize, fixed: bool)

    // A name declared by a block that has ended before this occurrence, which reads `undefined`.
    Gone

    // Function `rel`, whose frames' static link is the frame `up` names (`TopUp` for the top
    // level's).
    Function(rel: usize, up: usize)

    Relation(rel: usize)
    Builtin(id: usize)

    // A `data` constructor, `id` indexing `Vm.ctors`.
    Constructor(id: usize)

    Unknown

// Where a loop that `break` or `continue` leaves records its marks: the slot holding the index of
// the mark around the whole loop, and the one holding the mark around the turn being run.
struct LoopSlots
    whole: usize
    turn: usize

// What the resolver decided about a whole program.
struct Resolved
    rels: Buf[Rel]

    // The top-level definitions by name.
    by_name: Map[string, usize]

    // Every scope, by id.
    scopes: Buf[Scope]

    // The top level's scope id.
    top: usize

    // The top level's statements, in order.
    top_stmts: Buf[Stmt]

    // Each lambda's definition, by the id the parser gave it.
    lambdas: Map[usize, usize]

    // Each block's and each `for`'s block, by the id the parser gave it, as an index into the
    // blocks of the scope it is in.
    blocks: Map[usize, usize]

    // The two slots of each loop a `break` or a `continue` leaves, by the loop's id.
    loops: Map[usize, LoopSlots]

    // What `name` means written at offset `pos` in block `blk` of scope `sid`, which is complete.
    meaning(self, sid: usize, blk: usize, pos: usize, name: string) -> Meaning
        val m = self.meaning_above(sid, blk, pos, 0, name)

        m match
            Unknown -> if self.scopes.at(sid).ended(name, pos) then Gone else Unknown
            _ -> m

    // What `name` means starting from block `blk` of scope `sid` at offset `pos`, the scope itself
    // `depth` static links up from where the name is written.
    meaning_above(self, sid: usize, blk: usize, pos: usize, depth: usize, name: string) -> Meaning
        var at = sid
        var b = blk
        var p = pos
        var d = depth

        while at != NoScope
            val s = self.scopes.at(at)

            s.find(b, name, p) match
                Some(k) -> return s.named(d, k)
                None -> ()

            s.fns.get(name) match
                Some(r) -> return Function(r, if at == self.top then TopUp else d)
                None -> ()

            at = s.parent
            b = s.parent_block
            p = Anywhere
            d += 1

        self.global(name)
    end meaning_above

    // What `name` means among the top-level definitions and the builtins.
    global(self, name: string) -> Meaning
        self.by_name.get(name) match
            Some(i) -> return if self.rels.at(i).function then Function(i, TopUp) else Relation(i)
            None -> ()

        native_id(name) match
            Some(id) -> Builtin(id)
            None -> Unknown
end Resolved

// Resolve `prog`, adding every refusal and warning to `report`.
resolve(prog: Program, report: *Report) -> Resolved
    var res = Resolved(buf(), map(), buf(), 0, prog.stmts, map(), map(), map())

    res.top = new_scope_id(&res)

    for c in prog.clauses.view()
        add_top_clause(&res, c, report)

    var pending: Buf[usize] = buf()

    for i in 0..<res.rels.len()
        if res.rels.at(i).function
            pending.push(i)
        else
            resolve_relation(&res, i, &pending, report)

    var top = scope()
    var w = walker(&res, report, &pending, &top, res.top, false, false)

    hoist_stmts(&w, prog.stmts)

    for s in prog.stmts.view()
        walk_stmt(&w, s)

    res.scopes.set(res.top, top)

    var i: usize = 0

    while i < pending.len()
        resolve_function(&res, pending.at(i), &pending, report)
        i += 1

    res
end resolve

// A fresh scope id, its scope stored once it is complete.
new_scope_id(res: *Resolved) -> usize
    res.scopes.push(scope())
    res.scopes.len() - 1

// A top-level clause joins the definition of its name.
private add_top_clause(res: *Resolved, c: Clause, report: *Report)
    res.by_name.get(c.name) match
        None ->
            var cs: Buf[Clause] = buf()
            val f = is_function(c.kind)

            cs.push(c)
            res.by_name.put(c.name, res.rels.len())
            res.rels.push(Rel(c.name, c.params.len(), cs, reserve_chunk(c.name), f, if f then res.top else NoScope, 0, buf()))
        Some(i) ->
            var r = res.rels.at(i)
            val first = r.clauses.at(0)

            if is_function(first.kind) != is_function(c.kind)
                report.add(error(c.head, s"`${c.name}` mixes a function clause with relation clauses")
                    .with_label(s"this is ${kind_text(c.kind)}")
                    .with_note("a definition is one kind or the other: facts and `:-` rules make a relation, `=` clauses a function"))
                report.add(Diagnostic(Note, first.head, s"`${c.name}` is first defined here, by ${kind_text(first.kind)}", "", ""))
            elif c.params.len() != r.arity
                report.add(error(c.head, s"`${c.name}` was defined with ${counted(r.arity, "argument")}, and this clause has ${c.params.len()}")
                    .with_note("every clause of a definition takes the same number of arguments"))
            else
                r.clauses.push(c)
                res.rels.set(i, r)
end add_top_clause

is_function(k: ClauseKind) -> bool = k match
    FunctionC(_) -> true
    _ -> false

private kind_text(k: ClauseKind) -> string = k match
    Fact -> "a fact"
    Rule(_) -> "a rule"
    FunctionC(_) -> "a function clause, written with `=`"

// The scopes of a relation's clauses: each head's variables first, then its body's, and a warning
// for each written only once.
private resolve_relation(res: *Resolved, ri: usize, pending: *Buf[usize], report: *Report)
    val r = res.rels.at(ri)
    var ids: Buf[usize] = buf()

    for c in r.clauses.view()
        val sid = new_scope_id(res)
        var sc = scope()

        for p in c.params.view()
            walk_head(&sc, p, report)

        sc.head = sc.count()

        var w = walker(res, report, pending, &sc, sid, true, false)

        c.kind match
            Rule(body) -> walk(&w, body)
            _ -> ()

        for named in sc.names.view()
            val n = named.value

            if sc.uses.get(n) == Some(1) && !n.starts_with("_")
                report.add(warning(named.span, s"`$n` appears only once in this clause of `${c.name}`")
                    .with_label("written once")
                    .with_note(s"a variable written once is usually a misspelling of another; `_$n` says the single occurrence is intended"))

        res.scopes.set(sid, sc)
        ids.push(sid)

    var done = res.rels.at(ri)

    done.scopes = ids
    res.rels.set(ri, done)
end resolve_relation

// A head argument: a variable, `_`, a constant, or a term of those.
private walk_head(sc: *Scope, p: &Expr, report: *Report)
    p.kind match
        Ref(n) -> sc.note(n, p.span)
        Anon -> ()
        AtomE(_) -> ()
        IntE(_) -> ()
        StrE(_) -> ()
        CallE(_, _, args) ->
            for a in args.view()
                walk_head(sc, a, report)
        BadE -> ()
        _ ->
            report.add(error(p.span, "a head argument is a variable, a constant or a term")
                .with_note("a goal belongs in the body, after `:-`"))
end walk_head

// The scopes of a function's clauses: its parameters, then its local functions, its `where`
// values, and its guards and bodies.
private resolve_function(res: *Resolved, ri: usize, pending: *Buf[usize], report: *Report)
    val r = res.rels.at(ri)
    var ids: Buf[usize] = buf()

    for c in r.clauses.view()
        val sid = new_scope_id(res)
        var sc = child_scope(r.outer, r.outer_block)
        var w = walker(res, report, pending, &sc, sid, false, true)

        for p in c.params.view()
            declare_pattern(&w, p, 0, false)

        c.kind match
            FunctionC(b) ->
                hoist_stmts(&w, b.wheres)

                for g in b.guards.view()
                    g.cond match
                        Some(x) -> hoist_expr(&w, x)
                        None -> ()

                    hoist_expr(&w, g.body)

                // A `where` value is in scope in the whole clause, though it is written last.
                for s in b.wheres.view()
                    s match
                        ValS(pat, x, _) ->
                            walk(&w, x)
                            declare_pattern(&w, pat, 0, true)
                        _ -> walk_stmt(&w, s)

                for g in b.guards.view()
                    g.cond match
                        Some(x) -> walk(&w, x)
                        None -> ()

                    walk(&w, g.body)
            _ -> ()

        res.scopes.set(sid, sc)
        ids.push(sid)

    var done = res.rels.at(ri)

    done.scopes = ids
    res.rels.set(ri, done)
end resolve_function
