module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.Search

// The resolver: what every name in a program means, decided before anything is compiled.
//
// **Scopes nest as frames do.** The top level is one scope; each clause of a function or a lambda is
// a scope whose parent is the scope the function was written in; a relation clause is a scope with
// no parent, which sees only what the top level fixes: its constructors, `val`s and `where`
// functions. A name is looked for in the scope it is written in, then in each parent -- every step
// one static link at run time -- then among the top-level definitions and the builtins.
//
// **Definitions are hoisted.** Every top-level clause joins the definition of its name before any
// body is read, so a rule may call one written after it; a `def` inside a body or a `where` joins
// its scope's functions before that scope's names are read. A definition is one kind or the other:
// facts and `:-` rules make a relation, function clauses a function, and a name with both is refused
// naming both clauses.
//
// **A function's body is resolved after the scope it was written in is complete**, so it sees every
// name that scope declares; the bodies wait in a queue, which the lambdas met along the way join.
//
// **Blocks nest inside a frame** (language.md § Assignment): a block of statements, a `(s; e)`
// sequence and a `for`'s bindings each declare names only their own code sees, from the end of the
// declaration on. A block's names are slots of the frame, so leaving a block costs nothing at run
// time; a name read after its block has ended is `Gone` and reads `undefined`.
//
// **In a relation, a name that is not otherwise in scope is a logic variable of the clause** --
// `logic.md`'s rule; a clause variable written once is warned about, unless its name starts with
// `_`. **Elsewhere a name must be declared** -- by `free`, `val`, `var`, an assignment, a parameter
// or a pattern -- before it is read.

// The parent of a scope that has none.
const NoScope: usize = 4294967295

// One definition: a relation, a named function, or a lambda.
struct Rel
    name: string
    arity: usize
    clauses: Buf[Clause]

    // The chunk it is compiled into.
    chunk: usize

    // Whether its clauses are function clauses.
    function: bool

    // The scope a function was written in; `NoScope` for a relation.
    outer: usize

    // The block of `outer` it was written in.
    outer_block: usize

    // The scope of each clause, once its clauses are resolved.
    scopes: Buf[usize]

// Whether `r` is an `async` function: one of its clauses was written under `async`.
is_async_rel(r: Rel) -> bool
    for c in r.clauses.view()
        if c.is_async then return true

    false

// A source offset after every other: where a function nested in a scope looks its names up from,
// since its body runs after the scope's own code has declared every name it is going to.
const Anywhere: usize = 4294967295

// A name a block declares.
struct Decl
    slot: usize

    // The source offset from which the name is in scope: the end of what declares it.
    from: usize

    // Declared by `val` or a `where` binding, so nothing may assign it.
    fixed: bool

// A region of a frame's code with names of its own: the frame's root, every block of statements
// inside it, and each `for`'s bindings. A block's names are slots of the frame like any other; only
// what can see them is limited.
struct Block
    decls: Map[string, Decl]

    // The block around this one, or `NoScope` for the root.
    parent: usize

// The names of one frame's worth of code, numbered as slots of the frame.
struct Scope
    // The root block is the first.
    blocks: Buf[Block]

    // Each slot's name, at its declaration, in slot order.
    names: Buf[Spanned[string]]

    // How many times each name is written, for the singleton warning.
    uses: Map[string, usize]

    // Slots below this are bound by a relation clause's head; those from here up are made fresh
    // when the clause is entered.
    head: usize

    // The enclosing scope, or `NoScope`, and the block of it this scope's code was written in.
    parent: usize
    parent_block: usize

    // The functions a `def` or a `where` defines here, as indices into `Resolved.rels`: every arity
    // of each name, in the order they were first written.
    fns: Map[string, Buf[usize]]

    // The slots a `data` declaration's constructors are declared in, and each one's constructor id.
    ctors: Map[usize, usize]

    // Whether a `yield` is written in this scope's own code (not in a function nested in it): a
    // function clause that generates by `yield`.
    yields: bool

    // Whether a `return` is written in this scope's own code: its commit is a cut, which leaves the
    // reversible changes made inside the statement it leaves to the caller's mark.
    returns: bool

    count(self) -> usize = self.names.len()

    // What declaration `d` of this scope means, the scope `depth` static links up: a constructor, or a
    // variable.
    named(self, depth: usize, d: Decl) -> Meaning = self.ctors.get(d.slot) match
        Some(id) -> Constructor(id)
        None -> Local(depth, d.slot, d.fixed)

    // A new block inside block `parent`.
    open(*self, parent: usize) -> usize
        var decls: Map[string, Decl] = map()

        self.blocks.push(Block(decls, parent))
        self.blocks.len() - 1

    // One more occurrence of `name`, for the singleton warning.
    used(*self, name: string)
        val n = self.uses.get(name) match
            Some(k) -> k
            None -> 0

        self.uses.put(name, n + 1)

    // `name` declared by block `blk`, in scope from offset `from`: its slot, which is a new one unless
    // the block already declares the name.
    declare(*self, blk: usize, name: string, at: Span, from: usize, fixed: bool) -> usize
        var b = self.blocks.at(blk)

        b.decls.get(name) match
            Some(d) -> return d.slot
            None -> ()

        val s = self.names.len()

        self.names.push(Spanned(name, at))
        b.decls.put(name, Decl(s, from, fixed))
        self.blocks.set(blk, b)
        s
    end declare

    // A name of the root block, counted as an occurrence and made on its first: how a relation
    // clause's variables and a head's are numbered.
    note(*self, name: string, at: Span) -> usize
        self.used(name)
        self.declare(0, name, at, 0, false)

    // The slot the root block gives `name`.
    slot(self, name: string) -> Option[usize] = self.declared(0, name)

    // The slot block `blk` itself gives `name`: where a declaration's names are stored.
    declared(self, blk: usize, name: string) -> Option[usize] = self.blocks.at(blk).decls.get(name) match
        Some(d) -> Some(d.slot)
        None -> None

    // What `name` is, written at offset `pos` in block `blk`: the innermost declaration of it in that
    // block or one around it that is in scope by `pos`.
    find(self, blk: usize, name: string, pos: usize) -> Option[Decl]
        var b = blk

        while b != NoScope
            val k = self.blocks.at(b)

            k.decls.get(name) match
                Some(d) -> if d.from <= pos then return Some(d)
                None -> ()

            b = k.parent

        None
    end find

    // Whether `name`, out of scope at `pos`, was declared before it by a block that has ended.
    ended(self, name: string, pos: usize) -> bool
        for k in self.blocks.view()
            k.decls.get(name) match
                Some(d) -> if d.from <= pos then return true
                None -> ()

        false
end Scope

scope() -> Scope = child_scope(NoScope, NoScope)

child_scope(parent: usize, parent_block: usize) -> Scope
    var blocks: Buf[Block] = buf()
    var decls: Map[string, Decl] = map()

    blocks.push(Block(decls, NoScope))
    Scope(blocks, buf(), map(), 0, parent, parent_block, map(), map(), false, false)

// What a name means where it is written.
enum Meaning
    // A slot of the frame `depth` static links up; `fixed` when it cannot be assigned.
    Local(depth: usize, slot: usize, fixed: bool)

    // A name declared by a block that has ended before this occurrence, which reads `undefined`.
    Gone

    // Function `rel`, whose frames' static link is the frame `up` names (`TopUp` for the top
    // level's).
    Function(rel: usize, up: usize)

    Relation(rel: usize)
    Builtin(id: usize)

    // A Prolog predicate the program imported: a relation, reached by its name and the call's arity.
    Predicate(name: string)

    // A `data` constructor, `id` indexing `Vm.ctors`.
    Constructor(id: usize)

    // A name defined at several arities (`language.md` § "One name, several arities"): what each
    // arity means, in the order a call looks through them. A call is resolved to the member that
    // takes its count (`Resolved.called`); the name as a value is one function value that picks the
    // member by the count of each call made through it (`family.sysl`).
    Family(name: string, members: Buf[Meaning])

    Unknown

// Where a loop that `break` or `continue` leaves records its marks: the slot holding the index of
// the mark around the whole loop, and the one holding the mark around the turn being run.
struct LoopSlots
    whole: usize
    turn: usize

    // Whether a `continue` leaves the loop: it ends the turn by its mark, so the turn keeps one even
    // where its body settles.
    continued: bool

// What the resolver decided about a whole program.
struct Resolved
    rels: Buf[Rel]

    // The top-level definitions by name: every arity of each, functions and relations, in the order
    // they were first written. A definition is keyed by its name and arity.
    by_name: Map[string, Buf[usize]]

    // Every scope, by id.
    scopes: Buf[Scope]

    // The top level's scope id.
    top: usize

    // What a call or a closure names the top level's frame by: `TopUp` for a program, `file_up(m)`
    // for a FunL file Prolog imported.
    top_up: usize

    // The top level's statements, in order.
    top_stmts: Buf[Stmt]

    // Each lambda's definition, by the id the parser gave it.
    lambdas: Map[usize, usize]

    // Each block's and each `for`'s block, by the id the parser gave it, as an index into the
    // blocks of the scope it is in.
    blocks: Map[usize, usize]

    // The two slots of each loop a `break` or a `continue` leaves, by the loop's id.
    loops: Map[usize, LoopSlots]

    // The code being resolved, which positions are read in.
    src: Source

    // What each call of a name reaches, by the offset of the name, as the resolver decided it --
    // knowing whether the call is in a goal (`called_in`), and before the program's own definitions
    // became Prolog predicates.
    picks: Map[usize, Meaning]

    // What each name an `import { ... }` declares means, and each `import * as` alias its map
    // (`module.sysl`).
    imported: Map[string, Meaning]

    // Each `import * as` alias, as an index into `Vm.modules`, and what each `alias.name` it
    // qualifies means.
    aliases: Map[string, usize]
    qualified: Map[string, Meaning]

    // The `data` types this file declares, and those its imports bring (by the name an
    // `import { ... }` declares, or as `alias.name`), each as an index into `Vm.data_types`. A
    // type's name is the file's own: another file sees it only by importing it.
    own_types: Map[string, usize]
    imported_types: Map[string, usize]

    // Every constructor this file sees under each name -- its own, those an `import { ... }` brings
    // (under the name it declares), and each `alias.name` -- as indices into `Vm.ctors`. The same
    // name with another number of fields is another constructor, and a call or a pattern reaches it
    // only when it is seen here: another module's `point/1` is not, unless this file imports it.
    kin: Map[string, Buf[usize]]

    // The constructors the top level's root block declares under each name: what an `export` of the
    // name exports.
    top_kin: Map[string, Buf[usize]]

    // The `data` type made of the constructors under a name, for `x is name` where the name has more
    // than one (`ctor_test`), as an index into `Vm.data_types`.
    kin_types: Map[string, usize]

    // What each name the prelude exports means here (`prelude.sysl`): seen after the file's own
    // definitions, its imports and the builtins, so any of them shadows it.
    prelude: Map[string, Meaning]

    // Each map literal entry whose value is a lambda, under its key written as a bare name: the
    // lambda's span and the key. `{x:xs -> x}` is one, and a refusal of `x` inside it says how a set
    // holding a lambda over a cons is written.
    split_lambdas: Buf[(Span, string)]

    // Whether each definition, by index into `rels`, is a function that settles: a call of it
    // completes with one value or faults (`settled.sysl`). Decided once resolution is done; a
    // definition past its end does not settle.
    settled: Buf[bool]

    // The `data` type `name` means in this file, if any: its own first, then an imported one.
    data_type(self, name: string) -> Option[usize]
        self.own_types.get(name) match
            Some(id) -> return Some(id)
            None -> ()

        self.imported_types.get(name)

    // Constructor `id`, seen in this file under `name`; `top` when the top level's root block
    // declares it.
    see_ctor(*self, name: string, id: usize, top: bool)
        self.kin.put(name, with_id(self.kin.get(name), id))

        if top then self.top_kin.put(name, with_id(self.top_kin.get(name), id))

    // The constructor a call or a pattern of `name` -- which means constructor `id` -- with `n`
    // fields reaches: `id` itself when it has `n`, or the constructor of `id`'s name with `n` fields
    // this file sees under `name`. `None` when there is none.
    ctor_of(self, name: string, id: usize, n: usize) -> Option[usize]
        val v = current()
        val f = v.ctors.at(id).functor

        if v.ctors.at(id).fields.len() == n then return Some(id)

        self.kin.get(name) match
            Some(ids) ->
                for i in ids.view()
                    val d = v.ctors.at(i)

                    if d.functor == f && d.fields.len() == n then return Some(i)
            None -> ()

        None

    // The constructor a call of `name`, meaning constructor `id`, with `n` arguments makes: the one
    // `ctor_of` finds, or `id` itself, whose own count the call is then refused against.
    made_ctor(self, name: string, id: usize, n: usize) -> usize = self.ctor_of(name, id, n) match
        Some(c) -> c
        None -> id

    // What `x is name` tests, `name` meaning constructor `id`: a record of any constructor of that
    // name this file sees under it, whatever its number of fields.
    ctor_test(*self, name: string, id: usize) -> TypeTest
        val v = current()
        val f = v.ctors.at(id).functor
        var same: Buf[usize] = buf()

        same.push(id)

        self.kin.get(name) match
            Some(ids) ->
                for i in ids.view()
                    if i != id && v.ctors.at(i).functor == f then same.push(i)
            None -> ()

        if same.len() == 1 then return CtorT(id)

        self.kin_types.get(name) match
            Some(t) -> return DataT(t)
            None -> ()

        val t = declare_data_type(same)

        self.kin_types.put(name, t)
        DataT(t)

    // What the name after an `is` means, `local` being what it means where it is written: a
    // qualified `alias.name` is what that module exports (no local name has a `.` in it).
    qualified_or(self, name: string, local: Meaning) -> Meaning = self.qualified.get(name) match
        Some(m) -> m
        None -> local

    // What `name` means written at offset `pos` in block `blk` of scope `sid`, which is complete.
    meaning(self, sid: usize, blk: usize, pos: usize, name: string) -> Meaning
        val m = self.meaning_above(sid, blk, pos, 0, name)

        m match
            Unknown -> if self.scopes.at(sid).ended(name, pos) then Gone else Unknown
            _ -> m

    // What `name` means starting from block `blk` of scope `sid` at offset `pos`, the scope itself
    // `depth` static links up from where the name is written.
    meaning_above(self, sid: usize, blk: usize, pos: usize, depth: usize, name: string) -> Meaning
        var at = sid
        var b = blk
        var p = pos
        var d = depth
        var reached_top = false

        while at != NoScope
            if at == self.top then reached_top = true

            val s = self.scopes.at(at)

            s.find(b, name, p) match
                Some(k) -> return s.named(d, k)
                None -> ()

            // The nearest scope that defines the name owns it at every arity; only the top level's
            // definitions are merged with the builtins and the prelude, by `global`.
            s.fns.get(name) match
                Some(rs) -> return fns_meaning(name, rs, if at == self.top then self.top_up else d)
                None -> ()

            at = s.parent
            b = s.parent_block
            p = Anywhere
            d += 1

        // A relation clause has no parent, yet it sees what the top level's root block fixes: a
        // constructor, a `val`, and a function a `where` defines there (`logic.md` § "Variables in a
        // relation", rule 2). Each is reached by the frame the top level's name names, never by a
        // count of static links. A `var`, a `free` variable and a plain assignment's name are not
        // fixed, and stay clause variables.
        if !reached_top
            val m = self.top_fixed(name)

            m match
                Unknown -> ()
                _ -> return m

        self.global(name)
    end meaning_above

    // What `name` means as the top level's root block fixes it, seen from a relation clause.
    top_fixed(self, name: string) -> Meaning
        val s = self.scopes.at(self.top)

        s.find(0, name, Anywhere) match
            Some(d) ->
                s.ctors.get(d.slot) match
                    Some(id) -> return Constructor(id)
                    None -> ()

                if d.fixed then return Local(self.top_up, d.slot, true)
            None -> ()

        s.fns.get(name) match
            Some(rs) -> fns_meaning(name, rs, self.top_up)
            None -> Unknown

    // The constructor the top level's root block declares as `name`, wherever it is written.
    top_constructor(self, name: string) -> Option[usize]
        val s = self.scopes.at(self.top)

        s.find(0, name, Anywhere) match
            Some(d) -> return s.ctors.get(d.slot)
            None -> ()

        self.imported.get(name) match
            Some(m) -> m match
                Constructor(id) -> Some(id)
                _ -> None
            None -> None

    // What `name` means among the top-level definitions, the imported names, the builtins and the
    // prelude: an imported name shadows a builtin, as a definition does, and each of them shadows the
    // prelude.
    //
    // **The program's own definitions are merged with the rest per arity**, as Prolog keeps a
    // program's `p/1` apart from a library's `p/2`: a builtin, the prelude's functions and the
    // Prolog predicates the program loaded keep every arity the program does not define, so a
    // program's `def any( x )` leaves `any(p, xs)` to the prelude.
    global(self, name: string) -> Meaning
        self.by_name.get(name) match
            Some(rs) -> return self.merged(name, rs)
            None -> ()

        self.imported.get(name) match
            Some(m) -> return m
            None -> ()

        native_id(name) match
            Some(id) -> return Builtin(id)
            None -> ()

        self.prelude.get(name) match
            Some(m) -> return m
            None -> ()

        if pred_name_known(name) then Predicate(name) else Unknown

    // What a call of `name` with `argc` arguments reaches, `name` meaning `m` where the call is
    // written. **The name/arity namespace keeps a builtin and the prelude apart**: a builtin that
    // does not take `argc` arguments leaves the call to the prelude's function of that name and
    // arity, so `any(c)` scans and `any(p, xs)` asks.
    //
    // **A Prolog predicate the program loaded shadows the prelude too**, at the arity it is defined
    // with: `all(ls)` calls an imported `all/1`. The Prolog library's predicates do not.
    //
    // **A name of several arities is resolved here, by the call's count**: the first member that
    // takes it, or -- in a goal -- the function of one parameter fewer, called as a relation. A call
    // no member takes keeps the family, which `check_call` refuses.
    called(self, name: string, m: Meaning, argc: usize) -> Meaning = self.called_in(name, m, argc, false)

    // `called`, for a call written in a goal when `goal`: there the program's own function of
    // `argc - 1` parameters is the relation of `argc` -- the Prolog key it has -- and comes before
    // a builtin or the prelude of `argc`.
    called_in(self, name: string, m: Meaning, argc: usize, goal: bool) -> Meaning
        m match
            Family(_, ms) ->
                // A predicate of the Prolog key one of the family's own definitions has is that
                // definition, which Prolog was given.
                val own = self.own_key(ms, argc)

                for x in ms.view()
                    if self.is_own(x) && self.takes(name, x, argc) then return x

                if goal
                    for x in ms.view()
                        x match
                            Function(r, _) -> if self.is_own(x) && self.rels.at(r).arity + 1 == argc then return x
                            _ -> ()

                for x in ms.view()
                    x match
                        Predicate(_) -> if own then continue
                        _ -> ()

                    if self.takes(name, x, argc) then return x

                if goal
                    for x in ms.view()
                        x match
                            Function(r, _) -> if self.rels.at(r).arity + 1 == argc then return x
                            _ -> ()

                // A library predicate is reached last, after the prelude.
                for x in ms.view()
                    x match
                        Predicate(_) -> if !own && pred_defined(pred_key(name, argc)) then return x
                        _ -> ()

                return m
            _ -> ()

        if self.prelude_meant(name, m)
            val key = pred_key(name, argc)

            if pred_defined(key) && !is_library(key) then return Predicate(name)

            return m

        val id = m match
            Builtin(id) -> id
            _ -> return m

        if takes_count(current().natives.at(id), argc) then return m

        self.prelude.get(name) match
            Some(p) -> p match
                Function(r, _) -> if self.rels.at(r).arity == argc then p else m
                Family(_, ps) ->
                    for x in ps.view()
                        if self.takes(name, x, argc) then return x

                    m
                _ -> m
            None -> m

    // Whether member `x` of the family of `name` takes a call of `argc` arguments itself: a
    // definition of that arity, a builtin that takes the count, or a predicate the program loaded
    // with it -- not the Prolog library's, which comes after the prelude.
    takes(self, name: string, x: Meaning, argc: usize) -> bool = x match
        Function(r, _) -> self.rels.at(r).arity == argc
        Relation(r) -> self.rels.at(r).arity == argc
        Builtin(id) -> !is_constant(id) && takes_count(current().natives.at(id), argc)
        Predicate(_) ->
            val key = pred_key(name, argc)

            pred_defined(key) && !is_library(key)
        _ -> false

    // The program's own top-level definitions `rs` of `name`, with each arity they leave to a
    // builtin, the prelude or a Prolog predicate: one meaning, or the family of them.
    merged(self, name: string, rs: Buf[usize]) -> Meaning
        var ms: Buf[Meaning] = buf()

        for i in rs.view()
            ms.push(if self.rels.at(i).function then Function(i, self.top_up) else Relation(i))

        native_id(name) match
            Some(id) ->
                val nat = current().natives.at(id)

                // A builtin stays only for a count the program leaves it.
                var left = nat.arity == Variadic

                if !left
                    for k in nat.least..nat.arity
                        if !self.defines(rs, k) then left = true

                if left && !is_constant(id) then ms.push(Builtin(id))
            None -> ()

        if pred_name_known(name) then ms.push(Predicate(name))

        self.prelude.get(name) match
            Some(p) -> p match
                Function(r, _) -> if !self.defines(rs, self.rels.at(r).arity) then ms.push(p)
                Family(_, ps) ->
                    for x in ps.view()
                        x match
                            Function(r, _) -> if !self.defines(rs, self.rels.at(r).arity) then ms.push(x)
                            _ -> ()
                _ -> ()
            None -> ()

        if ms.len() == 1 then ms.at(0) else Family(name, ms)
    end merged

    // Whether `x` is a definition this file wrote, rather than the prelude's or a builtin.
    is_own(self, x: Meaning) -> bool = x match
        Function(r, _) -> self.rels.at(r).clauses.len() > 0
        Relation(r) -> self.rels.at(r).clauses.len() > 0
        _ -> false

    // The call written at offset `pos`, of `name` meaning `m` there with `argc` arguments: what the
    // resolver decided it reaches (`picks`), or `called`'s answer when it decided nothing.
    picked(self, pos: usize, name: string, m: Meaning, argc: usize) -> Meaning = self.picks.get(pos) match
        Some(p) -> p
        None -> self.called(name, m, argc)

    // Whether one of the FunL definitions among `ms` is the Prolog predicate of `argc` arguments: a
    // relation of `argc`, or a function of one fewer.
    own_key(self, ms: Buf[Meaning], argc: usize) -> bool
        for x in ms.view()
            x match
                Function(r, _) -> if self.rels.at(r).arity + 1 == argc then return true
                Relation(r) -> if self.rels.at(r).arity == argc then return true
                _ -> ()

        false

    // Whether one of the definitions `rs` has `arity` arguments.
    defines(self, rs: Buf[usize], arity: usize) -> bool
        for i in rs.view()
            if self.rels.at(i).arity == arity then return true

        false

    // Whether `name` means a definition of the prelude's here: one a declaration may take over, as
    // it takes over a builtin's.
    is_prelude(self, name: string) -> bool
        if self.by_name.get(name).is_some() || self.imported.get(name).is_some() then return false

        self.prelude.get(name).is_some()

    // Whether `m`, what `name` means where it is written, is the prelude's function of that name.
    // A family of the prelude's own arities is too.
    prelude_meant(self, name: string, m: Meaning) -> bool
        m match
            Family(_, ms) ->
                self.prelude.get(name) match
                    Some(p) -> p match
                        Family(_, ps) -> return ms.len() == ps.len() && ms.len() > 0 && self.prelude_meant(name, ms.at(0))
                        _ -> return false
                    None -> return false
            _ -> ()

        val r = m match
            Function(r, _) -> r
            _ -> return false

        self.prelude.get(name) match
            Some(p) -> p match
                Function(q, _) -> q == r
                Family(_, ps) ->
                    for x in ps.view()
                        x match
                            Function(q, _) -> if q == r then return true
                            _ -> ()

                    false
                _ -> false
            None -> false
end Resolved

// What the functions `rs` of `name`, all defined by one scope, mean where they are written, `up`
// naming that scope's frame: the one function, or the family of them.
fns_meaning(name: string, rs: Buf[usize], up: usize) -> Meaning
    if rs.len() == 1 then return Function(rs.at(0), up)

    var ms: Buf[Meaning] = buf()

    for r in rs.view()
        ms.push(Function(r, up))

    Family(name, ms)

// What `name` means once `m` -- one more arity of it, from the same module -- joins what it meant
// before, `old`: the family of both.
with_member(name: string, old: Option[Meaning], m: Meaning) -> Meaning
    val prior = old match
        Some(o) -> o
        None -> return m

    var ms: Buf[Meaning] = buf()

    prior match
        Family(_, ps) ->
            for x in ps.view()
                ms.push(x)
        _ -> ms.push(prior)

    ms.push(m)
    Family(name, ms)

// The constructors `ids` holds, and `id` after them.
private with_id(ids: Option[Buf[usize]], id: usize) -> Buf[usize]
    var b: Buf[usize] = ids match
        Some(x) -> x
        None -> buf()

    b.push(id)
    b

// Resolve `prog`, whose top level's frame `top_up` names and whose imports brought `im`, adding
// every refusal and warning to `report`.
resolve(src: Source, prog: Program, top_up: usize, im: Imports, report: *Report) -> Resolved
    var res = Resolved(buf(), map(), buf(), 0, top_up, prog.stmts, map(), map(), map(), src, map(), map(), map(), map(), map(), map(), map(), map(), map(), map(), buf(), buf())

    res.top = new_scope_id(&res)

    for c in prog.clauses.view()
        add_top_clause(&res, c, report)

    // The file's own definitions are all known, so an import taking one of their names is refused.
    val own = res.rels.len()

    bind_imports(&res, im, report)
    bind_prelude(&res)

    var pending: Buf[usize] = buf()

    for i in 0..<own
        if res.rels.at(i).function then pending.push(i)

    var top = scope()
    var w = walker(&res, report, &pending, &top, res.top, false, false, true)

    hoist_stmts(&w, prog.stmts)

    for s in prog.stmts.view()
        walk_stmt(&w, s)

    res.scopes.set(res.top, top)

    // A relation's clauses are read once the top level is complete, so they see its constructors.
    for i in 0..<res.rels.len()
        val r = res.rels.at(i)

        if !r.function && r.clauses.len() > 0 then resolve_relation(&res, i, &pending, report)

    var i: usize = 0

    while i < pending.len()
        resolve_function(&res, pending.at(i), &pending, report)
        i += 1

    split_lambda_notes(&res, report)
    res
end resolve

// **`{x:xs -> x}` is the key `x` and the lambda `xs -> x`**, so where the lambda's body names its
// own entry's key and the name is undefined, the refusal says how a set holding a lambda over a cons
// is written.
private split_lambda_notes(res: *Resolved, report: *Report)
    for i in 0..<report.len()
        val d = report.at(i)

        for (at, n) in res.split_lambdas.view()
            if d.message == s"`$n` is not defined" && d.span.start >= at.start && d.span.end <= at.end
                report.items.set(i, d.with_note(s"`{$n:rest -> e}` is the key `$n` and the lambda `rest -> e`; a set holding a lambda over a cons is `{($n:rest -> e)}`"))
                break

// A fresh scope id, its scope stored once it is complete.
new_scope_id(res: *Resolved) -> usize
    res.scopes.push(scope())
    res.scopes.len() - 1

// A top-level clause joins the definition of its name and arity, or begins one.
//
// **A new arity is refused when Prolog would see it as one already defined**: a function of `n`
// parameters is the predicate of `n + 1` arguments, so function `f/1` and relation `f/2` are both
// `f/2` to Prolog (`language.md` § "One name, several arities").
private add_top_clause(res: *Resolved, c: Clause, report: *Report)
    val f = is_function(c.kind)
    val n = c.params.len()

    var rs: Buf[usize] = res.by_name.get(c.name) match
        Some(x) -> x
        None -> buf()

    for i in rs.view()
        var r = res.rels.at(i)

        if r.arity != n then continue

        val first = r.clauses.at(0)

        if r.function != f
            report.add(error(c.head, s"`${c.name}` mixes a function clause with relation clauses")
                .with_label(s"this is ${kind_text(c.kind)}")
                .with_note("a definition is one kind or the other: facts and `:-` rules make a relation, `=` clauses a function"))
            report.add(Diagnostic(Note, first.head, s"`${c.name}` is first defined here, by ${kind_text(first.kind)}", "", ""))
            return

        r.clauses.push(c)
        res.rels.set(i, r)
        return

    val key = if f then n + 1 else n

    for i in rs.view()
        val r = res.rels.at(i)

        if (if r.function then r.arity + 1 else r.arity) == key
            val first = r.clauses.at(0)

            report.add(error(c.head, s"`${c.name}` is ${definition_text(f, n)} here and ${definition_text(r.function, r.arity)} already, and both are `${c.name}/$key` to Prolog")
                .with_note(s"a function of n parameters is the Prolog predicate of n + 1 arguments, so the two would be one predicate; give one of them another name"))
            report.add(Diagnostic(Note, first.head, s"`${c.name}` is ${definition_text(r.function, r.arity)} here", "", ""))
            return

    rs.push(res.rels.len())
    res.by_name.put(c.name, rs)
    res.rels.push(Rel(c.name, n, single(c), reserve_chunk(c.name), f, if f then res.top else NoScope, 0, buf()))
end add_top_clause

// "a function of 1 parameter", "a relation of 2 arguments".
private definition_text(function: bool, n: usize) -> string
    if function then s"a function of ${counted(n, "parameter")}" else s"a relation of ${counted(n, "argument")}"

private single(c: Clause) -> Buf[Clause]
    var cs: Buf[Clause] = buf()

    cs.push(c)
    cs

// Whether `i` is one of the top level's own definitions, rather than a local function, a lambda or
// another module's definition.
is_top_rel(res: *Resolved, i: usize) -> bool
    res.by_name.get(res.rels.at(i).name) match
        Some(rs) ->
            for j in rs.view()
                if j == i then return true

            false
        None -> false

is_function(k: ClauseKind) -> bool = k match
    FunctionC(_) -> true
    _ -> false

private kind_text(k: ClauseKind) -> string = k match
    Fact -> "a fact"
    Rule(_) -> "a rule"
    FunctionC(_) -> "a function clause, written with `=`"

// The scopes of a relation's clauses: each head's variables first, then its body's, and a warning
// for each written only once.
private resolve_relation(res: *Resolved, ri: usize, pending: *Buf[usize], report: *Report)
    val r = res.rels.at(ri)
    var ids: Buf[usize] = buf()
    var clauses: Buf[Clause] = buf()

    for written in r.clauses.view()
        val sid = new_scope_id(res)
        var sc = scope()
        var params: Buf[&Expr] = buf()

        for p in written.params.view()
            params.push(head_atoms(res, p, report))

        val c = Clause(written.name, written.head, params, written.kind, written.is_async)

        clauses.push(c)

        for p in c.params.view()
            walk_head(&sc, p, report)

        sc.head = sc.count()

        var w = walker(res, report, pending, &sc, sid, true, false, false)

        c.kind match
            Rule(body) -> walk(&w, body)
            _ -> ()

        for named in sc.names.view()
            val n = named.value

            if sc.uses.get(n) == Some(1) && !n.starts_with("_")
                report.add(warning(named.span, s"`$n` appears only once in this clause of `${c.name}`")
                    .with_label("written once")
                    .with_note(s"a variable written once is usually a misspelling of another; `_$n` says the single occurrence is intended"))

        res.scopes.set(sid, sc)
        ids.push(sid)

    var done = res.rels.at(ri)

    done.scopes = ids
    done.clauses = clauses
    res.rels.set(ri, done)
end resolve_relation

// A head argument with each name that means a constructor with no fields written as that
// constructor's atom (`logic.md` § "Atoms"): `red`, after `data hue = red | green`, is `#red` in a
// head as in a body, and every other name is a clause variable.
private head_atoms(res: *Resolved, p: &Expr, report: *Report) -> &Expr
    p.kind match
        Ref(n) ->
            res.top_constructor(n) match
                Some(id) -> if current().ctors.at(id).fields.len() == 0 then expr(AtomE(n), p.span) else p
                None -> p
        CallE(n, at, args) -> expr(CallE(n, at, heads_atoms(res, args, report)), p.span)
        ListE(items) -> expr(ListE(heads_atoms(res, items, report)), p.span)
        ConsE(h, t) -> expr(ConsE(head_atoms(res, h, report), head_atoms(res, t, report)), p.span)
        MapE(keys, vals) -> expr(MapE(keys, heads_atoms(res, vals, report)), p.span)
        MapRestE(keys, vals, rest) -> expr(MapRestE(keys, heads_atoms(res, vals, report), rest), p.span)

        // `m.name(p, ...)` and `m.name`, `m` a module: the term, or the atom, of the constructor the
        // module exports as `name`, written as one of the file's own would be.
        ApplyE(f, args) ->
            head_constructor(res, f, Some(args.len()), report) match
                Some(n) -> expr(CallE(n, f.span, heads_atoms(res, args, report)), p.span)
                None -> p
        FieldE(_, _) ->
            head_constructor(res, p, None, report) match
                Some(n) -> expr(AtomE(n), p.span)
                None -> p
        _ -> p

private heads_atoms(res: *Resolved, ps: Buf[&Expr], report: *Report) -> Buf[&Expr]
    var out: Buf[&Expr] = buf()

    for p in ps.view()
        out.push(head_atoms(res, p, report))

    out

// When `f`, written in a head with `argc` fields (`None` for the bare name), is `m.name` for a module
// `m`: the constructor's name, or `None` with the refusal reported. `None`, and nothing reported,
// for anything else, which the head's own check refuses.
private head_constructor(res: *Resolved, f: &Expr, argc: Option[usize], report: *Report) -> Option[string]
    f.kind match
        FieldE(x, name) ->
            x.kind match
                Ref(g) ->
                    qualified_in_head(res, g, name) match
                        Some(m) ->
                            qualified_pattern_refusal(res, g, name, m, argc, f.span) match
                                Some(d) -> report.add(d)
                                None -> ()

                            return Some(name)
                        None -> ()
                _ -> ()
        _ -> ()

    None

// A head argument: a variable, `_`, a constant, or a term or list of those.
private walk_head(sc: *Scope, p: &Expr, report: *Report)
    p.kind match
        Ref(n) -> sc.note(n, p.span)
        Anon -> ()
        AtomE(_) -> ()
        IntE(_) -> ()
        NumE(_) -> ()
        StrE(_) -> ()
        CallE(_, _, args) ->
            for a in args.view()
                walk_head(sc, a, report)
        ListE(items) ->
            for a in items.view()
                walk_head(sc, a, report)
        ConsE(h, t) ->
            walk_head(sc, h, report)
            walk_head(sc, t, report)
        MapE(keys, vals) -> walk_head_map(sc, keys, vals, report)
        MapRestE(keys, vals, rest) ->
            walk_head_map(sc, keys, vals, report)

            rest.kind match
                Ref(n) -> sc.note(n, rest.span)
                Anon -> ()
                _ ->
                    report.add(error(rest.span, "a map pattern's `..` is followed by a name, `_` or nothing")
                        .with_note("`..rest` binds `rest` to a map of the entries the pattern does not name"))
        BadE -> ()
        _ ->
            report.add(error(p.span, "a head argument is a variable, a constant or a term")
                .with_note("a goal belongs in the body, after `:-`"))
end walk_head

// A map pattern in a head: each key a constant or a clause variable in parentheses, which an earlier
// argument binds, and each value a head argument. One constant written twice is refused.
private walk_head_map(sc: *Scope, keys: Buf[&Expr], vals: Buf[&Expr], report: *Report)
    for i in 0..<keys.len()
        val k = keys.at(i)

        k.kind match
            Ref(n) -> sc.note(n, k.span)
            _ ->
                if constant_key(k)
                    for j in 0..<i
                        if same_constant_key(keys.at(j), k)
                            report.add(error(k.span, "this key is already in the map pattern")
                                .with_note("a map holds a key once, so a pattern names it once"))
                            break
                else
                    report.add(error(k.span, "a key in a head is a constant or a variable in parentheses, `(k)`"))

        walk_head(sc, vals.at(i), report)

// The scopes of a function's clauses: its parameters, then its local functions, its `where`
// values, and its guards and bodies.
private resolve_function(res: *Resolved, ri: usize, pending: *Buf[usize], report: *Report)
    val r = res.rels.at(ri)
    var ids: Buf[usize] = buf()
    val waits = is_async_rel(r)

    for c in r.clauses.view()
        val sid = new_scope_id(res)
        var sc = child_scope(r.outer, r.outer_block)
        var w = walker(res, report, pending, &sc, sid, false, true, waits)

        for p in c.params.view()
            declare_pattern(&w, p, 0, false)

        c.kind match
            FunctionC(b) ->
                hoist_stmts(&w, b.wheres)

                for g in b.guards.view()
                    g.cond match
                        Some(x) -> hoist_expr(&w, x)
                        None -> ()

                    hoist_expr(&w, g.body)

                // A `where` value is in scope in the whole clause, though it is written last.
                for s in b.wheres.view()
                    s match
                        ValS(pat, x, _) ->
                            walk(&w, x)
                            declare_pattern(&w, pat, 0, true)
                        _ -> walk_stmt(&w, s)

                for g in b.guards.view()
                    g.cond match
                        Some(x) -> walk(&w, x)
                        None -> ()

                    walk(&w, g.body)
            _ -> ()

        res.scopes.set(sid, sc)
        ids.push(sid)

    var done = res.rels.at(ri)

    done.scopes = ids
    res.rels.set(ri, done)
end resolve_function
