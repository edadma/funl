module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// Functions: committed-choice clauses, patterns, guards, `where`, and bodies in tail position.
//
// **A clause is a mark**: failure while its parameters match, its `where` values are made or its
// guards are tried reaches the mark and moves on to the next clause; once a guard holds, `Unmark`
// commits, and failure in the body is the body's own.
//
//     c1:   Mark(c2); Frame(n); LoadArg(0); <pattern>; ...; <where>;
//           Mark(g2); <guard>; FailIfFalse; Unmark; Unmark; <body>; Return
//     g2:   MarkThrough; <last guard>; FailIfFalse; Unmark; Unmark; <body>; Return
//     c2:   ...
//           NoMatch
//
// **A clean clause needs no mark** (`clean_head`): one whose head only tests and stores. Its `Frame`
// is `FrameHead(n, c2, b1)`, which gives the frame a failure target, and a failure before `b1`, the
// first guarded body, goes to `c2` as the mark would have sent it (`head_fails`):
//
//     c1:   FrameHead(n, c2, b1); LoadArg(0); <pattern>; ...; <where>; <guard>; FailIfFalse
//     b1:   <body>; Return
//     c2:   ...
//
// **A body expression's values are returned with `Return`**, which leaves its choice points
// resumable: a function whose body generates is a generator. `return e` is `ReturnCommit`, which
// keeps only the first.
//
// **Patterns match one way.** A pattern inspects the value on top of the stack and binds its own
// names; it never binds the value. A name written twice in one clause's parameters must see equal
// values.

// Compile every clause of function `r` into its reserved chunk.
//
// **A function whose clauses test an argument by a key is indexed** (`clause_index.sysl`): a
// `SwitchClause` before the clauses jumps by that argument's key to the clauses that could take it,
// so the others are never attempted. Clause `i` begins at `starts.at(i)`; its head, after its
// `FrameHead` or `Mark; Frame`, at `afters.at(i)`; `starts.at(n)` is the `NoMatch`.
compile_function(res: *Resolved, r: Rel) -> Result[unit, string]
    var e = emit_function(r.name, r.arity)
    var heads: Buf[ClauseHead] = buf()

    e.is_async = is_async_rel(r)

    for i in 0..<r.clauses.len()
        val cl = r.clauses.at(i)
        val sid = r.scopes.at(i)
        var loops: Buf[Looping] = buf()
        val c = context(res, sid, &loops)

        val b = cl.kind match
            FunctionC(b) -> b
            _ -> return Err(s"'${r.name}' is a function with a clause that is not a function clause")

        heads.push(clause_head(&e, c, cl.params, res.scopes.at(sid).count(), clean_head(c, cl.params, b)))

    var starts: Buf[usize] = buf()

    for _ in 0..<r.clauses.len() + 1
        starts.push(e.label())

    clause_index(&e, heads, starts)

    for i in 0..<r.clauses.len()
        val cl = r.clauses.at(i)
        val sid = r.scopes.at(i)
        var loops: Buf[Looping] = buf()
        val c = context(res, sid, &loops)
        val h = heads.at(i)
        val next = starts.at(i + 1)
        var seen = unseen(h.slots)

        val b = cl.kind match
            FunctionC(b) -> b
            _ -> return Err(s"'${r.name}' is a function with a clause that is not a function clause")

        e.place(starts.at(i))

        if h.clean
            e.op(FrameHead(h.slots, next, h.body))
        else
            e.op(Mark(next))
            e.op(Frame(h.slots))

        e.place(h.after)

        for j in 0..<cl.params.len()
            e.op(LoadArg(j))
            pattern(&e, c, cl.params.at(j), &seen, j)?

        clause_body(&e, c, b, h.clean, next, h.body)?

    e.place(starts.at(r.clauses.len()))
    e.op(NoMatch)
    install(e, r.chunk)
end compile_function

// A clause's `where` values, then its guards, each choosing a body.
//
// **A clean clause** (`clean_head`) runs under no mark: its `where` values need none, since they
// neither generate nor trail, and the failure of its parameters, its `where` values and its only or
// first guard reaches the frame's failure target, `next`, because they all lie before `body`, the
// first guarded body. A guard with another after it keeps its `Mark(other)`, whose failure tries the
// next guard; the last of several guards lies after the first body, out of the head's reach, so it
// keeps a mark too, aimed at `next`. Nothing commits: the bodies run with no clause entry beneath
// them.
private clause_body(e: *Emit, c: Ctx, b: FnBody, clean: bool, next: usize, body: usize) -> Result[unit, string]
    for s in b.wheres.view()
        s match
            ValS(pat, x, _) ->
                if !clean then e.op(MarkThrough)

                compile_value(e, c, x)?

                if !clean then e.op(UnmarkKeep)

                match_fresh(e, c, pat)?
            _ -> ()

    for i in 0..<b.guards.len()
        val g = b.guards.at(i)
        val other = e.label()
        val last = i + 1 == b.guards.len()

        g.cond match
            Some(cond) ->
                if !last
                    e.op(Mark(other))
                elif !clean
                    // The last guard's failure is the clause's.
                    e.op(MarkThrough)
                elif i > 0
                    e.op(Mark(next))

                compile_value(e, c, cond)?
                e.op(FailIfFalse)

                if !last || !clean || i > 0 then e.op(Unmark)
            None -> ()

        if clean
            if i == 0 then e.place(body)
        else
            e.op(Unmark)

        body_tail(e, c, g.body)?
        e.place(other)

    if b.guards.len() == 0 then e.place(body)

    Ok(())
end clause_body

// Whether a function clause's head may run without a mark: every failure in it is a test that
// binds nothing, trails nothing and leaves no entry, so the frame's failure target can stand in for
// the mark. Its parameter patterns have no alternation and no computed map key; its `where` values'
// patterns are the same and their values, like its guards, fail cleanly (`fails_cleanly`) -- no
// unification, `<-`, generator, relation call or call through a value. A head that unified could
// bind a caller's variable with no entry fresh enough to make the binding trailed, and so undone for
// the next clause.
private clean_head(c: Ctx, params: Buf[&Expr], b: FnBody) -> bool
    for p in params.view()
        if !clean_pattern(p) then return false

    for s in b.wheres.view()
        s match
            ValS(pat, x, _) -> if !clean_pattern(pat) || !fails_cleanly(c, x) then return false
            _ -> ()

    for g in b.guards.view()
        g.cond match
            Some(cond) -> if !fails_cleanly(c, cond) then return false
            None -> ()

    true

// Whether pattern `p` compiles to tests and stores alone: no `Choice` (alternation) and no
// `MarkThrough` (a map key that is not a constant).
private clean_pattern(p: &Expr) -> bool
    p.kind match
        Disj(_, _) -> false
        TupleE(items) -> all_clean(items)
        CallE(_, _, args) -> all_clean(args)
        ApplyE(_, args) -> all_clean(args)
        ListE(items) -> all_clean(items)
        ConsE(h, t) -> clean_pattern(h) && clean_pattern(t)
        AsE(_, x) -> clean_pattern(x)
        MapE(keys, vals) -> constant_keys(keys) && all_clean(vals)
        MapRestE(keys, vals, rest) -> constant_keys(keys) && all_clean(vals) && clean_pattern(rest)
        _ -> true

private all_clean(ps: Buf[&Expr]) -> bool
    for p in ps.view()
        if !clean_pattern(p) then return false

    true

private constant_keys(keys: Buf[&Expr]) -> bool
    for k in keys.view()
        if !constant_key(k) then return false

    true

// A function body in tail position: every path through it ends in `Return`, a call there in a tail
// call. A scan `s ? e` there keeps its body in tail position, so a `yield` that is the last thing
// the scan does is the last thing the function does; every path out of the scan's body leaves it
// (`ScanLeave`) on the way to `Return`, and a call inside it is an ordinary call, made with the
// scan's subject in force.
body_tail(e: *Emit, c: Ctx, x: &Expr) -> Result[unit, string]
    x.kind match
        CallE(n, at, args) ->
            if c.scans > 0
                value_tail(e, c, x)?
            else
                call_named(e, c, n, at.start, args, true)?
        ApplyE(f, args) ->
            if c.scans > 0
                value_tail(e, c, x)?
            else
                apply(e, c, f, args, true)?
        ScanE(s, body) ->
            compile_value(e, c, s)?
            e.op(ScanBegin)
            body_tail(e, c.in_scan(), body)?
        IfE(cond, yes, no) ->
            val other = e.label()

            condition(e, c, cond, other)?
            body_tail(e, c, yes)?
            e.place(other)

            no match
                Some(n) -> body_tail(e, c, n)?
                None -> e.op(Fail)
        Disj(a, b) ->
            val other = e.label()

            e.op(Choice(other))
            body_tail(e, c, a)?
            e.place(other)
            body_tail(e, c, b)?
        BlockE(id, stmts) ->
            val inner = c.in_block(id)?

            for i in 0..<stmts.len()
                val s = stmts.at(i)

                if i + 1 < stmts.len()
                    compile_stmt(e, inner, s)?
                    continue

                s match
                    ExprS(last) -> body_tail(e, inner, last)?
                    _ ->
                        compile_stmt(e, inner, s)?
                        e.op(PushUnit)
                        leave_scans(e, inner.scans)
                        e.op(Return)
        ReturnE(_) -> compile_value(e, c, x)?
        YieldE(a) -> suspend(e, c, a, true)?
        EveryE(id, label, g, body) ->
            compile_every(e, c, id, label, g, body, yielding(c))?
            left(e, c)
        WhileE(id, label, cond, body) ->
            compile_while(e, c, id, label, cond, body, yielding(c))?
            left(e, c)
        RepeatE(id, label, body) ->
            compile_repeat(e, c, id, label, body, yielding(c))?
            left(e, c)
        ForE(id, label, gens, body) ->
            compile_for(e, c, id, label, gens, body, yielding(c))?
            left(e, c)
        _ -> value_tail(e, c, x)?

    Ok(())
end body_tail

// Whether the clause being compiled generates by `yield`: then a loop that is the last thing it does
// ends with no value of its own on a bare `break`, as the function would on running out.
private yielding(c: Ctx) -> bool = c.res.scopes.at(c.sc).yields

// The value on the stack, in tail position, returned with the scans around it left open.
private left(e: *Emit, c: Ctx)
    leave_scans(e, c.scans)
    e.op(Return)

// `x` in tail position as an ordinary value: each of its values leaves the scans open around it and
// is returned.
private value_tail(e: *Emit, c: Ctx, x: &Expr) -> Result[unit, string]
    compile_value(e, c, x)?
    left(e, c)
    Ok(())

// -- patterns ---------------------------------------------------------------------------------------

// A buffer saying, for each slot, whether a pattern has bound it yet.
private unseen(n: usize) -> Buf[bool]
    var seen: Buf[bool] = buf()

    for _ in 0..<n
        seen.push(false)

    seen

// Match the top of the stack against `p`, every name in it a new binding.
match_fresh(e: *Emit, c: Ctx, p: &Expr) -> Result[unit, string]
    var seen = unseen(c.res.scopes.at(c.sc).count())

    pattern(e, c, p, &seen, NoParam)

// What `pattern` is given for a pattern that is not one of a function's parameters.
private const NoParam: usize = 4294967295

// Match the top of the stack against `p`, popping it; fail when it does not match. `param` is the
// function argument the pattern is part of, or `NoParam`: where it is one, every point at which the
// pattern looks inside a value is preceded by `Instantiated`, so an unbound variable there is an
// error naming the function and the argument.
private pattern(e: *Emit, c: Ctx, p: &Expr, seen: *Buf[bool], param: usize) -> Result[unit, string]
    p.kind match
        Ref(n) ->
            nullary(c.meaning(n, p.span.start)) match
                Some(functor) ->
                    inspect(e, param)
                    equal_to(e, Atom(functor))
                None -> bind_name(e, c, n, seen, param)?
        Anon -> e.op(Pop)
        AtomE(n) ->
            inspect(e, param)
            equal_to(e, atom(n))
        IntE(n) ->
            inspect(e, param)
            equal_to(e, Int(n))
        NumE(text) ->
            inspect(e, param)
            equal_to(e, literal_value(text)?)
        StrE(s) ->
            inspect(e, param)
            equal_to(e, new_str(s)?)
        BoolE(b) ->
            inspect(e, param)
            equal_to(e, boolean(b))
        TupleE(items) ->
            inspect(e, param)

            if items.len() == 0
                equal_to(e, Unit)
            else
                e.op(MatchTuple(items.len()))

                for x in items.view()
                    pattern(e, c, x, seen, param)?
        CallE(n, at, args) ->
            // The functor is the constructor's own, which an import's `as` does not rename; in a
            // `catch`'s pattern a name no constructor has is a functor of its own.
            val functor = c.meaning(n, at.start) match
                Constructor(id) -> current().ctors.at(id).functor
                _ -> intern(n)

            inspect(e, param)
            e.op(MatchCompound(functor, args.len()))

            for x in args.view()
                pattern(e, c, x, seen, param)?
        ApplyE(f, args) ->
            // `m.name(p, ...)`: a term of the constructor module `m` exports as `name`.
            val functor = pattern_functor(qualified_callee(c, f))?

            inspect(e, param)
            e.op(MatchCompound(functor, args.len()))

            for x in args.view()
                pattern(e, c, x, seen, param)?
        FieldE(x, name) ->
            inspect(e, param)
            equal_to(e, Atom(pattern_functor(qualified_in(c, x, name))?))
        ListE(items) ->
            for x in items.view()
                inspect(e, param)
                e.op(MatchCons)
                pattern(e, c, x, seen, param)?

            inspect(e, param)
            e.op(MatchNil)
        ConsE(h, t) ->
            inspect(e, param)
            e.op(MatchCons)
            pattern(e, c, h, seen, param)?
            pattern(e, c, t, seen, param)?
        Disj(a, b) ->
            val other = e.label()
            val end = e.label()
            val before = copied(seen)

            e.op(Choice(other))
            pattern(e, c, a, seen, param)?
            e.op(Branch(end))
            e.place(other)

            var also = before

            pattern(e, c, b, &also, param)?

            for i in 0..<also.len()
                if also.at(i) then seen.set(i, true)

            e.place(end)
        AsE(n, x) ->
            e.op(Dup)
            bind_name(e, c, n, seen, param)?
            pattern(e, c, x, seen, param)?
        MapE(keys, vals) -> map_pattern(e, c, keys, vals, None, seen, param)?
        MapRestE(keys, vals, rest) -> map_pattern(e, c, keys, vals, Some(rest), seen, param)?
        _ -> return Err("a pattern the resolver refused reached the compiler")

    Ok(())
end pattern

// `{k: p, ...}`, `{k: p, ..rest}`: the keys evaluated over the value, then `MatchMap`, then each
// value's pattern and the rest's. A key that is not a constant is an expression whose first value is
// the key; its failure is the pattern's. A bare `..` or `.._` asks for no rest map.
private map_pattern(e: *Emit, c: Ctx, keys: Buf[&Expr], vals: Buf[&Expr], rest: Option[&Expr], seen: *Buf[bool], param: usize) -> Result[unit, string]
    inspect(e, param)
    map_keys(e, c, keys)?

    val named: Option[&Expr] = rest match
        Some(r) -> r.kind match
            Anon -> None
            _ -> Some(r)
        None -> None

    e.op(MatchMap(keys.len(), named.is_some(), rest.is_none() && keys.len() == 0))

    for x in vals.view()
        pattern(e, c, x, seen, param)?

    named match
        Some(r) -> pattern(e, c, r, seen, param)?
        None -> ()

    Ok(())

// A map pattern's keys, pushed in order: a constant as itself, any other key the first value of its
// expression.
map_keys(e: *Emit, c: Ctx, keys: Buf[&Expr]) -> Result[unit, string]
    for k in keys.view()
        if constant_key(k)
            compile_value(e, c, k)?
        else
            e.op(MarkThrough)
            compile_value(e, c, k)?
            e.op(UnmarkKeep)

    Ok(())

// Before a pattern looks inside the value on top: the check that names the function, where the
// pattern is one of its parameters.
private inspect(e: *Emit, param: usize)
    if param != NoParam then e.op(Instantiated(param))

// A name in a pattern: its first occurrence takes the value, a later one must equal it.
private bind_name(e: *Emit, c: Ctx, n: string, seen: *Buf[bool], param: usize) -> Result[unit, string]
    val s = slot_of_name(c, n)?

    if seen.at(s)
        inspect(e, param)
        e.op(LoadSlot(0, s))
        e.op(TestEq)
        e.op(Pop)
    else
        seen.set(s, true)
        e.op(StoreSlot(s))

    Ok(())

// A constant in a pattern: the value must equal it.
private equal_to(e: *Emit, x: Value)
    e.op(PushConst(e.constant(x)))
    e.op(TestEq)
    e.op(Pop)

private copied(seen: *Buf[bool]) -> Buf[bool]
    var out: Buf[bool] = buf()

    for b in seen.view()
        out.push(b)

    out
