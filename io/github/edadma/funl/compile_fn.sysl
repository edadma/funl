module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// Functions: committed-choice clauses, patterns, guards, `where`, and bodies in tail position.
//
// **A clause is a mark**: failure while its parameters match, its `where` values are made or its
// guards are tried reaches the mark and moves on to the next clause; once a guard holds, `Unmark`
// commits, and failure in the body is the body's own.
//
//     c1:   Mark(c2); Frame(n); LoadArg(0); <pattern>; ...; <where>;
//           Mark(g2); <guard>; FailIfFalse; Unmark; Unmark; <body>; Return
//     g2:   MarkThrough; <last guard>; FailIfFalse; Unmark; Unmark; <body>; Return
//     c2:   ...
//           NoMatch
//
// **A body expression's values are returned with `Return`**, which leaves its choice points
// resumable: a function whose body generates is a generator. `return e` is `ReturnCommit`, which
// keeps only the first.
//
// **Patterns match one way.** A pattern inspects the value on top of the stack and binds its own
// names; it never binds the value. A name written twice in one clause's parameters must see equal
// values.

// Compile every clause of function `r` into its reserved chunk.
compile_function(res: *Resolved, r: Rel) -> Result[unit, string]
    var e = emit_function(r.name, r.arity)

    for i in 0..<r.clauses.len()
        val cl = r.clauses.at(i)
        val sid = r.scopes.at(i)
        var loops: Buf[Looping] = buf()
        val c = context(res, sid, &loops)
        val next = e.label()
        var seen = unseen(res.scopes.at(sid).count())

        e.op(Mark(next))
        e.op(Frame(res.scopes.at(sid).count()))

        for j in 0..<cl.params.len()
            e.op(LoadArg(j))
            pattern(&e, c, cl.params.at(j), &seen, j)?

        cl.kind match
            FunctionC(b) -> clause_body(&e, c, b)?
            _ -> return Err(s"'${r.name}' is a function with a clause that is not a function clause")

        e.place(next)

    e.op(NoMatch)
    install(e, r.chunk)
end compile_function

// A clause's `where` values, then its guards, each choosing a body.
private clause_body(e: *Emit, c: Ctx, b: FnBody) -> Result[unit, string]
    for s in b.wheres.view()
        s match
            ValS(pat, x, _) ->
                e.op(MarkThrough)
                compile_value(e, c, x)?
                e.op(UnmarkKeep)
                match_fresh(e, c, pat)?
            _ -> ()

    for i in 0..<b.guards.len()
        val g = b.guards.at(i)
        val other = e.label()

        g.cond match
            Some(cond) ->
                // The last guard's failure is the clause's.
                e.op(if i + 1 == b.guards.len() then MarkThrough else Mark(other))
                compile_value(e, c, cond)?
                e.op(FailIfFalse)
                e.op(Unmark)
            None -> ()

        e.op(Unmark)
        body_tail(e, c, g.body)?
        e.place(other)

    Ok(())
end clause_body

// A function body in tail position: every path through it ends in `Return`, a call there in a tail
// call. A scan `s ? e` there keeps its body in tail position, so a `yield` that is the last thing
// the scan does is the last thing the function does; every path out of the scan's body leaves it
// (`ScanLeave`) on the way to `Return`, and a call inside it is an ordinary call, made with the
// scan's subject in force.
body_tail(e: *Emit, c: Ctx, x: &Expr) -> Result[unit, string]
    x.kind match
        CallE(n, at, args) ->
            if c.scans > 0
                value_tail(e, c, x)?
            else
                call_named(e, c, n, at.start, args, true)?
        ApplyE(f, args) ->
            if c.scans > 0
                value_tail(e, c, x)?
            else
                apply(e, c, f, args, true)?
        ScanE(s, body) ->
            compile_value(e, c, s)?
            e.op(ScanBegin)
            body_tail(e, c.in_scan(), body)?
        IfE(cond, yes, no) ->
            val other = e.label()

            condition(e, c, cond, other)?
            body_tail(e, c, yes)?
            e.place(other)

            no match
                Some(n) -> body_tail(e, c, n)?
                None -> e.op(Fail)
        Disj(a, b) ->
            val other = e.label()

            e.op(Choice(other))
            body_tail(e, c, a)?
            e.place(other)
            body_tail(e, c, b)?
        BlockE(id, stmts) ->
            val inner = c.in_block(id)?

            for i in 0..<stmts.len()
                val s = stmts.at(i)

                if i + 1 < stmts.len()
                    compile_stmt(e, inner, s)?
                    continue

                s match
                    ExprS(last) -> body_tail(e, inner, last)?
                    _ ->
                        compile_stmt(e, inner, s)?
                        e.op(PushUnit)
                        leave_scans(e, inner.scans)
                        e.op(Return)
        ReturnE(_) -> compile_value(e, c, x)?
        YieldE(a) -> suspend(e, c, a, true)?
        _ -> value_tail(e, c, x)?

    Ok(())
end body_tail

// `x` in tail position as an ordinary value: each of its values leaves the scans open around it and
// is returned.
private value_tail(e: *Emit, c: Ctx, x: &Expr) -> Result[unit, string]
    compile_value(e, c, x)?
    leave_scans(e, c.scans)
    e.op(Return)
    Ok(())

// -- patterns ---------------------------------------------------------------------------------------

// A buffer saying, for each slot, whether a pattern has bound it yet.
private unseen(n: usize) -> Buf[bool]
    var seen: Buf[bool] = buf()

    for _ in 0..<n
        seen.push(false)

    seen

// Match the top of the stack against `p`, every name in it a new binding.
match_fresh(e: *Emit, c: Ctx, p: &Expr) -> Result[unit, string]
    var seen = unseen(c.res.scopes.at(c.sc).count())

    pattern(e, c, p, &seen, NoParam)

// What `pattern` is given for a pattern that is not one of a function's parameters.
private const NoParam: usize = 4294967295

// Match the top of the stack against `p`, popping it; fail when it does not match. `param` is the
// function argument the pattern is part of, or `NoParam`: where it is one, every point at which the
// pattern looks inside a value is preceded by `Instantiated`, so an unbound variable there is an
// error naming the function and the argument.
private pattern(e: *Emit, c: Ctx, p: &Expr, seen: *Buf[bool], param: usize) -> Result[unit, string]
    p.kind match
        Ref(n) ->
            nullary(c.meaning(n, p.span.start)) match
                Some(functor) ->
                    inspect(e, param)
                    equal_to(e, Atom(functor))
                None -> bind_name(e, c, n, seen, param)?
        Anon -> e.op(Pop)
        AtomE(n) ->
            inspect(e, param)
            equal_to(e, atom(n))
        IntE(n) ->
            inspect(e, param)
            equal_to(e, Int(n))
        NumE(text) ->
            inspect(e, param)
            equal_to(e, literal_value(text)?)
        StrE(s) ->
            inspect(e, param)
            equal_to(e, new_str(s)?)
        BoolE(b) ->
            inspect(e, param)
            equal_to(e, boolean(b))
        TupleE(items) ->
            inspect(e, param)

            if items.len() == 0
                equal_to(e, Unit)
            else
                e.op(MatchTuple(items.len()))

                for x in items.view()
                    pattern(e, c, x, seen, param)?
        CallE(n, at, args) ->
            // The functor is the constructor's own, which an import's `as` does not rename; in a
            // `catch`'s pattern a name no constructor has is a functor of its own.
            val functor = c.meaning(n, at.start) match
                Constructor(id) -> current().ctors.at(id).functor
                _ -> intern(n)

            inspect(e, param)
            e.op(MatchCompound(functor, args.len()))

            for x in args.view()
                pattern(e, c, x, seen, param)?
        ApplyE(f, args) ->
            // `m.name(p, ...)`: a term of the constructor module `m` exports as `name`.
            val functor = pattern_functor(qualified_callee(c, f))?

            inspect(e, param)
            e.op(MatchCompound(functor, args.len()))

            for x in args.view()
                pattern(e, c, x, seen, param)?
        FieldE(x, name) ->
            inspect(e, param)
            equal_to(e, Atom(pattern_functor(qualified_in(c, x, name))?))
        ListE(items) ->
            for x in items.view()
                inspect(e, param)
                e.op(MatchCons)
                pattern(e, c, x, seen, param)?

            inspect(e, param)
            e.op(MatchNil)
        ConsE(h, t) ->
            inspect(e, param)
            e.op(MatchCons)
            pattern(e, c, h, seen, param)?
            pattern(e, c, t, seen, param)?
        Disj(a, b) ->
            val other = e.label()
            val end = e.label()
            val before = copied(seen)

            e.op(Choice(other))
            pattern(e, c, a, seen, param)?
            e.op(Branch(end))
            e.place(other)

            var also = before

            pattern(e, c, b, &also, param)?

            for i in 0..<also.len()
                if also.at(i) then seen.set(i, true)

            e.place(end)
        AsE(n, x) ->
            e.op(Dup)
            bind_name(e, c, n, seen, param)?
            pattern(e, c, x, seen, param)?
        _ -> return Err("a pattern the resolver refused reached the compiler")

    Ok(())
end pattern

// Before a pattern looks inside the value on top: the check that names the function, where the
// pattern is one of its parameters.
private inspect(e: *Emit, param: usize)
    if param != NoParam then e.op(Instantiated(param))

// A name in a pattern: its first occurrence takes the value, a later one must equal it.
private bind_name(e: *Emit, c: Ctx, n: string, seen: *Buf[bool], param: usize) -> Result[unit, string]
    val s = slot_of_name(c, n)?

    if seen.at(s)
        inspect(e, param)
        e.op(LoadSlot(0, s))
        e.op(TestEq)
        e.op(Pop)
    else
        seen.set(s, true)
        e.op(StoreSlot(s))

    Ok(())

// A constant in a pattern: the value must equal it.
private equal_to(e: *Emit, x: Value)
    e.op(PushConst(e.constant(x)))
    e.op(TestEq)
    e.op(Pop)

private copied(seen: *Buf[bool]) -> Buf[bool]
    var out: Buf[bool] = buf()

    for b in seen.view()
        out.push(b)

    out
