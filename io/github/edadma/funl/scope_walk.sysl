module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{Search, from_utf8_unchecked}

// Reading one scope's code: each name looked up, declared or refused, each local function hoisted
// and each lambda queued for its own scope.

// Where the resolver is while it reads one scope.
struct Walk
    res: *Resolved
    report: *Report

    // Functions whose clauses wait to be resolved, as indices into `res.rels`.
    pending: *Buf[usize]

    // The scope being read, which is stored under `sid` once it is complete.
    sc: *Scope
    sid: usize

    // Whether this is a relation clause, where an unknown name is a fresh logic variable.
    relation: bool

    // Whether this is a function's clause, where `return` means something.
    function: bool

    // The block being read.
    blk: usize

    // The loops around the code being read, innermost last.
    loops: Buf[LoopSeen]

    // Whether the code being read is a goal -- a relation's body, or the goal of `findall`, `bagof`
    // or `setof` -- where a function of `n` parameters may be called as the relation `f/(n+1)`.
    goal: bool

    // Whether the pattern being read is a `catch`'s, which takes apart a thrown term -- an error term,
    // or whatever Prolog's `throw/1` was given -- so a term in it may name any functor, as a relation's
    // head may.
    ball: bool

    // What `name` means written at offset `pos`: the blocks being read first, then the complete
    // scopes above.
    meaning(self, name: string, pos: usize) -> Meaning
        self.sc.find(self.blk, name, pos) match
            Some(d) -> return self.sc.named(0, d)
            None -> ()

        self.sc.fns.get(name) match
            Some(r) -> return Function(r, if self.sid == self.res.top then self.res.top_up else 0)
            None -> ()

        val m = self.res.meaning_above(self.sc.parent, self.sc.parent_block, Anywhere, 1, name)

        m match
            Unknown -> if self.sc.ended(name, pos) then Gone else Unknown
            _ -> m
end Walk

// A loop the code being read is inside, which `break` and `continue` can name.
struct LoopSeen
    id: usize
    label: Option[string]

// A walk over scope `sid`, from its root block, inside no loop.
walker(res: *Resolved, report: *Report, pending: *Buf[usize], sc: *Scope, sid: usize, relation: bool, function: bool) -> Walk =
    Walk(res, report, pending, sc, sid, relation, function, 0, buf(), relation, false)

// Whether a call of `n`, which means `m`, is one of the all-solutions forms: the name, where nothing
// the program declares takes it.
is_all_solutions(m: Meaning, n: string) -> bool
    if n != "findall" && n != "bagof" && n != "setof" then return false

    m match
        Unknown -> true
        _ -> false

// `findall(t, g)`, `bagof(t, g)`, `setof(t, g)`: a template and a goal, the goal read as one.
private all_solutions(w: *Walk, n: string, at: Span, args: Buf[&Expr])
    if args.len() != 2
        w.report.add(error(at, s"`$n` takes a template and a goal, and this call gives ${counted(args.len(), "argument")}")
            .with_note(s"`$n( x, parent(#don, x) )` collects each `x` the goal gives"))
        return

    walk(w, args.at(0))

    val was = w.goal

    w.goal = true
    walk(w, args.at(1))
    w.goal = was

// A statement's names.
walk_stmt(w: *Walk, s: Stmt)
    s match
        FreeS(names) ->
            for named in names.view()
                if !refused_as_variable(w, named.value, named.span)
                    w.sc.declare(w.blk, named.value, named.span, named.span.end, false)
        ExprS(e) -> walk(w, e)
        ValS(pat, e, fixed) ->
            walk(w, e)

            if !fixed && writes_element(pat, w.meaning(call_name(pat), pat.span.start))
                walk(w, pat)
                return

            declare_pattern(w, pat, e.span.end, fixed)
        VarS(n, at, e) ->
            var from = at.end

            e match
                Some(x) ->
                    walk(w, x)
                    from = x.span.end
                None -> ()

            if !refused_as_variable(w, n, at) then w.sc.declare(w.blk, n, at, from, false)

        // Hoisted before the scope's names were read; what is learnt here is the block the
        // functions were written in, whose names their bodies see.
        DefS(clauses) -> written_in_block(w, clauses)

        // Each constructor is a name of the block, which nothing can assign, from its declaration on.
        // A data type's name is known to `is` from here on in this file, wherever it is written;
        // another file knows it only by importing it.
        DataS(ctors, typ) ->
            var ids: Buf[usize] = buf()

            for d in ctors.view()
                if refused_as_variable(w, d.name, d.at) then continue

                val origin = located(w.res.src, d.at.start)

                // The same declaration read again -- a file loaded once more after a refusal -- is
                // not a second constructor.
                declared_ctor(d.name, d.fields.len()) match
                    Some(first) ->
                        if first.origin != origin
                            w.report.add(error(d.at, s"the constructor `${d.name}` of ${counted(d.fields.len(), "field")} is already declared at ${first.origin}; two constructors with one name and one number of fields cannot be told apart"))
                            continue
                    None -> ()

                val slot = w.sc.declare(w.blk, d.name, d.at, d.at.end, true)
                val id = declare_ctor(d.name, d.fields, origin)

                w.sc.ctors.put(slot, id)
                w.res.see_ctor(d.name, id, w.sid == w.res.top && w.blk == 0)
                ids.push(id)

            if typ != ""
                if w.res.imported_types.get(typ).is_some() && ctors.len() > 0
                    w.report.add(error(ctors.at(0).at, s"the type `$typ` is imported, and this file cannot also declare it")
                        .with_note("`as` renames what an import declares: `import { x as y } from ...`, `import * as m from ...`"))
                else
                    w.res.own_types.put(typ, declare_data_type(ids))

// The name a statement `name(k) = e` writes through, or "" for any other left side.
call_name(pat: &Expr) -> string = pat.kind match
    CallE(n, _, _) -> n
    _ -> ""

// Whether the statement `pat = e`, `pat` being `name(k)`, writes into an element of the variable
// `name` -- `m` being what the name means -- rather than matching a pattern: a constructor's name, or
// one nothing declares, makes it a pattern.
writes_element(pat: &Expr, m: Meaning) -> bool
    pat.kind match
        CallE(_, _, args) -> if args.len() != 1 then return false
        _ -> return false

    m match
        Local(_, _, _) -> true
        _ -> false

// At the top level and in a relation, a name the program's own top-level definitions or imported
// Prolog predicates already have cannot also be a variable; the refusal is reported, and the answer
// says whether there was one. A function's own names may shadow them. A builtin's name is never
// refused: a declaration shadows the builtin from where it is in scope, as it shadows any outer name.
refused_as_variable(w: *Walk, n: string, at: Span) -> bool
    if w.sid != w.res.top && !w.relation then return false

    if w.res.imported.get(n).is_some() || w.res.aliases.get(n).is_some()
        w.report.add(error(at, s"`$n` is imported, and cannot also be a variable")
            .with_note("`as` renames what an import declares: `import { x as y } from ...`, `import * as m from ...`"))
        return true

    w.res.global(n) match
        Relation(_) -> ()
        Predicate(_) -> ()
        Function(_, _) ->
            w.report.add(error(at, s"`$n` is already a function, and cannot also be a variable"))
            return true
        _ -> return false

    w.report.add(error(at, s"`$n` is already a relation, and cannot also be a variable"))
    true

// A pattern's names, declared in the block being read, in scope from offset `from`.
declare_pattern(w: *Walk, p: &Expr, from: usize, fixed: bool)
    p.kind match
        Ref(n) ->
            // A constructor with no fields is a constant, which the pattern compares with.
            if nullary(w.meaning(n, p.span.start)).is_some() then return

            if !refused_as_variable(w, n, p.span) then w.sc.declare(w.blk, n, p.span, from, fixed)
        Anon -> ()
        AtomE(_) -> ()
        IntE(_) -> ()
        NumE(_) -> ()
        StrE(_) -> ()
        BoolE(_) -> ()
        TupleE(items) ->
            for x in items.view()
                declare_pattern(w, x, from, fixed)
        CallE(n, at, args) ->
            // `name(p, ...)`: a term of the constructor `name` in scope -- in a `catch`'s pattern, a
            // term of any functor.
            if !w.ball
                pattern_refusal(w.res, n, w.meaning(n, at.start), Some(args.len()), at) match
                    Some(d) -> w.report.add(d)
                    None -> ()

            for x in args.view()
                declare_pattern(w, x, from, fixed)
        ApplyE(f, args) ->
            // `m.name(p, ...)`, `m` a module: a term of the constructor the module exports as `name`.
            if !qualified_pattern(w, f, Some(args.len()))
                unmatchable(w, p)
                return

            for x in args.view()
                declare_pattern(w, x, from, fixed)
        FieldE(_, _) -> if !qualified_pattern(w, p, None) then unmatchable(w, p)
        Disj(a, b) ->
            declare_pattern(w, a, from, fixed)
            declare_pattern(w, b, from, fixed)
        ListE(items) ->
            for x in items.view()
                declare_pattern(w, x, from, fixed)
        ConsE(h, t) ->
            declare_pattern(w, h, from, fixed)
            declare_pattern(w, t, from, fixed)
        AsE(n, x) ->
            w.sc.declare(w.blk, n, p.span, from, fixed)
            declare_pattern(w, x, from, fixed)
        BadE -> ()
        _ -> unmatchable(w, p)
end declare_pattern

private unmatchable(w: *Walk, p: &Expr)
    w.report.add(error(p.span, "this cannot be matched against anything")
        .with_note("a pattern is a name, `_`, a constant, a tuple, a list `[a, b]` or `h:t`, a term, an alternation `p | q`, or `name@pattern`"))

// Whether `f`, a pattern's `m.name` given `argc` fields (`None` for the bare name), is a qualified
// name: `m` a module. A name the module does not export, or that is not a constructor of as many
// fields, is refused here; `false` leaves the refusal of anything else to the caller.
private qualified_pattern(w: *Walk, f: &Expr, argc: Option[usize]) -> bool
    f.kind match
        FieldE(x, name) ->
            qualified_at(w, x, name) match
                Some(m) ->
                    walk(w, x)

                    qualified_pattern_refusal(w.res, ref_name(x), name, m, argc, f.span) match
                        Some(d) -> w.report.add(d)
                        None -> ()

                    true
                None -> false
        _ -> false

// An expression's names.
walk(w: *Walk, e: &Expr)
    e.kind match
        Ref(n) ->
            w.meaning(n, e.span.start) match
                Local(depth, _, _) -> if depth == 0 then w.sc.used(n)
                Function(_, _) -> ()
                Constructor(_) -> ()
                Gone -> ()
                Relation(_) -> called_not_used(w, n, e.span)
                Predicate(_) -> called_not_used(w, n, e.span)
                Builtin(id) -> if !is_constant(id) && !is_function_value(id) then called_not_used(w, n, e.span)
                Unknown ->
                    // `import * as fs from funl:fs`: the module is the map of its exports.
                    if w.res.aliases.get(n).is_some() then return

                    if w.relation
                        w.sc.note(n, e.span)
                    elif w.sid == w.res.top
                        w.report.add(error(e.span, s"`$n` is not defined")
                            .with_note(s"a logic variable is declared before it is used: `free $n`"))
                    else
                        w.report.add(error(e.span, s"`$n` is not defined")
                            .with_note("a name is a parameter, a `val`, a function, or declared with `free`"))
        CallE(n, at, args) ->
            val m = w.meaning(n, at.start)

            if is_all_solutions(m, n)
                all_solutions(w, n, at, args)
                return

            if is_swap(m, n)
                swapped(w, args, e.span)
            elif is_combinator(m, n)
                check_combinator(w, n, at, args)
            else
                callable(w, n, at, args.len())

            for a in args.view()
                walk(w, a)
        UndefE -> ()
        MapE(keys, vals) ->
            for x in keys.view()
                walk(w, x)

            for x in vals.view()
                walk(w, x)
        SetE(items) ->
            for x in items.view()
                walk(w, x)
        ScanE(s, body) -> walk_two(w, s, body)
        CatchE(id, s, pat, guard, r) -> walk_catch(w, id, s, pat, guard, r)
        RegexE(_, _) -> ()
        SetElemE(c, k, x, _) ->
            walk_two(w, c, k)
            walk(w, x)
        InterpE(parts) ->
            for x in parts.view()
                walk(w, x)
        ApplyE(f, args) ->
            // `m.f(args)`, `m` a module: a call of what the module exports as `f`, checked as a call
            // of `f` in its own file is.
            var called = false

            f.kind match
                FieldE(x, name) ->
                    qualified_at(w, x, name) match
                        Some(m) ->
                            called = true
                            walk_module(w, x)

                            m match
                                Unknown -> not_exported_at(w, x, name, f.span)
                                _ -> check_call(w, m, s"${ref_name(x)}.$name", f.span, args.len())
                        None -> ()
                _ -> ()

            if !called then walk(w, f)

            for a in args.view()
                walk(w, a)
        TupleE(items) ->
            for x in items.view()
                walk(w, x)
        Conj(a, b) -> walk_two(w, a, b)
        Disj(a, b) -> walk_two(w, a, b)
        AndE(a, b) -> walk_two(w, a, b)
        OrE(a, b) -> walk_two(w, a, b)
        UnifyE(a, b) -> walk_two(w, a, b)
        EqualE(a, b) -> walk_two(w, a, b)
        DifferE(a, b) -> walk_two(w, a, b)
        BinE(_, a, b) -> walk_two(w, a, b)
        Neg(x) -> walk(w, x)
        MinusE(x) -> walk(w, x)
        IfE(c, y, n) ->
            walk_two(w, c, y)

            n match
                Some(x) -> walk(w, x)
                None -> ()
        EveryE(id, label, g, body) ->
            walk(w, g)
            loop_body(w, id, label, body)
        WhileE(id, label, c, body) ->
            walk(w, c)
            loop_body(w, id, label, body)
        RepeatE(id, label, body) -> loop_body(w, id, label, Some(body))
        ForE(id, label, gens, body) -> walk_for(w, id, label, gens, body)
        BreakE(label, v) ->
            loop_target(w, label, e.span, "break")

            v match
                Some(x) -> walk(w, x)
                None -> ()
        ContinueE(label) -> loop_target(w, label, e.span, "continue")
        BlockE(id, stmts) -> walk_block(w, id, stmts)
        LambdaE(id, clauses) -> queue_lambda(w, id, clauses, e.span)
        ReturnE(x) ->
            if !w.function
                w.report.add(error(e.span, "`return` is written inside a function")
                    .with_note("it leaves the function it is in, and the top level and a relation are not one"))

            x match
                Some(v) -> walk(w, v)
                None -> ()
        AsE(_, _) ->
            w.report.add(error(e.span, "`name@pattern` is a pattern, and this is not where one is matched")
                .with_note("it belongs in a parameter or on the left of a `val`"))
        SectionL(_, _) ->
            w.report.add(error(e.span, "this operator has no right operand")
                .with_note("a section that fixes the left operand is written in parentheses: `(2 *)`"))
        ListE(items) ->
            for x in items.view()
                walk(w, x)
        BangE(x) -> walk(w, x)
        RepAltE(x) -> walk(w, x)
        RangeE(a, b, by, _) ->
            walk_two(w, a, b)

            by match
                Some(x) -> walk(w, x)
                None -> ()
        ConsE(a, b) -> walk_two(w, a, b)
        RangeValE(a, upto, by, _) ->
            walk(w, a)
            walk_maybe(w, upto)
            walk_maybe(w, by)
        RangeCountE(a, n, by) ->
            walk_two(w, a, n)
            walk_maybe(w, by)
        CompE(id, elem, gens, _) -> walk_comprehension(w, id, elem, gens, e.span)
        InE(a, c, _) -> walk_two(w, a, c)
        IsE(x, t, at) ->
            walk(w, x)

            if type_test(w.res.data_type(t), w.res.qualified_or(t, w.meaning(t, at.start)), t).is_none()
                w.report.add(not_a_type(w, t, at))
        FieldE(x, name) ->
            qualified_at(w, x, name) match
                Some(m) ->
                    walk_module(w, x)

                    m match
                        Unknown -> not_exported_at(w, x, name, e.span)
                        Relation(_) -> called_not_used(w, s"${ref_name(x)}.$name", e.span)
                        _ -> ()
                None -> walk(w, x)
        RevAssignE(n, x) ->
            walk(w, x)
            assigned(w, n, e.span, e.span.end)
        YieldE(x) ->
            if !w.function
                w.report.add(error(e.span, "`yield` is written inside a function")
                    .with_note("it hands a value to the function's caller, and the top level and a relation have none"))

            w.sc.yields = true
            walk(w, x)
        AssignE(n, x) ->
            walk(w, x)
            assigned(w, n, e.span, e.span.end)
        CompoundE(n, o, x) ->
            walk(w, x)

            if !changes_val(o, w.meaning(n, e.span.start)) then updated(w, n, e.span)
        UpdateElemE(c, k, _, x) ->
            walk_two(w, c, k)
            walk(w, x)
        StepE(n, _, _) -> updated(w, n, e.span)
        MultiAssignE(targets, values) ->
            for x in values.view()
                walk(w, x)

            for t in targets.view()
                assigned(w, t.value, t.span, e.span.end)
        _ -> ()
end walk

private walk_two(w: *Walk, a: &Expr, b: &Expr)
    walk(w, a)
    walk(w, b)

walk_maybe(w: *Walk, x: Option[&Expr])
    x match
        Some(e) -> walk(w, e)
        None -> ()

private called_not_used(w: *Walk, n: string, at: Span)
    w.report.add(error(at, s"`$n` is a relation or a builtin, which is called rather than used as a value")
        .with_label(s"called as `$n(...)`"))

// The atom a name is, where it means a constructor with no fields.
nullary(m: Meaning) -> Option[u32] = m match
    Constructor(id) ->
        val d = current().ctors.at(id)

        if d.fields.len() == 0 then Some(d.functor) else None
    _ -> None

// Whether `m` is a `val`, a variable nothing can assign.
names_val(m: Meaning) -> bool = m match
    Local(_, _, fixed) -> fixed
    _ -> false

// Whether `x op= e`, `x` meaning `m`, changes the collection a `val` holds rather than assigning:
// `+=` onto a buffer or a mutable set, `-=` out of a mutable set, checked as it runs.
changes_val(o: BinOp, m: Meaning) -> bool = (o == Add || o == Sub) && names_val(m)

// Whether a call of `n`, which means `m`, is `swap`: the name, where nothing the program declares
// takes it.
is_swap(m: Meaning, n: string) -> bool
    if n != "swap" then return false

    m match
        Unknown -> true
        _ -> false

// `swap(a(i), b(j))`: two elements, each something an `=` could write into. Exchanging two variables
// is not built: it waits on a decision about passing a variable by reference.
private swapped(w: *Walk, args: Buf[&Expr], at: Span)
    if args.len() != 2
        w.report.add(error(at, s"`swap` exchanges two elements, and this call gives ${args.len()}")
            .with_note("`swap( a(i), a(j) )` exchanges two elements of an array"))
        return

    for a in args.view()
        val ok = if is_element(a) then writes_into(w, a) else false

        if !ok
            w.report.add(error(a.span, "`swap` exchanges elements, and this is not one")
                .with_note("an element is written `a(i)`, `a[i]` or `m.key`; swapping two variables is not built"))

// Whether element `a`, as written, reaches a collection: `name(k)` needs `name` to be a variable.
private writes_into(w: *Walk, a: &Expr) -> bool
    a.kind match
        CallE(n, at, _) ->
            w.meaning(n, at.start) match
                Local(_, _, _) -> true
                _ -> false
        _ -> true

// When `x.name` is a name a module exports, `x` naming the module: what it means there, `Unknown`
// when the module does not export it.
private qualified_at(w: *Walk, x: &Expr, name: string) -> Option[Meaning] = x.kind match
    Ref(g) -> qualified_name(w.res, g, w.meaning(g, x.span.start), name)
    _ -> None

// The module `x` names in `x.name`: walked as the value it is, unless it is one of FunL's own, which
// has no value and is only qualified through.
private walk_module(w: *Walk, x: &Expr)
    x.kind match
        Ref(g) -> if w.res.imported.get(g).is_none() then return
        _ -> ()

    walk(w, x)

// The name `x` is, or "".
private ref_name(x: &Expr) -> string = x.kind match
    Ref(g) -> g
    _ -> ""

// The refusal of `x.name`, which the module `x` names does not export.
// The refusal of `x is t` where `t` names no type: `m.t`, `m` a module alias, is refused as a name
// the module does not export.
private not_a_type(w: *Walk, t: string, at: Span) -> Diagnostic
    t.index_of(".") match
        Some(k) ->
            val g = from_utf8_unchecked(t.bytes[0..<k])

            if w.res.aliases.get(g).is_some() && w.res.qualified.get(t).is_none() && w.res.imported_types.get(t).is_none()
                return not_exported(w.res, g, from_utf8_unchecked(t.bytes[k + 1..<t.bytes.len]), at)
        None -> ()

    error(at, s"`$t` is not a type")
        .with_note("`is` takes a type's name: `integer`, `string`, `list` and the rest, a `data` type, or a constructor")

private not_exported_at(w: *Walk, x: &Expr, name: string, at: Span)
    x.kind match
        Ref(g) -> w.report.add(not_exported(w.res, g, name, at))
        _ -> ()

// A call names something callable, with as many arguments as it takes.
private callable(w: *Walk, n: string, at: Span, argc: usize) = check_call(w, w.meaning(n, at.start), n, at, argc)

// A call of `n`, which means `m`, with as many arguments as it takes.
private check_call(w: *Walk, m: Meaning, n: string, at: Span, argc: usize)
    val arity = m match
        Local(depth, _, _) ->
            if depth == 0 then w.sc.used(n)

            return
        Function(r, _) ->
            val n_params = w.res.rels.at(r).arity

            // In a goal, a function of `n` parameters is also the relation `f/(n+1)`.
            if w.goal && argc == n_params + 1 then return

            n_params
        Relation(r) -> w.res.rels.at(r).arity
        Builtin(id) ->
            // A constant is applied as its value is: the call indexes it, or calls it.
            if is_constant(id) then return

            val nat = current().natives.at(id)

            if nat.least != nat.arity
                if !takes_count(nat, argc)
                    w.report.add(error(at, s"`$n` takes ${takes_text(nat)}, and this call gives $argc"))

                return

            nat.arity
        Predicate(_) ->
            if !pred_defined(pred_key(n, argc))
                w.report.add(error(at, s"the Prolog predicate `$n` has no clauses of ${counted(argc, "argument")}")
                    .with_label("called here"))

            return
        Constructor(id) ->
            val fields = current().ctors.at(id).fields.len()

            if argc != fields && w.res.ctor_of(n, id, argc).is_none()
                w.report.add(error(at, s"the constructor `$n` takes ${counted(fields, "field")}, and this call gives $argc"))

            return
        _ ->
            // `fs("basename")`: a module of FunL's own is a map, which a call indexes.
            if w.res.aliases.get(n).is_some() then return

            var d = error(at, s"`$n` is not defined").with_label("called here")

            nearest_name(n, global_names(w.res)) match
                Some(near) -> d = d.with_note(s"did you mean `$near`?")
                None -> ()

            w.report.add(d)
            return

    if arity != Variadic && argc != arity
        w.report.add(error(at, s"`$n` takes ${counted(arity, "argument")}, and this call gives $argc"))
end check_call

private global_names(r: *Resolved) -> Buf[string]
    var names: Buf[string] = buf()

    for rel in r.rels.view()
        if rel.name != "lambda" then names.push(rel.name)

    // A Prolog builtin's key holds a `/` and a built-in module's native a `.` (`fs.read_file`), and
    // neither is a name a FunL program can write.
    for nat in current().natives.view()
        if nat.name.index_of("/").is_none() && nat.name.index_of(".").is_none() then names.push(nat.name)

    names

// A lambda is a function of its own, defined in the scope being read and resolved once that scope is
// complete.
private queue_lambda(w: *Walk, id: usize, clauses: Buf[Clause], at: Span)
    val arity = clauses.at(0).params.len()

    for c in clauses.view()
        if c.params.len() != arity
            w.report.add(error(c.head, s"this clause of a function literal takes ${c.params.len()}, and its first clause ${counted(arity, "argument")}")
                .with_note("every clause of a function takes the same number of arguments"))

    w.res.lambdas.put(id, w.res.rels.len())
    w.pending.push(w.res.rels.len())
    w.res.rels.push(Rel("lambda", arity, clauses, reserve_chunk("lambda"), true, w.sid, w.blk, buf()))

// -- hoisting -------------------------------------------------------------------------------------

// The `def`s among statements, and in every block inside them, join the scope being read.
hoist_stmts(w: *Walk, stmts: Buf[Stmt])
    for s in stmts.view()
        s match
            DefS(clauses) ->
                for c in clauses.view()
                    hoist_clause(w, c)
            ExprS(e) -> hoist_expr(w, e)
            ValS(_, e, _) -> hoist_expr(w, e)
            VarS(_, _, e) ->
                e match
                    Some(x) -> hoist_expr(w, x)
                    None -> ()
            FreeS(_) -> ()
            DataS(_, _) -> ()

// The `def`s in the blocks of an expression -- but not inside a lambda, which is a scope of its own.
hoist_expr(w: *Walk, e: &Expr)
    e.kind match
        BlockE(_, stmts) -> hoist_stmts(w, stmts)
        IfE(c, y, n) ->
            hoist_expr(w, c)
            hoist_expr(w, y)
            hoist_maybe(w, n)
        EveryE(_, _, g, body) ->
            hoist_expr(w, g)
            hoist_maybe(w, body)
        WhileE(_, _, c, body) ->
            hoist_expr(w, c)
            hoist_maybe(w, body)
        RepeatE(_, _, body) -> hoist_expr(w, body)
        ForE(_, _, gens, body) ->
            for g in gens.view()
                hoist_expr(w, g.iter)
                hoist_maybe(w, g.filter)

            hoist_maybe(w, body)
        BreakE(_, v) -> hoist_maybe(w, v)
        CompoundE(_, _, x) -> hoist_expr(w, x)
        MultiAssignE(_, values) ->
            for x in values.view()
                hoist_expr(w, x)
        CallE(_, _, args) ->
            for a in args.view()
                hoist_expr(w, a)
        ApplyE(f, args) ->
            hoist_expr(w, f)

            for a in args.view()
                hoist_expr(w, a)
        TupleE(items) ->
            for x in items.view()
                hoist_expr(w, x)
        Conj(a, b) -> hoist_two(w, a, b)
        Disj(a, b) -> hoist_two(w, a, b)
        AndE(a, b) -> hoist_two(w, a, b)
        OrE(a, b) -> hoist_two(w, a, b)
        UnifyE(a, b) -> hoist_two(w, a, b)
        EqualE(a, b) -> hoist_two(w, a, b)
        DifferE(a, b) -> hoist_two(w, a, b)
        BinE(_, a, b) -> hoist_two(w, a, b)
        Neg(x) -> hoist_expr(w, x)
        MinusE(x) -> hoist_expr(w, x)
        ReturnE(x) ->
            x match
                Some(v) -> hoist_expr(w, v)
                None -> ()
        ListE(items) ->
            for x in items.view()
                hoist_expr(w, x)
        BangE(x) -> hoist_expr(w, x)
        RepAltE(x) -> hoist_expr(w, x)
        YieldE(x) -> hoist_expr(w, x)
        AssignE(_, x) -> hoist_expr(w, x)
        RangeE(a, b, by, _) ->
            hoist_two(w, a, b)

            by match
                Some(x) -> hoist_expr(w, x)
                None -> ()
        ConsE(a, b) -> hoist_two(w, a, b)
        RangeValE(a, upto, by, _) ->
            hoist_expr(w, a)
            hoist_maybe(w, upto)
            hoist_maybe(w, by)
        RangeCountE(a, n, by) ->
            hoist_two(w, a, n)
            hoist_maybe(w, by)
        CompE(_, elem, gens, _) ->
            for g in gens.view()
                hoist_expr(w, g.iter)
                hoist_maybe(w, g.filter)

            hoist_expr(w, elem)
        InE(a, c, _) -> hoist_two(w, a, c)
        IsE(x, _, _) -> hoist_expr(w, x)
        DefinedE(x, _) -> hoist_expr(w, x)
        FieldE(x, _) -> hoist_expr(w, x)
        RevAssignE(_, x) -> hoist_expr(w, x)
        MapE(keys, vals) ->
            for x in keys.view()
                hoist_expr(w, x)

            for x in vals.view()
                hoist_expr(w, x)
        SetE(items) ->
            for x in items.view()
                hoist_expr(w, x)
        ScanE(s, body) -> hoist_two(w, s, body)
        CatchE(_, s, _, guard, r) ->
            hoist_two(w, s, r)
            hoist_maybe(w, guard)
        RegexE(_, _) -> ()
        SetElemE(c, k, x, _) ->
            hoist_two(w, c, k)
            hoist_expr(w, x)
        UpdateElemE(c, k, _, x) ->
            hoist_two(w, c, k)
            hoist_expr(w, x)
        InterpE(parts) ->
            for x in parts.view()
                hoist_expr(w, x)
        _ -> ()
end hoist_expr

private hoist_two(w: *Walk, a: &Expr, b: &Expr)
    hoist_expr(w, a)
    hoist_expr(w, b)

private hoist_maybe(w: *Walk, x: Option[&Expr])
    x match
        Some(e) -> hoist_expr(w, e)
        None -> ()

// One clause of a local `def` joins the function of its name in the scope being read.
private hoist_clause(w: *Walk, c: Clause)
    if !is_function(c.kind)
        w.report.add(error(c.head, s"`${c.name}` is a relation, and a relation is defined at the top level")
            .with_note("a `def` inside a body or a `where` defines a function, with `=`, a guard or a block"))
        return

    w.sc.fns.get(c.name) match
        Some(i) ->
            var r = w.res.rels.at(i)

            if c.params.len() != r.arity
                w.report.add(error(c.head, s"`${c.name}` was defined with ${counted(r.arity, "argument")}, and this clause has ${c.params.len()}")
                    .with_note("every clause of a definition takes the same number of arguments"))
                return

            r.clauses.push(c)
            w.res.rels.set(i, r)
        None ->
            var cs: Buf[Clause] = buf()

            cs.push(c)
            w.sc.fns.put(c.name, w.res.rels.len())
            w.pending.push(w.res.rels.len())
            w.res.rels.push(Rel(c.name, c.params.len(), cs, reserve_chunk(c.name), true, w.sid, 0, buf()))
end hoist_clause
