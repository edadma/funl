module io.github.edadma.funl
@tests

// Prolog's flags -- `set_prolog_flag/2`, `current_prolog_flag/2`, what `unknown` and `double_quotes`
// change -- and the ISO cases the conformance suite found the builtins getting wrong: `call/1` of a
// body with a part that is not callable, `arg/3` and `abolish/1` at the edges of their arguments,
// `number_chars/2` and `repeat/0`.

private ok(text: string) -> string = text + "\nsucceeded"

// Whether `goal` succeeds, fails, or the formal term of the error it raises.
private holds(goal: string) -> string =
    ran_prolog(s":- catch(($goal -> write(yes) ; write(no)), error(F, _), writeq(F)), nl.\n")

// `goal` run, then `X` written by `writeq`; or the formal term of the error it raises.
private gives(goal: string) -> string =
    ran_prolog(s":- catch(($goal -> writeq(X) ; write(no)), error(F, _), writeq(F)), nl.\n")

@test
THE_FLAGS_DESCRIBE_THE_MACHINE()
    assert_eq(gives("current_prolog_flag(bounded, X)"), ok("false"))
    assert_eq(gives("current_prolog_flag(prefer_rationals, X)"), ok("false"))
    assert_eq(holds("set_prolog_flag(prefer_rationals, true), current_prolog_flag(prefer_rationals, true)"), ok("yes"))
    assert_eq(gives("current_prolog_flag(max_integer, X)"), ok("9223372036854775807"))
    assert_eq(gives("current_prolog_flag(min_integer, X)"), ok("-9223372036854775808"))
    assert_eq(gives("current_prolog_flag(integer_rounding_function, X)"), ok("toward_zero"))
    assert_eq(gives("current_prolog_flag(max_arity, X)"), ok("1048576"))
    assert_eq(gives("current_prolog_flag(unknown, X)"), ok("error"))
    assert_eq(gives("current_prolog_flag(double_quotes, X)"), ok("string"))
    assert_eq(gives("current_prolog_flag(debug, X)"), ok("off"))
    assert_eq(gives("findall(F, current_prolog_flag(F, _), L), length(L, X)"), ok("9"))

@test
SET_PROLOG_FLAG_CHANGES_WHAT_CURRENT_PROLOG_FLAG_SAYS()
    assert_eq(gives("set_prolog_flag(unknown, warning), current_prolog_flag(unknown, X)"), ok("warning"))
    assert_eq(gives("set_prolog_flag(debug, on), current_prolog_flag(debug, X)"), ok("on"))
    assert_eq(holds("set_prolog_flag(unknown, fail), current_prolog_flag(unknown, error)"), ok("no"))

@test
THE_FLAG_BUILTINS_RAISE_THE_ISO_ERRORS()
    assert_eq(holds("set_prolog_flag(X, warning)"), ok("instantiation_error"))
    assert_eq(holds("set_prolog_flag(unknown, X)"), ok("instantiation_error"))
    assert_eq(holds("set_prolog_flag(5, decimals)"), ok("type_error(atom,5)"))
    assert_eq(holds("set_prolog_flag(date, 'July 1999')"), ok("domain_error(prolog_flag,date)"))
    assert_eq(holds("set_prolog_flag(debug, no)"), ok("domain_error(flag_value,debug+no)"))
    assert_eq(holds("set_prolog_flag(max_arity, 40)"), ok("permission_error(modify,flag,max_arity)"))
    assert_eq(holds("set_prolog_flag(bounded, false)"), ok("permission_error(modify,flag,bounded)"))
    assert_eq(holds("current_prolog_flag(5, V)"), ok("type_error(atom,5)"))
    assert_eq(holds("current_prolog_flag(warning, V)"), ok("domain_error(prolog_flag,warning)"))

@test
UNKNOWN_DECIDES_WHAT_A_CALL_OF_AN_UNDEFINED_PREDICATE_DOES()
    assert_eq(holds("undef_pred"), ok("existence_error(procedure,undef_pred/0)"))
    assert_eq(holds("set_prolog_flag(unknown, fail), undef_pred"), ok("no"))
    assert_eq(holds("set_prolog_flag(unknown, warning), undef_pred"), ok("no"))
    assert_eq(holds("set_prolog_flag(unknown, fail), G = undef_meta(1), call(G)"), ok("no"))
    assert_eq(holds("G = undef_meta(1), call(G)"), ok("existence_error(procedure,undef_meta/1)"))

    // A builtin and a defined predicate are not affected.
    assert_eq(ran_prolog("p(1).\n:- set_prolog_flag(unknown, fail), p(X), atom_length(abc, N), write(X-N), nl.\n"), ok("1-3"))

@test
DOUBLE_QUOTES_DECIDES_WHAT_THE_CLAUSES_AFTER_IT_READ()
    val clause = "w :- X = \"ab\", writeq(X), nl.\n:- w.\n"

    assert_eq(ran_prolog(clause), ok("\"ab\""))
    assert_eq(ran_prolog(":- set_prolog_flag(double_quotes, codes).\n" + clause), ok("[97,98]"))
    assert_eq(ran_prolog(":- set_prolog_flag(double_quotes, chars).\n" + clause), ok("[a,b]"))
    assert_eq(ran_prolog(":- set_prolog_flag(double_quotes, atom).\n" + clause), ok("ab"))
    assert_eq(ran_prolog(":- set_prolog_flag(double_quotes, codes).\nw :- X = \"\", writeq(X), nl.\n:- w.\n"), ok("[]"))

@test
A_FLAG_DIRECTIVE_TAKES_EFFECT_IN_ITS_PLACE_AMONG_THE_DIRECTIVES()
    val shown = ":- current_prolog_flag(prefer_rationals, P), current_prolog_flag(double_quotes, Q), " +
        "current_prolog_flag(unknown, U), X is 7 / 2, write(P/Q/U/X), nl.\n"
    val text = shown + ":- set_prolog_flag(prefer_rationals, true).\n:- set_prolog_flag(double_quotes, codes).\n" +
        ":- set_prolog_flag(unknown, fail).\n" + shown

    assert_eq(ran_prolog(text), ok("false/string/error/3.5\ntrue/codes/fail/7r2"))

    // A refused value is a directive that raises, in its place, and the load goes on.
    assert_eq(ran_prolog(":- write(before), nl.\n:- set_prolog_flag(unknown, maybe).\n:- write(after), nl.\n"),
        ok("before\nWarning: directive raised set_prolog_flag/2: flag unknown cannot be maybe: set_prolog_flag(unknown, maybe)\nafter"))

@test
A_FLAG_DIRECTIVE_THAT_IS_REFUSED_IS_REPORTED()
    assert_eq(prolog_complaints(":- set_prolog_flag(double_quotes, bytes).\n"),
        "error 1:4 set_prolog_flag/2: flag double_quotes cannot be bytes\n")

@test
CALL_REFUSES_A_BODY_WITH_A_PART_THAT_IS_NOT_CALLABLE_BEFORE_RUNNING_ANY_OF_IT()
    assert_eq(holds("call((fail, 1))"), ok("type_error(callable,(fail,1))"))
    assert_eq(holds("call((write(3), 1))"), ok("type_error(callable,(write(3),1))"))
    assert_eq(holds("call((1 ; true))"), ok("type_error(callable,(1;true))"))
    assert_eq(holds("call((true -> 2 ; true))"), ok("type_error(callable,(true->2;true))"))
    assert_eq(holds("setof(X, X^(true ; 4), L)"), ok("type_error(callable,(true;4))"))

    // A variable in a body is a goal, `call(X)`, and a term inside another builtin is that builtin's.
    assert_eq(holds("call((fail, _))"), ok("no"))
    assert_eq(holds("call((true ; fail))"), ok("yes"))
    assert_eq(holds("call((true, \\+ 1))"), ok("type_error(callable,1)"))

@test
ARG_REFUSES_A_NEGATIVE_POSITION()
    assert_eq(holds("arg(-3, foo(a, b), A)"), ok("domain_error(not_less_than_zero,-3)"))
    assert_eq(holds("arg(0, foo(a, b), A)"), ok("no"))
    assert_eq(holds("arg(3, foo(a, b), A)"), ok("no"))

@test
ABOLISH_REFUSES_AN_ARITY_PAST_MAX_ARITY()
    assert_eq(holds("current_prolog_flag(max_arity, M), N is M + 1, abolish(foo/N)"), ok("representation_error(max_arity)"))
    assert_eq(holds("current_prolog_flag(max_arity, M), abolish(foo/M)"), ok("yes"))

@test
NUMBER_CHARS_READS_AND_WRITES_A_NUMBER()
    assert_eq(gives("number_chars(33, X)"), ok("['3','3']"))
    assert_eq(holds("number_chars(33, ['3', '3'])"), ok("yes"))
    assert_eq(gives("number_chars(X, ['-', '2', '5'])"), ok("-25"))
    assert_eq(gives("number_chars(X, ['\\n', ' ', '3'])"), ok("3"))
    assert_eq(gives("number_chars(X, ['0', x, f])"), ok("15"))
    assert_eq(gives("number_chars(X, ['0', '''', 'A'])"), ok("65"))

@test
NUMBER_CHARS_RAISES_THE_ISO_ERRORS()
    assert_eq(holds("number_chars(A, ['3', ' '])"), ok("syntax_error(illegal_number)"))
    assert_eq(holds("number_chars(A, L)"), ok("instantiation_error"))
    assert_eq(holds("number_chars(a, L)"), ok("type_error(number,a)"))
    assert_eq(holds("number_chars(A, 4)"), ok("type_error(list,4)"))
    assert_eq(holds("number_chars(A, ['4', 2])"), ok("type_error(character,2)"))

@test
REPEAT_SUCCEEDS_AGAIN_EACH_TIME_IT_IS_BACKTRACKED_INTO()
    assert_eq(ran_prolog(":- nb_setval(n, 0), repeat, nb_getval(n, N), M is N + 1, nb_setval(n, M), M >= 3, !, write(M), nl.\n"),
        ok("3"))
    assert_eq(holds("(repeat, !, fail)"), ok("no"))
    assert_eq(holds("once(repeat)"), ok("yes"))
