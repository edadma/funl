module io.github.edadma.funl

import sh.sysl.parsing.counted
import sysl.buf.Buf

// The builtin registry.
//
// **Open from the start**: a builtin is `register(name, arity, go)` written in the file that
// implements it, and the `Native` instruction is an index into the table. No central match over every
// builtin exists to make every implementation visible to one place.
//
// **A builtin's arguments stand on the operand stack while it runs**, at `base ..< base + argc`, and
// are cut off once it answers. The stack is a root, so a builtin that allocates cannot lose them --
// but it may not keep a `Value` it read in a sysl local across anything that could run FunL code.

//
// **A builtin answers a `Fault` when it cannot go on**: an error term for anything the program asked
// that cannot be done (`errors.sysl`), which `catch/3` can catch.
type NativeGo = &Fn(usize, usize) -> Result[Value, Fault]

// A builtin that may fail and may produce more than one value: called with its arguments and a
// cursor, 0 the first time and afterwards whatever its last answer said to resume from.
type GeneratorGo = &Fn(usize, usize, long) -> Result[Answer, Fault]

// What a generating builtin answers.
enum Answer
    // One value, and no other to follow it.
    Gives(x: Value)

    // No value: the call fails.
    Refuses

    // A value, and more to be had by calling again with cursor `next`.
    GivesMore(x: Value, next: long)

// How a generator over a handle begins: called once per call with its arguments, it answers the
// handle holding this call's iteration state (`Handle(p)`), or `None` when there is nothing to
// iterate and the call fails at once.
type StartGo = &Fn(usize, usize) -> Result[Option[Value], Fault]

// How a generator over a handle steps: the next value from the state handle `start` made, or `None`
// when it has run out, which is failure.
type StepGo = &Fn(*HandleObj) -> Result[Option[Value], Fault]

// How a builtin is run.
enum Impl
    // Called with its arguments; answers one value.
    Plain(go: NativeGo)

    // Called with its arguments and a cursor; `NativeGen` runs it.
    Generating(go: GeneratorGo)

    // A generator whose state is a handle: `start` makes it, `step` takes the next value from it.
    // `NativeGen` runs it, with the handle in the cursor's cell (`call_stepping`).
    Stepping(start: StartGo, step: StepGo)

    // A name for a value, `letters`: called with no arguments, once, when a program that names it is
    // compiled.
    Constant(go: NativeGo)

    // Called with its arguments; answers a value, or a function to call with those same arguments in
    // its place (`map(f, xs)`, which the prelude's `map` answers).
    Forwarding(go: ForwardGo)

    // Calls FunL functions back and takes their results (`sortBy`, `zipWith`): run in a frame of its
    // own over the driver chunk `driver_chunk` makes, with `slots` slots for its state, by `go` one
    // turn at a time (`Callback`).
    Calling(go: TurnGo, slots: usize, driver: Option[usize])

// What a forwarding builtin answers: its value, or the function value whose call answers for it.
enum Forward
    Done(x: Value)
    Into(f: Value)

type ForwardGo = &Fn(usize, usize) -> Result[Forward, Fault]

// **A calling builtin never calls FunL from sysl.** Each turn of it is a sysl call that returns: it
// answers, or names a function and the arguments to call it with, and the machine makes that call
// as a bounded expression in the builtin's own frame and starts the next turn with what came of it.
// So no sysl frame is ever suspended under FunL code, and a callback that suspends -- an `await` --
// or backtracks leaves nothing on the sysl stack. Everything a calling builtin keeps from one turn
// to the next is in its frame -- its arguments and its slots -- where the collector sees it.

// What came of the turn before.
enum Called
    // Nothing yet: the first turn.
    Begun

    // The function called last answered `x`: its first result, its choice points discarded.
    Returned(x: Value)

    // The function called last failed.
    Missed

// What a turn answers: the builtin's value, or a function to call and the arguments to call it with.
enum Turn
    Answered(x: Value)
    Calls(f: Value, args: Buf[Value])

type TurnGo = &Fn(*FrameObj, Called) -> Result[Turn, Fault]

// The arity of a builtin that takes any number of arguments.
const Variadic: usize = 4294967295

// **`least` is the fewest arguments a call may give and `arity` the most**: the two are equal for
// every builtin but one whose trailing arguments are optional, `stringify(v)` and
// `stringify(v, indent)`. Unlike `Variadic`, a range is bounded, so Prolog sees one predicate per
// count it allows (`prolog_builtin_module`).
struct Native
    name: string
    least: usize
    arity: usize
    how: Impl

// Add a builtin to `v`'s table and answer its id.
register(v: *Vm, name: string, arity: usize, go: NativeGo) -> usize
    v.natives.push(Native(name, arity, arity, Plain(go)))
    v.natives.len() - 1

// Add a builtin taking from `least` to `most` arguments, the ones past `least` optional.
register_between(v: *Vm, name: string, least: usize, most: usize, go: NativeGo) -> usize
    v.natives.push(Native(name, least, most, Plain(go)))
    v.natives.len() - 1

// Add a builtin that may fail or generate.
register_generator(v: *Vm, name: string, arity: usize, go: GeneratorGo) -> usize
    v.natives.push(Native(name, arity, arity, Generating(go)))
    v.natives.len() - 1

// Add a generator over a handle: each call makes a fresh state handle with `start` and takes values
// from it with `step`, one per resumption, until `step` runs out (see `call_stepping`).
register_stepping(v: *Vm, name: string, arity: usize, start: StartGo, step: StepGo) -> usize
    v.natives.push(Native(name, arity, arity, Stepping(start, step)))
    v.natives.len() - 1

// Let a call of builtin `id` leave out its arguments past the first `least`, as `register_between`
// does for a plain builtin: for one that generates, `run(program)` beside `run(program, args)`.
optional_past(v: *Vm, id: usize, least: usize)
    var n = v.natives.at(id)

    n.least = least
    v.natives.set(id, n)

// Add a builtin that may hand its call on to a function value.
register_forwarding(v: *Vm, name: string, arity: usize, go: ForwardGo) -> usize
    v.natives.push(Native(name, arity, arity, Forwarding(go)))
    v.natives.len() - 1

// Add a builtin that calls FunL functions back, keeping its state in `slots` slots of its frame.
register_calling(v: *Vm, name: string, arity: usize, slots: usize, go: TurnGo) -> usize
    v.natives.push(Native(name, arity, arity, Calling(go, slots, None)))
    v.natives.len() - 1

// The chunk calling builtin `id`'s frame runs, made the first time it is called and named after it:
//
//     0: Callback(id, false)    the first turn, or the next with the call's result on top
//     1: UnmarkKeep             the call has answered: its first result, its choice points gone
//     2: Branch(0)
//     3: Callback(id, true)     the call failed
//
// A turn that calls pushes a `Mark` failing to `CallbackMissed`, sets `ip` to `CallbackReturns` and
// calls, so the callee returns to the `UnmarkKeep`.
driver_chunk(id: usize) -> Result[usize, string]
    val v = current()
    val n = v.natives.at(id)

    val (go, slots) = n.how match
        Calling(g, k, d) ->
            d match
                Some(c) -> return Ok(c)
                None -> ()

            (g, k)
        _ -> return Err(s"'${n.name}' does not call back")

    var e = emit(n.name)
    val top = e.label()

    e.place(top)
    e.op(Callback(id, false))
    e.op(UnmarkKeep)
    e.op(Branch(top))
    e.op(Callback(id, true))

    val c = finish(e)?

    v.natives.set(id, Native(n.name, n.least, n.arity, Calling(go, slots, Some(c))))
    Ok(c)

// Where a calling builtin's callee returns to, and where its failure resumes (`driver_chunk`).
const CallbackReturns: usize = 1
const CallbackMissed: usize = 3

// Add a name for the value `go` makes.
register_constant(v: *Vm, name: string, go: NativeGo) -> usize
    v.natives.push(Native(name, 0, 0, Constant(go)))
    v.natives.len() - 1

// Whether a call of builtin `n` may give `argc` arguments.
takes_count(n: Native, argc: usize) -> bool = n.arity == Variadic || (argc >= n.least && argc <= n.arity)

// How many arguments builtin `n` takes, for a refusal: "2 arguments", "1 or 2 arguments".
takes_text(n: Native) -> string
    if n.least == n.arity then return counted(n.arity, "argument")
    if n.least + 1 == n.arity then return s"${n.least} or ${n.arity} arguments"

    s"${n.least} to ${n.arity} arguments"

// Whether builtin `id` names a value rather than something to call.
is_constant(id: usize) -> bool = current().natives.at(id).how match
    Constant(_) -> true
    _ -> false

// Whether builtin `id` is run by `NativeGen`.
is_generator(id: usize) -> bool = current().natives.at(id).how match
    Generating(_) -> true
    Stepping(_, _) -> true
    _ -> false

// Whether builtin `id`, named without a call, is a function value: every builtin but Prolog's
// `consult` and the constants.
is_function_value(id: usize) -> bool
    val n = current().natives.at(id)

    n.how match
        Constant(_) -> return false
        _ -> ()

    n.name != "consult"

// The chunk a builtin's function value calls: its arguments passed to the builtin exactly as a call
// written with them would pass them, and the builtin's answer returned -- each of a generator's
// answers, as a generating function's are. A fixed-arity builtin's value has its arity, so a call
// through it with any other count is refused as a call of a function value is; a variadic builtin's
// value passes on whatever it is given, and the builtin's own count check answers. Made once per builtin.
value_chunk(id: usize) -> Result[usize, string]
    val v = current()

    v.native_chunks.get(id) match
        Some(c) -> return Ok(c)
        None -> ()

    val n = v.natives.at(id)
    var e = emit_function(n.name, if n.arity == Variadic then AnyArity else n.arity)

    if n.arity == Variadic
        e.op(LoadArgs)
    else
        for i in 0..<n.arity
            e.op(LoadArg(i))

    if is_generator(id)
        e.op(PushInt(0))
        e.op(NativeGen(id, n.arity))
    else
        e.op(Native(id, n.arity))

    e.op(Return)

    val c = finish(e)?

    v.native_chunks.put(id, c)
    Ok(c)

// The id of the builtin called `name`, if there is one.
native_id(name: string) -> Option[usize]
    val v = current()

    for i in 0..<v.natives.len()
        if v.natives.at(i).name == name then return Some(i)

    None

// Argument `i` of a builtin whose arguments start at `base`.
arg(base: usize, i: usize) -> Value = current().stack.at(base + i)

// Ask that `a` and `b` be unified once a generating builtin has answered: after the choice point a
// `GivesMore` pushes, so failure back into the builtin undoes the bindings of the answer it gave.
// Unifying inside the builtin instead binds before that choice point exists, and the bindings would
// outlive the answer. The pair waits on the operand stack, above the builtin's cursor.
unify_on_answer(a: Value, b: Value)
    val v = current()

    v.stack.push(a)
    v.stack.push(b)
