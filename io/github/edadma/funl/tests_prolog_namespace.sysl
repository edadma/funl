module io.github.edadma.funl
@tests

import sysl.text.Search

// One namespace for Prolog and FunL, keyed by name and arity (`prolog.md` § "Calling FunL from
// Prolog"): a FunL function of n parameters is the predicate `f/(n+1)` and a relation of n arguments
// `r/n`, and a second definition of a key is refused when it is loaded, naming both. The library
// written in Prolog gives way to a program's own definition; a builtin is never redefined.

// Whether `text` holds `part`.
private has(text: string, part: string) -> bool = text.index_of(part).is_some()

// The FunL line importing `file`.
private import_of(file: string) -> string = s"import \"$file\"\n"

@test
A_FUNL_FUNCTION_ON_THE_KEY_OF_A_PROLOG_PREDICATE_IS_REFUSED_NAMING_BOTH()
    val d = scratch()
    defer scrap(d)

    assert_eq(complaints(import_interop(d) + "def grand(x) = x\nwrite(1)\n"),
        s"error 2:5 `grand/2` cannot be defined twice: the Prolog predicate `grand/2` at $d/interop.pl:1:1, " +
        "and the FunL function `grand` at test.funl:2:5, which is `grand/2` to Prolog. Prolog and FunL share one predicate for each name and arity\n")

@test
A_FUNL_RELATION_ON_THE_KEY_OF_A_PROLOG_PREDICATE_IS_REFUSED_NAMING_BOTH()
    val d = scratch()
    defer scrap(d)

    assert_eq(complaints(import_interop(d) + "def either(#left)\nwrite(1)\n"),
        s"error 2:5 `either/1` cannot be defined twice: the Prolog predicate `either/1` at $d/interop.pl:3:1, " +
        "and the FunL relation `either` at test.funl:2:5. Prolog and FunL share one predicate for each name and arity\n")

@test
A_FUNL_DEFINITION_ON_ANOTHER_ARITY_OF_THE_SAME_NAME_IS_ITS_OWN_PREDICATE()
    val d = scratch()
    defer scrap(d)

    // `grand` of 2 parameters is `grand/3`, which nothing else defines; `either/1` stays Prolog's.
    assert_eq(ran_funl(import_interop(d) + "def grand(x, y) = x + y\nfree z\nwrite(grand(1, 2))\nevery either(z) do write(z)\n"),
        "loaded\n3\nleft\nright\nsucceeded")

@test
A_FUNL_DEFINITION_ON_THE_KEY_OF_A_DYNAMIC_PREDICATE_IS_REFUSED()
    val d = scratch()
    defer scrap(d)

    val a = put(d, "clash_a.pl", ClashAPl)

    assert_eq(complaints(import_of(a) + "def counter(#one)\nwrite(1)\n"),
        s"error 2:5 `counter/1` cannot be defined twice: the dynamic predicate `counter/1` declared at $a:2:4, " +
        "and the FunL relation `counter` at test.funl:2:5. Prolog and FunL share one predicate for each name and arity\n")

@test
A_SECOND_PROLOG_FILE_DEFINING_THE_SAME_PREDICATE_IS_REFUSED_NAMING_BOTH()
    val d = scratch()
    defer scrap(d)

    val a = put(d, "clash_a.pl", ClashAPl)
    val b = put(d, "clash_b.pl", ClashBPl)
    val said = rendered(import_of(a) + import_of(b) + "write(1)\n")

    assert_eq(has(said, s"`$b` could not be loaded"), true)
    assert_eq(has(said, s"`shared/1` cannot be defined twice: the Prolog predicate `shared/1` at $a:1:1, " +
        s"and the Prolog predicate `shared/1` at $b:1:1"), true)

@test
A_PROLOG_FILE_GIVING_CLAUSES_TO_ANOTHER_FILES_DYNAMIC_PREDICATE_IS_REFUSED()
    val d = scratch()
    defer scrap(d)

    val a = put(d, "clash_a.pl", ClashAPl)
    val c = put(d, "clash_c.pl", ClashCPl)
    val said = rendered(import_of(a) + import_of(c) + "write(1)\n")

    assert_eq(has(said, s"`counter/1` cannot be defined twice: the dynamic predicate `counter/1` declared at $a:2:4, " +
        s"and the Prolog predicate `counter/1` at $c:1:1"), true)

@test
A_FILE_CONSULTED_WHILE_THE_PROGRAM_RUNS_IS_REFUSED_A_KEY_THE_PROGRAM_DEFINES()
    val d = scratch()
    defer scrap(d)

    val a = put(d, "clash_a.pl", ClashAPl)
    val said = ran_funl(s"def shared(#mine)\nwrite(#before)\nconsult(\"$a\")\nwrite(#after)\n")

    assert_eq(has(said, "before\n"), true)
    assert_eq(has(said, "after"), false)
    assert_eq(has(said, "`shared/1` cannot be defined twice: the FunL relation `shared` at test.funl:1:5, " +
        s"and the Prolog predicate `shared/1` at $a:1:1"), true)

@test
PROLOG_CONSULTING_A_SECOND_FILE_THAT_DEFINES_THE_SAME_PREDICATE_GETS_AN_ERROR_IT_CAN_CATCH()
    val d = scratch()
    defer scrap(d)

    val a = put(d, "clash_a.pl", ClashAPl)
    val b = put(d, "clash_b.pl", ClashBPl)
    val text = s":- consult(\"$a\").\n" +
        s":- catch(consult(\"$b\"), error(E, _), (functor(E, F, _), write(F), nl)).\n" +
        ":- forall(shared(X), (write(X), nl)).\n"

    assert_eq(ran_prolog(text), "permission_error\na\nsucceeded")

@test
IMPORTING_THE_SAME_FILE_TWICE_LOADS_IT_ONCE_AND_IS_NO_COLLISION()
    val d = scratch()
    defer scrap(d)

    val interop = import_interop(d)

    assert_eq(ran_funl(interop + interop + "free z\nevery either(z) do write(z)\n"), "loaded\nleft\nright\nsucceeded")

@test
CONSULTING_THE_SAME_FILE_AGAIN_REPLACES_ITS_PREDICATES_AND_IS_NO_COLLISION()
    val d = scratch()
    defer scrap(d)

    val hello = put(d, "hello.pl", HelloPl)
    val text = s":- consult(\"$hello\").\n:- consult(\"$hello\").\n:- forall(greeting(G), (write(G), nl)).\n"

    assert_eq(ran_prolog(text), "hello\nworld\nhello\nworld\nhello\nworld\nsucceeded")

// Clauses calling a library predicate and a builtin, beside which the FunL program importing the file
// defines functions of the same names.
private const LibraryUserPl: string = "rev(L, R) :- reverse(L, R).\nsrt(L, S) :- sort(L, S).\n"

@test
A_FUNL_DEFINITION_REPLACES_THE_LIBRARYS_FOR_PROLOG_TOO()
    val d = scratch()
    defer scrap(d)

    val user = put(d, "library_user.pl", LibraryUserPl)
    val text = import_of(user) + "def reverse(l) = #mine\nfree r\nif rev([1, 2], r) then write(r)\nwrite(reverse([1, 2]))\n"

    assert_eq(ran_funl(text), "mine\nmine\nsucceeded")

@test
A_FUNL_DEFINITION_ON_A_BUILTINS_KEY_IS_FUNLS_OWN_AND_PROLOG_KEEPS_THE_BUILTIN()
    val d = scratch()
    defer scrap(d)

    val user = put(d, "library_user.pl", LibraryUserPl)
    val text = import_of(user) + "def sort(l) = #mine\nfree s\nwrite(sort([2, 1]))\nif srt([2, 1, 2], s) then write(s)\n"

    assert_eq(ran_funl(text), "mine\n[1, 2]\nsucceeded")

@test
A_PROLOG_FILE_DEFINING_A_BUILTIN_IS_REFUSED()
    assert_eq(prolog_complaints("atom_length(a, 1).\nok.\n"), "error 1:1 `atom_length/2` is a builtin predicate, and a program cannot define it\n")
    assert_eq(prolog_complaints("catch(_, _, _) :- true.\n"), "error 1:1 `catch/3` is a builtin predicate, and a program cannot define it\n")
