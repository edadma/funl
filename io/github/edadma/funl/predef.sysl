module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// The general builtins: `error`, `throw`, `abs`, `min`, `max`, `odd`, `even` and `sum`.

install_predef(v: *Vm)
    register(v, "error", 1, do_error)
    register(v, "throw", 1, do_throw)
    register(v, "abs", 1, do_abs)
    register(v, "min", Variadic, do_min)
    register(v, "max", Variadic, do_max)
    register_generator(v, "odd", 1, (b, n, c) -> parity("odd", b, 1))
    register_generator(v, "even", 1, (b, n, c) -> parity("even", b, 0))
    register(v, "sum", 1, do_sum)

// `error(x)`: raise `error(user_error(x), _)`, whose message is `x` as it prints. It is an error, not a
// failure: only a `catch` stops it.
private do_error(base: usize, argc: usize) -> Result[Value, Fault]
    val x = arg(base, 0)

    Err(user_error(x, render(x)))

// `throw(x)`: raise `x` itself, as Prolog's `throw/1` does -- the ball a `catch` sees is `x`, not an
// error term around it.
private do_throw(base: usize, argc: usize) -> Result[Value, Fault]
    val x = deref(arg(base, 0))

    x match
        Var(_) -> Err(instantiation_error("instantiation error: 'throw' was given an unbound variable"))
        _ -> Err(Thrown(x))

private do_abs(base: usize, argc: usize) -> Result[Value, Fault]
    val x = arg(base, 0)

    val y = deref(x)

    num_of(y) match
        Some(n) -> num_result(funl_policy().abs(n), s"abs(${render(y)})", y)
        None -> y match
            Var(_) -> Err(instantiation_error("instantiation error: 'abs' was given an unbound variable"))
            _ -> Err(type_error("number", y, s"'abs' wants a number and was given ${described(x)}"))

private do_min(base: usize, argc: usize) -> Result[Value, Fault] = extreme(base, argc, "min", Lt)

private do_max(base: usize, argc: usize) -> Result[Value, Fault] = extreme(base, argc, "max", Gt)

// The argument every other one is not `better` than: the least for `<`, the greatest for `>`.
private extreme(base: usize, argc: usize, name: string, better: BinOp) -> Result[Value, Fault]
    if argc == 0 then return Err(wrong_count(name, 0, s"'$name' wants at least one argument"))

    var best = arg(base, 0)

    for i in 1..<argc
        val x = arg(base, i)

        val wins = arith(better, x, best)?

        if wins.is_some() then best = x

    Ok(best)

// `odd(n)` and `even(n)`: `n` itself when it has the parity asked for, and failure when it does not.
// Only an integer, of either size, has a parity.
private parity(name: string, base: usize, want: long) -> Result[Answer, Fault]
    val x = deref(arg(base, 0))

    x match
        Var(_) -> return Err(instantiation_error(s"instantiation error: '$name' was given an unbound variable"))
        _ -> ()

    if !is_int(x) then return Err(kind_error(x, "integer", s"'$name' wants an integer and was given ${described(x)}"))

    val r = arith(Rem, x, Int(2))?

    r match
        Some(Int(k)) -> Ok(if k == want || k == -want then Gives(x) else Refuses)
        _ -> Err(Broken(s"'$name' could not take a remainder"))

// `sum(c)`: the elements of a list, range, tuple, set, array or buffer added with `+`; 0 for none.
private do_sum(base: usize, argc: usize) -> Result[Value, Fault]
    var items: Buf[Value] = buf()

    list_guard(arg(base, 0), "'sum'")?
    elements(arg(base, 0), "'sum'", &items)?

    var total: Value = Int(0)

    for e in items.view()
        val x = deref(e)

        if !is_num(x)
            x match
                Var(_) -> return Err(instantiation_error("instantiation error: 'sum' was given an unbound variable"))
                _ -> return Err(type_error("number", x, s"'sum' wants numbers and was given ${described(x)}"))

        total = arith(Add, total, x)?.unwrap()

    Ok(total)
