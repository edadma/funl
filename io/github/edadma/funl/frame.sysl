module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// Calls and returns.
//
// **No FunL call becomes a sysl call.** A call makes a heap frame and moves `ip`; a return moves it
// back. The whole of a suspended computation is therefore data -- entries, saved cells, frames --
// which can be restored, collected and inspected.

// Pop `argc` values, the deepest first, into a fresh buffer.
private pop_args(v: *Vm, argc: usize) -> Result[Buf[Value], string]
    val n = v.stack.len()

    if argc > n then return Err(s"a call wants $argc arguments and the operand stack holds $n")

    var args: Buf[Value] = buf()

    for i in n - argc..<n
        args.push(v.stack.at(i))

    v.stack.truncate(n - argc)
    Ok(args)

private check_target(v: *Vm, target: usize) -> Result[unit, string]
    if target >= v.chunks.len() then return Err(s"a call names chunk $target, and there are ${v.chunks.len()}")

    Ok(())

// Call chunk `target` with the top `argc` values, returning to `v.ip` (already past the call).
//
// **The frame is allocated before the arguments leave the stack**, so they are rooted while the
// allocation runs -- and allocation never collects in any case.
call(v: *Vm, target: usize, argc: usize) -> Result[unit, string]
    check_target(v, target)?

    val f = new_frame(target)?

    f.args = pop_args(v, argc)?
    f.caller = v.frame
    f.return_ip = v.ip
    f.caller_mark = v.mark
    f.entry = v.control.len()
    f.cut = v.control.len()
    v.allocated += argc * sizeof(Value)

    v.frame = f
    v.code = target
    v.ip = 0
    Ok(())

// A call in tail position. When nothing resumable was made in the running frame, the frame is reused
// for the callee and the caller's return point is kept; otherwise it is an ordinary call, whose value
// comes back to the `Return` that always follows a `TailCall`.
tail_call(v: *Vm, target: usize, argc: usize) -> Result[unit, string]
    val f = v.frame

    if f == null || f.caller == null || v.control.len() != f.entry then return call(v, target, argc)

    check_target(v, target)?

    f.args = pop_args(v, argc)?
    f.slots.clear()
    f.chunk = target
    f.cut = v.control.len()

    v.code = target
    v.ip = 0
    Ok(())

// Return the top of the stack to the caller.
//
// **A return that leaves entries behind pushes a `Restore`**, saving the caller's operand cells from
// the caller's innermost mark to the top. The caller then pops its own operands -- cells below the
// callee's marks -- while the callee's choice points are still resumable; backtracking meets the
// `Restore` first, puts those cells back, and keeps failing into the callee as if it had never
// returned. A return that leaves nothing behind pushes nothing.
ret(v: *Vm) -> Result[unit, string]
    val f = v.frame

    if f == null || f.caller == null then return Err("Return with no caller to return to")

    val value = v.stack.pop() match
        Some(x) -> x
        None -> return Err("Return with nothing on the operand stack")

    if v.control.len() > f.entry
        push_entry(v, Restore, 0, floor_of(v, f.caller_mark))

    v.mark = f.caller_mark
    v.ip = f.return_ip
    v.frame = f.caller
    v.code = f.caller.chunk
    v.stack.push(value)
    Ok(())

// A deterministic exit: discard everything the frame made, then return.
ret_commit(v: *Vm) -> Result[unit, string]
    val f = v.frame

    if f == null || f.caller == null then return Err("Return with no caller to return to")

    cut_to(v, f.entry)
    ret(v)

// Size the running frame's slots to `n`, every one `Undefined`.
size_frame(v: *Vm, n: usize) -> Result[unit, string]
    val f = v.frame

    if f == null then return Err("Frame with no frame running")

    f.slots.clear()

    for _ in 0..<n
        f.slots.push(Undefined)

    v.allocated += n * sizeof(Value)
    Ok(())

// The frame `depth` static links up from the running one.
frame_up(v: *Vm, depth: usize) -> Result[*FrameObj, string]
    var f = v.frame

    for _ in 0..<depth
        if f == null then break

        f = f.up

    if f == null then return Err(s"no frame $depth static links up")

    Ok(f)

slot_of(f: *FrameObj, slot: usize) -> Result[Value, string]
    if slot >= f.slots.len() then return Err(s"slot $slot of a frame with ${f.slots.len()}")

    Ok(f.slots.at(slot))

set_slot(f: *FrameObj, slot: usize, x: Value) -> Result[unit, string]
    if slot >= f.slots.len() then return Err(s"slot $slot of a frame with ${f.slots.len()}")

    f.slots.set(slot, x)
    Ok(())
