module io.github.edadma.funl

import sh.sysl.parsing.counted
import sysl.buf.{Buf, buf}

// Calls and returns.
//
// **No FunL call becomes a sysl call.** A call makes a heap frame and moves `ip`; a return moves it
// back. The whole of a suspended computation is therefore data -- entries, saved cells, frames --
// which can be restored, collected and inspected.

// Pop `argc` values, the deepest first, into a fresh buffer.
private pop_args(v: *Vm, argc: usize) -> Result[Buf[Value], string]
    val n = v.stack.len()

    if argc > n then return Err(s"a call wants $argc arguments and the operand stack holds $n")

    var args: Buf[Value] = buf()

    for i in n - argc..<n
        args.push(v.stack.at(i))

    v.stack.truncate(n - argc)
    Ok(args)

// A call of chunk `target` with `argc` arguments is one it can take: the chunk exists, and a
// function's arity is met.
private check_target(v: *Vm, target: usize, argc: usize) -> Result[unit, Fault]
    if target >= v.chunks.len() then return Err(Broken(s"a call names chunk $target, and there are ${v.chunks.len()}"))

    val c = v.chunks.at(target)

    if c.arity != AnyArity && c.arity != argc
        return Err(wrong_count(c.name, argc, s"'${c.name}' takes ${counted(c.arity, "argument")} and was given $argc"))

    Ok(())

// Call chunk `target` with the top `argc` values, returning to `v.ip` (already past the call).
call(v: *Vm, target: usize, argc: usize) -> Result[unit, Fault] = open_frame(v, target, argc, null)

// Call function chunk `target`, whose static link is the frame `up` names (see `link`).
call_fn(v: *Vm, target: usize, argc: usize, up: usize) -> Result[unit, Fault] = open_frame(v, target, argc, link(v, up)?)

// The frame a `MakeClosure`, a `CallFn` or a `LoadSlot` names: `up` static links above the running frame, the
// top level's frame for `TopUp`, or that of a FunL file Prolog imported for `file_up(m)`.
link(v: *Vm, up: usize) -> Result[*FrameObj, string]
    if up == TopUp then return Ok(v.globals)

    if up >= TopUp - FileUps
        val m = TopUp - 1 - up
        val f = if m < v.funl_tops.len() then v.funl_tops.at(m) else null

        if f == null then return Err("a FunL file's function was called before the file's top level ran")

        return Ok(f)

    frame_up(v, up)

// Push a function value over `target`, made in the frame `up` names.
make_closure(v: *Vm, target: usize, up: usize) -> Result[unit, string]
    v.stack.push(new_closure(target, link(v, up)?)?)
    Ok(())

// A new frame for `target` over the top `argc` values, with static link `up`.
//
// **The frame is allocated before the arguments leave the stack**, so they are rooted while the
// allocation runs -- and allocation never collects in any case.
//
// **An `async` function's call starts a task instead** (`task.sysl`), and every call path comes
// through here -- a direct call, a call through a value, a tail call, a builtin's callback -- so no
// `await` ever runs in a frame a sysl call made.
private open_frame(v: *Vm, target: usize, argc: usize, up: *FrameObj) -> Result[unit, Fault]
    check_target(v, target, argc)?

    if v.chunks.at(target).is_async then return start_async(v, target, argc, up)

    val f = new_frame(target)?

    f.args = pop_args(v, argc)?
    f.base = v.stack.len()
    f.up = up
    f.caller = v.frame
    f.return_ip = v.ip
    f.caller_mark = v.mark
    f.entry = v.control.len()
    f.cut = v.control.len()
    v.allocated += argc * sizeof(Value)

    v.frame = f
    v.code = target
    v.ip = 0
    Ok(())

// A call in tail position. When nothing resumable was made in the running frame, the frame is reused
// for the callee and the caller's return point is kept; otherwise it is an ordinary call, whose value
// comes back to the `Return` that always follows a `TailCall`.
tail_call(v: *Vm, target: usize, argc: usize) -> Result[unit, Fault] = tail_into(v, target, argc, null)

tail_call_fn(v: *Vm, target: usize, argc: usize, up: usize) -> Result[unit, Fault] = tail_into(v, target, argc, link(v, up)?)

// **A frame is reused only when nothing can see it afterwards**: no entry above its own (nothing
// resumable was made in it), no function value captured it, and the callee's static link is not
// this very frame -- a function defined inside the running one reads the running one's slots.
private tail_into(v: *Vm, target: usize, argc: usize, up: *FrameObj) -> Result[unit, Fault]
    val f = v.frame

    // An `async` callee starts a task, whose promise the `Return` after the `TailCall` returns.
    if f == null || f.caller == null || v.control.len() != f.entry || f.captured || up == f || is_async_chunk(v, target)
        return open_frame(v, target, argc, up)

    check_target(v, target, argc)?

    f.args = pop_args(v, argc)?
    f.slots.clear()
    f.chunk = target
    f.up = up
    f.cut = v.control.len()
    f.fail_to = NoMark

    v.code = target
    v.ip = 0
    Ok(())

private is_async_chunk(v: *Vm, target: usize) -> bool = target < v.chunks.len() && v.chunks.at(target).is_async

// Call the function value beneath the top `argc` values, in tail position when `tail`. False where
// the callee was a collection and held nothing under the key: the call fails.
call_value(v: *Vm, argc: usize, tail: bool) -> Result[bool, Fault]
    val n = v.stack.len()

    if argc >= n then return Err(Broken(s"a call wants a function and $argc arguments and the operand stack holds $n"))

    val callee = deref(v.stack.at(n - argc - 1))

    val c = callee match
        Func(p) -> p
        Ctor(id) ->
            // A constructor called through a value: its record, made of the arguments once the
            // callee's cell is gone from under them.
            for i in n - argc..<n
                v.stack.set(i - 1, v.stack.at(i))

            v.stack.truncate(n - 1)
            make_record(v, usize(id), argc)?
            return Ok(true)
        _ ->
            callee match
                Var(_) -> return Err(instantiation_error("instantiation error: an unbound variable was called"))
                _ -> ()

            if !indexable(callee)
                return Err(type_error("callable", callee, s"${described(callee)} is not a function, and cannot be called"))

            // `c(i)`: an element, which a tail call's `Return` then returns like any value.
            if argc != 1
                return Err(domain_error("one_key", callee, s"${described(callee)} is indexed by one key, and was given $argc arguments"))

            val found = element_get(callee, v.stack.at(n - 1))?

            v.stack.truncate(n - 2)

            found match
                Some(x) ->
                    v.stack.push(x)
                    return Ok(true)
                None -> return Ok(false)

    // The callee's cell goes, the arguments close up over it; the closure stays reachable through
    // `c` for the frame being made, and nothing collects before the frame holds it.
    for i in n - argc..<n
        v.stack.set(i - 1, v.stack.at(i))

    v.stack.truncate(n - 1)

    if tail then tail_into(v, c.chunk, argc, c.up)? else open_frame(v, c.chunk, argc, c.up)?

    Ok(true)

// Whether a value is reached by call syntax, `c(i)`: a list, a range, a tuple, a string, a byte
// string, an array, a buffer, a map or a record.
private indexable(x: Value) -> bool = x match
    Nil -> true
    Cons(_) -> true
    Range(_) -> true
    Tuple(_) -> true
    Unit -> true
    Str(_) -> true
    Bytes(_) -> true
    Array(_) -> true
    Buffer(_) -> true
    Map(_) -> true
    MutMap(_) -> true
    Compound(_) -> true
    _ -> false

// No clause of the running function took its arguments.
//
// **`existence_error(matching_clause, Name/Arity)`**: the function exists, and no clause of it is
// there for these arguments. The message shows the arguments.
no_match(v: *Vm) -> Result[unit, Fault]
    val f = v.frame
    val name = v.chunks.at(f.chunk).name
    var shown = ""

    for i in 0..<f.args.len()
        if i > 0 then shown = shown + ", "

        shown = shown + render(f.args.at(i))

    val p = indicator(name, f.args.len())?

    Err(existence_error("matching_clause", p, s"argument match not found: no clause of '$name' matches ($shown)"))

// Return the top of the stack to the caller.
//
// **A return that leaves entries behind pushes a `Restore`**, saving the caller's operand cells from
// the caller's innermost mark to the top. The caller then pops its own operands -- cells below the
// callee's marks -- while the callee's choice points are still resumable; backtracking meets the
// `Restore` first, puts those cells back, and keeps failing into the callee as if it had never
// returned. A return that leaves nothing behind pushes nothing.
ret(v: *Vm) -> Result[unit, string]
    val f = v.frame

    if f == null || f.caller == null then return Err("Return with no caller to return to")

    val value = v.stack.pop() match
        Some(x) -> x
        None -> return Err("Return with nothing on the operand stack")

    // A `yield` inside an expression returns with that expression's operands still standing above
    // the frame's base; the `Restore` has saved them, and the caller must not see them.
    if v.control.len() > f.entry
        push_entry(v, Restore, 0, floor_of(v, f.caller_mark))

    if v.stack.len() > f.base then v.stack.truncate(f.base)

    v.mark = f.caller_mark
    v.ip = f.return_ip
    v.frame = f.caller
    v.code = f.caller.chunk
    v.stack.push(value)
    Ok(())

// A deterministic exit: discard everything the frame made, and any operands it left part-way
// through an expression, then return.
ret_commit(v: *Vm) -> Result[unit, string]
    val f = v.frame

    if f == null || f.caller == null then return Err("Return with no caller to return to")

    val value = v.stack.pop() match
        Some(x) -> x
        None -> return Err("Return with nothing on the operand stack")

    cut_to(v, f.entry, false)

    if v.stack.len() > f.base then v.stack.truncate(f.base)

    v.stack.push(value)
    ret(v)

// Size the running frame's slots to `n`, every one `Undefined`, and take away its failure target: a
// clause that runs under a mark, and every chunk that is not a function's, has none.
size_frame(v: *Vm, n: usize) -> Result[unit, string]
    val f = v.frame

    if f == null then return Err("Frame with no frame running")

    f.fail_to = NoMark
    f.slots.clear()

    for _ in 0..<n
        f.slots.push(Undefined)

    v.allocated += n * sizeof(Value)
    Ok(())

// `FrameHead`, after `size_frame`: the clause's head, from here to `body`, fails to `next`. The frame
// is running, so `size_frame` has already refused a missing one.
head_target(v: *Vm, next: usize, body: usize, resume: usize)
    val f = v.frame

    f.fail_to = next
    f.head_end = body
    f.head_floor = v.stack.len()
    f.resume = resume

// Failure in a mark-free clause head: the running frame has a failure target, has made no entry, and
// the instruction that failed -- the one before `v.ip` -- lies in the head of the clause running in
// it. Then the head's cells go and the next clause starts, which is everything the clause's mark
// would have done: with no entry above the frame's own, there is no trail and no saved cell to undo.
//
// **Where the head has a `resume`, the next clause's `FrameHead` and its shared prefix are not run
// again** (`reuse_slots`): the failure takes that `FrameHead`'s size and targets itself and resumes
// the next head after the slots this one already bound. Every other slot is still `Undefined`, since
// this head wrote none but those, so sizing the frame to the next clause's count leaves it exactly as
// `FrameHead` and the prefix would have.
head_fails(v: *Vm) -> bool
    val f = v.frame

    if f == null || f.fail_to == NoMark || v.control.len() != f.entry || v.code != f.chunk || v.ip > f.head_end
        return false

    v.stack.truncate(f.head_floor)

    if f.resume != NoMark
        v.chunks.at(v.code).code.at(f.fail_to) match
            FrameHead(n, next, body, resume) ->
                if f.slots.len() > n
                    f.slots.truncate(n)
                else
                    v.allocated += (n - f.slots.len()) * sizeof(Value)

                    while f.slots.len() < n
                        f.slots.push(Undefined)

                v.ip = f.resume
                f.fail_to = next
                f.head_end = body
                f.resume = resume
                return true
            _ -> ()

    v.ip = f.fail_to
    true

// The frame `depth` static links up from the running one.
frame_up(v: *Vm, depth: usize) -> Result[*FrameObj, string]
    var f = v.frame

    for _ in 0..<depth
        if f == null then break

        f = f.up

    if f == null then return Err(s"no frame $depth static links up")

    Ok(f)

slot_of(f: *FrameObj, slot: usize) -> Result[Value, string]
    if slot >= f.slots.len() then return Err(s"slot $slot of a frame with ${f.slots.len()}")

    Ok(f.slots.at(slot))

set_slot(f: *FrameObj, slot: usize, x: Value) -> Result[unit, string]
    if slot >= f.slots.len() then return Err(s"slot $slot of a frame with ${f.slots.len()}")

    f.slots.set(slot, x)
    Ok(())
