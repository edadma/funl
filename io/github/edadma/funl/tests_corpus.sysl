module io.github.edadma.funl
@tests

import sysl.fs.read_text

// The old implementation's own programs, each a file under `tests/funl/` beside the output it must
// print: `<name>.fl` and `<name>.out`. Each runs on both heaps and must print exactly that and
// succeed.

private corpus(name: string)
    val dir = "tests/funl/"

    val text = read_text(dir + name + ".fl") match
        Ok(t) -> t
        Err(e) -> panic(s"cannot read $dir$name.fl (run the suite from the project root): $e")

    val want = read_text(dir + name + ".out") match
        Ok(t) -> t
        Err(e) -> panic(s"cannot read $dir$name.out: $e")

    assert_eq(ran_funl(text), want + "succeeded")

@test
ANONYMOUS_FUNCTIONS()
    corpus("anonymous_functions")

@test
ANONYMOUS_FUNCTIONS_CURRYING_1()
    corpus("currying_1")

