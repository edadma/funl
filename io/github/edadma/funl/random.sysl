module io.github.edadma.funl

import sysl.buf.{Buf, buf}
import sysl.posix.rand.seed_from_os
import sysl.rand.{Rng, rng}

// Random numbers: the machine's one generator, `random()`, prefix `?`, and the seed.
//
// **The generator is sysl's PCG32** (`sysl.rand`), the same one Prolog's `random/1` draws from, so a
// seeded run repeats within FunL but does not repeat Icon's. It is seeded from the operating system
// the first time anything draws, so every run differs unless the program sets the seed.

install_random(v: *Vm)
    register(v, "random", 0, (b, n) -> Ok(Real(draw_unit())))
    register_between(v, "random_seed", 0, 1, (b, n) -> seed_of(b, n))
    register_generator(v, "$random_pick", 1, (b, n, c) -> pick(b))
    register_generator(v, "$random_key", 1, (b, n, c) -> pick_key(b))

// A value in [0, n) from the machine's generator.
draw_below(n: u64) -> u64
    seed_if_needed()

    current().rng.below(n)

// A real in [0, 1).
draw_unit() -> real
    seed_if_needed()

    current().rng.unit()

private seed_if_needed()
    val v = current()

    if !v.rng_seeded
        reseed(long(seed_from_os().unwrap_or(0)))

private reseed(seed: long)
    val v = current()

    v.rng = rng(u64(seed), 0)
    v.rng_seed = seed
    v.rng_seeded = true

// `random_seed()`: the seed the generator started from, which `random_seed(n)` restarts it from to
// repeat a run; `random_seed(n)` answers `n`.
private seed_of(base: usize, argc: usize) -> Result[Value, Fault]
    seed_if_needed()

    val v = current()

    if argc == 0 then return Ok(Int(v.rng_seed))

    val x = deref(arg(base, 0))

    x match
        Int(n) ->
            reseed(n)
            Ok(x)
        Var(_) -> Err(instantiation_error("instantiation error: 'random_seed' was given an unbound variable"))
        _ -> Err(type_error("integer", x, s"'random_seed' wants a 64-bit integer and was given ${described(x)}"))

// `?x`, the random thing in `x`: an integer from 1 to `x` for a positive integer, a real in [0, 1) for
// 0, a character of a string or cset, a member of a list, range, tuple, set, array or buffer, a value of a map.
// An empty collection or string has none, which is failure.
private pick(base: usize) -> Result[Answer, Fault]
    val x = deref(arg(base, 0))

    x match
        Int(n) ->
            if n < 0 then return Err(domain_error("not_less_than_zero", x, s"'?' wants a count of zero or more and was given $n"))
            if n == 0 then return Ok(Gives(Real(draw_unit())))

            return Ok(Gives(Int(long(draw_below(u64(n))) + 1)))
        Big(_) -> return Err(domain_error("int", x, "'?' counts up to a 64-bit integer, and this one is larger"))
        Var(_) -> return Err(instantiation_error("instantiation error: '?' was given an unbound variable"))
        Map(m) -> return pick_from(m.vals)
        MutMap(m) -> return pick_from(m.vals)
        Array(a) -> return pick_from(a.items)
        Buffer(a) -> return pick_from(a.items)
        Tuple(t) -> return pick_from(t.items)
        Set(s) -> return pick_from(s.items)
        MutSet(s) -> return pick_from(s.items)
        CSet(p) ->
            val k = cset_count(x, p.set, "cannot be listed")?

            if k == 0 then return Ok(Refuses)

            return Ok(Gives(cset_nth(x, p.set, usize(draw_below(u64(k))))?))
        _ -> ()

    val n = size_of(x)?

    if n == 0 then return Ok(Refuses)

    val i = long(draw_below(u64(n)))

    element_at(x, Int(i))? match
        Some(y) -> Ok(Gives(y))
        None -> Ok(Refuses)

// The key a store through `?c` writes: an index into an array, a buffer or another indexed
// collection, or a key of a map. An empty collection has none, which is failure.
private pick_key(base: usize) -> Result[Answer, Fault]
    val x = deref(arg(base, 0))

    x match
        Map(m) -> return pick_from(m.keys)
        MutMap(m) -> return pick_from(m.keys)
        Var(_) -> return Err(instantiation_error("instantiation error: '?' was given an unbound variable"))
        CSet(p) ->
            val k = cset_count(x, p.set, "cannot be listed")?

            if k == 0 then return Ok(Refuses)

            return Ok(Gives(Int(long(draw_below(u64(k))))))
        _ -> ()

    val n = size_of(x)?

    if n == 0 then return Ok(Refuses)

    Ok(Gives(Int(long(draw_below(u64(n))))))

private pick_from(items: Buf[Value]) -> Result[Answer, Fault]
    if items.len() == 0 then return Ok(Refuses)

    Ok(Gives(items.at(usize(draw_below(u64(items.len()))))))

// How many things `?x` chooses among: the elements of a collection or the characters of a string. A
// number or anything else with no elements is a type error.
private size_of(x: Value) -> Result[long, Fault]
    x match
        Str(_) -> length_of(x)
        Nil -> Ok(0)
        Cons(_) -> length_of(x)
        Range(_) -> length_of(x)
        Tuple(_) -> length_of(x)
        Set(_) -> length_of(x)
        MutSet(_) -> length_of(x)
        Array(_) -> length_of(x)
        Buffer(_) -> length_of(x)
        _ -> Err(type_error("collection", x, s"'?' wants a number, a string or a collection and was given ${described(x)}"))
