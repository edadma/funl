module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// Unification, and the head-unification instructions built on it.
//
// **Iterative, with an explicit work list**, so a deep term cannot overflow the sysl stack. The list
// is `Vm.work`, used as a stack of pairs and empty between instructions; nothing here allocates on
// the collected heap, so no collection can run while a value sits in it.

// Push a pair for the running unification to visit. Not `private`: an extension kind whose values
// have parts unifies them through this.
unify_later(a: Value, b: Value)
    val v = current()

    v.work.push(a)
    v.work.push(b)

// Whether two values are the same variable, the same heap object, or the same atomic value.
private identical(a: Value, b: Value) -> bool = a match
    Var(p) -> b match
        Var(q) -> p == q
        _ -> false
    Compound(p) -> b match
        Compound(q) -> p == q
        _ -> false
    Cons(p) -> b match
        Cons(q) -> p == q
        _ -> false
    Str(p) -> b match
        Str(q) -> p == q
        _ -> false
    Tuple(p) -> b match
        Tuple(q) -> p == q
        _ -> false
    Func(p) -> b match
        Func(q) -> p == q
        _ -> false
    Map(p) -> b match
        Map(q) -> p == q
        _ -> false
    MutMap(p) -> b match
        MutMap(q) -> p == q
        _ -> false
    MutSet(p) -> b match
        MutSet(q) -> p == q
        _ -> false
    Array(p) -> b match
        Array(q) -> p == q
        _ -> false
    Buffer(p) -> b match
        Buffer(q) -> p == q
        _ -> false
    Ctor(i) -> b match
        Ctor(j) -> i == j
        _ -> false
    _ -> false

// Unify `a` with `b`, binding variables. Answers false on a mismatch, leaving whatever bindings it
// made on the trail for the failure that follows to undo.
//
// **A variable met with itself succeeds at once** -- the identity test comes first -- so `X ~ X`
// cannot loop. **Kinds are compared before values. When two unbound variables meet, the younger is
// bound to the older** -- by `id`, which is creation order exactly where two stamps can be equal --
// so the binding usually needs no trail entry. There is no occurs check.
unify(a: Value, b: Value) -> bool = unify_with(a, b, false)

// Unify `a` with `b` as `unify` does, but refusing to bind a variable to a term that contains it
// (`unify_with_occurs_check/2`), so the result is never a cyclic term.
unify_checked(a: Value, b: Value) -> bool = unify_with(a, b, true)

private unify_with(a: Value, b: Value, check: bool) -> bool
    val v = current()
    val base = v.work.len()

    unify_later(a, b)

    while v.work.len() > base
        val y = deref(v.work.pop().unwrap())
        val x = deref(v.work.pop().unwrap())

        if !step(x, y, check)
            v.work.truncate(base)
            return false

    true
end unify_with

// One pair, both dereferenced; `check` refuses a binding the occurs check fails.
private step(x: Value, y: Value, check: bool) -> bool
    if identical(x, y) then return true

    x match
        Var(p) ->
            y match
                Var(q) -> if p.id < q.id then bind(q, x) else bind(p, y)
                _ ->
                    if check && occurs_in(x, y) then return false

                    bind(p, y)

            return true
        _ -> ()

    y match
        Var(q) ->
            if check && occurs_in(y, x) then return false

            bind(q, x)
            return true
        _ -> ()

    x match
        Undefined -> y match
            Undefined -> true
            _ -> false
        Nil -> y match
            Nil -> true
            _ -> false
        Int(n) -> y match
            Int(m) -> n == m
            _ -> false

        // **Unification compares numbers by kind and value**, so `1` and `1.0` do not unify, while
        // FunL's `==` and Prolog's `=:=` compare them by value.
        Big(_) -> same_number(x, y)
        Rat(_) -> same_number(x, y)
        Real(_) -> same_number(x, y)
        Atom(i) -> y match
            Atom(j) -> i == j
            _ -> false
        Compound(p) -> y match
            Compound(q) -> unify_args(p, q)
            _ -> false
        Cons(p) -> y match
            Cons(q) ->
                unify_later(p.head, q.head)
                unify_later(p.tail, q.tail)
                true
            _ -> false
        Unit -> y match
            Unit -> true
            _ -> false
        Str(p) -> y match
            Str(q) -> p.s == q.s
            _ -> false
        Tuple(p) -> y match
            Tuple(q) -> unify_items(p, q)
            _ -> false
        Bool(a) -> y match
            Bool(b) -> a == b
            _ -> false

        // Function values unify by identity, which `identical` has already tested.
        Func(_) -> false
        Var(_) -> false

        // A range holds no variable, and a set is unordered: each unifies with what it equals.
        Range(_) -> equal_or_not(x, y)
        Set(_) -> equal_or_not(x, y)
        CSet(_) -> equal_or_not(x, y)

        // A map, a mutable set, an array, a buffer and a constructor are opaque to unification: each
        // unifies only with itself, which `identical` has already tested.
        Map(_) -> false
        MutSet(_) -> false
        MutMap(_) -> false
        Array(_) -> false
        Buffer(_) -> false
        Ctor(_) -> false
end step

// Whether unbound variable `x` occurs anywhere inside term `t`.
private occurs_in(x: Value, t: Value) -> bool
    var work: Buf[Value] = buf()

    work.push(t)

    loop
        val u = work.pop() match
            Some(u) -> deref(u)
            None -> return false

        if identical(x, u) then return true

        u match
            Compound(p) ->
                for a in p.args.view()
                    work.push(a)
            Cons(p) ->
                work.push(p.head)
                work.push(p.tail)
            Tuple(p) ->
                for a in p.items.view()
                    work.push(a)
            _ -> ()

// Whether two values are equal, an instantiation error counting as not.
private equal_or_not(x: Value, y: Value) -> bool = equal_values(x, y, "~") match
    Ok(b) -> b
    Err(_) -> false

private unify_args(p: *CompoundObj, q: *CompoundObj) -> bool
    if p.functor != q.functor || p.args.len() != q.args.len() then return false

    for i in 0..<p.args.len()
        unify_later(p.args.at(i), q.args.at(i))

    true

private unify_items(p: *TupleObj, q: *TupleObj) -> bool
    if p.items.len() != q.items.len() then return false

    for i in 0..<p.items.len()
        unify_later(p.items.at(i), q.items.at(i))

    true

// -- head unification ----------------------------------------------------------------------------

// The value a head instruction reads.
private source(v: *Vm, src: Src) -> Result[Value, string]
    src match
        Arg(i) ->
            val args = v.frame.args

            if i >= args.len() then return Err(s"argument $i of a call that passed ${args.len()}")

            Ok(args.at(i))
        Popped ->
            v.stack.pop() match
                Some(x) -> Ok(x)
                None -> Err("a head instruction found the operand stack empty")

// First occurrence of a head variable: the slot shares the caller's variable, or holds the value.
get_var(v: *Vm, slot: usize, src: Src) -> Result[bool, string]
    set_slot(v.frame, slot, source(v, src)?)?
    Ok(true)

get_value(v: *Vm, slot: usize, src: Src) -> Result[bool, string]
    val x = source(v, src)?

    Ok(unify(slot_of(v.frame, slot)?, x))

// A constant in the head binds an unbound argument to it and compares a bound one -- which is
// exactly unification with the constant.
get_const(v: *Vm, k: usize, src: Src) -> Result[bool, string]
    val x = source(v, src)?
    val consts = v.chunks.at(v.code).consts

    if k >= consts.len() then return Err(s"constant $k of a chunk with ${consts.len()}")

    Ok(unify(consts.at(k), x))

// A compound in the head. **This is the half of head unification a function's parameters never
// have**: an unbound argument is bound to a term built here, so the caller learns the shape.
get_compound(v: *Vm, functor: u32, n: usize, src: Src) -> Result[bool, string]
    val x = deref(source(v, src)?)

    x match
        Var(p) ->
            val c = new_compound(functor, n)?

            for i in 0..<n
                c.args.set(i, Var(new_var()?))

            bind(p, Compound(c))
            push_args(v, c)
            Ok(true)
        Compound(c) ->
            if c.functor != functor || c.args.len() != n then return Ok(false)

            push_args(v, c)
            Ok(true)
        _ -> Ok(false)
end get_compound

// `[]` in a head: an unbound argument is bound to the empty list; a bound one must be an empty list
// or range.
get_nil(v: *Vm, src: Src) -> Result[bool, string]
    deref(source(v, src)?) match
        Var(p) ->
            bind(p, Nil)
            Ok(true)
        Nil -> Ok(true)
        Range(r) -> Ok(range_empty(r))
        _ -> Ok(false)

// `h:t` in a head: an unbound argument is bound to a cell of two fresh variables, so the caller
// learns it is a non-empty list; a bound one must be a non-empty list or range. The tail is pushed,
// then the head, which is on top for the next `Popped`.
get_cons(v: *Vm, src: Src) -> Result[bool, string]
    deref(source(v, src)?) match
        Var(p) ->
            val head = Var(new_var()?)
            val tail = Var(new_var()?)

            bind(p, new_cons(head, tail)?)
            v.stack.push(tail)
            v.stack.push(head)
            Ok(true)
        Cons(c) ->
            v.stack.push(c.tail)
            v.stack.push(c.head)
            Ok(true)
        Range(r) ->
            if range_empty(r) then return Ok(false)

            v.stack.push(range_rest(r)?)
            v.stack.push(Int(r.from))
            Ok(true)
        _ -> Ok(false)

// Push a compound's arguments, the last first, so the first is on top for the next `Popped`.
private push_args(v: *Vm, c: *CompoundObj)
    var i = c.args.len()

    while i > 0
        i -= 1
        v.stack.push(c.args.at(i))

// -- equality ------------------------------------------------------------------------------------

// Whether `a` and `b` are equal values, for `==` and `!=` (`op`, named in the error).
//
// **Equality binds nothing, so an unbound variable cannot be compared** and is an instantiation
// error. Kinds are compared before values, as unification compares them. Iterative over a work list
// of its own, which nothing can collect while it runs: equality allocates nothing.
equal_values(a: Value, b: Value, op: string) -> Result[bool, Fault]
    var work: Buf[Value] = buf()

    work.push(a)
    work.push(b)

    while work.len() > 0
        val y = deref(work.pop().unwrap())
        val x = deref(work.pop().unwrap())

        if unbound(x) || unbound(y) then return Err(instantiation_error(s"instantiation error: '$op' was given an unbound variable"))

        if identical(x, y) then continue

        val same = x match
            Undefined -> y match
                Undefined -> true
                _ -> false
            Unit -> y match
                Unit -> true
                _ -> false
            Nil -> y match
                Nil -> true
                Range(q) -> range_empty(q)
                _ -> false
            Int(n) -> y match
                Int(m) -> n == m
                _ -> same_value(x, y)
            Big(_) -> same_value(x, y)
            Rat(_) -> same_value(x, y)
            Real(_) -> same_value(x, y)
            Atom(i) -> y match
                Atom(j) -> i == j
                _ -> false
            Str(p) -> y match
                Str(q) -> p.s == q.s
                _ -> false
            Compound(p) -> y match
                Compound(q) -> both(&work, p.functor == q.functor, p.args.view(), q.args.view())
                _ -> false
            Tuple(p) -> y match
                Tuple(q) -> both(&work, true, p.items.view(), q.items.view())
                _ -> false
            Cons(p) -> y match
                Cons(q) ->
                    work.push(p.head)
                    work.push(q.head)
                    work.push(p.tail)
                    work.push(q.tail)
                    true
                Range(q) -> range_equals_list(q, x)?
                _ -> false
            Bool(a) -> y match
                Bool(b) -> a == b
                _ -> false
            Func(_) -> false
            Var(_) -> false

            // A range equals another with the same elements, and a list with them in order.
            Range(p) -> y match
                Range(q) -> same_range(p, q)
                Nil -> range_empty(p)
                Cons(_) -> range_equals_list(p, y)?
                _ -> false
            Set(p) -> y match
                Set(q) -> same_set(p, q)?
                _ -> false

            // A cset equals one with the same characters.
            CSet(p) -> y match
                CSet(q) -> p.set.same(q.set)
                _ -> false

            // An immutable map equals one with the same entries. What changes in place is equal only
            // to itself, which `identical` has already tested.
            Map(p) -> y match
                Map(q) -> same_map(p, q)?
                _ -> false
            MutSet(_) -> false
            MutMap(_) -> false
            Array(_) -> false
            Buffer(_) -> false
            Ctor(_) -> false

        if !same then return Ok(false)

    Ok(true)
end equal_values

private unbound(x: Value) -> bool = x match
    Var(p) -> !p.bound
    _ -> false

// -- the standard order of terms -----------------------------------------------------------------

// Where `a` stands against `b` in the standard order of terms: negative before, zero the same term,
// positive after.
//
// **Variables by age, then numbers by value, then atoms by text, then strings by text, then
// compounds by arity, then name, then arguments left to right** (`prolog.md` § "Arithmetic and
// order"). The empty list is the atom `[]`, `true` and `false` are atoms, a list cell is the compound
// `'.'(h, t)` and a tuple the compound `tuple(...)`, as the term mapping makes them. The kinds only
// FunL has come after the compounds in a fixed order of kind, and within a kind by value where it
// has one and by identity where it does not, so a sort of mixed values is total and repeatable.
//
// Iterative over a work list of its own, like equality; it binds nothing and allocates nothing, so
// it cannot fail.
compare_terms(a: Value, b: Value) -> int
    var work: Buf[Value] = buf()

    work.push(b)
    work.push(a)

    while work.len() > 0
        val x = deref(work.pop().unwrap())
        val y = deref(work.pop().unwrap())

        if identical(x, y) then continue

        val rx = rank(x)
        val ry = rank(y)

        if rx != ry then return if rx < ry then -1 else 1

        val d = x match
            Var(p) -> y match
                Var(q) -> ordered(p.id, q.id)
                _ -> 0
            Int(n) -> y match
                Int(m) -> if n < m then -1 elif n > m then 1 else 0
                _ -> number_order(x, y)
            Big(_) -> number_order(x, y)
            Rat(_) -> number_order(x, y)
            Real(_) -> number_order(x, y)
            Str(p) -> y match
                Str(q) -> texts(p.s, q.s)
                _ -> 0
            Unit -> 0
            Undefined -> 0
            Range(p) -> y match
                Range(q) -> range_order(p, q)
                _ -> 0
            Ctor(i) -> y match
                Ctor(j) -> ordered(u64(i), u64(j))
                _ -> 0
            _ ->
                if rx == AtomRank
                    texts(atom_text(x), atom_text(y))
                elif rx == CompoundRank
                    compound_order(&work, x, y)
                else
                    ordered(u64(identity(x)), u64(identity(y)))

        if d != 0 then return d

    0
end compare_terms

private const AtomRank: int = 2
private const CompoundRank: int = 4

// A kind's place in the standard order.
private rank(x: Value) -> int = x match
    Var(_) -> 0
    Int(_) -> 1
    Big(_) -> 1
    Rat(_) -> 1
    Real(_) -> 1
    Atom(_) -> AtomRank
    Nil -> AtomRank
    Bool(_) -> AtomRank
    Str(_) -> 3
    Compound(_) -> CompoundRank
    Cons(_) -> CompoundRank
    Tuple(_) -> CompoundRank
    Unit -> 5
    Undefined -> 6
    Range(_) -> 7
    Set(_) -> 8
    MutSet(_) -> 9
    Map(_) -> 10
    MutMap(_) -> 11
    Array(_) -> 12
    Buffer(_) -> 13
    Func(_) -> 14
    Ctor(_) -> 15
    CSet(_) -> 16

private ordered(a: u64, b: u64) -> int = if a < b then -1 elif a > b then 1 else 0

private texts(a: string, b: string) -> int = if a < b then -1 elif a > b then 1 else 0

// The text of a value that orders as an atom.
private atom_text(x: Value) -> string = x match
    Atom(i) -> atom_name(i)
    Nil -> "[]"
    Bool(b) -> if b then "true" else "false"
    _ -> ""

// Two values that order as compounds: by arity, then name; when both agree, their arguments are
// pushed for the loop to compare left to right.
private compound_order(work: *Buf[Value], x: Value, y: Value) -> int
    val ax = term_arity(x)
    val ay = term_arity(y)

    if ax != ay then return if ax < ay then -1 else 1

    val byname = texts(term_name(x), term_name(y))

    if byname != 0 then return byname

    var i = ax

    while i > 0
        i -= 1
        work.push(term_arg(y, i))
        work.push(term_arg(x, i))

    0

private term_arity(x: Value) -> usize = x match
    Compound(p) -> p.args.len()
    Tuple(p) -> p.items.len()
    _ -> 2

private term_name(x: Value) -> string = x match
    Compound(p) -> atom_name(p.functor)
    Tuple(_) -> "tuple"
    _ -> "."

private term_arg(x: Value, i: usize) -> Value = x match
    Compound(p) -> p.args.at(i)
    Tuple(p) -> p.items.at(i)
    Cons(p) -> if i == 0 then p.head else p.tail
    _ -> Undefined

// Ranges by their first element, then their end, then their step.
private range_order(p: *RangeObj, q: *RangeObj) -> int
    if p.from != q.from then return if p.from < q.from then -1 else 1

    if p.endless != q.endless then return if p.endless then 1 else -1

    if p.last != q.last then return if p.last < q.last then -1 else 1

    if p.step != q.step then return if p.step < q.step then -1 else 1

    if p.inclusive == q.inclusive then 0 elif p.inclusive then 1 else -1

// The address of a value that orders by identity.
private identity(x: Value) -> usize = x match
    Set(p) -> usize(p)
    MutSet(p) -> usize(p)
    Map(p) -> usize(p)
    MutMap(p) -> usize(p)
    Array(p) -> usize(p)
    Buffer(p) -> usize(p)
    Func(p) -> usize(p)
    CSet(p) -> usize(p)
    _ -> 0

// Push each pair of parts of two terms whose heads already agree (`heads`) and whose arity does.
private both(work: *Buf[Value], heads: bool, xs: []Value, ys: []Value) -> bool
    if !heads || xs.len != ys.len then return false

    for i in 0..<xs.len
        work.push(xs[i])
        work.push(ys[i])

    true
