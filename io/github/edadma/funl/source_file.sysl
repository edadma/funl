module io.github.edadma.funl

import sh.sysl.parsing.{full_report, source_of}
import sysl.fs.read_text
import sysl.text.Search

// What became of a file handed to the `funl` driver.
enum Compiled
    // It could not be read, and why.
    CannotRead(why: string)

    // It was refused, and its diagnostics rendered.
    Refused(said: string)

    // Its chunk, ready to run, and any warnings rendered.
    Ready(chunk: usize, said: string)

// Read `file` and compile it into the running VM: a `.pl` file as a Prolog program, a `.lfunl` file
// as literate FunL (tangled first), anything else as FunL.
//
// **Every diagnostic names the line and column of the file the reader has open**, a literate file's
// included: a refusal of the document is rendered against it, and the program's diagnostics are moved
// by the columns its tangle took off.
compile_file(file: string) -> Compiled
    read_text(file) match
        Ok(text) -> compile_text(file, text)
        Err(e) -> CannotRead(s"$e")

// Compile `text` as the contents of a file named `file`, exactly as `compile_file` would once it had
// read it: the name alone decides how the text is read, and names the file in every diagnostic.
compile_text(file: string, text: string) -> Compiled
    val doc = source_of(file, text)

    val src = funl_source(doc) match
        Ok(s) -> s
        Err(d) -> return Refused(d.render(doc))

    var report = full_report()
    val chunk = if file.ends_with(".pl") then prolog_program(src, &report) else compile_program(src, &report)
    val said = if report.is_empty() then "" else render_report(report, doc, src)

    chunk match
        Some(at) -> Ready(at, said)
        None -> Refused(said)
end compile_text

// The `funl` driver: compile `file` and run it on a machine of its own, the status to exit with.
// `run_source` says what happens next.
run_file(file: string, line: &Fn(string) -> Option[string], say: &Fn(string) -> unit, complain: &Fn(string) -> unit) -> int
    read_text(file) match
        Ok(text) -> run_source(file, text, line, say, complain)
        Err(e) ->
            complain(s"funl: cannot read $file: $e\n")
            2

// Run `text` as the contents of `file`, as `funl file` does: what the program writes goes to `say` a
// line at a time, and diagnostics to `complain`.
//
// **A Prolog file is loaded, which runs its directives and `initialization/1` goals; a file with no
// such goal then starts the top level** (`prolog.md` § "Loading Prolog") on the same machine, reading
// queries from `line` exactly as the `prolog` executable does.
//
// **The status says which of four things happened**: 0 for a program that ran, 1 for one that was
// refused or faulted, 2 for a file that could not be read, and `N` for a program that ran `halt(N)`.
run_source(file: string, text: string, line: &Fn(string) -> Option[string], say: &Fn(string) -> unit, complain: &Fn(string) -> unit) -> int
    var v = new_vm(HeapBytes, CollectFloor, Growth)
    val was = enter(&v)
    var status = 0

    compile_text(file, text) match
        CannotRead(why) ->
            complain(s"funl: cannot read $file: $why\n")
            status = 2
        Refused(said) ->
            complain(said)
            status = 1
        Ready(at, said) ->
            complain(said)

            val outcome = run(&v, at)

            for l in v.output.view()
                say(l)

            v.output.truncate(0)

            outcome match
                Faulted(m) ->
                    complain(s"funl: $m\n")
                    status = 1
                Halted(n) -> status = n
                _ -> if file.ends_with(".pl") && !v.has_initialization then status = answer_queries(&v, line, say)

    dispose_vm(&v)
    leave(was)
    status
end run_source
