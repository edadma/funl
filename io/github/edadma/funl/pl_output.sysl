module io.github.edadma.funl

import sysl.text.chars_of

// Prolog's output: the `write` family, `nl/0`, `tab/1` and `put_char/1`. Text goes onto the line
// `nl/0` ends (`Vm.line`), as FunL's `write` puts it.

install_prolog_output(v: *Vm)
    register(v, "write/1", 1, (b, n) -> written(b, write_opts(false, false, true)))
    register(v, "print/1", 1, (b, n) -> written(b, write_opts(true, false, true)))
    register(v, "writeq/1", 1, (b, n) -> written(b, write_opts(true, false, true)))
    register(v, "write_canonical/1", 1, (b, n) -> written(b, write_opts(true, true, false)))
    register(v, "write_term/2", 2, pl_write_term)
    register(v, "writeln/1", 1, pl_writeln)
    register(v, "nl/0", 0, pl_nl)
    register(v, "tab/1", 1, pl_tab)
    register(v, "put_char/1", 1, pl_put_char)

private out(text: string)
    val v = current()

    v.line = v.line + text

// The first argument, written with options `o`.
private written(base: usize, o: WriteOpts) -> Result[Value, Fault]
    out(term_text(arg(base, 0), o))
    Ok(Unit)

private pl_nl(base: usize, argc: usize) -> Result[Value, Fault]
    val v = current()

    v.output.push(v.line)
    v.line = ""
    Ok(Unit)

private pl_writeln(base: usize, argc: usize) -> Result[Value, Fault]
    written(base, write_opts(false, false, true))?
    pl_nl(base, 0)

// `write_term(T, Options)`: `quoted(B)`, `ignore_ops(B)`, `numbervars(B)` and `max_depth(N)`.
private pl_write_term(base: usize, argc: usize) -> Result[Value, Fault]
    val given = arg(base, 1)
    var o = write_opts(false, false, false)
    var at = deref(given)

    loop
        at match
            Nil -> break
            Cons(p) ->
                write_option(&o, deref(p.head))?
                at = deref(p.tail)
            Var(_) -> return Err(instantiation_error("instantiation error: write_term/2's options end in an unbound variable"))
            _ -> return Err(type_error("list", given, s"write_term/2 wants a list of options, and was given ${described(given)}"))

    written(base, o)

private write_option(o: *WriteOpts, x: Value) -> Result[unit, Fault]
    val c = x match
        Compound(c) -> if c.args.len() == 1 then c else return Err(bad_option(x))
        Var(_) -> return Err(instantiation_error("instantiation error: write_term/2 was given an unbound variable as an option"))
        _ -> return Err(bad_option(x))

    val name = atom_name(c.functor)
    val a = deref(c.args.at(0))

    if is_unbound(a)
        return Err(instantiation_error(s"instantiation error: write_term/2's option $name was given an unbound variable"))

    if name == "max_depth"
        a match
            Int(n) ->
                if n < 0 then return Err(bad_option(x))

                o.max_depth = n
                return Ok(())
            _ -> return Err(bad_option(x))

    val on = a match
        Atom(id) ->
            val b = atom_name(id)

            if b == "true" then true elif b == "false" then false else return Err(bad_option(x))
        _ -> return Err(bad_option(x))

    if name == "quoted"
        o.quoted = on
    elif name == "ignore_ops"
        o.ignore_ops = on
    elif name == "numbervars"
        o.numbervars = on
    else
        return Err(bad_option(x))

    Ok(())
end write_option

private bad_option(x: Value) -> Fault =
    domain_error("write_option", x, s"${term_text(x, write_opts(true, false, false))} is not an option write_term/2 takes")

// `tab(N)`: `N` spaces, `N` an expression.
private pl_tab(base: usize, argc: usize) -> Result[Value, Fault]
    val x = eval(arg(base, 0))?

    val n = x match
        Int(k) -> k
        _ -> return Err(type_error("integer", x, s"tab/1 wants an integer count, and was given ${described(x)}"))

    var spaces = ""

    for i in 0..<n
        spaces = spaces + " "

    out(spaces)
    Ok(Unit)

// `put_char(C)`: the one character atom `C` is.
private pl_put_char(base: usize, argc: usize) -> Result[Value, Fault]
    val x = deref(arg(base, 0))

    x match
        Atom(id) ->
            val name = atom_name(id)

            if one_char(name)
                out(name)
                return Ok(Unit)
        Var(_) -> return Err(instantiation_error("instantiation error: put_char/1 was given an unbound variable"))
        _ -> ()

    Err(type_error("character", x, s"put_char/1 wants a one-character atom, and was given ${described(x)}"))

// Whether `s` is exactly one character.
one_char(s: string) -> bool
    var n: usize = 0

    for c in chars_of(s.bytes)
        n += 1

    n == 1
