module io.github.edadma.funl

import sysl.text.chars_of

// Prolog's output: the `write` family, `nl/0` and `tab/1`. Text goes to the stream a two-argument
// form names, or to the current output stream (`pl_streams.sysl`), as it is written; standard
// output's goes through the same sink as FunL's `write` (`io.sysl`'s `put_out`), so the two keep the
// order they ran in.

install_prolog_output(v: *Vm)
    register(v, "write/1", 1, (b, n) -> written(b, false, write_opts(false, false, true), "write/1"))
    register(v, "write/2", 2, (b, n) -> written(b, true, write_opts(false, false, true), "write/2"))
    register(v, "print/1", 1, (b, n) -> written(b, false, write_opts(true, false, true), "print/1"))
    register(v, "print/2", 2, (b, n) -> written(b, true, write_opts(true, false, true), "print/2"))
    register(v, "writeq/1", 1, (b, n) -> written(b, false, write_opts(true, false, true), "writeq/1"))
    register(v, "writeq/2", 2, (b, n) -> written(b, true, write_opts(true, false, true), "writeq/2"))
    register(v, "write_canonical/1", 1, (b, n) -> written(b, false, write_opts(true, true, false), "write_canonical/1"))
    register(v, "write_canonical/2", 2, (b, n) -> written(b, true, write_opts(true, true, false), "write_canonical/2"))
    register(v, "write_term/2", 2, (b, n) -> pl_write_term(b, false))
    register(v, "write_term/3", 3, (b, n) -> pl_write_term(b, true))
    register(v, "writeln/1", 1, pl_writeln)
    register(v, "nl/0", 0, pl_nl)
    register(v, "tab/1", 1, pl_tab)
    register(v, "tab/2", 2, pl_tab)

private out(text: string) -> Result[unit, Fault] = put_current(text)

// `t` onto the current output, each newline in it ending the line as `nl/0` does.
put_text(t: string) -> Result[unit, Fault] = put_current(t)

// The term argument written with options `o`: to the stream the first argument names where
// `named`, the term then second, else to the current output.
private written(base: usize, named: bool, o: WriteOpts, who: string) -> Result[Value, Fault]
    val s = term_output(base, named, who)?

    put_on(s, term_text(arg(base, if named then 1 else 0), o))?
    Ok(Unit)

private pl_nl(base: usize, argc: usize) -> Result[Value, Fault]
    out("\n")?
    Ok(Unit)

private pl_writeln(base: usize, argc: usize) -> Result[Value, Fault]
    written(base, false, write_opts(false, false, true), "writeln/1")?
    pl_nl(base, 0)

// `write_term(S, T, Options)` where `named`, and `write_term(T, Options)` on the current output:
// `quoted(B)`, `ignore_ops(B)`, `numbervars(B)` and `max_depth(N)`.
private pl_write_term(base: usize, named: bool) -> Result[Value, Fault]
    val who = if named then "write_term/3" else "write_term/2"
    val given = arg(base, if named then 2 else 1)
    var o = write_opts(false, false, false)
    var at = deref(given)

    loop
        at match
            Nil -> break
            Cons(p) ->
                write_option(&o, deref(p.head), who)?
                at = deref(p.tail)
            Var(_) -> return Err(instantiation_error(s"instantiation error: $who's options end in an unbound variable"))
            _ -> return Err(type_error("list", given, s"$who wants a list of options, and was given ${described(given)}"))

    written(base, named, o, who)

private write_option(o: *WriteOpts, x: Value, who: string) -> Result[unit, Fault]
    val c = x match
        Compound(c) -> if c.args.len() == 1 then c else return Err(bad_option(x, who))
        Var(_) -> return Err(instantiation_error(s"instantiation error: $who was given an unbound variable as an option"))
        _ -> return Err(bad_option(x, who))

    val name = atom_name(c.functor)
    val a = deref(c.args.at(0))

    if is_unbound(a)
        return Err(instantiation_error(s"instantiation error: $who's option $name was given an unbound variable"))

    if name == "max_depth"
        a match
            Int(n) ->
                if n < 0 then return Err(bad_option(x, who))

                o.max_depth = n
                return Ok(())
            _ -> return Err(bad_option(x, who))

    val on = a match
        Atom(id) ->
            val b = atom_name(id)

            if b == "true" then true elif b == "false" then false else return Err(bad_option(x, who))
        _ -> return Err(bad_option(x, who))

    if name == "quoted"
        o.quoted = on
    elif name == "ignore_ops"
        o.ignore_ops = on
    elif name == "numbervars"
        o.numbervars = on
    else
        return Err(bad_option(x, who))

    Ok(())
end write_option

private bad_option(x: Value, who: string) -> Fault =
    domain_error("write_option", x, s"${term_text(x, write_opts(true, false, false))} is not an option $who takes")

// `tab(N)` and `tab(S, N)`: `N` spaces, `N` an expression, on the current output or on stream `S`.
// A count below one writes nothing, as in SWI-Prolog.
private pl_tab(base: usize, argc: usize) -> Result[Value, Fault]
    val named = argc == 2
    val who = if named then "tab/2" else "tab/1"
    val s = term_output(base, named, who)?
    val x = eval(arg(base, if named then 1 else 0))?

    val n = x match
        Int(k) -> k
        _ -> return Err(type_error("integer", x, s"$who wants an integer count, and was given ${described(x)}"))

    var spaces = ""

    for i in 0..<n
        spaces = spaces + " "

    put_on(s, spaces)?
    Ok(Unit)

// Whether `s` is exactly one character.
one_char(s: string) -> bool
    var n: usize = 0

    for c in chars_of(s.bytes)
        n += 1

    n == 1
