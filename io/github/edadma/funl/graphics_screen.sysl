module io.github.edadma.funl

import sysl.buf.Buf
import sysl.posix.time.sleep
import sysl.time.micros

// `funl:graphics`'s canvases on screen: what the window's own events do to its canvas, the waits that
// show the canvases, and the methods that wait (`docs/library/graphics-screen.md`). The window itself
// -- SDL, behind the `graphics` feature -- is `native_screen.sysl`; the canvas, its queue and its
// attributes are `native_graphics.sysl`.
//
// **The program's waits are where the screen is brought up to date**: `show_screens` takes in what
// SDL says has happened -- a resize, a close asked for, a key, a click -- onto each canvas and its
// queue, then copies every shown canvas into its window. `flush`, `sync`, `delay`, `event`, `pending`,
// `active`, the event loop's wait and the program's end all go through it.

// The place of the canvas whose window SDL calls `id`.
private canvas_of_screen(id: u32) -> Option[usize]
    for i in 0..<canvases.len()
        canvases.at(i) match
            Some(c) -> if c.screen >= 0 && screen_id(usize(c.screen)) == id then return Some(i)
            None -> ()

    None

// Event `ev` put on the queue of the canvas at `at`, unless its `inputmask` keeps it off, as
// `enqueue` would: motion with no button held without `"m"`, a key's release without `"k"`.
private queued(at: usize, ev: WinEvent)
    val c = canvas_at(at)
    val unasked_release = (ev.mods & ScreenReleased) != 0 && !in_mask(c.inputmask, 'k')
    val unasked_motion = !ev.is_key && atom_name(ev.sym) == "move" && !in_mask(c.inputmask, 'm')

    if !unasked_release && !unasked_motion then c.queue.push(ev)

// A symbol event at the pointer of the canvas at `at`.
private at_pointer(at: usize, sym: string) -> WinEvent
    val (x, y) = canvas_at(at).pointer.unwrap_or((0, 0))

    WinEvent(false, "", intern(sym), x, y, 0, 0)

// What has happened to the windows on screen, waiting up to `ms` milliseconds for the first thing,
// carried into their canvases: a window resized by its user has its canvas resized with it, the
// picture kept and the new area filled, and `#resize` queued; a close asked for queues `#close`; one
// exposed is shown again; the pointer seen over one is its `pointer`; a key, a button and the wheel
// are queued as Icon's events.
private take_news(ms: long)
    val news = screen_news(ms)

    for i in 0..<news.len()
        news.at(i) match
            Resized(id, w, h) ->
                canvas_of_screen(id) match
                    Some(at) ->
                        val c = canvas_at(at)

                        // A resize to the size the canvas has is the program's own `set` coming back.
                        if w != c.width || h != c.height
                            resized(c, w, h, c.fill) match
                                Some(r) ->
                                    canvases.set(at, Some(r))
                                    queued(at, at_pointer(at, "resize"))
                                None -> ()
                    None -> ()
            Exposed(id) ->
                canvas_of_screen(id) match
                    Some(at) -> screen_show(usize(canvas_at(at).screen), canvas_at(at).surface, None)
                    None -> ()
            Pointed(id, x, y) ->
                canvas_of_screen(id) match
                    Some(at) ->
                        var c = canvas_at(at)

                        c.pointer = Some((x, y))
                        canvases.set(at, Some(c))
                    None -> ()
            Closing(id) ->
                canvas_of_screen(id) match
                    Some(at) -> queued(at, at_pointer(at, "close"))
                    None -> ()
            Input(id, key, sym, x, y, mods, interval) ->
                canvas_of_screen(id) match
                    Some(at) ->
                        val ev = if key != "" then WinEvent(true, key, 0, x, y, mods, interval) else WinEvent(false, "", intern(sym), x, y, mods, interval)

                        queued(at, ev)
                    None -> ()
end take_news

// The program waits: what has happened to the windows on screen is taken in, and every canvas shown
// in a window is copied there and presented. Not `private`: the event loop calls it before it blocks.
show_screens()
    take_news(0)
    shown_with(None)

// Every canvas shown in a window copied there and presented, the canvas at `caret`'s place with its
// caret drawn over it.
private shown_with(caret: Option[(usize, ScreenCaret)])
    for i in 0..<canvases.len()
        canvases.at(i) match
            Some(c) ->
                if c.screen >= 0 && c.state != "hidden"
                    val k = caret match
                        Some((at, k)) -> if at == i then Some(k) else None
                        None -> None

                    screen_show(usize(c.screen), c.surface, k)
            None -> ()

// Whether the canvas at `at` is shown in a window, so that its user can still put an event on its
// queue while the program waits.
on_screen(at: usize) -> bool
    val c = canvas_at(at)

    c.screen >= 0 && c.state != "hidden"

// Waited, showing the canvases and taking in their windows' events, until `ready` says so. The
// caller has made sure an event can come.
wait_on_screens(ready: () -> bool)
    show_screens()

    while !ready()
        take_news(100)
        show_screens()

// Waited as `wait_on_screens` waits, for `ready`, by a program taking events off `w`'s queue -- `event`,
// `read`, `reads` -- with the text caret shown in `w`'s window while it waits, when `w`'s `cursor` is
// on, as Icon's is: a block at the text cursor, a character cell (`fwidth`) wide and the font's
// `descent` high under the baseline, in the foreground colour. It is drawn in the window only, over
// the canvas copied there, and put up again each time the wait looks -- a resize or an expose shows
// the canvas afresh -- and the window is shown without it once the wait is over, so the canvas never
// holds it and no wait that ends at once shows it at all.
waited_with_caret(w: Win, ready: () -> bool)
    show_screens()

    if ready() then return

    loop
        val c = canvas_at(w.at)

        shown_with(if c.cursor then Some((w.at, caret_of(c, context_at(w.ctx)))) else None)
        take_news(100)

        if ready() then break

    show_screens()

// The caret of canvas `c` under context `ctx`, in the canvas's device pixels.
private caret_of(c: WinCanvas, ctx: WinContext) -> ScreenCaret
    val f = face_at(ctx.face)
    val d = c.density
    val fg = ctx.fg_rgb

    ScreenCaret(c.x * d, c.y * d, f.fwidth * d, f.descent * d, eight_bit(fg.r), eight_bit(fg.g), eight_bit(fg.b))

// Whether a window on screen is still waiting to be closed by its user.
private screens_left() -> bool
    if screens_quit_asked() then return false

    for i in 0..<canvases.len()
        canvases.at(i) match
            Some(c) -> if c.screen >= 0 && c.state != "hidden" && !screen_close_asked(usize(c.screen)) then return true
            None -> ()

    false

// The program has ended with windows still on screen: they are shown, and waited on until each is
// closed from its title bar or the platform asks the program to quit, as Icon's `WDone` waits; then
// every window is closed. Not `private`: the driver calls it when a program ends (`source_file.sysl`).
wait_for_screens()
    while screens_left()
        show_screens()
        take_news(100)

    for i in 0..<canvases.len()
        canvases.at(i) match
            Some(c) -> if c.screen >= 0 then free_canvas(i)
            None -> ()

// `ms` milliseconds waited, in short sleeps, the windows on screen taken in between them so that
// they keep answering while the program pauses.
private pause(ms: long)
    var left = ms

    while left > 0
        val step = if left < 10 then left else 10

        sleep(micros(step * 1000))
        take_news(0)
        left -= step

// `w.flush()`: every canvas shown on screen as it now is; answers `w`. A frame is presented by the
// time SDL's present returns.
private[funl] do_flush(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "flush")?

    show_screens()
    Ok(Some(Handle(w.h)))

// `w.sync()`: what `flush` does, and then every request made of `w`'s window -- its size, its place,
// maximizing, minimizing -- waited for, as `SDL_SyncWindow` does; answers `w`. A hidden canvas has no
// window to wait for.
private[funl] do_sync(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "sync")?

    show_screens()

    val c = canvas_at(w.at)

    if c.screen >= 0 then screen_sync(usize(c.screen))

    Ok(Some(Handle(w.h)))

// `w.delay(ms)`: the canvases shown, then `ms` milliseconds waited; answers `w`.
private[funl] do_delay(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "delay")?
    val x = deref(arg(base, 1))

    val ms = x match
        Int(n) -> n
        _ -> return Err(kind_error(x, "integer", s"'delay' wants a number of milliseconds, an integer, and was given ${described(x)}"))

    show_screens()
    pause(ms)
    Ok(Some(Handle(w.h)))

// `w.raise()`: `w`'s window brought in front of the others; answers `w`. A hidden canvas has no window
// to raise.
private[funl] do_raise(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "raise")?
    val c = canvas_at(w.at)

    if c.screen >= 0 then screen_raise(usize(c.screen))

    Ok(Some(Handle(w.h)))

// `w.lower()`: `w`'s window sent behind the others; answers `w`. A hidden canvas has no window to
// lower, as it has none to raise. Where the platform's window system cannot lower a window, the call
// faults with `system_error` saying so.
private[funl] do_lower(base: usize, argc: usize) -> Result[Option[Value], Fault]
    val w = window_arg(base, 0, "lower")?
    val c = canvas_at(w.at)

    if c.screen >= 0 then
        screen_lower(usize(c.screen)) match
            Ok(_) -> ()
            Err(why) -> return Err(system_error(s"'lower': $why"))

    Ok(Some(Handle(w.h)))
