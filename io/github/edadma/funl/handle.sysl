module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// Handles: how a native module gives a program a live resource -- a connection, a statement, a child
// process, an iteration's state -- without the program seeing inside it.
//
// **A handle is opaque.** The program holds it, passes it, compares it (equal only to itself) and
// calls its methods, `h.name(args)`; nothing else reads it. Prolog sees it as an opaque term that
// unifies only with itself. It prints as `<kind handle>`, `<closed kind handle>` once closed.
//
// **Registering a kind** is what a native module does once, at install time:
//
//     val k = register_handle_kind(v, "statement", release_statement)
//     register_method(v, k, "step", 0, statement_step)
//     register_method(v, k, "bind", 2, statement_bind)
//
// The release hook gives the handle's resource back (`res`, and anything its `vals` stand for); it is
// run exactly once, by `close()` or, for a handle the program forgot, by the collector's finalizer.
// A maker native takes a handle with `new_handle(k)`, stores its resource, and answers `Handle(p)`.
// A method is a builtin whose argument 0 is the handle (`open_handle` checks it) and which may fail
// (`MethodGo`): `step` is called with one argument, `bind` with three.
//
// **Every kind has `close()`**, which the runtime supplies: it releases the resource now, and closing
// a closed handle does nothing. Any other method called on a closed handle is a fault,
// `existence_error(handle, H)`, as a closed stream is in Prolog; a method the kind does not have is
// `existence_error(method, Name)`.
//
// **A native generator keeps its state in a handle** (`register_stepping`, `call_stepping`): one per
// call, released when the generator runs out, by `close()`, or by the finalizer once a commit has
// abandoned it. **A method may generate the same way** (`register_stepping_method`): `rows()` of a
// statement, `stmt.rows()`, is a generator whose state is made from the statement.

// What a kind's release hook is given: the handle whose resource it gives back.
type ReleaseGo = &Fn(*HandleObj) -> unit

// A method: called with its arguments on the stack from `base`, the handle first, and how many there
// are, it answers a value, or `None` for failure -- "no such row", "nothing more" -- which the program
// tests with `if` and `|` as it would a comparison.
type MethodGo = &Fn(usize, usize) -> Result[Option[Value], Fault]

// How a method is run.
enum MethodHow
    // Called with its arguments; answers a value or fails.
    Answers(go: MethodGo)

    // A generator over a state handle, as `register_stepping`'s builtins are: `start` is called with
    // the handle and the arguments and makes the state, `step` takes the next value from it.
    Steps(start: StartGo, step: StepGo)

// One method of a kind: its name, how many arguments it takes besides the handle, and how it runs.
struct Method
    name: string
    arity: usize
    how: MethodHow

// A kind of handle: the name it prints with, its release hook and its methods.
struct HandleKind
    name: string
    release: ReleaseGo
    methods: Buf[Method]

// Register a kind of handle and answer its id, which `new_handle` and `register_method` take.
register_handle_kind(v: *Vm, name: string, release: ReleaseGo) -> u32
    v.handle_kinds.push(HandleKind(name, release, buf()))
    u32(v.handle_kinds.len() - 1)

// Give kind `kind` the method `name`, taking `arity` arguments besides the handle (`Variadic` for any
// number). `go` sees the handle as argument 0, so it is called with `arity + 1`.
register_method(v: *Vm, kind: u32, name: string, arity: usize, go: MethodGo) = add_method(v, kind, Method(name, arity, Answers(go)))

// Give kind `kind` the generating method `name`: each call `h.name(args)` makes a fresh state handle
// with `start`, which sees `h` as argument 0, and takes values from it with `step`, one per
// resumption, exactly as a builtin `register_stepping` made does (see `call_stepping`).
register_stepping_method(v: *Vm, kind: u32, name: string, arity: usize, start: StartGo, step: StepGo) =
    add_method(v, kind, Method(name, arity, Steps(start, step)))

private add_method(v: *Vm, kind: u32, m: Method)
    var k = v.handle_kinds.at(usize(kind))

    k.methods.push(m)
    v.handle_kinds.set(usize(kind), k)

// The name of the kind of handle `h`.
handle_kind_name(h: *HandleObj) -> string = current().handle_kinds.at(usize(h.kind)).name

// Close `h`: run its kind's release hook, once. Closing a closed handle does nothing.
close_handle(h: *HandleObj)
    if h.closed then return

    h.closed = true
    current().handle_kinds.at(usize(h.kind)).release(h)
    h.res = null
    h.vals.release()

// Argument `i` of a method or builtin, which must be an open handle of kind `kind`.
open_handle(base: usize, i: usize, kind: u32, what: string) -> Result[*HandleObj, Fault]
    val x = deref(arg(base, i))

    val h = x match
        Handle(p) -> p
        _ -> return Err(kind_error(x, "handle", s"$what wants a handle and was given ${described(x)}"))

    if h.kind != kind
        return Err(type_error(current().handle_kinds.at(usize(kind)).name, x, s"$what wants a ${current().handle_kinds.at(usize(kind)).name} handle and was given ${described(x)}"))

    if h.closed then return Err(closed_handle(x, what))

    Ok(h)

private closed_handle(x: Value, what: string) -> Fault = existence_error("handle", x, s"$what was called on ${described(x)}")

// `CallMethod(name, argc, tail)`: what `MethodOf(name)` left -- a handle and `()`, or `()` and a
// callee -- under the top `argc` values. False where the call fails.
//
// **A generating method is resumed by running this instruction again**: its first run moves the
// handle up into the `()` cell and puts the cursor where the handle was, so the arguments `start`
// sees -- the handle, then the program's -- stand together, and `call_stepping` keeps the state
// handle in the cursor cell. A run that finds a handle above a handle is such a resumption, since
// `MethodOf` always leaves `()` above a handle. A handle closed while its method was generating has
// nothing more to give: the state is closed and the call fails.
call_method(v: *Vm, name: u32, argc: usize, tail: bool) -> Result[bool, Fault]
    val n = v.stack.len()

    if argc + 2 > n then return Err(Broken(s"a method call wants two cells and $argc arguments and the operand stack holds $n"))

    val first = n - argc - 2
    val recv = deref(v.stack.at(first))

    val h = recv match
        Handle(p) -> p
        _ ->
            // Not a handle: the field `MethodOf` read is called as `CallValue` would call it, once the
            // `()` under it is gone.
            for i in first + 1..<n
                v.stack.set(i - 1, v.stack.at(i))

            v.stack.truncate(n - 1)
            return call_value(v, argc, tail)

    val text = atom_name(name)

    deref(v.stack.at(first + 1)) match
        Handle(owner) ->
            if owner.closed
                close_handle(h)
                return Ok(false)

            val m = method_named(owner, name, deref(v.stack.at(first + 1)))?

            return m.how match
                Steps(start, step) -> call_stepping(v, s"'$text'", start, step, first + 1, argc + 1, first)
                Answers(_) -> Err(Broken(s"'$text' was resumed, and does not generate"))
        _ -> ()

    val shown = s"'$text' of ${described(recv)}"

    if text == "close"
        if argc != 0 then return Err(wrong_count(text, argc, s"$shown takes no arguments and was given $argc"))

        close_handle(h)
        v.stack.truncate(first)
        v.stack.push(Unit)
        return Ok(true)

    val m = method_named(h, name, recv)?

    if h.closed then return Err(closed_handle(recv, s"'$text'"))

    if m.arity != Variadic && argc != m.arity
        return Err(wrong_count(text, argc, s"$shown takes ${m.arity} arguments and was given $argc"))

    val go = m.how match
        Answers(go) -> go
        Steps(start, step) ->
            v.stack.set(first + 1, v.stack.at(first))
            v.stack.set(first, Int(0))
            return call_stepping(v, s"'$text'", start, step, first + 1, argc + 1, first)

    // The `()` goes; the handle becomes argument 0.
    for i in first + 2..<n
        v.stack.set(i - 1, v.stack.at(i))

    v.stack.truncate(n - 1)

    val answer = go(first, argc + 1)?

    v.stack.truncate(first)

    answer match
        Some(x) ->
            v.stack.push(x)
            Ok(true)
        None -> Ok(false)
end call_method

// The method `name` of the kind of handle `h`, which is `recv`.
private method_named(h: *HandleObj, name: u32, recv: Value) -> Result[Method, Fault]
    val text = atom_name(name)

    for m in current().handle_kinds.at(usize(h.kind)).methods.view()
        if m.name == text then return Ok(m)

    Err(existence_error("method", Atom(name), s"${described(recv)} has no method '$text'"))

// Run a generator over a handle: `start` and `step` are its builtins, its `argc` arguments stand
// from `base`, and cell `cell` -- the cursor's -- holds its state.
//
// **The cursor cell holds the call's state handle once it has one**: the first run finds `0` there,
// has `start` make the handle, and stores it in the cell, so the collector sees it from then on --
// on the stack while the call runs, and in the cells the choice point saves while it waits. Each
// value `step` gives leaves a choice point that re-runs this instruction over the same cells, which
// steps the same handle again. **Each call starts afresh**, since every call pushes its own `0`.
// When `step` runs out the handle is closed at once and the call fails; a context that commits
// abandons the choice point instead, and the finalizer closes the handle once nothing reaches it.
// A state handle closed from outside -- by the handle it came from -- has nothing more to give.
// The cells from the lower of `base` and `cell` up give way to the value. False where the call fails.
call_stepping(v: *Vm, name: string, start: StartGo, step: StepGo, base: usize, argc: usize, cell: usize) -> Result[bool, Fault]
    val state = v.stack.at(cell) match
        Int(_) ->
            val made = start(base, argc)? match
                Some(x) -> x
                None -> return Ok(false)

            v.stack.set(cell, made)
            made
        x -> x

    val h = state match
        Handle(p) -> p
        _ -> return Err(Broken(s"$name keeps its state in something other than a handle"))

    if h.closed then return Ok(false)

    step(h)? match
        Some(x) ->
            push_choice(v, v.ip - 1)
            v.stack.truncate(if cell < base then cell else base)
            v.stack.push(x)
            Ok(true)
        None ->
            close_handle(h)
            Ok(false)
