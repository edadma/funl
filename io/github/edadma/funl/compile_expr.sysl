module io.github.edadma.funl

import sysl.buf.{Buf, buf}

// Expressions and statements, compiled to the machine.
//
// **An expression that succeeds leaves exactly one value on the operand stack**; one that fails
// leaves the machine failing, and the control stack decides where that goes. So every form below
// is the composition of its parts' code with the few control instructions that say how they
// backtrack into each other:
//
//     a & b                  a; Pop; b
//     a | b                  Choice(l); a; Branch(end); l: b; end:
//     a and b                a; FailIfFalse; Pop; b; FailIfFalse
//     not e                  Mark(ok); e; FailIfFalse; Unmark; Fail; ok: PushUnit
//     if c then t else e     Mark(no); c; FailIfFalse; Unmark; t; Branch(end); no: e; end:
//     every g do b           g; Pop; MarkThrough; b; Unmark; Fail
//     a statement            Mark(next); e; Unmark; next:
//     !c                     c; GenStart(false); GenNext
//     i to j by k            i; j; k; PushInt(0); GenRange(true)
//     |e                     top: MarkThrough; e; ChangeMark(top)
//     yield e                Choice(after); e; [ScanLeave(n)]; Return; after: PushUnit
//     return e               e; [ScanLeave(n)]; ReturnCommit
//     s ? e                  s; ScanBegin; e; ScanEnd
//     e catch p -> r         SaveHeight(h); PushTrap(r); e; ExitTrap(h); ...   -- `catch.sysl`
//
// `[ScanLeave(n)]` is there when the jump leaves `n` scans of the function's body that are open
// around it, and puts back the scan state the outermost of them replaced.
//     f(a, ...)              a; ...; PushInt(0); NativeGen(f)   -- a builtin that fails or generates
//
// A condition, a statement and the body of an `every` are bounded: their `Unmark` discards every
// choice point made inside them. Everything else is left resumable, so a generator anywhere in an
// expression is backtracked into by whatever fails after it. The loops are in `compile_loop.sysl`.
//
//     x op= e                e; Update(x, op)          -- `e` first, so each of its values updates
//     x++                    LoadSlot(x); PushInt(1); Update(x, +); Pop
//     x <- e                 e; Dup; StoreBack(x)      -- the old value trailed, for failure to restore
//     h:t                    h; t; MakeCons
//     a..b by k              a; b; k; MakeRange
//     a..+n by k             a; n; k; MakeRange(counted)
//     [e | p <- c if f]      PushNil; StoreSlot(acc); Mark(done); c; GenStart(true); GenNext; match p;
//                            MarkThrough; f; FailIfFalse; Unmark; e; Collect(acc); Fail;
//                            done: Collected(acc)

// What the compiler reads while it compiles one scope's code.
struct Ctx
    res: *Resolved

    // The scope being compiled, by id, and the block of it.
    sc: usize
    blk: usize

    // The loops around the code being compiled, innermost last.
    loops: *Buf[Looping]

    // How many scans `s ? e` of this function's body are open around the code being compiled: what a
    // `return` or `yield` here leaves (`ScanLeave`).
    scans: usize

    // What `n` means written at offset `pos` here.
    meaning(self, n: string, pos: usize) -> Meaning = self.res.meaning(self.sc, self.blk, pos, n)

    // The same, compiling the block the parser numbered `id`.
    in_block(self, id: usize) -> Result[Ctx, string] = self.res.blocks.get(id) match
        Some(b) -> Ok(Ctx(self.res, self.sc, b, self.loops, self.scans))
        None -> Err(s"block $id was never resolved")

    // The same, compiling the body of one more scan.
    in_scan(self) -> Ctx = Ctx(self.res, self.sc, self.blk, self.loops, self.scans + 1)

// A context for scope `sid` from its root block, inside no loop or scan, its loop stack `loops`.
context(res: *Resolved, sid: usize, loops: *Buf[Looping]) -> Ctx = Ctx(res, sid, 0, loops, 0)

// Before a jump out of `n` scans, the instruction that leaves them.
leave_scans(e: *Emit, n: usize)
    if n > 0 then e.op(ScanLeave(n))

// Push the value of the name `n`, which means `m`.
private push_meaning(e: *Emit, c: Ctx, m: Meaning, n: string) -> Result[unit, string]
    m match
        Local(depth, slot, _) -> e.op(LoadSlot(depth, slot))
        Function(r, up) -> e.op(MakeClosure(c.res.rels.at(r).chunk, up))
        Gone -> e.op(PushConst(e.constant(Undefined)))
        Constructor(id) ->
            // One with no fields is its atom; any other is a value that makes records.
            val d = current().ctors.at(id)

            e.op(PushConst(e.constant(if d.fields.len() == 0 then Atom(d.functor) else Ctor(u32(id)))))
        Builtin(id) -> push_builtin(e, id, n)?
        Unknown ->
            // `import * as fs from funl:fs`: the module, a map from each export to its value.
            c.res.aliases.get(n) match
                Some(index) -> push_module_map(e, index)?
                None -> return Err(s"'$n' was resolved and is not a value")
        _ -> return Err(s"'$n' was resolved and is not a value")

    Ok(())

// Push builtin `id`'s value: a builtin that names a value is made once, into the chunk's constants,
// and one of a fixed arity is a function value over its `value_chunk`.
private push_builtin(e: *Emit, id: usize, n: string) -> Result[unit, string]
    current().natives.at(id).how match
        Constant(go) ->
            val made = go(0, 0) match
                Ok(x) -> x
                Err(f) -> return Err(fault_text(f))

            e.op(PushConst(e.constant(made)))
        _ ->
            if !is_function_value(id) then return Err(s"'$n' is a builtin, and is not a value")

            e.op(MakeClosure(value_chunk(id)?, TopUp))

    Ok(())

// Push the map a module of FunL's own is as a value: each export that is a value under its name.
private push_module_map(e: *Emit, index: usize) -> Result[unit, string]
    val md = current().modules.at(index)
    var count: usize = 0

    for x in md.exports.view()
        x.kind match
            ExNative(id) ->
                if is_constant(id) || is_function_value(id)
                    e.op(PushConst(e.constant(new_str(x.name)?)))
                    push_builtin(e, id, x.name)?
                    count += 1
            _ -> ()

    e.op(MakeMap(count))
    Ok(())

// When `x.name` is a name a module exports, `x` naming the module (`module.sysl`): what it means.
qualified_in(c: Ctx, x: &Expr, name: string) -> Option[Meaning] = x.kind match
    Ref(g) -> qualified_name(c.res, g, c.meaning(g, x.span.start), name)
    _ -> None

// When `f(args)` calls a name a module exports, `f` being `m.name`: what the name means.
qualified_callee(c: Ctx, f: &Expr) -> Option[Meaning] = f.kind match
    FieldE(x, name) -> qualified_in(c, x, name)
    _ -> None

// The name a qualified callee `m.name` calls, as it is written: `m.name`.
callee_name(f: &Expr) -> string = f.kind match
    FieldE(x, name) -> x.kind match
        Ref(g) -> s"$g.$name"
        _ -> name
    _ -> ""

// Push `x`'s value.
compile_value(e: *Emit, c: Ctx, x: &Expr) -> Result[unit, string]
    x.kind match
        Ref(n) -> push_meaning(e, c, c.meaning(n, x.span.start), n)?
        Anon -> e.op(PushVar)
        AtomE(n) -> e.op(PushConst(e.constant(atom(n))))
        IntE(n) -> e.op(PushInt(n))
        NumE(text) -> e.op(PushConst(e.constant(literal_value(text)?)))
        StrE(s) -> e.op(PushConst(e.constant(new_str(s)?)))
        BoolE(b) -> e.op(PushConst(e.constant(boolean(b))))
        TupleE(items) ->
            for a in items.view()
                compile_value(e, c, a)?

            e.op(if items.len() == 0 then PushUnit else MakeTuple(items.len()))
        CallE(n, at, args) -> call_named(e, c, n, at.start, args, false)?
        ApplyE(f, args) -> apply(e, c, f, args, false)?
        Conj(a, b) ->
            compile_value(e, c, a)?
            e.op(Pop)
            compile_value(e, c, b)?
        Disj(a, b) -> alternation(e, c, a, b, false)?
        AndE(a, b) ->
            compile_value(e, c, a)?
            e.op(FailIfFalse)
            e.op(Pop)
            compile_value(e, c, b)?
            e.op(FailIfFalse)
        OrE(a, b) -> alternation(e, c, a, b, true)?
        Neg(g) ->
            val ok = e.label()

            e.op(Mark(ok))
            compile_value(e, c, g)?
            e.op(FailIfFalse)
            e.op(Unmark)
            e.op(Fail)
            e.place(ok)
            e.op(PushUnit)
        UnifyE(a, b) -> binary(e, c, a, b, Unify)?
        EqualE(a, b) -> binary(e, c, a, b, TestEq)?
        DifferE(a, b) -> binary(e, c, a, b, TestNe)?
        BinE(o, a, b) -> binary(e, c, a, b, Arith(o))?
        MinusE(a) ->
            compile_value(e, c, a)?
            e.op(Negate)
        IfE(cond, yes, no) ->
            val other = e.label()
            val end = e.label()

            condition(e, c, cond, other)?
            compile_value(e, c, yes)?
            e.op(Branch(end))
            e.place(other)

            no match
                Some(n) -> compile_value(e, c, n)?
                None -> e.op(Fail)

            e.place(end)
        EveryE(id, label, g, body) -> compile_every(e, c, id, label, g, body, false)?
        WhileE(id, label, cond, body) -> compile_while(e, c, id, label, cond, body, false)?
        RepeatE(id, label, body) -> compile_repeat(e, c, id, label, body, false)?
        ForE(id, label, gens, body) -> compile_for(e, c, id, label, gens, body, false)?
        BreakE(label, v) -> compile_break(e, c, label, v)?
        ContinueE(label) -> compile_continue(e, c, label)?
        BlockE(id, stmts) -> block(e, c.in_block(id)?, stmts)?
        LambdaE(id, _) ->
            c.res.lambdas.get(id) match
                Some(r) -> e.op(MakeClosure(c.res.rels.at(r).chunk, 0))
                None -> return Err(s"lambda $id was never resolved")
        ReturnE(v) ->
            v match
                Some(a) -> compile_value(e, c, a)?
                None -> e.op(PushUnit)

            leave_scans(e, c.scans)
            e.op(ReturnCommit)
        FailE -> e.op(Fail)
        ListE(items) ->
            for a in items.view()
                compile_value(e, c, a)?

            e.op(PushNil)

            for _ in 0..<items.len()
                e.op(MakeCons)
        BangE(a) ->
            compile_value(e, c, a)?
            e.op(GenStart(false))
            e.op(GenNext)
        RangeE(from, upto, by, inclusive) ->
            compile_value(e, c, from)?
            compile_value(e, c, upto)?

            by match
                Some(k) -> compile_value(e, c, k)?
                None -> e.op(PushInt(1))

            e.op(PushInt(0))
            e.op(GenRange(inclusive))
        RepAltE(a) ->
            val top = e.label()

            e.place(top)
            e.op(MarkThrough)
            compile_value(e, c, a)?
            e.op(ChangeMark(top))
        YieldE(a) -> suspend(e, c, a, false)?
        AssignE(n, a) ->
            compile_value(e, c, a)?
            e.op(Dup)
            e.op(store_to(c, n, x.span.end)?)
        CompoundE(n, o, a) ->
            compile_value(e, c, a)?

            val v = variable(c, n, x.span.start)?

            if changes_val(o, c.meaning(n, x.span.start))
                e.op(InPlace(v.depth, v.slot, o))
            else
                e.op(Update(v.depth, v.slot, o))
        StepE(n, delta, prefix) ->
            val v = variable(c, n, x.span.start)?

            if !prefix then e.op(LoadSlot(v.depth, v.slot))

            e.op(PushInt(delta))
            e.op(Update(v.depth, v.slot, Add))

            if !prefix then e.op(Pop)
        MultiAssignE(targets, values) ->
            for a in values.view()
                compile_value(e, c, a)?

            var i = targets.len()

            while i > 0
                i -= 1
                e.op(store_to(c, targets.at(i).value, x.span.end)?)

            e.op(PushUnit)
        ConsE(h, t) -> binary(e, c, h, t, MakeCons)?
        RangeValE(from, upto, by, inclusive) ->
            compile_value(e, c, from)?

            upto match
                Some(u) -> compile_value(e, c, u)?
                None -> ()

            by match
                Some(k) -> compile_value(e, c, k)?
                None -> e.op(PushInt(1))

            e.op(MakeRange(inclusive, upto.is_none(), false))
        RangeCountE(from, n, by) ->
            compile_value(e, c, from)?
            compile_value(e, c, n)?

            by match
                Some(k) -> compile_value(e, c, k)?
                None -> e.op(PushInt(1))

            e.op(MakeRange(false, false, true))
        CompE(id, elem, gens, set) -> compile_comprehension(e, c, id, elem, gens, set)?
        InE(a, coll, negated) -> binary(e, c, a, coll, Member(negated))?
        IsE(a, t, at) ->
            compile_value(e, c, a)?

            type_test(c.res.data_type(t), c.res.qualified_or(t, c.meaning(t, at.start)), t) match
                Some(CtorT(id)) -> e.op(TestType(c.res.ctor_test(t, id)))
                Some(test) -> e.op(TestType(test))
                None -> return Err(s"`$t` is not a type, and the resolver let it through")
        DefinedE(a, defined) ->
            compile_value(e, c, a)?
            e.op(TestDefined(defined))
        FieldE(a, name) ->
            qualified_in(c, a, name) match
                Some(m) -> push_meaning(e, c, m, name)?
                None ->
                    compile_value(e, c, a)?
                    e.op(Field(intern(name)))
        RevAssignE(n, a) ->
            compile_value(e, c, a)?
            e.op(Dup)

            val v = variable(c, n, x.span.end)?

            e.op(StoreBack(v.depth, v.slot))
        UndefE -> e.op(PushConst(e.constant(Undefined)))
        MapE(keys, vals) -> compile_map(e, c, keys, vals)?
        SetE(items) -> compile_set(e, c, items)?
        SetElemE(coll, k, a, back) -> compile_store(e, c, coll, k, a, back)?
        UpdateElemE(coll, k, o, a) -> compile_update(e, c, coll, k, o, a)?
        InterpE(parts) -> compile_interp(e, c, parts)?
        ScanE(s, body) ->
            compile_value(e, c, s)?
            e.op(ScanBegin)
            compile_value(e, c.in_scan(), body)?
            e.op(ScanEnd)
        CatchE(id, s, pat, guard, r) -> compile_catch(e, c, id, s, pat, guard, r)?
        RegexE(p, groups) -> compile_pattern_value(e, c, p, groups)?
        AsE(_, _) -> return Err("a pattern the resolver refused reached the compiler")
        SectionL(_, _) -> return Err("a section the resolver refused reached the compiler")
        BadE -> return Err("a tree with a parse error in it reached the compiler")

    Ok(())
end compile_value

// `f(args)` for a callee that is an expression, in tail position when `tail` (and then followed by
// `Return`). **`x.name(args)` is a method call**: `MethodOf` before the arguments and `CallMethod`
// after, so a handle's method is found by name when it is called, and any other `x` has its field
// read before the arguments are made, as `Field` then `CallValue` would.
apply(e: *Emit, c: Ctx, f: &Expr, args: Buf[&Expr], tail: bool) -> Result[unit, string]
    // `m.f(args)`, `m` a module: a call of what the module exports as `f`, made directly.
    qualified_callee(c, f) match
        Some(m) -> return call_meaning(e, c, m, callee_name(f), args, tail)
        None -> ()

    val method = f.kind match
        FieldE(x, name) ->
            compile_value(e, c, x)?
            e.op(MethodOf(intern(name)))
            Some(intern(name))
        _ ->
            compile_value(e, c, f)?
            None

    for a in args.view()
        compile_value(e, c, a)?

    method match
        Some(name) -> e.op(CallMethod(name, args.len(), tail))
        None -> e.op(if tail then TailCallValue(args.len()) else CallValue(args.len()))

    if tail then e.op(Return)

    Ok(())

// `yield a`: `Choice(after); a; Return; after:` -- the choice point is pushed before `a`, so `a`'s
// own generators are newer and are resumed first, and only when they are spent does the function
// carry on past the `yield`. What it carries on with is `()`, or -- where the `yield` is the last
// thing the body does (`last`) -- nothing: the function has no more values to produce, and fails.
// Not `private`: a function body's tail position compiles `yield` with it too.
suspend(e: *Emit, c: Ctx, a: &Expr, last: bool) -> Result[unit, string]
    val after = e.label()

    e.op(Choice(after))
    compile_value(e, c, a)?
    leave_scans(e, c.scans)
    e.op(Return)
    e.place(after)
    e.op(if last then Fail else PushUnit)
    Ok(())

// `a | b`, or `a or b` when each side is a condition (`conditions`).
private alternation(e: *Emit, c: Ctx, a: &Expr, b: &Expr, conditions: bool) -> Result[unit, string]
    val other = e.label()
    val end = e.label()

    e.op(Choice(other))
    compile_value(e, c, a)?

    if conditions then e.op(FailIfFalse)

    e.op(Branch(end))
    e.place(other)
    compile_value(e, c, b)?

    if conditions then e.op(FailIfFalse)

    e.place(end)
    Ok(())

// `[elem | p <- c if f, ...]`, or `{...}` (`set`): every value of `elem` for every combination of
// the bindings, collected in the comprehension's hidden slot. The bindings run exactly as a `for`'s
// do; the element is generated in full, each value collected and then failed past, until failure
// reaches the mark that ends the whole and the collection is pushed.
private compile_comprehension(e: *Emit, c: Ctx, id: usize, elem: &Expr, gens: Buf[ForGen], set: bool) -> Result[unit, string]
    val inner = c.in_block(id)?
    val acc = slot_of_name(inner, collected_name(id))?
    val done = e.label()

    e.op(PushNil)
    e.op(StoreSlot(acc))
    e.op(Mark(done))

    for g in gens.view()
        bind_generator(e, inner, g)?

    compile_value(e, inner, elem)?
    e.op(Collect(acc))
    e.op(Fail)
    e.place(done)
    e.op(Collected(acc, set))
    Ok(())

// A variable's place: the frame `depth` static links up, and its slot there.
struct SlotRef
    depth: usize
    slot: usize

// The variable `n` names at offset `pos`.
private variable(c: Ctx, n: string, pos: usize) -> Result[SlotRef, string] = c.meaning(n, pos) match
    Local(depth, slot, _) -> Ok(SlotRef(depth, slot))
    _ -> Err(s"'$n' was resolved and is not a variable")

// The instruction storing the top of the stack into the variable `n` names at offset `pos`.
private store_to(c: Ctx, n: string, pos: usize) -> Result[Op, string]
    val v = variable(c, n, pos)?

    Ok(if v.depth == 0 then StoreSlot(v.slot) else StoreUp(v.depth, v.slot))

// `name(args)`, the name written at offset `pos`: a call of whatever the name means. In tail
// position (`tail`) a call that can reuse the frame is a tail call, and every path ends in `Return`.
call_named(e: *Emit, c: Ctx, n: string, pos: usize, args: Buf[&Expr], tail: bool) -> Result[unit, string] =
    call_meaning(e, c, c.meaning(n, pos), n, args, tail)

// The same, of a name `n` that means `m`: a name of the file's own, or one a module exports.
call_meaning(e: *Emit, c: Ctx, m: Meaning, n: string, args: Buf[&Expr], tail: bool) -> Result[unit, string]
    if is_swap(m, n)
        compile_swap(e, c, args)?

        if tail then e.op(Return)

        return Ok(())

    if is_combinator(m, n)
        val built = combinator(c, n, args)?

        compile_pattern_value(e, c, built.pat, built.groups)?

        if tail then e.op(Return)

        return Ok(())

    if is_all_solutions(m, n)
        all_solutions(e, c, n, args)?

        if tail then e.op(Return)

        return Ok(())

    m match
        Function(r, up) ->
            val rel = c.res.rels.at(r)

            if args.len() == rel.arity + 1
                function_as_relation(e, c, rel.chunk, up, args)?

                if tail then e.op(Return)

                return Ok(())
        _ -> ()

    // A module of FunL's own named by `import * as` is a map, and a call indexes it.
    val module_map = m match
        Unknown -> c.res.aliases.get(n)
        _ -> None

    // A constant builtin applied is its value applied, as a variable holding that value is.
    val constant = m match
        Builtin(id) -> is_constant(id)
        _ -> false

    m match
        Local(depth, slot, _) -> e.op(LoadSlot(depth, slot))
        Builtin(id) -> if constant then push_builtin(e, id, n)?
        _ ->
            module_map match
                Some(index) -> push_module_map(e, index)?
                None -> ()

    for a in args.view()
        compile_value(e, c, a)?

    val argc = args.len()

    if module_map.is_some() || constant
        e.op(if tail then TailCallValue(argc) else CallValue(argc))

        if tail then e.op(Return)

        return Ok(())

    m match
        Local(_, _, _) -> e.op(if tail then TailCallValue(argc) else CallValue(argc))
        Function(r, up) ->
            val chunk = c.res.rels.at(r).chunk

            e.op(if tail then TailCallFn(chunk, argc, up) else CallFn(chunk, argc, up))
        Relation(r) ->
            val chunk = c.res.rels.at(r).chunk

            e.op(if tail then TailCall(chunk, argc) else Call(chunk, argc))
        Predicate(name) ->
            val chunk = predicate_chunk(name, argc)

            e.op(if tail then TailCall(chunk, argc) else Call(chunk, argc))
        Builtin(id) ->
            if current().natives.at(id).name == "consult"
                e.op(Consult)
            elif is_generator(id)
                e.op(PushInt(0))
                e.op(NativeGen(id, argc))
            else
                e.op(Native(id, argc))
        Constructor(id) -> e.op(MakeRecord(c.res.made_ctor(n, id, argc), argc))
        _ -> return Err(s"'$n' was resolved and names nothing")

    if tail then e.op(Return)

    Ok(())
end call_meaning

// A function of `n` parameters called with `n + 1` arguments, in a goal: the relation `f/(n+1)`,
// whose last argument is unified with the function's value. Its value is `()`, as a relation's is;
// a function that generates leaves its choice points, so each value it gives is one solution.
private function_as_relation(e: *Emit, c: Ctx, chunk: usize, up: usize, args: Buf[&Expr]) -> Result[unit, string]
    val n = args.len() - 1

    for i in 0..<n
        compile_value(e, c, args.at(i))?

    e.op(CallFn(chunk, n, up))
    compile_value(e, c, args.at(n))?
    e.op(Unify)
    e.op(Pop)
    e.op(PushUnit)
    Ok(())

// `findall(t, g)`, `bagof(t, g)` or `setof(t, g)`: run `g` to exhaustion, collecting a copy of `t`
// at each solution into the operand cell below the form's mark (`copy.sysl`). `g` runs inside the
// mark, so it is evaluated only here, and every choice point it leaves is gone when the mark is
// failed into.
private all_solutions(e: *Emit, c: Ctx, n: string, args: Buf[&Expr]) -> Result[unit, string]
    val done = e.label()
    val how = if n == "findall" then AllFound elif n == "bagof" then Bag else SortedSet

    e.op(PushNil)
    e.op(Mark(done))
    compile_value(e, c, args.at(1))?
    e.op(Pop)
    compile_value(e, c, args.at(0))?
    e.op(CollectCopy)
    e.op(Fail)
    e.place(done)
    e.op(Gathered(how))
    Ok(())

// `a op b`: both values, then the instruction that compares or combines them.
private binary(e: *Emit, c: Ctx, a: &Expr, b: &Expr, o: Op) -> Result[unit, string]
    compile_value(e, c, a)?
    compile_value(e, c, b)?
    e.op(o)
    Ok(())

// A bounded condition: its first value or nothing, then on to what follows; to `other` if it fails
// or its value is `false`. Not `private`: a relation's and a function's tail positions compile `if`
// with it too.
condition(e: *Emit, c: Ctx, cond: &Expr, other: usize) -> Result[unit, string]
    e.op(Mark(other))
    compile_value(e, c, cond)?
    e.op(FailIfFalse)
    e.op(Unmark)
    Ok(())

// A block's statements, each bounded but the last, whose value is the block's.
private block(e: *Emit, c: Ctx, stmts: Buf[Stmt]) -> Result[unit, string]
    for i in 0..<stmts.len()
        val s = stmts.at(i)

        if i + 1 < stmts.len()
            compile_stmt(e, c, s)?
            continue

        s match
            ExprS(x) -> compile_value(e, c, x)?
            _ ->
                compile_stmt(e, c, s)?
                e.op(PushUnit)

    Ok(())
end block

// A statement: `free` makes its variables, `val` matches its pattern against the first value of
// its expression, a local `def` emits nothing -- its function is called directly -- and an
// expression runs bounded and is dropped.
compile_stmt(e: *Emit, c: Ctx, s: Stmt) -> Result[unit, string]
    s match
        FreeS(names) ->
            for named in names.view()
                e.op(NewVar(slot_of_name(c, named.value)?))
        ExprS(x) ->
            val next = e.label()

            e.op(Mark(next))
            compile_value(e, c, x)?
            e.op(Unmark)
            e.place(next)
        ValS(pat, x, fixed) ->
            val next = e.label()

            e.op(Mark(next))

            // `name(k) = x` with `name` a variable writes into an element, as the resolver decided.
            if !fixed && writes_element(pat, c.meaning(call_name(pat), pat.span.start))
                pat.kind match
                    CallE(n, at, args) -> compile_store(e, c, expr(Ref(n), at), args.at(0), x, false)?
                    _ -> ()
            else
                compile_value(e, c, x)?
                match_fresh(e, c, pat)?

            e.op(Unmark)
            e.place(next)
        VarS(n, _, x) ->
            val next = e.label()

            e.op(Mark(next))

            x match
                Some(v) -> compile_value(e, c, v)?
                None -> e.op(PushConst(e.constant(Undefined)))

            e.op(StoreSlot(slot_of_name(c, n)?))
            e.op(Unmark)
            e.place(next)
        DefS(_) -> ()

        // A constructor's name is resolved to the constructor wherever it is read; nothing is stored.
        DataS(_, _) -> ()

    Ok(())

// The slot the block being compiled declares `n` in.
slot_of_name(c: Ctx, n: string) -> Result[usize, string] = c.res.scopes.at(c.sc).declared(c.blk, n) match
    Some(s) -> Ok(s)
    None -> Err(s"'$n' was resolved and has no slot")
