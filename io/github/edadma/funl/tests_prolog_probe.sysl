module io.github.edadma.funl
@tests

// The probe that no standard builtin is missing: every builtin predicate of ISO 13211-1 and its
// corrigenda 1-3, every predicate in the builtin-set table of `prolog.md` § "The builtin set", and
// every one the reference page's table lists, called with fresh arguments -- and none may raise `existence_error(procedure, _)`.
//
// A goal with fresh arguments mostly raises an instantiation error, which is fine: only a missing
// procedure fails the probe. Each runs once, its output captured, with the current input an empty
// file, so that none waits for input and `repeat/0` does not loop. `halt/0-1` are left out, as they
// would end the run.

// The ISO builtins, by the clauses of the standard that define them.
private const IsoBuiltins: string =
    // 7.8 control constructs, 8.15 logic and control, and call/2-8 and false/0 of Cor. 2.
    "true/0, fail/0, false/0, !/0, (',')/2, (;)/2, (->)/2, call/1, call/2, call/3, call/4, call/5, call/6, call/7, call/8, " +
    "catch/3, throw/1, (\\+)/1, once/1, repeat/0, " +
    // 8.2 unification, with subsumes_term/2 of Cor. 2.
    "(=)/2, unify_with_occurs_check/2, (\\=)/2, subsumes_term/2, " +
    // 8.3 type testing, with callable/1, ground/1 and acyclic_term/1 of Cor. 2.
    "var/1, atom/1, integer/1, float/1, atomic/1, compound/1, nonvar/1, number/1, callable/1, ground/1, acyclic_term/1, " +
    // 8.4 term comparison, with compare/3, sort/2 and keysort/2 of Cor. 2.
    "(@=<)/2, (==)/2, (\\==)/2, (@<)/2, (@>)/2, (@>=)/2, compare/3, sort/2, keysort/2, " +
    // 8.5 term creation and decomposition, with term_variables/2 of Cor. 2.
    "functor/3, arg/3, (=..)/2, copy_term/2, term_variables/2, " +
    // 8.6 and 8.7 arithmetic.
    "(is)/2, (=:=)/2, (=\\=)/2, (<)/2, (=<)/2, (>)/2, (>=)/2, " +
    // 8.8 to 8.10 clauses and all solutions, with retractall/1 of Cor. 2.
    "clause/2, current_predicate/1, asserta/1, assertz/1, retract/1, abolish/1, retractall/1, findall/3, bagof/3, setof/3, " +
    // 8.11 stream selection and control.
    "current_input/1, current_output/1, set_input/1, set_output/1, open/3, open/4, close/1, close/2, flush_output/0, " +
    "flush_output/1, stream_property/2, at_end_of_stream/0, at_end_of_stream/1, set_stream_position/2, " +
    // 8.12 and 8.13 character and byte input and output.
    "get_char/1, get_char/2, get_code/1, get_code/2, peek_char/1, peek_char/2, peek_code/1, peek_code/2, put_char/1, " +
    "put_char/2, put_code/1, put_code/2, nl/0, nl/1, get_byte/1, get_byte/2, peek_byte/1, peek_byte/2, put_byte/1, put_byte/2, " +
    // 8.14 term input and output.
    "read_term/2, read_term/3, read/1, read/2, write_term/2, write_term/3, write/1, write/2, writeq/1, writeq/2, " +
    "write_canonical/1, write_canonical/2, op/3, current_op/3, char_conversion/2, current_char_conversion/2, " +
    // 8.16 atomic term processing.
    "atom_length/2, atom_concat/3, sub_atom/5, atom_chars/2, atom_codes/2, char_code/2, number_chars/2, number_codes/2, " +
    // 8.17 implementation-defined hooks, halt/0-1 left out.
    "set_prolog_flag/2, current_prolog_flag/2"

// The builtin-set table of `prolog.md`, beyond ISO's.
private const TableBuiltins: string =
    "not/1, ignore/1, forall/2, between/3, setup_call_cleanup/3, call_cleanup/2, " +
    "is_list/1, string/1, succ/2, plus/3, " +
    "assert/1, dynamic/1, findall/4, aggregate_all/3, predicate_property/2, " +
    "atom_number/2, atom_string/2, string_concat/3, string_chars/2, string_codes/2, split_string/4, sub_string/5, " +
    "upcase_atom/2, term_to_atom/2, atomic_list_concat/2, atomic_list_concat/3, char_type/2, code_type/2, " +
    "append/3, member/2, memberchk/2, length/2, nth0/3, nth1/3, reverse/2, last/2, msort/2, sort/4, predsort/3, " +
    "sum_list/2, max_list/2, min_list/2, max_member/2, min_member/2, list_to_set/2, exclude/3, include/3, " +
    "maplist/2, maplist/3, maplist/4, maplist/5, foldl/4, foldl/5, foldl/6, nb_getval/2, b_getval/2, setarg/3, nb_setarg/3, " +
    "writeln/1, print/1, print/2, tab/1, tab/2, format/1, format/2, format/3, with_output_to/2, " +
    "read_line_to_string/2, read_line_to_codes/2, statistics/2, get_time/1, " +
    "phrase/2, phrase/3, consult/1, ensure_loaded/1, discontiguous/1"

// The rest of the reference page's builtin table (`docs/reference/prolog.md` § "The builtin set").
private const ReferenceBuiltins: string =
    "(*->)/2, (=@=)/2, (\\=@=)/2, unifiable/3, (?=)/2, rational/1, cyclic_term/1, numbervars/3, numbervars/4, rational/3, " +
    "downcase_atom/2, atom_to_term/3, string_to_atom/2, string_code/3, string_length/2, string_upper/2, string_lower/2, " +
    "number_string/2, term_string/2, append/2, delete/3, select/3, selectchk/3, subtract/3, intersection/3, union/3, " +
    "permutation/2, flatten/2, numlist/3, sumlist/2, partition/4, keysort/2, nb_setval/2, b_setval/2, dcg_translate_rule/2"

@test
NO_STANDARD_BUILTIN_IS_MISSING()
    val d = scratch()
    defer scrap(d)

    val empty = put(d, "empty.txt", "")
    val probe = s"probe([$IsoBuiltins, $TableBuiltins, $ReferenceBuiltins]).\n" +
        s":- open('$empty', read, In), set_input(In), probe(Ps), " +
        "findall(N/A, (member(N/A, Ps), functor(G, N, A), catch(with_output_to(string(_), G), E, true), " +
        "nonvar(E), E = error(existence_error(procedure, _), _)), Missing), writeq(missing(Missing)), nl.\n"

    // On the roomy heap alone: the list of some 270 goals and what they leave outgrow the heap that is
    // collected at every step, and each builtin's collection safety is its own tests' business.
    assert_eq(roomy(() -> prolog_text(probe)).text, "missing([])\nsucceeded")

@test
THE_PROBE_FINDS_A_MISSING_PREDICATE()
    // The probe's own check, on a name nothing defines: it is reported, where a goal that raises
    // another error is not.
    val probe = "probe([no_such_builtin/2, atom_length/2]).\n" +
        ":- probe(Ps), findall(N/A, (member(N/A, Ps), functor(G, N, A), catch(with_output_to(string(_), G), E, true), " +
        "nonvar(E), E = error(existence_error(procedure, _), _)), Missing), writeq(missing(Missing)), nl.\n"

    assert_eq(ran_prolog(probe), "missing([no_such_builtin/2])\nsucceeded")
