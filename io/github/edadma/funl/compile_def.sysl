module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.path.{join, parent}

// Relations, and the whole program.
//
// **A relation is a `Choice` per clause but the last**, so its clauses are alternatives that are
// all tried, and a relation that reaches its last clause leaves nothing behind for itself:
//
//     Choice(c2)
//     Frame(n); <head>; NewVar for each body variable; <body in tail position>
//     c2: ...
//
// A relation whose first head arguments say something is reached through its first-argument index
// instead (`index.sysl`), whose chains make the choice points, and its clauses carry none.
//
// **The head is unified, not matched** (`logic.md` § "Head unification is two-way"): a variable's
// first occurrence is `GetVar`, a later one `GetValue`, a constant `GetConst` and a term
// `GetCompound` with its arguments read off the stack -- each binding an unbound argument of the
// caller's rather than refusing it.
//
// **A body ends in tail position.** A call there is a `TailCall`, which reuses the frame when the
// clause has made nothing resumable; every other goal returns `()` with `Return`, which leaves the
// body's choice points standing so the caller sees every solution.

// The program in `src`, compiled into the running VM: the chunk to run, or `None` with the reasons
// in `report`. Warnings alone do not stop it.
//
// The modules it imports are registered as they are compiled; when the program is refused they are
// forgotten again, since their top levels will never run.
compile_program(src: Source, report: *Report) -> Option[usize]
    val v = current()
    val before = load_mark()

    v.loading.push(src.name)

    val made = compile_funl(src, TopUp, report)

    v.loading.pop()

    made match
        Ok(out) -> Some(out.chunk)
        Err(_) ->
            forget_since(before)
            None

// The FunL module in `src`, loaded as number `m` (`module.sysl`), compiled into the running VM: its
// exports and the chunk that runs its top level and returns `()`, or why it was refused with the
// reasons in `report`.
compile_module(src: Source, top_up: usize, report: *Report) -> Result[ModuleOut, Refusal] = compile_funl(src, top_up, report)

// The FunL code in `src`, whose top level's frame `top_up` names: a program for `TopUp`, whose
// chunk halts, and otherwise a module, whose chunk keeps its frame, takes its exports' snapshot and
// returns.
private compile_funl(src: Source, top_up: usize, report: *Report) -> Result[ModuleOut, Refusal]
    val prog = parse(src, report)

    if report.has_errors() then return Err(Unreadable)

    // What the imports bring is loaded first, so the resolver knows the Prolog files' predicates and
    // the modules' exports by name.
    val im = imports_of(src, prog, report)

    if report.has_errors() then return Err(Unreadable)

    var res = resolve(src, prog, top_up, im, report)

    if report.has_errors() then return Err(Unreadable)

    val program = top_up == TopUp

    // A program's definitions are all Prolog's to call; a module's exports become predicates only
    // when a Prolog file imports it.
    var why: Refusal = Unreadable

    if program
        why = match_up(src, &res, report) match
            Ok(w) -> w
            Err(e) ->
                report.add(error(point(0), s"the compiler failed: $e"))
                return Err(Unreadable)

    if report.has_errors() then return Err(why)

    var out = module_exports(&res, prog.exports, !program, report)

    if report.has_errors() then return Err(Unreadable)

    compiled(&res, im.loads, out) match
        Ok(chunk) ->
            out.chunk = chunk
            Ok(out)
        Err(e) ->
            report.add(error(point(0), s"the compiler failed: $e"))
            Err(Unreadable)
end compile_funl

// `import "file.pl"`: the Prolog file, read relative to the directory of the program importing it,
// loaded into the VM; the chunk that runs its directives, or `None` with the reason reported at the
// import. **A file is loaded once in the program**, known by its real path (`same_file`), however
// many of the program's files import it, as a FunL module is.
imported(src: Source, i: Spanned[string], report: *Report) -> Option[usize] =
    imported_file(module_path(src.name, i.value), i.span, report)

// The Prolog file `file` loaded into the VM, for an import written at `at`: the chunk that runs its
// directives, or `None` -- loaded already, or refused with the reason reported at `at`.
imported_file(file: string, at: Span, report: *Report) -> Option[usize]
    val v = current()

    for f in v.pl_imports.view()
        if same_file(f, file) then return None

    v.pl_imports.push(file)

    val text = read_text(file) match
        Ok(t) -> t
        Err(e) ->
            report.add(error(at, s"`$file` cannot be read: $e"))
            return None

    val pl = source_of(file, text)
    var inner = full_report()

    load_prolog(pl, &inner) match
        Ok(chunk) -> Some(chunk)
        Err(_) ->
            report.add(error(at, s"`$file` could not be loaded").with_note(inner.render(pl)))
            None
end imported_file

// Make the program's top-level definitions predicates Prolog can call by name and arity: a relation
// `r` of `n` arguments as `r/n`, a function `f` of `n` parameters as `f/(n+1)`, whose last argument
// is unified with each value the function gives.
//
// **A key a Prolog file has already defined is refused**, naming both definitions: Prolog and FunL
// share one predicate for each name and arity. A key of the library's is taken over, as a Prolog
// program's own definition takes it over. A builtin's key stays the builtin's: the FunL definition is
// FunL's own under its name and Prolog does not see it, which no load order can change.
//
// Answers why the code is refused when a key was: the first key refused, or `Unreadable` when none.
private match_up(src: Source, res: *Resolved, report: *Report) -> Result[Refusal, string]
    var why: Refusal = Unreadable

    for i in 0..<res.rels.len()
        val r = res.rels.at(i)

        if !is_top_rel(res, i) then continue

        val key = if r.function then pred_key(r.name, r.arity + 1) else pred_key(r.name, r.arity)

        if is_builtin(key) then continue

        val head = r.clauses.at(0).head
        val at = located(src, head.start)

        val what = if r.function
            s"the FunL function `${r.name}` at $at, which is `$key` to Prolog"
        else
            s"the FunL relation `${r.name}` at $at"

        val origin = Origin(src.name, what)

        clash(key, origin) match
            Some(m) ->
                why = refusal(why, report, Taken(key_name(key), if r.function then r.arity + 1 else r.arity))
                report.add(error(head, m))
                continue
            None -> ()

        funl_predicate(key, r.name, r.chunk, r.arity, r.function, res.top_up, origin)?

    Ok(why)
end match_up

// Define predicate `key` as the FunL definition `name` compiled into `chunk`: a relation of `arity`
// arguments called with them, or a function of `arity` parameters whose value is unified with the
// last argument, its frames' static link the frame `up` names.
funl_predicate(key: string, name: string, chunk: usize, arity: usize, function: bool, up: usize, origin: Origin) -> Result[unit, string]
    var e = emit(name)

    for k in 0..<arity
        e.op(LoadArg(k))

    if function
        e.op(CallFn(chunk, arity, up))
        e.op(LoadArg(arity))
        e.op(Unify)
        e.op(Pop)
        e.op(PushUnit)
        e.op(Return)
    else
        e.op(TailCall(chunk, arity))
        e.op(Return)

    define_predicate(key, e, origin)

// The relations and functions, and the top level: a program's halts; a module's keeps its frame
// for its functions to reach, takes the snapshot of its exports `out` describes, then returns `()`
// to the file that imported it. A definition with no clauses is another module's, already compiled.
private compiled(res: *Resolved, loads: Buf[usize], out: ModuleOut) -> Result[usize, string]
    for r in res.rels.view()
        if r.clauses.len() == 0 then continue

        if r.function then compile_function(res, r)? else compile_relation(res, r)?

    val program = res.top_up == TopUp
    var e = emit(if program then "main" else "top level")
    var loops: Buf[Looping] = buf()
    val c = context(res, res.top, &loops)

    e.op(Frame(res.scopes.at(res.top).count()))

    if !program then e.op(KeepTop(TopUp - 1 - res.top_up))

    // What each imported file's directives run, before the program's own statements.
    for l in loads.view()
        e.op(Call(l, 0))
        e.op(Pop)

    for s in res.top_stmts.view()
        compile_stmt(&e, c, s)?

    if program
        e.op(Halt)
    else
        snapshot(&e, res, out)?
        e.op(PushUnit)
        e.op(Return)

    finish(e)
end compiled

// The end of a module's top level: each exported variable copied into its snapshot's slot, and the
// map of every export that is a value -- functions, variables, constructors -- made into the map's.
private snapshot(e: *Emit, res: *Resolved, out: ModuleOut) -> Result[unit, string]
    for i in 0..<out.copy_from.len()
        e.op(LoadSlot(0, out.copy_from.at(i)))
        e.op(StoreSlot(out.copy_to.at(i)))

    var n: usize = 0

    for i in 0..<out.exports.len()
        val x = out.exports.at(i)

        val value = x.kind match
            ExFunction(_, _) -> true
            ExValue(_) -> true
            ExCtor(_, _) -> true
            _ -> false

        if !value then continue

        // A name exported at several arities is one entry, the family of them, made at its first.
        var arities: Buf[Member] = buf()
        var earlier = false

        for k in 0..<out.exports.len()
            val y = out.exports.at(k)

            if y.name != x.name then continue

            y.kind match
                ExFunction(chunk, arity) ->
                    if k < i then earlier = true

                    arities.push(FnMember(chunk, arity, res.top_up))
                _ -> ()

        if earlier then continue

        e.op(PushConst(e.constant(new_str(x.name)?)))

        x.kind match
            ExFunction(chunk, _) ->
                if arities.len() > 1
                    e.op(MakeClosure(family_chunk(x.name, arities)?, res.top_up))
                else
                    e.op(MakeClosure(chunk, res.top_up))
            ExValue(slot) -> e.op(LoadSlot(0, slot))
            ExCtor(id, kin) -> push_ctor_value(e, id, Some(kin))?
            _ -> ()

        n += 1

    e.op(MakeMap(n))
    e.op(StoreSlot(out.map_slot))
    Ok(())
end snapshot

private compile_relation(res: *Resolved, r: Rel) -> Result[unit, string]
    var e = emit(r.name)
    var starts: Buf[usize] = buf()

    for _ in 0..<r.clauses.len()
        starts.push(e.label())

    // An indexed relation reaches its clauses through the index's chains, which make the choice
    // points; otherwise each clause but the last is an alternative of its own.
    val index = indexed(r.clauses)

    if index then first_arg_index(&e, clause_keys(r.clauses), starts)

    for i in 0..<r.clauses.len()
        val cl = r.clauses.at(i)
        var sc = res.scopes.at(r.scopes.at(i))
        var loops: Buf[Looping] = buf()
        val c = context(res, r.scopes.at(i), &loops)
        val last = index || i + 1 == r.clauses.len()
        val next = e.label()

        if !last then e.op(Choice(next))

        e.place(starts.at(i))
        e.op(Frame(sc.count()))

        var seen: Buf[bool] = buf()

        for _ in 0..<sc.head
            seen.push(false)

        for j in 0..<cl.params.len()
            head_arg(&e, &sc, cl.params.at(j), Arg(j), &seen)?

        for s in sc.head..<sc.count()
            e.op(NewVar(s))

        cl.kind match
            Rule(body) -> tail(&e, c, body)?
            _ ->
                e.op(PushUnit)
                e.op(Return)

        if !last then e.place(next)

    install(e, r.chunk)
end compile_relation

// One head argument, unified with what `src` reads.
private head_arg(e: *Emit, sc: *Scope, p: &Expr, src: Src, seen: *Buf[bool]) -> Result[unit, string]
    p.kind match
        Ref(n) ->
            val s = sc.slot(n).unwrap()

            if seen.at(s)
                e.op(GetValue(s, src))
            else
                seen.set(s, true)
                e.op(GetVar(s, src))
        Anon ->
            src match
                Popped -> e.op(Pop)
                Arg(_) -> ()
        AtomE(n) -> e.op(GetConst(e.constant(atom(n)), src))
        IntE(n) -> e.op(GetConst(e.constant(Int(n)), src))
        NumE(text) -> e.op(GetConst(e.constant(literal_value(text)?), src))
        StrE(s) -> e.op(GetConst(e.constant(new_str(s)?), src))
        CallE(n, _, args) ->
            e.op(GetCompound(intern(n), args.len(), src))

            for a in args.view()
                head_arg(e, sc, a, Popped, seen)?
        ListE(items) ->
            var from = src

            for a in items.view()
                e.op(GetCons(from))
                head_arg(e, sc, a, Popped, seen)?
                from = Popped

            e.op(GetNil(from))
        ConsE(h, t) ->
            e.op(GetCons(src))
            head_arg(e, sc, h, Popped, seen)?
            head_arg(e, sc, t, Popped, seen)?
        MapE(keys, vals) -> head_map(e, sc, keys, vals, None, src, seen)?
        MapRestE(keys, vals, rest) -> head_map(e, sc, keys, vals, Some(rest), src, seen)?
        _ -> return Err("a head argument the resolver refused reached the compiler")

    Ok(())
end head_arg

// A map pattern in a head: a rest name an earlier argument bound pushed, then its keys, `GetMap`, then
// each value's head argument and the rest's. A key variable no earlier argument has bound is a fresh
// variable here, which `GetMap` refuses as an unbound key.
private head_map(e: *Emit, sc: *Scope, keys: Buf[&Expr], vals: Buf[&Expr], rest: Option[&Expr], src: Src, seen: *Buf[bool]) -> Result[unit, string]
    val named: Option[&Expr] = rest match
        Some(r) -> r.kind match
            Anon -> None
            _ -> Some(r)
        None -> None

    var given = false

    named match
        Some(r) -> r.kind match
            Ref(n) ->
                val s = sc.slot(n).unwrap()

                if seen.at(s)
                    given = true
                    e.op(LoadSlot(0, s))
            _ -> ()
        None -> ()

    for k in keys.view()
        k.kind match
            Ref(n) ->
                val s = sc.slot(n).unwrap()

                if !seen.at(s)
                    seen.set(s, true)
                    e.op(NewVar(s))

                e.op(LoadSlot(0, s))
            AtomE(n) -> e.op(PushConst(e.constant(atom(n))))
            IntE(n) -> e.op(PushConst(e.constant(Int(n))))
            NumE(text) -> e.op(PushConst(e.constant(literal_value(text)?)))
            StrE(s) -> e.op(PushConst(e.constant(new_str(s)?)))
            BoolE(b) -> e.op(PushConst(e.constant(boolean(b))))
            _ -> return Err("a head key the resolver refused reached the compiler")

    e.op(GetMap(keys.len(), named.is_some(), given, rest.is_none() && keys.len() == 0, src))

    for x in vals.view()
        head_arg(e, sc, x, Popped, seen)?

    named match
        Some(r) -> head_arg(e, sc, r, Popped, seen)?
        None -> ()

    Ok(())

// A body in tail position: every path through it ends in `Return`.
private tail(e: *Emit, c: Ctx, x: &Expr) -> Result[unit, string]
    x.kind match
        CallE(n, at, args) ->
            c.res.picked(at.start, n, c.meaning(n, at.start), args.len()) match
                Relation(_) -> call_named(e, c, n, at.start, args, true)?
                Predicate(_) -> call_named(e, c, n, at.start, args, true)?
                _ -> returning(e, c, x)?
        Conj(a, b) ->
            compile_value(e, c, a)?
            thrown_away(e, a)
            e.op(Pop)
            tail(e, c, b)?
        Disj(a, b) ->
            val other = e.label()

            e.op(Choice(other))
            tail(e, c, a)?
            e.place(other)
            tail(e, c, b)?
        IfE(cond, yes, no) ->
            val other = e.label()

            condition(e, c, cond, other)?
            tail(e, c, yes)?
            e.place(other)

            no match
                Some(n) -> tail(e, c, n)?
                None -> e.op(Fail)
        _ -> returning(e, c, x)?

    Ok(())
end tail

// A goal that is not a call, last in a body: run it, then return `()`.
private returning(e: *Emit, c: Ctx, x: &Expr) -> Result[unit, string]
    compile_value(e, c, x)?
    e.op(Pop)
    e.op(PushUnit)
    e.op(Return)
    Ok(())
