module io.github.edadma.funl

import sysl.buf.{Buf, buf}
import sysl.math.Float
import sysl.math.bigint as big
import sysl.text.{Search, char_from_u32, chars_of, from_utf8_unchecked, str_builder}

// Prolog's builtins over the text of atoms: `atom_codes/2`, `atom_chars/2`, `char_code/2`,
// `atom_length/2`, `atom_concat/3`, `sub_atom/5`, `number_codes/2`, `number_chars/2` and
// `atom_number/2`; and their counterparts over strings, as SWI-Prolog has them: `atom_string/2`,
// `string_chars/2`, `string_codes/2`, `string_length/2`, `string_concat/3`, `sub_string/5`,
// `split_string/4`, `upcase_atom/2`, `downcase_atom/2`, `string_upper/2` and `string_lower/2`.
//
// **Where an atom is wanted, any atomic value gives its text**, as SWI-Prolog takes it: a number its
// digits, a string its characters, `[]` the two characters it is written with. ISO asks for an atom;
// accepting the rest refuses nothing a conforming program writes. A compound is a type error either
// way. **Positions and lengths count characters**, not bytes. A string builtin takes the same text and
// differs in what it makes: a string where the atom builtin makes an atom.
//
// **`string_length/2`, `string_chars/2`, `string_codes/2`, `split_string/4` and the string of
// `atom_string/2` read any text**, as SWI-Prolog does: a code list or a character list spells its
// characters too. `string_concat/3`, `sub_string/5` and the case conversions take only atomic text,
// and the ISO builtins over atoms take no list: a list given to `atom_length/2`, `atom_concat/3`,
// `sub_atom/5`, or as the atom of `atom_codes/2` and `atom_chars/2`, is a type error (`TextMode`).
// A string where the ISO builtins want a code list or a character list is its text.

install_prolog_atoms(v: *Vm)
    register_generator(v, "atom_codes/2", 2, (b, n, c) -> atom_and_list(b, "atom_codes/2", false, false))
    register_generator(v, "atom_chars/2", 2, (b, n, c) -> atom_and_list(b, "atom_chars/2", true, false))
    register_generator(v, "char_code/2", 2, pl_char_code)
    register_generator(v, "atom_length/2", 2, (b, n, c) -> text_length(b, "atom_length/2"))
    register_generator(v, "atom_concat/3", 3, (b, n, c) -> text_concat(b, c, "atom_concat/3", false))
    register_generator(v, "sub_atom/5", 5, (b, n, c) -> sub_text(b, c, "sub_atom/5", false))
    register_generator(v, "number_codes/2", 2, (b, n, c) -> number_and_list(b, "number_codes/2", false))
    register_generator(v, "number_chars/2", 2, (b, n, c) -> number_and_list(b, "number_chars/2", true))
    register_generator(v, "atom_number/2", 2, pl_atom_number)
    register_generator(v, "atom_string/2", 2, pl_atom_string)
    register_generator(v, "string_codes/2", 2, (b, n, c) -> atom_and_list(b, "string_codes/2", false, true))
    register_generator(v, "string_chars/2", 2, (b, n, c) -> atom_and_list(b, "string_chars/2", true, true))
    register_generator(v, "string_length/2", 2, (b, n, c) -> text_length(b, "string_length/2"))
    register_generator(v, "string_concat/3", 3, (b, n, c) -> text_concat(b, c, "string_concat/3", true))
    register_generator(v, "sub_string/5", 5, (b, n, c) -> sub_text(b, c, "sub_string/5", true))
    register_generator(v, "split_string/4", 4, pl_split_string)
    register_generator(v, "upcase_atom/2", 2, (b, n, c) -> case_of(b, "upcase_atom/2", true, false))
    register_generator(v, "downcase_atom/2", 2, (b, n, c) -> case_of(b, "downcase_atom/2", false, false))
    register_generator(v, "string_upper/2", 2, (b, n, c) -> case_of(b, "string_upper/2", true, true))
    register_generator(v, "string_lower/2", 2, (b, n, c) -> case_of(b, "string_lower/2", false, true))
    register_generator(v, "string_code/3", 3, pl_string_code)
    register_generator(v, "number_string/2", 2, pl_number_string)

// How a builtin reads a text argument, as SWI-Prolog reads it:
//
// - `atom_length/2`, `atom_concat/3`, `sub_atom/5` and the atom of `atom_codes/2` and `atom_chars/2`
//   take any atomic value, `[]` the two characters it is written with; anything else is
//   `type_error(atom, X)`.
// - `string_concat/3` and the case conversions take an atom, a string or a number; anything else,
//   a list or `[]` among it, is `type_error(atomic, X)` (`type_error(atom, [])` for `[]`).
// - `sub_string/5` takes the same, and anything else is `type_error(string, X)`.
// - `string_length/2`, `string_chars/2` and `string_codes/2` also take a code list or a character
//   list, `[]` the empty one; anything else is `type_error(text, X)`.
// - `split_string/4` takes the same but a number, which with anything else is `type_error(text, X)`.
// - The string of `atom_string/2` takes any text; anything else is `type_error(string, X)`.
private enum TextMode
    IsoAtom
    AtomicText
    SubString
    AnyText
    SplitText
    StringText

private text_mode(who: string) -> TextMode
    if who == "string_concat/3" || who == "upcase_atom/2" || who == "downcase_atom/2" || who == "string_upper/2" ||
            who == "string_lower/2"
        return AtomicText

    if who == "sub_string/5" then return SubString
    if who == "split_string/4" then return SplitText
    if who == "atom_string/2" then return StringText
    if who == "string_length/2" || who == "string_chars/2" || who == "string_codes/2" then return AnyText

    IsoAtom

// The type a text argument read in `mode` is named by in its errors.
private wanted(mode: TextMode) -> string = mode match
    IsoAtom -> "atom"
    AtomicText -> "atomic"
    SubString -> "string"
    StringText -> "string"
    _ -> "text"

private a_wanted(mode: TextMode) -> string = mode match
    IsoAtom -> "an atom"
    AtomicText -> "an atom, a string or a number"
    SubString -> "a string"
    StringText -> "a string"
    _ -> "text"

// Whether `mode` reads a code list or a character list as text.
private reads_lists(mode: TextMode) -> bool = mode match
    AnyText -> true
    SplitText -> true
    StringText -> true
    _ -> false

// The text of `x`, `None` when it is unbound, read as builtin `who` reads it.
private text_of(x: Value, who: string) -> Result[Option[string], Fault] = text_in(x, who, text_mode(who))

// The text of `x` read in `mode`, `None` when it is unbound. A list not yet whole is an instantiation
// error where lists are text, and `type_error(string, L)` for the string of `atom_string/2`.
private text_in(x: Value, who: string, mode: TextMode) -> Result[Option[string], Fault]
    val y = deref(x)

    y match
        Atom(id) -> Ok(Some(atom_name(id)))
        Nil -> mode match
            IsoAtom -> Ok(Some("[]"))
            AtomicText -> Err(type_error("atom", y, s"$who wants ${a_wanted(mode)}, and was given []"))
            SubString -> Err(not_text(y, who, mode))
            _ -> Ok(Some(""))
        Str(p) -> Ok(Some(p.s))
        Var(_) -> Ok(None)
        _ ->
            if reads_lists(mode) && is_cons(y)
                return list_spells(y, who, mode)? match
                    Some(s) -> Ok(Some(s))
                    None -> mode match
                        StringText -> Err(not_text(y, who, mode))
                        _ -> Err(instantiation_error(s"instantiation error: $who was given a list that is not yet whole where it wants text"))

            val numeral = mode match
                SplitText -> false
                _ -> is_num(y)

            if numeral then return Ok(Some(written_number(y)))

            Err(not_text(y, who, mode))

// The text of `x` read as `string_length/2` reads it -- an atom, a string, a number, a code list or a
// character list, `[]` the empty text -- `None` when it is unbound.
any_text(x: Value, who: string) -> Result[Option[string], Fault] = text_in(x, who, AnyText)

private is_cons(y: Value) -> bool = y match
    Cons(_) -> true
    _ -> false

private not_text(y: Value, who: string, mode: TextMode) -> Fault =
    type_error(wanted(mode), y, s"$who wants ${a_wanted(mode)}, and was given ${described(y)}")

// The text of `x`, which must be bound.
private bound_text(x: Value, who: string) -> Result[string, Fault]
    text_of(x, who)? match
        Some(s) -> Ok(s)
        None -> Err(instantiation_error(s"instantiation error: $who was given an unbound variable where it wants ${a_wanted(text_mode(who))}"))

// The text code list or character list `l` spells, its first element deciding which it is: a
// one-character atom starts a character list, and anything else a code list. `None` while the list
// is not yet whole or holds an unbound element. An element of the wrong kind is
// `type_error(character_code, E)` in a code list -- a negative integer among them -- and
// `type_error(character, E)` in a character list, as SWI-Prolog reports it; a code above the last
// character is `representation_error(character_code)`.
private list_spells(l: Value, who: string, mode: TextMode) -> Result[Option[string], Fault]
    var out = str_builder()
    var at = deref(l)
    var codes = false
    var chars = false

    loop
        at match
            Nil -> return Ok(Some(out.finish()))
            Var(_) -> return Ok(None)
            Cons(p) ->
                val e = deref(p.head)
                var took = false

                e match
                    Var(_) -> return Ok(None)
                    Int(k) ->
                        if !chars && k >= 0
                            codes = true
                            took = true
                            out.push_char(code_char(k, who)?)
                    Atom(id) ->
                        if !codes && one_char(atom_name(id))
                            chars = true
                            took = true
                            out.push(atom_name(id))
                    _ -> ()

                if !took
                    if chars then return Err(type_error("character", e, s"$who wants a list of characters, and was given ${described(e)} in it"))

                    return Err(type_error("character_code", e, s"$who wants a list of character codes, and was given ${described(e)} in it"))

                at = deref(p.tail)
            _ -> return Err(not_text(l, who, mode))
end list_spells

// Text made into the value a builtin returns: a string, or an atom.
private made_text(s: string, as_string: bool) -> Result[Value, Fault]
    if !as_string then return Ok(atom(s))

    new_str(s) match
        Ok(v) -> Ok(v)
        Err(e) -> Err(Broken(e))

private one_char_text(c: char) -> string
    var b = str_builder()

    b.push_char(c)
    b.finish()

// The characters of `s` as one-character atoms, or as codes.
private text_list(s: string, chars: bool) -> Result[Value, Fault]
    var items: Buf[Value] = buf()

    for c in chars_of(s.bytes)
        items.push(if chars then atom(one_char_text(c)) else Int(long(u32(c))))

    Ok(list_of(&items, Nil)?)

// The text list `l` spells: one-character atoms, or codes. `None` when it is not yet a whole list or
// an element is unbound, which only an argument that has to be read makes an error. A string in the
// list's place is its text, as SWI-Prolog takes it.
private list_text(l: Value, who: string, chars: bool) -> Result[Option[string], Fault]
    var out = str_builder()
    var at = deref(l)

    at match
        Str(p) -> return Ok(Some(p.s))
        _ -> ()

    loop
        at match
            Nil -> return Ok(Some(out.finish()))
            Var(_) -> return Ok(None)
            Cons(p) ->
                val e = deref(p.head)

                e match
                    Var(_) -> return Ok(None)
                    _ -> ()

                if chars
                    val ok = e match
                        Atom(id) -> one_char(atom_name(id))
                        _ -> false

                    if !ok then return Err(type_error("character", e, s"$who wants a list of characters, and was given ${described(e)} in it"))

                    out.push(atom_text(e))
                else
                    val code = e match
                        Int(k) -> k
                        _ -> return Err(type_error("integer", e, s"$who wants a list of character codes, and was given ${described(e)} in it"))

                    val c = code_char(code, who)?

                    out.push_char(c)

                at = deref(p.tail)
            _ -> return Err(type_error("list", l, s"$who wants a list, and was given ${described(l)}"))
end list_text

private atom_text(x: Value) -> string = x match
    Atom(id) -> atom_name(id)
    _ -> ""

// The character with code `k`: `representation_error(character_code)` when there is none.
private code_char(k: long, who: string) -> Result[char, Fault]
    if k < 0 || k > 1114111 then return Err(no_such_code(k, who))

    char_from_u32(u32(k)) match
        Some(c) -> Ok(c)
        None -> Err(no_such_code(k, who))

private no_such_code(k: long, who: string) -> Fault =
    representation_error("character_code", s"$who was given $k, which is not a character code")

private unbound_list(who: string) -> Fault =
    instantiation_error(s"instantiation error: $who wants its atom or a whole list, and was given neither")

// `atom_codes(A, L)` and `atom_chars(A, L)`; `string_codes(S, L)` and `string_chars(S, L)`.
// The atom builtins read an atom and a list of their own kind, as ISO has them; the string builtins
// read any text on either side.
private atom_and_list(base: usize, who: string, chars: bool, as_string: bool) -> Result[Answer, Fault]
    text_of(arg(base, 0), who)? match
        Some(s) -> return unified(arg(base, 1), text_list(s, chars)?)
        None -> ()

    val given = if as_string then text_of(arg(base, 1), who)? else list_text(arg(base, 1), who, chars)?

    given match
        Some(s) -> unified(arg(base, 0), made_text(s, as_string)?)
        None -> Err(unbound_list(who))

// `char_code(C, N)`.
private pl_char_code(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val c = deref(arg(base, 0))

    c match
        Atom(id) ->
            val name = atom_name(id)

            if !one_char(name) then return Err(type_error("character", c, s"char_code/2 wants a character, and was given $name"))

            val code = Int(long(u32(chars_of(name.bytes).peek().unwrap())))

            int_or_unbound(arg(base, 1), "char_code/2")?
            return unified(arg(base, 1), code)
        Var(_) -> ()
        _ -> return Err(type_error("character", c, s"char_code/2 wants a character, and was given ${described(c)}"))

    val n = deref(arg(base, 1))

    n match
        Int(k) -> unified(c, atom(one_char_text(code_char(k, "char_code/2")?)))
        Var(_) -> Err(instantiation_error("instantiation error: char_code/2 wants a character or a code, and was given neither"))
        _ -> Err(type_error("integer", n, s"char_code/2 wants an integer code, and was given ${described(n)}"))

// An argument that, when bound, must be an integer.
private int_or_unbound(x: Value, who: string) -> Result[unit, Fault]
    val y = deref(x)

    y match
        Int(_) -> Ok(())
        Var(_) -> Ok(())
        _ -> Err(type_error("integer", y, s"$who wants an integer, and was given ${described(y)}"))

// `atom_length(A, N)` and `string_length(S, N)`.
private text_length(base: usize, who: string) -> Result[Answer, Fault]
    val s = bound_text(arg(base, 0), who)?
    val n = deref(arg(base, 1))

    n match
        Int(k) -> if k < 0 then return Err(domain_error("not_less_than_zero", n, s"$who's length is 0 or more, and was given $k"))
        Var(_) -> ()
        _ -> return Err(type_error("integer", n, s"$who wants an integer length, and was given ${described(n)}"))

    unified(n, Int(long(char_count(s))))

// The byte offset of each character of `s`, and of its end.
private char_offsets(s: string) -> Buf[usize]
    var at: Buf[usize] = buf()
    var i: usize = 0

    for c in chars_of(s.bytes)
        at.push(i)
        i += one_char_text(c).bytes.len

    at.push(i)
    at

private between_chars(s: string, at: *Buf[usize], from: usize, to: usize) -> string =
    from_utf8_unchecked(s.bytes[at.at(from)..<at.at(to)])

// `atom_concat(A, B, C)` and `string_concat(A, B, C)`: `C` is `A` followed by `B`; with only `C`
// given, each way of cutting it in two, in turn. A given part, or a given whole, is compared by its
// text, so `atom_concat(X, "b", ab)` and `string_concat(X, c, "abc")` cut at the one place that leaves
// it, as SWI-Prolog does.
private text_concat(base: usize, cursor: long, who: string, as_string: bool) -> Result[Answer, Fault]
    val a = text_of(arg(base, 0), who)?
    val b = text_of(arg(base, 1), who)?

    a match
        Some(x) -> b match
            Some(y) ->
                if as_string then return answer(same_text(arg(base, 2), x + y)?)

                return text_of(arg(base, 2), who)? match
                    Some(whole) -> answer(whole == x + y)
                    None -> unified(arg(base, 2), atom(x + y))
            None -> ()
        None -> ()

    val whole = text_of(arg(base, 2), who)? match
        Some(s) -> s
        None -> return Err(instantiation_error(s"instantiation error: $who wants its first two arguments or its third"))

    var at = char_offsets(whole)
    val n = at.len() - 1
    var k = usize(cursor)

    while k <= n && !cut_fits(whole, &at, k, a, b)
        k += 1

    if k > n then return Ok(Refuses)

    if a.is_none() then unify_on_answer(arg(base, 0), made_text(between_chars(whole, &at, 0, k), as_string)?)
    if b.is_none() then unify_on_answer(arg(base, 1), made_text(between_chars(whole, &at, k, n), as_string)?)

    var next = k + 1

    while next <= n && !cut_fits(whole, &at, next, a, b)
        next += 1

    Ok(if next > n then Gives(Unit) else GivesMore(Unit, long(next)))

// Whether cutting `whole` after `k` characters leaves the given parts' text either side.
private cut_fits(whole: string, at: *Buf[usize], k: usize, a: Option[string], b: Option[string]) -> bool
    val n = at.len() - 1

    val front = a match
        Some(x) -> between_chars(whole, at, 0, k) == x
        None -> true

    val back = b match
        Some(y) -> between_chars(whole, at, k, n) == y
        None -> true

    front && back

// Whether `x` is unbound, then bound to the string `s`, or is atomic with the text `s`; a compound is
// not text and fails, as in SWI-Prolog.
private same_text(x: Value, s: string) -> Result[bool, Fault]
    val y = deref(x)

    y match
        Var(_) -> Ok(unify(y, made_text(s, true)?))
        Atom(id) -> Ok(atom_name(id) == s)
        Nil -> Ok(s == "[]")
        Str(p) -> Ok(p.s == s)
        _ -> Ok(is_num(y) && written_number(y) == s)

// The integer `x` is, `None` when unbound; anything else is a type error.
private optional_int(x: Value, who: string) -> Result[Option[long], Fault]
    val y = deref(x)

    y match
        Int(k) -> Ok(Some(k))
        Var(_) -> Ok(None)
        _ -> Err(type_error("integer", y, s"$who wants an integer, and was given ${described(y)}"))

// A count of characters, `None` when unbound: an integer, and not a negative one --
// `domain_error(not_less_than_zero, N)`.
private count_arg(x: Value, who: string) -> Result[Option[long], Fault]
    val k = optional_int(x, who)?

    k match
        Some(n) -> if n < 0 then return Err(domain_error("not_less_than_zero", deref(x), s"$who counts characters from 0, and was given $n"))
        None -> ()

    Ok(k)

// What `sub_atom/5` was asked: the atom's text and character offsets, and whichever of before,
// length, after and the sub-atom were given.
private struct SubAtomAsk
    s: string
    at: Buf[usize]
    before: Option[long]
    length: Option[long]
    after: Option[long]
    sub: Option[string]

// `sub_atom(Atom, Before, Length, After, Sub)` and `sub_string/5`: each way `Sub` stands in `Atom`
// with `Before` characters before it and `After` after it, by `Before` and then `Length` ascending.
private sub_text(base: usize, cursor: long, who: string, as_string: bool) -> Result[Answer, Fault]
    val s = bound_text(arg(base, 0), who)?

    val sub = deref(arg(base, 4)) match
        Var(_) -> None
        y -> text_of(y, who)?

    var ask = SubAtomAsk(s, char_offsets(s), count_arg(arg(base, 1), who)?, count_arg(arg(base, 2), who)?,
        count_arg(arg(base, 3), who)?, sub)

    val n = long(ask.at.len() - 1)
    val (b, l) = next_place(&ask, cursor / (n + 1), cursor % (n + 1)) match
        Some(p) -> p
        None -> return Ok(Refuses)

    unify_on_answer(arg(base, 1), Int(b))
    unify_on_answer(arg(base, 2), Int(l))
    unify_on_answer(arg(base, 3), Int(n - b - l))
    // A given sub-atom has already been matched by its text, whatever atomic value spells it.
    if ask.sub.is_none()
        unify_on_answer(arg(base, 4), made_text(between_chars(s, &ask.at, usize(b), usize(b + l)), as_string)?)

    next_place(&ask, b, l + 1) match
        Some((b2, l2)) -> Ok(GivesMore(Unit, b2 * (n + 1) + l2))
        None -> Ok(Gives(Unit))
end sub_text

// The first place at or after `b`, `l` -- by `b`, then `l` -- that what was asked allows.
private next_place(ask: *SubAtomAsk, from_b: long, from_l: long) -> Option[(long, long)]
    val n = long(ask.at.len() - 1)
    var b = from_b
    var l = from_l

    ask.before match
        Some(want) ->
            if b > want then return None

            if b < want
                b = want
                l = 0
        None -> ()

    while b <= n
        var lo: long = 0
        var hi: long = n - b

        ask.length match
            Some(k) ->
                lo = if k > lo then k else lo
                hi = if k < hi then k else hi
            None -> ()

        ask.after match
            Some(k) ->
                val m = n - b - k

                lo = if m > lo then m else lo
                hi = if m < hi then m else hi
            None -> ()

        ask.sub match
            Some(t) ->
                val m = long(char_count(t))

                lo = if m > lo then m else lo
                hi = if m < hi then m else hi
            None -> ()

        if l < lo then l = lo

        if l <= hi
            val fits = ask.sub match
                Some(t) -> between_chars(ask.s, &ask.at, usize(b), usize(b + l)) == t
                None -> true

            if fits then return Some((b, l))

        ask.before match
            Some(_) -> return None
            None -> ()

        b += 1
        l = 0

    None
end next_place

// The number text `s` spells, with layout before it and a `-` or `+` touching it allowed: a decimal
// integer of any size, a float, `1.0Inf` or `1.5NaN`, `0x`, `0o`, `0b`, `16'ff`, or `0'c`. `None`
// when it spells no number.
parse_number(s: string) -> Result[Option[Value], Fault]
    val b = s.bytes
    var i: usize = 0

    while i < b.len && (b[i] == u8(' ') || b[i] == u8('\t') || b[i] == u8('\n') || b[i] == u8('\r'))
        i += 1

    var negative = false

    if i < b.len && b[i] == u8('-')
        negative = true
        i += 1
    elif i < b.len && b[i] == u8('+')
        i += 1

    if i >= b.len || b[i] < u8('0') || b[i] > u8('9') then return Ok(None)

    // A comment, which the reader allows after a `_` in a digit group, is no part of a number's text.
    if s.contains("/*") || s.contains("%") then return Ok(None)

    val unsigned = from_utf8_unchecked(b[i..<b.len])

    if unsigned.ends_with("Inf") || unsigned.ends_with("NaN") then return non_finite_number(unsigned, negative)

    if b[i] == u8('0') && i + 1 < b.len && b[i + 1] == u8('\'')
        val rest = from_utf8_unchecked(b[i + 2..<b.len])

        if !one_char(rest) then return Ok(None)

        val code = long(u32(chars_of(rest.bytes).peek().unwrap()))

        return Ok(Some(Int(if negative then -code else code)))

    var radix: long = 10

    if b[i] == u8('0') && i + 2 < b.len
        val r = b[i + 1]

        radix = if r == u8('x') then 16 elif r == u8('o') then 8 elif r == u8('b') then 2 else 10

        if radix != 10 then i += 2

    // `16'ff`: a base from 2 to 36, a quote, and digits in that base.
    if radix == 10
        var j = i
        var r: long = 0

        while j < b.len && j - i < 3 && b[j] >= u8('0') && b[j] <= u8('9')
            r = r * 10 + long(b[j] - u8('0'))
            j += 1

        if j + 1 < b.len && b[j] == u8('\'') && r >= 2 && r <= 36
            radix = r
            i = j + 1

    // Digit groups, as the reader takes them -- `1 000`, `1_000`, `0xff_ff`, `1r2_0` -- in an integer
    // or a rational and nowhere else: a float with groups is no number here.
    val run = digit_run(b[i..<b.len], int(radix))
    val grouped_text = plain_groups(b[i..<i + run.len])
    val tail = b[i + run.len..<b.len]
    val rational = radix == 10 && tail.len > 1 && tail[0] == u8('r') && digit_run(tail[1..<tail.len], 10).len == tail.len - 1
    val denominator_text = if rational then plain_groups(tail[1..<tail.len]) else ""

    if grouped_text.bytes.len != run.len || (rational && denominator_text.bytes.len != tail.len - 1)
        if tail.len > 0 && !rational then return Ok(None)

        val rest = if rational then s"r$denominator_text" else ""
        val prefix = from_utf8_unchecked(b[0..<i])

        return parse_number(s"$prefix$grouped_text$rest")

    // A decimal number is the tower's to read -- an integer of any size, a float, or a rational
    // written `7r2`, which the tower reads as `7/2`; a `/` is no part of Prolog's number syntax.
    if radix == 10
        var rest = from_utf8_unchecked(b[i..<b.len])

        if rest.contains("/") then return Ok(None)

        rest = rational_text(rest) match
            Some(q) -> q
            None -> rest

        val text = if negative then s"-$rest" else rest

        return funl_policy().parse(text) match
            Ok(n) -> num_value(n) match
                Ok(x) -> Ok(Some(x))
                Err(e) -> Err(Broken(e))
            Err(_) -> Ok(None)

    // Any number of digits in the radix, an integer of any size.
    if i >= b.len then return Ok(None)

    for k in i..<b.len
        if digit_value(b[k]) >= radix then return Ok(None)

    val digits = from_utf8_unchecked(b[i..<b.len])

    val whole = big.parse_radix(if negative then s"-$digits" else digits, int(radix)) match
        Some(n) -> n
        None -> return Ok(None)

    prolog_policy().of_big(whole) match
        Ok(n) -> num_value(n) match
            Ok(x) -> Ok(Some(x))
            Err(e) -> Err(Broken(e))
        Err(_) -> Ok(None)
end parse_number

// `text`, which ends in `Inf` or `NaN`, as the reader reads it: a float's digits, with no exponent,
// then `Inf` for an infinity, or `NaN` after a mantissa above 1 and below 2 for a NaN.
private non_finite_number(text: string, negative: bool) -> Result[Option[Value], Fault]
    val mantissa = text.slice(0, text.len - 3)
    val b = mantissa.bytes
    var dot: usize = 0

    while dot < b.len && b[dot] >= u8('0') && b[dot] <= u8('9')
        dot += 1

    if dot == 0 || dot + 1 >= b.len || b[dot] != u8('.') then return Ok(None)

    for k in dot + 1..<b.len
        if b[k] < u8('0') || b[k] > u8('9') then return Ok(None)

    if text.ends_with("Inf") then return Ok(Some(Real(if negative then -real.infinity() else real.infinity())))

    if dot != 1 || b[0] != u8('1') || all_zeros(mantissa.slice(2, mantissa.len)) then return Ok(None)

    Ok(Some(Real(real.nan())))

// `N/M` for text `NrM` -- digits, an `r`, and digits not all `0` -- and `None` for any other text.
private rational_text(s: string) -> Option[string]
    val b = s.bytes
    var at: usize = 0

    while at < b.len && b[at] >= u8('0') && b[at] <= u8('9')
        at += 1

    if at == 0 || at + 1 >= b.len || b[at] != u8('r') then return None

    for k in at + 1..<b.len
        if b[k] < u8('0') || b[k] > u8('9') then return None

    val denominator = from_utf8_unchecked(b[at + 1..<b.len])

    if all_zeros(denominator) then return None

    Some(s"${from_utf8_unchecked(b[0..<at])}/$denominator")

// What digit `c` is worth, in any base up to 16; 99 for a character that is no digit.
private digit_value(c: u8) -> long
    if c >= u8('0') && c <= u8('9') then return long(c - u8('0'))
    if c >= u8('a') && c <= u8('f') then return long(c - u8('a')) + 10
    if c >= u8('A') && c <= u8('F') then return long(c - u8('A')) + 10

    99

// `number_codes(N, L)` and `number_chars(N, L)`: a whole list is read as a number, which `N` must then
// be.
private number_and_list(base: usize, who: string, chars: bool) -> Result[Answer, Fault]
    val n = deref(arg(base, 0))

    if !is_num(n) && !is_unbound(n) then return Err(type_error("number", n, s"$who wants a number, and was given ${described(n)}"))

    list_text(arg(base, 1), who, chars)? match
        Some(text) ->
            parse_number(text)? match
                Some(k) -> return unified(n, k)
                None -> return Err(syntax_error("illegal_number", s"$who: '$text' is not a number"))
        None -> ()

    if is_num(n) then unified(arg(base, 1), text_list(written_number(n), chars)?) else Err(unbound_list(who))

// `atom_number(A, N)`: `A` read as a number, failing when it is none -- as SWI-Prolog does; ISO has no
// such predicate. Unlike `number_codes/2`, layout before the number is not allowed.
private pl_atom_number(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val who = "atom_number/2"

    text_of(arg(base, 0), who)? match
        Some(s) ->
            if s.bytes.len > 0 && is_layout_byte(s.bytes[0]) then return Ok(Refuses)

            parse_number(s)? match
                Some(k) -> unified(arg(base, 1), k)
                None -> Ok(Refuses)
        None ->
            val n = deref(arg(base, 1))

            if is_num(n) then return unified(arg(base, 0), atom(written_number(n)))

            n match
                Var(_) -> Err(instantiation_error("instantiation error: atom_number/2 wants its atom or its number"))
                _ -> Err(type_error("number", n, s"$who wants a number, and was given ${described(n)}"))

private is_layout_byte(c: u8) -> bool = c == u8(' ') || c == u8('\t') || c == u8('\n') || c == u8('\r')

// `atom_string(A, S)`: the atom and the string with the same text. A given `S` decides `A`, compared
// by its text: `S` may be any text, `A` any atomic value. Where `S` is not text but `A` is, `A`
// decides and `S` must be the string.
private pl_atom_string(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val who = "atom_string/2"
    val a = deref(arg(base, 0))

    text_of(arg(base, 1), who) match
        Ok(Some(t)) -> return a match
            Var(_) -> unified(a, atom(t))
            _ -> answer(same_text(a, t)?)
        Ok(None) -> ()
        Err(e) -> a match
            Var(_) -> return Err(e)
            _ -> ()

    // `[]` is the empty text here, as SWI-Prolog reads it; any other atomic value spells its text.
    a match
        Nil -> return answer(same_text(arg(base, 1), "")?)
        _ -> ()

    text_in(a, who, IsoAtom)? match
        Some(t) -> answer(same_text(arg(base, 1), t)?)
        None -> Err(instantiation_error("instantiation error: atom_string/2 wants its atom or its string"))

// `string_code(I, S, C)`: `C` is the code of character `I` of `S`, counting from 1, as SWI-Prolog has
// it. An index past either end fails, a negative one is a domain error, and an unbound one enumerates
// the characters. `S` is any text but a number, a code list or a character list among it.
private pl_string_code(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val who = "string_code/3"

    val s = text_in(arg(base, 1), who, SplitText)? match
        Some(t) -> t
        None -> return Err(instantiation_error(s"instantiation error: $who was given an unbound variable where it wants text"))

    var codes: Buf[long] = buf()

    for c in chars_of(s.bytes)
        codes.push(long(u32(c)))

    val i = deref(arg(base, 0))

    i match
        Int(k) ->
            if k < 0 then return Err(domain_error("not_less_than_zero", i, s"$who's index is 1 or more, and was given $k"))

            if k == 0 || k > long(codes.len()) then return Ok(Refuses)

            return unified(arg(base, 2), Int(codes.at(usize(k - 1))))
        Var(_) -> ()
        _ -> return Err(type_error("integer", i, s"$who wants an integer index, and was given ${described(i)}"))

    // Enumerating: the characters from `cursor` on whose code unifies with `C`.
    val c = deref(arg(base, 2))
    var k = usize(cursor)

    while k < codes.len() && !code_fits(c, codes.at(k))
        k += 1

    if k >= codes.len() then return Ok(Refuses)

    unify_on_answer(arg(base, 0), Int(long(k + 1)))
    unify_on_answer(arg(base, 2), Int(codes.at(k)))

    var next = k + 1

    while next < codes.len() && !code_fits(c, codes.at(next))
        next += 1

    Ok(if next >= codes.len() then Gives(Unit) else GivesMore(Unit, long(next)))
end pl_string_code

// Whether `c`, the code argument, could be `code`: unbound, or that integer.
private code_fits(c: Value, code: long) -> bool = c match
    Var(_) -> true
    Int(k) -> k == code
    _ -> false

// `number_string(N, S)`: `S` read as a number, failing where it is none -- as SWI-Prolog has it, which
// reads no layout around the number. `S` is a string, a code list or a character list; an atom is
// `type_error(list, A)`. With `S` unbound, `N` written as a string.
private pl_number_string(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val who = "number_string/2"
    val n = deref(arg(base, 0))
    val s = deref(arg(base, 1))

    if !is_num(n) && !is_unbound(n) then return Err(type_error("number", n, s"$who wants a number, and was given ${described(n)}"))

    s match
        Var(_) ->
            if is_num(n) then return unified(s, made_text(written_number(n), true)?)

            return Err(instantiation_error(s"instantiation error: $who wants its number or its string"))
        Str(_) -> ()
        Nil -> ()
        Cons(_) -> ()
        _ -> return Err(type_error("list", s, s"$who wants a string or a list, and was given ${described(s)}"))

    val text = text_in(s, who, SplitText)? match
        Some(t) -> t
        None -> return Err(instantiation_error(s"instantiation error: $who was given a list that is not yet whole"))

    if text.bytes.len == 0 || is_layout_byte(text.bytes[0]) then return Ok(Refuses)

    // A `+` before the digits is taken, as SWI-Prolog takes it here.
    val digits = if text.bytes.len > 1 && text.bytes[0] == u8('+') && text.bytes[1] >= u8('0') && text.bytes[1] <= u8('9')
        from_utf8_unchecked(text.bytes[1..<text.bytes.len])
    else
        text

    parse_number(digits) match
        Ok(Some(k)) -> unified(n, k)
        _ -> Ok(Refuses)
end pl_number_string

// `upcase_atom/2`, `downcase_atom/2`, `string_upper/2` and `string_lower/2`: the text of the first
// argument with every character in upper or lower case, made an atom or a string.
private case_of(base: usize, who: string, upper: bool, as_string: bool) -> Result[Answer, Fault]
    val t = cased(bound_text(arg(base, 0), who)?, upper)

    if as_string then answer(same_text(arg(base, 1), t)?) else unified(arg(base, 1), atom(t))

// `split_string(S, SepChars, Pad, Subs)`, as SWI-Prolog has it: `S` with the `Pad` characters taken
// off both ends, cut at every one of the `SepChars`, and each piece with the `Pad` characters taken off
// both of its ends (`split_text`).
private pl_split_string(base: usize, argc: usize, cursor: long) -> Result[Answer, Fault]
    val who = "split_string/4"
    val s = bound_text(arg(base, 0), who)?
    val sep = char_set(bound_text(arg(base, 1), who)?)
    val pad = char_set(bound_text(arg(base, 2), who)?)
    var pieces = split_text(s, Among(sep), Among(pad))

    unified(arg(base, 3), string_list(&pieces)?)
