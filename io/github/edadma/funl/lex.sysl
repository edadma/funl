module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint as big
import sysl.text.from_utf8_unchecked

// FunL's tokens, over `sh.sysl.parsing`'s byte cursor and its layout pass.
//
// **Indentation is structure.** A line deeper than the one before it emits `Indent`, a line at the
// same depth `Newline`, and a shallower one a `Dedent` per block it closes and then a `Newline`;
// the end of the input closes everything still open. Inside brackets a newline is whitespace,
// except under a token that opens a block -- `then`, `else`, `do`, `=`, `:-` and `->` -- written at
// the end of its line.
//
// **A line ending in an infix operator has not ended its statement**: the next line continues it,
// indented deeper than the line the statement began on, and opens and closes nothing -- so the line
// after the continuation is measured against the statement, and a body may sit to its left:
//
//     every row(r) == undefined and
//           row(r) <- r
//         solution(c) = r
//
// **Comments are `;;` to the end of the line and `/* ... */`, which nests.** A line holding nothing
// but blanks and a comment is no line at all: it opens and closes nothing.
//
// A malformed token is reported and skipped, so one pass reports every one in a file.

private const TabWidth: usize = 8

// The tokens of `src`, with every complaint about its spelling added to `report`. A line beginning
// with `$` is not a directive here: this is the lexer alone, for text that is part of a file already
// preprocessed -- an interpolation's hole.
lex(src: Source, report: *Report) -> Tokens[Tok]
    var pre = no_preprocessing(report)

    lex_with(src, report, &pre, 0)

// The tokens of `src`, read as file number `file` of what `pre` is preprocessing (`preproc.sysl`).
// The tokens' spans are offsets into the program `pre` puts together; `report` gets every complaint
// about the file at offsets into `src`, for the caller to move.
//
// **A directive is a line whose first character past its indentation is `$`.** It opens and closes
// no block, as a line holding only a comment does -- except `$include`, whose file's statements stand
// where the line does, so it is measured as a statement line is. A line a false `$ifdef` covers is
// skipped unread.
//
// **The program is built in the order its tokens are read**: the file's text is copied into it up to
// each place something else goes in -- an included file, a definition's text -- so every token's
// offset is past the offsets of the tokens before it, which is what a scope rule reading order from
// offsets needs.
lex_with(src: Source, report: *Report, pre: *Pre, file: usize) -> Tokens[Tok]
    var s = scan(src)
    var lay = layout()
    var out: Tokens[Tok] = tokens()
    var line_start = true
    var first = true
    var conds: Buf[Cond] = buf()

    // The tokens from this index on still have offsets into `src`, and move to the program's when the
    // next token not read from `src` is put after them.
    var native_from: usize = 0

    // `src`'s text up to `copied` is in the program; from `copied` on it goes in at offset `resume`.
    var copied: usize = 0
    var resume = pre.bytes.len()

    // Whether the line being read is an `$include`, whose `$` the token loop below hands over.
    var including = false

    // Where the last real token ended, which is where a `Newline` is said to be.
    var last_end: usize = 0

    loop
        if line_start
            line_start = false

            val ind = measure_indent(&s, TabWidth)

            if blank_rest(&s)
                s.skip_to_line_end()

                if !s.accept_newline() then break

                line_start = true
                continue

            if pre.on
                val directive = s.peek() == Some(u8('$'))

                if directive && !(taking(&conds) && is_include(&s))
                    directive_line(&s, src, pre, file, &conds, report)

                    if !s.accept_newline() then break

                    line_start = true
                    continue

                if !directive && !taking(&conds)
                    s.skip_to_line_end()

                    if !s.accept_newline() then break

                    line_start = true
                    continue

                including = directive

            // A line after one that ended on an infix operator is the rest of that statement, and
            // opens and closes nothing. One that is not indented past the statement is refused and
            // still read as its rest, so the operator is not refused a second time for having no
            // right operand.
            val open_op = if lay.significant() then leaves_line_open(&out) else None

            open_op match
                Some(op) ->
                    if !lay.continues(ind.columns)
                        report.add(error(point(s.at), s"the line above ends in ${describe(op.value)}, so this line has to continue it")
                            .with_label("not indented past the statement it continues")
                            .with_note("a line ending in an operator runs on to the next line, which is indented deeper than the line the statement began on"))
                None -> ()

            if lay.significant() && open_op.is_none()
                val here = point(s.at)

                lay.line(ind.columns) match
                    Same -> if !first then out.push(Newline, point(last_end))
                    Deeper -> out.push(Indent, here)
                    Shallower(n) -> close(&out, n, here, last_end)
                    Ragged(n) ->
                        report.add(error(here, "this line lines up with no block that is open")
                            .with_label("indented to a column between two levels")
                            .with_note("a line returns to the indentation of a line above it, or goes deeper"))
                        close(&out, n, here, last_end)

            first = false

        s.skip_blanks()

        if s.starts_with(";;".bytes)
            s.skip_to_line_end()
            continue

        s.skip_block_comment("/*".bytes, "*/".bytes, true) match
            Ok(true) -> continue
            Ok(false) -> ()
            Err(sp) ->
                report.add(error(Span(sp.start, sp.start + 2), "this comment is never closed")
                    .with_label("opened here")
                    .with_note("a `/*` comment ends at the matching `*/`, and comments nest"))
                break

        val c = s.peek() match
            Some(c) -> c
            None -> break

        if is_newline(c)
            s.accept_newline()
            line_start = true
            continue

        val start = s.at

        if including
            including = false

            include_line(&s, src, report) match
                Some(inc) ->
                    to_program(&out, native_from, copied, resume)
                    copy_text(pre, file, src, copied, s.at)

                    for t in included(pre, inc, file).items.view()
                        out.items.push(t)

                    copied = s.at
                    resume = pre.bytes.len()
                    native_from = out.len()
                None -> ()

            last_end = s.at
            continue

        val before = out.len()

        if one_token(&s, src, &lay, &out, report, c)
            last_end = s.at

            // A name `$define` gave text is replaced by that text's tokens.
            if pre.on && out.len() == before + 1
                out.items.at(before).value match
                    Name(w) ->
                        if is_defined(pre, w)
                            to_program(&out, native_from, copied, resume)

                            val used = out.items.pop().unwrap()

                            copy_text(pre, file, src, copied, s.at)
                            expand(pre, w, used.span, &out)
                            copied = s.at
                            resume = pre.bytes.len()
                            native_from = out.len()
                    _ -> ()
        else
            // Nothing was made of it: say so and step over the character.
            s.next_char()
            report.add(error(Span(start, s.at), s"`${from_utf8_unchecked(src.text(Span(start, s.at)))}` cannot begin anything here"))
    end loop

    val end = point(src.bytes.len)

    for _ in 0..<lay.finish()
        out.push(Dedent, end)

    if pre.on
        unclosed(&conds, report)

        // A main file nothing went into is the program as it stands.
        if file != 0 || !pre.map.pieces.is_empty()
            to_program(&out, native_from, copied, resume)
            copy_text(pre, file, src, copied, src.bytes.len)

    out
end lex_with

// Move the tokens of `out` from index `from` on from offsets into their file to offsets into the
// program, where the file's offset `copied` is at `resume`.
private to_program(out: *Tokens[Tok], from: usize, copied: usize, resume: usize)
    if copied == resume then return

    for i in from..<out.len()
        val t = out.items.at(i)

        out.items.set(i, Spanned(t.value, Span(t.span.start + resume - copied, t.span.end + resume - copied)))

// The tokens on the rest of the line `s` is on, up to its end or a comment, which is left unread:
// what a directive is given. Each token's span is an offset into `src`.
line_tokens(s: *Scanner, src: Source, report: *Report) -> Tokens[Tok]
    var lay = layout()
    var out: Tokens[Tok] = tokens()

    loop
        s.skip_blanks()

        if blank_rest(s) then break

        if s.starts_with("/*".bytes)
            s.skip_block_comment("/*".bytes, "*/".bytes, true) match
                Ok(_) -> continue
                Err(sp) ->
                    report.add(error(Span(sp.start, sp.start + 2), "this comment is never closed")
                        .with_label("opened here")
                        .with_note("a `/*` comment ends at the matching `*/`, and comments nest"))
                    break

        val c = s.peek().unwrap()
        val start = s.at

        if !one_token(s, src, &lay, &out, report, c)
            s.next_char()
            report.add(error(Span(start, s.at), s"`${from_utf8_unchecked(src.text(Span(start, s.at)))}` cannot begin anything here"))

    out
end line_tokens

// Whether nothing but a comment is left on this line.
// Move past a regex literal from its opening backtick, answering whether its closing one was found
// on the same line. A backslash takes the byte after it along, so `` \` `` does not close it.
private read_regex(s: *Scanner) -> bool
    s.bump()

    loop
        val b = s.peek() match
            Some(b) -> b
            None -> return false

        if b == u8('\n') then return false

        s.bump()

        if b == u8('`') then return true

        if b == u8('\\')
            s.peek() match
                Some(n) -> if n != u8('\n') then s.bump()
                None -> ()

private blank_rest(s: *Scanner) -> bool
    s.peek() match
        None -> true
        Some(c) -> is_newline(c) || s.starts_with(";;".bytes)

// Whether the token just read is the last thing on its line, so a block opens under it.
private ends_line(s: *Scanner) -> bool
    val m = s.mark()

    s.skip_blanks()

    val ends = blank_rest(s)

    s.reset(m)
    ends

// The token the last line ended on, where it is an infix operator and so leaves its statement
// unfinished. The operators that open a block when they end a line -- `=`, `->`, `?`, `:-` -- are
// not among them, and nor are the postfix ones.
private leaves_line_open(out: *Tokens[Tok]) -> Option[Spanned[Tok]]
    if out.len() == 0 then return None

    val last = out.items.at(out.len() - 1)

    if !continues_line(last.value) then return None

    // `end until` closing an `until` loop is a marker line, not a range awaiting its end.
    if is_end_until(out) then return None

    Some(last)

// Whether the line ends in the marker `end until`: `until` after a line-initial `end`.
private is_end_until(out: *Tokens[Tok]) -> bool
    val n = out.len()

    if n < 2 then return false

    val is_until = out.items.at(n - 1).value match
        Until -> true
        _ -> false

    if !is_until then return false

    val is_end = out.items.at(n - 2).value match
        Name(w) -> w == "end"
        _ -> false

    if !is_end then return false

    if n == 2 then return true

    out.items.at(n - 3).value match
        Newline -> true
        Indent -> true
        Dedent -> true
        _ -> false

// `n` blocks closed by the line starting at `here`, then the end of the statement before it.
private close(out: *Tokens[Tok], n: usize, here: Span, last_end: usize)
    for _ in 0..<n
        out.push(Dedent, here)

    out.push(Newline, point(last_end))

// Read one token starting with byte `c`; false if nothing starts with it.
private one_token(s: *Scanner, src: Source, lay: *Layout, out: *Tokens[Tok], report: *Report, c: u8) -> bool
    val start = s.at

    if is_ident_start(c)
        val sp = s.read_ident(is_ident_start, is_ident_cont).unwrap()
        val word = from_utf8_unchecked(src.text(sp))

        keyword(word) match
            Some(k) ->
                if word == "not" && in_follows(s)
                    out.push(NotIn, Span(sp.start, s.at))
                    return true

                out.push(k, sp)

                if (word == "then" || word == "else" || word == "do") && ends_line(s) then lay.opens_block()
            None -> out.push(Name(word), sp)

        return true

    if c == u8('#')
        s.bump()

        s.read_ident(is_ident_start, is_ident_cont) match
            Some(sp) -> out.push(AtomLit(from_utf8_unchecked(src.text(sp))), Span(start, s.at))
            None ->
                report.add(expected(point(s.at), "an atom's name after `#`", found_at(src, point(s.at)))
                    .with_note("an atom is written `#name`, as in `#don`"))

        return true

    // **`&` touching a letter begins a keyword, `&pos`**; conjunction is `&` with space after it. Where
    // the token before ends an operand, `a &b` was meant as a conjunction and is refused, then read as
    // one so the rest of the expression is not refused as well.
    if c == u8('&') && s.peek_at(1).map((d) -> is_ident_start(d)).unwrap_or(false)
        s.bump()

        val sp = s.read_ident(is_ident_start, is_ident_cont).unwrap()
        val word = from_utf8_unchecked(src.text(sp))

        if out.len() > 0 && ends_operand(out.items.at(out.len() - 1).value)
            val left = out.items.at(out.len() - 1).value match
                Name(n) -> n
                _ -> "a"

            report.add(error(Span(start, s.at), s"`&$word` touching its name is the keyword `&$word`, and a keyword cannot follow an operand")
                .with_note(s"a conjunction is written with a space after `&`: `$left & $word`"))
            out.push(Amp, Span(start, start + 1))
            out.push(Name(word), sp)
        else
            out.push(AmpName(word), Span(start, s.at))

        return true

    if is_digit(c)
        val base = radix_form(s.src[s.at..<s.src.len])
        val radix_number = base >= 0

        read_number_literal(s) match
            Ok(Small(n)) -> out.push(IntLit(n), Span(start, s.at))
            Ok(Text(t)) -> out.push(NumLit(t), Span(start, s.at))
            Err(e) ->
                // A base outside 2 to 36 is refused at the base, as a radix rather than as a digit.
                val d = if radix_number && (base < 2 || base > 36)
                    error(where(e), "a radix must be 2 to 36")
                else
                    error(where(e), s"this number is $e")

                if radix_number
                    report.add(d.with_note("a radix number is a base from 2 to 36, an `r`, then digits of that base: `16rFF`, `2r1010`"))
                else
                    report.add(d)

        return true

    // **A double-quoted string interpolates and a single-quoted one does not.** One with a hole in it
    // becomes `InterpLit`, which the parser takes apart again from the source; one without is an
    // ordinary string, `$$` already read as a dollar.
    if c == u8('"')
        read_interpolated_named(s, c, "${".bytes, u8('}'), is_ident_start, is_ident_cont) match
            Ok(parts) ->
                if parts.holes.len() == 0
                    out.push(StrLit(parts.chunks.at(0)), Span(start, s.at))
                else
                    out.push(InterpLit, Span(start, s.at))
            Err(e) ->
                val at = where(e)

                report.add(error(Span(at.start, at.start + 1), s"this string is $e").with_label("opened here"))
                s.skip_to_line_end()

        return true

    if c == u8('\'')
        read_quoted(s, c) match
            Ok(text) -> out.push(StrLit(text), Span(start, s.at))
            Err(e) ->
                val at = where(e)

                report.add(error(Span(at.start, at.start + 1), s"this string is $e").with_label("opened here"))
                s.skip_to_line_end()

        return true

    // **A regex runs to the closing backtick on its line**, and its text is kept exactly as written, so
    // a position in it is an offset from the literal's first character.
    if c == u8('`')
        if read_regex(s)
            out.push(RegexLit(from_utf8_unchecked(src.text(Span(start + 1, s.at - 1)))), Span(start, s.at))
        else
            report.add(error(Span(start, start + 1), "this regex is not closed before the end of the line")
                .with_label("opened here").with_note("a backtick inside a regex is written `\\``"))
            s.skip_to_line_end()

            // An empty regex in its place, so the expression it was part of is not refused as well.
            out.push(RegexLit(""), Span(start, s.at))

        return true

    s.bump()

    if c == u8('(')
        lay.open_bracket()
        out.push(LParen, Span(start, s.at))
    elif c == u8(')')
        for _ in 0..<lay.close_bracket()
            out.push(Dedent, point(start))

        out.push(RParen, Span(start, s.at))
    elif c == u8(',')
        if ends_line(s)
            for _ in 0..<lay.close_blocks_in_bracket()
                out.push(Dedent, point(start))

        out.push(Comma, Span(start, s.at))
    elif c == u8('&')
        out.push(Amp, Span(start, s.at))
    elif c == u8('|')
        out.push(Bar, Span(start, s.at))
    elif c == u8('~')
        out.push(Tilde, Span(start, s.at))
    elif c == u8('?')
        if s.accept(u8('='))
            out.push(QuestionEq, Span(start, s.at))
        else
            out.push(Question, Span(start, s.at))

            if ends_line(s) then lay.opens_block()
    elif c == u8('=')
        if s.accept(u8('='))
            out.push(EqEq, Span(start, s.at))
        else
            out.push(Equals, Span(start, s.at))

            if ends_line(s) then lay.opens_block()
    elif c == u8('!')
        out.push(if s.accept(u8('=')) then BangEq else Bang, Span(start, s.at))
    elif c == u8('[')
        lay.open_bracket()
        out.push(LBracket, Span(start, s.at))
    elif c == u8(']')
        for _ in 0..<lay.close_bracket()
            out.push(Dedent, point(start))

        out.push(RBracket, Span(start, s.at))
    elif c == u8(':') && s.accept(u8('-'))
        out.push(Turnstile, Span(start, s.at))

        if ends_line(s) then lay.opens_block()
    elif c == u8(':')
        out.push(Colon, Span(start, s.at))
    elif c == u8(';')
        out.push(Semi, Span(start, s.at))
    elif c == u8('-')
        if s.accept(u8('>'))
            out.push(Arrow, Span(start, s.at))

            if ends_line(s) then lay.opens_block()
        elif s.accept(u8('-'))
            out.push(MinusMinus, Span(start, s.at))
        else
            out.push(operator_or_assign(s, Minus, Sub), Span(start, s.at))
    elif c == u8('<')
        if s.accept(u8('='))
            out.push(LessEq, Span(start, s.at))
        elif s.accept(u8('-'))
            out.push(LeftArrow, Span(start, s.at))
        elif ordering_assign(s)
            out.push(OpEq(Lt), Span(start, s.at))
        else
            out.push(Less, Span(start, s.at))
    elif c == u8('>')
        if s.accept(u8('='))
            out.push(GreaterEq, Span(start, s.at))
        elif ordering_assign(s)
            out.push(OpEq(Gt), Span(start, s.at))
        else
            out.push(Greater, Span(start, s.at))
    elif c == u8('.') && s.accept(u8('.'))
        val k = if s.accept(u8('<')) then DotDotLess elif s.accept(u8('+')) then DotDotPlus else DotDot

        out.push(k, Span(start, s.at))
    elif c == u8('.')
        out.push(Dot, Span(start, s.at))
    elif c == u8('{')
        lay.open_bracket()
        out.push(LBrace, Span(start, s.at))
    elif c == u8('}')
        for _ in 0..<lay.close_bracket()
            out.push(Dedent, point(start))

        out.push(RBrace, Span(start, s.at))
    elif c == u8('@')
        out.push(At, Span(start, s.at))
    elif c == u8('+')
        if s.accept(u8('+'))
            out.push(PlusPlus, Span(start, s.at))
        else
            out.push(operator_or_assign(s, Plus, Add), Span(start, s.at))
    elif c == u8('*')
        if s.accept(u8('*'))
            out.push(operator_or_assign(s, StarStar, Inter), Span(start, s.at))
        else
            out.push(operator_or_assign(s, Star, Mul), Span(start, s.at))
    elif c == u8('/')
        if s.accept(u8('/'))
            out.push(operator_or_assign(s, SlashSlash, FloorQuo), Span(start, s.at))
        else
            out.push(operator_or_assign(s, Slash, Quo), Span(start, s.at))
    elif c == u8('\\')
        out.push(operator_or_assign(s, Backslash, IntQuo), Span(start, s.at))
    elif c == u8('%')
        out.push(operator_or_assign(s, Percent, Rem), Span(start, s.at))
    elif c == u8('^')
        out.push(operator_or_assign(s, Caret, Pow), Span(start, s.at))
    else
        s.reset(start)
        return false

    true
end one_token

// **A decimal integer followed by a fraction or an exponent is a float**: `1.5`, `1e3`, `2.5e-3`.
// A `.` counts as a fraction only with a digit after it, so `1..5`, `1..<5` and `3.length` are
// still an integer and what follows it; an `e` only with a digit, or a sign and a digit, after it,
// so `2e` is still `2` times `e`.
private float_follows(s: *Scanner) -> bool
    if s.peek() == Some(u8('.')) && s.peek_at(1).map((d) -> is_digit(d)).unwrap_or(false) then return true

    (s.peek() == Some(u8('e')) || s.peek() == Some(u8('E'))) && exponent_digits(s.peek_at(1), s.peek_at(2))

// The rest of a float whose integer part has been read: its fraction and its exponent, as far as
// they go.
private read_float_tail(s: *Scanner)
    if s.peek() == Some(u8('.')) && s.peek_at(1).map((d) -> is_digit(d)).unwrap_or(false)
        s.bump()
        s.accept_while(is_digit)

    if (s.peek() == Some(u8('e')) || s.peek() == Some(u8('E'))) && exponent_digits(s.peek_at(1), s.peek_at(2))
        s.bump()
        s.accept_any("+-".bytes)
        s.accept_while(is_digit)

// A number's text with its digit separators taken out, as the tower reads it: `1_000.5` is `1000.5`.
plain_digits(bs: []const u8) -> string
    var out: Buf[u8] = buf()

    for b in bs
        if b != u8('_') then out.push(b)

    from_utf8_unchecked(out.view())

// A number literal, as the lexer reads one at `s` and as `integer`, `real` and `numeric` read one
// out of a string: a 64-bit integer held as itself, and anything else -- a real, or an integer past
// 64 bits in any of the four bases -- carried as its text with the digit separators taken out, for
// `literal_value` to read.
enum LitNumber
    Small(n: long)
    Text(t: string)

//
// **Icon's `NrDDD` is one number**: a base, an `r`, and digits of that base in either case --
// `16rFF`, `2r1010`, `36rZZ` -- for any base from 2 to 36 and any size, `_` between digits as in the
// other forms. A base outside that range, a digit the base does not have, or no digits at all is an
// error, and the identifier characters after the `r` are consumed so that one mistake is one report.
read_number_literal(s: *Scanner) -> Result[LitNumber, LitError]
    val base = radix_form(s.src[s.at..<s.src.len])

    if base >= 0 then return read_radix_literal(s, base)

    val start = s.at
    val radix =s.peek() == Some(u8('0')) && s.peek_at(1).map((p) -> is_radix_letter(p)).unwrap_or(false)

    read_integer(s) match
        Ok(n) ->
            if !radix && float_follows(s)
                read_float_tail(s)
                Ok(Text(plain_digits(s.src[start..<s.at])))
            elif n <= 9223372036854775807
                Ok(Small(long(n)))
            else
                Ok(Text(plain_digits(s.src[start..<s.at])))
        Err(e) -> e match
            Overflow(_) ->
                if !radix && float_follows(s) then read_float_tail(s)

                Ok(Text(plain_digits(s.src[start..<s.at])))
            _ -> Err(e)

// The base of Icon's `NrDDD`, where `bs` begins with up to three decimal digits and an `r` or `R`;
// -1 where it does not. A base outside 2 to 36 is answered as written, for the reader to refuse.
radix_form(bs: []const u8) -> int
    var k: usize = 0

    while k < bs.len && k < 4 && is_digit(bs[k]) do k += 1

    if k == 0 || k > 3 || k >= bs.len || (bs[k] != u8('r') && bs[k] != u8('R')) then return -1

    var n = 0

    for i in 0..<k
        n = n * 10 + int(bs[i] - u8('0'))

    n

// A radix number, `s` at the first digit of its base. The mistakes are reported at the base or at the
// first byte that is not a digit of it.
private read_radix_literal(s: *Scanner, base: int) -> Result[LitNumber, LitError]
    val start = s.at

    s.accept_while(is_digit)

    val base_span = Span(start, s.at)

    s.bump()

    if base < 2 || base > 36
        s.accept_while(is_ident_cont)
        return Err(BadDigit(base_span))

    val first = s.at

    read_digits(s, base) match
        Ok(_) -> ()
        Err(Overflow(_)) -> ()
        Err(e) ->
            s.accept_while(is_ident_cont)
            return Err(e)

    if s.peek().map((c) -> is_ident_cont(c)).unwrap_or(false)
        val bad = Span(s.at, s.at + 1)

        s.accept_while(is_ident_cont)
        return Err(BadDigit(bad))

    big.parse_radix(plain_digits(s.src[first..<s.at]), base) match
        Some(v) -> v.to_long() match
            Some(k) -> Ok(Small(k))
            None -> Ok(Text(big.to_string(v)))
        None -> Err(NoDigits(Span(first, s.at)))

// The second letter of a radix prefix, `0x`, `0o` or `0b`.
private is_radix_letter(b: u8) -> bool =
    b == u8('x') || b == u8('X') || b == u8('o') || b == u8('O') || b == u8('b') || b == u8('B')

// An arithmetic operator just read: itself, or with a `=` touching it the assignment through it.
private operator_or_assign(s: *Scanner, plain: Tok, o: BinOp) -> Tok = if s.accept(u8('=')) then OpEq(o) else plain

// After the word `not`: whether the word `in` follows on the same line, making the one operator
// `not in`, which is then read.
private in_follows(s: *Scanner) -> bool
    val m = s.mark()

    s.skip_blanks()

    if s.accept_word("in".bytes, is_ident_cont) then return true

    s.reset(m)
    false

// After `<` or `>`: whether `:=` follows, making `<:=` or `>:=`, which is then read.
private ordering_assign(s: *Scanner) -> bool
    if !s.starts_with(":=".bytes) then return false

    s.bump()
    s.bump()
    true
