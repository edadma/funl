module io.github.edadma.funl
@tests

import sysl.buf.{Buf, buf}
import sysl.text.Search

// Prolog's output: `write/1`, `print/1`, `writeq/1` and `write_canonical/1` over the operator table,
// `write_term/2` and its options, `nl/0`, `tab/1` and `put_char/1`; and the round trip, every tricky
// term `writeq` writes read back by the reader as the term it was.

// What `how(<term>)` writes.
private written(how: string, term_text: string) -> string =
    ran_prolog(s":- X = ($term_text), $how(X), nl.\n")

private ok(text: string) -> string = text + "\nsucceeded"

// Whether `goal` succeeds, or the formal term of the error it raises.
private raised(goal: string) -> string =
    ran_prolog(s":- catch(($goal, F = none), error(F, _), true), nl, write(F), nl.\n")

// Terms `writeq` has to get right, each as read and as written.
private tricky() -> Buf[(string, string)]
    var t: Buf[(string, string)] = buf()

    t.push(("1 + 2", "1+2"))
    t.push(("a :- b", "a:-b"))
    // A prefix operator's bracketed operand is set apart by a space, as GNU Prolog 1.5.0 writes it.
    t.push(("-(1)", "- (1)"))
    t.push(("- (1)", "- (1)"))
    t.push(("-(-1)", "- -1"))
    t.push(("-(-(1))", "- - (1)"))
    t.push(("1 - (-1)", "1- -1"))
    t.push(("a - -1", "a- -1"))
    t.push(("1 - (-(1))", "1- - (1)"))
    t.push(("-a", "-a"))
    t.push(("- - a", "- -a"))
    t.push(("- (1 + 2)", "- (1+2)"))
    t.push(("- (1 ^ 2)", "- (1^2)"))
    t.push(("(- a) ^ 2", "(-a)^2"))
    t.push(("-(2) ^ 2", "(- (2))^2"))
    t.push(("+(1)", "+1"))
    t.push(("-(1.0)", "- (1.0)"))
    t.push(("1 - (2 - 3)", "1-(2-3)"))
    t.push(("(1 - 2) - 3", "1-2-3"))
    t.push(("2 ^ 3 ^ 4", "2^3^4"))
    t.push(("(2 ^ 3) ^ 4", "(2^3)^4"))
    t.push(("1 * (2 + 3)", "1*(2+3)"))
    t.push(("(a :- b) :- c", "(a:-b):-c"))
    t.push(("p :- a, b ; c -> d", "p:-a,b;c->d"))
    t.push(("f((a :- b))", "f((a:-b))"))
    t.push(("f((a, b))", "f((a,b))"))
    t.push(("[(a, b)]", "[(a,b)]"))
    t.push(("(a, b)", "a,b"))
    t.push(("{a, b}", "{a,b}"))
    t.push(("'{}'(x)", "{x}"))
    t.push(("{}", "{}"))
    t.push(("[a, b | c]", "[a,b|c]"))
    t.push(("[a | []]", "[a]"))
    t.push(("[]", "[]"))
    t.push(("'[]'", "'[]'"))
    t.push(("'hello world'", "'hello world'"))
    t.push(("'\\n'", "'\\n'"))
    t.push(("'it''s'", "'it\\'s'"))
    t.push(("'Abc'", "'Abc'"))
    t.push(("aB_1", "aB_1"))
    t.push(("''", "''"))
    t.push(("'/*'", "'/*'"))
    t.push(("f(;, '|', ',')", "f(;,'|',',')"))
    t.push(("[-]", "[-]"))
    t.push(("- = x", "(-)=x"))
    t.push(("- (-)", "- (-)"))
    t.push(("f(a - (-))", "f(a-(-))"))
    t.push(("\\+ a", "\\+a"))
    t.push(("\\+ (a, b)", "\\+ (a,b)"))
    t.push(("a = (\\+ b)", "a=(\\+b)"))
    t.push(("a = -1", "a= -1"))
    t.push(("a = - b", "a= -b"))
    t.push(("a =.. b", "a=..b"))
    t.push(("a is 1 mod 2", "a is 1 mod 2"))
    t.push(("a mod (b + c)", "a mod (b+c)"))
    t.push(("a = (mod)", "a=(mod)"))
    t.push(("x is (mod)", "x is (mod)"))
    // `- 1` is `-(1)`, as SWI-Prolog reads it; GNU Prolog reads the number -1.
    t.push(("- 1", "- (1)"))
    t.push(("f(- 1)", "f(- (1))"))
    t.push(("f(-1)", "f(-1)"))
    t.push(("1 - - a", "1- -a"))
    t.push(("\"a \\\"string\\\"\"", "\"a \\\"string\\\"\""))
    t.push(("f(x, \"s\")", "f(x,\"s\")"))
    t.push(("-(1, 2, 3)", "-(1,2,3)"))
    t.push(("'\\t'(a)", "'\\t'(a)"))
    t
end tricky

@test
WRITEQ_WRITES_EACH_TRICKY_TERM_AS_IT_HAS_TO_BE_WRITTEN()
    for (src, text) in tricky().view()
        assert_eq(written("writeq", src), ok(text))

@test
WHAT_WRITEQ_WRITES_READS_BACK_AS_THE_SAME_TERM()
    for (src, text) in tricky().view()
        val program = s":- X = ($src), Y = ($text), (X == Y -> write(same) ; write(differs)), nl.\n"

        assert_eq(ran_prolog(program), ok("same"))

@test
WRITE_LEAVES_ATOMS_AND_STRINGS_UNQUOTED()
    assert_eq(written("write", "'hello world'"), ok("hello world"))
    assert_eq(written("write", "[a, 'B c', \"s\"]"), ok("[a,B c,s]"))
    assert_eq(written("write", "f(',', '|')"), ok("f(',','|')"))
    assert_eq(written("write", "1 + a * 'B'"), ok("1+a*B"))

@test
PRINT_WRITES_AS_WRITEQ_DOES()
    assert_eq(written("print", "f('A', [])"), ok("f('A',[])"))

@test
WRITE_CANONICAL_QUOTES_AND_IGNORES_OPERATORS()
    assert_eq(written("write_canonical", "1 + 2 * 3"), ok("+(1,*(2,3))"))
    assert_eq(written("write_canonical", "[a, 'B' | c]"), ok("[a,'B'|c]"))
    assert_eq(written("write_canonical", "(a :- b, c)"), ok(":-(a,','(b,c))"))
    assert_eq(written("write_canonical", "- 1"), ok("-(1)"))
    assert_eq(written("write_canonical", "-1"), ok("-1"))
    assert_eq(written("write_canonical", "'$VAR'(1)"), ok("'$VAR'(1)"))
    assert_eq(written("write_canonical", "{a}"), ok("{a}"))

@test
A_VARIABLE_IS_WRITTEN_AS_ONE_THE_READER_READS_BACK()
    assert_eq(ran_prolog(":- X = f(A, B, A), write_canonical(X), nl.\n").index_of("f(_G").is_some(), true)

    // The same variable twice is written the same way twice.
    assert_eq(ran_prolog(":- X = f(A, A), writeq(X), nl.\n").index_of(",_G").is_some(), true)

@test
NUMBERVARS_NAMES_EACH_VAR_TERM_BY_ITS_NUMBER()
    assert_eq(written("print", "f('$VAR'(0), '$VAR'(1), '$VAR'(25), '$VAR'(27))"), ok("f(A,B,Z,B1)"))
    assert_eq(written("write", "'$VAR'(x)"), ok("$VAR(x)"))

@test
WRITE_TERM_TAKES_ITS_OPTIONS()
    assert_eq(ran_prolog(":- write_term('A' + b, [quoted(true)]), nl.\n"), ok("'A'+b"))
    assert_eq(ran_prolog(":- write_term('A' + b, [quoted(true), ignore_ops(true)]), nl.\n"), ok("+('A',b)"))
    assert_eq(ran_prolog(":- write_term('A' + b, []), nl.\n"), ok("A+b"))
    assert_eq(ran_prolog(":- write_term([1, 2, 3, 4], [max_depth(2)]), nl.\n"), ok("[1,2|...]"))
    assert_eq(ran_prolog(":- write_term(f(g(h(i))), [max_depth(2)]), nl.\n"), ok("f(g(...))"))
    assert_eq(ran_prolog(":- write_term('$VAR'(2), [numbervars(true)]), nl.\n"), ok("C"))

@test
WRITE_TERM_RAISES_THE_ISO_ERRORS_FOR_ITS_OPTIONS()
    assert_eq(raised("write_term(a, foo)"), ok("\ntype_error(list,foo)"))
    assert_eq(raised("write_term(a, _)"), ok("\ninstantiation_error"))
    assert_eq(raised("write_term(a, [quoted(true) | _])"), ok("\ninstantiation_error"))
    assert_eq(raised("write_term(a, [_])"), ok("\ninstantiation_error"))
    assert_eq(raised("write_term(a, [foo])"), ok("\ndomain_error(write_option,foo)"))
    assert_eq(raised("write_term(a, [quoted(maybe)])"), ok("\ndomain_error(write_option,quoted(maybe))"))
    assert_eq(raised("write_term(a, [max_depth(-1)])"), ok("\ndomain_error(write_option,max_depth(-1))"))

@test
NL_TAB_AND_PUT_CHAR_WRITE_WHITE_SPACE_AND_CHARACTERS()
    assert_eq(ran_prolog(":- write(a), tab(3), write(b), tab(1 + 1), put_char(c), nl, put_char('\\n'), write(d), nl.\n"),
        ok("a   b  c\n\nd"))

@test
TAB_AND_PUT_CHAR_RAISE_THE_ISO_ERRORS()
    assert_eq(raised("tab(_)"), ok("\ninstantiation_error"))
    assert_eq(raised("tab(foo)"), ok("\ntype_error(evaluable,foo/0)"))
    assert_eq(raised("put_char(_)"), ok("\ninstantiation_error"))
    assert_eq(raised("put_char(ab)"), ok("\ntype_error(character,ab)"))
    assert_eq(raised("put_char(1)"), ok("\ntype_error(character,1)"))

@test
FUNL_VALUES_WITHOUT_A_TERM_ARE_WRITTEN_OPAQUE()
    // A tuple is the compound `tuple(...)`; a map and a function are opaque (`prolog.md` § "The term
    // mapping").
    val d = scratch()
    defer scrap(d)

    val text = import_interop(d) +
        "show_term((1, #a))\n" +
        "show_term({#a: 1})\n" +
        "show_term(x -> x)\n"

    assert_eq(ran_funl(text), "loaded\ntuple(1,a)\n<map>\n<function>\nsucceeded")

@test
A_VAR_TERM_NAMED_BY_AN_ATOM_OR_A_NEGATIVE_NUMBER_IS_WRITTEN_AS_SWI_PROLOG_WRITES_IT()
    // SWI-Prolog 10.0.2: a name spelled as a variable is written bare, `'$VAR'(-N)` is `S_N`.
    assert_eq(ran_prolog(":- writeq(['$VAR'('Foo'), '$VAR'('_'), '$VAR'('_Foo'), '$VAR'(x), '$VAR'('foo bar'), '$VAR'(-1)]), nl.\n"),
        ok("[Foo,_,_Foo,'$VAR'(x),'$VAR'('foo bar'),S_1]"))
    assert_eq(ran_prolog(":- print('$VAR'('Foo')), nl, write_canonical('$VAR'('Foo')), nl, write_term('$VAR'('Foo'), [numbervars(false), quoted(true)]), nl.\n"),
        ok("Foo\n'$VAR'('Foo')\n'$VAR'('Foo')"))

@test
THE_BAR_IS_AN_INFIX_OPERATOR_AT_1105()
    // GNU Prolog 1.5.0 and SWI-Prolog 10.0.2 agree on the term; running it as a disjunction is
    // SWI-Prolog's.
    assert_eq(ran_prolog(":- X = (a | b), X =.. L, writeq(L), nl.\n"), ok("['|',a,b]"))
    assert_eq(ran_prolog(":- X = (a :- b | c), writeq(X), nl.\n"), ok("a:-b|c"))
    assert_eq(ran_prolog(":- findall(P-T, current_op(P, T, '|'), L), writeq(L), nl.\n"), ok("[1105-xfy]"))
    assert_eq(ran_prolog(":- forall((X = 1 | X = 2), write(X)), nl.\n"), ok("12"))

@test
XOR_IS_AN_OPERATOR_AT_400()
    // SWI-Prolog 10.0.2's priority; ISO's table has no `xor`.
    assert_eq(ran_prolog(":- findall(P-T, current_op(P, T, xor), L), writeq(L), nl, X is 1 + 6 xor 3, write(X), nl.\n"), ok("[400-yfx]\n6"))

@test
A_NAME_OPERATOR_IS_SET_APART_FROM_WHAT_FOLLOWS_IT_AS_SWI_PROLOG_WRITES_IT()
    // Each expected line is what SWI-Prolog 10.0.2's `writeq/1` writes.
    assert_eq(ran_prolog(":- X = (a is -4), writeq(X), nl.\n:- X = (a mod -1), writeq(X), nl.\n:- X = (a xor -1), writeq(X), nl.\n"),
        ok("a is -4\na mod -1\na xor -1"))
    assert_eq(ran_prolog(":- X = (a is [b]), writeq(X), nl.\n:- X = (a is {b}), writeq(X), nl.\n:- X = (a is []), writeq(X), nl.\n:- X = (a rem \"s\"), writeq(X), nl.\n"),
        ok("a is [b]\na is {b}\na is []\na rem \"s\""))
    assert_eq(ran_prolog(":- X = (a is b), writeq(X), nl.\n:- X = (a is f(x)), writeq(X), nl.\n:- X = (a is (b, c)), writeq(X), nl.\n:- X = (1 is -1 + 2), writeq(X), nl.\n"),
        ok("a is b\na is f(x)\na is (b,c)\n1 is -1+2"))

@test
A_SYMBOL_OPERATOR_SET_APART_FROM_ITS_LEFT_IS_SET_APART_FROM_ITS_RIGHT_TOO()
    // SWI-Prolog 10.0.2: `@ = a`, `@ - 1`.
    assert_eq(ran_prolog(":- X = (@ = a), writeq(X), nl.\n:- X = (@ - 1), writeq(X), nl.\n:- X = (# = #), writeq(X), nl.\n"),
        ok("@ = a\n@ - 1\n# = #"))

@test
A_SYMBOL_OPERATOR_STAYS_CLOSE_WHERE_NOTHING_RUNS_TOGETHER()
    // SWI-Prolog 10.0.2 writes each of these without a space.
    assert_eq(ran_prolog(":- X = (a = b), writeq(X), nl.\n:- X = (a = [b]), writeq(X), nl.\n:- X = (a - 1), writeq(X), nl.\n:- X = (a:-b), writeq(X), nl.\n:- X = (a = (b , c)), writeq(X), nl.\n"),
        ok("a=b\na=[b]\na-1\na:-b\na=(b,c)"))
    assert_eq(ran_prolog(":- X = (a- -1), writeq(X), nl.\n:- X = (1 - (-(a))), writeq(X), nl.\n:- X = (f(a) = f(b)), writeq(X), nl.\n"),
        ok("a- -1\n1- -a\nf(a)=f(b)"))

@test
A_NAME_PREFIX_OPERATOR_IS_SET_APART_FROM_A_CURLY_TERM()
    // SWI-Prolog 10.0.2: `dynamic {a}`. A symbol prefix operator stays close, as GNU Prolog 1.5.0 has `-{a}`.
    assert_eq(ran_prolog(":- X = (dynamic {a}), writeq(X), nl.\n:- X = (- {a}), writeq(X), nl.\n:- X = (dynamic a), writeq(X), nl.\n"),
        ok("dynamic {a}\n-{a}\ndynamic a"))

@test
AN_INFINITY_AND_A_NAN_ARE_WRITTEN_AS_SWI_PROLOG_WRITES_THEM()
    // SWI-Prolog 10.0.2 writes the same, but for `- 1.0Inf`, which it writes without the brackets.
    assert_eq(written("writeq", "f(1.0Inf, -1.0Inf, 1.5NaN)"), ok("f(1.0Inf,-1.0Inf,1.5NaN)"))
    assert_eq(written("write", "[1.0Inf, -1.0Inf, 1.5NaN]"), ok("[1.0Inf,-1.0Inf,1.5NaN]"))
    assert_eq(written("print", "1.5NaN"), ok("1.5NaN"))
    // A written float reads back as a float: a whole one keeps its `.0`, whatever FunL prints.
    assert_eq(written("write", "[1.0, 5.0, 2.5, 1.0e22]"), ok("[1.0,5.0,2.5,1.0e+22]"))
    assert_eq(written("writeq", "-0.0"), ok("-0.0"))
    assert_eq(written("write_canonical", "-1.0Inf"), ok("-1.0Inf"))
    assert_eq(written("writeq", "1 - -1.0Inf"), ok("1- -1.0Inf"))
    assert_eq(written("writeq", "-(1.0Inf)"), ok("- (1.0Inf)"))
    assert_eq(written("writeq", "-(1.5NaN)"), ok("- (1.5NaN)"))
    assert_eq(written("writeq", "-(-1.0Inf)"), ok("- -1.0Inf"))
    assert_eq(ran_prolog(":- X is inf, format(\"~w ~q ~a~n\", [X, X, x]).\n"), ok("1.0Inf 1.0Inf x"))
    assert_eq(ran_prolog(":- msort([1.5NaN, 1.0Inf, -1.0Inf, 0.0, 1], L), writeq(L), nl.\n"), ok("[1.5NaN,-1.0Inf,0.0,1,1.0Inf]"))
