module io.github.edadma.funl

// Which builtins a VM is built with: an index of the `install_` calls, one per file that implements
// some. Each file registers its own.
install_natives(v: *Vm)
    install_io(v)
    install_predef(v)
    install_math(v)
    install_data(v)
    install_scan(v)
    install_strings(v)
    install_bytes(v)
    install_prolog(v)
    install_catch(v)
    install_fs(v)
