module io.github.edadma.funl

// Which builtins a VM is built with: an index of the `install_` calls, one per file that implements
// some. Each file registers its own.
install_natives(v: *Vm)
    install_io(v)
    install_predef(v)
    install_math(v)
    install_random(v)
    install_conversions(v)
    install_data(v)
    install_deques(v)
    install_scan(v)
    install_keywords(v)
    install_coexprs(v)
    install_tracing(v)
    install_csets(v)
    install_strings(v)
    install_string_layout(v)
    install_string_images(v)
    install_bytes(v)
    install_prolog(v)
    install_catch(v)
    install_variadic(v)
    install_fs(v)
    install_process(v)
    install_json(v)
    install_sqlite(v)
    install_time(v)
    install_async(v)
    install_prelude(v)
    install_proc(v)
#if feature_http
    install_http(v)
#endif
