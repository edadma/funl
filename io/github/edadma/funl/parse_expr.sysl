module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Expressions: the `pratt` callbacks, and the prefix forms -- `if`, `every`, `not`, `return`,
// prefix `-` -- that read as far right as they can.
//
// **A token that cannot begin an expression is refused before `pratt` takes it**, so a missing
// operand leaves the `)` or the end of the line where it was for the caller to find.
//
// **A lambda is read from the right of its arrow back**: `->` is an infix operator binding more
// loosely than anything else, and what stood on its left becomes the parameters -- a name or a
// pattern, a parenthesized list of them, and after a bare `|` a guard.

// Deep enough for any program a person writes, shallow enough that the sysl stack holds it.
private const MaxDepth: usize = 400

// An expression at binding power `bp`.
parse_expr(p: *Parser, bp: u16) -> &Expr
    val t = p.look() match
        Some(t) -> t
        None ->
            p.fail_here("an expression")
            return expr(BadE, p.toks.here())

    if !starts_expr(t.value)
        p.fail_here("an expression")
        return expr(BadE, t.span)

    if p.depth >= MaxDepth
        p.report.add(error(t.span, "this expression is nested too deeply to read"))
        p.skip_line()
        return expr(BadE, t.span)

    p.depth += 1

    val e = pratt(p, bp, nud, led, lbp).unwrap()

    p.depth -= 1
    e
end parse_expr

private lbp(t: Spanned[Tok]) -> u16 = power(t.value).left

private nud(t: Spanned[Tok], p: *Parser) -> &Expr
    t.value match
        Name(n) ->
            if n == "_" then return expr(Anon, t.span)

            if p.at_tok(LParen) then return call(p, n, t.span)

            if p.at_tok(Colon) && loop_word(p, 1)
                p.take()

                return labelled(p, t.span, Some(n))

            if p.accept(At)
                val pat = parse_expr(p, JuxtPower)

                return expr(AsE(n, pat), t.span.to(pat.span))

            expr(Ref(n), t.span)
        AtomLit(a) -> expr(AtomE(a), t.span)
        IntLit(n) -> number(p, IntE(n), t.span)
        NumLit(text) -> number(p, NumE(text), t.span)
        StrLit(s) -> expr(StrE(s), t.span)
        RegexLit(r) -> regex_literal(p, r, t.span)
        InterpLit -> interpolated(p, t)
        UndefinedW -> expr(UndefE, t.span)
        TrueW -> expr(BoolE(true), t.span)
        FalseW -> expr(BoolE(false), t.span)
        Otherwise -> expr(BoolE(true), t.span)
        FailW -> expr(FailE, t.span)
        ReturnW ->
            val starts = p.peek_tok() match
                Some(k) -> starts_expr(k)
                None -> false

            if !starts then return expr(ReturnE(None), t.span)

            val e = parse_expr(p, ReturnPower)

            expr(ReturnE(Some(e)), t.span.to(e.span))
        Minus ->
            val e = parse_expr(p, NegPower)

            e.kind match
                IntE(n) -> expr(IntE(-n), t.span.to(e.span))
                NumE(text) -> expr(NumE(s"-$text"), t.span.to(e.span))
                _ -> expr(MinusE(e), t.span.to(e.span))
        LParen -> paren(p, t.span)
        Not ->
            val e = parse_expr(p, NotPower)

            expr(Neg(e), t.span.to(e.span))
        If -> if_expr(p, t.span)
        Every -> every_expr(p, t.span, None)
        While -> while_expr(p, t.span, None)
        Repeat -> repeat_expr(p, t.span, None)
        For -> for_expr(p, t.span, None)
        Break ->
            val label = loop_label(p)

            if !p.at_tok(LParen) then return expr(BreakE(label, None), t.span.to(p.toks.previous()))

            val e = parse_expr(p, ReturnPower)

            expr(BreakE(label, Some(e)), t.span.to(e.span))
        Continue ->
            val label = loop_label(p)

            expr(ContinueE(label), t.span.to(p.toks.previous()))
        PlusPlus -> prefix_step(p, t.span, 1)
        MinusMinus -> prefix_step(p, t.span, -1)
        Bang ->
            val e = parse_expr(p, BangPower)

            expr(BangE(e), t.span.to(e.span))
        Bar ->
            val e = parse_expr(p, RepeatPower)

            expr(RepAltE(e), t.span.to(e.span))
        YieldW ->
            val e = parse_expr(p, ReturnPower)

            expr(YieldE(e), t.span.to(e.span))
        LBracket -> list(p, t.span)
        LBrace -> braces(p, t.span)
        Backslash ->
            val e = parse_expr(p, DefinedPower)

            expr(DefinedE(e, true), t.span.to(e.span))
        Slash ->
            val e = parse_expr(p, DefinedPower)

            expr(DefinedE(e, false), t.span.to(e.span))
        _ -> expr(BadE, t.span)
end nud

// `[a, b, ...]` or a list comprehension `[e | p <- c, ...]`, the `[` already read, through the `]`.
private list(p: *Parser, open: Span) -> &Expr
    var items: Buf[&Expr] = buf()

    if !p.accept(RBracket)
        loop
            val item = parse_expr(p, 0)

            if items.len() == 0
                comprehension_head(p, item) match
                    Some(h) -> return comprehension(p, open, h.elem, h.pat, RBracket, "`]`", false)
                    None -> ()

            items.push(item)

            if p.accept(Comma) then continue

            if !p.expect(RBracket, "`,` or `]`") then p.skip_line()

            break

    expr(ListE(items), open.to(p.toks.previous()))

// What follows `{`, through the `}`: `{}`, the empty map; a map `{k: v, ...}`; a set `{a, b, ...}`;
// or a set comprehension `{e | p <- c, ...}`.
//
// **A map's entry is read as one expression and taken apart at its top `:`**, which is cons
// everywhere else: cons groups to the right, so `{a: x:xs}` is the key `a` and the list `x:xs`. The
// first item decides which the braces hold, and every other item must agree.
private braces(p: *Parser, open: Span) -> &Expr
    if p.accept(RBrace) then return expr(MapE(buf(), buf()), open.to(p.toks.previous()))

    val first = parse_expr(p, 0)

    comprehension_head(p, first) match
        Some(h) -> return comprehension(p, open, h.elem, h.pat, RBrace, "`}`", true)
        None -> ()

    val is_map = map_entry(first).is_some()
    var keys: Buf[&Expr] = buf()
    var vals: Buf[&Expr] = buf()
    var items: Buf[&Expr] = buf()
    var bad = false
    var item = first

    loop
        map_entry(item) match
            Some(kv) ->
                if is_map
                    keys.push(kv.key)
                    vals.push(kv.value)
                else
                    p.report.add(error(item.span, "a set's items are values, and this is a map's `key: value`"))
                    bad = true
            None ->
                if is_map
                    p.report.add(error(item.span, "a map's entries are each written `key: value`"))
                    bad = true
                else
                    items.push(item)

        if !p.accept(Comma) then break

        item = parse_expr(p, 0)

    if !p.expect(RBrace, "`,` or `}`") then p.skip_line()

    val at = open.to(p.toks.previous())

    if bad then return expr(BadE, at)

    if is_map then expr(MapE(keys, vals), at) else expr(SetE(items), at)
end braces

private struct KeyValue
    key: &Expr
    value: &Expr

// A map's entry, `key: value`. A key written as a bare name is that name as a string.
private map_entry(e: &Expr) -> Option[KeyValue] = e.kind match
    ConsE(k, v) ->
        val key = k.kind match
            Ref(n) -> expr(StrE(n), k.span)
            _ -> k

        Some(KeyValue(key, v))
    _ -> None

// The element and first pattern of a comprehension, `e | p` read as one alternation with `<-` next:
// the `|` that separates them is read as alternation's, and its right side is the pattern.
private comprehension_head(p: *Parser, first: &Expr) -> Option[CompHead]
    if !p.at_tok(LeftArrow) then return None

    first.kind match
        Disj(e, pat) -> Some(CompHead(e, pat))
        _ -> None

private struct CompHead
    elem: &Expr
    pat: &Expr

// The bindings of a comprehension from its first `<-`, its element and first pattern read, through
// `close`.
private comprehension(p: *Parser, open: Span, elem: &Expr, first: &Expr, close: Tok, what: string, set: bool) -> &Expr
    val id = p.node_id()
    var gens: Buf[ForGen] = buf()
    var pat = first

    loop
        if !p.expect(LeftArrow, "`<-`")
            p.skip_line()
            return expr(BadE, open.to(p.toks.previous()))

        val iter = parse_expr(p, 0)
        val filter = if p.accept(If) then Some(parse_expr(p, 0)) else None

        gens.push(ForGen(pat, iter, filter))

        if !p.accept(Comma) then break

        pat = parse_expr(p, 0)

    if !p.expect(close, s"`,` or $what") then p.skip_line()

    expr(CompE(id, elem, gens, set), open.to(p.toks.previous()))

// An expression where one is delimited -- inside parentheses or a call's arguments, at the head of
// `every` and `while` -- which may also be an assignment `name = e` or `name op= e`, or a write
// into an element, `a(i) = e`. Nowhere else
// does `=` assign inside an expression: a statement reads its own `=`, and a guard's or a
// definition's `=` begins a body.
delimited(p: *Parser) -> &Expr
    val e = parse_expr(p, 0)

    compound_assign(p, e) match
        Some(c) -> return c
        None -> ()

    if p.at_tok(LeftArrow) then return reversible(p, e)

    if !p.at_tok(Equals) then return e

    e.kind match
        Ref(n) ->
            p.take()

            val value = parse_expr(p, 0)

            expr(AssignE(n, value), e.span.to(value.span))
        DefinedE(_, _) ->
            p.take()
            guarded_assign(p, e, parse_expr(p, 0))
        _ ->
            if !is_element(e) then return e

            p.take()

            val value = parse_expr(p, 0)

            element_target(e, value, false, e.span.to(value.span)).unwrap()

// `target <- e`, the target read and `<-` next: a variable, or an element. It groups to the right, so
// `a <- b <- e` stores `e` in both.
reversible(p: *Parser, target: &Expr) -> &Expr
    p.take()

    var value = parse_expr(p, 0)

    if p.at_tok(LeftArrow) then value = reversible(p, value)

    reversed(p, target, value)

// `\x = e` or `/x = e`, the `=` read: the assignment made only when `x` is defined, or undefined --
// the test, and then the assignment, which the test failing skips.
guarded_assign(p: *Parser, test: &Expr, value: &Expr) -> &Expr
    val at = test.span.to(value.span)

    test.kind match
        DefinedE(target, _) ->
            target.kind match
                Ref(n) -> return expr(Conj(test, expr(AssignE(n, value), at)), at)
                BadE -> return expr(BadE, at)
                _ -> ()
        _ -> ()

    p.report.add(error(test.span, "only a variable can be assigned under `\\` or `/`")
        .with_note("`\\x = e` assigns `x` only when it has a value, `/x = e` only when it has none"))
    expr(BadE, at)

// `name op= e`, the target read and an assignment operator next; `None` when none is.
compound_assign(p: *Parser, target: &Expr) -> Option[&Expr]
    var o = Add

    p.peek_tok() match
        Some(t) ->
            t match
                OpEq(k) -> o = k
                QuestionEq -> return Some(scan_assign(p, target))
                _ -> return None
        None -> return None

    p.take()

    val value = parse_expr(p, 0)
    val at = target.span.to(value.span)

    target.kind match
        Ref(n) -> return Some(expr(CompoundE(n, o, value), at))
        BadE -> return Some(expr(BadE, at))
        _ -> ()

    element_update(target, o, value, at) match
        Some(x) -> Some(x)
        None ->
            p.report.add(error(target.span, "only a variable or an element can be assigned through an operator")
                .with_note("`x += e` stores `x + e` in the variable `x`, and `a(i) += e` in the element `a(i)`"))
            Some(expr(BadE, at))

// `name ?= e`, the target read and `?=` next: `name = name ? e`.
private scan_assign(p: *Parser, target: &Expr) -> &Expr
    p.take()

    val body = parse_expr(p, 0)
    val at = target.span.to(body.span)

    target.kind match
        Ref(n) -> expr(AssignE(n, expr(ScanE(target, body), at)), at)
        BadE -> expr(BadE, at)
        _ ->
            p.report.add(error(target.span, "only a variable can be scanned and assigned with `?=`")
                .with_note("`x ?= e` scans the string in `x` with `e` and stores the result in `x`"))
            expr(BadE, at)

// `++x` or `--x`, the operator already read.
private prefix_step(p: *Parser, at: Span, delta: long) -> &Expr
    val target = parse_expr(p, ApplyPower)

    stepped(p, target, at.to(target.span), delta, true)

// `x++` or `x--`, the operator just read.
private postfix_step(p: *Parser, target: &Expr, op: Span, delta: long) -> &Expr = stepped(p, target, target.span.to(op), delta, false)

private stepped(p: *Parser, target: &Expr, at: Span, delta: long, prefix: bool) -> &Expr
    target.kind match
        Ref(n) -> expr(StepE(n, delta, prefix), at)
        BadE -> expr(BadE, at)
        _ ->
            p.report.add(error(target.span, "`++` and `--` change a variable, and this is not one")
                .with_note("`n++` adds one to the variable `n` and produces its old value"))
            expr(BadE, at)

// `i to j [by k]` or `i until j [by k]`, the `to` or `until` already read.
range(p: *Parser, from: &Expr, inclusive: bool) -> &Expr
    val upto = parse_expr(p, RangePower)

    if !p.accept(By) then return expr(RangeE(from, upto, None, inclusive), from.span.to(upto.span))

    val step = parse_expr(p, RangePower)

    expr(RangeE(from, upto, Some(step), inclusive), from.span.to(step.span))

// `a..b`, `a..<b` or the endless `a..`, each with an optional `by k`, the `..` or `..<` already
// read. The range has no end when nothing that can begin an expression follows: `for d <- 1..`,
// `1.. by 2`.
private range_value(p: *Parser, from: &Expr, op: Span, inclusive: bool) -> &Expr
    val more = p.peek_tok() match
        Some(k) -> starts_expr(k)
        None -> false

    if !more
        if !inclusive
            p.report.add(error(op, "a range with `..<` needs an end to stop before")
                .with_note("`a..` is the range with no end"))
            return expr(BadE, from.span.to(op))

        if !p.accept(By) then return expr(RangeValE(from, None, None, true), from.span.to(op))

        val stride = parse_expr(p, RangePower)

        return expr(RangeValE(from, None, Some(stride), true), from.span.to(stride.span))

    val upto = parse_expr(p, RangePower)

    if !p.accept(By) then return expr(RangeValE(from, Some(upto), None, inclusive), from.span.to(upto.span))

    val step = parse_expr(p, RangePower)

    expr(RangeValE(from, Some(upto), Some(step), inclusive), from.span.to(step.span))

// `a..+n`, with an optional `by k`, the `..+` already read.
private range_count(p: *Parser, from: &Expr) -> &Expr
    val count = parse_expr(p, RangePower)

    if !p.accept(By) then return expr(RangeCountE(from, count, None), from.span.to(count.span))

    val step = parse_expr(p, RangePower)

    expr(RangeCountE(from, count, Some(step)), from.span.to(step.span))

// `e.name`, the `.` already read.
private field(p: *Parser, left: &Expr) -> &Expr
    p.peek_tok() match
        Some(k) ->
            k match
                Name(n) ->
                    p.take()
                    return expr(FieldE(left, n), left.span.to(p.toks.previous()))
                _ -> ()
        None -> ()

    p.fail_here("a field's name after `.`")
    expr(BadE, left.span)

// A number literal, and juxtaposition: a literal immediately followed by a name or `(`, with no
// space between, multiplies it -- `2n`, `3(x + 1)`.
private number(p: *Parser, kind: ExprKind, at: Span) -> &Expr
    val lit = expr(kind, at)

    val next = p.toks.peek() match
        Some(k) -> k
        None -> return lit

    if next.span.start != at.end then return lit

    val touching = next.value match
        Name(_) -> true
        LParen -> true
        _ -> false

    if !touching then return lit

    val operand = parse_expr(p, JuxtPower)

    expr(BinE(Mul, lit, operand), at.to(operand.span))

private led(left: &Expr, t: Spanned[Tok], p: *Parser) -> &Expr
    t.value match
        Arrow -> return lambda(p, left)
        LParen ->
            val args = arguments(p)

            return expr(ApplyE(left, args), left.span.to(p.toks.previous()))
        To -> return range(p, left, true)
        Until -> return range(p, left, false)
        DotDot -> return range_value(p, left, t.span, true)
        DotDotLess -> return range_value(p, left, t.span, false)
        DotDotPlus -> return range_count(p, left)
        Dot -> return field(p, left)
        LBracket ->
            val key = parse_expr(p, 0)

            if !p.expect(RBracket, "`]`") then p.skip_line()

            return expr(IndexE(left, key), left.span.to(p.toks.previous()))
        PlusPlus -> return postfix_step(p, left, t.span, 1)
        MinusMinus -> return postfix_step(p, left, t.span, -1)
        Question ->
            // A `?` that ends its line scans the indented block under it.
            val body = if p.at_tok(Indent) then branch(p) else parse_expr(p, power(Question).right)

            return expr(ScanE(left, body), left.span.to(body.span))
        _ -> ()

    // `(e op)`: the operator's right operand is the `)`, which makes this half of a section.
    if sectionable(t.value) && p.at_tok(RParen) then return expr(SectionL(t.value, left), left.span.to(t.span))

    val right = parse_expr(p, power(t.value).right)

    expr(infix(t.value, left, right), left.span.to(right.span))
end led

// What an infix operator makes of its operands.
private infix(op: Tok, a: &Expr, b: &Expr) -> ExprKind
    op match
        Or -> OrE(a, b)
        Bar -> Disj(a, b)
        And -> AndE(a, b)
        Amp -> Conj(a, b)
        Tilde -> UnifyE(a, b)
        EqEq -> EqualE(a, b)
        BangEq -> DifferE(a, b)
        Colon -> ConsE(a, b)
        In -> InE(a, b, false)
        NotIn -> InE(a, b, true)
        _ ->
            binop_of(op) match
                Some(o) -> BinE(o, a, b)
                None -> BadE

// What follows `(`: `()`, a section or an operator as a function, a tuple, a sequence `(s; s; e)`,
// or a parenthesized expression -- whose span takes in the parentheses, so a lambda can tell `(0 | 1) -> e`, whose
// pattern is an alternation, from `n | n > 0 -> e`, whose pattern is guarded.
private paren(p: *Parser, open: Span) -> &Expr
    if p.accept(RParen) then return expr(TupleE(buf()), open.to(p.toks.previous()))

    val look = p.look() match
        Some(k) -> k
        None ->
            p.fail_here("an expression")
            return expr(BadE, open)

    if p.at_tok(Val) || p.at_tok(VarW) then return sequence(p, open, statement(p))

    // `(op)` and `(op e)`. A `-` is a section only as `(-)`: `(- 1)` is minus one.
    if sectionable(look.value) && (!is_minus(look.value) || p.next_is(RParen))
        p.take()

        if p.accept(RParen)
            return section(p, look.value, expr(Ref("$a"), look.span), expr(Ref("$b"), look.span), 2, open)

        val operand = parse_expr(p, 0)

        p.expect(RParen, "`)`")
        return section(p, look.value, expr(Ref("$a"), look.span), operand, 1, open)

    val first = delimited(p)

    first.kind match
        SectionL(op, e) ->
            p.expect(RParen, "`)`")
            return section(p, op, e, expr(Ref("$b"), first.span), 1, open)
        _ -> ()

    if p.at_tok(Semi) then return sequence(p, open, ExprS(first))

    if p.at_tok(Comma)
        var items: Buf[&Expr] = buf()

        items.push(first)

        while p.accept(Comma)
            items.push(delimited(p))

        if !p.expect(RParen, "`,` or `)`") then p.skip_to_close()

        return expr(TupleE(items), open.to(p.toks.previous()))

    p.expect(RParen, "`)`")
    expr(first.kind, open.to(p.toks.previous()))
end paren

// `(s; s; e)`, its first statement read: a block of its own, whose value is its last statement's.
private sequence(p: *Parser, open: Span, first: Stmt) -> &Expr
    var stmts: Buf[Stmt] = buf()

    stmts.push(first)

    while p.accept(Semi)
        stmts.push(statement(p))

    if !p.expect(RParen, "`;` or `)`") then p.skip_to_close()

    expr(BlockE(p.node_id(), stmts), open.to(p.toks.previous()))

private is_minus(t: Tok) -> bool = t match
    Minus -> true
    _ -> false

// A section as the lambda it is: `a op b` over the parameters the hidden names `$a` and `$b` stand
// for -- `arity` of them, the first `$a` and then `$b` -- which no program can write.
private section(p: *Parser, op: Tok, a: &Expr, b: &Expr, arity: usize, open: Span) -> &Expr
    val at = open.to(p.toks.previous())
    var params: Buf[&Expr] = buf()

    if arity == 2 || is_ref(a, "$a") then params.push(expr(Ref("$a"), at))
    if arity == 2 || is_ref(b, "$b") then params.push(expr(Ref("$b"), at))

    val body = expr(infix(op, a, b), at)

    one_clause_lambda(p, params, None, body, at)

private is_ref(e: &Expr, name: string) -> bool = e.kind match
    Ref(n) -> n == name
    _ -> false

// `params -> body`, the arrow already taken and `left` what stood before it.
private lambda(p: *Parser, left: &Expr) -> &Expr
    val body = if p.at_tok(Indent) then branch(p) else parse_expr(p, power(Arrow).right)

    // A bare alternation on the left is a pattern and its guard.
    var pat = left
    var guard: Option[&Expr] = None

    left.kind match
        Disj(a, g) ->
            if left.span.start == a.span.start
                pat = a
                guard = Some(g)
        _ -> ()

    var params: Buf[&Expr] = buf()

    pat.kind match
        TupleE(items) ->
            for x in items.view()
                params.push(x)
        _ -> params.push(pat)

    one_clause_lambda(p, params, guard, body, left.span.to(body.span))
end lambda

private one_clause_lambda(p: *Parser, params: Buf[&Expr], guard: Option[&Expr], body: &Expr, at: Span) -> &Expr
    var guards: Buf[Guard] = buf()
    var clauses: Buf[Clause] = buf()

    guards.push(Guard(guard, body))
    clauses.push(Clause("lambda", at, params, FunctionC(FnBody(guards, buf()))))
    expr(LambdaE(p.lambda_id(), clauses), at)

// `name(args)`, the name already read and the `(` next.
private call(p: *Parser, name: string, name_span: Span) -> &Expr
    p.take()

    val args = arguments(p)

    expr(CallE(name, name_span, args), name_span.to(p.toks.previous()))

// The arguments of a call or a head, the `(` already taken, through the `)`.
arguments(p: *Parser) -> Buf[&Expr]
    var args: Buf[&Expr] = buf()

    if p.accept(RParen) then return args

    loop
        args.push(delimited(p))

        if p.accept(Comma) then continue

        if !p.expect(RParen, "`,` or `)`") then p.skip_to_close()

        break

    args
end arguments

// `if c then t [elif ...] [else e]`, the `if` already read. A condition followed by an indented
// block needs no `then`.
private if_expr(p: *Parser, at: Span) -> &Expr
    val cond = parse_expr(p, 0)

    if !p.at_tok(Indent) && !p.expect(Then, "`then`") then return expr(BadE, at.to(cond.span))

    val yes = branch(p)

    // An `elif` or an `else` may begin the line after a block that ended the branch before it.
    if p.at_tok(Newline) && (p.next_is(Else) || p.next_is(Elif)) then p.take()

    if p.at_tok(Elif)
        val elif_at = p.toks.here()

        p.take()

        val no = if_expr(p, elif_at)

        return expr(IfE(cond, yes, Some(no)), at.to(no.span))

    if !p.accept(Else) then return expr(IfE(cond, yes, None), at.to(yes.span))

    val no = branch(p)

    expr(IfE(cond, yes, Some(no)), at.to(no.span))
end if_expr

// What follows `then`, `else`, `do`, `=`, `->` or `repeat`: an expression on the same line -- which,
// as a statement can, may assign, `do x = e` -- or an indented block. **A block whose every line is a lambda is a partial function literal**: one anonymous
// function whose clauses are the lambdas, in order.
branch(p: *Parser) -> &Expr
    if !p.at_tok(Indent) then return delimited(p)

    val at = p.toks.here()

    p.take()

    var stmts: Buf[Stmt] = buf()

    loop
        stmts.push(statement(p))

        if p.accept(Newline) then continue

        if p.accept(Dedent) then break

        p.fail_here("the end of the line")
        p.skip_line()

        if p.accept(Newline) then continue

        p.accept(Dedent)
        break

    val span = at.to(p.toks.previous())

    partial_function(stmts, span) match
        Some(f) -> f
        None -> expr(BlockE(p.node_id(), stmts), span)
end branch

// The lambdas of a block as one function, if every line is one.
private partial_function(stmts: Buf[Stmt], span: Span) -> Option[&Expr]
    var clauses: Buf[Clause] = buf()
    var id: usize = 0

    for i in 0..<stmts.len()
        stmts.at(i) match
            ExprS(e) ->
                e.kind match
                    LambdaE(k, cs) ->
                        if i == 0 then id = k

                        for c in cs.view()
                            clauses.push(c)
                    _ -> return None
            _ -> return None

    Some(expr(LambdaE(id, clauses), span))
end partial_function

// A regex literal, its text read into a pattern tree; a mistake in it is reported where it is in the
// source, the text starting one past the opening backtick.
private regex_literal(p: *Parser, text: string, at: Span) -> &Expr
    parse_regex(text) match
        Ok(r) -> expr(RegexE(r.pat, r.groups), at)
        Err(e) ->
            val from = at.start + 1 + e.at
            var d = error(Span(from, from + e.len), e.message)

            if e.note != "" then d = d.with_note(e.note)

            p.report.add(d)
            expr(BadE, at)
