module io.github.edadma.funl

import sh.sysl.kairos.{Driver, Loop, event_loop}
import sh.sysl.kairos.host.{Host, host}
import sysl.time.Duration

// The event loop: `sh.sysl.kairos`, used in callback form.
//
// **There are two queues, in a fixed order.** The ready queue (`task.sysl`) holds the machines a
// settled promise owes a turn, and is drained to empty first. Only then is the loop asked for
// anything: the promises of the timers that fired in its last pass are kept, in deadline order, and
// the ready queue is drained to empty again; when none has fired, the loop is run until one does.
// **A turn of the loop is a pass, as slate's is**: two timers due in the same pass are both kept
// before either waiting task runs.
//
// **A timer's callback runs no FunL.** It moves its promise from `timed` to `fired` and stops the
// loop, so `run` returns at the end of that pass and the instruction loop carries on. The loop is
// never entered from inside a FunL machine, and a machine never runs inside the loop.
//
// **A pending timer keeps the program alive**: the top level halting with one set is parked, as it is
// with tasks still owed a turn, and the run ends when both queues are empty and no timer is left.
//
// Both tables are collector roots, so a promise nothing else holds -- `sleep( 10 )` on a line of its
// own -- is still there to keep when its timer fires.

// The loop, made by the first timer a program sets.
private events_of(v: *Vm) -> &Loop[Host]
    v.events match
        Some(lp) -> return lp
        None -> ()

    val h = host()
    val lp = event_loop(h)

    v.clock = Some(h)
    v.events = Some(lp)
    lp

// Keep promise `p` once `d` has passed.
//
// kairos sets a timer from the reading its last pass took, which for a timer set from FunL -- after
// the loop has returned -- is the time the loop last looked. **The clock is read once per stretch of
// FunL between passes**, at its first timer, and the time since the pass is added: so a wait starts
// when the stretch first asked for one, however long the program ran before it, and two timers set
// in one stretch with the same delay are due together and fire in the same pass, in the order they
// were set.
arm_timer(v: *Vm, p: *PromiseObj, d: Duration)
    val lp = events_of(v)

    val base = v.stretch match
        Some(t) -> t
        None ->
            val t = v.clock match
                Some(h) -> h.now()
                None -> lp.now()

            v.stretch = Some(t)
            t

    val since = base - lp.now()

    v.timed.push(Promise(p))

    lp.after(d + since, (l) ->
        timer_fired(v, p)
        l.stop())

// A timer has fired: its promise moves from those waiting on a timer to those owed keeping.
private timer_fired(v: *Vm, p: *PromiseObj)
    val n = v.timed.len()

    for i in 0..<n
        val here = v.timed.at(i) match
            Promise(q) -> q == p
            _ -> false

        if here
            v.timed.set(i, v.timed.at(n - 1))
            v.timed.truncate(n - 1)
            break

    v.fired.push(Promise(p))

// Whether the loop holds anything: a fired timer's promise not yet kept, or a timer still to fire.
events_owed(v: *Vm) -> bool = !v.fired.is_empty() || !v.timed.is_empty()

// The ready queue is empty: keep the promises the loop's last pass fired, or, none having fired, run
// the loop until one does. False when there is nothing left that could make a machine ready.
next_event(v: *Vm) -> bool
    if !v.fired.is_empty()
        for x in v.fired.view()
            x match
                Promise(p) -> settle_promise(v, p, PromiseKept, Unit, "")
                _ -> ()

        v.fired.clear()
        return true

    if v.timed.is_empty() then return false

    v.stretch = None

    v.events match
        Some(lp) -> lp.run()
        None -> return false

    true
end next_event

// Drop the loop and every timer: when a VM is disposed, and when a run begins, so a timer a faulted
// run left set does not hold the next one open.
forget_events(v: *Vm)
    v.events = None
    v.clock = None
    v.stretch = None
    v.timed.clear()
    v.fired.clear()
