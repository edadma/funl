module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.from_utf8_unchecked

// Loading Prolog: the predicate table, and a file's clauses and directives compiled into the VM.
//
// **Every predicate has one chunk for the life of the VM**, reserved the first time anything names
// it -- a call compiled before the definition is read, a FunL program importing the file -- and
// filled when its clauses are compiled. A call compiled before the definition therefore reaches it,
// and one to a predicate never defined runs `NoProcedure`.
//
// **A file's directives run when what loading it made is called** (`prolog.md` § "Loading Prolog"):
// loading answers a chunk that runs each directive in turn, then each `initialization/1` goal, and
// returns `()`. `op/3` is the exception, carried out the moment the directive is read, because it
// changes how the rest of the file reads.

// A predicate a call can reach, and whether anything has defined it yet.
struct PredInfo
    chunk: usize
    defined: bool
    kind: PredKind

    // Where its definition came from, for a refusal to name.
    origin: Origin

// Where a definition was made.
//
// **Prolog and FunL share one predicate for each name and arity** (`prolog.md` § "Calling FunL from
// Prolog"), so a second definition of a key -- a FunL function or relation, or a file's clauses -- is
// refused when it is loaded, naming both. The file that made the first may load again: that replaces
// it, as consulting a file again does.
struct Origin
    // The file whose clauses or definition it is; empty for a builtin, the library, or a dynamic
    // predicate made while the program runs.
    file: string

    // The definition named for a person: what it is and where it is written.
    what: string

// No file's: a builtin, the library, a predicate made while the program runs.
nowhere() -> Origin = Origin("", "")

// Where `offset` is in `src`, as `file:line:column`.
located(src: Source, offset: usize) -> string = s"${src.name}:${src.locate(offset)}"

// Where a predicate's code came from, which says what may change it.
enum PredKind
    // Nothing has defined it: its chunk runs `NoProcedure`.
    Unclaimed

    // A builtin, or `catch/3`.
    NativePred

    // A predicate of the library written in Prolog (`pl_lib.sysl`): a program that defines the same
    // name and arity replaces it.
    LibraryPred

    // Clauses a program loaded, or a FunL definition: static.
    ProgramPred

    // A dynamic predicate, entry `index` of the database (`pl_db.sysl`).
    DynamicPred(index: usize)

// The chunk of predicate `name/arity`: its own, a builtin's, or one reserved for it.
predicate_chunk(name: string, arity: usize) -> usize
    val v = current()
    val key = pred_key(name, arity)

    v.preds.get(key) match
        Some(p) -> return p.chunk
        None -> ()

    if key == "catch/3"
        val at = catch_chunk()

        v.preds.put(key, PredInfo(at, true, NativePred, nowhere()))
        return at

    native_id(key) match
        Some(id) ->
            val at = finish(native_predicate(key, id, arity)).unwrap()

            v.preds.put(key, PredInfo(at, true, NativePred, nowhere()))
            at
        None ->
            var e = emit(key)

            e.op(NoProcedure)

            val at = finish(e).unwrap()

            v.preds.put(key, PredInfo(at, false, Unclaimed, nowhere()))
            at
end predicate_chunk

// A builtin as a predicate, for `call/N` to reach: its arguments, the builtin, and `()`.
private native_predicate(key: string, id: usize, arity: usize) -> Emit
    var e = emit(key)

    for i in 0..<arity
        e.op(LoadArg(i))

    if is_generator(id)
        e.op(PushInt(0))
        e.op(NativeGen(id, arity))
    else
        e.op(Native(id, arity))

    e.op(Pop)
    e.op(PushUnit)
    e.op(Return)
    e

// Whether `name/arity` has been defined by anything: Prolog clauses, a FunL definition, a builtin.
pred_defined(key: string) -> bool = current().preds.get(key) match
    Some(p) -> p.defined
    None -> false

// Make `e` the code of predicate `key`, in the chunk calls to it already name, the definition
// `origin` made.
define_predicate(key: string, e: Emit, origin: Origin) -> Result[unit, string]
    val v = current()

    v.preds.get(key) match
        Some(p) ->
            install(e, p.chunk)?
            v.preds.put(key, PredInfo(p.chunk, true, ProgramPred, origin))
        None ->
            val at = finish(e)?

            v.preds.put(key, PredInfo(at, true, ProgramPred, origin))

    Ok(())

// Whether `key` is a builtin's -- `catch/3` among them -- which no program can define.
is_builtin(key: string) -> bool = key == "catch/3" || native_id(key).is_some()

// Why `key` cannot be given the definition `origin`, or `None` when it can: a definition of a
// program's or a dynamic predicate's is already there, made by another file. The library's gives way,
// a predicate nothing has defined has nothing to give, and the file that made the definition may
// make it again.
clash(key: string, origin: Origin) -> Option[string]
    val p = current().preds.get(key) match
        Some(p) -> p
        None -> return None

    val taken = p.kind match
        ProgramPred -> true
        DynamicPred(_) -> true
        _ -> false

    if !taken || p.origin.file == "" || p.origin.file == origin.file then return None

    Some(s"`$key` cannot be defined twice: ${p.origin.what}, and ${origin.what}. Prolog and FunL share one predicate for each name and arity")

// Record that `origin` made dynamic predicate `key`'s definition where no file has yet: a file's
// clauses for a predicate made dynamic while the program ran.
claim(key: string, origin: Origin)
    val v = current()

    v.preds.get(key) match
        Some(p) -> if p.origin.file == "" then v.preds.put(key, PredInfo(p.chunk, p.defined, p.kind, origin))
        None -> ()

// Whether `key` is a predicate of the library written in Prolog, which a program may replace.
is_library(key: string) -> bool = current().preds.get(key) match
    Some(p) -> p.kind match
        LibraryPred -> true
        _ -> false
    None -> false

// Every predicate defined so far becomes the library's: what loading the library ends with.
mark_library()
    val v = current()
    var keys: Buf[string] = buf()
    var walk = v.preds.walk()

    loop
        walk.next() match
            Some((k, p)) ->
                p.kind match
                    ProgramPred -> keys.push(k)
                    _ -> ()
            None -> break

    for k in keys.view()
        val p = v.preds.get(k).unwrap()

        v.preds.put(k, PredInfo(p.chunk, p.defined, LibraryPred, nowhere()))

// Whether `name` has a Prolog predicate -- of any arity -- defined in the table; what a FunL program
// calls by name. **The library's predicates are Prolog's own and not among them**: a FunL program
// names a program's predicates, and its own forms -- `findall`, `bagof`, `setof` -- keep their
// meaning whatever the library defines.
pred_name_known(name: string) -> bool
    var walk = current().preds.walk()

    loop
        walk.next() match
            Some((k, p)) ->
                val library = p.kind match
                    LibraryPred -> true
                    _ -> false

                if p.defined && !library && key_name(k) == name then return true
            None -> return false

// The name part of key `name/arity`.
key_name(k: string) -> string
    var i = k.bytes.len

    while i > 0
        i -= 1

        if k.bytes[i] == u8('/') then return from_utf8_unchecked(k.bytes[0..<i])

    k

// The clauses a file gives one predicate, in the order they were read.
private struct Group
    name: string
    arity: usize
    clauses: Buf[ReadClause]

// Read and compile the Prolog program in `src` into the running VM: the chunk that runs its
// directives, or `None` with the reasons in `report`.
load_prolog(src: Source, report: *Report) -> Option[usize]
    var r = pl_reader(src, report)
    var groups: Buf[Group] = buf()
    var by_key: Map[string, usize] = map()
    var goals: Buf[ReadClause] = buf()
    var inits: Buf[ReadClause] = buf()

    loop
        val c = next_clause(&r) match
            Done -> break
            Skipped -> continue
            Clause(c) -> c

        directive_goal(c.t) match
            Some(g) ->
                directive(src, report, ReadClause(g, c.names), &goals, &inits)
                continue
            None -> ()

        val (head, _) = clause_parts(c.t)

        val (f, n) = callable_key(head) match
            Some(k) -> k
            None ->
                report.add(error(head.span, "a clause's head is an atom or a compound term"))
                continue

        val name = atom_name(f)

        if is_inline(name, n)
            report.add(error(head.span, s"`$name/$n` is a control construct, and a program cannot define it"))
            continue

        val key = pred_key(name, n)

        // ISO's `permission_error(modify, static_procedure, ...)`, raised as the file loads.
        if is_builtin(key)
            report.add(error(head.span, s"`$key` is a builtin predicate, and a program cannot define it"))
            continue

        by_key.get(key) match
            Some(i) ->
                var g = groups.at(i)

                g.clauses.push(c)
                groups.set(i, g)
            None ->
                var cs: Buf[ReadClause] = buf()

                cs.push(c)
                by_key.put(key, groups.len())
                groups.push(Group(name, n, cs))
    end loop

    if report.has_errors() then return None

    var origins: Buf[Origin] = buf()

    for g in groups.view()
        val key = pred_key(g.name, g.arity)
        val head = g.clauses.at(0).t
        val origin = Origin(src.name, s"the Prolog predicate `$key` at ${located(src, head.span.start)}")

        clash(key, origin) match
            Some(m) -> report.add(error(head.span, m))
            None -> ()

        origins.push(origin)

    if report.has_errors() then return None

    var codes: Buf[Emit] = buf()

    for g in groups.view()
        // A dynamic predicate's clauses are added to the database below, one chunk each.
        if dynamic_index(pred_key(g.name, g.arity)).is_some()
            codes.push(emit(""))
            continue

        compile_predicate(g.name, g.arity, g.clauses) match
            Ok(e) -> codes.push(e)
            Err(p) -> report.add(error(p.at, p.message))

    if report.has_errors() then return None

    for i in 0..<groups.len()
        val g = groups.at(i)
        val key = pred_key(g.name, g.arity)

        dynamic_index(key) match
            Some(p) ->
                claim(key, origins.at(i))
                load_dynamic(report, p, g.clauses)
            None -> define_predicate(key, codes.at(i), origins.at(i)).unwrap()

    if report.has_errors() then return None

    var load = emit(s"load ${src.name}")

    for g in goals.view()
        run_directive(&load, src, report, g, "directive")?

    for g in inits.view()
        run_directive(&load, src, report, g, "initialization goal")?

    load.op(PushUnit)
    load.op(Return)

    finish(load) match
        Ok(at) -> Some(at)
        Err(e) ->
            report.add(error(point(0), s"the Prolog compiler failed: $e"))
            None
end load_prolog

// A file's clauses for dynamic predicate `p`, added to the database in order.
private load_dynamic(report: *Report, p: usize, clauses: Buf[ReadClause])
    for c in clauses.view()
        var vars: Buf[Value] = buf()

        val x = term_value(c.t, &vars) match
            Ok(x) -> x
            Err(m) ->
                report.add(error(c.t.span, m))
                continue

        val stored = stored_clause(x, "a clause") match
            Ok((t, _, _)) -> t
            Err(f) ->
                report.add(error(c.t.span, fault_text(f)))
                continue

        add_clause(p, stored, false) match
            Ok(_) -> ()
            Err(f) -> report.add(error(c.t.span, fault_text(f)))

// The database index of `key`, when it is a dynamic predicate.
dynamic_index(key: string) -> Option[usize] = current().preds.get(key) match
    Some(p) -> p.kind match
        DynamicPred(i) -> Some(i)
        _ -> None
    None -> None

// The goal of a directive `:- G` (or `?- G`).
private directive_goal(t: &Term) -> Option[&Term]
    t.kind match
        TComp(f, args) ->
            val n = atom_name(f)

            if args.len() == 1 && (n == ":-" || n == "?-") then return Some(args.at(0))
        _ -> ()

    None

// A directive as it is read: `op/3` carried out now, `initialization/1` kept for after the rest,
// anything else kept to run in order.
private directive(src: Source, report: *Report, c: ReadClause, goals: *Buf[ReadClause], inits: *Buf[ReadClause])
    val t = c.t

    t.kind match
        TComp(f, args) ->
            val n = atom_name(f)

            if n == "op" && args.len() == 3
                op_directive(report, t, args)
                return

            if n == "initialization" && (args.len() == 1 || args.len() == 2)
                inits.push(ReadClause(args.at(0), c.names))
                return

            // `dynamic/1` is carried out now too: the file's own clauses for the predicates it
            // names are added to the database rather than compiled as static code.
            if n == "dynamic" && args.len() == 1
                var vars: Buf[Value] = buf()

                val spec = term_value(args.at(0), &vars) match
                    Ok(x) -> x
                    Err(m) ->
                        report.add(error(t.span, m))
                        return

                declare_dynamic(spec, src.name, located(src, t.span.start)) match
                    Ok(_) -> ()
                    Err(f) -> report.add(error(t.span, fault_text(f)))

                return
        _ -> ()

    goals.push(c)

// `:- op(P, T, Names)`, where `Names` is a name or a list of them.
private op_directive(report: *Report, t: &Term, args: Buf[&Term])
    val p = args.at(0).kind match
        TInt(n) -> n
        _ ->
            report.add(error(args.at(0).span, "an operator's priority is an integer from 0 to 1200"))
            return

    val kind = args.at(1).kind match
        TAtom(id) -> atom_name(id)
        _ ->
            report.add(error(args.at(1).span, "an operator's type is an atom: xfx, xfy, yfx, fy, fx, xf or yf"))
            return

    var names: Buf[&Term] = buf()
    var at = args.at(2)

    loop
        at.kind match
            TCons(h, tl) ->
                names.push(h)
                at = tl
            TNil -> break
            _ ->
                names.push(at)
                break

    for x in names.view()
        val name = x.kind match
            TAtom(id) -> atom_name(id)
            _ ->
                report.add(error(x.span, "an operator is named by an atom"))
                continue

        set_op(p, kind, name) match
            Ok(_) -> ()
            Err(f) -> report.add(error(t.span, fault_text(f)))
end op_directive

// Emit the running of one directive: a chunk of its own called inside a mark, and a warning naming
// it where it fails.
private run_directive(load: *Emit, src: Source, report: *Report, g: ReadClause, what: string) -> Option[unit]
    val e = compile_query(s"$what in ${src.name}", g) match
        Ok(e) -> e
        Err(p) ->
            report.add(error(p.at, p.message))
            return None

    val chunk = finish(e) match
        Ok(c) -> c
        Err(m) ->
            report.add(error(g.t.span, m))
            return None

    val failed = load.label()
    val next = load.label()
    val text = from_utf8_unchecked(src.text(g.t.span))

    load.op(Mark(failed))
    load.op(Call(chunk, 0))
    load.op(Unmark)
    load.op(Branch(next))
    load.place(failed)

    val warning = new_str(s"Warning: $what failed: $text") match
        Ok(w) -> w
        Err(m) ->
            report.add(error(g.t.span, m))
            return None

    load.op(PushConst(load.constant(warning)))
    load.op(Native(native_id("write").unwrap(), 1))
    load.op(Pop)
    load.place(next)
    Some(())
end run_directive

// A whole Prolog program, `funl file.pl`: load it, which runs its directives and its
// `initialization/1` goals, and halt.
prolog_program(src: Source, report: *Report) -> Option[usize]
    val load = load_prolog(src, report)?
    var e = emit("main")

    e.op(Frame(0))
    e.op(Call(load, 0))
    e.op(Pop)
    e.op(Halt)

    finish(e) match
        Ok(at) -> Some(at)
        Err(m) ->
            report.add(error(point(0), s"the Prolog compiler failed: $m"))
            None
