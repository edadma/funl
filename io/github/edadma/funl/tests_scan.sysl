module io.github.edadma.funl
@tests

import sysl.text.Search

// String scanning: `s ? e`, `?=`, the builtins that read and move the position, csets, and the
// string representation under them. Every program runs on both heaps.

private faults_with(text: string, want: string)
    val said = ran_funl(text)

    assert(said.contains("fault: "), said)
    assert(said.contains(want), said)

// A generator inside a scan, resumed after the scan has ended -- and after another scan has run --
// sees its own subject, at the position it had when the generator was first reached.
@test
A_GENERATOR_RESUMED_AFTER_ITS_SCAN_ENDED_SEES_ITS_SUBJECT_AND_POSITION()
    assert_eq(ran_funl("every write((\"hello\" ? (tab(2) & tab(upto('lo')))), (\"xy\" ? move(1)))\n"),
        "e, x\nel, x\nell, x\nsucceeded")

@test
A_POSITION_OUTSIDE_THE_SUBJECT_FAILS()
    assert_eq(ran_funl("'abc' ? (if tab(5) then write('moved') else write(pos(1)))\n'abc' ? (if move(-5) | pos(9) then write('moved') else write('stayed'))\n"),
        "1\nstayed\nsucceeded")

@test
ZERO_AND_NEGATIVE_POSITIONS_COUNT_FROM_THE_END()
    assert_eq(ran_funl("'abc' ? write(tab(-1), tab(0))\n'abc' ? (tab(0) & write(move(-2)))\n"),
        "ab, c\nbc\nsucceeded")

@test
BACKTRACKING_PAST_TAB_AND_MOVE_PUTS_THE_POSITION_BACK()
    assert_eq(ran_funl("'abcdef' ? (tab(3) & move(10) | write(tab(0)))\n'abcdef' ? ((move(2) | move(3)) & pos(4) & write(tab(0)))\n"),
        "abcdef\ndef\nsucceeded")

// A bounded expression that completes makes its movement permanent, as a reversible assignment's
// is: resuming the generator of an `every` does not move the position back, and a loop that ends by
// failing keeps what its body moved.
@test
A_COMPLETED_BOUNDED_EXPRESSION_KEEPS_ITS_MOVEMENT()
    assert_eq(ran_funl("'abc' ? every 1 to 3 do write(move(1))\n'ab cd' ?\n  while tab(upto(' '))\n    move(1)\n\n  write(tab(0))\n"),
        "a\nb\nc\ncd\nsucceeded")

@test
A_NESTED_SCAN_PUTS_THE_OUTER_SUBJECT_BACK()
    assert_eq(ran_funl("'outer' ? (tab(3) & ('inner' ? write(tab(0))) & write(tab(0)))\n'outer' ? (tab(2) & (('in' ? tab(9)) | write(tab(0))))\n"),
        "inner\nter\nuter\nsucceeded")

@test
SCANNING_A_NON_STRING_IS_AN_ERROR()
    faults_with("5 ? write(move(1))\n", "`?` scans a string, and was given the integer 5")
    faults_with("write(tab(1))\n", "'tab' works on the subject of a scan `s ? e`, and no scan is running")

@test
A_SCANNING_BUILTIN_REFUSES_AN_ARGUMENT_OF_THE_WRONG_KIND()
    faults_with("'a' ? tab('x')\n", "'tab' wants an integer and was given the string 'x'")
    faults_with("'a' ? upto(5)\n", "'upto' wants a cset or a string and was given the integer 5")
    faults_with("'a' ? match(5)\n", "'match' wants a string and was given the integer 5")
    faults_with("write(upto('a', 'b', 'c'))\n", "'upto' takes 1 or 2 arguments, and was given 3")

@test
MANY_ANY_AND_MATCH_ANSWER_POSITIONS()
    assert_eq(ran_funl("write('abc' ? any('xa'), 'abc' ? match('ab'), 'abc' ? match(''), 'aab' ? many('a'))\nif 'abc' ? (any('x') | many('x') | match('b')) then write('moved') else write('none')\n"),
        "2, 3, 1, 3\nnone\nsucceeded")

@test
UPTO_AND_FIND_SEARCH_A_STRING_GIVEN_THEM()
    assert_eq(ran_funl("every write(upto('l', 'hello'))\nevery write(find('ab', 'abcabab'))\n"),
        "3\n4\n1\n4\n6\nsucceeded")

@test
CSETS_ARE_MADE_NAMED_AND_COMPARED()
    assert_eq(ran_funl("write(cset('cba'), cset('abc') == cset('cab'), cset('é a'))\nif letters == cset('ba') then write('same') else write('differ')\nwrite('a1b2' ? tab(many(letters)), 'a1b2' ? (move(1) & tab(many(digits))), 'x9?' ? tab(many(alphanum)))\n"),
        "cset(\"abc\"), cset(\"abc\"), cset(\" aé\")\ndiffer\na, 1, x9\nsucceeded")
    faults_with("write(cset(5))\n", "'cset' wants a string and was given the integer 5")

@test
A_NAMED_CSET_IS_NOT_CALLED()
    assert_eq(complaints("write(letters(1))\n"), "")
    faults_with("write(letters(1))\n", "a cset is not a function, and cannot be called")
    faults_with("c = letters\nwrite(c(1))\n", "a cset is not a function, and cannot be called")

// Positions are characters, not bytes, forward and back.
@test
POSITIONS_COUNT_CHARACTERS()
    assert_eq(ran_funl("write('héllo' ? (tab(3) & move(2)), '日本語' ? find('語'), 'héllo'(1), 'héllo'.length)\nwrite('héllo' ? (tab(0) & move(-4)), 'aé日' ? (tab(0) & tab(2)))\n"),
        "ll, 3, é, 5\néllo, é日\nsucceeded")

@test
SCAN_ASSIGN_STORES_THE_RESULT()
    assert_eq(ran_funl("var padded = '  trimmed'\npadded ?= tab(many(' ')) & tab(0)\nwrite( padded )\n"), "trimmed\nsucceeded")
    assert_eq(complaints("'a' ?= tab(1)\n"), "error 1:1 only a variable can be scanned and assigned with `?=`\n")

@test
RIGHT_PADS_OR_CUTS_TO_A_WIDTH()
    assert_eq(ran_funl("write(right('ab', 4), right('abcdef', 3), right(7, 2))\n"), "  ab, def,  7\nsucceeded")
    faults_with("write(right('a', -1))\n", "'right' makes a field of -1 characters")

// -- leaving a scan by a jump ------------------------------------------------------------------------

// `return` evaluates its value inside the scans it leaves, then the caller's scan is in force again,
// at the position it had -- however many of the function's scans the `return` leaves.
@test
RETURN_FROM_INSIDE_A_SCAN_PUTS_THE_CALLERS_SCAN_BACK()
    val text = "def f() = 'inner' ? (move(2) & return tab(0))\n" +
        "def g()\n" +
        "  'mid' ?\n" +
        "    move(1)\n" +
        "    'in' ? (move(1) & return tab(0))\n" +
        "'outer' ? (tab(3) & write(f(), tab(0)))\n" +
        "'outer' ? (tab(2) & write(g(), tab(0)))\n"

    assert_eq(ran_funl(text), "ner, ter\nn, uter\nsucceeded")

// A `break` or `continue` out of a scan inside a loop puts back the scan state around the loop,
// keeping what the loop moved there; a labelled `break` leaves every scan up to its loop. A `break`
// out of a loop inside a scan leaves no scan, and keeps the scan's movement.
@test
BREAK_AND_CONTINUE_OUT_OF_A_SCAN_PUT_THE_LOOPS_SCAN_BACK()
    val text = "'outer' ?\n" +
        "  tab(2)\n" +
        "  for i <- 1..3\n" +
        "    'inner' ?\n" +
        "      move(i)\n" +
        "      if i == 2 then break\n" +
        "  write(tab(0))\n" +
        "var n = 0\n" +
        "'outer' ?\n" +
        "  tab(2)\n" +
        "  while n++ < 2\n" +
        "    move(1)\n" +
        "    'inner' ?\n" +
        "      move(1)\n" +
        "      continue\n" +
        "  write(tab(0))\n" +
        "'outer' ?\n" +
        "  tab(2)\n" +
        "  out: repeat\n" +
        "    'mid' ?\n" +
        "      move(1)\n" +
        "      repeat\n" +
        "        'in' ?\n" +
        "          move(1)\n" +
        "          break out\n" +
        "  write(tab(0))\n" +
        "'abcd' ?\n" +
        "  tab(2)\n" +
        "  repeat\n" +
        "    move(1)\n" +
        "    break\n" +
        "  write(tab(0))\n"

    assert_eq(ran_funl(text), "uter\ner\nuter\ncd\nsucceeded")

// A generator inside a scan, resumed after a `break` or a `return` left an inner scan, still sees
// its own subject and position.
@test
A_GENERATOR_RESUMED_AFTER_A_JUMP_OUT_OF_AN_INNER_SCAN_SEES_ITS_SUBJECT()
    val text = "def f() = 'x' ? return 1\n" +
        "every 'hello' ? (tab(upto('lo')) & (repeat ('x' ? break)) & write(tab(0)))\n" +
        "every 'hello' ? (tab(upto('lo')) & f() & write(tab(0)))\n"

    assert_eq(ran_funl(text), "llo\nlo\no\nllo\nlo\no\nsucceeded")

// `yield` from inside a scan gives the caller its own scan back, and resuming the generator gives
// the generator its scan back, at the position it had. The last `yield` is the function's last
// value: resumed after it, the function fails.
@test
YIELD_FROM_INSIDE_A_SCAN_SWAPS_THE_SCANS_EACH_WAY()
    val text = "def g()\n" +
        "  'abc' ?\n" +
        "    move(1)\n" +
        "    yield move(1)\n" +
        "    yield tab(0)\n" +
        "'outer' ? (tab(2) & every write(g(), tab(0)))\n"

    assert_eq(ran_funl(text), "b, uter\nbc, uter\nsucceeded")

// A `yield` that is the last thing a scan does, where the scan is the last thing the function does,
// is the function's last `yield`: resumed, the function fails rather than producing `()`. That holds
// however the scan is written -- the body's statement, `= e`, under an `if` either way round, nested
// in another scan, or in a `where` function.
@test
A_FINAL_YIELD_INSIDE_A_SCAN_ENDS_THE_FUNCTION()
    val text = "def g()\n" +
        "  'a' ? yield 1\n" +
        "every write( g() )\n" +
        "def h() = 'a' ? yield 2\n" +
        "every write( h() )\n" +
        "def i( x )\n" +
        "  if x\n" +
        "    'a' ? yield 3\n" +
        "  else\n" +
        "    yield 0\n" +
        "every write( i(true) )\n" +
        "def j( x )\n" +
        "  'a' ?\n" +
        "    if x then yield 4 else yield 0\n" +
        "every write( j(true) )\n" +
        "def k() = 'a' ? ('b' ? yield 5)\n" +
        "every write( k() )\n" +
        "def l() = m()\n" +
        "  where\n" +
        "    m()\n" +
        "      yield 6\n" +
        "      'a' ? yield 7\n" +
        "every write( l() )\n"

    assert_eq(ran_funl(text), "1\n2\n3\n4\n5\n6\n7\nsucceeded")

// A `yield` inside a scan that is not the last thing the function does produces its value and,
// resumed, carries on with the rest of the scan -- `move(1)` undone, as failing back past it does.
@test
A_YIELD_INSIDE_A_SCAN_THAT_IS_NOT_LAST_CARRIES_ON()
    val text = "def g()\n" +
        "  'abc' ?\n" +
        "    yield move(1)\n" +
        "    tab(0)\n" +
        "every write( g() )\n" +
        "def h()\n" +
        "  'xy' ? yield move(1)\n" +
        "  'done'\n" +
        "every write( h() )\n"

    assert_eq(ran_funl(text), "a\nabc\nx\ndone\nsucceeded")

// A call that is the last thing a scan does is made with the scan's subject in force, and each of
// its values leaves the scan on the way out of the function.
@test
A_CALL_LAST_IN_A_SCAN_SEES_THE_SCANS_SUBJECT()
    val text = "def m( n ) = if n == 0 then tab(0) else 's' + n ? m(n - 1)\n" +
        "write( m(3) )\n" +
        "def k() = 'p' ? 'qr' ? tab(0)\n" +
        "'zz' ? write( k(), tab(0) )\n"

    assert_eq(ran_funl(text), "s1\nqr, zz\nsucceeded")

// `=s` is `tab(match(s))`: it moves past `s` and produces it, and failure passing back over it puts
// the position back.
@test
PREFIX_EQUALS_TABS_PAST_A_MATCHING_STRING()
    assert_eq(ran_funl("'hello world' ? (=\"hello\" & write(tab(0)))\n'hello' ? write(=\"he\", =\"llo\", pos(0))\n"),
        " world\nhe, llo, 6\nsucceeded")

@test
PREFIX_EQUALS_FAILS_WHEN_THE_SUBJECT_DOES_NOT_CONTINUE_WITH_IT()
    assert_eq(ran_funl("'hello' ? (if =\"help\" then write('yes') else write('no', pos(1)))\n'ab' ? (if =\"abc\" then write('yes') else write('short'))\n"),
        "no, 1\nshort\nsucceeded")

@test
PREFIX_EQUALS_IS_UNDONE_BY_BACKTRACKING()
    assert_eq(ran_funl("'abcd' ? ((=\"ab\" & =\"x\") | write(tab(0)))\n'abab' ? (=\"ab\" & =\"ab\" & write(pos(0)))\n"),
        "abcd\n5\nsucceeded")

@test
PREFIX_EQUALS_OUTSIDE_A_SCAN_IS_A_FAULT()
    faults_with("write(=\"a\")\n", "scan")

@test
PREFIX_EQUALS_WANTS_A_STRING()
    faults_with("'abc' ? write(=3)\n", "string")

// `bal` generates the balanced positions.
@test
BAL_SKIPS_NESTED_BRACKETS_AND_GENERATES_ITS_POSITIONS()
    assert_eq(ran_funl("every write(bal(',', undefined, undefined, 'a,(b,c),d'))\n"),
        "2\n8\nsucceeded")

@test
BAL_WITH_NO_ARGUMENTS_GENERATES_EVERY_POSITION_AT_DEPTH_ZERO()
    assert_eq(ran_funl("'x(y)z' ? every write(bal())\n"),
        "1\n2\n5\nsucceeded")

@test
BAL_DEFAULTS_TO_THE_SUBJECT_AND_THE_SCAN_POSITION()
    assert_eq(ran_funl("'a,(b,c),d' ? (move(2) & every write(bal(',')))\n'f(x),y' ? write(tab(bal(',')))\n"),
        "8\nf(x)\nsucceeded")

@test
BAL_TAKES_OWN_BRACKETS_AND_A_RANGE()
    assert_eq(ran_funl("every write(bal(';', '[', ']', 'a[;]b;c', 1, 0))\nevery write(bal(';', '[', ']', 'a;b;c', 1, 3))\n"),
        "6\n2\nsucceeded")

@test
BAL_STOPS_AT_A_CLOSER_WITH_NO_OPENER()
    assert_eq(ran_funl("every write(bal(',', undefined, undefined, 'a),b,c'))\n"),
        "succeeded")

@test
BAL_FAILS_WHERE_NOTHING_IS_BALANCED_AND_OUTSIDE_A_SCAN()
    assert_eq(ran_funl("write(if bal(',', undefined, undefined, '(a,b)') then 'found' else 'none')\n"),
        "none\nsucceeded")
    faults_with("bal(',')\n", "scan")

@test
BAL_REFUSES_A_BAD_ARGUMENT()
    faults_with("bal(3, undefined, undefined, 'abc')\n", "cset")
    faults_with("bal(',', undefined, undefined, 5)\n", "string")

// -- word operators and `=` ------------------------------------------------------------------------------

// A word operator touching an `=` is an assigning form that does not exist, and is refused at compile
// time rather than read as the operator applied to the scan `=s`.
@test
A_WORD_OPERATOR_TOUCHING_AN_EQUALS_HAS_NO_ASSIGNING_FORM()
    val words = ["mod", "div", "and", "or", "in", "is", "to", "until"]

    for w in words
        val said = complaints(s"var x = 7\nx $w= 3\n")

        assert(said.starts_with(s"error 2:3 `$w` has no assigning form\n"), said)

// With a space before the `=` it is the operator applied to the scan `=s`, which stays legal.
@test
A_WORD_OPERATOR_BEFORE_A_SPACED_SCAN_IS_STILL_ACCEPTED()
    val words = ["mod", "div", "and", "or", "in", "to", "until"]

    for w in words
        assert_eq(complaints(s"def f(x, s) = x $w =s\n"), "")
