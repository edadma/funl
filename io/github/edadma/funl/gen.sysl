module io.github.edadma.funl

import sh.sysl.dal
import sh.sysl.dal.Number
import sysl.math.checked_add
import sysl.text.{from_utf8_unchecked, is_char_boundary}

// Generators, whose whole state is cells on the operand stack.
//
// **A cursor is immutable.** `GenNext` and `GenRange` never change a cursor a choice point has
// saved: they overwrite the stack's cells with the ADVANCED cursor, push the choice point -- which
// copies those cells -- and only then replace the cursor with the element. Resuming the choice point
// therefore puts the advanced cursor back and runs the same instruction on it, and a choice point
// restored twice would produce the same element twice rather than skipping one.
//
// **The last element leaves no choice point.** Where the advanced cursor is already exhausted there
// is nothing to resume, so the element is produced as an ordinary value; a generator whose every
// element has been produced has left nothing on the control stack.
//
// The cursor of `!c` is two cells: what is left of the collection, and a position in it. A list's
// position stays 0 and its cell moves down the list; a tuple's, a set's, an array's, a buffer's, a
// byte string's and a map's position is an index, a string's a byte offset and a range's its next element, the collection
// itself staying put. A map produces its entries as pairs `(key, value)`.

// `GenStart`: the collection on top becomes its first cursor. Under `draw` (a binding `p <- e`) any
// other value is drawn as it is, the cursor of a one-element list of it.
gen_start(v: *Vm, draw: bool) -> Result[unit, Fault]
    val top = v.stack.len()

    if top == 0 then return Err(Broken("the operand stack is empty"))

    var c = deref(v.stack.at(top - 1))

    var first: long = 0

    c match
        Nil -> ()
        Cons(_) -> ()
        Tuple(_) -> ()
        Unit -> ()
        Str(_) -> ()
        Bytes(_) -> ()
        Set(_) -> ()
        MutSet(_) -> ()
        Array(_) -> ()
        Buffer(_) -> ()
        Map(_) -> ()
        MutMap(_) -> ()
        Range(r) -> first = r.from
        Var(_) ->
            val what = if draw then "`<-`" else "`!`"

            return Err(instantiation_error(s"instantiation error: $what was given an unbound variable"))
        _ ->
            if draw
                c = new_cons(c, Nil)?
                v.stack.set(top - 1, c)
                v.stack.push(Int(0))
                return Ok(())

            val msg = s"`!` generates the elements of a list, a range, a tuple, a set, an array, a buffer, a map, a string or a byte string, and was given ${described(c)}"

            return Err(type_error("collection", c, msg))

    v.stack.set(top - 1, c)
    v.stack.push(Int(first))
    Ok(())

// `GenNext`: the next element of the cursor on top, or failure when there is none.
gen_next(v: *Vm) -> Result[bool, Fault]
    val top = v.stack.len()

    if top < 2 then return Err(Broken("a cursor is two cells and the operand stack holds fewer"))

    val at = v.stack.at(top - 1) match
        Int(n) -> n
        _ -> return Err(Broken("a cursor's position is not an integer"))

    // The element, and the cursor after it -- `rest` at `next` -- with whether that one is spent.
    var elem = Undefined
    var rest = Undefined
    var next: long = 0
    var spent = false

    deref(v.stack.at(top - 2)) match
        Nil | Unit ->
            v.stack.truncate(top - 2)
            return Ok(false)
        Cons(p) ->
            elem = p.head
            rest = deref(p.tail)
            spent = rest match
                Nil -> true
                _ -> false
        Tuple(t) ->
            val n = long(t.items.len())

            if at >= n
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = t.items.at(usize(at))
            rest = v.stack.at(top - 2)
            next = at + 1
            spent = next == n
        Set(s) ->
            val n = long(s.items.len())

            if at >= n
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = s.items.at(usize(at))
            rest = v.stack.at(top - 2)
            next = at + 1
            spent = next == n
        MutSet(s) ->
            // Its size read afresh at every step, as a buffer's is, since either can change in place.
            if at >= long(s.items.len())
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = s.items.at(usize(at))
            rest = v.stack.at(top - 2)
            next = at + 1
            spent = next >= long(s.items.len())
        Array(a) ->
            if at >= long(a.items.len())
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = a.items.at(usize(at))
            rest = v.stack.at(top - 2)
            next = at + 1
            spent = next >= long(a.items.len())
        Buffer(a) ->
            if at >= long(a.items.len())
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = a.items.at(usize(at))
            rest = v.stack.at(top - 2)
            next = at + 1
            spent = next >= long(a.items.len())
        Map(m) ->
            if at >= long(m.keys.len())
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = entry(m, usize(at))?
            rest = v.stack.at(top - 2)
            next = at + 1
            spent = next >= long(m.keys.len())
        MutMap(m) ->
            if at >= long(m.keys.len())
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = entry(m, usize(at))?
            rest = v.stack.at(top - 2)
            next = at + 1
            spent = next >= long(m.keys.len())
        Range(r) ->
            if range_past(r, at)
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = Int(at)
            rest = v.stack.at(top - 2)

            checked_add(at, r.step) match
                Some(k) ->
                    next = k
                    spent = range_past(r, k)
                None -> spent = true
        Str(p) ->
            val bytes = p.s.bytes
            val n = bytes.len

            if usize(at) >= n
                v.stack.truncate(top - 2)
                return Ok(false)

            var end = usize(at) + 1

            while end < n && !is_char_boundary(bytes[end])
                end += 1

            elem = new_str(from_utf8_unchecked(bytes[usize(at)..<end]))?
            rest = v.stack.at(top - 2)
            next = long(end)
            spent = end == n
        Bytes(p) ->
            val n = long(p.b.len())

            if at >= n
                v.stack.truncate(top - 2)
                return Ok(false)

            elem = Int(long(p.b.at(usize(at))))
            rest = v.stack.at(top - 2)
            next = at + 1
            spent = next == n
        Var(_) -> return Err(instantiation_error("instantiation error: `!` reached an unbound tail of a list"))
        x -> return Err(type_error("list", x, s"`!` reached the end of a list that ends in ${described(x)} rather than `[]`"))

    if !spent
        v.stack.set(top - 2, rest)
        v.stack.set(top - 1, Int(next))
        push_choice(v, v.ip - 1)

    v.stack.truncate(top - 2)
    v.stack.push(elem)
    Ok(true)
end gen_next

// `GenRange`: the next number of `i to j by k` (`inclusive`) or `i until j by k`, or failure once
// the range is spent. The cursor is the four cells on top: the start `i`, the end `j`, the step `k`
// and a count `n`, and the value it stands for is `i + n*k`.
//
// **A range counts over the whole numeric tower.** The `n`-th value is the start plus `n` times
// the step, by `+`'s and `*`'s own arithmetic, so integers and rationals count exactly and a real
// value is rounded once rather than accumulating the rounding of every step before it. Where the
// step is a real the start is made a real too, so every value of the range is one kind. The range
// stops at the first value that compares past `j` -- by `>` (`>=` for `until`) going up and `<`
// (`<=`) going down, with no tolerance -- and a NaN anywhere ends it at once. Four 64-bit integers
// take the fast path below without entering the tower; there addition is exact, so the start
// itself moves on by the step and the count stays 0.
gen_range(v: *Vm, inclusive: bool) -> Result[bool, Fault]
    val top = v.stack.len()

    if top < 4 then return Err(Broken("a range's cursor is four cells and the operand stack holds fewer"))

    val word = if inclusive then "to" else "until"
    val c = bound(v.stack.at(top - 4), word)?
    val l = bound(v.stack.at(top - 3), word)?
    val s = bound(v.stack.at(top - 2), word)?
    val n = v.stack.at(top - 1) match
        Int(k) -> k
        _ -> return Err(Broken("a range's count is not an integer"))

    (c, l, s) match
        (Int(i), Int(j), Int(k)) -> return int_range(v, top, word, i, j, k, inclusive)
        _ -> ()

    num_range(v, top, word, c, l, s, n, inclusive)
end gen_range

// A range whose start, end and step are all 64-bit integers.
private int_range(v: *Vm, top: usize, word: string, cur: long, last: long, step: long, inclusive: bool) -> Result[bool, Fault]
    if step == 0
        return Err(domain_error("non_zero", Int(0), s"`$word ... by 0` would produce $cur for ever: a step cannot be zero"))

    if past(cur, last, step, inclusive)
        v.stack.truncate(top - 4)
        return Ok(false)

    checked_add(cur, step) match
        Some(next) ->
            if !past(next, last, step, inclusive)
                v.stack.set(top - 4, Int(next))
                v.stack.set(top - 3, Int(last))
                v.stack.set(top - 2, Int(step))
                v.stack.set(top - 1, Int(0))
                push_choice(v, v.ip - 1)
        None -> ()

    v.stack.truncate(top - 4)
    v.stack.push(Int(cur))
    Ok(true)
end int_range

// A range over numbers of any kind: an integer past 64 bits, a rational, a real, or a mix. `c` is
// the start and `n` the count of values already produced.
private num_range(v: *Vm, top: usize, word: string, c: Value, last: Value, step: Value, n: long, inclusive: bool) -> Result[bool, Fault]
    val p = funl_policy()
    val s = num_of(step).unwrap()
    val l = num_of(last).unwrap()

    // A real step makes the start a real, so that `0 to 1 by 0.5` is three reals.
    val start = (c, step) match
        (Real(_), _) -> c
        (_, Real(_)) -> num_answer(p.add(num_of(c).unwrap(), Number.Real(0.0)), "+", c, step)?
        _ -> c

    dal.compare(s, Number.Int(0)) match
        Some(0) -> return Err(domain_error("non_zero", step, s"`$word ... by ${render(step)}` would produce ${render(start)} for ever: a step cannot be zero"))
        None ->
            v.stack.truncate(top - 4)
            return Ok(false)
        _ -> ()

    val cur = nth_value(start, step, n)?

    if num_past(num_of(cur).unwrap(), l, s, inclusive)
        v.stack.truncate(top - 4)
        return Ok(false)

    val next = nth_value(start, step, n + 1)?

    if !num_past(num_of(next).unwrap(), l, s, inclusive)
        v.stack.set(top - 4, c)
        v.stack.set(top - 3, last)
        v.stack.set(top - 2, step)
        v.stack.set(top - 1, Int(n + 1))
        push_choice(v, v.ip - 1)

    v.stack.truncate(top - 4)
    v.stack.push(cur)
    Ok(true)
end num_range

// The `n`-th value of a range from `start` by `step`: `start` itself, then `start + n*step`, each
// by the arithmetic `+` and `*` use, so a real value carries a single multiplication's and a
// single addition's rounding however far along the range it is.
private nth_value(start: Value, step: Value, n: long) -> Result[Value, Fault]
    if n == 0 then return Ok(start)

    val p = funl_policy()
    val times = num_answer(p.mul(Number.Int(n), num_of(step).unwrap()), "*", Int(n), step)?

    num_answer(p.add(num_of(start).unwrap(), num_of(times).unwrap()), "+", start, times)

// Entry `i` of a map as `!` produces it: the pair `(key, value)`.
private entry(m: *MapObj, i: usize) -> Result[Value, string]
    val t = new_tuple(2)?

    t.items.set(0, m.keys.at(i))
    t.items.set(1, m.vals.at(i))
    Ok(Tuple(t))

// A range's start, end or step, which must be a number.
private bound(x: Value, word: string) -> Result[Value, Fault]
    val y = deref(x)

    if is_num(y) then return Ok(y)

    y match
        Var(_) -> Err(instantiation_error(s"instantiation error: `$word` was given an unbound variable"))
        _ -> Err(type_error("number", y, s"`$word` counts with numbers and was given ${described(y)}"))

// Whether `n` is beyond where a range stepping by `step` towards `last` stops.
private past(n: long, last: long, step: long, inclusive: bool) -> bool
    if step > 0 then return if inclusive then n > last else n >= last

    if inclusive then n < last else n <= last

// `past` over the tower. A value that compares with nothing, a NaN, is past every end.
private num_past(n: Number, last: Number, step: Number, inclusive: bool) -> bool
    val c = dal.compare(n, last) match
        Some(k) -> k
        None -> return true

    if dal.sign(step) > 0 then return if inclusive then c > 0 else c >= 0

    if inclusive then c < 0 else c <= 0

// `ChangeMark(to)`, ending a round of `|e` that produced a value.
//
// The round's mark becomes one that restarts `e` at `to` when failure reaches it, and stops being
// the innermost: what follows `|e` belongs to the enclosing bounded expression. **And a `Restore` is
// pushed**, for the reason a generating call's return pushes one: the code after `|e` pops cells
// below the round's mark while `e`'s choice points are still resumable, so backtracking has to put
// the enclosing expression's cells back before it resumes inside `e`.
change_mark(v: *Vm, to: usize) -> Result[unit, string]
    if v.mark == NoMark then return Err("ChangeMark with no mark open")

    val at = v.mark
    val m = v.control.at(at)

    v.control.set(at, Entry(Mark, to, m.code, m.frame, m.mark, m.floor, m.saved_at, m.trail, m.stamp))
    v.mark = m.mark
    push_entry(v, Restore, 0, floor_of(v, v.mark))
    Ok(())
