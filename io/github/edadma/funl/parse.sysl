module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The parser: the token cursor, the report, and the forms that are not expressions -- statements,
// `free`, and definitions with their clauses.
//
// **A parse error is a node and a diagnostic**, never a stop: the statement it is in is skipped to
// the end of its line and parsing goes on, so one pass reports every mistake in a file.

struct Parser
    toks: Tokens[Tok]
    report: *Report
    src: Source

    // How deeply expressions are nested, which `parse_expr` bounds.
    depth: usize

    // How many lambdas have been read: the next one's id.
    lambdas: usize

    // How many blocks and loops have been read: the next one's id.
    nodes: usize

    // A fresh lambda id.
    lambda_id(*self) -> usize
        self.lambdas += 1
        self.lambdas - 1

    // A fresh id for a block or a loop.
    node_id(*self) -> usize
        self.nodes += 1
        self.nodes - 1

    // **Not `private`: the expression callbacks in `parse_expr.sysl` use these.**

    // The token at the cursor, if any.
    peek_tok(self) -> Option[Tok] = self.toks.peek() match
        Some(t) -> Some(t.value)
        None -> None

    // Whether the token at the cursor is of `k`'s kind; payloads are not compared.
    at_tok(self, k: Tok) -> bool = self.peek_tok() match
        Some(t) -> tag(t) == tag(k)
        None -> false

    // Whether the token after the cursor is of `k`'s kind.
    next_is(self, k: Tok) -> bool = self.toks.peek_at(1) match
        Some(t) -> tag(t.value) == tag(k)
        None -> false

    // Take the token at the cursor if it is of `k`'s kind.
    accept(*self, k: Tok) -> bool
        if !self.at_tok(k) then return false

        self.toks.advance()
        true

    // Take a `k`, or say that `what` was wanted here.
    expect(*self, k: Tok, what: string) -> bool
        if self.accept(k) then return true

        self.fail_here(what)
        false

    // Say that `what` was wanted where the cursor is -- unless something was already said about
    // that place, by the lexer or by a construct inside this one: that is the same mistake again.
    fail_here(*self, what: string)
        val sp = self.toks.here()

        for i in 0..<self.report.len()
            if self.report.at(i).span.start == sp.start then return

        val found = self.peek_tok() match
            Some(t) -> describe(t)
            None -> "the end of the input"

        self.report.add(expected(sp, what, found))

    // Step over the rest of a statement: up to the `Newline` that ends it, or the `Dedent` that
    // closes the block it is in, stepping over any block it opened.
    skip_line(*self)
        var depth: usize = 0

        loop
            val t = self.peek_tok() match
                Some(t) -> t
                None -> return

            t match
                Newline -> if depth == 0 then return
                Indent -> depth += 1
                Dedent ->
                    if depth == 0 then return

                    depth -= 1
                _ -> ()

            self.toks.advance()
    end skip_line

    // Step over the rest of a bracketed list through its `)`, or to the end of the statement when
    // the `)` never comes.
    skip_to_close(*self)
        var depth: usize = 0

        loop
            val t = self.peek_tok() match
                Some(t) -> t
                None -> return

            t match
                LParen -> depth += 1
                RParen ->
                    self.toks.advance()

                    if depth == 0 then return

                    depth -= 1
                    continue
                Newline -> return
                Indent -> return
                Dedent -> return
                _ -> ()

            self.toks.advance()
    end skip_to_close
end Parser

impl TokenStream for Parser
    type Token = Spanned[Tok]

    look(self) -> Option[Spanned[Tok]] = self.toks.peek()
    take(*self) -> Option[Spanned[Tok]] = self.toks.advance()

// A token's kind as a number, for comparing kinds whatever the payload.
tag(t: Tok) -> u8
    t match
        Name(_) -> 0
        AtomLit(_) -> 1
        IntLit(_) -> 2
        StrLit(_) -> 3
        Def -> 4
        Free -> 5
        Every -> 6
        Do -> 7
        If -> 8
        Then -> 9
        Else -> 10
        Not -> 11
        And -> 12
        Or -> 13
        LParen -> 14
        RParen -> 15
        Comma -> 16
        Amp -> 17
        Bar -> 18
        Tilde -> 19
        EqEq -> 20
        BangEq -> 21
        Equals -> 22
        Turnstile -> 23
        Newline -> 24
        Indent -> 25
        Dedent -> 26
        Elif -> 27
        Val -> 28
        Where -> 29
        ReturnW -> 30
        FailW -> 31
        TrueW -> 32
        FalseW -> 33
        Otherwise -> 34
        Mod -> 35
        Div -> 36
        Arrow -> 37
        At -> 38
        Plus -> 39
        Minus -> 40
        Star -> 41
        Slash -> 42
        Backslash -> 43
        Percent -> 44
        Caret -> 45
        Less -> 46
        LessEq -> 47
        Greater -> 48
        GreaterEq -> 49
        To -> 50
        Until -> 51
        By -> 52
        YieldW -> 53
        LBracket -> 54
        RBracket -> 55
        Bang -> 56
        VarW -> 57
        While -> 58
        Repeat -> 59
        For -> 60
        Break -> 61
        Continue -> 62
        Semi -> 63
        Colon -> 64
        LeftArrow -> 65
        DotDot -> 66
        DotDotLess -> 67
        OpEq(_) -> 68
        PlusPlus -> 69
        MinusMinus -> 70
        LBrace -> 71
        RBrace -> 72
        Dot -> 73
        In -> 74
        NotIn -> 75
        InterpLit -> 76
        DataW -> 77
        UndefinedW -> 78
        Question -> 79
        QuestionEq -> 80
        RegexLit(_) -> 81
        DotDotPlus -> 82
        SlashSlash -> 83
        NumLit(_) -> 84
        Is -> 85
        CatchW -> 86
end tag

// The program in `src`, with every complaint about its syntax added to `report`.
parse(src: Source, report: *Report) -> Program
    var p = Parser(lex(src, report), report, src, 0, 0, 0)
    var clauses: Buf[Clause] = buf()
    var stmts: Buf[Stmt] = buf()
    var imports: Buf[ImportDecl] = buf()
    var exports: Buf[Spanned[string]] = buf()

    loop
        while p.accept(Newline)
            ()

        if p.peek_tok().is_none() then break

        if p.at_tok(Indent)
            p.report.add(error(p.toks.here(), "this line is indented, and nothing above it opens a block")
                .with_note("a block opens under a line ending in `then`, `else`, `do`, `:-` or `=`, or under a bare `def`"))
            p.take()
            p.skip_line()
            p.accept(Dedent)
            continue

        if p.at_tok(Dedent)
            p.take()
            continue

        if p.accept(Def)
            definition(&p, &clauses)
        elif at_export(&p)
            exported(&p, &clauses, &stmts, &exports)
        elif at_import(&p)
            import_line(&p, &imports)
        else
            stmts.push(statement(&p))

        // An indented line under the statement is refused at the top of the loop.
        if p.at_tok(Newline) || p.at_tok(Indent) || p.peek_tok().is_none() then continue

        p.fail_here("the end of the line")
        p.skip_line()
    end loop

    Program(clauses, stmts, imports, exports)
end parse

// Whether the token `k` places past the cursor is the name `word`.
private word_at(p: *Parser, k: usize, word: string) -> bool = p.toks.peek_at(k) match
    Some(t) -> t.value match
        Name(n) -> n == word
        _ -> false
    None -> false

// An `import` line at the top level: the word is a keyword only there, and only before a string, a
// `{` or a `*`, so `import` stays a name a program may use for anything else.
private at_import(p: *Parser) -> bool
    if !word_at(p, 0, "import") then return false

    p.toks.peek_at(1) match
        Some(t) -> t.value match
            StrLit(_) -> true
            LBrace -> true
            Star -> true
            _ -> false
        None -> false

// `export` before a `def`, a `val`, a `var` or a `data` at the top level: like `import`, a keyword
// only there.
private at_export(p: *Parser) -> bool
    if !word_at(p, 0, "export") then return false

    p.toks.peek_at(1) match
        Some(t) -> t.value match
            Def -> true
            Val -> true
            VarW -> true
            DataW -> true
            _ -> false
        None -> false

// `export def ...`, `export val ...`, `export var ...`, `export data ...`: the definition or the
// statement, read as it would be without the word, and the names it declares added to `exports`. A
// `def` block under `export def` exports every definition in it.
private exported(p: *Parser, clauses: *Buf[Clause], stmts: *Buf[Stmt], exports: *Buf[Spanned[string]])
    p.take()

    if p.accept(Def)
        val before = clauses.len()

        definition(p, clauses)

        for i in before..<clauses.len()
            val c = clauses.at(i)

            exports.push(Spanned(c.name, c.head))

        return

    val s = statement(p)

    s match
        ValS(pat, _, _) -> pattern_names(pat, exports)
        VarS(n, at, _) -> exports.push(Spanned(n, at))
        DataS(ctors, typ) ->
            if typ != "" && ctors.len() > 0 then exports.push(Spanned(typ, ctors.at(0).at))

            for c in ctors.view()
                exports.push(Spanned(c.name, c.at))
        _ -> ()

    stmts.push(s)
end exported

// The names a `val` pattern declares.
private pattern_names(pat: &Expr, out: *Buf[Spanned[string]])
    pat.kind match
        Ref(n) -> out.push(Spanned(n, pat.span))
        AsE(n, x) ->
            out.push(Spanned(n, pat.span))
            pattern_names(x, out)
        TupleE(items) ->
            for x in items.view()
                pattern_names(x, out)
        ListE(items) ->
            for x in items.view()
                pattern_names(x, out)
        CallE(_, _, args) ->
            for x in args.view()
                pattern_names(x, out)
        ConsE(h, t) ->
            pattern_names(h, out)
            pattern_names(t, out)
        _ -> ()

// `import "file"`, `import { a, b as c } from spec` or `import * as m from spec`, the cursor on
// `import`.
private import_line(p: *Parser, imports: *Buf[ImportDecl])
    p.take()

    val first = p.toks.peek().unwrap()

    first.value match
        StrLit(s) ->
            p.take()
            imports.push(ImportDecl(PathSpec(s), first.span, WholeForm))
            return
        _ -> ()

    var form = WholeForm

    if p.accept(Star)
        if !word_at(p, 0, "as")
            p.fail_here("`as` and the name the module is known by")
            return

        p.take()

        val alias = p.toks.peek() match
            Some(t) -> t
            None ->
                p.fail_here("the name the module is known by")
                return

        alias.value match
            Name(n) ->
                p.take()
                form = StarForm(Spanned(n, alias.span))
            _ ->
                p.fail_here("the name the module is known by")
                return
    else
        p.take()

        var names: Buf[ImportName] = buf()

        loop
            if p.at_tok(RBrace) then break

            val t = p.toks.peek() match
                Some(t) -> t
                None ->
                    p.fail_here("a name to import")
                    return

            val n = t.value match
                Name(n) -> n
                _ ->
                    p.fail_here("a name to import")
                    return

            p.take()

            var local = n
            var at = t.span

            if word_at(p, 0, "as")
                p.take()

                val l = p.toks.peek() match
                    Some(l) -> l
                    None ->
                        p.fail_here("the name it is known by here")
                        return

                l.value match
                    Name(m) ->
                        p.take()
                        local = m
                        at = t.span.to(l.span)
                    _ ->
                        p.fail_here("the name it is known by here")
                        return

            names.push(ImportName(n, local, at))

            if !p.accept(Comma) then break

        if !p.expect(RBrace, "`}`") then return

        form = NamedForm(names)

    if !word_at(p, 0, "from")
        p.fail_here("`from` and the module to import from")
        return

    p.take()

    val s = p.toks.peek() match
        Some(s) -> s
        None ->
            p.fail_here("the module to import from")
            return

    s.value match
        StrLit(path) ->
            p.take()
            imports.push(ImportDecl(PathSpec(path), s.span, form))
        Name(n) ->
            p.take()

            if n == "funl" && p.at_tok(Colon)
                p.take()

                val m = p.toks.peek() match
                    Some(m) -> m
                    None ->
                        p.fail_here("the name of one of FunL's modules")
                        return

                m.value match
                    Name(name) ->
                        p.take()
                        imports.push(ImportDecl(BuiltinSpec(name), s.span.to(m.span), form))
                    _ -> p.fail_here("the name of one of FunL's modules")

                return

            // A dotted bare word is still a package name, and is refused as one: a file is quoted.
            var name = n
            var at = s.span

            while p.at_tok(Dot)
                p.take()

                val part = p.toks.peek() match
                    Some(t) -> t
                    None -> break

                part.value match
                    Name(w) ->
                        p.take()
                        name = s"$name.$w"
                        at = at.to(part.span)
                    _ -> break

            imports.push(ImportDecl(PackageSpec(name), at, form))
        _ -> p.fail_here("the module to import from: a quoted path, a package name, or `funl:name`")
end import_line

// One statement: `free names`, `def`, `val pattern = e`, `var name [= e]`, an assignment --
// `name = e`, `name op= e`, `name <- e`, `\name = e`, `/name = e`, `a, b = e1, e2` -- `pattern = e`,
// or an expression.
statement(p: *Parser) -> Stmt
    if p.accept(Def)
        var clauses: Buf[Clause] = buf()

        definition(p, &clauses)
        return DefS(clauses)

    if p.accept(Val)
        val pat = parse_expr(p, 0)

        if !p.expect(Equals, "`=`") then return ValS(pat, expr(BadE, pat.span), true)

        return ValS(pat, body_expr(p), true)

    if p.accept(VarW) then return var_statement(p)

    if p.accept(DataW) then return data_declaration(p)

    if !p.accept(Free)
        val e = parse_expr(p, 0)

        if p.at_tok(Comma) then return ExprS(multiple_assignment(p, e))

        compound_assign(p, e) match
            Some(c) -> return ExprS(c)
            None -> ()

        if p.at_tok(LeftArrow) then return ExprS(reversible(p, e))

        if !p.accept(Equals) then return ExprS(e)

        val value = body_expr(p)

        // `name(k) = e` is left a pattern here, being one when `name` is a constructor: the resolver
        // makes it a write into an element when `name` is a variable.
        e.kind match
            Ref(n) -> return ExprS(expr(AssignE(n, value), e.span.to(value.span)))
            DefinedE(_, _) -> return ExprS(guarded_assign(p, e, value))
            CallE(_, _, _) -> return ValS(e, value, false)
            _ ->
                element_target(e, value, false, e.span.to(value.span)) match
                    Some(x) -> return ExprS(x)
                    None -> return ValS(e, value, false)

    var names: Buf[Spanned[string]] = buf()

    loop
        p.toks.peek() match
            Some(t) ->
                t.value match
                    Name(n) ->
                        p.take()
                        names.push(Spanned(n, t.span))
                    _ ->
                        p.fail_here("a name to declare")
                        break
            None ->
                p.fail_here("a name to declare")
                break

        if !p.accept(Comma) then break

    FreeS(names)
end statement

// `var name [= e]`, the `var` already read.
private var_statement(p: *Parser) -> Stmt
    val t = p.toks.peek() match
        Some(t) -> t
        None ->
            p.fail_here("a name to declare")
            return ExprS(expr(BadE, p.toks.here()))

    val n = t.value match
        Name(n) -> n
        _ ->
            p.fail_here("a name to declare")
            return ExprS(expr(BadE, t.span))

    p.take()

    if !p.accept(Equals) then return VarS(n, t.span, None)

    VarS(n, t.span, Some(body_expr(p)))

// `a, b = e1, e2`, the first target read and a `,` next.
private multiple_assignment(p: *Parser, first: &Expr) -> &Expr
    var targets: Buf[Spanned[string]] = buf()
    var bad = !target_name(p, first, &targets)
    var count: usize = 1

    while p.accept(Comma)
        count += 1

        if !target_name(p, parse_expr(p, 0), &targets) then bad = true

    if !p.expect(Equals, "`=`") then return expr(BadE, first.span.to(p.toks.previous()))

    var values: Buf[&Expr] = buf()

    loop
        values.push(parse_expr(p, 0))

        if !p.accept(Comma) then break

    val at = first.span.to(p.toks.previous())

    if values.len() != count
        p.report.add(error(at, s"this assigns ${counted(count, "variable")} and gives ${counted(values.len(), "value")}")
            .with_note("`a, b = b, a` takes one value for each name"))
        bad = true

    if bad then expr(BadE, at) else expr(MultiAssignE(targets, values), at)
end multiple_assignment

// One target of a multiple assignment, which is a name; false, with the refusal reported, for
// anything else.
private target_name(p: *Parser, e: &Expr, out: *Buf[Spanned[string]]) -> bool
    e.kind match
        Ref(n) ->
            out.push(Spanned(n, e.span))
            true
        BadE -> false
        _ ->
            p.report.add(error(e.span, "a multiple assignment assigns names, and this is not one"))
            false

