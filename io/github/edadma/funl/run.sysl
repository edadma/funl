module io.github.edadma.funl

import sysl.buf.Buf

// The instruction loop.
//
// **There is no host recursion anywhere in it.** A call moves `ip` into a new heap frame, a
// resumption is `fail` restoring an entry, and nothing is ever suspended on the sysl stack -- which
// is what lets every suspended computation be data the collector sees.

enum Outcome
    // The run reached `Halt`.
    Succeeded

    // Failure emptied the control stack: nothing was left to resume.
    Failed

    // An instruction could not be carried out; the message says which and why.
    Faulted(msg: string)

private enum Flow
    Next
    Fails
    Halts

// Run chunk `chunk` as the top level, from its first instruction.
run(v: *Vm, chunk: usize) -> Outcome
    if chunk >= v.chunks.len() then return Faulted(s"there is no chunk $chunk to run")

    v.frame = new_frame(chunk) match
        Ok(f) -> f
        Err(e) -> return Faulted(e)

    v.globals = v.frame
    v.code = chunk
    v.ip = 0
    v.mark = NoMark

    loop
        maybe_collect(v)

        val at = v.ip
        val code = v.chunks.at(v.code).code

        if at >= code.len() then return Faulted(s"ran off the end of chunk '${v.chunks.at(v.code).name}'")

        v.ip = at + 1

        execute(v, code.at(at)) match
            Ok(Next) -> ()
            Ok(Fails) -> if !fail(v) then return Failed
            Ok(Halts) -> return Succeeded
            Err(e) -> return Faulted(s"${v.chunks.at(v.code).name}@$at: $e")
end run

private fails_if(ok: bool) -> Flow = if ok then Next else Fails

private pop(v: *Vm) -> Result[Value, string] = v.stack.pop() match
    Some(x) -> Ok(x)
    None -> Err("the operand stack is empty")

// Pop `n` values into a compound's arguments, the deepest first.
private pop_into(v: *Vm, c: *CompoundObj, n: usize) -> Result[unit, string]
    val top = v.stack.len()

    if n > top then return Err(s"wants $n operands and the stack holds $top")

    for i in 0..<n
        c.args.set(i, v.stack.at(top - n + i))

    v.stack.truncate(top - n)
    Ok(())

private execute(v: *Vm, op: Op) -> Result[Flow, string]
    op match
        Halt -> Ok(Halts)
        Mark(to) ->
            push_mark(v, Mark, to)
            Ok(Next)
        MarkThrough ->
            push_mark(v, MarkThrough, 0)
            Ok(Next)
        Choice(to) ->
            push_choice(v, to)
            Ok(Next)
        Unmark ->
            unmark(v)?
            Ok(Next)
        UnmarkKeep ->
            val x = pop(v)?

            unmark(v)?
            v.stack.push(x)
            Ok(Next)
        Fail -> Ok(Fails)
        Branch(to) ->
            v.ip = to
            Ok(Next)
        SaveMark(slot) ->
            set_slot(v.frame, slot, Int(long(v.mark)))?
            Ok(Next)
        UnmarkTo(slot) ->
            unmark_to(v, slot_of(v.frame, slot)?)?
            Ok(Next)
        Pop ->
            pop(v)?
            Ok(Next)
        PushConst(k) ->
            val consts = v.chunks.at(v.code).consts

            if k >= consts.len() then return Err(s"constant $k of a chunk with ${consts.len()}")

            v.stack.push(consts.at(k))
            Ok(Next)
        PushNil ->
            v.stack.push(Nil)
            Ok(Next)
        PushInt(n) ->
            v.stack.push(Int(n))
            Ok(Next)
        LoadSlot(depth, slot) ->
            v.stack.push(slot_of(frame_up(v, depth)?, slot)?)
            Ok(Next)
        NewVar(slot) ->
            set_slot(v.frame, slot, Var(new_var()?))?
            Ok(Next)
        PushVar ->
            v.stack.push(Var(new_var()?))
            Ok(Next)
        MakeCompound(functor, n) ->
            val c = new_compound(functor, n)?

            pop_into(v, c, n)?
            v.stack.push(Compound(c))
            Ok(Next)
        MakeCons ->
            val tail = pop(v)?
            val head = pop(v)?

            v.stack.push(new_cons(head, cons_tail(tail)?)?)
            Ok(Next)
        Unify ->
            val b = pop(v)?
            val a = pop(v)?

            if !unify(a, b) then return Ok(Fails)

            v.stack.push(b)
            Ok(Next)
        TestEq -> compare(v, true, "==")
        TestNe -> compare(v, false, "!=")
        Frame(n) ->
            size_frame(v, n)?
            Ok(Next)
        Call(target, argc) ->
            call(v, target, argc)?
            Ok(Next)
        TailCall(target, argc) ->
            tail_call(v, target, argc)?
            Ok(Next)
        Return ->
            ret(v)?
            Ok(Next)
        ReturnCommit ->
            ret_commit(v)?
            Ok(Next)
        Native(id, argc) ->
            call_native(v, id, argc)?
            Ok(Next)
        GetVar(slot, src) -> Ok(fails_if(get_var(v, slot, src)?))
        GetValue(slot, src) -> Ok(fails_if(get_value(v, slot, src)?))
        GetConst(k, src) -> Ok(fails_if(get_const(v, k, src)?))
        GetCompound(functor, n, src) -> Ok(fails_if(get_compound(v, functor, n, src)?))
        PushUnit ->
            v.stack.push(Unit)
            Ok(Next)
        MakeTuple(n) ->
            val t = new_tuple(n)?
            val top = v.stack.len()

            if n > top then return Err(s"wants $n operands and the stack holds $top")

            for i in 0..<n
                t.items.set(i, v.stack.at(top - n + i))

            v.stack.truncate(top - n)
            v.stack.push(Tuple(t))
            Ok(Next)
        Arith(o) ->
            val b = pop(v)?
            val a = pop(v)?

            arith(o, a, b)? match
                Some(x) ->
                    v.stack.push(x)
                    Ok(Next)
                None -> Ok(Fails)
        Negate ->
            val a = pop(v)?

            v.stack.push(negate(a)?)
            Ok(Next)
        FailIfFalse ->
            val top = v.stack.len()

            if top == 0 then return Err("the operand stack is empty")

            deref(v.stack.at(top - 1)) match
                Bool(b) -> Ok(fails_if(b))
                _ -> Ok(Next)
        Dup ->
            val top = v.stack.len()

            if top == 0 then return Err("the operand stack is empty")

            v.stack.push(v.stack.at(top - 1))
            Ok(Next)
        LoadArg(i) ->
            val args = v.frame.args

            if i >= args.len() then return Err(s"argument $i of a call that passed ${args.len()}")

            v.stack.push(args.at(i))
            Ok(Next)
        StoreSlot(slot) ->
            val x = pop(v)?

            set_slot(v.frame, slot, x)?
            Ok(Next)
        MakeClosure(target, up) ->
            make_closure(v, target, up)?
            Ok(Next)
        CallFn(target, argc, up) ->
            call_fn(v, target, argc, up)?
            Ok(Next)
        TailCallFn(target, argc, up) ->
            tail_call_fn(v, target, argc, up)?
            Ok(Next)
        CallValue(argc) ->
            call_value(v, argc, false)?
            Ok(Next)
        TailCallValue(argc) ->
            call_value(v, argc, true)?
            Ok(Next)
        MatchTuple(n) ->
            deref(pop(v)?) match
                Tuple(t) ->
                    if t.items.len() != n then return Ok(Fails)

                    push_parts(v, t.items)
                    Ok(Next)
                Var(_) -> Err("instantiation error: a tuple pattern was given an unbound variable")
                _ -> Ok(Fails)
        MatchCompound(functor, n) ->
            deref(pop(v)?) match
                Compound(c) ->
                    if c.functor != functor || c.args.len() != n then return Ok(Fails)

                    push_parts(v, c.args)
                    Ok(Next)
                Var(_) -> Err(s"instantiation error: a pattern '${atom_name(functor)}(...)' was given an unbound variable")
                _ -> Ok(Fails)
        NoMatch ->
            no_match(v)?
            Ok(Next)
        StoreUp(depth, slot) ->
            val x = pop(v)?

            set_slot(frame_up(v, depth)?, slot, x)?
            Ok(Next)
        Update(depth, slot, o) ->
            val b = pop(v)?
            val f = frame_up(v, depth)?
            val held = slot_of(f, slot)?

            // `+=` onto a buffer adds to it in place, the variable still holding the same buffer.
            if o == Add && adds_in_place(held, b)
                v.stack.push(held)
                return Ok(Next)

            arith(o, held, b)? match
                Some(x) ->
                    set_slot(f, slot, x)?
                    v.stack.push(x)
                    Ok(Next)
                None -> Ok(Fails)
        GenStart ->
            gen_start(v)?
            Ok(Next)
        GenNext -> Ok(fails_if(gen_next(v)?))
        GenRange(inclusive) -> Ok(fails_if(gen_range(v, inclusive)?))
        ChangeMark(to) ->
            change_mark(v, to)?
            Ok(Next)
        MakeRange(inclusive, endless) ->
            make_range(v, inclusive, endless)?
            Ok(Next)
        MatchCons -> Ok(fails_if(match_cons(v)?))
        MatchNil -> Ok(fails_if(match_nil(v)?))
        Member(negated) ->
            val c = pop(v)?
            val x = pop(v)?

            if member(x, c)? == negated then return Ok(Fails)

            v.stack.push(x)
            Ok(Next)
        TestDefined(defined) ->
            val top = v.stack.len()

            if top == 0 then return Err("the operand stack is empty")

            val undefined = deref(v.stack.at(top - 1)) match
                Undefined -> true
                _ -> false

            Ok(fails_if(undefined != defined))
        Field(name) ->
            val x = pop(v)?

            v.stack.push(field_of(x, name)?)
            Ok(Next)
        StoreBack(depth, slot) ->
            val x = pop(v)?

            assign_reversibly(frame_up(v, depth)?, slot, x)?
            Ok(Next)
        Collect(slot) ->
            collect(v, slot)?
            Ok(Next)
        Collected(slot, set) ->
            collected(v, slot, set)?
            Ok(Next)
        MakeMap(n) ->
            make_map(v, n)?
            Ok(Next)
        MakeSet(n) ->
            make_set(v, n)?
            Ok(Next)
        MakeRecord(ctor, n) ->
            make_record(v, ctor, n)?
            Ok(Next)
        Index ->
            val key = pop(v)?
            val c = pop(v)?

            v.stack.push(element_get(c, key, true)?)
            Ok(Next)
        StoreElem(bracket, back) ->
            val x = pop(v)?
            val key = pop(v)?
            val c = pop(v)?

            element_set(c, key, bracket, x, back)?
            v.stack.push(x)
            Ok(Next)
        Append(depth, slot) ->
            val x = pop(v)?

            v.stack.push(append_to(slot_of(frame_up(v, depth)?, slot)?, x)?)
            Ok(Next)
        SwapElems(first, second) ->
            swap_elements(v, first, second)?
            Ok(Next)
        Concat(n) ->
            concat(v, n)?
            Ok(Next)
        NativeGen(id, argc) -> call_generator(v, id, argc)
        ScanBegin ->
            scan_begin(v)?
            Ok(Next)
        ScanEnd ->
            scan_end(v)?
            Ok(Next)
end execute

// Push a tuple's items or a term's arguments, the last first, so the first is on top for the
// pattern that matches it.
private push_parts(v: *Vm, parts: Buf[Value])
    var i = parts.len()

    while i > 0
        i -= 1
        v.stack.push(parts.at(i))

// `TestEq` and `TestNe`: pop `b` and `a`, and push `b` when their equality is `want`.
private compare(v: *Vm, want: bool, op: string) -> Result[Flow, string]
    val b = pop(v)?
    val a = pop(v)?

    if equal_values(a, b, op)? != want then return Ok(Fails)

    v.stack.push(b)
    Ok(Next)

// Run builtin `id` over the top `argc` values, which stand on the stack until it answers.
private call_native(v: *Vm, id: usize, argc: usize) -> Result[unit, string]
    if id >= v.natives.len() then return Err(s"builtin $id is not registered")

    val n = v.natives.at(id)
    val top = v.stack.len()

    if n.arity != Variadic && argc != n.arity then return Err(s"'${n.name}' takes ${n.arity} arguments and was given $argc")

    if argc > top then return Err(s"'${n.name}' wants $argc operands and the stack holds $top")

    val go = n.how match
        Plain(g) -> g
        Constant(g) -> g
        Generating(_) -> return Err(s"'${n.name}' may fail or generate, and is run by `NativeGen`")

    val base = top - argc
    val answer = go(base, argc)?

    v.stack.truncate(base)
    v.stack.push(answer)
    Ok(())

// Run generating builtin `id` over the `argc` values under the cursor on top of the stack. When it has
// more to give, the cursor cell takes where to resume from and a choice point re-runs this
// instruction with it, the arguments still standing: so the builtin resumes as `!c` does, with the
// scan state failure put back.
private call_generator(v: *Vm, id: usize, argc: usize) -> Result[Flow, string]
    if id >= v.natives.len() then return Err(s"builtin $id is not registered")

    val n = v.natives.at(id)
    val top = v.stack.len()

    if n.arity != Variadic && argc != n.arity then return Err(s"'${n.name}' takes ${n.arity} arguments and was given $argc")

    if argc + 1 > top then return Err(s"'${n.name}' wants ${argc + 1} operands and the stack holds $top")

    val go = n.how match
        Generating(g) -> g
        _ -> return Err(s"'${n.name}' is not run by `NativeGen`")

    val cursor = v.stack.at(top - 1) match
        Int(k) -> k
        _ -> return Err(s"'${n.name}' was run without a cursor above its arguments")

    val base = top - 1 - argc

    go(base, argc, cursor)? match
        Gives(x) ->
            v.stack.truncate(base)
            v.stack.push(x)
            Ok(Next)
        Refuses -> Ok(Fails)
        GivesMore(x, next) ->
            v.stack.set(top - 1, Int(next))
            push_choice(v, v.ip - 1)
            v.stack.truncate(base)
            v.stack.push(x)
            Ok(Next)

// `ScanBegin`: pop the string to scan; push the scan state it replaces, the subject and then the
// position; begin at position 1 of the string.
private scan_begin(v: *Vm) -> Result[unit, string]
    val s = deref(pop(v)?)

    s match
        Str(_) -> ()
        x -> return Err(s"`?` scans a string, and was given ${described(x)}")

    v.stack.push(v.subject)
    v.stack.push(Int(long(v.pos)))
    set_scan(v, s, 1)
    Ok(())

// `ScanEnd`: pop the scanned expression's value, then the position and the subject `ScanBegin` saved
// under it, which are the scan state again; push the value. Both changes of the scan state are
// trailed, so failing back into the scanned expression -- a generator in it resumed after the scan
// has ended -- makes its subject and position the scan's again.
private scan_end(v: *Vm) -> Result[unit, string]
    val x = pop(v)?

    val at = pop(v)? match
        Int(k) -> usize(k)
        _ -> return Err("`ScanEnd` found no saved position under the scan's value")

    val subject = pop(v)?

    set_scan(v, subject, at)
    v.stack.push(x)
    Ok(())
