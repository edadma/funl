module io.github.edadma.funl

import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

// The instruction loop.
//
// **There is no host recursion anywhere in it.** A call moves `ip` into a new heap frame, a
// resumption is `fail` restoring an entry, and nothing is ever suspended on the sysl stack -- which
// is what lets every suspended computation be data the collector sees.

enum Outcome
    // The run reached `Halt`.
    Succeeded

    // Failure emptied the control stack: nothing was left to resume.
    Failed

    // An instruction could not be carried out, or raised an error nothing caught; the message says
    // which instruction and why.
    Faulted(msg: string)

private enum Flow
    Next
    Fails
    Halts

// Run chunk `chunk` as the top level, from its first instruction. A line Prolog's `write/1` began
// and nothing ended is written out when the run ends, however it ends.
run(v: *Vm, chunk: usize) -> Outcome
    val outcome = run_loop(v, chunk)

    end_line(v)
    outcome

private run_loop(v: *Vm, chunk: usize) -> Outcome
    if chunk >= v.chunks.len() then return Faulted(s"there is no chunk $chunk to run")

    v.frame = new_frame(chunk) match
        Ok(f) -> f
        Err(e) -> return Faulted(e)

    v.globals = v.frame
    v.code = chunk
    v.ip = 0
    v.mark = NoMark

    drive(v)

// Fail back into the run that last reached `Halt`, and run on from whatever resumes: the next
// solution of a top-level query (`toplevel.sysl`). `Failed` when nothing is left to resume.
resume(v: *Vm) -> Outcome
    val outcome = if fail(v) then drive(v) else Failed

    end_line(v)
    outcome

// The instruction loop proper, from `v.ip` in `v.code`.
private drive(v: *Vm) -> Outcome
    loop
        maybe_collect(v)

        val at = v.ip
        val code = v.chunks.at(v.code).code

        if at >= code.len() then return Faulted(s"ran off the end of chunk '${v.chunks.at(v.code).name}'")

        v.ip = at + 1

        execute(v, code.at(at)) match
            Ok(Next) -> ()
            Ok(Fails) -> if !fail(v) then return Failed
            Ok(Halts) -> return Succeeded
            Err(Broken(e)) -> return Faulted(s"${v.chunks.at(v.code).name}@$at: $e")
            Err(Thrown(ball)) ->
                // Read before unwinding, which undoes the bindings the ball was made with.
                val said = s"${v.chunks.at(v.code).name}@$at: ${uncaught_text(ball)}"

                throw_ball(v, ball) match
                    Ok(true) -> ()
                    Ok(false) -> return Faulted(said)
                    Err(e) -> return Faulted(e)
end drive

private fails_if(ok: bool) -> Flow = if ok then Next else Fails

private pop(v: *Vm) -> Result[Value, string] = v.stack.pop() match
    Some(x) -> Ok(x)
    None -> Err("the operand stack is empty")

// Pop `n` values into a compound's arguments, the deepest first.
private pop_into(v: *Vm, c: *CompoundObj, n: usize) -> Result[unit, string]
    val top = v.stack.len()

    if n > top then return Err(s"wants $n operands and the stack holds $top")

    for i in 0..<n
        c.args.set(i, v.stack.at(top - n + i))

    v.stack.truncate(top - n)
    Ok(())

private execute(v: *Vm, op: Op) -> Result[Flow, Fault]
    op match
        Halt -> Ok(Halts)
        Mark(to) ->
            push_mark(v, Mark, to)
            Ok(Next)
        MarkThrough ->
            push_mark(v, MarkThrough, 0)
            Ok(Next)
        Choice(to) ->
            push_choice(v, to)
            Ok(Next)
        Unmark ->
            unmark(v)?
            Ok(Next)
        UnmarkKeep ->
            val x = pop(v)?

            unmark(v)?
            v.stack.push(x)
            Ok(Next)
        Fail -> Ok(Fails)
        Branch(to) ->
            v.ip = to
            Ok(Next)
        SaveMark(slot) ->
            set_slot(v.frame, slot, Int(long(v.mark)))?
            Ok(Next)
        UnmarkTo(slot) ->
            unmark_to(v, slot_of(v.frame, slot)?)?
            Ok(Next)
        Pop ->
            pop(v)?
            Ok(Next)
        PushConst(k) ->
            val consts = v.chunks.at(v.code).consts

            if k >= consts.len() then return Err(Broken(s"constant $k of a chunk with ${consts.len()}"))

            v.stack.push(consts.at(k))
            Ok(Next)
        PushNil ->
            v.stack.push(Nil)
            Ok(Next)
        PushInt(n) ->
            v.stack.push(Int(n))
            Ok(Next)
        LoadSlot(depth, slot) ->
            v.stack.push(slot_of(frame_up(v, depth)?, slot)?)
            Ok(Next)
        NewVar(slot) ->
            set_slot(v.frame, slot, Var(new_var()?))?
            Ok(Next)
        PushVar ->
            v.stack.push(Var(new_var()?))
            Ok(Next)
        MakeCompound(functor, n) ->
            val c = new_compound(functor, n)?

            pop_into(v, c, n)?
            v.stack.push(Compound(c))
            Ok(Next)
        MakeCons ->
            val tail = pop(v)?
            val head = pop(v)?

            v.stack.push(new_cons(head, cons_tail(tail)?)?)
            Ok(Next)
        Unify ->
            val b = pop(v)?
            val a = pop(v)?

            if !unify(a, b) then return Ok(Fails)

            v.stack.push(b)
            Ok(Next)
        TestEq -> compare(v, true, "==")
        TestNe -> compare(v, false, "!=")
        Frame(n) ->
            size_frame(v, n)?
            Ok(Next)
        Call(target, argc) ->
            call(v, target, argc)?
            Ok(Next)
        TailCall(target, argc) ->
            tail_call(v, target, argc)?
            Ok(Next)
        Return ->
            ret(v)?
            Ok(Next)
        ReturnCommit ->
            ret_commit(v)?
            Ok(Next)
        Native(id, argc) ->
            call_native(v, id, argc)?
            Ok(Next)
        GetVar(slot, src) -> Ok(fails_if(get_var(v, slot, src)?))
        GetValue(slot, src) -> Ok(fails_if(get_value(v, slot, src)?))
        GetConst(k, src) -> Ok(fails_if(get_const(v, k, src)?))
        GetCompound(functor, n, src) -> Ok(fails_if(get_compound(v, functor, n, src)?))
        PushUnit ->
            v.stack.push(Unit)
            Ok(Next)
        MakeTuple(n) ->
            val t = new_tuple(n)?
            val top = v.stack.len()

            if n > top then return Err(Broken(s"wants $n operands and the stack holds $top"))

            for i in 0..<n
                t.items.set(i, v.stack.at(top - n + i))

            v.stack.truncate(top - n)
            v.stack.push(Tuple(t))
            Ok(Next)
        Arith(o) ->
            val b = pop(v)?
            val a = pop(v)?

            arith(o, a, b)? match
                Some(x) ->
                    v.stack.push(x)
                    Ok(Next)
                None -> Ok(Fails)
        Negate ->
            val a = pop(v)?

            v.stack.push(negate(a)?)
            Ok(Next)
        FailIfFalse ->
            val top = v.stack.len()

            if top == 0 then return Err(Broken("the operand stack is empty"))

            deref(v.stack.at(top - 1)) match
                Bool(b) -> Ok(fails_if(b))
                _ -> Ok(Next)
        Dup ->
            val top = v.stack.len()

            if top == 0 then return Err(Broken("the operand stack is empty"))

            v.stack.push(v.stack.at(top - 1))
            Ok(Next)
        LoadArg(i) ->
            val args = v.frame.args

            if i >= args.len() then return Err(Broken(s"argument $i of a call that passed ${args.len()}"))

            v.stack.push(args.at(i))
            Ok(Next)
        StoreSlot(slot) ->
            val x = pop(v)?

            set_slot(v.frame, slot, x)?
            Ok(Next)
        MakeClosure(target, up) ->
            make_closure(v, target, up)?
            Ok(Next)
        CallFn(target, argc, up) ->
            call_fn(v, target, argc, up)?
            Ok(Next)
        TailCallFn(target, argc, up) ->
            tail_call_fn(v, target, argc, up)?
            Ok(Next)
        CallValue(argc) ->
            Ok(fails_if(call_value(v, argc, false)?))
        KeepTop(file) ->
            v.funl_tops.set(file, v.frame)
            Ok(Next)
        TailCallValue(argc) ->
            Ok(fails_if(call_value(v, argc, true)?))
        MatchTuple(n) ->
            deref(pop(v)?) match
                Tuple(t) ->
                    if t.items.len() != n then return Ok(Fails)

                    push_parts(v, t.items)
                    Ok(Next)

                // The compound `tuple(...)` a Prolog caller builds is a tuple, as the term mapping has it.
                Compound(c) ->
                    if c.args.len() != n || atom_name(c.functor) != "tuple" then return Ok(Fails)

                    push_parts(v, c.args)
                    Ok(Next)
                Var(_) -> Err(instantiation_error("instantiation error: a tuple pattern was given an unbound variable"))
                _ -> Ok(Fails)
        MatchCompound(functor, n) ->
            deref(pop(v)?) match
                Compound(c) ->
                    if c.functor != functor || c.args.len() != n then return Ok(Fails)

                    push_parts(v, c.args)
                    Ok(Next)
                Var(_) -> Err(instantiation_error(s"instantiation error: a pattern '${atom_name(functor)}(...)' was given an unbound variable"))
                _ -> Ok(Fails)
        NoMatch ->
            no_match(v)?
            Ok(Next)
        StoreUp(depth, slot) ->
            val x = pop(v)?

            set_slot(frame_up(v, depth)?, slot, x)?
            Ok(Next)
        Update(depth, slot, o) ->
            val b = pop(v)?
            val f = frame_up(v, depth)?
            val held = slot_of(f, slot)?

            // `+=` onto a buffer or a mutable set adds to it in place, and `-=` takes out of a mutable
            // set, the variable still holding the same collection.
            if changes_in_place(o, held, b)?
                v.stack.push(held)
                return Ok(Next)

            arith(o, held, b)? match
                Some(x) ->
                    set_slot(f, slot, x)?
                    v.stack.push(x)
                    Ok(Next)
                None -> Ok(Fails)
        GenStart ->
            gen_start(v)?
            Ok(Next)
        GenNext -> Ok(fails_if(gen_next(v)?))
        GenRange(inclusive) -> Ok(fails_if(gen_range(v, inclusive)?))
        ChangeMark(to) ->
            change_mark(v, to)?
            Ok(Next)
        MakeRange(inclusive, endless, counted) ->
            make_range(v, inclusive, endless, counted)?
            Ok(Next)
        MatchCons -> Ok(fails_if(match_cons(v)?))
        MatchNil -> Ok(fails_if(match_nil(v)?))
        Member(negated) ->
            val c = pop(v)?
            val x = pop(v)?

            if member(x, c)? == negated then return Ok(Fails)

            v.stack.push(x)
            Ok(Next)
        TestDefined(defined) ->
            val top = v.stack.len()

            if top == 0 then return Err(Broken("the operand stack is empty"))

            val undefined = deref(v.stack.at(top - 1)) match
                Undefined -> true
                _ -> false

            Ok(fails_if(undefined != defined))
        TestType(t) ->
            val top = v.stack.len()

            if top == 0 then return Err(Broken("the operand stack is empty"))

            Ok(fails_if(of_type(v, v.stack.at(top - 1), t)))
        Field(name) ->
            val x = pop(v)?

            field_of(x, name)? match
                Some(y) ->
                    v.stack.push(y)
                    Ok(Next)
                None -> Ok(Fails)
        StoreBack(depth, slot) ->
            val x = pop(v)?

            assign_reversibly(frame_up(v, depth)?, slot, x)?
            Ok(Next)
        Collect(slot) ->
            collect(v, slot)?
            Ok(Next)
        Collected(slot, set) ->
            collected(v, slot, set)?
            Ok(Next)
        MakeMap(n) ->
            make_map(v, n)?
            Ok(Next)
        MakeSet(n) ->
            make_set(v, n)?
            Ok(Next)
        MakeRecord(ctor, n) ->
            make_record(v, ctor, n)?
            Ok(Next)
        Index ->
            val key = pop(v)?
            val c = pop(v)?

            element_get(c, key, true)? match
                Some(x) ->
                    v.stack.push(x)
                    Ok(Next)
                None -> Ok(Fails)
        StoreElem(bracket, back) ->
            val x = pop(v)?
            val key = pop(v)?
            val c = pop(v)?

            element_set(c, key, bracket, x, back)?
            v.stack.push(x)
            Ok(Next)
        UpdateElem(bracket, o) ->
            val x = pop(v)?
            val key = pop(v)?
            val c = pop(v)?

            update_element(c, key, bracket, o, x)? match
                Some(y) ->
                    v.stack.push(y)
                    Ok(Next)
                None -> Ok(Fails)
        InPlace(depth, slot, o) ->
            val x = pop(v)?

            v.stack.push(in_place(o, slot_of(frame_up(v, depth)?, slot)?, x)?)
            Ok(Next)
        SwapElems(first, second) ->
            Ok(fails_if(swap_elements(v, first, second)?))
        Concat(n) ->
            concat(v, n)?
            Ok(Next)
        NativeGen(id, argc) -> call_generator(v, id, argc)
        ScanBegin ->
            scan_begin(v)?
            Ok(Next)
        ScanEnd ->
            close_scans(v, 1)?
            Ok(Next)
        ScanLeave(n) ->
            close_scans(v, n)?
            Ok(Next)
        Char(c, fold) -> Ok(fails_if(rx_char(v, c, fold, false)?))
        Class(k) -> Ok(fails_if(rx_class(v, k, false)?))
        ClassOf -> Ok(fails_if(rx_class_of(v, pop(v)?, false)?))
        AnyChar(dotall) -> Ok(fails_if(rx_any(v, dotall, false)?))
        LitOf -> Ok(fails_if(rx_lit_of(v, pop(v)?, false)?))
        Backref(n, fold) -> Ok(fails_if(rx_backref(v, n, fold, false)?))
        CharRev(c, fold) -> Ok(fails_if(rx_char(v, c, fold, true)?))
        ClassRev(k) -> Ok(fails_if(rx_class(v, k, true)?))
        ClassOfRev -> Ok(fails_if(rx_class_of(v, pop(v)?, true)?))
        AnyCharRev(dotall) -> Ok(fails_if(rx_any(v, dotall, true)?))
        LitOfRev -> Ok(fails_if(rx_lit_of(v, pop(v)?, true)?))
        BackrefRev(n, fold) -> Ok(fails_if(rx_backref(v, n, fold, true)?))
        GroupEndRev(n) ->
            val end = popped_position(pop(v)?)?

            set_capture(v, n, GroupSpan(v.pos, end))
            Ok(Next)
        GroupStart ->
            v.stack.push(Int(long(v.pos)))
            Ok(Next)
        GroupEnd(n) ->
            val start = popped_position(pop(v)?)?

            set_capture(v, n, GroupSpan(start, v.pos))
            Ok(Next)
        Assert(a) -> Ok(fails_if(rx_assert(v, a)?))
        SavePos ->
            v.stack.push(Int(long(v.pos)))
            Ok(Next)
        RestorePos ->
            val at = popped_position(pop(v)?)?

            set_scan(v, v.subject, at)
            Ok(Next)
        RepNext(lo, hi, exit, lazy) ->
            rep_next(v, lo, hi, exit, lazy)?
            Ok(Next)
        RepStep(top, lo) ->
            rep_step(v, top, lo)?
            Ok(Next)
        Barrier ->
            v.stack.push(Int(long(v.control.len())))
            Ok(Next)
        CutTo ->
            val h = popped_position(pop(v)?)?

            cut_to(v, h, false)
            Ok(Next)
        RxBegin(groups) ->
            rx_begin(v, groups)
            Ok(Next)
        RxEnd ->
            val start = popped_position(pop(v)?)?

            v.stack.push(rx_end(v, start)?)
            Ok(Next)
        GetNil(src) -> Ok(fails_if(get_nil(v, src)?))
        GetCons(src) -> Ok(fails_if(get_cons(v, src)?))
        SwitchFirst(unbound, other, cases) ->
            switch_first(v, unbound, other, cases)?
            Ok(Next)
        Case(_, _) -> Err(Broken("a `Case` was run as an instruction rather than searched by its `SwitchFirst`"))
        Instantiated(param) ->
            instantiated(v, param)?
            Ok(Next)
        CollectCopy ->
            collect_copy(v)?
            Ok(Next)
        Gathered(how) -> Ok(fails_if(gathered(v, how)?))
        CutClause ->
            cut_to(v, v.frame.cut, false)
            Ok(Next)
        SaveHeight(slot) ->
            set_slot(v.frame, slot, Int(long(v.control.len())))?
            Ok(Next)
        CutSlot(slot) ->
            cut_to(v, saved_height(v, slot)?, false)
            Ok(Next)
        SoftCut(slot) ->
            soft_cut(v, saved_height(v, slot)?)
            Ok(Next)
        CallGoal(extra) ->
            call_goal(v, extra)?
            Ok(Next)
        Consult ->
            consult(v)?
            Ok(Next)
        NoProcedure -> no_procedure(v.chunks.at(v.code).name) match
            Some(f) -> Err(f)
            None -> Ok(Fails)
        TryDynamic(p) -> Ok(fails_if(try_dynamic(v, p)?))
        PushCatch(to) ->
            push_catch(v, to)
            Ok(Next)
        ExitCatch(slot) ->
            exit_catch(v, slot)?
            Ok(Next)
end execute

// The error a call of a predicate never defined raises, or `None` when the `unknown` flag says it
// fails; `key` is its `name/arity`.
private no_procedure(key: string) -> Option[Fault]
    var cut = key.bytes.len
    var arity: usize = 0
    var scale: usize = 1

    while cut > 0 && key.bytes[cut - 1] >= u8('0') && key.bytes[cut - 1] <= u8('9')
        cut -= 1
        arity += usize(key.bytes[cut] - u8('0')) * scale
        scale *= 10

    if cut < 2 || cut == key.bytes.len || key.bytes[cut - 1] != u8('/') then return Some(Broken(s"unknown procedure $key"))

    unknown_call(from_utf8_unchecked(key.bytes[0..<cut - 1]), arity)

// Push a tuple's items or a term's arguments, the last first, so the first is on top for the
// pattern that matches it.
private push_parts(v: *Vm, parts: Buf[Value])
    var i = parts.len()

    while i > 0
        i -= 1
        v.stack.push(parts.at(i))

// `TestEq` and `TestNe`: pop `b` and `a`, and push `b` when their equality is `want`.
private compare(v: *Vm, want: bool, op: string) -> Result[Flow, Fault]
    val b = pop(v)?
    val a = pop(v)?

    if equal_values(a, b, op)? != want then return Ok(Fails)

    v.stack.push(b)
    Ok(Next)

// Builtin `id`, checked against a call of it with `argc` arguments and `extra` cells above them.
// The compiler checks a builtin's arity, so a mismatch here is the machine's own fault.
private native_called(v: *Vm, id: usize, argc: usize, extra: usize) -> Result[Native, string]
    if id >= v.natives.len() then return Err(s"builtin $id is not registered")

    val n = v.natives.at(id)
    val top = v.stack.len()

    if n.arity != Variadic && argc != n.arity then return Err(s"'${n.name}' takes ${n.arity} arguments and was given $argc")

    if argc + extra > top then return Err(s"'${n.name}' wants ${argc + extra} operands and the stack holds $top")

    Ok(n)

// Run builtin `id` over the top `argc` values, which stand on the stack until it answers.
private call_native(v: *Vm, id: usize, argc: usize) -> Result[unit, Fault]
    val n = native_called(v, id, argc, 0)?
    val top = v.stack.len()

    val go = n.how match
        Plain(g) -> g
        Constant(g) -> g
        Generating(_) -> return Err(Broken(s"'${n.name}' may fail or generate, and is run by `NativeGen`"))

    val base = top - argc
    val answer = go(base, argc)?

    v.stack.truncate(base)
    v.stack.push(answer)
    Ok(())

// Run generating builtin `id` over the `argc` values under the cursor on top of the stack. When it has
// more to give, the cursor cell takes where to resume from and a choice point re-runs this
// instruction with it, the arguments still standing: so the builtin resumes as `!c` does, with the
// scan state failure put back.
private call_generator(v: *Vm, id: usize, argc: usize) -> Result[Flow, Fault]
    val n = native_called(v, id, argc, 1)?
    val top = v.stack.len()

    val go = n.how match
        Generating(g) -> g
        _ -> return Err(Broken(s"'${n.name}' is not run by `NativeGen`"))

    val cursor = v.stack.at(top - 1) match
        Int(k) -> k
        _ -> return Err(Broken(s"'${n.name}' was run without a cursor above its arguments"))

    val base = top - 1 - argc
    val answer = go(base, argc, cursor)?

    // The unifications the builtin asked for with `unify_on_answer`, taken off the stack before a
    // choice point could save them.
    var pairs: Buf[Value] = buf()

    for i in top..<v.stack.len()
        pairs.push(v.stack.at(i))

    v.stack.truncate(top)

    answer match
        Gives(x) ->
            v.stack.truncate(base)
            v.stack.push(x)
            Ok(if unified_pairs(pairs) then Next else Fails)
        Refuses -> Ok(Fails)
        GivesMore(x, next) ->
            v.stack.set(top - 1, Int(next))
            push_choice(v, v.ip - 1)
            v.stack.truncate(base)
            v.stack.push(x)
            Ok(if unified_pairs(pairs) then Next else Fails)

// Whether every pair a generating builtin asked to unify does.
private unified_pairs(pairs: Buf[Value]) -> bool
    var i: usize = 0

    while i + 1 < pairs.len()
        if !unify(pairs.at(i), pairs.at(i + 1)) then return false

        i += 2

    true

// `ScanBegin`: pop the string to scan; save the scan state it replaces on `scans`; begin at position 1
// of the string.
private scan_begin(v: *Vm) -> Result[unit, Fault]
    val s = deref(pop(v)?)

    s match
        Str(_) -> ()
        Var(_) -> return Err(instantiation_error("instantiation error: `?` was given an unbound variable to scan"))
        x -> return Err(type_error("string", x, s"`?` scans a string, and was given ${described(x)}"))

    open_scan(v, s)
    Ok(())
