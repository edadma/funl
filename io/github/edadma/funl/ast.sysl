module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.Buf

// The tree the parser builds and the resolver and compiler read.
//
// **A name is kept as its spelling here**; what it means -- a slot, a function, a relation, a
// builtin, a fresh logic variable -- is the resolver's answer, asked by the compiler.
//
// **A pattern is an expression**: a parameter, the left of a `val` and a head argument are all read
// as expressions, and the resolver refuses a form that cannot match anything.

enum ExprKind
    // A name in value position.
    Ref(name: string)

    // `_`: a new anonymous variable at each occurrence.
    Anon

    AtomE(name: string)
    IntE(n: long)
    StrE(s: string)
    BoolE(b: bool)

    // `(a, b, ...)`; `()` is the tuple of nothing, which is the unit value.
    TupleE(items: Buf[&Expr])

    // `name(args)`: a call of what the name means, or in a head or a pattern a compound term.
    CallE(name: string, name_span: Span, args: Buf[&Expr])

    // `f(args)` where `f` is any expression but a name: `curried(5)(6)`.
    ApplyE(f: &Expr, args: Buf[&Expr])

    // `a & b`, `a | b`, `not e`.
    Conj(a: &Expr, b: &Expr)
    Disj(a: &Expr, b: &Expr)
    Neg(e: &Expr)

    // `a and b`, `a or b`: the same as `&` and `|`, except that each operand is a condition, which
    // `false` fails.
    AndE(a: &Expr, b: &Expr)
    OrE(a: &Expr, b: &Expr)

    // `a ~ b`, `a == b`, `a != b`: each produces `b` when it holds.
    UnifyE(a: &Expr, b: &Expr)
    EqualE(a: &Expr, b: &Expr)
    DifferE(a: &Expr, b: &Expr)

    // Arithmetic and ordering. An ordering produces its right operand when it holds, so comparisons
    // chain: `1 < x < 10`.
    BinE(op: BinOp, a: &Expr, b: &Expr)

    // Prefix `-`.
    MinusE(e: &Expr)

    // `name@pattern`: the whole value under a name, and its parts under the pattern's.
    AsE(name: string, pat: &Expr)

    // `if c then t else e`; with no `else`, the `if` fails when `c` does.
    IfE(cond: &Expr, yes: &Expr, no: Option[&Expr])

    // `every e do b`: drives `e` through all its values, running `b` bounded for each, then fails.
    // `id` is unique in the program and names the loop to `break` and `continue`; `label` is the
    // name written before it, `outer: every ...`.
    EveryE(id: usize, label: Option[string], gen: &Expr, body: Option[&Expr])

    // `while c do b`: `b` bounded while `c` succeeds; the loop fails when `c` does.
    WhileE(id: usize, label: Option[string], cond: &Expr, body: Option[&Expr])

    // `repeat b`: `b` bounded, for ever, until a `break` or a `return` leaves it.
    RepeatE(id: usize, label: Option[string], body: &Expr)

    // `for p <- c if f, ... do b`: each binding iterates its collection by pattern, filtered, and the
    // body runs bounded for every combination; the loop then fails. `id` also names the block the
    // patterns' names are declared in.
    ForE(id: usize, label: Option[string], gens: Buf[ForGen], body: Option[&Expr])

    // `break`, `break label`, `break (e)`: leave the loop, which produces `e`, or `()`.
    BreakE(label: Option[string], value: Option[&Expr])

    // `continue`, `continue label`: on to the loop's next turn.
    ContinueE(label: Option[string])

    // A run of statements, each bounded but the last, whose value is the block's: an indented block,
    // or `(s; s; e)`. Its names are its own; `id` is unique in the program and names the block to the
    // resolver.
    BlockE(id: usize, stmts: Buf[Stmt])

    // A lambda, or a partial function literal -- an indented block of lambdas -- which is several
    // clauses of one anonymous function. `id` is unique in the program; the resolver keys the
    // function it makes by it.
    LambdaE(id: usize, clauses: Buf[Clause])

    // `(e op`, read just before a `)`: half of a left section, which the parenthesis around it
    // completes. Anywhere else it is a mistake the resolver reports.
    SectionL(op: Tok, e: &Expr)

    // `return e`, or `return` alone, which returns `()`.
    ReturnE(e: Option[&Expr])

    // `fail`: fails.
    FailE

    // `[a, b, ...]`: a list of the items' values. As a pattern, a list of exactly that many elements.
    ListE(items: Buf[&Expr])

    // `h:t`: the list whose first element is `h` and whose rest is `t`. As a pattern, any non-empty
    // list -- or range -- whose parts match.
    ConsE(head: &Expr, tail: &Expr)

    // `a..b` (`inclusive`), `a..<b`, or `a..` with no end (`upto` absent), with an optional `by k`:
    // a range value, which can be stored, iterated, indexed and matched as a list.
    RangeValE(from: &Expr, upto: Option[&Expr], by: Option[&Expr], inclusive: bool)

    // `[e | p <- c if f, ...]` or `{e | ...}` (`set`): every value of `e`, in order, for every
    // combination the bindings produce, collected into a list or a set. `id` names the block the
    // patterns' names are declared in.
    CompE(id: usize, elem: &Expr, gens: Buf[ForGen], set: bool)

    // `x in c` and `x not in c` (`negated`): `x` when `c` holds it -- or, negated, does not -- and
    // failure otherwise.
    InE(a: &Expr, c: &Expr, negated: bool)

    // `\x` (`defined`) and `/x`: `x` when it is defined, or when it is `undefined`, and failure
    // otherwise.
    DefinedE(e: &Expr, defined: bool)

    // `e.name`: a field of `e`'s value, `l.length`.
    FieldE(e: &Expr, name: string)

    // `name <- e`: `name = e`, undone when the expression it is part of is backtracked into.
    RevAssignE(name: string, e: &Expr)

    // `!c`: each element of `c`, one per resumption.
    BangE(e: &Expr)

    // `|e`: `e`'s values, then `e`'s values again, for as long as each round produces one.
    RepAltE(e: &Expr)

    // `i to j` (`inclusive`) or `i until j`, with an optional `by k`: the integers from `i` towards `j`.
    RangeE(from: &Expr, to: &Expr, by: Option[&Expr], inclusive: bool)

    // `yield e`: each of `e`'s values to the function's caller, the function suspended until it is
    // asked for the next.
    YieldE(e: &Expr)

    // `name = e`, as a statement or where an expression is delimited -- inside parentheses, at the
    // head of `every` -- storing each of `e`'s values in the variable `name` and producing it. The
    // variable is the nearest `name` in scope, or a new one of the block when there is none.
    AssignE(name: string, e: &Expr)

    // `name op= e`: each of `e`'s values combined into the variable through `op`, which is stored
    // and produced. `<:=` and `>:=` are `Lt` and `Gt`, failing where the ordering does not hold.
    CompoundE(name: string, op: BinOp, e: &Expr)

    // `x++` and `x--` (`prefix` false) produce the old value, `++x` and `--x` the new; either way the
    // variable moves by `delta`.
    StepE(name: string, delta: long, prefix: bool)

    // `a, b = e1, e2`: every value made first, then every variable stored; produces `()`.
    MultiAssignE(targets: Buf[Spanned[string]], values: Buf[&Expr])

    // `undefined`: the value of a variable never assigned.
    UndefE

    // `{k: v, ...}`: an immutable map of the keys' values to the values', in the order written. A key
    // written as a bare name is that name as a string, so `{a: 1}` is `{"a": 1}`.
    MapE(keys: Buf[&Expr], vals: Buf[&Expr])

    // `{a, b, ...}`: a set of the items' values.
    SetE(items: Buf[&Expr])

    // `c[i]`: an element counted from 1, or from -1 at the end; for a map, the value under key `i`.
    IndexE(c: &Expr, key: &Expr)

    // An element written: `c(k) = e`, `c.name = e`, `c[k] = e` (`bracket`), or with `<-` (`back`), when
    // backtracking puts the old element back. `key` is the index, the map key, or the field's name as
    // a string. Produces `e`'s value.
    SetElemE(c: &Expr, key: &Expr, bracket: bool, e: &Expr, back: bool)

    // `"text $name ${e} text"`: the parts in order, text and holes, each rendered and joined.
    InterpE(parts: Buf[&Expr])

    // What a parse error leaves in the tree, so the tree keeps its shape and parsing goes on.
    BadE
end ExprKind

struct Expr
    kind: ExprKind
    span: Span

expr(kind: ExprKind, span: Span) -> &Expr = Expr(kind, span)

// One binding of a `for` head: `pat <- iter if filter`.
struct ForGen
    pat: &Expr
    iter: &Expr
    filter: Option[&Expr]

enum Stmt
    // `free x, y`: fresh logic variables.
    FreeS(names: Buf[Spanned[string]])

    // An expression run bounded.
    ExprS(e: &Expr)

    // `val pattern = e`, a `where` binding, or `pattern = e` for a pattern that is not a name: the
    // first value of `e`, matched against the pattern, whose names it declares -- `fixed`, so that
    // nothing can assign them, unless the pattern was written without `val`.
    ValS(pat: &Expr, e: &Expr, fixed: bool)

    // `var name` or `var name = e`: a variable of the block, `undefined` until something is stored.
    VarS(name: string, at: Span, e: Option[&Expr])

    // `def` inside a body or a `where`: functions local to the frame they are written in.
    DefS(clauses: Buf[Clause])

    // `data point(x, y)` or `data shape = circle(r) | square(s) | empty`: constructors of records,
    // declared in the block like a `val`.
    DataS(ctors: Buf[CtorDecl])
end Stmt

// One constructor of a `data` declaration: its name and its fields' names. One written with no
// parentheses has no fields, and its value is its atom.
struct CtorDecl
    name: string
    at: Span
    fields: Buf[string]

// Which kind of definition a clause makes.
enum ClauseKind
    // `def name(args)`: a fact.
    Fact

    // `def name(args) :- body`: a rule.
    Rule(body: &Expr)

    // `def name(args) = body`, guarded alternatives, a block body: a function clause.
    FunctionC(body: FnBody)

// What a function clause does once its parameters have matched.
struct FnBody
    // Tried in order; the first whose condition succeeds is the clause's body. An unguarded clause
    // has one, with no condition.
    guards: Buf[Guard]

    // `where`: values and functions the guards and bodies can see, made when the clause is entered.
    wheres: Buf[Stmt]

// `| cond = body`; `otherwise`, or no `|` at all, is no condition.
struct Guard
    cond: Option[&Expr]
    body: &Expr

// One clause of a definition. The head's arguments are expressions -- for a relation a variable, a
// constant or a term, for a function any pattern -- and the resolver refuses anything else.
struct Clause
    name: string
    head: Span
    params: Buf[&Expr]
    kind: ClauseKind

// What a file holds, in order: its top-level clauses, wherever they were written, and its
// statements.
struct Program
    clauses: Buf[Clause]
    stmts: Buf[Stmt]
