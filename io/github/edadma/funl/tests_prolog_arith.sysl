module io.github.edadma.funl
@tests

// Prolog arithmetic: `is/2` over every integer evaluable, the comparisons, `succ/2`, `plus/3` and
// `between/3`, each with the ISO errors it raises.

// What `X is expr` binds `X` to, or the formal term of the error it raises.
private value_of(expr: string) -> string =
    ran_prolog(s":- catch((X is $expr, write(X)), error(F, _), write(F)), nl.\n")

// Whether `goal` succeeds, fails, or the formal term of the error it raises.
private holds(goal: string) -> string =
    ran_prolog(s":- catch(($goal -> write(yes) ; write(no)), error(F, _), write(F)), nl.\n")

private ok(text: string) -> string = text + "\nsucceeded"

@test
IS_EVALUATES_THE_ADDITIVE_AND_MULTIPLICATIVE_OPERATORS()
    assert_eq(value_of("1 + 2 * 3"), ok("7"))
    assert_eq(value_of("10 - 4 - 3"), ok("3"))
    assert_eq(value_of("-(5)"), ok("-5"))
    assert_eq(value_of("+(5)"), ok("5"))
    assert_eq(value_of("- (2 + 3)"), ok("-5"))
    assert_eq(value_of("12 / 4"), ok("3"))

@test
INTEGER_DIVISION_TRUNCATES_AND_DIV_FLOORS()
    assert_eq(value_of("7 // 2"), ok("3"))
    assert_eq(value_of("-7 // 2"), ok("-3"))
    assert_eq(value_of("-7 div 2"), ok("-4"))
    assert_eq(value_of("7 div -2"), ok("-4"))

@test
MOD_TAKES_THE_DIVISORS_SIGN_AND_REM_THE_DIVIDENDS()
    assert_eq(value_of("-7 mod 2"), ok("1"))
    assert_eq(value_of("7 mod -2"), ok("-1"))
    assert_eq(value_of("-7 rem 2"), ok("-1"))
    assert_eq(value_of("7 rem -2"), ok("1"))

@test
THE_ONE_ARGUMENT_FUNCTIONS()
    assert_eq(value_of("abs(-3)"), ok("3"))
    assert_eq(value_of("sign(-3)"), ok("-1"))
    assert_eq(value_of("sign(0)"), ok("0"))
    assert_eq(value_of("sign(9)"), ok("1"))
    assert_eq(value_of("\\ 5"), ok("-6"))
    assert_eq(value_of("msb(1000)"), ok("9"))
    assert_eq(value_of("truncate(4)"), ok("4"))
    assert_eq(value_of("integer(4)"), ok("4"))

@test
MIN_MAX_AND_GCD()
    assert_eq(value_of("min(3, -2)"), ok("-2"))
    assert_eq(value_of("max(3, -2)"), ok("3"))
    assert_eq(value_of("gcd(12, -18)"), ok("6"))
    assert_eq(value_of("gcd(0, 0)"), ok("0"))

@test
THE_BIT_OPERATIONS()
    assert_eq(value_of("5 /\\ 3"), ok("1"))
    assert_eq(value_of("5 \\/ 3"), ok("7"))
    assert_eq(value_of("5 xor 3"), ok("6"))
    assert_eq(value_of("1 << 10"), ok("1024"))
    assert_eq(value_of("1024 >> 3"), ok("128"))
    assert_eq(value_of("-16 >> 2"), ok("-4"))
    assert_eq(value_of("-1 >> 100"), ok("-1"))
    assert_eq(value_of("5 << -1"), ok("2"))
    assert_eq(value_of("-5 >> 100000000"), ok("-1"))
    assert_eq(value_of("(2 ^ 70) >> (2 ^ 70)"), ok("0"))
    assert_eq(value_of("0 << 100000000"), ok("0"))
    assert_eq(value_of("1 << 100000000"), ok("resource_error(memory)"))
    assert_eq(value_of("1 << (2 ^ 70)"), ok("resource_error(memory)"))
    assert_eq(value_of("1.5 << 100000000"), ok("type_error(integer,1.5)"))

@test
POWERS_OF_INTEGERS()
    assert_eq(value_of("2 ^ 10"), ok("1024"))
    assert_eq(value_of("1 ^ -5"), ok("1"))
    assert_eq(value_of("-1 ^ -3"), ok("-1"))
    assert_eq(value_of("0 ^ -1"), ok("evaluation_error(zero_divisor)"))
    assert_eq(value_of("2 ^ -1"), ok("type_error(float,2)"))
    assert_eq(value_of("2 ^ 100000000000"), ok("resource_error(memory)"))

@test
STAR_STAR_IS_A_FLOAT_POWER_AND_CARET_ONE_WHERE_A_FLOAT_IS_GIVEN()
    assert_eq(value_of("2 ** 10"), ok("1024.0"))
    assert_eq(value_of("2 ** -1"), ok("0.5"))
    assert_eq(value_of("2.0 ^ 3"), ok("8.0"))
    assert_eq(value_of("4 ^ 0.5"), ok("2.0"))
    assert_eq(value_of("10.0 ** 400"), ok("evaluation_error(float_overflow)"))
    assert_eq(value_of("(-8.0) ** 0.5"), ok("evaluation_error(undefined)"))

@test
IS_UNIFIES_ITS_LEFT_SIDE_WITH_THE_VALUE()
    assert_eq(holds("3 is 1 + 2"), ok("yes"))
    assert_eq(holds("4 is 1 + 2"), ok("no"))
    assert_eq(holds("foo is 1 + 2"), ok("no"))

@test
AN_UNBOUND_VARIABLE_IN_AN_EXPRESSION_IS_AN_INSTANTIATION_ERROR()
    assert_eq(value_of("1 + _"), ok("instantiation_error"))
    assert_eq(holds("_ < 3"), ok("instantiation_error"))

@test
A_NAME_THAT_IS_NOT_AN_ARITHMETIC_FUNCTION_IS_A_TYPE_ERROR_NAMING_IT()
    assert_eq(value_of("foo + 1"), ok("type_error(evaluable,foo/0)"))
    assert_eq(value_of("foo(1, 2, 3)"), ok("type_error(evaluable,foo/3)"))
    assert_eq(value_of("bar(1)"), ok("type_error(evaluable,bar/1)"))
    assert_eq(value_of("[]"), ok("type_error(evaluable,[]/0)"))
    assert_eq(value_of("\"seven\""), ok("type_error(evaluable,seven)"))

@test
DIVISION_BY_ZERO_IS_AN_EVALUATION_ERROR_FOR_EVERY_DIVISION()
    for op in ["/", "//", "mod", "rem", "div"]
        assert_eq(value_of(s"7 $op 0"), ok("evaluation_error(zero_divisor)"))

@test
A_RESULT_PAST_64_BITS_GROWS_INTO_A_BIG_INTEGER()
    assert_eq(value_of("9223372036854775807 + 1"), ok("9223372036854775808"))
    assert_eq(value_of("-9223372036854775807 - 2"), ok("-9223372036854775809"))
    assert_eq(value_of("abs(-9223372036854775807 - 1)"), ok("9223372036854775808"))
    assert_eq(value_of("1 << 63"), ok("9223372036854775808"))
    assert_eq(value_of("1 << 100 >> 99"), ok("2"))
    assert_eq(value_of("2 ^ 64"), ok("18446744073709551616"))
    assert_eq(value_of("(-9223372036854775807 - 1) // -1"), ok("9223372036854775808"))
    assert_eq(value_of("2 ^ 64 - 2 ^ 64 + 1"), ok("1"))
    assert_eq(value_of("(2 ^ 64) mod 7"), ok("2"))
    assert_eq(value_of("(2 ^ 64) /\\ 255"), ok("0"))
    assert_eq(value_of("\\ (2 ^ 64)"), ok("-18446744073709551617"))
    assert_eq(value_of("gcd(2 ^ 70, 6 ^ 3)"), ok("8"))
    assert_eq(value_of("msb(2 ^ 70)"), ok("70"))
    assert_eq(value_of("123456789012345678901234567890 + 0"), ok("123456789012345678901234567890"))
    assert_eq(holds("X is 2 ^ 64, integer(X), X > 9223372036854775807"), ok("yes"))

@test
SLASH_IS_A_FLOAT_WHERE_IT_DOES_NOT_DIVIDE_OR_A_RATIONAL_UNDER_PREFER_RATIONALS()
    assert_eq(value_of("7 / 2"), ok("3.5"))
    assert_eq(value_of("6 / 2"), ok("3"))
    assert_eq(value_of("7 / 2.0"), ok("3.5"))
    assert_eq(ran_prolog(":- set_prolog_flag(prefer_rationals, true), X is 7 / 2, Y is X * 2, write(X/Y), nl.\n"), ok("7r2/7"))
    assert_eq(ran_prolog(":- set_prolog_flag(prefer_rationals, true), X is 2 ^ -2, write(X), nl.\n"), ok("1r4"))
    assert_eq(ran_prolog(":- set_prolog_flag(prefer_rationals, true), X is 1 / 3, rational(X), \\+ integer(X), number(X), write(yes), nl.\n"), ok("yes"))
    assert_eq(holds("set_prolog_flag(prefer_rationals, maybe)"), ok("domain_error(flag_value,prefer_rationals+maybe)"))

@test
THE_FLOAT_FUNCTIONS()
    assert_eq(value_of("float(7)"), ok("7.0"))
    assert_eq(value_of("float(2 ^ 2000)"), ok("evaluation_error(float_overflow)"))
    assert_eq(value_of("sqrt(16)"), ok("4.0"))
    assert_eq(value_of("sqrt(-1)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("sin(0)"), ok("0.0"))
    assert_eq(value_of("cos(0)"), ok("1.0"))
    assert_eq(holds("atan(1) * 4 =:= pi"), ok("yes"))
    assert_eq(value_of("exp(0)"), ok("1.0"))
    assert_eq(value_of("log(1)"), ok("0.0"))
    assert_eq(value_of("log(0)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("log(-1)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("atan2(1, 1) * 4"), ok("3.141592653589793"))
    assert_eq(value_of("atan2(0, 0)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("float_integer_part(-2.5)"), ok("-2.0"))
    assert_eq(value_of("float_fractional_part(2.75)"), ok("0.75"))
    assert_eq(value_of("1.0e10"), ok("10000000000.0"))
    assert_eq(value_of("1 + 2.0"), ok("3.0"))
    assert_eq(value_of("2.5 * 2"), ok("5.0"))
    assert_eq(value_of("1.0 / 0"), ok("evaluation_error(zero_divisor)"))
    assert_eq(value_of("1.0e308 * 10"), ok("evaluation_error(float_overflow)"))

@test
THE_ROUNDINGS_TURN_A_FLOAT_OR_A_RATIONAL_INTO_AN_INTEGER()
    assert_eq(value_of("truncate(2.7)"), ok("2"))
    assert_eq(value_of("truncate(-2.7)"), ok("-2"))
    assert_eq(value_of("round(2.5)"), ok("3"))
    assert_eq(value_of("round(-2.5)"), ok("-3"))
    assert_eq(value_of("integer(2.4)"), ok("2"))
    assert_eq(value_of("ceiling(2.1)"), ok("3"))
    assert_eq(value_of("floor(-2.1)"), ok("-3"))
    assert_eq(value_of("floor(5)"), ok("5"))
    assert_eq(value_of("truncate(1.0e20)"), ok("100000000000000000000"))
    assert_eq(ran_prolog(":- set_prolog_flag(prefer_rationals, true), A is floor(-7/2), B is ceiling(-7/2), C is round(7/2), D is truncate(-7/2), write([A,B,C,D]), nl.\n"), ok("[-4,-3,4,-3]"))
    assert_eq(value_of("floor(1.0e308 * 10)"), ok("evaluation_error(float_overflow)"))

@test
THE_INTEGER_OPERATIONS_REFUSE_A_FLOAT()
    assert_eq(value_of("7.0 // 2"), ok("type_error(integer,7.0)"))
    assert_eq(value_of("7 mod 2.0"), ok("type_error(integer,2.0)"))
    assert_eq(value_of("7.5 rem 2"), ok("type_error(integer,7.5)"))
    assert_eq(value_of("7 div 2.5"), ok("type_error(integer,2.5)"))
    assert_eq(value_of("1.5 /\\ 1"), ok("type_error(integer,1.5)"))
    assert_eq(value_of("gcd(4, 2.0)"), ok("type_error(integer,2.0)"))
    assert_eq(value_of("1 << 1.0"), ok("type_error(integer,1.0)"))
    assert_eq(value_of("msb(2.0)"), ok("type_error(integer,2.0)"))

@test
THE_COMPARISONS_EVALUATE_BOTH_SIDES()
    assert_eq(holds("1 + 2 =:= 3"), ok("yes"))
    assert_eq(holds("1 + 2 =\\= 3"), ok("no"))
    assert_eq(holds("1 < 2"), ok("yes"))
    assert_eq(holds("2 < 2"), ok("no"))
    assert_eq(holds("2 =< 2"), ok("yes"))
    assert_eq(holds("3 > 2 * 2"), ok("no"))
    assert_eq(holds("4 >= 2 * 2"), ok("yes"))
    assert_eq(holds("a < 1"), ok("type_error(evaluable,a/0)"))
    assert_eq(holds("1 =:= 1.0"), ok("yes"))
    assert_eq(holds("1 < 1.5"), ok("yes"))
    assert_eq(holds("2 ^ 64 > 1.0e20"), ok("no"))
    assert_eq(holds("9007199254740993 > 9007199254740992.0"), ok("yes"))
    assert_eq(holds("0.5 =:= 1 / 2"), ok("yes"))

@test
SUCC_COUNTS_UP_AND_DOWN_OVER_THE_NATURAL_NUMBERS()
    assert_eq(ran_prolog(":- succ(3, Y), succ(Z, Y), write(Y-Z), nl.\n"), ok("4-3"))
    assert_eq(holds("succ(_, 0)"), ok("no"))
    assert_eq(holds("succ(_, _)"), ok("instantiation_error"))
    assert_eq(holds("succ(a, _)"), ok("type_error(integer,a)"))
    assert_eq(holds("succ(-1, _)"), ok("type_error(not_less_than_zero,-1)"))
    assert_eq(ran_prolog(":- succ(9223372036854775807, Y), write(Y), nl.\n"), ok("9223372036854775808"))
    assert_eq(ran_prolog(":- plus(9223372036854775807, 1, Z), write(Z), nl.\n"), ok("9223372036854775808"))
    assert_eq(holds("succ(1.0, _)"), ok("type_error(integer,1.0)"))

@test
PLUS_SOLVES_FOR_WHICHEVER_ARGUMENT_IS_UNBOUND()
    assert_eq(ran_prolog(":- plus(1, 2, X), plus(1, Y, 3), plus(Z, 2, 3), write(X/Y/Z), nl.\n"), ok("3/2/1"))
    assert_eq(holds("plus(1, 2, 4)"), ok("no"))
    assert_eq(holds("plus(1, _, _)"), ok("instantiation_error"))
    assert_eq(holds("plus(a, 1, _)"), ok("type_error(integer,a)"))

@test
BETWEEN_GENERATES_EACH_INTEGER_AND_UNDOES_EACH_BINDING_ON_BACKTRACKING()
    assert_eq(ran_prolog(":- forall(between(1, 4, X), (write(X), nl)).\n"), ok("1\n2\n3\n4"))
    assert_eq(holds("between(3, 1, _)"), ok("no"))
    assert_eq(ran_prolog(":- between(1, inf, X), X > 3, write(X), nl.\n"), ok("4"))
    assert_eq(ran_prolog(":- forall((between(1, 2, X), between(X, 2, Y)), (write(X-Y), nl)).\n"), ok("1-1\n1-2\n2-2"))

    // Each solution's binding is gone when the next is asked for, so `X = 2` sees a fresh `X`.
    assert_eq(ran_prolog(":- between(1, 3, X), X = 2, write(X), nl.\n"), ok("2"))
    assert_eq(holds("between(1, 3, 2)"), ok("yes"))
    assert_eq(holds("between(1, 3, 5)"), ok("no"))

@test
BETWEEN_RAISES_THE_ISO_ERRORS()
    assert_eq(holds("between(_, 3, _)"), ok("instantiation_error"))
    assert_eq(holds("between(1, foo, _)"), ok("type_error(integer,foo)"))
    assert_eq(holds("between(1, 3, a)"), ok("type_error(integer,a)"))

// `random/1` draws from the operating system's seed, so a test can pin only the range and the type
// of what it gives, never the value.
@test
RANDOM_GIVES_AN_INTEGER_FROM_ZERO_TO_BELOW_ITS_BOUND()
    assert_eq(holds("forall(between(1, 500, _), (X is random(10), integer(X), X >= 0, X < 10))"), ok("yes"))
    assert_eq(holds("forall(between(1, 50, _), 0 is random(1))"), ok("yes"))
    assert_eq(holds("findall(X, (between(1, 60, _), X is random(3)), L), msort(L, S), S = [0|_], last(S, 2)"), ok("yes"))

@test
RANDOM_WANTS_A_POSITIVE_INTEGER()
    assert_eq(value_of("random(0)"), ok("domain_error(positive_integer,0)"))
    assert_eq(value_of("random(-3)"), ok("domain_error(positive_integer,-3)"))
    assert_eq(value_of("random(2.5)"), ok("type_error(integer,2.5)"))
    assert_eq(value_of("random(_)"), ok("instantiation_error"))

@test
THE_HYPERBOLIC_COTANGENT_AND_TWO_ARGUMENT_LOGARITHM_FUNCTIONS_EVALUATE()
    assert_eq(value_of("sinh(1)"), ok("1.1752011936438014"))
    assert_eq(value_of("cosh(1)"), ok("1.5430806348152437"))
    assert_eq(value_of("tanh(1)"), ok("0.7615941559557649"))
    assert_eq(value_of("asinh(1)"), ok("0.881373587019543"))
    assert_eq(value_of("acosh(2)"), ok("1.3169578969248166"))
    assert_eq(value_of("atanh(0.5)"), ok("0.5493061443340549"))
    assert_eq(value_of("log2(8)"), ok("3.0"))
    assert_eq(value_of("log(2, 8)"), ok("3.0"))
    assert_eq(value_of("cot(1)"), ok("0.6420926159343308"))
    assert_eq(value_of("acot(1)"), ok("0.7853981633974483"))
    assert_eq(value_of("acot(0)"), ok("1.5707963267948966"))
    assert_eq(value_of("copysign(3, -0.0)"), ok("-3.0"))

@test
THE_NEW_FUNCTIONS_REFUSE_ARGUMENTS_OUTSIDE_THEIR_DOMAIN()
    assert_eq(value_of("log(1, 5)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("log(0, 5)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("log(2, -5)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("log2(0)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("acosh(0.5)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("atanh(1)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("atanh(-2)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("cot(0)"), ok("evaluation_error(undefined)"))
    assert_eq(value_of("cosh(1000)"), ok("evaluation_error(float_overflow)"))
    assert_eq(value_of("sinh(a)"), ok("type_error(evaluable,a/0)"))
