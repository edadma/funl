module io.github.edadma.funl
@tests

import sysl.text.Search

// The loop under `async`, and `funl:async` (`docs/library/async.md`): timers in the second queue,
// drained only once the first is empty; a pending timer keeping the program alive; the promise
// makers; and the collector running while promises wait on timers. Every program runs on both heaps.

private has(text: string, part: string) -> bool = text.index_of(part).is_some()

// slate's interleaving: two workers, each on timers of its own, crossing by when their sleeps come
// up. slate's own test runs it at 8 and 20 milliseconds; here the times are five times as long, which
// slate prints in the same order, so a loaded machine has 20 milliseconds either side of every step
// rather than 4.
private const Interleaving: string = "import { sleep } from funl:async\n" +
    "\n" +
    "async def worker( name, ms, turns ) =\n" +
    "  i = 0\n" +
    "  while i < turns do\n" +
    "    await sleep( ms )\n" +
    "    write( \"$name $i\" )\n" +
    "    i += 1\n" +
    "  name\n" +
    "\n" +
    "async def main() =\n" +
    "  a = worker( \"a\", 40, 3 )\n" +
    "  b = worker( \"b\", 100, 2 )\n" +
    "  write( \"both started\" )\n" +
    "  write( (await a) + \" \" + (await b) )\n" +
    "\n" +
    "main()\n"

@test
SLATES_INTERLEAVING_PRINTS_THE_SAME_ORDER()
    // `a` comes up at 40, 80 and 120 milliseconds and `b` at 100 and 200.
    assert_eq(ran_funl(Interleaving), "both started\na 0\na 1\nb 0\na 2\nb 1\na b\nsucceeded")

@test
THE_COLLECTOR_RUNS_WHILE_PROMISES_WAIT_ON_TIMERS_AND_CHANGES_NOTHING()
    // `sleep( 30 )` on a line of its own is held by nothing but the timer's table.
    val text = "import { sleep } from funl:async\n" +
        "\n" +
        "async def late( s ) =\n" +
        "  await sleep( 20 )\n" +
        "  write( s, \"after a timer\" )\n" +
        "\n" +
        "sleep( 30 )\n" +
        "late( [1, 2, 3] )\n" +
        "write( \"set\" )\n"

    val calm = roomy(() -> compiled_text(text))
    val tight = stressed(() -> compiled_text(text))

    assert_eq(calm.text, "set\n[1, 2, 3], after a timer\nsucceeded")
    assert_eq(tight.text, calm.text)
    assert(tight.collections > 100, s"the stressed heap collected ${tight.collections} times")

@test
A_SETTLED_PROMISE_RESUMES_BEFORE_A_TIMER_ALREADY_DUE()
    // The ready queue is drained before the loop is asked for anything, and a zero wait still goes
    // round the loop: slate prints this order for the same program.
    val text = "import { sleep, resolve } from funl:async\n" +
        "\n" +
        "async def f() =\n" +
        "  await resolve( 1 )\n" +
        "  write( \"resumed\" )\n" +
        "\n" +
        "async def t() =\n" +
        "  await sleep( 0 )\n" +
        "  write( \"timer\" )\n" +
        "\n" +
        "t()\n" +
        "f()\n" +
        "write( \"sync\" )\n"

    assert_eq(ran_funl(text), "sync\nresumed\ntimer\nsucceeded")

@test
TWO_TIMERS_DUE_IN_ONE_PASS_ARE_BOTH_KEPT_BEFORE_EITHER_TASK_RUNS()
    // A turn of the loop is a pass, as slate's is: both timers were set in one stretch with the same
    // delay, so they are due together, and both tasks are queued before either moves.
    val text = "import { sleep } from funl:async\n" +
        "\n" +
        "async def chain( name ) =\n" +
        "  await sleep( 10 )\n" +
        "  write( \"$name timer\" )\n" +
        "  await ()\n" +
        "  write( \"$name micro\" )\n" +
        "\n" +
        "chain( \"a\" )\n" +
        "chain( \"b\" )\n"

    assert_eq(ran_funl(text), "a timer\nb timer\na micro\nb micro\nsucceeded")

@test
A_PENDING_TIMER_KEEPS_THE_PROGRAM_ALIVE_AFTER_THE_TOP_LEVEL_ENDS()
    val text = "import { sleep } from funl:async\n" +
        "\n" +
        "async def later() =\n" +
        "  await sleep( 30 )\n" +
        "  write( \"later\" )\n" +
        "\n" +
        "later()\n" +
        "sleep( 60 )\n" +
        "write( \"top done\" )\n"

    assert_eq(ran_funl(text), "top done\nlater\nsucceeded")

@test
A_WAIT_STARTS_WHEN_IT_IS_ASKED_FOR_HOWEVER_LONG_THE_PROGRAM_RAN_BEFORE_IT()
    // `funl:time`'s `sleep` blocks for 50 milliseconds between the loop's last pass and the second
    // timer, which still waits its whole 30 from where it was set.
    val text = "import { sleep } from funl:async\n" +
        "import { monotonic, sleep as block } from funl:time\n" +
        "\n" +
        "start = monotonic()\n" +
        "await sleep( 5 )\n" +
        "block( 50 )\n" +
        "await sleep( 30 )\n" +
        "write( if monotonic() - start >= 85 then \"waited\" else \"early\" )\n"

    assert_eq(ran_funl(text), "waited\nsucceeded")

@test
THE_MAKERS_ANSWER_PROMISES_ALREADY_SETTLED_OR_NOT_YET()
    val text = "import { resolve, reject, pending, settle } from funl:async\n" +
        "\n" +
        "p = pending()\n" +
        "write( p )\n" +
        "settle( p, 1 )\n" +
        "write( p )\n" +
        "write( await p )\n" +
        "settle( p, 2 )\n" +
        "write( await p )\n" +
        "write( resolve( 5 ) )\n" +
        "write( await resolve( 5 ) )\n" +
        "write( (await reject( \"no\" )) catch e -> e.message )\n"

    assert_eq(ran_funl(text), "<promise pending>\n<promise 1>\n1\n1\n<promise 5>\n5\nno\nsucceeded")

@test
A_TASK_WAITING_ON_A_PENDING_PROMISE_RUNS_WHEN_IT_IS_SETTLED()
    val text = "import { pending, settle } from funl:async\n" +
        "\n" +
        "door = pending()\n" +
        "\n" +
        "async def guest() =\n" +
        "  write( \"waiting\" )\n" +
        "  write( \"let in with \" + (await door) )\n" +
        "\n" +
        "guest()\n" +
        "write( \"opening\" )\n" +
        "settle( door, \"a key\" )\n" +
        "write( \"opened\" )\n"

    assert_eq(ran_funl(text), "waiting\nopening\nopened\nlet in with a key\nsucceeded")

@test
A_REJECTED_PROMISE_NOTHING_AWAITS_IS_THE_RUNS_FAULT()
    val text = "import { reject } from funl:async\n" +
        "\n" +
        "p = reject( \"nobody waited\" )\n" +
        "write( \"top done\" )\n"

    assert_eq(ran_funl(text), "top done\nfault: nobody waited")

    // Thrown away, it can never be awaited, and ends the run where it is made.
    val gone = "import { reject } from funl:async\n" +
        "\n" +
        "reject( \"nobody waited\" )\n" +
        "write( \"top done\" )\n"

    assert_eq(ran_funl(gone), "fault: nobody waited")

@test
THE_MAKERS_REFUSE_WHAT_IS_NOT_THEIRS()
    val text = "import { sleep, settle } from funl:async\n" +
        "\n" +
        "write( settle( 42, 1 ) catch e -> e.message )\n" +
        "write( sleep( \"x\" ) catch e -> e.message )\n"

    assert_eq(ran_funl(text),
        "'settle' wants a promise and was given the integer 42\n" +
        "'sleep' wants a number of milliseconds and was given the string 'x'\nsucceeded")

@test
SETTLE_ERROR_FAULTS_A_PENDING_PROMISE_AS_REJECT_DOES_ONE_ALREADY_MADE()
    val text = "import { pending, settle, settle_error, reject } from funl:async\n" +
        "\n" +
        "p = pending()\n" +
        "settle_error( p, \"no such row\" )\n" +
        "write( (await p) catch e -> e.message )\n" +
        "write( (await reject( \"no such row\" )) catch e -> e.message )\n" +
        "settle( p, 1 )\n" +
        "settle_error( p, \"again\" )\n" +
        "write( (await p) catch e -> e.message )\n" +
        "q = pending()\n" +
        "settle( q, 7 )\n" +
        "settle_error( q, \"late\" )\n" +
        "write( await q )\n"

    assert_eq(ran_funl(text), "no such row\nno such row\nno such row\n7\nsucceeded")

@test
A_TASK_WAITING_ON_A_PENDING_PROMISE_RAISES_ITS_FAULT_WHEN_IT_IS_SETTLED_WITH_AN_ERROR()
    val text = "import { pending, settle_error } from funl:async\n" +
        "\n" +
        "door = pending()\n" +
        "\n" +
        "async def guest( s ) =\n" +
        "  write( \"waiting\" )\n" +
        "  write( s, (await door) catch e -> \"refused: \" + e.message )\n" +
        "\n" +
        "g = guest( [1, 2, 3] )\n" +
        "write( \"opening\" )\n" +
        "settle_error( door, \"locked\" )\n" +
        "write( \"opened\" )\n" +
        "await g\n"

    val calm = roomy(() -> compiled_text(text))
    val tight = stressed(() -> compiled_text(text))

    assert_eq(calm.text, "waiting\nopening\nopened\n[1, 2, 3], refused: locked\nsucceeded")
    assert_eq(tight.text, calm.text)
    assert(tight.collections > 10, s"the stressed heap collected ${tight.collections} times")

@test
A_PROMISE_SETTLED_WITH_AN_ERROR_NOTHING_AWAITS_IS_THE_RUNS_FAULT()
    val text = "import { pending, settle_error } from funl:async\n" +
        "\n" +
        "p = pending()\n" +
        "settle_error( p, \"nobody waited\" )\n" +
        "write( \"top done\" )\n"

    assert_eq(ran_funl(text), "top done\nfault: nobody waited")

@test
SETTLE_ERROR_WANTS_A_PROMISE()
    val text = "import { settle_error } from funl:async\n" +
        "\n" +
        "write( settle_error( 42, \"x\" ) catch e -> e.message )\n" +
        "write( settle_error( _, \"x\" ) catch e -> e.message )\n"

    assert_eq(ran_funl(text),
        "'settle_error' wants a promise and was given the integer 42\n" +
        "instantiation error: 'settle_error' was given an unbound variable\nsucceeded")

@test
THE_MODULE_IS_NAMED_FOR_THE_RESERVED_WORD_AND_IMPORTS_EITHER_WAY()
    assert_eq(ran_funl("import * as a from funl:async\nwrite( await a.resolve( 3 ) )\n"), "3\nsucceeded")
    assert(has(complaints("import { fetch } from funl:async\n"), "`funl:async` does not export `fetch`"))
