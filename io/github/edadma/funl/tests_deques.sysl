module io.github.edadma.funl
@tests

import sysl.text.Search

// A buffer as a deque (`push`, `pop`, `get`, `pull`, `put`), `delete` and `-=` on mutable maps and
// sets, `array(n, x)`, `copy`, `same`, and `sort` of a map with `sortOn`.

private faults_with(text: string, want: string)
    val said = ran_funl(text)

    assert(said.contains("fault: "), said)
    assert(said.contains(want), said)

@test
PUT_ADDS_AT_THE_END_AND_PUSH_AT_THE_FRONT_THE_LAST_ARGUMENT_FIRST()
    assert_eq(ran_funl("b = buffer()\nwrite( put(b, 1, 2, 3), push(b, 8, 9), b )\n"), "Buffer(9, 8, 1, 2, 3), Buffer(9, 8, 1, 2, 3), Buffer(9, 8, 1, 2, 3)\nsucceeded")
    assert_eq(ran_funl("b = buffer()\nput(b, 1)\nput(b)\npush(b)\nwrite( b )\n"), "Buffer(1)\nsucceeded")
    assert_eq(ran_funl("b = buffer([1])\nwrite( put(b, (2, 3)), push(copy(b), [0]) )\n"), "Buffer(1, (2, 3)), Buffer([0], 1, (2, 3))\nsucceeded")

@test
POP_AND_GET_TAKE_FROM_THE_FRONT_AND_PULL_FROM_THE_BACK()
    assert_eq(ran_funl("b = buffer([1, 2, 3, 4])\nwrite( pop(b), get(b), pull(b), b )\n"), "1, 2, 4, Buffer(3)\nsucceeded")
    assert_eq(ran_funl("b = buffer([1, 2])\nwhile x = pop(b) do write( x )\nwrite( b )\n"), "1\n2\nBuffer()\nsucceeded")
    assert_eq(ran_funl("b = buffer([1, 2])\nwhile x = pull(b) do write( x )\n"), "2\n1\nsucceeded")

@test
POP_GET_AND_PULL_FAIL_ON_AN_EMPTY_BUFFER()
    assert_eq(ran_funl("b = buffer()\nwrite( pop(b) | \"none\", get(b) | \"none\", pull(b) | \"none\" )\n"), "none, none, none\nsucceeded")
    assert_eq(ran_funl("b = buffer()\nwrite( pop(b) )\nwrite( \"after\" )\n"), "after\nsucceeded")

@test
THE_DEQUE_FUNCTIONS_WANT_A_BUFFER()
    faults_with("write( push([1], 2) )\n", "'push' wants a buffer, and was given the list [1]")
    faults_with("write( put(array(2), 2) )\n", "'put' wants a buffer, and was given an array, which cannot grow or shrink")
    faults_with("write( pop(array(2)) )\n", "wants a buffer, and was given an array")
    faults_with("write( pull({1}) )\n", "'pull' wants a buffer, and was given {1}")
    faults_with("write( put() )\n", "'put' takes a buffer and the values to add at its end")
    faults_with("write( push() )\n", "'push' takes a buffer and the values to put on its front")
    assert(ran_funl("write( pop() )\n").contains("`pop` takes 1 argument"))

@test
DELETE_TAKES_A_KEY_OR_AN_ELEMENT_OUT_OF_A_MUTABLE_COLLECTION_AND_ANSWERS_IT()
    assert_eq(ran_funl("m = map({a: 1, b: 2, c: 3})\nwrite( delete(m, \"b\"), delete(m, \"zz\"), m )\n"),
        "MutableMap(\"a\": 1, \"c\": 3), MutableMap(\"a\": 1, \"c\": 3), MutableMap(\"a\": 1, \"c\": 3)\nsucceeded")
    assert_eq(ran_funl("s = set({1, 2, 3})\nwrite( delete(s, 2), delete(s, 9) )\n"), "MutableSet(1, 3), MutableSet(1, 3)\nsucceeded")
    assert_eq(ran_funl("s = set({1, {2, 3}})\ndelete(s, {2, 3})\nwrite( s )\n"), "MutableSet(1)\nsucceeded")
    assert_eq(ran_funl("m = map({a: 1}, 0)\ndelete(m, \"a\")\nwrite( m, m(\"a\") )\n"), "MutableMap(), 0\nsucceeded")

@test
DELETE_REFUSES_WHAT_IT_CANNOT_CHANGE()
    faults_with("write( delete({a: 1}, \"a\") )\n", "is an immutable map, and nothing can be deleted from it")
    faults_with("write( delete({1, 2}, 1) )\n", "is an immutable set, and nothing can be deleted from it")
    faults_with("write( delete([1, 2], 1) )\n", "'delete' takes a mutable map or a mutable set, and was given the list [1, 2]")
    faults_with("write( delete(buffer(), 1) )\n", "'delete' takes a mutable map or a mutable set")

@test
MINUS_EQUALS_TAKES_A_KEY_OUT_OF_A_MUTABLE_MAP_AND_AN_ELEMENT_OUT_OF_A_MUTABLE_SET()
    assert_eq(ran_funl("val m = map({a: 1, b: 2})\nm -= \"a\"\nm -= \"zz\"\nwrite( m )\n"), "MutableMap(\"b\": 2)\nsucceeded")
    assert_eq(ran_funl("var m = map({a: 1, b: 2})\nm -= \"b\"\nwrite( m )\n"), "MutableMap(\"a\": 1)\nsucceeded")
    assert_eq(ran_funl("val s = set({1, 2, 3})\ns -= 2\ns -= {3}\nwrite( s )\n"), "MutableSet(1)\nsucceeded")
    assert_eq(ran_funl("val t = [map({a: 1, b: 2})]\nt(0) -= \"a\"\nwrite( t )\n"), "[MutableMap(\"b\": 2)]\nsucceeded")
    assert_eq(ran_funl("var m = {a: 1, b: 2}\nm -= \"a\"\nwrite( m )\n"), "{\"b\": 2}\nsucceeded")
    faults_with("val n = 5\nn -= 1\n", "takes out of the mutable set or map it holds")

@test
ARRAY_WITH_A_VALUE_FILLS_EVERY_PLACE_WITH_THAT_ONE_VALUE()
    assert_eq(ran_funl("write( array(3, 0), array(0, 1), array(2, \"x\") )\n"), "Array(0, 0, 0), Array(), Array(\"x\", \"x\")\nsucceeded")
    assert_eq(ran_funl("a = array(2, buffer())\nput(a(0), 1)\nwrite( a )\n"), "Array(Buffer(1), Buffer(1))\nsucceeded")
    assert_eq(ran_funl("a = array(2, 0)\na(1) = 5\nwrite( a, array(2) )\n"), "Array(0, 5), Array(undefined, undefined)\nsucceeded")
    faults_with("write( array(-1, 0) )\n", "an array cannot have -1 elements")
    faults_with("write( array(\"a\", 0) )\n", "wants the number of elements as an integer")
    assert(ran_funl("write( array(1, 2, 3) )\n").contains("`array` takes 1 or 2 arguments, and this call gives 3"))

@test
COPY_IS_A_ONE_LEVEL_COPY_OF_A_MUTABLE_COLLECTION()
    assert_eq(ran_funl("b = buffer([1, 2])\nc = copy(b)\nput(c, 3)\nwrite( b, c )\n"), "Buffer(1, 2), Buffer(1, 2, 3)\nsucceeded")
    assert_eq(ran_funl("a = array([1, 2])\nc = copy(a)\nc(0) = 9\nwrite( a, c )\n"), "Array(1, 2), Array(9, 2)\nsucceeded")
    assert_eq(ran_funl("m = map({a: 1})\nc = copy(m)\nc.b = 2\nwrite( m, c )\n"), "MutableMap(\"a\": 1), MutableMap(\"a\": 1, \"b\": 2)\nsucceeded")
    assert_eq(ran_funl("s = set({1})\nc = copy(s)\nc += 2\nwrite( s, c )\n"), "MutableSet(1), MutableSet(1, 2)\nsucceeded")
    assert_eq(ran_funl("m = map({a: 1}, 0)\nc = copy(m)\nwrite( c(\"zz\") )\n"), "0\nsucceeded")
    assert_eq(ran_funl("inner = buffer([1])\nc = copy(buffer([inner]))\nput(inner, 2)\nwrite( c )\n"), "Buffer(Buffer(1, 2))\nsucceeded")
    assert_eq(ran_funl("write( copy(5), copy(\"ab\"), copy([1, 2]), copy({a: 1}), copy(()) )\n"), "5, ab, [1, 2], {\"a\": 1}, ()\nsucceeded")

@test
SAME_IS_IDENTITY_FOR_COLLECTIONS_AND_VALUE_FOR_NUMBERS_STRINGS_AND_ATOMS()
    assert_eq(ran_funl("b = buffer()\nc = buffer()\nwrite( same(b, b) | \"no\", same(b, c) | \"no\", same(b, copy(b)) | \"no\" )\n"), "Buffer(), no, no\nsucceeded")
    assert_eq(ran_funl("write( same(1, 1), same(1, 1.0) | \"no\", same(1.5, 1.5), same(\"a\", \"a\"), same(\"a\", \"b\") | \"no\", same(#a, #a), same(#a, #b) | \"no\" )\n"),
        "1, no, 1.5, a, no, a, no\nsucceeded")
    assert_eq(ran_funl("write( same(123456789012345678901234567890, 123456789012345678901234567890), same(123456789012345678901234567890, 123456789012345678901234567891) | \"no\", same(1/2, 1/2), same(1/2, 1/3) | \"no\" )\n"),
        "123456789012345678901234567890, no, 1/2, no\nsucceeded")
    assert_eq(ran_funl("m = map()\ns = set()\nl = [1]\nr = 1..3\nwrite( same(m, m) | \"no\", same(m, s) | \"no\", same(s, s) | \"no\", same(l, l), same(l, [1]) | \"no\", same(r, r) | \"no\" )\n"),
        "MutableMap(), no, MutableSet(), [1], no, 1..3\nsucceeded")
    assert_eq(ran_funl("write( same(undefined, undefined), same((), ()), same([], []), same(1, \"1\") | \"no\" )\n"), "undefined, (), [], no\nsucceeded")

@test
SORT_OF_A_MAP_IS_ITS_ENTRIES_BY_KEY_AND_SORTON_ORDERS_BY_A_KEY_FUNCTION()
    assert_eq(ran_funl("write( sort({b: 2, a: 3, c: 1}), sort(map({z: 1, y: 2})), sort({}), sort({3: #c, 1: #a, 2: #b}) )\n"),
        "[(\"a\", 3), (\"b\", 2), (\"c\", 1)], [(\"y\", 2), (\"z\", 1)], [], [(1, a), (2, b), (3, c)]\nsucceeded")
    assert_eq(ran_funl("write( sortOn(p -> p(1), sort({b: 2, a: 3, c: 1})), sortOn(x -> -x, [1, 3, 2]), sortOn(x -> x, []), sortOn(x -> x.length,[\"ccc\", \"a\", \"bb\"]) )\n"),
        "[(\"c\", 1), (\"b\", 2), (\"a\", 3)], [3, 2, 1], [], [\"a\", \"bb\", \"ccc\"]\nsucceeded")
    assert_eq(ran_funl("write( sortOn(p -> p(0), [(1, #x), (0, #y), (1, #z), (0, #w)]) )\n"), "[(0, y), (0, w), (1, x), (1, z)]\nsucceeded")
    faults_with("write( sort({1: 2, \"a\": 3}) )\n", "'<' cannot compare the string 'a' with the integer 1")
    faults_with("write( sortOn(x -> x, {a: 1}) )\n", "'sortOn' wants a list and reached {\"a\": 1}")
