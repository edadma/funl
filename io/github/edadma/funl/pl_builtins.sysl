module io.github.edadma.funl

// Prolog's builtins, each registered under its key `name/arity`.
//
// **The slash keeps the two languages' builtins apart**: FunL names a builtin by a bare name a program
// can write, and no FunL name holds a `/`, so Prolog's `write/1` and FunL's `write` are two entries
// that never meet. The control constructs and `=` are not here: the clause compiler builds them into
// the clause (`pl_compile.sysl`).

install_prolog(v: *Vm)
    register(v, "write/1", 1, pl_write)
    register(v, "writeln/1", 1, pl_writeln)
    register(v, "nl/0", 0, pl_nl)
    register(v, "op/3", 3, pl_op)
    register_generator(v, "==/2", 2, (b, n, c) -> ordered_if(b, (o) -> o == 0))
    register_generator(v, "\\==/2", 2, (b, n, c) -> ordered_if(b, (o) -> o != 0))
    register_generator(v, "@</2", 2, (b, n, c) -> ordered_if(b, (o) -> o < 0))
    register_generator(v, "@>/2", 2, (b, n, c) -> ordered_if(b, (o) -> o > 0))
    register_generator(v, "@=</2", 2, (b, n, c) -> ordered_if(b, (o) -> o <= 0))
    register_generator(v, "@>=/2", 2, (b, n, c) -> ordered_if(b, (o) -> o >= 0))

    // FunL's `consult(file)`, which the compiler turns into the `Consult` instruction: registered so
    // the name resolves and its arity is checked, and never run as a builtin.
    register(v, "consult", 1, (b, n) -> Err("consult is run by its own instruction"))

// `write/1`: the term, continuing the line `nl/0` will end.
private pl_write(base: usize, argc: usize) -> Result[Value, string]
    val v = current()

    v.line = v.line + render(arg(base, 0))
    Ok(Unit)

private pl_nl(base: usize, argc: usize) -> Result[Value, string]
    val v = current()

    v.output.push(v.line)
    v.line = ""
    Ok(Unit)

private pl_writeln(base: usize, argc: usize) -> Result[Value, string]
    pl_write(base, argc)?
    pl_nl(base, 0)

// `op(P, T, Name)` run as a goal: the table changes for whatever is read after it.
private pl_op(base: usize, argc: usize) -> Result[Value, string]
    val p = deref(arg(base, 0)) match
        Int(n) -> n
        x -> return Err(s"op/3 wants an integer priority, and was given ${described(x)}")

    val kind = deref(arg(base, 1)) match
        Atom(id) -> atom_name(id)
        x -> return Err(s"op/3 wants an operator type, and was given ${described(x)}")

    val name = deref(arg(base, 2)) match
        Atom(id) -> atom_name(id)
        x -> return Err(s"op/3 wants an operator's name, and was given ${described(x)}")

    set_op(p, kind, name)?
    Ok(Unit)

// The comparisons of the standard order of terms: succeed when `holds` says the order of the two
// arguments is right, binding nothing.
private ordered_if(base: usize, holds: int -> bool) -> Result[Answer, string] =
    Ok(if holds(compare_terms(arg(base, 0), arg(base, 1))) then Gives(Unit) else Refuses)
