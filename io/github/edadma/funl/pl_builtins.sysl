module io.github.edadma.funl

// Prolog's builtins, each registered under its key `name/arity`.
//
// **The slash keeps the two languages' builtins apart**: FunL names a builtin by a bare name a program
// can write, and no FunL name holds a `/`, so Prolog's `write/1` and FunL's `write` are two entries
// that never meet. The control constructs and `=` are not here: the clause compiler builds them into
// the clause (`pl_compile.sysl`).

install_prolog(v: *Vm)
    install_prolog_output(v)
    install_prolog_format(v)
    register(v, "op/3", 3, pl_op)
    register_generator(v, "==/2", 2, (b, n, c) -> ordered_if(b, (o) -> o == 0))
    register_generator(v, "\\==/2", 2, (b, n, c) -> ordered_if(b, (o) -> o != 0))
    register_generator(v, "@</2", 2, (b, n, c) -> ordered_if(b, (o) -> o < 0))
    register_generator(v, "@>/2", 2, (b, n, c) -> ordered_if(b, (o) -> o > 0))
    register_generator(v, "@=</2", 2, (b, n, c) -> ordered_if(b, (o) -> o <= 0))
    register_generator(v, "@>=/2", 2, (b, n, c) -> ordered_if(b, (o) -> o >= 0))
    install_prolog_arith(v)
    install_prolog_terms(v)
    install_prolog_atoms(v)
    install_prolog_lists(v)
    install_prolog_db(v)
    install_prolog_lib(v)
    install_prolog_dcg(v)
    install_prolog_flags(v)
    install_prolog_read(v)

    // FunL's `consult(file)`, which the compiler turns into the `Consult` instruction: registered so
    // the name resolves and its arity is checked, and never run as a builtin.
    register(v, "consult", 1, (b, n) -> Err(Broken("consult is run by its own instruction")))
    register(v, "$directive_raised/3", 3, pl_directive_raised)

// `'$directive_raised'(Ball, What, Text)`, the recovery a loaded file's directive runs under
// (`pl_load.sysl`): a line saying directive `Text` raised `Ball` -- an error by its message, any
// other ball as `writeq/1` writes it -- and success, so the load goes on to the next.
private pl_directive_raised(base: usize, argc: usize) -> Result[Value, Fault]
    val ball = arg(base, 0)

    val said = error_message(ball) match
        Some(m) -> m
        None -> term_text(ball, write_opts(true, false, true))

    val what = deref(arg(base, 1)) match
        Str(s) -> s.s
        _ -> "directive"

    val text = deref(arg(base, 2)) match
        Str(s) -> s.s
        _ -> ""

    val v = current()

    // A line `write/1` has begun is the warning's start, as it is the failed directive's.
    v.output.push(v.line + s"Warning: $what raised $said: $text")
    v.line = ""
    Ok(Unit)

// `op(P, T, Name)` run as a goal: the table changes for whatever is read after it.
private pl_op(base: usize, argc: usize) -> Result[Value, Fault]
    val p = deref(arg(base, 0)) match
        Int(n) -> n
        x -> return Err(op_argument(x, "integer", "an integer priority"))

    val kind = deref(arg(base, 1)) match
        Atom(id) -> atom_name(id)
        x -> return Err(op_argument(x, "atom", "an operator type"))

    val name = deref(arg(base, 2)) match
        Atom(id) -> atom_name(id)
        x -> return Err(op_argument(x, "atom", "an operator's name"))

    set_op(p, kind, name)?
    Ok(Unit)

// An argument of `op/3` that is unbound, or not the kind it has to be.
private op_argument(x: Value, kind: string, what: string) -> Fault = x match
    Var(_) -> instantiation_error(s"instantiation error: op/3 wants $what, and was given an unbound variable")
    _ -> type_error(kind, x, s"op/3 wants $what, and was given ${described(x)}")

// The comparisons of the standard order of terms: succeed when `holds` says the order of the two
// arguments is right, binding nothing.
private ordered_if(base: usize, holds: int -> bool) -> Result[Answer, Fault] =
    Ok(if holds(compare_terms(arg(base, 0), arg(base, 1))) then Gives(Unit) else Refuses)
