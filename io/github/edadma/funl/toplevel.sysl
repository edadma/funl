module io.github.edadma.funl

import sh.sysl.parsing.{full_report, point, source_of}
import sysl.buf.{Buf, buf}
import sysl.text.{Search, join}

// The standalone Prolog's ISO top level (`prolog.md` § "A Prolog with no FunL in it"): the machine
// with the Prolog reader and the Prolog builtins, and no FunL front end.
//
//     ?- member(X, [a, b]).
//     X = a
//     ;
//     X = b.
//
// **A query is read, compiled and run on the machine as any directive is** -- the reader, the clause
// compiler, `catch/3` and the writer are the ones a consulted file goes through. A solution stops the
// run at `Halt` with the query's variables on the operand stack (`compile_toplevel`); the bindings are
// written, and a `;` fails back into the same run for the next. **An answer with nothing left to
// resume ends in `.` and asks nothing.**
//
// Lines come from `line` and everything said goes to `say`, a line at a time, so the driver chooses
// the terminal (`prolog/main.sysl` reads through linenoise) and a test hands in a script.

const QueryPrompt: string = "?- "
const MorePrompt: string = "|    "

// The machine the standalone Prolog runs on: every builtin a Prolog program can name, and no way to
// bring in FunL.
prolog_vm() -> Vm
    var v = new_vm(HeapBytes, CollectFloor, Growth)

    v.funl_front_end = false
    v

// A whole session: consult `files` in order, then answer queries until `halt` or the end of input.
// Answers the status to exit with -- `halt(N)`'s `N`, and otherwise 0. A `halt` in a file's directive
// ends the session there, before any query is read.
toplevel(files: []string, line: &Fn(string) -> Option[string], say: &Fn(string) -> unit) -> int
    var v = prolog_vm()
    val was = enter(&v)
    var halted: Option[int] = None

    // `read/1` in a query reads the lines that follow it, as the queries are read.
    v.input = line

    for f in files
        if halted.is_none() then halted = consult_named(&v, f, say)

    val status = halted match
        Some(n) -> n
        None -> answer_queries(&v, line, say)

    dispose_vm(&v)
    leave(was)
    status
end toplevel

// Answer queries on `v`, the machine in charge, until `halt` or the end of input: the status to exit
// with. The `prolog` executable's session after its files are consulted, and `funl file.pl`'s after
// the file is loaded.
answer_queries(v: *Vm, line: &Fn(string) -> Option[string], say: &Fn(string) -> unit) -> int
    v.input = line

    loop
        val text = read_query(line) match
            Some(t) -> t
            None -> return 0

        if text.trim().is_empty() then continue

        query(v, text, line, say) match
            Some(code) -> return code
            None -> ()
end answer_queries

// One query's text: lines read until one ends in `.`, the first under `?- ` and the rest under a
// continuation prompt. `None` at the end of input.
private read_query(line: &Fn(string) -> Option[string]) -> Option[string]
    var text = ""
    var prompt = QueryPrompt

    loop
        val got = line(prompt) match
            Some(l) -> l
            None -> return None

        text = if text.is_empty() then got else text + "\n" + got

        val t = text.trim()

        if t.is_empty() || t.ends_with(".") then return Some(text)

        prompt = MorePrompt

// Consult the file named `file`, as `consult/1` from the top level would, saying only what goes wrong.
// `Some(status)` where a directive of the file halted.
private consult_named(v: *Vm, file: string, say: &Fn(string) -> unit) -> Option[int]
    val at = point(0)
    var args: Buf[&Term] = buf()

    args.push(term(TAtom(intern(file)), at))
    solve(v, ReadClause(term(TComp(intern("consult"), args), at), buf()), buf(), (p) -> None, say, true)

// Answer the query `text`. `Some(status)` where it ran `halt` or `halt(N)`, ending the session.
private query(v: *Vm, text: string, line: &Fn(string) -> Option[string], say: &Fn(string) -> unit) -> Option[int]
    val src = source_of("user", text)
    var report = full_report()
    var r = pl_reader(src, &report)

    val c = next_clause(&r) match
        Clause(c) -> c
        _ ->
            if !report.is_empty() then say(report.render(src).trim())
            return None

    if report.has_errors()
        say(report.render(src).trim())
        return None

    // The variables an answer reads: every one the query named. A `_`-prefixed one is not shown as a
    // binding of its own, but an unbound one keeps its name where it appears (`answer_of`).
    var shown: Buf[usize] = buf()

    for i in 0..<c.names.len()
        if c.names.at(i) != "_" then shown.push(i)

    solve(v, c, shown, line, say, false)
end query

// Run `c` and say its answers, the variables of `shown` bound in each. `quiet` says nothing of a
// success and asks for no second one: what consulting a file at start-up wants. `Some(status)` where
// the goal ran `halt`, what it wrote before that said first.
private solve(v: *Vm, c: ReadClause, shown: Buf[usize], line: &Fn(string) -> Option[string], say: &Fn(string) -> unit, quiet: bool) -> Option[int]
    val chunk = compile_toplevel(c, shown.view()) match
        Ok(e) -> finish(e) match
            Ok(at) -> at
            Err(m) ->
                say(s"error: $m")
                return None
        Err(p) ->
            say(s"error: ${p.message}")
            return None

    var outcome = run(v, chunk)

    loop
        said(v, say)

        outcome match
            Halted(n) -> return Some(n)
            Failed ->
                say(if quiet then s"Warning: ${render(term_value_of(c))} failed" else "false.")
                break
            Faulted(m) ->
                say(s"error: $m")
                break
            Succeeded ->
                val top = v.stack.len()
                val base = top - shown.len() - 1
                val ball = deref(v.stack.at(base))

                ball match
                    Var(_) -> ()
                    _ ->
                        say(s"uncaught exception: ${exception_text(ball)}")
                        break

                if quiet then break

                var names: Buf[string] = buf()
                var vals: Buf[Value] = buf()

                for j in 0..<shown.len()
                    names.push(c.names.at(shown.at(j)))
                    vals.push(deref(v.stack.at(base + 1 + j)))

                val answer = answer_of(names, vals)

                if !resumable(v)
                    say(answer + ".")
                    break

                say(answer)

                val reply = line("") match
                    Some(l) -> l.trim()
                    None -> break

                if reply != ";" then break

                outcome = resume(v)
    end loop

    settle(v)
    None
end solve

// The goal a quiet run was handed, for a warning.
private term_value_of(c: ReadClause) -> Value
    var vars: Buf[Value] = buf()

    term_value(c.t, &vars).unwrap_or(Undefined)

// The answer the query's variables `names` make, bound to `vals`, as SWI-Prolog's top level writes it.
//
// **Variables with the same value are written as one chain**: `X = Y, Y = a`, or `X = Y, Y = Z`
// where they are all unbound, the chains in the order of their first variable. An unbound variable is
// written as the last name of its chain wherever it appears -- `X = f(Z), Y = Z` -- and a lone one
// says nothing. A `_`-prefixed variable is never the left side of a binding, but keeps its name where
// it appears. **Every other unbound variable is `_` where it appears once in the whole answer**, and
// `_A`, `_B`, ... where it appears more than once, skipping the query's own names:
//
//     ?- copy_term(f(A, A, B), T).
//     T = f(_A, _A, _).
private answer_of(names: Buf[string], vals: Buf[Value]) -> string
    var group: Buf[usize] = buf()

    for j in 0..<vals.len()
        var g = j

        for k in 0..<j
            if group.at(k) == k && same_value(vals.at(k), vals.at(j))
                g = k
                break

        group.push(g)

    var vn = var_names()

    for g in 0..<vals.len()
        if group.at(g) == g
            vals.at(g) match
                Var(p) ->
                    var last = g

                    for j in g..<vals.len()
                        if group.at(j) == g then last = j

                    vn.ids.push(p.id)
                    vn.names.push(names.at(last))
                _ -> ()

    // Written once to see how often each unnamed variable appears, then named and written again.
    answer_text_of(names, vals, group, &vn)

    var made: long = 0

    for i in 0..<vn.unnamed.len()
        val id = vn.unnamed.at(i)

        if var_named(&vn, id).is_none()
            var times = 0

            for k in 0..<vn.unnamed.len()
                if vn.unnamed.at(k) == id then times += 1

            if times == 1
                vn.ids.push(id)
                vn.names.push("_")
            else
                loop
                    val name = "_" + var_name(made)

                    made += 1

                    if !names_one(names, name)
                        vn.ids.push(id)
                        vn.names.push(name)
                        break

    vn.unnamed.truncate(0)
    answer_text_of(names, vals, group, &vn)
end answer_of

// Whether the query names a variable `name`.
private names_one(names: Buf[string], name: string) -> bool
    for n in names.view()
        if n == name then return true

    false

// Whether two values of the query's variables are one chain: the same unbound variable, or bound
// terms that are identical.
private same_value(a: Value, b: Value) -> bool
    a match
        Var(p) ->
            b match
                Var(q) -> p.id == q.id
                _ -> false
        _ ->
            b match
                Var(_) -> false
                _ -> compare_terms(a, b) == 0

// The answer's text, with the variable names `vn` gives (`answer_of`).
private answer_text_of(names: Buf[string], vals: Buf[Value], group: Buf[usize], vn: *VarNames) -> string
    var parts: Buf[string] = buf()
    var factored = Factored(buf(), buf())

    for g in 0..<vals.len()
        if group.at(g) != g then continue

        var chain: Buf[usize] = buf()
        var last = g

        for j in g..<vals.len()
            if group.at(j) == g
                last = j

                if !names.at(j).starts_with("_") then chain.push(j)

        if chain.len() == 0 then continue

        var text = ""

        vals.at(g) match
            Var(_) ->
                if names.at(last).starts_with("_") then chain.push(last)

                if chain.len() < 2 then continue

                for i in 0..<chain.len() - 1
                    if i > 0 then text += ", "

                    text += s"${names.at(chain.at(i))} = ${names.at(chain.at(i + 1))}"
            _ ->
                for i in 0..<chain.len() - 1
                    text += s"${names.at(chain.at(i))} = ${names.at(chain.at(i + 1))}, "

                text += binding_text(names.at(chain.at(chain.len() - 1)), vals.at(g), &factored, vn)

        parts.push(text)

    if parts.len() == 0 then "true" else join(parts.view(), ",\n")
end answer_text_of

// A term as an answer writes it: quoted, so it reads back as the same term.
private answer_text(x: Value) -> string = term_text(x, write_opts(true, false, true))

// The nodes where a cycle closes that an answer has named so far, and their names.
private struct Factored
    nodes: Buf[usize]
    names: Buf[string]

// The name the answer gave node `a`, if it has.
private factored_name(f: *Factored, a: usize) -> Option[string]
    for i in 0..<f.nodes.len()
        if f.nodes.at(i) == a then return Some(f.names.at(i))

    None

// What variable `name`'s binding `x` is written as.
//
// **A cyclic binding is written as SWI-Prolog's top level writes one.** Where the cycle closes on the
// binding itself, the variable's own name stands for it: `X = f(X)`. Every other node where a cycle
// closes is named `_S1`, `_S2`, ... -- numbered across the whole answer, `factored` keeping them --
// and spelled out once in a `% where` block below the binding. A node an earlier binding named keeps
// its name, the binding itself among them:
//
//     X = f(_S1), % where
//         _S1 = g(_S1),
//     Y = g(_S1)
//
// The value is written as SWI-Prolog's top level writes it: quoted, a space after each comma, and
// as the right side of `=`, so an operator term above priority 699 is bracketed -- `X = (a, b)`.
private binding_text(name: string, x: Value, factored: *Factored, vn: *VarNames) -> string
    val o = answer_opts()
    val c = cycles_of(x)

    if c.heads.len() == 0 then return s"$name = ${term_text_vars(x, o, c, buf(), false, 699, vn)}"

    val root = node_of(x)
    var names: Buf[string] = buf()
    var spelled: Buf[usize] = buf()
    var own = false

    for i in 0..<c.heads.len()
        val a = node_of(c.heads.at(i))

        factored_name(factored, a) match
            Some(earlier) ->
                names.push(earlier)

                if a == root then own = true
            None ->
                // The binding's own name stands for it only where its cycle is the only one, as
                // SWI-Prolog writes `X = f(X)` but `X = _S1, % where _S1 = f(_S1, _S2), ...`.
                if a == root && c.heads.len() == 1
                    names.push(name)
                    own = true
                else
                    factored.nodes.push(a)
                    factored.names.push(cycle_name(factored.nodes.len()))
                    names.push(cycle_name(factored.nodes.len()))
                    spelled.push(i)

    var text = s"$name = ${term_text_vars(x, o, c, names, own, 699, vn)}"

    if spelled.len() > 0 then text += ", % where"

    for j in 0..<spelled.len()
        val i = spelled.at(j)

        text += s"\n    ${names.at(i)} = ${term_text_vars(c.heads.at(i), o, c, names, true, 699, vn)}"

        if j + 1 < spelled.len() then text += ","

    text
end binding_text

// An uncaught ball in ISO form: `error(Formal, _)` for an error term -- its context is the machine's
// message, which is not part of the standard term -- and the ball itself for anything else.
private exception_text(ball: Value) -> string
    deref(ball) match
        Compound(e) ->
            if atom_name(e.functor) == "error" && e.args.len() == 2
                val formal = s"error(${answer_text(e.args.at(0))},_)"

                // Text that did not read says where, and what was expected there: the reader's
                // diagnostic, which the term's message carries.
                if is_syntax_error(e.args.at(0))
                    error_message(ball) match
                        Some(m) -> return s"$formal\n${m.trim()}"
                        None -> ()

                return formal
        _ -> ()

    answer_text(ball)

private is_syntax_error(formal: Value) -> bool
    deref(formal) match
        Compound(c) -> atom_name(c.functor) == "syntax_error"
        _ -> false

// Whether failing back into the run could find another solution: a choice point, or a mark with
// somewhere to go, is still on the control stack.
private resumable(v: *Vm) -> bool
    for i in 0..<v.control.len()
        val k = v.control.at(i).kind

        if k == Choice || k == Mark then return true

    false

// What the run wrote, said and forgotten.
private said(v: *Vm, say: &Fn(string) -> unit)
    for l in v.output.view()
        say(l)

    v.output.truncate(0)

// Commit to the answer the session stopped at: nothing the query left can be resumed, and nothing it
// bound will be undone, so the machine is empty for the next query.
private settle(v: *Vm)
    cut_to(v, 0, true)
    v.trail.truncate(0)
    v.saved.truncate(0)
    v.stack.truncate(0)
    v.mark = NoMark
