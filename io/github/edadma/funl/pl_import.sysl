module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.Buf
import sysl.text.Search

// `:- import("file.funl")`: a Prolog file loading a FunL module (`prolog.md` § "Calling FunL from
// Prolog"). A `.lfunl` file is literate FunL, tangled first.
//
// **The module is compiled as the Prolog file is read**, so its exports are predicates before the
// Prolog file's own clauses are defined: an exported relation `r` of `n` arguments is `r/n`, an
// exported function `f` of `n` parameters `f/(n+1)`, under the namespace's rules -- a key another
// file holds is refused naming both, the Prolog file's own clauses for a key the module took among
// them. **What the module does not export, Prolog does not see**, as a FunL importer does not. **Its
// top level runs where the directive stands** among the file's directives, and its frame stays for
// the module's functions to reach its variables, as a program's top level stays for the program's.
//
// The path is read relative to the directory of the Prolog file, as FunL's `import "file.pl"` reads
// its own, and a module the VM has already loaded -- by this import, another, or a FunL `import` -- is
// not loaded again: consulting the Prolog file again is among the ways that happens.

// Carry out `:- import(File)` in Prolog file `src`, its top level a step of `goals`; answers why the
// load is refused, given `why` so far.
//
// **A string is a file and an atom is a package**, as FunL's quoted path and bare word are:
// `:- import(tabular).` reaches the package's `main`, and `:- import(tabular/pivot).` -- the compound
// `/(tabular, pivot)`, standard Prolog's own module notation -- one of its listed modules. A package's
// Prolog file is loaded whole, its directives run where the directive stands.
import_directive(src: Source, report: *Report, named: &Term, goals: *Buf[LoadStep], why: Refusal) -> Refusal
    val spec = named.kind match
        TStr(s) -> s
        TAtom(id) ->
            val a = atom_name(id)

            if a.starts_with("funl:") then a else return package_directive(src, report, named, a, goals, why)
        TComp(f, args) ->
            val (pkg, m) = if atom_name(f) == "/" && args.len() == 2 then (args.at(0).kind, args.at(1).kind) else (TNil, TNil)

            (pkg, m) match
                (TAtom(a), TAtom(b)) -> return package_directive(src, report, named, s"${atom_name(a)}/${atom_name(b)}", goals, why)
                _ ->
                    report.add(error(named.span, "import names a file with a string, or a package with an atom: `tabular`, `tabular/pivot`"))
                    return why
        _ ->
            report.add(error(named.span, "import names a file with a string, or a package with an atom: `tabular`, `tabular/pivot`"))
            return why

    if spec == "funl:prelude" then return prolog_prelude(named.span, report, goals, why)

    if spec.starts_with("funl:") then return prolog_builtin_module(spec.slice(5, spec.len), named.span, report, why)

    funl_import(module_path(src.name, spec), named, report, goals, why)
end import_directive

// The FunL module in `file` loaded for the directive naming it, its exports made predicates.
private funl_import(file: string, named: &Term, report: *Report, goals: *Buf[LoadStep], why: Refusal) -> Refusal
    val had = report.has_errors()

    load_module(file, named.span, report) match
        Ok(l) ->
            if l.fresh then goals.push(RunChunk(current().modules.at(l.index).chunk))

            prolog_exports(l.index, named.span, report, why)
        Err(r) -> if had then why else r

// `:- import(tabular)` and `:- import(tabular/pivot)`: package specifier `spec`, resolved as FunL's
// bare word is.
private package_directive(src: Source, report: *Report, named: &Term, spec: string, goals: *Buf[LoadStep], why: Refusal) -> Refusal
    val had = report.has_errors()

    resolve_package(src.name, spec, named.span, report) match
        Some(FunlTarget(file)) -> funl_import(file, named, report, goals, why)
        Some(PlTarget(file)) ->
            imported_file(file, named.span, report) match
                Some(chunk) -> goals.push(RunChunk(chunk))
                None -> ()

            if had || !report.has_errors() then why else Unreadable
        None -> if had then why else Unreadable
