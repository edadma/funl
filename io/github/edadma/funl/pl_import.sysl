module io.github.edadma.funl

import sh.sysl.parsing.*
import sysl.buf.Buf
import sysl.text.Search

// `:- import("file.funl")`: a Prolog file loading a FunL module (`prolog.md` § "Calling FunL from
// Prolog"). A `.lfunl` file is literate FunL, tangled first.
//
// **The module is compiled as the Prolog file is read**, so its exports are predicates before the
// Prolog file's own clauses are defined: an exported relation `r` of `n` arguments is `r/n`, an
// exported function `f` of `n` parameters `f/(n+1)`, under the namespace's rules -- a key another
// file holds is refused naming both, the Prolog file's own clauses for a key the module took among
// them. **What the module does not export, Prolog does not see**, as a FunL importer does not. **Its
// top level runs where the directive stands** among the file's directives, and its frame stays for
// the module's functions to reach its variables, as a program's top level stays for the program's.
//
// The path is read relative to the directory of the Prolog file, as FunL's `import "file.pl"` reads
// its own, and a module the VM has already loaded -- by this import, another, or a FunL `import` -- is
// not loaded again: consulting the Prolog file again is among the ways that happens.

// Carry out `:- import(File)` in Prolog file `src`, its top level a step of `goals`; answers why the
// load is refused, given `why` so far.
import_directive(src: Source, report: *Report, named: &Term, goals: *Buf[LoadStep], why: Refusal) -> Refusal
    val given = named.kind match
        TStr(s) -> s
        TAtom(id) -> atom_name(id)
        _ ->
            report.add(error(named.span, "import names its file with a string"))
            return why

    if given.starts_with("funl:") then return prolog_builtin_module(given.slice(5, given.len), named.span, report, why)

    val file = module_path(src.name, given)
    val had = report.has_errors()

    load_module(file, named.span, report) match
        Ok(l) ->
            if l.fresh then goals.push(RunChunk(current().modules.at(l.index).chunk))

            prolog_exports(l.index, named.span, report, why)
        Err(r) -> if had then why else r
end import_directive
