module io.github.edadma.funl

import sh.sysl.dal
import sh.sysl.dal.Number
import sysl.math.{checked_add, checked_mul, checked_sub, Float}

// FunL's arithmetic and ordering operators. `+` on a list or a range is `list_add` (`seq.sysl`), and
// `+` and `-` on a set or a map are `combined` and `removed` (`data.sysl`).
//
// **Numbers are `dal`'s tower under FunL's policy** (`number.sysl`): an integer that overflows grows
// into a big one, `7 / 2` is the rational `7/2`, an exact result is demoted to the smallest kind that
// holds it, and a real appears only where a literal or an operation brings one in. **Two 64-bit
// integers are added, subtracted, multiplied and compared here without entering the tower**, since
// that is what nearly every operation in a running program is.

enum BinOp
    Add
    Sub
    Mul

    // `/`: exact division.
    Quo

    // `\`: integer division, which floors: the quotient rounded toward negative infinity, never
    // toward zero, so `-7 \ 2` is `-4`.
    IntQuo

    // `//`: floor division, the same quotient as `\`.
    FloorQuo

    // `%`: the remainder, with the sign of the dividend.
    Rem

    // `mod`: the modulus, with the sign of the divisor.
    Modulo

    // `a div b`: succeeds producing `b` when `a` divides it.
    Divides

    Pow
    Lt
    Le
    Gt
    Ge
end BinOp

// How the operator is written, for a message.
op_text(o: BinOp) -> string
    o match
        Add -> "+"
        Sub -> "-"
        Mul -> "*"
        Quo -> "/"
        IntQuo -> "\\"
        FloorQuo -> "//"
        Rem -> "%"
        Modulo -> "mod"
        Divides -> "div"
        Pow -> "^"
        Lt -> "<"
        Le -> "<="
        Gt -> ">"
        Ge -> ">="

// `a op b`: the value, `None` when the operation fails (an ordering that does not hold, a `div`
// that does not divide), or an error.
arith(o: BinOp, a: Value, b: Value) -> Result[Option[Value], Fault]
    val x = deref(a)
    val y = deref(b)

    o match
        Lt -> return ordered(o, x, y)
        Le -> return ordered(o, x, y)
        Gt -> return ordered(o, x, y)
        Ge -> return ordered(o, x, y)
        Add ->
            if is_seq(x) then return Ok(Some(list_add(x, y)?))

            if combines(x) then return Ok(Some(combined(x, y)?))

            if is_str(x) || is_str(y) then return Ok(Some(new_str(render(x) + render(y))?))
        Sub -> if combines(x) then return Ok(Some(removed(x, y)?))
        _ -> ()

    // The fast path: two 64-bit integers whose sum, difference or product is one too.
    x match
        Int(n) -> y match
            Int(m) ->
                val quick = o match
                    Add -> checked_add(n, m)
                    Sub -> checked_sub(n, m)
                    Mul -> checked_mul(n, m)
                    _ -> None

                quick match
                    Some(r) -> return Ok(Some(Int(r)))
                    None -> ()
            _ -> ()
        _ -> ()

    val n = num_operand(o, x)?
    val m = num_operand(o, y)?
    val p = funl_policy()

    val r = o match
        Add -> p.add(n, m)
        Sub -> p.sub(n, m)
        Mul -> p.mul(n, m)
        Quo -> p.div(n, m)
        IntQuo -> p.floor_div(n, m)
        FloorQuo -> p.floor_div(n, m)
        Rem -> p.rem(n, m)
        Modulo -> p.modulo(n, m)
        Divides -> return divides(x, y, n, m)
        Pow -> powered(p, n, m)
        _ -> return Err(Broken(s"'${op_text(o)}' reached arithmetic"))

    Ok(Some(num_answer(r, op_text(o), x, y)?))
end arith

// `a ^ b`: exact for an exact base and an integer power, and a real otherwise. A real or fractional
// power is C's `pow` on the two as reals, so `2 ^ 0.5` is the square root of 2 and `4 ^ (1/2)` is
// `2.0`. Zero to a negative power divides by zero whatever the kinds, and a power with no real value
// (a negative base to a fractional power) is refused, as every non-finite real is.
private powered(p: dal.Policy, n: Number, m: Number) -> Result[Number, dal.NumberError]
    val fractional = m match
        Number.Real(_) -> true
        Number.Rat(r) -> !r.is_integer()
        _ -> false

    if !fractional then return p.pow(n, m)

    val b = dal.to_real(n)
    val e = dal.to_real(m)

    if b == 0.0 && e < 0.0 then return Err(dal.NumberError.DivisionByZero)

    p.admit(Number.Real(b.pow(e)))

// `a div b`: `b` when integer `a` divides integer `b`, which only 0 does of 0.
private divides(x: Value, y: Value, a: Number, b: Number) -> Result[Option[Value], Fault]
    if !is_int(x) || !is_int(y)
        val culprit = non_integer(x, y)

        return Err(type_error("integer", culprit, s"'div' asks whether one integer divides another, and was given ${described(culprit)}"))

    if dal.sign(a) == 0 then return Ok(if dal.sign(b) == 0 then Some(y) else None)

    val r = num_result(funl_policy().rem(b, a), s"${render(y)} % ${render(x)}", x)?

    r match
        Int(k) -> Ok(if k == 0 then Some(y) else None)
        _ -> Ok(None)

// Prefix `-`.
negate(a: Value) -> Result[Value, Fault]
    val x = deref(a)

    x match
        Int(n) -> if n != -9223372036854775807 - 1 then return Ok(Int(-n))
        Var(_) -> return Err(instantiation_error("instantiation error: '-' was given an unbound variable"))
        _ -> ()

    num_of(x) match
        Some(n) -> num_result(funl_policy().neg(n), s"-(${render(x)})", x)
        None -> Err(type_error("number", x, s"'-' wants a number and was given ${described(x)}"))

private is_str(x: Value) -> bool = x match
    Str(_) -> true
    _ -> false

private num_operand(o: BinOp, x: Value) -> Result[Number, Fault]
    num_of(x) match
        Some(n) -> Ok(n)
        None -> x match
            Var(_) -> Err(unbound_operand(o))
            _ -> Err(type_error("number", x, s"'${op_text(o)}' wants numbers and was given ${described(x)}"))

private unbound_operand(o: BinOp) -> Fault =
    instantiation_error(s"instantiation error: '${op_text(o)}' was given an unbound variable")

// A value as a message names it: its kind, and what it prints as.
described(x: Value) -> string
    deref(x) match
        Int(n) -> s"the integer $n"
        Big(_) -> s"the integer ${render(x)}"
        Rat(_) -> s"the rational ${render(x)}"
        Real(_) -> s"the real ${render(x)}"
        Str(p) -> s"the string '${p.s}'"
        Unit -> "()"
        Undefined -> "undefined"
        Func(_) -> "a function"
        Atom(id) -> if is_boolean_atom(id) then atom_name(id) else s"the atom ${render(x)}"
        Nil -> "the empty list"
        Cons(_) -> s"the list ${render(x)}"
        Tuple(_) -> s"the tuple ${render(x)}"
        Compound(_) -> s"the record ${render(x)}"
        Range(_) -> s"the range ${render(x)}"
        Ctor(_) -> "a record constructor"
        CSet(_) -> "a cset"
        Var(_) -> "an unbound variable"
        y -> render(y)

// Whether ordering `o` holds of a three-way comparison's answer.
private holds(o: BinOp, c: int) -> bool
    o match
        Lt -> c < 0
        Le -> c <= 0
        Gt -> c == 1
        _ -> c == 0 || c == 1

// An ordering: numbers by value across kinds, exactly, and strings by their bytes. A NaN is in no
// order with anything, so every ordering of one fails.
private ordered(o: BinOp, x: Value, y: Value) -> Result[Option[Value], Fault]
    val c: int = x match
        Int(n) -> y match
            Int(m) -> if n < m then -1 elif n > m then 1 else 0
            _ -> num_order(o, x, y)?
        Str(p) -> y match
            Str(q) -> if p.s < q.s then -1 elif p.s > q.s then 1 else 0
            _ -> return Err(mismatch(o, x, y, "string", y))
        Var(_) -> return Err(unbound_operand(o))
        _ -> num_order(o, x, y)?

    Ok(if holds(o, c) then Some(y) else None)

// Two values an ordering compares as numbers; a NaN compares as 2, which no ordering holds of.
private num_order(o: BinOp, x: Value, y: Value) -> Result[int, Fault]
    val a = num_of(x) match
        Some(n) -> n
        None -> return Err(mismatch(o, x, y, "number", x))

    val b = num_of(y) match
        Some(n) -> n
        None -> return Err(mismatch(o, x, y, "number", y))

    Ok(dal.compare(a, b).unwrap_or(2))

// Two values an ordering cannot compare: `type_error(Kind, Culprit)`, the culprit the operand that is
// not the kind the other one, or an ordering, wants.
private mismatch(o: BinOp, x: Value, y: Value, kind: string, culprit: Value) -> Fault =
    y match
        Var(_) -> unbound_operand(o)
        _ -> type_error(kind, culprit, s"'${op_text(o)}' cannot compare ${described(x)} with ${described(y)}")
