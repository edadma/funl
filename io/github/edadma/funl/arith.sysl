module io.github.edadma.funl

import sysl.math.{checked_add, checked_mul, checked_sub}

// FunL's arithmetic and ordering operators. `+` on a list or a range is `list_add` (`seq.sysl`), and
// `+` and `-` on a set or a map are `combined` and `removed` (`data.sysl`).
//
// **Numbers are 64-bit integers here, and a result that is not one is refused, never rounded or
// wrapped**: an overflow, or a division that does not come out whole, raises an error naming the
// operation.
// The numeric tower, where those results are a bigger integer or a rational, replaces exactly
// those refusals.

enum BinOp
    Add
    Sub
    Mul

    // `/`: exact division.
    Quo

    // `\`: integer division, rounding down.
    IntQuo

    // `//`: floor division, the quotient rounded toward negative infinity. On two integers it is
    // the same quotient as `\`.
    FloorQuo

    // `%`: the remainder, with the sign of the dividend.
    Rem

    // `mod`: the modulus, with the sign of the divisor.
    Modulo

    // `a div b`: succeeds producing `b` when `a` divides it.
    Divides

    Pow
    Lt
    Le
    Gt
    Ge
end BinOp

// How the operator is written, for a message.
op_text(o: BinOp) -> string
    o match
        Add -> "+"
        Sub -> "-"
        Mul -> "*"
        Quo -> "/"
        IntQuo -> "\\"
        FloorQuo -> "//"
        Rem -> "%"
        Modulo -> "mod"
        Divides -> "div"
        Pow -> "^"
        Lt -> "<"
        Le -> "<="
        Gt -> ">"
        Ge -> ">="

// `a op b`: the value, `None` when the operation fails (an ordering that does not hold, a `div`
// that does not divide), or an error.
arith(o: BinOp, a: Value, b: Value) -> Result[Option[Value], Fault]
    val x = deref(a)
    val y = deref(b)

    o match
        Lt -> return ordered(o, x, y)
        Le -> return ordered(o, x, y)
        Gt -> return ordered(o, x, y)
        Ge -> return ordered(o, x, y)
        Add ->
            if is_seq(x) then return Ok(Some(list_add(x, y)?))

            if combines(x) then return Ok(Some(combined(x, y)?))

            if is_str(x) || is_str(y) then return Ok(Some(new_str(render(x) + render(y))?))
        Sub -> if combines(x) then return Ok(Some(removed(x, y)?))
        _ -> ()

    val n = int_operand(o, x)?
    val m = int_operand(o, y)?

    val r: long = o match
        Add -> fits(o, n, m, checked_add(n, m))?
        Sub -> fits(o, n, m, checked_sub(n, m))?
        Mul -> fits(o, n, m, checked_mul(n, m))?
        Quo ->
            nonzero(o, n, m)?

            if n % m != 0 then return Err(not_whole(s"$n / $m"))

            fits(o, n, m, if n == -9223372036854775807 - 1 && m == -1 then None else Some(n / m))?
        IntQuo ->
            nonzero(o, n, m)?
            fits(o, n, m, floor_quo(n, m))?
        FloorQuo ->
            nonzero(o, n, m)?
            fits(o, n, m, floor_quo(n, m))?
        Rem ->
            nonzero(o, n, m)?

            if m == -1 then 0 else n % m
        Modulo ->
            nonzero(o, n, m)?

            if m == -1 then 0 else floor_mod(n, m)
        Divides ->
            if n == 0 then return Ok(if m == 0 then Some(Int(m)) else None)

            if n == -1 || m % n == 0 then return Ok(Some(Int(m)))

            return Ok(None)
        Pow -> power(n, m)?
        _ -> return Err(Broken(s"'${op_text(o)}' reached integer arithmetic"))

    Ok(Some(Int(r)))
end arith

// Prefix `-`.
negate(a: Value) -> Result[Value, Fault]
    deref(a) match
        Int(n) ->
            if n == -9223372036854775807 - 1 then return Err(overflow(s"-($n)"))

            Ok(Int(-n))
        Var(_) -> Err(instantiation_error("instantiation error: '-' was given an unbound variable"))
        x -> Err(type_error("number", x, s"'-' wants a number and was given ${described(x)}"))

private is_str(x: Value) -> bool = x match
    Str(_) -> true
    _ -> false

private int_operand(o: BinOp, x: Value) -> Result[long, Fault]
    x match
        Int(n) -> Ok(n)
        Var(_) -> Err(unbound_operand(o))
        _ -> Err(type_error("number", x, s"'${op_text(o)}' wants numbers and was given ${described(x)}"))

private unbound_operand(o: BinOp) -> Fault =
    instantiation_error(s"instantiation error: '${op_text(o)}' was given an unbound variable")

// A result past 64 bits: `evaluation_error(int_overflow)`.
private overflow(what: string) -> Fault =
    evaluation_error("int_overflow", s"$what does not fit in 64 bits, and only integers are built")

// A result that is not a whole number, which the machine has no way to hold until it has rationals:
// `representation_error(rational)`.
private not_whole(what: string) -> Fault =
    representation_error("rational", s"$what is not a whole number, and only integers are built")

// A value as a message names it: its kind, and what it prints as.
described(x: Value) -> string
    deref(x) match
        Int(n) -> s"the integer $n"
        Str(p) -> s"the string '${p.s}'"
        Bool(b) -> if b then "true" else "false"
        Unit -> "()"
        Undefined -> "undefined"
        Func(_) -> "a function"
        Var(_) -> "an unbound variable"
        y -> render(y)

private fits(o: BinOp, n: long, m: long, r: Option[long]) -> Result[long, Fault]
    r match
        Some(x) -> Ok(x)
        None -> Err(overflow(s"$n ${op_text(o)} $m"))

private nonzero(o: BinOp, n: long, m: long) -> Result[unit, Fault]
    if m == 0 then return Err(evaluation_error("zero_divisor", s"$n ${op_text(o)} 0 divides by zero"))

    Ok(())

private floor_quo(n: long, m: long) -> Option[long]
    if n == -9223372036854775807 - 1 && m == -1 then return None

    val q = n / m

    if n % m != 0 && (n < 0) != (m < 0) then Some(q - 1) else Some(q)

private floor_mod(n: long, m: long) -> long
    val r = n % m

    if r != 0 && (r < 0) != (m < 0) then r + m else r

// `n ^ m` by squaring, refusing a negative exponent and a result past 64 bits.
private power(n: long, m: long) -> Result[long, Fault]
    if m < 0 then return Err(not_whole(s"$n ^ $m"))

    var result: long = 1
    var base = n
    var e = m

    loop
        if e % 2 == 1
            result = checked_mul(result, base) match
                Some(r) -> r
                None -> return Err(overflow(s"$n ^ $m"))

        e = e / 2

        if e == 0 then break

        base = checked_mul(base, base) match
            Some(r) -> r
            None -> return Err(overflow(s"$n ^ $m"))

    Ok(result)
end power

// Whether ordering `o` holds of a three-way comparison's answer.
private holds(o: BinOp, c: int) -> bool
    o match
        Lt -> c < 0
        Le -> c <= 0
        Gt -> c > 0
        _ -> c >= 0

// An ordering: integers by value, strings by their bytes.
private ordered(o: BinOp, x: Value, y: Value) -> Result[Option[Value], Fault]
    val c: int = x match
        Int(n) -> y match
            Int(m) -> if n < m then -1 elif n > m then 1 else 0
            _ -> return Err(mismatch(o, x, y, "integer", y))
        Str(p) -> y match
            Str(q) -> if p.s < q.s then -1 elif p.s > q.s then 1 else 0
            _ -> return Err(mismatch(o, x, y, "string", y))
        Var(_) -> return Err(unbound_operand(o))
        _ -> return Err(mismatch(o, x, y, "number", x))

    Ok(if holds(o, c) then Some(y) else None)

// Two values an ordering cannot compare: `type_error(Kind, Culprit)`, the culprit the operand that is
// not the kind the other one, or an ordering, wants.
private mismatch(o: BinOp, x: Value, y: Value, kind: string, culprit: Value) -> Fault =
    y match
        Var(_) -> unbound_operand(o)
        _ -> type_error(kind, culprit, s"'${op_text(o)}' cannot compare ${described(x)} with ${described(y)}")
