module io.github.edadma.funl

import sh.sysl.gc
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// The machine's state, and the one way to reach it.
//
// **Every per-VM thing the runtime owns is a field of `Vm`**, reached through `current()`, and the
// census in `tests_vm_state.sysl` refuses a module-level `var` that is not `the_vm` or marked
// process-wide with a reason. A second VM in the same process is then a second `Vm` and an `enter`.

// The innermost-mark register's value when no mark is open.
const NoMark: usize = 4294967295

struct Vm
    // -- the machine (`vm.md`) ------------------------------------------------------------------------

    chunks: Buf[Chunk]

    // The running chunk, and the next instruction in it.
    code: usize
    ip: usize

    stack: Buf[Value]
    frame: *FrameObj

    // The top level's frame: the static link of every function defined at the top level, whatever
    // frame calls it -- a relation's frames have no static chain to reach it by.
    globals: *FrameObj

    // Marks, choice points and restore points, and the operand cells they saved, in step.
    control: Buf[Entry]
    saved: Buf[Value]

    // What failure has to put back that the control entries do not already save.
    trail: Buf[Undo]

    // Index in `control` of the innermost mark, or `NoMark`.
    mark: usize

    // Bumped by every entry pushed; dates logic variables against the control stack.
    stamp: u64

    // The scan state: the string `s ? e` is scanning, `Undefined` outside every scan, and the position
    // in it, a character position counted from 1. Changed only through `set_scan`, which trails the
    // change as a reversible assignment.
    subject: Value
    pos: usize

    // The scan state each open scan replaced, innermost last: what its `ScanEnd`, or a `return`,
    // `break`, `continue` or `yield` leaving it, puts back.
    scans: Buf[ScanSaved]

    // What each capture group of the regex matched last, group 0 the whole match. Changed only through
    // `set_capture`, which trails the old span.
    captures: Buf[GroupSpan]

    // The character classes the program's regexes test, by the index a `Class` instruction carries.
    classes: Buf[RxClass]

    // Unification's work list, empty between instructions.
    work: Buf[Value]

    // How many variables have been made, which is what the next one prints as.
    var_count: u64

    // -- names and builtins -----------------------------------------------------------------------------

    atom_names: Buf[string]
    atom_ids: Map[string, u32]
    natives: Buf[Native]

    // Every `data` constructor the program declares, by the id its `Ctor` values and records carry.
    ctors: Buf[CtorDef]

    // What `write` printed, a line per call.
    output: Buf[string]

    // A line Prolog's `write/1` has begun and `nl/0` has not yet ended.
    line: string

    // -- Prolog (`pl_load.sysl`, `pl_ops.sysl`) ----------------------------------------------------

    // Every predicate a call by name and arity can reach -- a Prolog predicate, a FunL relation `r/n`,
    // a FunL function `f/(n+1)`, a builtin -- by its key `name/arity`.
    preds: Map[string, PredInfo]

    // The operators the Prolog reader knows, by name, one table per position.
    prefix_ops: Map[string, PlOp]
    infix_ops: Map[string, PlOp]
    postfix_ops: Map[string, PlOp]

    // The clauses of the dynamic predicates, and the generation counter they are dated by
    // (`pl_db.sysl`).
    db: Db

    // -- the heap (`collector.sysl`) ------------------------------------------------------------------

    block: *u8
    heap: gc.Heap

    // Bytes allocated since the last collection, and the figure that triggers the next one.
    allocated: usize
    threshold: usize

    // The lowest the threshold may fall, and what it is raised to as a multiple of what survived.
    floor: usize
    growth: usize

    collections: usize

    // The most entries the control stack has held at once: what shows that a recursion the index
    // made deterministic runs in constant control space.
    control_peak: usize
end Vm

// A scan state saved while a scan replaces it.
struct ScanSaved
    subject: Value
    pos: usize

// What a capture group matched: the character positions it began and ended at, counted from 1 as
// the scan position is -- or, `start` 0, nothing.
struct GroupSpan
    start: usize
    end: usize

extern malloc(bytes: usize) -> *u8
extern free(block: *u8)

// A machine with nothing in it but its builtins, over a heap of `heap_bytes` of its own.
//
// `floor` and `growth` schedule the collector (see `maybe_collect`). A floor of 0 and a growth of 0
// collect before every instruction, which is the suite's stress setting.
new_vm(heap_bytes: usize, floor: usize, growth: usize) -> Vm
    val block = malloc(heap_bytes)

    if block == null then panic("funl could not take a heap of the size this VM asked for")

    var v = Vm(
        buf(), 0, 0, buf(), null, null, buf(), buf(), buf(), NoMark, 0, Undefined, 1, buf(), buf(), buf(), buf(), 0,
        buf(), map(), buf(), buf(), buf(), "", map(), map(), map(), map(), new_db(),
        block, gc.heap(block, heap_bytes), 0, floor, floor, growth, 0, 0)

    install_natives(&v)
    install_ops(&v)
    install_library(&v)
    v
end new_vm

// Give a VM's heap back, running every finalizer still outstanding.
dispose_vm(v: *Vm)
    gc.dispose(&v.heap)
    free(v.block)
    v.block = null

// The one module-level `var` the runtime keeps: a POINTER to the VM in charge.
private var the_vm: *Vm = null

// The VM in charge. **A pointer, so a caller writes through it.**
current() -> *Vm
    if the_vm == null then panic("funl: no VM has been entered")

    the_vm

// Run what follows on `v`, and answer the VM that was in charge, for `leave`.
enter(v: *Vm) -> *Vm
    val was = the_vm

    the_vm = v
    was

leave(was: *Vm)
    the_vm = was
