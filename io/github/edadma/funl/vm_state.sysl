module io.github.edadma.funl

import sh.sysl.gc
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.rand.{Rng, rng}

// The machine's state, and the one way to reach it.
//
// **Every per-VM thing the runtime owns is a field of `Vm`**, reached through `current()`, and the
// census in `tests_vm_state.sysl` refuses a module-level `var` that is not `the_vm` or marked
// process-wide with a reason. A second VM in the same process is then a second `Vm` and an `enter`.

// The heap a program runs in, and the collector's schedule over it: what both executables, `funl`
// and `prolog`, give their machine. The benchmark tests run on it too.
const HeapBytes: usize = 268435456
const CollectFloor: usize = 4194304
const Growth: usize = 2

// The innermost-mark register's value when no mark is open.
const NoMark: usize = 4294967295

struct Vm
    // -- the machine (`vm.md`) ------------------------------------------------------------------------

    chunks: Buf[Chunk]

    // The running chunk, and the next instruction in it.
    code: usize
    ip: usize

    stack: Buf[Value]
    frame: *FrameObj

    // The top level's frame: the static link of every function defined at the top level, whatever
    // frame calls it -- a relation's frames have no static chain to reach it by.
    globals: *FrameObj

    // Marks, choice points and restore points, and the operand cells they saved, in step.
    control: Buf[Entry]
    saved: Buf[Value]

    // What failure has to put back that the control entries do not already save.
    trail: Buf[Undo]

    // Index in `control` of the innermost mark, or `NoMark`.
    mark: usize

    // Bumped by every entry pushed; dates logic variables against the control stack.
    stamp: u64

    // The scan state: the string `s ? e` is scanning, `Undefined` outside every scan, and the position
    // in it, a character position counted from 1. Changed only through `set_scan`, which trails the
    // change as a reversible assignment.
    subject: Value
    pos: usize

    // The scan state each open scan replaced, innermost last: what its `ScanEnd`, or a `return`,
    // `break`, `continue` or `yield` leaving it, puts back.
    scans: Buf[ScanSaved]

    // What each capture group of the regex matched last, group 0 the whole match. Changed only through
    // `set_capture`, which trails the old span.
    captures: Buf[GroupSpan]

    // The character classes the program's regexes test, by the index a `Class` instruction carries.
    classes: Buf[RxClass]

    // Unification's work list, empty between instructions.
    work: Buf[Value]

    // How many variables have been made, which is what the next one prints as.
    var_count: u64

    // -- names and builtins -----------------------------------------------------------------------------

    atom_names: Buf[string]
    atom_ids: Map[string, u32]
    natives: Buf[Native]

    // The chunk a builtin named as a value calls, by the builtin's id: made the first time a program
    // names it without calling it (`native_fn.sysl`, `value_chunk`).
    native_chunks: Map[usize, usize]

    // Every `data` constructor the program declares, by the id its `Ctor` values and records carry.
    ctors: Buf[CtorDef]

    // Every `data` type declared with `data t = c1 | c2 ...`, by the id `TypeTest.Data` carries.
    // Its name belongs to the file that declares it (`Resolved.own_types`).
    data_types: Buf[Buf[usize]]

    // What `write` printed, a line per call.
    output: Buf[string]

    // A line Prolog's `write/1` has begun and `nl/0` has not yet ended.
    line: string

    // -- Prolog (`pl_load.sysl`, `pl_ops.sysl`) ----------------------------------------------------

    // Every predicate a call by name and arity can reach -- a Prolog predicate, a FunL relation `r/n`,
    // a FunL function `f/(n+1)`, a builtin -- by its key `name/arity`.
    preds: Map[string, PredInfo]

    // The operators the Prolog reader knows, by name, one table per position.
    prefix_ops: Map[string, PlOp]
    infix_ops: Map[string, PlOp]
    postfix_ops: Map[string, PlOp]

    // The clauses of the dynamic predicates, and the generation counter they are dated by
    // (`pl_db.sysl`).
    db: Db

    // Prolog's global variables, `nb_setval/2` and `b_setval/2`: a mutable map from each name, made
    // when the first is set; `Undefined` until then.
    pl_globals: Value

    // The FunL modules loaded (`module.sysl`) -- by a FunL `import` or a Prolog `:- import` -- so
    // each is loaded once; and by the number each was compiled with, its top level's frame -- the
    // static link of its top-level functions' frames, as `globals` is the program's -- `null` until
    // that top level has run.
    modules: Buf[FunlModule]
    funl_tops: Buf[*FrameObj]

    // The files being compiled, each importing the next: what an import closing a circle names.
    loading: Buf[string]

    // The Prolog files a FunL `import "x.pl"` has loaded, so each is loaded once in the program,
    // whichever and however many files import it (`module.sysl`).
    pl_imports: Buf[string]

    // The Prolog flags a program can change (`pl_flags.sysl`).
    flags: PlFlags

    // -- the heap (`collector.sysl`) ------------------------------------------------------------------

    block: *u8
    heap: gc.Heap

    // Bytes allocated since the last collection, and the figure that triggers the next one.
    allocated: usize
    threshold: usize

    // The lowest the threshold may fall, and what it is raised to as a multiple of what survived.
    floor: usize
    growth: usize

    collections: usize

    // The most entries the control stack has held at once: what shows that a recursion the index
    // made deterministic runs in constant control space.
    control_peak: usize

    // -- front ends -----------------------------------------------------------------------------------

    // Whether a Prolog file may bring in the FunL front end with `:- import(File)`. False on the
    // standalone Prolog's machine (`prolog_vm`), which knows standard Prolog and nothing else: there
    // `import/1` is an ordinary goal, and no predicate of that name exists.
    funl_front_end: bool

    // Whether a Prolog file loaded on this machine named an `initialization/1` goal: `funl file.pl`
    // runs such a file's goals and ends, and starts the top level for any other.
    has_initialization: bool

    // -- arithmetic's `random/1` ----------------------------------------------------------------------

    // The generator, seeded from the operating system the first time `random/1` is evaluated.
    rng: Rng
    rng_seeded: bool

    // -- input (`pl_read_term.sysl`) --------------------------------------------------------------------

    // Where `read/1` takes its lines, given the prompt: standard input, or the top level's own line
    // source; and what is left of the last line read after the term taken from it.
    input: &Fn(string) -> Option[string]
    pending: string

    // -- trial unification (`trial_unify`) -------------------------------------------------------------

    // Whether every binding goes on the trail, however young its variable, so that a unification
    // tried only to see what it would bind can be taken back whole.
    trailing_all: bool

    // -- handles (`handle.sysl`) ------------------------------------------------------------------------

    // Every kind of handle registered, by the id a `HandleObj` carries.
    handle_kinds: Buf[HandleKind]

    // -- the program's own arguments (`funl:process`) ---------------------------------------------

    // What the program was given after its own name, which `funl:process`'s `args` reads: set by the
    // driver before the program is compiled.
    program_args: Buf[string]

    // -- tasks (`task.sysl`) ------------------------------------------------------------------------

    // The promise the running machine settles when its function answers: null for the top level's.
    promise: *PromiseObj

    // The machine that started the running task and waits for it to give way -- to settle or to
    // reach an `await` -- the first time; `NoMachine` once it has, and for a task the queue resumed.
    back_to: usize

    // Machines set aside, by index: those not `live` are free for the next.
    parked: Buf[Machine]

    // The machines whose awaited value is ready, in the order they became so, from `ready_head` on.
    ready: Buf[usize]
    ready_head: usize

    // The top level's machine, set aside once it has halted while tasks are still owed a turn.
    main_parked: usize

    // Promises a fault settled that nothing has awaited, reported when the program ends.
    rejected: Buf[Value]

    // The chunk a task's first frame returns to, once made.
    task_chunk: Option[usize]
end Vm

// A scan state saved while a scan replaces it.
struct ScanSaved
    subject: Value
    pos: usize

// What a capture group matched: the character positions it began and ended at, counted from 1 as
// the scan position is -- or, `start` 0, nothing.
struct GroupSpan
    start: usize
    end: usize

extern malloc(bytes: usize) -> *u8
extern free(block: *u8)

// A machine with nothing in it but its builtins, over a heap of `heap_bytes` of its own.
//
// `floor` and `growth` schedule the collector (see `maybe_collect`). A floor of 0 and a growth of 0
// collect before every instruction, which is the suite's stress setting.
new_vm(heap_bytes: usize, floor: usize, growth: usize) -> Vm
    val block = malloc(heap_bytes)

    if block == null then panic("funl could not take a heap of the size this VM asked for")

    var v = Vm(
        buf(), 0, 0, buf(), null, null, buf(), buf(), buf(), NoMark, 0, Undefined, 1, buf(), buf(), buf(), buf(), 0,
        buf(), map(), buf(), map(), buf(), buf(), buf(), "", map(), map(), map(), map(), new_db(), Undefined, buf(), buf(), buf(), buf(), pl_flags(),
        block, gc.heap(block, heap_bytes), 0, floor, floor, growth, 0, 0, true, false,
        rng(0, 0), false, (prompt) -> stdin_line(), "", false, buf(), buf(),
        null, NoMachine, buf(), buf(), 0, NoMachine, buf(), None)

    // The booleans' ids are the constants `FalseAtom` and `TrueAtom`, so they are interned first.
    v.atom_names.push("false")
    v.atom_ids.put("false", FalseAtom)
    v.atom_names.push("true")
    v.atom_ids.put("true", TrueAtom)
    install_natives(&v)
    install_ops(&v)
    install_library(&v)
    v
end new_vm

// Give a VM's heap back, running every finalizer still outstanding.
dispose_vm(v: *Vm)
    gc.dispose(&v.heap)
    free(v.block)
    v.block = null

// The one module-level `var` the runtime keeps: a POINTER to the VM in charge.
private var the_vm: *Vm = null

// The VM in charge. **A pointer, so a caller writes through it.**
current() -> *Vm
    if the_vm == null then panic("funl: no VM has been entered")

    the_vm

// Run what follows on `v`, and answer the VM that was in charge, for `leave`.
enter(v: *Vm) -> *Vm
    val was = the_vm

    the_vm = v
    was

leave(was: *Vm)
    the_vm = was
