module io.github.edadma.funl
@tests

// The Prolog builtins that inspect and build terms: the type tests, `functor/3`, `arg/3`, `=../2`,
// `copy_term/2`, `term_variables/2`, `compare/3`, `acyclic_term/1`, `cyclic_term/1`,
// `subsumes_term/2`, `unifiable/3`, `?=/2`, `numbervars/3` and `numbervars/4`, each with its errors; and the refusal
// to store a cyclic term as a clause.

private ok(text: string) -> string = text + "\nsucceeded"

// Whether `goal` succeeds, fails, or the formal term of the error it raises.
private holds(goal: string) -> string =
    ran_prolog(s":- catch(($goal -> write(yes) ; write(no)), error(F, _), writeq(F)), nl.\n")

// `goal` run, then `X` written by `writeq`; or the formal term of the error it raises.
private gives(goal: string) -> string =
    ran_prolog(s":- catch(($goal -> writeq(X) ; write(no)), error(F, _), writeq(F)), nl.\n")

@test
THE_TYPE_TESTS_SORT_EACH_KIND_OF_TERM()
    val kinds = "[V, 1, a, [], \"s\", f(x), [a], 'A']"
    val program = "in_list(X, [X|_]).\nin_list(X, [_|T]) :- in_list(X, T).\n" +
        s":- forall(in_list(T, $kinds), (" +
        "(var(T) -> write(v) ; write('-')), (nonvar(T) -> write(n) ; write('-')), " +
        "(atom(T) -> write(a) ; write('-')), (number(T) -> write(u) ; write('-')), " +
        "(integer(T) -> write(i) ; write('-')), (atomic(T) -> write(t) ; write('-')), " +
        "(compound(T) -> write(c) ; write('-')), (callable(T) -> write(k) ; write('-')), " +
        "(string(T) -> write(s) ; write('-')), (float(T) -> write(f) ; write('-')), nl)).\n"

    assert_eq(ran_prolog(program), ok("v---------\n-n-uit----\n-na--t-k--\n-na--t-k--\n-n---t--s-\n-n----ck--\n-n----ck--\n-na--t-k--"))

@test
IS_LIST_AND_GROUND()
    assert_eq(holds("is_list([a, b])"), ok("yes"))
    assert_eq(holds("is_list([a | _])"), ok("no"))
    assert_eq(holds("is_list(foo)"), ok("no"))
    assert_eq(holds("ground(f(a, [b]))"), ok("yes"))
    assert_eq(holds("ground(f(a, [_]))"), ok("no"))

@test
FUNCTOR_TAKES_A_TERM_APART_AND_BUILDS_ONE()
    assert_eq(gives("functor(foo(a, b), N, A), X = N/A"), ok("foo/2"))
    assert_eq(gives("functor(abc, N, A), X = N/A"), ok("abc/0"))
    assert_eq(gives("functor(7, N, A), X = N/A"), ok("7/0"))
    assert_eq(gives("functor([a], N, A), X = N/A"), ok("'[|]'/2"))
    assert_eq(holds("functor(X, foo, 3), X = foo(A, B, C), var(A), var(C), A \\== B"), ok("yes"))
    assert_eq(gives("functor(X, foo, 0)"), ok("foo"))
    assert_eq(gives("functor(X, 5, 0)"), ok("5"))
    assert_eq(gives("functor(X, '[|]', 2), X = [a | b]"), ok("[a|b]"))

@test
FUNCTOR_RAISES_THE_ISO_ERRORS()
    assert_eq(holds("functor(_, _, 1)"), ok("instantiation_error"))
    assert_eq(holds("functor(_, foo, _)"), ok("instantiation_error"))
    assert_eq(holds("functor(_, foo, a)"), ok("type_error(integer,a)"))
    assert_eq(holds("functor(_, foo, -1)"), ok("domain_error(not_less_than_zero,-1)"))
    assert_eq(holds("functor(_, foo(a), 1)"), ok("type_error(atomic,foo(a))"))
    assert_eq(holds("functor(_, 5, 1)"), ok("type_error(atom,5)"))

@test
ARG_PICKS_AN_ARGUMENT_COUNTING_FROM_ONE()
    assert_eq(gives("arg(2, f(a, b, c), X)"), ok("b"))
    assert_eq(gives("arg(1, [h | t], X)"), ok("h"))
    assert_eq(holds("arg(4, f(a, b, c), _)"), ok("no"))
    assert_eq(holds("arg(0, f(a), _)"), ok("no"))
    assert_eq(holds("arg(1, f(a), b)"), ok("no"))

@test
ARG_RAISES_THE_ISO_ERRORS()
    assert_eq(holds("arg(_, f(a), _)"), ok("instantiation_error"))
    assert_eq(holds("arg(a, f(a), _)"), ok("type_error(integer,a)"))
    assert_eq(holds("arg(1, _, _)"), ok("instantiation_error"))
    assert_eq(holds("arg(1, atom, _)"), ok("type_error(compound,atom)"))

@test
UNIV_TAKES_A_TERM_APART_AND_BUILDS_ONE()
    assert_eq(gives("f(a, b) =.. X"), ok("[f,a,b]"))
    assert_eq(gives("abc =.. X"), ok("[abc]"))
    assert_eq(gives("3 =.. X"), ok("[3]"))
    assert_eq(gives("[a, b] =.. X"), ok("['[|]',a,[b]]"))
    assert_eq(gives("X =.. [g, 1, 2]"), ok("g(1,2)"))
    assert_eq(gives("X =.. [x]"), ok("x"))
    assert_eq(gives("X =.. [7]"), ok("7"))
    assert_eq(gives("X =.. ['[|]', 1, []]"), ok("[1]"))
    assert_eq(gives("X =.. [+, 1, 2]"), ok("1+2"))

@test
UNIV_RAISES_THE_ISO_ERRORS()
    assert_eq(holds("_ =.. _"), ok("instantiation_error"))
    assert_eq(holds("_ =.. [foo | _]"), ok("instantiation_error"))
    assert_eq(holds("_ =.. [_, a]"), ok("instantiation_error"))
    assert_eq(holds("_ =.. []"), ok("domain_error(non_empty_list,[])"))
    assert_eq(holds("_ =.. foo"), ok("type_error(list,foo)"))
    // GNU Prolog 1.5.0 and SWI-Prolog 10.0.2 agree: with arguments the name must be an atom.
    assert_eq(holds("_ =.. [f(a), b]"), ok("type_error(atom,f(a))"))
    assert_eq(holds("_ =.. [f(a)]"), ok("type_error(atomic,f(a))"))
    assert_eq(holds("_ =.. [1, b]"), ok("type_error(atom,1)"))

@test
COPY_TERM_RENAMES_EVERY_VARIABLE_AND_KEEPS_THE_SHARING()
    assert_eq(holds("copy_term(f(A, B, A), f(X, Y, Z)), X == Z, X \\== Y, var(A), X \\== A"), ok("yes"))
    assert_eq(gives("copy_term(f(a, [b]), X)"), ok("f(a,[b])"))

@test
TERM_VARIABLES_LISTS_EACH_VARIABLE_ONCE_LEFT_TO_RIGHT()
    assert_eq(holds("term_variables(f(A, g(B, A), [C]), L), L == [A, B, C]"), ok("yes"))
    assert_eq(gives("term_variables(f(a, [b]), X)"), ok("[]"))

@test
COMPARE_ANSWERS_THE_STANDARD_ORDER()
    assert_eq(gives("compare(X, 1, a)"), ok("<"))
    assert_eq(gives("compare(X, f(b), f(a))"), ok(">"))
    assert_eq(gives("compare(X, f(a), f(a))"), ok("="))
    assert_eq(holds("compare(<, a, b)"), ok("yes"))
    assert_eq(holds("compare(>, a, b)"), ok("no"))

@test
COMPARE_RAISES_THE_ISO_ERRORS()
    assert_eq(holds("compare(foo, a, b)"), ok("domain_error(order,foo)"))
    assert_eq(holds("compare(1, a, b)"), ok("type_error(atom,1)"))

@test
ACYCLIC_TERM_AND_CYCLIC_TERM_TELL_A_RATIONAL_TREE_FROM_A_FINITE_ONE()
    assert_eq(holds("acyclic_term(f(_, g(a)))"), ok("yes"))
    assert_eq(holds("cyclic_term(f(_, g(a)))"), ok("no"))
    assert_eq(holds("A = f(A), acyclic_term(A)"), ok("no"))
    assert_eq(holds("A = f(A), cyclic_term(A)"), ok("yes"))
    assert_eq(holds("A = [a, b | A], cyclic_term(g(x, A))"), ok("yes"))
    assert_eq(holds("A = f(B), B = g(_), C = h(A, A), acyclic_term(C)"), ok("yes"))

@test
SUBSUMES_TERM_ASKS_WHETHER_ONE_TERM_IS_AN_INSTANCE_OF_THE_OTHER()
    assert_eq(holds("subsumes_term(f(_), f(a))"), ok("yes"))
    assert_eq(holds("subsumes_term(f(a), f(_))"), ok("no"))
    assert_eq(holds("subsumes_term(f(X, X), f(_, _))"), ok("no"))
    assert_eq(holds("subsumes_term(f(_, _), f(Y, Y))"), ok("yes"))
    assert_eq(holds("subsumes_term(X, f(X))"), ok("no"))
    assert_eq(holds("subsumes_term(a, b)"), ok("no"))
    assert_eq(holds("subsumes_term(f(X), f(a)), var(X)"), ok("yes"))
    assert_eq(holds("A = f(A), B = f(B), subsumes_term(A, B)"), ok("yes"))
    assert_eq(holds("A = f(A, _), subsumes_term(g(_), A)"), ok("no"))
    assert_eq(holds("A = f(A, _), B = f(B, c), subsumes_term(A, B)"), ok("yes"))

@test
UNIFIABLE_LISTS_THE_BINDINGS_WITHOUT_MAKING_THEM()
    assert_eq(gives("unifiable(f(A, B, C), f(a, b, c), X), A = 'A', B = 'B', C = 'C'"), ok("['C'=c,'B'=b,'A'=a]"))
    assert_eq(gives("unifiable(f(A, b), f(a, B), U), var(A), var(B), A = 'A', B = 'B', X = U"), ok("['B'=b,'A'=a]"))
    assert_eq(gives("unifiable(f(a), f(a), X)"), ok("[]"))
    assert_eq(holds("unifiable(a, b, _)"), ok("no"))
    assert_eq(holds("A = f(A), B = f(B), unifiable(A, B, [])"), ok("yes"))

@test
THE_STANDARD_ORDER_PUTS_STRINGS_BEFORE_ATOMS_AND_THE_EMPTY_LIST_FIRST_AMONG_ATOMS()
    // SWI-Prolog 10.0.2's order.
    assert_eq(gives("msort([b, \"a\", 1.0, 1, \"b\", f(x), a, []], X)"), ok("[1.0,1,\"a\",\"b\",[],a,b,f(x)]"))
    assert_eq(gives("msort([zebra, \"apple\", \"zoo\", apple], X)"), ok("[\"apple\",\"zoo\",apple,zebra]"))
    assert_eq(gives("msort([a, [], !, '[]'], X)"), ok("[[],!,'[]',a]"))
    assert_eq(gives("compare(X, \"z\", a)"), ok("<"))

@test
UNIFIABLE_LISTS_THE_BINDINGS_IN_SWI_PROLOGS_ORDER()
    // SWI-Prolog 10.0.2's answers, each variable named by binding it afterwards.
    assert_eq(gives("unifiable(X0, Y0, X), X0 = x, Y0 = y"), ok("[x=y]"))
    assert_eq(gives("unifiable(Y0, X0, X), X0 = x, Y0 = y"), ok("[y=x]"))
    assert_eq(gives("unifiable(f(Y0), X0, X), X0 = x, Y0 = y"), ok("[x=f(y)]"))
    assert_eq(gives("unifiable(X0, X0, X)"), ok("[]"))
    assert_eq(gives("unifiable(f(X0, Y0, Z0), f(Z0, X0, Y0), X), X0 = x, Y0 = y, Z0 = z"), ok("[y=x,z=x]"))
    assert_eq(gives("unifiable(f(X0, X0), f(a, Y0), X), X0 = x, Y0 = y"), ok("[y=a,x=a]"))
    assert_eq(gives("unifiable(f(X0, g(Y0)), f(g(Z0), X0), X), X0 = x, Y0 = y, Z0 = z"), ok("[z=y,x=g(z)]"))
    assert_eq(gives("unifiable([X0, Y0], [Y0, a], X), X0 = x, Y0 = y"), ok("[x=a,y=x]"))

@test
DECIDED_IS_IDENTITY_OR_A_SURE_MISMATCH()
    assert_eq(holds("?=(a, a)"), ok("yes"))
    assert_eq(holds("?=(a, b)"), ok("yes"))
    assert_eq(holds("?=(X, X)"), ok("yes"))
    assert_eq(holds("?=(_, a)"), ok("no"))
    assert_eq(holds("?=(f(X), f(Y))"), ok("no"))
    assert_eq(holds("?=(f(X, a), f(Y, b))"), ok("yes"))
    assert_eq(gives("?=(f(X), f(a)) ; X = unbound"), ok("unbound"))

@test
NUMBERVARS_NAMES_EACH_VARIABLE_BY_A_VAR_TERM()
    assert_eq(ran_prolog(":- T = f(X, Y, X, g(Z)), numbervars(T, 0, E), print(T-E), nl, write_canonical(T), nl.\n"),
        ok("f(A,B,A,g(C))-3\nf('$VAR'(0),'$VAR'(1),'$VAR'(0),g('$VAR'(2)))"))
    assert_eq(gives("T = f(_, _), numbervars(T, 25, E), X = T-E"), ok("f(Z,A1)-27"))
    assert_eq(gives("numbervars(abc, 7, X)"), ok("7"))
    assert_eq(holds("numbervars(f(_), 0, 5)"), ok("no"))
    assert_eq(gives("A = f(A, _), numbervars(A, 0, X)"), ok("1"))

@test
NUMBERVARS_RAISES_THE_ERRORS_SWI_PROLOG_DOES()
    assert_eq(holds("numbervars(f(_), _, _)"), ok("instantiation_error"))
    assert_eq(holds("numbervars(f(_), a, _)"), ok("type_error(integer,a)"))
    assert_eq(holds("numbervars(f(_), 1.0, _)"), ok("type_error(integer,1.0)"))

// The expected answers of the two below are what swipl 10.0.2 gives for the same goals.
@test
NUMBERVARS_4_TAKES_SWI_PROLOGS_OPTIONS()
    val shows = ":- T = f(X, Y, X), numbervars(T, 0, E, [singletons(true)]), print(T-E), nl, write_canonical(T), nl.\n"

    assert_eq(ran_prolog(shows), ok("f(A,_,A)-1\nf('$VAR'(0),'$VAR'('_'),'$VAR'(0))"))
    assert_eq(gives("T = g(A, B, A, C), numbervars(T, 0, E, [singletons(true)]), X = T-E"), ok("g(A,_,A,_)-1"))
    assert_eq(gives("T = f(_, _), numbervars(T, 0, E, [functor_name(v)]), X = T-E"), ok("f(v(0),v(1))-2"))
    assert_eq(gives("T = f(_, _), numbervars(T, 5, E, [functor_name(v), singletons(true)]), X = T-E"), ok("f(v('_'),v('_'))-5"))
    assert_eq(gives("T = f(_, _), numbervars(T, 0, E, [functor_name(v), functor_name(w)]), X = T-E"), ok("f(w(0),w(1))-2"))
    assert_eq(gives("T = f(_, _), numbervars(T, 0, E, [attvar(skip), foo(bar)]), X = T-E"), ok("f(A,B)-2"))
    assert_eq(gives("T = f(_), numbervars(T, 0, E, []), X = T-E"), ok("f(A)-1"))
    assert_eq(gives("T = f(_), numbervars(T, -1, E, []), X = T-E"), ok("f(S_1)-0"))
    assert_eq(holds("numbervars(f(_, _), 0, 1, [])"), ok("no"))

@test
NUMBERVARS_4_REFUSES_A_BAD_OPTION()
    assert_eq(holds("numbervars(f(_), 0, _, foo)"), ok("type_error(list,foo)"))
    assert_eq(holds("numbervars(f(_), 0, _, [a, b|c])"), ok("type_error(list,c)"))
    assert_eq(holds("numbervars(f(_), 0, _, _)"), ok("instantiation_error"))
    assert_eq(holds("numbervars(f(_), 0, _, [a|_])"), ok("instantiation_error"))
    assert_eq(holds("numbervars(f(_), 0, _, [_])"), ok("instantiation_error"))
    assert_eq(holds("numbervars(f(_), 0, _, [functor_name(_)])"), ok("instantiation_error"))
    assert_eq(holds("numbervars(f(_), 0, _, [attvar(foo)])"), ok("domain_error(numbervar_option,[attvar(foo)])"))
    assert_eq(holds("numbervars(f(_), 0, _, [foo(1), attvar(foo), bar])"), ok("domain_error(numbervar_option,[foo(1),attvar(foo),bar])"))
    assert_eq(holds("numbervars(f(_), 0, _, [functor_name(1)])"), ok("type_error(atom,1)"))
    assert_eq(holds("numbervars(f(_), 0, _, [singletons(maybe)])"), ok("type_error(bool,maybe)"))
    assert_eq(holds("numbervars(f(_), a, _, [])"), ok("type_error(integer,a)"))

@test
A_CYCLIC_TERM_IS_NOT_STORED_AS_A_CLAUSE()
    assert_eq(holds("A = f(A), assertz(p(A))"), ok("representation_error(cyclic_term)"))
    assert_eq(holds("A = f(A), asserta(p(A))"), ok("representation_error(cyclic_term)"))
    assert_eq(holds("A = f(A), assert(p(A))"), ok("representation_error(cyclic_term)"))
    assert_eq(holds("A = (q :- A), assertz(A)"), ok("representation_error(cyclic_term)"))
    assert_eq(holds("A = (a, A), assertz((q :- A))"), ok("representation_error(cyclic_term)"))
    assert_eq(holds("A = f(A), findall(A, true, [L]), L = f(L), cyclic_term(L)"), ok("yes"))
