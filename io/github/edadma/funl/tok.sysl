module io.github.edadma.funl

import sh.sysl.parsing.*

// The tokens, and how strongly each infix one binds.
//
// **The ladder, lowest first**: the lambda arrow `->` (right) · scanning `?` · `or` · `and` · the operand of `not` ·
// alternation `|` · conjunction `&` · comparison `~`, `==`, `!=`, `<`, `<=`, `>`, `>=`, `in`, `not in` ·
// cons `:` (right) · `to until .. ..<` · `+ -` · `* / \ % mod div` · `^` (right) · prefix `-` ·
// `! \ /` · application, `.` and postfix `++` `--`. Comparison binds tighter than `&` and
// `|`, so a rule body reads `a != b & f != m` as the two goals `logic.md` says it is.

enum Tok
    Name(text: string)
    AtomLit(text: string)
    IntLit(n: long)

    // A number literal that is not a 64-bit integer -- a real, `2.5`, `1e10`, or an integer past 64
    // bits -- as its digits, underscores taken out; the tower reads it when it becomes a constant.
    NumLit(text: string)
    StrLit(text: string)

    // A regex between backticks, its text exactly as written: the regex parser reads its escapes,
    // `` \` `` among them.
    RegexLit(text: string)

    // A double-quoted string with `$name` or `${e}` written into it. The token carries nothing: the
    // parser reads the literal again from the source at the token's span, taking it apart into its
    // text and the expressions in its holes.
    InterpLit

    // Words.
    Def
    Free
    Every
    Do
    If
    Then
    Elif
    Else
    Not
    And
    Or
    Val
    Where
    ReturnW
    FailW
    TrueW
    FalseW
    Otherwise
    Mod
    Div
    To
    Until
    By
    YieldW
    VarW
    While
    Repeat
    For
    Break
    Continue
    DataW
    UndefinedW

    LParen
    RParen
    LBracket
    RBracket
    Bang
    Comma
    Amp
    Bar
    Tilde
    EqEq
    BangEq
    Equals
    Turnstile
    Arrow
    At
    Plus
    Minus
    Star
    Slash
    SlashSlash
    Backslash
    Percent
    Caret
    Less
    LessEq
    Greater
    GreaterEq

    // `;` between the statements of a parenthesized sequence; `:` after a loop's label.
    Semi
    Colon

    // `<-`: the binding of a `for` head or a comprehension, and reversible assignment `x <- e`.
    LeftArrow

    // `..` and `..<`: a range, inclusive and exclusive of its end. `..+`: a range of a count.
    DotDot
    DotDotLess
    DotDotPlus

    // `{` and `}`: a set comprehension.
    LBrace
    RBrace

    // `.`: a field, `l.length`.
    Dot

    // `in`, and `not in` read as one operator.
    In
    NotIn

    // `+=`, `-=`, `*=`, `/=`, `\=`, `%=`, `^=`, and `<:=` and `>:=`, which store the right operand
    // when the ordering holds and fail otherwise: an assignment through the operator.
    OpEq(o: BinOp)

    // `++` and `--`.
    PlusPlus
    MinusMinus

    // `?`, string scanning `s ? e`, and `?=`, which scans a variable and stores the result in it.
    Question
    QuestionEq

    // Layout: the end of a line at the same depth, a deeper line, and each block a shallower line
    // closes.
    Newline
    Indent
    Dedent
end Tok

// Spelling a token for a diagnostic: what a reader would have to type to produce it.
describe(t: Tok) -> string
    t match
        Name(s) -> s"`$s`"
        AtomLit(s) -> s"`#$s`"
        IntLit(n) -> s"`$n`"
        NumLit(t) -> s"`$t`"
        StrLit(_) -> "a string"
        RegexLit(_) -> "a regex"
        InterpLit -> "a string"
        Newline -> "the end of the line"
        Indent -> "an indented line"
        Dedent -> "the end of the block"
        _ -> s"`${spelling(t)}`"
end describe

// How a word or a symbol is written.
private spelling(t: Tok) -> string
    t match
        Def -> "def"
        Free -> "free"
        Every -> "every"
        Do -> "do"
        If -> "if"
        Then -> "then"
        Elif -> "elif"
        Else -> "else"
        Not -> "not"
        And -> "and"
        Or -> "or"
        Val -> "val"
        Where -> "where"
        ReturnW -> "return"
        FailW -> "fail"
        TrueW -> "true"
        FalseW -> "false"
        Otherwise -> "otherwise"
        Mod -> "mod"
        Div -> "div"
        To -> "to"
        Until -> "until"
        By -> "by"
        YieldW -> "yield"
        VarW -> "var"
        While -> "while"
        Repeat -> "repeat"
        For -> "for"
        Break -> "break"
        Continue -> "continue"
        DataW -> "data"
        UndefinedW -> "undefined"
        Semi -> ";"
        Colon -> ":"
        LeftArrow -> "<-"
        DotDot -> ".."
        DotDotLess -> "..<"
        DotDotPlus -> "..+"
        LBrace -> "{"
        RBrace -> "}"
        Dot -> "."
        In -> "in"
        NotIn -> "not in"
        OpEq(o) ->
            o match
                Lt -> "<:="
                Gt -> ">:="
                _ -> op_text(o) + "="
        PlusPlus -> "++"
        MinusMinus -> "--"
        Question -> "?"
        QuestionEq -> "?="
        LParen -> "("
        RParen -> ")"
        LBracket -> "["
        RBracket -> "]"
        Bang -> "!"
        Comma -> ","
        Amp -> "&"
        Bar -> "|"
        Tilde -> "~"
        EqEq -> "=="
        BangEq -> "!="
        Equals -> "="
        Turnstile -> ":-"
        Arrow -> "->"
        At -> "@"
        Plus -> "+"
        Minus -> "-"
        Star -> "*"
        Slash -> "/"
        SlashSlash -> "//"
        Backslash -> "\\"
        Percent -> "%"
        Caret -> "^"
        Less -> "<"
        LessEq -> "<="
        Greater -> ">"
        GreaterEq -> ">="
        _ -> "?"
end spelling

// The word a name is, if it is one.
keyword(s: string) -> Option[Tok]
    if s == "def" then return Some(Def)
    if s == "free" then return Some(Free)
    if s == "every" then return Some(Every)
    if s == "do" then return Some(Do)
    if s == "if" then return Some(If)
    if s == "then" then return Some(Then)
    if s == "elif" then return Some(Elif)
    if s == "else" then return Some(Else)
    if s == "not" then return Some(Not)
    if s == "and" then return Some(And)
    if s == "or" then return Some(Or)
    if s == "val" then return Some(Val)
    if s == "where" then return Some(Where)
    if s == "return" then return Some(ReturnW)
    if s == "fail" then return Some(FailW)
    if s == "true" then return Some(TrueW)
    if s == "false" then return Some(FalseW)
    if s == "otherwise" then return Some(Otherwise)
    if s == "mod" then return Some(Mod)
    if s == "div" then return Some(Div)
    if s == "to" then return Some(To)
    if s == "until" then return Some(Until)
    if s == "by" then return Some(By)
    if s == "in" then return Some(In)
    if s == "yield" then return Some(YieldW)
    if s == "var" then return Some(VarW)
    if s == "while" then return Some(While)
    if s == "repeat" then return Some(Repeat)
    if s == "for" then return Some(For)
    if s == "break" then return Some(Break)
    if s == "continue" then return Some(Continue)
    if s == "data" then return Some(DataW)
    if s == "undefined" then return Some(UndefinedW)

    None
end keyword

// The operator's power on its left; 0 for a token that is not an infix operator, which stops the
// expression loop.
power(t: Tok) -> Power
    t match
        Arrow -> right_assoc(ArrowPower)
        Question -> left_assoc(ScanPower)
        Or -> left_assoc(10)
        And -> left_assoc(12)
        Bar -> left_assoc(20)
        Amp -> left_assoc(30)
        Tilde -> left_assoc(40)
        EqEq -> left_assoc(40)
        BangEq -> left_assoc(40)
        Less -> left_assoc(40)
        LessEq -> left_assoc(40)
        Greater -> left_assoc(40)
        GreaterEq -> left_assoc(40)
        In -> left_assoc(40)
        NotIn -> left_assoc(40)
        Colon -> right_assoc(ConsPower)
        To -> left_assoc(RangePower)
        Until -> left_assoc(RangePower)
        DotDot -> left_assoc(RangePower)
        DotDotLess -> left_assoc(RangePower)
        DotDotPlus -> left_assoc(RangePower)
        Plus -> left_assoc(50)
        Minus -> left_assoc(50)
        Star -> left_assoc(60)
        Slash -> left_assoc(60)
        SlashSlash -> left_assoc(60)
        Backslash -> left_assoc(60)
        Percent -> left_assoc(60)
        Mod -> left_assoc(60)
        Div -> left_assoc(60)
        Caret -> right_assoc(70)
        LParen -> left_assoc(ApplyPower)
        LBracket -> left_assoc(ApplyPower)
        Dot -> left_assoc(ApplyPower)
        PlusPlus -> left_assoc(ApplyPower)
        MinusMinus -> left_assoc(ApplyPower)
        _ -> left_assoc(0)

// Whether a line ending in this token has not finished its statement: an infix operator still owes
// its right operand, so the next line continues the statement. Assignment through an operator and
// reversible assignment `<-` count; the tokens that open a block when they end a line (`=`, `->`,
// `?`, `:-`) do not, and nor do the postfix `++` and `--`, or `..`, which ends the endless range
// `1..`.
continues_line(t: Tok) -> bool
    t match
        Or | And | Bar | Amp | Tilde -> true
        EqEq | BangEq | Less | LessEq | Greater | GreaterEq | In | NotIn -> true
        Colon | To | Until | By | DotDotLess | DotDotPlus -> true
        Plus | Minus | Star | Slash | SlashSlash | Backslash | Percent | Mod | Div | Caret -> true
        LeftArrow | QuestionEq -> true
        OpEq(_) -> true
        _ -> false

// The arrow of a lambda: below everything, so a lambda's body reaches as far right as it can.
const ArrowPower: u16 = 5

// String scanning `s ? e`: looser than `or`, so the whole of `s ? a | b` is scanned, and tighter than
// the lambda arrow, so a lambda's body can be a scan.
const ScanPower: u16 = 8

// The level `not` reads its operand at: everything that binds tighter than `and`.
const NotPower: u16 = 14

// The level `return` and `yield` read their operand at: everything that binds tighter than `&`.
const ReturnPower: u16 = 30

// The level the operand of a prefix `|` is read at: everything that binds tighter than `|`, so
// `|a | b` is `(|a) | b`.
const RepeatPower: u16 = 20

// `to` and `until`, `..` and `..<`, and the level their bounds and a `by` step are read at: looser
// than arithmetic, tighter than a comparison, so `1 to n + 1` counts to `n + 1` and `x == 1 to 3`
// compares with each.
const RangePower: u16 = 45

// Cons `h:t`, grouping to the right: looser than a range, tighter than a comparison, so `x:xs == l`
// compares the cons and `0:1..3` is `0` before the range.
const ConsPower: u16 = 42

// The level `\x` and `/x` read their operand at, as `!` does.
const DefinedPower: u16 = 88

// The level the operand of `!` is read at: application binds tighter, so `!f(x)` generates the
// elements of `f(x)`.
const BangPower: u16 = 88

// The level prefix `-` reads its operand at: `^` binds tighter, `*` does not, so `-2^2` is `-(2^2)`.
const NegPower: u16 = 65

// The level a number literal's touching operand is read at, `2n` or `3(x + 1)`: application binds
// tighter, so `2f(x)` is `2 * f(x)`.
const JuxtPower: u16 = 85

// Application, `f(x)` on any expression: tighter than every operator.
const ApplyPower: u16 = 90

// Whether a section can be made of a token: `(+ 1)`, `(2 *)`, `(== 0)`.
sectionable(t: Tok) -> bool
    if binop_of(t).is_some() then return true

    t match
        EqEq -> true
        BangEq -> true
        _ -> false

// The arithmetic or ordering operator a token is, if it is one.
binop_of(t: Tok) -> Option[BinOp]
    t match
        Plus -> Some(Add)
        Minus -> Some(Sub)
        Star -> Some(Mul)
        Slash -> Some(Quo)
        SlashSlash -> Some(FloorQuo)
        Backslash -> Some(IntQuo)
        Percent -> Some(Rem)
        Mod -> Some(Modulo)
        Div -> Some(Divides)
        Caret -> Some(Pow)
        Less -> Some(Lt)
        LessEq -> Some(Le)
        Greater -> Some(Gt)
        GreaterEq -> Some(Ge)
        _ -> None

// Whether a token can begin an expression.
starts_expr(t: Tok) -> bool
    t match
        Name(_) -> true
        AtomLit(_) -> true
        IntLit(_) -> true
        NumLit(_) -> true
        StrLit(_) -> true
        RegexLit(_) -> true
        InterpLit -> true
        UndefinedW -> true
        Every -> true
        If -> true
        Not -> true
        LParen -> true
        ReturnW -> true
        FailW -> true
        TrueW -> true
        FalseW -> true
        Otherwise -> true
        Minus -> true
        Bang -> true
        Bar -> true
        YieldW -> true
        LBracket -> true
        LBrace -> true
        Backslash -> true
        Slash -> true
        While -> true
        Repeat -> true
        For -> true
        Break -> true
        Continue -> true
        PlusPlus -> true
        MinusMinus -> true
        _ -> false
