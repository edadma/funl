// `prolog` -- the FunL machine with nothing but its Prolog front end: an ISO top level that knows
// standard Prolog and no FunL. The executable is named for this package.

package {
  name    = "prolog"
  version = "0.0.5"
  sysl    = "0.1.0-alpha.5"
}

// **`default_features = false`, because standard Prolog imports no `funl:` module** (`modules.md`
// § "Features keep the core link line short"): the machine comes without the features that would put
// a library such as libcurl on this executable's link line.
dependencies {
  funl-vm   { workspace = true, default_features = false }
  parsing   { git = "github.com/sysl-lang/parsing", version = "0.12.1" }
  linenoise { git = "github.com/sysl-lang/linenoise", version = "0.3.0" }
}

// `sysl build -p prolog --features profile` builds a `prolog` that counts the instructions it
// executes; `FUNL_PROFILE=1` then has it write the table to standard error when it ends.
features {
  profile = ["funl-vm/profile"]
}

requires {
  heap = true
}
