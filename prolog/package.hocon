// `prolog` -- the FunL machine with nothing but its Prolog front end: an ISO top level that knows
// standard Prolog and no FunL. The executable is named for this package.

package {
  name    = "prolog"
  version = "0.0.1"
  sysl    = "0.1.0-alpha.1"
}

dependencies {
  funl-vm   { workspace = true }
  parsing   { git = "github.com/sysl-lang/parsing", version = "0.12.1" }
  linenoise { git = "github.com/sysl-lang/linenoise", version = "0.3.0" }
}

requires {
  heap = true
}
