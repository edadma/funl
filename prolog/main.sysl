import io.github.edadma.funl.{asked_to_profile, profile_report, profile_start, profile_stop, to_stdout, toplevel, unfinished}
import sh.sysl.linenoise.{history_add, history_set_max_len, read}
import sysl.posix.tty.is_tty
import sysl.text.Search

// `prolog [file.pl ...]`: consult each file, then the ISO top level -- `?- goal.`, `;` for the next
// answer, `halt.` or the end of input to leave. The machine is FunL's, with its Prolog front end and
// nothing else (`toplevel.sysl`).
//
// Lines are read through linenoise: the arrow keys and history at a terminal, and plain lines, with no
// prompt, from a pipe.

main(args: []string)
    history_set_max_len(500)

    // `FUNL_PROFILE=1`: the instructions executed, per kind, on standard error at the end.
    val profiling = asked_to_profile()

    if profiling then profile_start()

    val code = toplevel(args[1..], (prompt) -> line(prompt), (text) -> out(text))

    flush()

    if profiling
        profile_stop()
        eprints(profile_report())

    exit(code)

// What standard output's current line holds so far, for `line`.
private var tail: string = ""

// `text` to standard output as the session writes it, minding the line it leaves unfinished.
private out(text: string)
    to_stdout(text)
    tail = unfinished(tail, text)

// A line, remembered for the arrow keys unless it is blank. What the session has written is pushed
// out first; at a terminal, a line a query left unfinished is handed to linenoise as the start of the
// prompt, because linenoise redraws its line from the left margin and would otherwise erase it. The
// cursor goes back to the margin for it, since linenoise first writes its prompt where the cursor is,
// over the same text.
private line(prompt: string) -> Option[string]
    var p = prompt

    if tail.bytes.len > 0 && is_tty(0) && is_tty(1)
        prints("\r")
        p = tail + prompt

    flush()

    val got = read(p)

    // The line typed ends with the newline the terminal echoed.
    tail = ""

    got match
        Some(l) -> if !l.trim().is_empty() then history_add(l)
        None -> ()

    got
