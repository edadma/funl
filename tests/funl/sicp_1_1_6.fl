;; SICP 1.1.6  Conditional Expressions and Predicates

def abs( x ) = if x >= 0 then x else -x

write( abs(-3), abs(0), abs(5) )

;; `x > y` produces `y` or fails, so a predicate is asked with `if`
def greater_or_equal( x, y ) = x > y or x == y

def at_least( x, y ) = not x < y

for (x, y) <- [(5, 3), (3, 3), (2, 3)]
  write( x, y, if greater_or_equal(x, y) then "yes" else "no", if at_least(x, y) then "yes" else "no" )

;; Exercise 1.1

write( 10 )
write( 5 + 3 + 4 )
write( 9 - 1 )
write( 6 / 2 )
write( (2 * 4) + (4 - 6) )

val a = 3
val b = a + 1

write( a + b + (a * b) )
write( if a == b then "true" else "false" )
write( if b > a and b < a * b then b else a )
write( if a == 4 then 6 elif b == 4 then 6 + 7 + a else 25 )
write( 2 + (if b > a then b else a) )
write( (if a > b then a elif a < b then b else -1) * (a + 1) )
