;; SICP 1.3.1  Procedures as Arguments: the sums that approximate pi and an integral

def pi_sum( a, b ) =
  if a > b then 0
  else 1.0 / (a * (a + 2)) + pi_sum( a + 4, b )

write( 8 * pi_sum(1, 1000) )

def sum( term, a, next, b ) =
  if a > b then 0
  else term( a ) + sum( term, next(a), next, b )

def cube( x ) = x * x * x

def pi_sum_2( a, b )
  def pi_term( x ) = 1.0 / (x * (x + 2))
  def pi_next( x ) = x + 4

  sum( pi_term, a, pi_next, b )

write( 8 * pi_sum_2(1, 1000) )

def integral( f, a, b, dx )
  def add_dx( x ) = x + dx

  sum( f, a + dx / 2.0, add_dx, b ) * dx

write( integral(cube, 0, 1, 0.01) )
write( integral(cube, 0, 1, 0.001) )
