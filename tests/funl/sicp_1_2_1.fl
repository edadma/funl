;; SICP 1.2.1  Linear Recursion and Iteration

;; recursive
def factorial( 1 ) = 1
def factorial( n ) = n * factorial( n - 1 )

write( factorial(6) )

;; iterative
def factorial_2( n ) = fact_iter( 1, 1, n )

def fact_iter( product, counter, max_count ) =
  if counter > max_count then product
  else fact_iter( counter * product, counter + 1, max_count )

write( factorial_2(6) )

;; Exercise 1.9

def inc( x ) = x + 1

def dec( x ) = x - 1

;; recursive
def plus( 0, b ) = b
def plus( a, b ) = inc( plus(dec(a), b) )

write( plus(4, 5) )

;; iterative
def plus_2( 0, b ) = b
def plus_2( a, b ) = plus_2( dec(a), inc(b) )

write( plus_2(4, 5) )

;; Exercise 1.10: Ackermann's function

def A( x, 0 ) = 0
def A( 0, y ) = 2y
def A( x, 1 ) = 2
def A( x, y ) = A( x - 1, A(x, y - 1) )

write( A(1, 10) )
write( A(2, 4) )
write( A(3, 3) )
