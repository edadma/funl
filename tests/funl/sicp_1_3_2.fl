;; SICP 1.3.2  Constructing Procedures Using Lambda

def plus4( x ) = x + 4

val plus4_2 = x -> x + 4

write( plus4(3), plus4_2(3), (x -> x + 4)(3) )

def square( x ) = x * x

write( ((x, y, z) -> x + y + square(z))(1, 2, 3) )

;; Using `val` to create local names

def f( x, y )
  val a = 1 + x * y
  val b = 1 - y

  x * square( a ) + y * b + a * b

write( f(3, 4) )

;; the same with a lambda applied to the values, as `let` is

def f_2( x, y ) = ((a, b) -> x * square( a ) + y * b + a * b)( 1 + x * y, 1 - y )

write( f_2(3, 4) )

;; conditional clauses with a body of statements

def expmod( _, 0, _ ) = 1
def expmod( base, exp, m )
  | 2 div exp =
      val half_exp = expmod( base, exp / 2, m )

      half_exp * half_exp mod m
  | otherwise = base * expmod( base, exp - 1, m ) mod m

write( expmod(4, 3, 5) )
write( expmod(2, 10, 1000) )
