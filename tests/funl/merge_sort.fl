def
  merge( [], ys )               = ys
  merge( xs, [] )               = xs
  merge( xs@(x:xt), ys@(y:yt) )
    | x <= y                    = x : merge( xt, ys )
    | otherwise                 = y : merge( xs, yt )

  split( (x:y:zs) ) = (x:xs, y:ys) where (xs, ys) = split( zs )
  split( [x] )      = ([x], [])
  split( [] )       = ([], [])

  mergeSort( [] )  = []
  mergeSort( [x] ) = [x]
  mergeSort( xs )  = merge( mergeSort(as), mergeSort(bs) ) where (as,bs) = split( xs )

write( mergeSort([4, 6, 9, 1, 3, 5, 7, 2, 8]) )
