var multiple = 2
var lower = 4

def
  foldl( f, z, [] )           = z
  foldl( f, z, x:xs )         = foldl( f, f(z, x), xs )

  map( f, [] )                = []
  map( f, x:xs )              = f( x ) : map( f, xs )

  filter( p, [] )             = []
  filter( p, x:xs ) | p( x )  = x : filter( p, xs )
  filter( p, _:xs )           = filter( p, xs )

write( foldl((+), 0, map((*multiple), filter((lower<), 3..6))) )
