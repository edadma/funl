def
  filter( p, [] )             =  []
  filter( p, x:xs ) | p( x )  =  x : filter( p, xs )
  filter( p, _:xs )           =  filter( p, xs )

  take( 0, _ )          =  []
  take( _, [] )         =  []
  take( n, _ ) | n < 0  =  error( "take: expected non-negative integer" )
  take( n, x:xs )       =  x : take( n - 1, xs )

write( take(2, filter((>= 5), 1..10)) )
write( take(2, filter(a -> a >= 5, 1..10)) )
