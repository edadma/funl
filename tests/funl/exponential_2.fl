def pow( _, 0 ) = 1
def pow( x, n ) | n > 0 = f( x, n - 1, x )
  where
    f( _, 0, y ) = y
    f( x, n, y ) = g( x, n )
      where
        g( x, n )
          | 2 div n = g( x*x, n/2 )
          | otherwise = f( x, n - 1, x*y )
def pow( _, _ ) = error( "pow: negative exponent" )

for n <- 0..18
  write( n, pow(2, n) )
for n <- 0..18
  write( n, pow(3, n) )
