var i
var j
val b = buffer()

outer: every i = 1 to 10
  every j = 1 to 2
    if 3 div i and j == 2 then continue
    if 5 div i then continue outer

    b += (i, j)

write( b )

;;;;;;;;;;;;;;;;

i = 0
val b1 = buffer()

outer: while i++ < 10
  j = 0

  while j++ < 2
    if 3 div i and j == 2 then continue
    if 5 div i then continue outer

    b1 += (i, j)

write( b1 )

;;;;;;;;;;;;;;;;

i = 0
val b2 = buffer()

outer: repeat
  if not i++ < 10 then break
  j = 0

  repeat
    if j++ >= 2 then break
    if 3 div i and j == 2 then continue
    if 5 div i then continue outer

    b2 += (i, j)

write( b2 )
