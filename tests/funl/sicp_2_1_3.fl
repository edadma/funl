;; SICP 2.1.3  What Is Meant by Data?

;; Exercise 2.6: Church numerals

val zero = f -> x -> x

def add_1( n ) = f -> x -> f( n(f)(x) )

val one = f -> x -> f( x )
val two = f -> x -> f( f(x) )

def plus( n, m ) = f -> x -> n( f )( m(f)(x) )

def church_to_number( c ) = c( (+ 1) )( 0 )

write( church_to_number(zero) )
write( church_to_number(add_1(zero)) )
write( church_to_number(two) )

val three = plus( one, two )

write( church_to_number(three) )
write( church_to_number(plus(three, add_1(three))) )
